-- ===============================================
-- Form_OnFormInit
-- ===============================================
function Form_OnFormInit()
	-- -----------------------------------------------
	-- 패딩값 초기화 (위치변경 X)
	-- -----------------------------------------------
	lblTempTitle.paddinginfo = "0,0,0,0"
	lblTemp0.paddinginfo = "0,0,0,0"
	lblTemp1.paddinginfo = "0,0,0,0"
	lblTemp2.paddinginfo = "0,0,0,0"
	
	Label0.caption = "해당 종목은 감시 실행이 불가하므로"
	Label1.caption = "삭제 후 이용해 주세요"
	
	Label2.caption = "거래정지, 권리 발생(액면병합, 액면분할, 합병"
	Label3.caption = "등), 종목정보 변경 (ISIN코드, Tiker, 거래소"
	Label4.caption = "변경, 재상장 등), 상장폐지, OTC 종목으로"
	Label5.caption = "전환, 기준가격이 변동된 경우에는 감시 실행이"
	Label6.caption = "불가해요."
	
--	Label2.ChangeTextAttr(0, 4, 290, 0, false)
--	Label4.ChangeTextAttr(18, 8, 290, 0, false)
--	Label5.ChangeTextAttr(0, 9, 290, 0, false)
	
	lblTitle0.SetHighlight(332)
	Label5.SetHighlight(332, 10, 15)
	Label6.SetHighlight(332)
	-- ------------------------------------------------------------------------------
	-- 라벨컨트롤 라인수 체크 시 OS별 동작 타이밍 다름
	-- iOS : 즉시 라인수 체크 가능
	-- 안드로이드 : 지연처리 후 라인수 체크 가능(컨트롤 생성 타이밍 때문으로 보임)
	-- ------------------------------------------------------------------------------
--	if g_szOsType == "2" then
--		Init_Control()
--	else
--		Form.SetDelayEvent(1, 0.1)
--	end
	
end

-- ===============================================
-- Form_OnDelayEvent(1회 실행)
-- ===============================================
function Form_OnDelayEvent(nID)
	if gf_Tonumber(nID) == 1 then
		Init_Control()
	end
end

