function Init_Control()
	lblTitle.fgcolor = g_szTxtColor_Normal
	lblTitle.paddinginfo = "0,0,0,0"

	imgBack.maintainratio = "2"
	imgBack.imgpath = g_szBackImg
	
	lblLine0.bgcolor = g_szLineColor2
	
	Image1.maintainratio = "3"
	Image1.imgpath = g_ImgArrow_Down
	
	Label0.imagefilepth = g_szBadgeBg_Line2
	
	lblSortInfo.fgcolor = g_szTxtColor_Grey
end

function Request_Tran_ohhts_6230_001r()
	g_szCmbData = ""
	DATAMANAGER.ClearInputData(false, "ohhts_6230_001r")
	DATAMANAGER.SetDataValue(false,"ohhts_6230_001r", "InBlock1", "FID_CLCD"	, 0 , "1")
	DATAMANAGER.RequestTranData("ohhts_6230_001r")
end

function Process_Tran_ohhts_6230_001r()
	nDataCnt = DATAMANAGER.GetDataCount(false, "ohhts_6230_001r", "OutBlock1")
	
	if nDataCnt == "" or gf_Tonumber(nDataCnt) == 0 then
		return
	end
	
	for i = 0, nDataCnt-1 do
		szTypeCd = DATAMANAGER.GetDataValue(false,"ohhts_6230_001r", "OutBlock1", "FIDX_BSTP_CLS_CODE"  , i)
		szTypeNm = DATAMANAGER.GetDataValue(false,"ohhts_6230_001r", "OutBlock1", "FIDX_BSTP_DIV_NAME"  , i)
		
		cmb1.cbadddatatext = szTypeCd.."`"..szTypeNm
	end
	
	if DATAMANAGER.IsMoreNextData("ohhts_6230_001r") == true then
		DATAMANAGER.RequestNextData("ohhts_6230_001r")
	else
		if g_szExidCd ~= "" then
			cmb0.cbkeydata = g_szExidCd
		end
		if g_szTypeCd ~= "" then
			cmb1.cbkeydata = g_szTypeCd
		end
		
		Request_Tran_ohhts_6230_002r()
	end
end

function Request_Tran_ohhts_6230_002r()
	Pannel0.rowcount = 0
	
	DATAMANAGER.ClearInputData(false, "ohhts_6230_002r")

	  --시장 구분
    local sCmb_Makt
    sCmb_Makt  = cmb0.cbkeydata
     --국가 구분
    if sCmb_Makt == "US" then
	    sNtns = sCmb_Makt 
	    sCmb_Makt = ""											 --미국전체
    elseif sCmb_Makt == "NY" or sCmb_Makt == "AX" or sCmb_Makt == "OQ" then --미국 각 시장
	    sNtns = "US"
    elseif sCmb_Makt == "SH" or sCmb_Makt == "SZ" then --상해, 심천
	    sNtns = "CN"
    else --일본, 홍콩 
	    sNtns = sCmb_Makt
    end

	DATAMANAGER.SetDataValue(false,"ohhts_6230_002r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE"	, 0 , "OV")
	DATAMANAGER.SetDataValue(false,"ohhts_6230_002r", "InBlock1", "FID_INPUT_COND_SCR_DIV_CODE"		, 0 , "62300")
	DATAMANAGER.SetDataValue(false,"ohhts_6230_002r", "InBlock1", "FIDX_INPUT_DELY_RLTM_CLS_CODE"	, 0 , g_rtChk)
	DATAMANAGER.SetDataValue(false,"ohhts_6230_002r", "InBlock1", "FIDX_INPUT_NTNL_CODE"			, 0 , sNtns)
	DATAMANAGER.SetDataValue(false,"ohhts_6230_002r", "InBlock1", "FID_COND_MRKT_CLS_CODE"			, 0 , sCmb_Makt)
	DATAMANAGER.SetDataValue(false,"ohhts_6230_002r", "InBlock1", "FIDX_INPUT_BSTP_CODE"			, 0 , cmb1.cbkeydata )
	DATAMANAGER.SetDataValue(false,"ohhts_6230_002r", "InBlock1", "FID_INPUT_DATE1"				, 0 , g_szTerm)
	DATAMANAGER.SetDataValue(false,"ohhts_6230_002r", "InBlock1", "FID_INPUT_RANK_SORT_CLS_CODE"	, 0 , g_szSort1)
	DATAMANAGER.SetDataValue(false,"ohhts_6230_002r", "InBlock1", "FID_INPUT_RANK_SORT_CLS_CODE4"	, 0 , g_szSort2)
	DATAMANAGER.SetDataValue(false,"ohhts_6230_002r", "InBlock1", "FID_INPUT_VOL1"				, 0 , "0")
	DATAMANAGER.SetDataValue(false,"ohhts_6230_002r", "InBlock1", "FIDX_INPUT_TR_PBMN"			, 0 , "0")
	DATAMANAGER.SetDataValue(false,"ohhts_6230_002r", "InBlock1", "FID_INPUT_PRC1"				, 0 , "0")
	
	DATAMANAGER.RequestTranData("ohhts_6230_002r")
end

function Process_Tran_ohhts_6230_002r()
	nDataCnt = DATAMANAGER.GetDataCount(false, "ohhts_6230_002r", "OutBlock1")
	
	if nDataCnt == "" or gf_Tonumber(nDataCnt) == 0 then
		return
	end
	
	for i = 0, nDataCnt-1 do
		szData0 = DATAMANAGER.GetDataValue(false, "ohhts_6230_002r", "OutBlock1", "FID_COND_MRKT_CLS_CODE"  , i)
		szData1 = DATAMANAGER.GetDataValue(false, "ohhts_6230_002r", "OutBlock1", "FIDX_ISCD" , i)
		szData2 = DATAMANAGER.GetDataValue(false, "ohhts_6230_002r", "OutBlock1", "FIDX_KOR_ISNM" , i)
		szData3 = DATAMANAGER.GetDataValue(false, "ohhts_6230_002r", "OutBlock1", "FIDX_PRPR" , i)
		szData4 = DATAMANAGER.GetDataValue(false, "ohhts_6230_002r", "OutBlock1", "FIDX_PRDY_CTRT", i)
		szData5 = DATAMANAGER.GetDataValue(false, "ohhts_6230_002r", "OutBlock1", "FIDX_SDPR_VRSS_PRPR_RATE", i)
		
		 --msgbox szData0 .. "|" ..szData1 .. "|" ..szData2 .. "|" ..szData3 .. "|" ..szData4
		
		nIdx = Pannel0.AddRow()
		
		szPrc = ""
		if szData3 ~= "" then
			if szData0 == "AX" or szData0 == "NY" or szData0 == "OQ" then
				szPrc = gf_CommaValue(szData3, 4)
			elseif szData0 == "JP" then
				szPrc = gf_CommaValue(szData3, 1)
			elseif szData0 == "SH" or szData0 == "SZ" then
				szPrc = gf_CommaValue(szData3, 3)
			elseif szData0 == "HK" then
				szPrc = gf_CommaValue(szData3, 3)
			end
		end
		
		 --현재가 .. 수익률
		
		
		szPrcRateAttr2 = ""
		szPrcRate2 = ""
		
		if g_szTerm == "1" then
			szPrcRate = szPrc .. " | " .. gf_CommaValue(szData4, 2) .. "%"
		else
			szPrcRate = szPrc .. " | " 
			szPrcRate2 = gf_CommaValue(szData5, 2) .. "%"
			
			
		
			szPrcRateAttr2 = "0"
	
			if gf_Tonumber(szData5) > 0 then
				szPrcRateAttr2 = "43"
			elseif gf_Tonumber(szData5) < 0 then
				szPrcRateAttr2 = "45"
			end
		end
		
		szPrcRateAttr = "0"
	
		if gf_Tonumber(szData4) > 0 then
			szPrcRateAttr = "43"
		elseif gf_Tonumber(szData4) < 0 then
			szPrcRateAttr = "45"
		end
		
		sGroupID = ""
		sFlagID = ""
		if szData0 == "AX" or szData0 == "NY" or szData0 == "OQ" then
			sGroupID = "CI_USD"
			sFlagID = "USA"
		elseif szData0 == "JP" then
			sGroupID = "CI_JPN"
			sFlagID = "JPN"
		elseif szData0 == "SH" or szData0 == "SZ" then
			sGroupID = "CI_CHN"
			sFlagID = "CHN"
		elseif szData0 == "HK" then
			sGroupID = "CI_HKG"
			sFlagID = "HKG"
		else
			sGroupID = "CI_KOR"
			sFlagID = "KOR"
		end
		
		szImgNm = Form.GetIconImg(sGroupID, szData1)
		
		if szImgNm == "" then
			szImgNm = Form.GetIconImg("FLAG", sFlagID)
			
			if szImgNm == "" then
				szImgNm = "flag_general"
			end
		end

		DisplaySetting_Pannel(nIdx, szData1, szData0, szData2, szPrcRate,szPrcRate2, szPrcRateAttr,szPrcRateAttr2, szImgNm) 
	end
	
	
end

function DisplaySetting_Pannel(nIdx, szItemCd, szMktCd, szItemNm, szPrcRate,szPrcRate2, szPrcRateAttr,szPrcRateAttr2, szImgNm)
	 --상단 라인표시
 --	if nIdx = 0 then
 --		Pannel0.SetPropCardCell("bgcolor","lblLine2", nIdx , g_szTxtColor_White)
 --	else
 --		Pannel0.SetPropCardCell("bgcolor","lblLine2", nIdx , g_szLineColor)
 --	end if
	
	Pannel0.SetPropCardCell("bgcolor","lblLine2", nIdx , g_szLineColor2)
	 --종목 국가 국기이미지 
	Pannel0.SetPropCardCell("maintainratio", "imgFlag", nIdx, "2")
	Pannel0.SetPropCardCell("imgpath","imgFlag", nIdx, szImgNm)
	
	Pannel0.SetPropCardCell("paddinginfo","lblNum",nIdx, "0,0,0,0")
	Pannel0.SetPropCardCell("fgcolor","lblNum",nIdx, g_szTxtColor_Normal)
	Pannel0.SetPropCardCell("maxlinecnt","lblNum",nIdx, "1^-2")
	Pannel0.SetPropCardCell("caption","lblNum",nIdx, nIdx+1..".")
	
	 --종목명
	Pannel0.SetPropCardCell("paddinginfo","lblItemName",nIdx, "0,0,0,0")
	Pannel0.SetPropCardCell("fgcolor","lblItemName",nIdx, g_szTxtColor_Normal)
	Pannel0.SetPropCardCell("maxlinecnt","lblItemName",nIdx, "1^-4")
	Pannel0.SetPropCardCell("caption","lblItemName",nIdx, szItemNm)
	
	 --종목코드(시장조치)
	Pannel0.SetPropCardCell("paddinginfo","lblItemCode",nIdx, "0,0,0,0")
	Pannel0.SetPropCardCell("fgcolor","lblItemCode",nIdx, g_szTxtColor_Grey)
	Pannel0.SetPropCardCell("caption","lblItemCode",nIdx, szItemCd)
	
	 --현재가(전일대비)
	Pannel0.SetPropCardCell("paddinginfo","lblItemPrc",nIdx, "0,0,0,0")
	Pannel0.SetPropCardCell("maxlinecnt","lblItemPrc",nIdx, "1")
	Pannel0.SetPropCardCell("fontbold", "lblItemPrc", nIdx, "1")
	Pannel0.SetPropCardCell("fgcolor","lblItemPrc",nIdx, g_szTxtColor_Grey)
	Pannel0.SetPropCardCell("caption","lblItemPrc",nIdx, szPrcRate)
	
	if szPrcRateAttr == "43" then
		Pannel0.SetPropCardCell("fgcolor","lblItemPrc",nIdx, g_szTxtColor_Red)
	elseif szPrcRateAttr == "45" then
		Pannel0.SetPropCardCell("fgcolor","lblItemPrc",nIdx, g_szTxtColor_Blue)
	else
		Pannel0.SetPropCardCell("fgcolor","lblItemPrc",nIdx, g_szTxtColor_Grey)
	end
	
	if szPrcRate2 ~= "" then
		Pannel0.SetPropCardCell("left","lblItemPrc0",nIdx, "190")
		
		Pannel0.SetPropCardCell("paddinginfo","lblItemPrc0",nIdx, "0,0,0,0")
		Pannel0.SetPropCardCell("maxlinecnt","lblItemPrc0",nIdx, "1")
		Pannel0.SetPropCardCell("fontbold", "lblItemPrc0", nIdx, "1")
		Pannel0.SetPropCardCell("fgcolor","lblItemPrc0",nIdx, g_szTxtColor_Grey)
		
		
		Pannel0.SetPropCardCell("caption","lblItemPrc0",nIdx, szPrcRate2)
		
		nWidth = Form.GetTextWidth(szPrcRate2, -2, false, false)
		nLeft = 190 - nWidth - 5
		Pannel0.SetPropCardCell("left","lblItemPrc",nIdx, nLeft)
		
		if szPrcRateAttr2 == "43" then
			Pannel0.SetPropCardCell("fgcolor","lblItemPrc0",nIdx, g_szTxtColor_Red)
		elseif szPrcRateAttr2 == "45" then
			Pannel0.SetPropCardCell("fgcolor","lblItemPrc0",nIdx, g_szTxtColor_Blue)
		else
			Pannel0.SetPropCardCell("fgcolor","lblItemPrc0",nIdx, g_szTxtColor_Grey)
		end
	else
		Pannel0.SetPropCardCell("left","lblItemPrc",nIdx, "190")
		Pannel0.SetPropCardCell("left","lblItemPrc0",nIdx, "400")
	end

 --	 --(숨김)종목코드
	Pannel0.SetPropCardCell("caption","lblHideData0",nIdx, szMktCd)
	Pannel0.SetPropCardCell("caption","lblHideData1",nIdx, szItemCd)
	Pannel0.SetPropCardCell("caption","lblHideData2",nIdx, szItemNm)

	Pannel0.SetPropCardCell("paddinginfo","btnHyun",nIdx, "0,0,0,0")
	Pannel0.SetPropCardCell("fgcolor","btnHyun",nIdx, g_szTxtColor_Grey)
	
	Pannel0.SetPropCardCell("paddinginfo","btnChart",nIdx, "0,0,0,0")
	Pannel0.SetPropCardCell("fgcolor","btnChart",nIdx, g_szTxtColor_Grey)
	
	Pannel0.SetPropCardCell("paddinginfo","btnInfo",nIdx, "0,0,0,0")
	Pannel0.SetPropCardCell("fgcolor","btnInfo",nIdx, g_szTxtColor_Grey)
	
	Pannel0.SetPropCardCell("paddinginfo","btnOrder0",nIdx, "0,0,0,0")
	Pannel0.SetPropCardCell("fgcolor","btnOrder0",nIdx, g_szTxtColor_White)
	
	Pannel0.SetPropCardCell("paddinginfo","btnOrder1",nIdx, "0,0,0,0")
	Pannel0.SetPropCardCell("fgcolor","btnOrder1",nIdx, g_szTxtColor_White)

	
end

function Convert_Filter1(szData)
	-- SELECT CASE 변환 (수동 보정 필요)
		if szData == "당일" then
			g_szTerm = "1"
		else
			g_szTerm = gf_Trim(string.gsub(szData, string.gsub("일", "([%p])", "%%%1"), ""))
	end
end

function Convert_Filter2(szData)
	-- SELECT CASE 변환 (수동 보정 필요)
		if szData == "상승률 높은순" then
			g_szSort1 = "0"
			g_szSort2 = "0"
		elseif szData == "하락률 높은순" then
			g_szSort1 = "0"
			g_szSort2 = "1"
		elseif szData == "거래량 많은순" then
			g_szSort1 = "2"
			g_szSort2 = "0"
		elseif szData == "거래량 낮은순" then
			g_szSort1 = "2"
			g_szSort2 = "1"
		else
			g_szSort1 = "0"
			g_szSort2 = "0"
	end
end

function MovePopup(nidx, nGbn)
	
	szMktCd = Pannel0.GetPropCardCell("caption","lblHideData0",nidx)
	szItemCd = Pannel0.GetPropCardCell("caption","lblHideData1",nidx)
	szItemNm = Pannel0.GetPropCardCell("caption","lblHideData2",nidx)
	szItemCd = szMktCd .. "@" .. szItemCd
	
	-- SELECT CASE 변환 (수동 보정 필요)
		if szMktCd == "OQ" or szMktCd == "AX" or szMktCd == "NY" or szMktCd == "SH" or szMktCd == "SZ" or szMktCd == "HK" or szMktCd == "JP" then
			Form.SetSharedData( "..ITEM_CODE" , szItemCd )
			Form.SetSharedData( "..ITEM_KORNAME" , szItemNm )
			Form.SetSharedData( "..ITEM_OVERSTOCK", szItemCd.."★"..szItemNm.."★".."", "" )					
			Form.SendMessageToMain( "CHANGE_ITEMCODE_OVERSTOCK", szItemCd.."★"..szItemNm.."★".."", "" )
			
			if nGbn == 0 then -- 현재가 end end
				Form.SendReturnToParent( "RETURN_LAYOUT" , "호가")			
			elseif nGbn == 1 then -- 차트
				Form.OpenScreen("16020", "")
			elseif nGbn == 2 then
				 --Form.TriggerEvent("#", "RETURN_LAYOUT", "종목정보")
			elseif nGbn == 3 then -- 매수
				Form.OpenScreen("16060", "0")
			elseif nGbn == 4 then -- 매도
				Form.OpenScreen("16060", "1")
			end
	end
	Form.CloseForm()
end


