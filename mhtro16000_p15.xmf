 --===============================================
 -- Form_OnFormInitBefore
 --===============================================
function Form_OnFormInitBefore()
	 --contMain.contCont.lblContent.SizeAutoFit()
end

 --===============================================
 -- Form_OnFormInit
 --===============================================
function Form_OnFormInit()
	Init_Control()
	
	local szLinkData
	szLinkData = Form.GetOpenLinkData()
	
	arrLinkData = gf_Split(szLinkData, "`")
	
	if #arrLinkData > 1 then
		g_szExidCd = arrLinkData[0+1]
		
		g_rtChk = Form.GetSharedData( "REALTIME_"..g_szExidCd, false )
		
		if g_szExidCd == "AX" or g_szExidCd == "OQ" or g_szExidCd == "NY" then
			g_szExidCd = "US"
		end
		
		g_szTypeCd = arrLinkData[1+1]
	end

	Request_Tran_ohhts_6230_001r()

end

 --===============================================
 -- imgBg_OnClick
 --===============================================
function imgBack_OnClick()
	Form.CloseForm()
end

 --============================================================================
function DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "ohhts_6230_001r" then
		Process_Tran_ohhts_6230_001r()
	elseif szTranID == "ohhts_6230_002r" then
		Process_Tran_ohhts_6230_002r()
	end
end

