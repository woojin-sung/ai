function cmb0_OnEditComplete(iIndex)
	Request_Tran_ohhts_6230_002r()
end

 --============================================================================
function cmb1_OnEditComplete(iIndex)
	Request_Tran_ohhts_6230_002r()
end

 --============================================================================
function lblSortInfo_OnClick()
	Form.OpenPopup("mhtro16000_p16", "TYPE".."★0★".."".."★".."".."★"..g_szSaveFilterData1.."★"..g_szSaveFilterData2 , "")
end

 --============================================================================
function Pannel0_OnClick(nIndex, sCellID)
		
	if sCellID == "btnHyun" then
		MovePopup(nIndex, 0)
	elseif sCellID == "btnChart" then
		MovePopup(nIndex, 1)
	elseif sCellID == "btnInfo" then
		MovePopup(nIndex, 2)
	elseif sCellID == "btnOrder0" then
		MovePopup(nIndex, 3)
	elseif sCellID == "btnOrder1" then
		MovePopup(nIndex, 4)	
	else
		nTopRow = gf_Tonumber(Pannel0.toprow)
		nGap = gf_Tonumber(nIndex) - nTopRow
		
		nCurHeight = Pannel0.GetCardWHAt(nIndex)

		if g_nFoldHeight == nCurHeight then
			Pannel0.SetPropCardCell("top","lblLine2", nIndex , g_nExpandHeight-1)
			Pannel0.SetCardWHAt(nIndex, g_nExpandHeight)
			
			if g_nPrev_Expand_Idx > -1 then
				if g_nPrev_Expand_Idx ~= nIndex then
					Pannel0.SetPropCardCell("top","lblLine2", g_nPrev_Expand_Idx , g_nFoldHeight-1)
					Pannel0.SetCardWHAt(g_nPrev_Expand_Idx, g_nFoldHeight)
				end
			end
			
			g_nPrev_Expand_Idx = nIndex
			
		
			if nGap > 7 then
				Pannel0.toprow = nTopRow + 2
			elseif nGap > 6 then
				Pannel0.toprow = nTopRow + 1
			end
			
		else
			Pannel0.SetPropCardCell("top","lblLine2", nIndex , g_nFoldHeight-1)
			Pannel0.SetCardWHAt(nIndex, g_nFoldHeight)
		end
	end
end

 --============================================================================
function Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName == "RETURN_DATA_TYPE" then
		arrOptionData = gf_Split(sRet, "★")
	
		if #arrOptionData > 0 then
			g_szSaveFilterData1 = arrOptionData[0+1]
			Convert_Filter1(g_szSaveFilterData1)
		end
		
		if #arrOptionData > 1 then
			g_szSaveFilterData2 = arrOptionData[1+1]
			
			Convert_Filter2(g_szSaveFilterData2)
		end
		
		lblSortInfo.caption = arrOptionData[1+1] .. "ㆍ" .. arrOptionData[0+1]
		Pannel0.rowcount = 0
		
		Request_Tran_ohhts_6230_002r()
	end
	
end


 --============================================================================
function Image1_OnClick()
	lblSortInfo_OnClick()
end

	
