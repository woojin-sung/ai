	<SCRIPT_INFO _len="14475" _ulen="13833" >
dofile("scr/script.lua")
dofile("scr/json.lua")
-- ****************************************************************************
--                G  L  O  B  A  L       V  A  R  I  A  B  L  E
-- ****************************************************************************
local g_sAcno
local g_sAsno
local g_sPwd
local g_sAcntNm
local g_sLinkData
-- ****************************************************************************
--             P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N              
-- ****************************************************************************
-- ===============================================
-- NULL 체크 
-- ===============================================
function isEmpty(sData)
	if gf_Trim(sData) == "" or sData == nil or gf_Trim(sData) == "null" then
		return true
	else
		return false
	end
end
-- ===============================================
-- 숫자 소수점 절사 함수
-- ===============================================
function truncateToDecimalPlaces(nVal, nDeimalPlaces)
	nVal = gf_Tonumber(nVal)
	nFactor = 10 ^ nDeimalPlaces
	szNumStr = gf_CommaValue(nVal*nFactor,12,0,0,0,1)
	nDecimalIdx = string.find(szNumStr, "%.")
	nTotalData = 0
	if gf_Tonumber(nDecimalIdx) > 0 then
		nTotalData = gf_Tonumber(string.sub(szNumStr, 1, gf_Tonumber(nDecimalIdx)-1))
	else
		nTotalData = gf_Tonumber(szNumStr)
	end
	return nTotalData / nFactor
end
-- ===============================================
-- (NonNull) 문자열 -> 배열 변환함수
-- ===============================================
function Convert_StrToArr(szData, szSeperator)
	local arrData
	-- --------------------------------------------
	-- 링크데이터 값 체크
	-- --------------------------------------------
	if isEmpty(szData) then
		arrData = {}
		return arrData
	end
	-- --------------------------------------------
	-- 구분자 값 체크
	-- --------------------------------------------
	if isEmpty(szSeperator) then
		-- 단일변수
		arrData = {}
		table.insert(arrData, szData)
	else
		-- 다중변수
		arrData = gf_Split(szData, szSeperator)
	end
	return arrData
end
function Transform_Exid(sValue)
	if sValue == "0537" then -- 나스닥
		return "OQ"
	elseif sValue == "0321" then -- 뉴욕
		return "NY"
	elseif sValue == "0066" then -- 아멕스
		return "AX"
	elseif sValue == "0215" then -- 상해
		return "SH"
	elseif sValue == "0214" then -- 심천
		return "SZ"
	elseif sValue == "0104" then -- 홍콩
		return "HK"
	elseif sValue == "0106" then -- 일본
		return "JP"
	else
		return ""
	end
end
function Init_Control()
	-- --------------------------------------------------
	-- 폼탭 헤더 생성
	-- --------------------------------------------------
	cont0.fmtabMain.setTabHeaderImage("img_bgcircle_black.9" , "img_bgcircle_line.9" , 6) --활성화/비활성화/여백
	cont0.fmtabMain.setTabHeaderFgColor("28" , "321") 								 --활성화/비활성화 폰트색상
	cont0.fmtabMain.insertPage( cont0.fmtabMain.tabcount, "page1", "page1", "empty", "0", "전체")
	cont0.fmtabMain.insertPage( cont0.fmtabMain.tabcount, "page2", "page2", "empty", "0", "현금")
	cont0.fmtabMain.currenttab = 0
	cont0.grd0.SetCellMaxLineCount("bd_cell01", 2)
end
-- ****************************************************************************
--                C  O  M  M  O  N       F  U  N  C  T  I  O  N               
-- ****************************************************************************
-- =============================================================================
function Form_OnFormInit()
	Init_Control()
	g_sLinkData = Form.GetOpenLinkData()
	arrLinkData = Convert_StrToArr(g_sLinkData, "`")
	nArrCnt = #arrLinkData
	sChk = Form.GetEnvData("17100_PJANGO_CHK")
	if isEmpty(sChk) == false then
		cont0.chk0.chksilence = sChk
	end
	if nArrCnt >= 3 then
		g_sGbn = arrLinkData[1]
		g_sAcno = arrLinkData[2]
		g_sAsno = arrLinkData[3]
		DATAMANAGER.RequestTranData("obtro_oder_267r")
		return
	end
end
