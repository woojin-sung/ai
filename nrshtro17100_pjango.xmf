function imgBg_OnClick()
	Form.CloseForm()
end
-- =============================================================================
function DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID == "obtro_oder_267r" then
		cont0.imgNoData.visible = false
		cont0.lblNoData.visible = false
		DATAMANAGER.ClearInputData(0, "obtro_oder_267r")
		DATAMANAGER.SetDataValue(0, "obtro_oder_267r", "InBlock1", "ACNO" 		  , 0 , g_sAcno)
		DATAMANAGER.SetDataValue(0, "obtro_oder_267r", "InBlock1", "ASNO" 		  , 0 , g_sAsno)
		sUserID = Form.GetSharedData("&USER_ID", false)
		DATAMANAGER.SetDataValue(0, "obtro_oder_267r", "InBlock1", "ELFN_ID" 	  , 0 , sUserID)
		szChk0 = "N"
		if cont0.chk0.checkstate == "1" or gf_Tonumber(cont0.chk0.checkstate) == 1 then --비용포함
			szChk0 = "Y"
		else
			szChk0 = "N"
		end
		DATAMANAGER.SetDataValue(0, "obtro_oder_267r", "InBlock1", "FEE_INCU_YN"	  		, 0 , szChk0)	--비용포함
		DATAMANAGER.SetDataValue(0, "obtro_oder_267r", "InBlock1", "DYTM_TR_CLPR_APLY_YN"	, 0 , "Y") 	--주간시세 적용여부(YN)
		DATAMANAGER.SetDataValue(0, "obtro_oder_267r", "InBlock1", "IQRY_CLS_CODE" 		, 0 , "1") 	--대출합산 적용여부(1:개별, 2:합산)
		DATAMANAGER.SetDataValue(0, "obtro_oder_267r", "InBlock1", "PROS_CLS" 			, 0 , "1") 	--원화 적용여부(1:외화, 2:원화)
		-- -----------------------------------------------------------------
		-- 자동감시 주문은 미국종목만 대상으로 함 (추후 국가 추가될 수 있음)
		-- -----------------------------------------------------------------
		sCrcd = "840"
		DATAMANAGER.SetDataValue(0, "obtro_oder_267r", "InBlock1", "UI_IQRY_COND_CNTT" 		, 0 , sCrcd) 	--적용 통화코드
		nTab = gf_Tonumber(cont0.fmtabMain.currenttab)
		DATAMANAGER.SetDataValue(0,  "obtro_oder_267r", "InBlock1", "RMND_CLCD"		, 0 , "3") 	--적용 통화코드
	end
end
-- =============================================================================
function DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obtro_oder_267r" then
		for i = 0, cont0.grd0.rowcount-1 do
			cont0.grd0.setCellFgColor("bd_cell51", i, g_szTxtColor_Grey)
			stnd_exrt		= string.gsub(cont0.grd0.GetCellData("bd_cell15", i), ",", "")	--기준환율
			szItemCd		= cont0.grd0.GetCellData("bd_cell16", i)	--종목코드
			exch			= cont0.grd0.GetCellData("bd_cell72", i)	--거래소구분코드
			vltn_prls_amt 	= string.gsub(cont0.grd0.GetCellData("bd_cell06", i), ",", "")	--평가손익
			byov_amt 		= string.gsub(cont0.grd0.GetCellData("bd_cell9", i) , ",", "")
			psnt_prc		= string.gsub(cont0.grd0.GetCellData("bd_cell10", i), ",", "")
			nation		= cont0.grd0.GetCellData("bd_cell12", i)
			vltn_amt		= string.gsub(cont0.grd0.GetCellData("bd_cell8", i), ",", "")
			byov_prc		= string.gsub(cont0.grd0.GetCellData("bd_cell11", i), ",", "")
			local sType, nOwnQty, nAbleQty
			sTemp = cont0.grd0.GetCellData("bd_cell16", i)
			sType = cont0.grd0.GetCellData("bd_cell18", i)
			nOwnQty = gf_Tonumber(cont0.grd0.GetCellData("bd_cell17", i))
			nAbleQty = gf_Tonumber(cont0.grd0.GetCellData("bd_cell67", i))
			if sType == "1" then
				nOwnQty = gf_CommaValue(nOwnQty, 0)
				nAbleQty = gf_CommaValue(nAbleQty, 0)
				cont0.grd0.SetCellData("bd_cell11", i, "일반")
			elseif sType == "2" then
				-- 20241023_01 HWG START : 소수점잔고 표기오류 개선
				arrData = gf_Split(tostring(nOwnQty), ".")
				arrData2 = gf_Split(tostring(nAbleQty), ".")
				nOwnQty = gf_CommaValue(arrData[1], 0)
				nAbleQty = gf_CommaValue(arrData2[1], 0)
				if #arrData > 1 then
					nOwnQty = nOwnQty .. "." .. arrData[2]
				end
				if #arrData2 > 1 then
					nAbleQty = nAbleQty .. "." .. arrData2[2]
				end
				-- 20241023_01 HWG END
				cont0.grd0.SetCellData("bd_cell11", i, "소수점")
				cont0.grd0.SetCellData("bd_cell51", i, "소수점 | " .. sTemp )
			end
			cont0.grd0.SetCellData("bd_cell04", i, nOwnQty)
			cont0.grd0.SetCellData("bd_cell54", i, nAbleQty)
			sType = cont0.grd0.GetCellData("bd_cell53", i)
			if sType == "01" then
				cont0.grd0.SetCellData("bd_cell51", i, "현금 | " .. sTemp )
			elseif sType == "02" then
				cont0.grd0.SetCellData("bd_cell51", i, "대출 | " .. sTemp )
			end
			if gf_Tonumber(vltn_prls_amt) > 0 then
				cont0.grd0.SetCellFgColor("bd_cell06", i, "10")
			elseif gf_Tonumber(vltn_prls_amt) < 0 then
				cont0.grd0.SetCellFgColor("bd_cell06", i, "11")
			else
				cont0.grd0.SetCellFgColor("bd_cell06", i, "4")
			end
			szKorExch = Form.GetMetaData("해외주식거래국가코드", exch)
			cont0.grd0.SetCellData("bd_cell60", i, szKorExch)
			loan_type = Form.GetMetaData("대출상세유형코드", cont0.grd0.GetCellData("bd_cell69", i))
			cont0.grd0.SetCellData("bd_cell59", i, loan_type)
			-- 20240919_01 HWG START : 종합잔고 텍스트 색상조정
			tmp_prc = string.gsub(cont0.grd0.GetCellData("bd_cell05", i), ",", "")
			tmp_clpr = string.gsub(cont0.grd0.GetCellData("bd_cell20", i), ",", "")
			-- 20240919_01 HWG END
			if gf_Tonumber(tmp_prc) > gf_Tonumber(tmp_clpr) then
				cont0.grd0.SetCellFgColor("bd_cell05", i, "10")
			elseif gf_Tonumber(tmp_prc) < gf_Tonumber(tmp_clpr) then
				cont0.grd0.SetCellFgColor("bd_cell05", i, "11")
			else
				cont0.grd0.SetCellFgColor("bd_cell05", i, "4")
			end
			szItemCode = cont0.grd0.GetCellData("bd_cell16", i)
			szExchCode = string.sub(cont0.grd0.GetCellData("bd_cell70", i), -2)
			cont0.grd0.SetCellData("bd_cell21", i, szExchCode.."@"..szItemCode)
		end
		if DATAMANAGER.IsMoreNextData("obtro_oder_267r") == true then
			DATAMANAGER.RequestNextData("obtro_oder_267r")
		else
			if gf_Tonumber(cont0.grd0.rowcount) == 0 then
				cont0.imgNoData.visible = true
				cont0.lblNoData.visible = true
			else
				cont0.imgNoData.visible = false
				cont0.lblNoData.visible = false
			end
		end
	end
end
