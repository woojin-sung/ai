-- =============================================================================
function cont0_grd0_OnClickUp(lRow, szCellID)
	sType = cont0.grd0.GetCellData("bd_cell18", lRow)
	if sType == "2" then
		Form.ShowAlert("알림", "소수점 잔고는 자동 주문이\n불가해요.")
		return
	end
	sType = cont0.grd0.GetCellData("bd_cell53", lRow)
	if sType == "02" then
		Form.ShowAlert("알림", "대출 잔고는 자동 주문이\n불가해요.")
		return
	end
	sVndrCode 	= cont0.grd0.GetCellData("bd_cell66", lRow)
	szOffChk = Transform_Exid(sVndrCode)
	if szOffChk == "" then
		Form.ShowAlert("알림", "해당 종목은 온라인에서\n거래가 불가합니다.\n\n영업점 또는 해외주식 데스크로 문의해주세요")
		return
	end
	szNowCode = cont0.grd0.GetCellData("bd_cell21", lRow)			--종목코드
	szExchCd = string.sub(cont0.grd0.GetCellData("bd_cell70", lRow), -2) 	--거래소코드
	szAvrgPrc = cont0.grd0.GetCellData("bd_cell55", lRow)			--평균단가
	sLinkData = szNowCode
	sLinkData = sLinkData .. "`" .. szExchCd  .. "`" .. szAvrgPrc
	Form.SendReturnToParent("RETURN_JANGO" , sLinkData)
	Form.CloseForm()
end
