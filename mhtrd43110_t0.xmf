<?xml version="1.0" encoding="utf-8"?>

<ROOT>
	<MAP_INFO scrno="43110" scrname="해외선옵-관심-스타일" version="2" writer="아이티젠" />
	<FORM_INFO name="Form" ly_vert="0,0,375,517,1" />
	<CONTROL_INFO>
		<LINKFORM name="LinkFm" ly_vert="0,0,375,517,1" />
	</CONTROL_INFO>
	<SCRIPT_INFO _len="3042" _ulen="2836" >
dofile("scr/script.lua")
dofile("scr/json.lua")
 --============================================================================
 -- 화 면 명 : 관심종목_스타일_Main
 -- 화면설명 : 관심종목 스타일이 변경될때 화면전환시키는 메인화면
 -- 작    성 : 2016.01.08 ssang
 --============================================================================

 --****************************************************************************
 --               G  L  O  B  A  L       V  A  R  I  A  B  L  E
 --****************************************************************************
local g_szScreen
g_szScreen = ""

 --****************************************************************************
 --            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
 --****************************************************************************

 --****************************************************************************
 --               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
 --****************************************************************************

 --============================================================================
 -- Form_OnFormInit
 --============================================================================
function Form_OnFormInit()
	if gf_Trim(g_szScreen) == "" then
	
		LinkFm.linkfile = "mhtrd43110_t1"
	else
		LinkFm.linkfile = g_szScreen
	end
end

 --============================================================================
 -- Form_OnTriggerEvent
 --============================================================================
function Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "GLOBAL_INTR_STYLE" then
		if sParam == "SET_STYLE1" then
			LinkFm.linkfile = "mhtrd43110_t1"
			g_szScreen = "mhtrd43110_t1"
		end
	 -- ----------------------------------------------------------------------
	 -- 메인화면에서 관심종목 조회를 요청 Trigger
	 -- ----------------------------------------------------------------------	
	elseif sEventName == "GLOBAL_INTR_LIST" then
		Form.TriggerEvent("LinkFm", "GLOBAL_INTR_LIST", sParam)
	 -- ----------------------------------------------------------------------
	 -- 메인화면에서 관심종목 추가 Trigger
	 -- ----------------------------------------------------------------------	
	elseif sEventName == "GLOBAL_INTR_LIST_ADD" then
		Form.TriggerEvent("LinkFm", "GLOBAL_INTR_LIST_ADD", sParam)
	 -- ----------------------------------------------------------------------
	 -- 그룹변경시 바로 적용(스타일2에 필요한 트리거)
	 -- ----------------------------------------------------------------------	
	elseif sEventName == "GLOBAL_INTR_GROUP_CHANGE" then
		Form.TriggerEvent("LinkFm", "GLOBAL_INTR_GROUP_CHANGE", "")
	 -- ----------------------------------------------------------------------
	 -- 메인화면에서 차트설정 변경후 조회를 요청 Trigger
	 -- ----------------------------------------------------------------------	
	elseif sEventName == "SET_CHART" then
		Form.TriggerEvent("LinkFm", "SET_CHART", sParam)
	end
end



	
</SCRIPT_INFO>
</ROOT>