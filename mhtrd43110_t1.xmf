 --============================================================================
 -- Form_OnFormInit
 --============================================================================
function Form_OnFormInit( )
	 -- 관심 동기화 //////////////////////////////////////////////////////////
	g_szCloud = Form.GetEnvData("common.interest_cloud")
	
	if gf_Trim(g_szCloud) == "" then -- 초기값 : 1(동기화 사용) end end
		g_szCloud = "1"
	end
	 -- //////////////////////////////////////////////////////////////////////v
	
	grdList0.SetSiseCtrlId("bd_hyun:bd_debi:bd_rate:bd_bong:bd_vol")
	
	 --20240405 KKM 상승/하락/보합으로 하이라이트색상지정
	grdList0.SetHLColorCellId("bd_debiIcon")	
	 --20240405 KKM 멀티라인 설정될 때 최대 두줄까지만 설정되도록
	grdList0.SetCellMaxLineCount("bd_name", 2)	
end

 --============================================================================
 -- Form_OnPopupReturn
 --============================================================================
function Form_OnPopupReturn(sKeyName, sRet)
	 -- ----------------------------------------------------------------------
	 -- 무브팝업리턴 받아 화면 이동
	 -- ----------------------------------------------------------------------		
	if sKeyName == "MOVEPOP_RETURN" then
		local tChk
		local szChk
		
		if sRet == "" then
			return
		end
		
		tChk = gf_Split(sRet, "★")
		
		szChk = tChk[0+1]
		
		if szChk ~= "" then
			if tChk[1+1] == "0" then -- 현재가 end end
				Form.OpenScreen("43100", g_szSltCd)
			elseif tChk[1+1] == "1" then -- 차트
				Form.OpenScreen("43300", g_szSltCd)
			elseif tChk[1+1] == "2" then -- 매수
				 --20200331 HWG START : 고유MTS
				szMediaCode = Form.GetSharedData("..MEDIA_CODE", false)
				
				 --20210804 SWJ START : 모의투자 매체코드 추가
				if szMediaCode == "156" or szMediaCode == "157" or szMediaCode == "412" or szMediaCode == "413" then
					Form.OpenScreen("44300", "관심종목★0" .. "★" .. g_szSltCd)
				elseif szMediaCode == "158" or szMediaCode == "159" then
					Form.OpenScreen("03000", "관심종목★0" .. "★" .. g_szSltCd)
				end
				 --20200331 HWG END
			elseif tChk[1+1] == "3" then -- 매도
				 --20200331 HWG START : 고유MTS
				szMediaCode = Form.GetSharedData("..MEDIA_CODE", false)
				
				 --20210804 SWJ START : 모의투자 매체코드 추가
				if szMediaCode == "156" or szMediaCode == "157" or szMediaCode == "412" or szMediaCode == "413" then
					Form.OpenScreen("44300", "관심종목★1" .. "★" .. g_szSltCd)
				elseif szMediaCode == "158" or szMediaCode == "159" then
					Form.OpenScreen("03000", "관심종목★1" .. "★" .. g_szSltCd)
				end
				 --20200331 HWG END
			end
		end
	end
end

 --============================================================================
 -- Form_OnTriggerEvent
 --============================================================================
function Form_OnTriggerEvent(sEventName, sParam)
	 -- ----------------------------------------------------------------------
	 -- 메인화면에서 관심종목 조회를 요청 Trigger
	 -- ----------------------------------------------------------------------	
	if sEventName == "GLOBAL_INTR_LIST" then
		if sParam ~= "" then
			tData = gf_Split(sParam, "♥")
			
			g_szGSID = tData[0+1]
			edtvrsnID.caption = tData[1+1]
			
			Init_grdMk( )		 -- 실시간 해제
			
			grdList0.rowcount = 0
			grdCode.rowcount = 0
			
			
			 -- 실시간 하이라이트 표시
			grdList0.highlightuse = "0"
				
			if Form.GetEnvData("GLOBAL_INTR_RORDER") == "1" then
				Form.SetCtlProp("grdList0", "highlightuse", "1")
			end
	
			 -- 종목선택시 연결화면(0:연결화면, 1:현재가, 2:주문, 3:차트)
			g_szMove = Form.GetEnvData("GLOBAL_INTR_SCREEN_MOVE")
			
			if gf_Trim(g_szMove) == "" then
				g_szMove = "0"
			end
			
			if g_szGSID == "BB" then -- 최근조회 종목 end end
				szRecent = Form.GetRecentHistory("34")
				
				Load_RecentList(szRecent)
			elseif g_szGSID == "CC" then -- 보유종목
				DATAMANAGER.RequestTranData("obtrd_oder_529r")
			else
				 -- 관심그룹의 종목을 재설정
				init_GWList( )			
			end
		end
	 -- ----------------------------------------------------------------------
	 -- 메인화면에서 관심종목 추가 Trigger
	 -- 20160407 : 종목다중선택 로직 추가
	 -- ----------------------------------------------------------------------	
	elseif sEventName == "GLOBAL_INTR_LIST_ADD" then
		local nRow
		local szCode, szName
		
		nRow = 0
		szCode, szName = "", ""
		g_tCode = {}

		if sParam ~= "" then
			tData = gf_Split(sParam, "★")
			
			if gf_Trim(tData[0+1]) ~= "" then
				g_tCode = gf_Split(tData[0+1], ":")
				
				nRow = grdCode.rowcount
				
				if #g_tCode == 1 then
					for i = 0, nRow - 1 do
						szCode = gf_Trim(grdCode.GetCellData("bd_code", i))
						
						if szCode == gf_Trim(g_tCode[0+1]) then
							szName = Form.GetItemCodeInfo(g_tCode[0+1], "name")
							g_szCd = g_tCode[0+1]
							
							Form.MsgBox(g_szTitle, szName .. "은(는) 이미 등록되어 있습니다.\r\n\n중복해서 등록하시겠습니까?", "ADD_ITEM", 1)
						end
					end
					
					g_szCd = g_tCode[0+1]
					g_GrpName = tData[1+1]
					Init_grdMk( )		 -- 실시간 해제
					Add_Item(0)
					
				elseif #g_tCode > 1 then
					for j = 0, #g_tCode - 1 do
						for i = 0, nRow - 1 do
							szCode = gf_Trim(grdCode.GetCellData("bd_code", i))
							
							if szCode == gf_Trim(g_tCode[j]) then
								g_szCd = g_tCode[j]
								g_GrpName = tData[1+1]
								
								Form.MsgBox(g_szTitle, "선택종목들 중 이미 등록되어 있는 종목이 있습니다.\r\n\n중복해서 등록하시겠습니까?", "ADD_ITEMS", 1)
								return
							end
						end
					end
					
					 -- 20160411 : 확인이 다 되었으면 리스트에 담는다.
					for k = 0, #g_tCode - 1 do
						g_szCd = g_tCode[k]
						g_GrpName = tData[1+1]
						Init_grdMk( )		 -- 실시간 해제
						Add_Item(1)
					end
						
					Check_LocalOrServer( )
				end
			end
		end
	end
end

 --============================================================================
 -- Form_OnMsgBoxClose
 --============================================================================
function Form_OnMsgBoxClose(sKeyName, sRet)
	 -- 종목 추가
	if sKeyName == "ADD_ITEM" then
		if sRet == "ok" then
			Add_Item(0)
		end
	 -- 20160407 : 다건종목 추가
	elseif sKeyName == "ADD_ITEMS" then
		if sRet == "ok" then
			for j = 0, #g_tCode - 1 do
				g_szCd = g_tCode[j]
				Add_Item(1)
			end
			
			Check_LocalOrServer( )		
		end
	end
end

 --============================================================================
 -- DATAMANAGER_OnSendTranBefore
 --============================================================================
function DATAMANAGER_OnSendTranBefore(szTranID)
	DATAMANAGER.ClearInputData(0, szTranID)
	 -- ----------------------------------------------------------------------
	 -- 보유종목 조회
	 -- ----------------------------------------------------------------------	
	if szTranID == "obtrd_oder_529r" then
		grdCode.rowcount = "0"
		DATAMANAGER.SetDataValue(0, "obtrd_oder_529r", "InBlock1", "ELFN_ID", 0, Form.GetSharedData("..USER_ID", false))
	 -- ----------------------------------------------------------------------
	 -- 관심종목 종목 조회
	 -- ----------------------------------------------------------------------
	elseif szTranID == "ohhts_intr_027r" then
		grdCode.rowcount = "0"
		
		DATAMANAGER.SetDataValue(0, "ohhts_intr_027r", "InBlock1", "FID_USER_ID",          0, Form.GetSharedData("..USER_ID", false))	 -- USER ID	
		DATAMANAGER.SetDataValue(0, "ohhts_intr_027r", "InBlock1", "FID_CNCN_ISSU_GRP_ID", 0, g_szGSID)								 -- 관심그룹ID	
	 -- ----------------------------------------------------------------------
	 -- 관심종목 데이터조회
	 -- ----------------------------------------------------------------------
	elseif szTranID ==  "ohhts_6500_002r" then
		grdList0.rowcount = "0"		 -- 종목조회그리드 초기화
		
		local szExch, szCode
		for i = 0, grdCode.rowcount-1 do
			szExch = gf_Trim(grdCode.GetCellData("bd_exch", i) )
			szCode = gf_Trim(grdCode.GetCellData("bd_code", i) )
			
			if szExch ~= "" then
				DATAMANAGER.SetDataValue( 0 , szTranID , "InBlock1" , "FID_OVDV_QTTN_EXCH_NAME" , i , szExch )
				DATAMANAGER.SetDataValue( 0 , szTranID , "InBlock1" , "FID_OVDV_ISCD"           , i , szCode )
			else
			    DATAMANAGER.SetDataValue( 0 , szTranID , "InBlock1" , "FID_OVDV_QTTN_EXCH_NAME" , i , "" )
			    DATAMANAGER.SetDataValue( 0 , szTranID , "InBlock1" , "FID_OVDV_ISCD"           , i , "" )
			end
		end
	 -- ----------------------------------------------------------------------
	 -- 관심 수정 TR : 종목추가82
	 -- ----------------------------------------------------------------------
	elseif szTranID == "ohhts_intr_029r" then
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "FID_USER_ID",     0, Form.GetSharedData("..USER_ID", false))	 -- FID사용자ID
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "FID_VRSN_ID",     0, edtvrsnID.caption)						 -- FID버전ID	
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "FID_MOD_YN",      0, "0")									 -- FID수정여부				
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock1", "FID_ISSU_MOD_YN", 0, "0")									 -- FID종목수정여부
		
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock2", "FID_CNCN_ISSU_GRP_ID", 0, g_szGSID)							 -- FID관심종목그룹ID
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock2", "FID_CNCN_GRP_NAME",    0, g_GrpName)						 -- FID관심그룹명	
		DATAMANAGER.SetDataValue(0, szTranID, "InBlock2", "FID_ISSU_MOD_YN",      0, "1")								 -- FID종목수정여부
		
		local szCode , szExch , szMemo , szName
		for j = 0, grdCode.rowcount - 1 do
			szCode = grdCode.GetCellData("bd_code", j)
			szExch = grdCode.GetCellData("bd_exch", j)
			szMemo = grdCode.GetCellData("bd_memo", j)
			szName = grdCode.GetCellData("bd_name", j)
			
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock3", "FID_CNCN_ISSU_GRP_ID", j, g_szGSID)						 -- FID관심종목그룹	
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock3", "FID_CNCN_ISSU_ID2",    j, Change_Len(j))					 -- FID관심종목
			
			if gf_Trim(szCode) == "EMPTY" then
				if gf_Trim(szMemo) == "" then
					DATAMANAGER.SetDataValue(0, szTranID, "InBlock3", "FID_CODE_CLS_CODE", j, "2")	 -- 빈칸 / FID코드구분코드
				else
					DATAMANAGER.SetDataValue(0, szTranID, "InBlock3", "FID_CODE_CLS_CODE", j, "3")	 -- 메모 / FID코드구분코드
				end
				
				DATAMANAGER.SetDataValue(0, szTranID, "InBlock3", "FID_OVDV_ISCD", j, "EMPTY")		 -- FID관심종목코드
				DATAMANAGER.SetDataValue(0, szTranID, "InBlock3", "FID_MEMO_CNTT", j, szMemo)			 -- FID메모내용
				
			else
				DATAMANAGER.SetDataValue(0, szTranID, "InBlock3", "FID_CODE_CLS_CODE", j, "1")		 -- 종목 / FID코드구분코드
				
				DATAMANAGER.SetDataValue(0, szTranID, "InBlock3", "FID_OVDV_ISCD", j, szCode)			 -- FID관심종목코드
				DATAMANAGER.SetDataValue(0, szTranID, "InBlock3", "FID_MEMO_CNTT", j, "")			 -- FID메모내용
			end
			
			DATAMANAGER.SetDataValue(0, szTranID, "InBlock3", "FID_INPUT_MRKT_CLS_CODE", j, szExch)	 -- FID입력시장구분코드
			
			
 --Form.Log("\n[_DEBUG]", "\n:j:" .. j ..":\n:szCode:".. szCode ..":\n:szExch:".. szExch ..":\n:"..
 --"szMemo:".. szMemo ..":\n:szName:".. szName ..":\n:"..
 --"FID_CODE_CLS_CODE:".. DATAMANAGER.GetDataValue(0, szTranID, "InBlock3", "FID_CODE_CLS_CODE", j) ..":")
		end
	end
end

 --============================================================================
 -- DATAMANAGER_OnReceiveTranComplete
 --============================================================================
function DATAMANAGER_OnReceiveTranComplete(szTranID)
	local szCode , szExch , szMemo
	local szCode2 , nCnt , nRow
	 -- 종목의 시장구분은 조회데이터가 잘못된 값이 내려올수 있으므로 메인에서 받아와야한다.	 -- --''''''''''''''''	
	 -- ----------------------------------------------------------------------
	 -- 보유종목/관심종목 종목
	 -- ----------------------------------------------------------------------	
	if szTranID == "obtrd_oder_529r" or szTranID == "ohhts_intr_027r" then
		if szTranID == "obtrd_oder_529r" then
			nCnt = DATAMANAGER.GetDataCount(0, "obtrd_oder_529r", "OutBlock1")
			
			if nCnt > 0 then
				nRow = 0
				
				for i = 0, nCnt -1 do
					szCode = DATAMANAGER.GetDataValue(0, "obtrd_oder_529r", "OutBlock1", "FISCD", i)
					grdCode.insertrow = nRow
					
					szExch = Form.GetItemCodeInfo(szCode, "exchname")
					
					grdCode.SetCellData("bd_code", nRow, szCode)
					grdCode.SetCellData("bd_name", nRow, Form.GetItemCodeInfo(szCode, "name"))	 -- 20160325 위젯위해 종목명 추가
					
					grdCode.SetCellData("bd_exch", nRow, szExch)
					
					nRow = nRow + 1
				end
			end
			
		 -- 관심종목 종목 조회
		elseif szTranID == "ohhts_intr_027r" then
			nRow = grdCode.rowcount
			
			for i = 0, nRow - 1 do
				szCode = grdCode.GetCellData("bd_code", i)
				szExch = Form.GetItemCodeInfo(szCode, "exchname")
				
				
				grdCode.SetCellData("bd_exch", i, szExch)
				grdCode.SetCellData("bd_name", i, Form.GetItemCodeInfo(szCode, "name"))	 -- 20160325 위젯위해 종목명 추가
			end
		end
		
		 -- 메인화면에서 종목추가 가능하므로 메인화면에 종목리스트 카운트를 알린다.
		Form.SetCtlProp("##edtListCnt", "caption", grdCode.rowcount)

		Save_GWList( )		 -- 동기화 상태일때도 파일에는 계속저장
		Save_grdMk( )		
	 -- ----------------------------------------------------------------------
	 -- 관심종목 종목데이터 조회
	 -- ----------------------------------------------------------------------
	elseif szTranID == "ohhts_6500_002r" then
		 -- 메모셀 적용 ////////////////////////////////////////////////////////
		 -- -> MTS마스터에 없는 종목 보이지 않기 20160321
 --		For i =  grdCode.rowcount - 1 to 0 step -1
		for i = 0, grdCode.rowcount - 1 do
			szMemo = grdCode.GetCellData("bd_memo", i)
			szCode = grdCode.GetCellData("bd_code", i)
			szName = grdCode.GetCellData("bd_name", i)
			szExch = grdCode.GetCellData("bd_exch", i)
	
			if gf_Trim(szMemo) ~= "" then
				grdList0.SetPropGridCell("memo", "bd_code", i, szMemo)
			end
			
			if gf_Trim(szExch) == "" and gf_Trim(szCode) ~= "EMPTY" then
				grdList0.SetCellData("bd_name", i, szCode)
				grdList0.SetCellFgColor("bd_name", i, "127")
			else
				grdList0.SetCellData("bd_name", i, szName)  --20240401 KKM 종목명 추가				
			end
			
			grdList0.SetCellFgColor("bd_code", i, "321")  --20240401 KKM 종목코드 폰트색상변경
			
			 -- ++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++		
		end
		 -- //////////////////////////////////////////////////////////////////
		
		 -- 실시간을 위한 작업 //////////////////////////////////////////////
		DATAMANAGER.ClearInputData( 1, "ohhts_ovdv_cntf" )
		
		for j = 0, grdMk.rowcount - 1 do
			szCode = grdMk.GetCellData("bd_code", j)
			szExch = grdMk.GetCellData("bd_exch", j)
			
			if szCode ~= "" and szExch ~= "" then
				tCode = gf_Split(szCode, "★")
				
				for k = 0, #tCode-1 do
					if szExch ~= "" then
						Set_Real_Input(k, tCode[k+1])
					end
				end
				
				Real_RequestData( )
			end
		end
		 -- //////////////////////////////////////////////////////////////////
	 -- ----------------------------------------------------------------------
	 -- 관심 수정 TR : 종목추가
	 -- ----------------------------------------------------------------------
	elseif szTranID == "ohhts_intr_029r" then
		Form.SetCtlProp("##edtvrsnID", "caption", edtvrsnID.caption)
		Form.SetCtlProp("##edtListCnt", "caption", grdCode.rowcount)
		
		Save_grdMk( )
	end
end
	
 --============================================================================
 -- grdList0_OnClickUp : 현재가 그리드 클릭
 --============================================================================
function grdList0_OnClickUp(lRow, szCellID)
	szCd = grdList0.GetCellData("bd_code", lRow)
	if gf_Trim(szCd) == "" then
		return
	end
	
	g_szSltCd = szCd
	
	listLocation =  gf_Split(grdList0.location,":")
	nYPos = Int(listLocation[1+1])
	height = listLocation[3+1]
	
	Move_Popup(nYPos, height)
end

	
