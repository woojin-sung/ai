 --============================================================================
 -- 화 면 명 : 관심종목_스타일1
 -- 화면설명 : 관심종목_스타일1
 -- 작    성 : 2015.12.21 ~ 2016.  .       ssang
 --============================================================================

 --****************************************************************************
 --               G  L  O  B  A  L       V  A  R  I  A  B  L  E
 --****************************************************************************

 -- 관심그룹 Key
local g_szGSID
g_szGSID = ""

local g_szCloud -- 관심동기화(0:미사용(로컬), 1:사용(서버))

 -- 종목선택시 연결화면(0:연결화면, 1:현재가, 2:주문, 3:차트)
local g_szMove
g_szMove = "0"

 -- 화면에서 종목추가위해 선택관심그룹명 필요
local g_GrpName

 -- 20160126 선택팝업관련 추가사항
local g_szSltCd --, szMk

 -- 20160309 중복종목 체크
local g_szCd
g_szCd = ""

local g_szTitle
g_szTitle = "알림"

 -- 20160407 종목다중선택을 위해 필요한 변수
local g_tCode[ +1]
g_tCode = {}


 --****************************************************************************
 --            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
 --****************************************************************************

 --============================================================================
 -- init_GWList :  관심그룹의 종목 재설정 (로컬/서버)
 --============================================================================
function init_GWList( )
	 -- 설정에서 구분자를 받아온다.
	if g_szCloud == "1" then
		
		DATAMANAGER.RequestTranData("ohhts_intr_027r")
	else
		 -- 로컬 저장된 관심종목 가져오기
		Load_GWList( )
	end
end

 --============================================================================
 -- Set_Real_Input : real_input 정의
 --============================================================================
function Set_Real_Input(nIdx, szCd)
	DATAMANAGER.SetDataValue(1, "ohhts_ovdv_cntf", "InBlock1", "FID_OVDV_ISCD", nIdx, szCd)
end

 --============================================================================
 -- Real_RequestData : Real 요청
 --============================================================================
function Real_RequestData( )
	DATAMANAGER.RequestRealData("ohhts_ovdv_cntf")
end

 --============================================================================
 -- Cancel_RequestReal : Real 해제
 --============================================================================
function Cancel_RequestReal( )
	DATAMANAGER.CancelRealData("ohhts_ovdv_cntf")
end

 --============================================================================
 -- Load_RecentList :  최근조회종목 리스트
 --============================================================================
function Load_RecentList(szData)
	local tList
	local szExch, szName
	
	grdCode.rowcount = 0
	
	if gf_Trim(szData) ~= "" then
		tList = gf_Split(szData, "`")
		
		for i = 0, #tList-1 do
			szExch = Form.GetItemCodeInfo( tList[i+1] , "exchname" )
			szName = Form.GetItemCodeInfo( tList[i+1] , "name" )
			
			grdCode.insertrow = i
			grdCode.SetCellData( "bd_code" , i , tList[i+1] )
			grdCode.SetCellData( "bd_exch" , i , szExch   )
			grdCode.SetCellData( "bd_memo" , i , ""       )
			grdCode.SetCellData( "bd_name" , i , szName   )
		end
	
		Form.SetCtlProp("##edtListCnt", "caption", grdCode.rowcount)

		Save_grdMk( )		
	end
end

 --============================================================================
 -- Load_GWGroup :   -- 로컬 저장된 관심종목 가져오기
 --============================================================================
function Load_GWList( )
	local tGroup, tList
	
	grdCode.rowcount = 0
	szGroup = Form.LoadConfigData("GLOBAL_INTR", g_szGSID)

	if gf_Trim(szGroup) ~= "" then
		tGroup = gf_Split(szGroup, "♣")

		for i = 0, #tGroup-1 do
			tList = gf_Split(tGroup[i+1], "★")
			
			grdCode.insertrow = i
	
			grdCode.SetCellData("bd_code", i, tList[0+1])
			grdCode.SetCellData("bd_exch",   i, tList[1+1])
			grdCode.SetCellData("bd_memo", i, tList[2+1])
			grdCode.SetCellData("bd_name", i, tList[3+1])	 -- 20160325 위젯위해 종목명 추가
		end
	
		Form.SetCtlProp("##edtListCnt", "caption", grdCode.rowcount)

		Save_grdMk( )
	end
end

 --============================================================================
 -- Save_GWList
 --============================================================================
function Save_GWList( )
	local szList, szCd, szMk

	for i = 0, grdCode.rowcount-1 do
		szCd = grdCode.GetCellData("bd_code", i)
		szMk = grdCode.GetCellData("bd_exch",   i)
		
		if gf_Trim(szMk) == "" then
			szMk = ""
		end

		 -- 20160325 위젯위해 종목명 추가
		if i == 0 then
			szList = szCd  .. "★" .. szMk .. "★" .. grdCode.GetCellData("bd_memo", i) .. "★" .. grdCode.GetCellData("bd_name", i)
		else
			szList = szList .. "♣" .. szCd .. "★" .. szMk .. "★" .. grdCode.GetCellData("bd_memo", i) .. "★" .. grdCode.GetCellData("bd_name", i)
		end
	end

	 -- 동기화 시는 파일 저장만.. /////////////////////////////////////////////
	Form.SaveConfigData("GLOBAL_INTR", g_szGSID, szList)

	if g_szCloud == "0" then
		Form.SetCtlProp("##edtListCnt", "caption", grdCode.rowcount)	
		Save_grdMk( )
	end
	 -- ///////////////////////////////////////////////////////////////////////
end
 --============================================================================
 -- Save_grdMk : 실시간을 위해 중복되지 않는 시장구분을 저장해둔다.
 --============================================================================
function Save_grdMk( )
	local szExch, szCode
	local szExch2, szCode2
	grdMk.rowcount = 0
	
	for i = 0, grdCode.rowcount-1 do
	
		szExch = gf_Trim(grdCode.GetCellData("bd_exch", i))
		szCode = gf_Trim(grdCode.GetCellData("bd_code", i))
		
		if szExch ~= "" then
			nRow2 = gf_Tonumber(grdMk.rowcount)
	
			if nRow2 == 0 then
				grdMk.insertrow = 0
				grdMk.SetCellData("bd_exch", 0, szExch)
				grdMk.SetCellData("bd_code", 0, szCode)
			end
	
			for j = 0, nRow2 - 1 do
				szExch2 = gf_Trim(grdMk.GetCellData("bd_exch", j))
				
				if szExch == szExch2 then
					szCode2 = grdMk.GetCellData("bd_code", j) .. "★" .. szCode
					grdMk.SetCellData("bd_code", j, szCode2)
					
					break
				end
				
				if j == nRow2 - 1 then
					grdMk.insertrow = 0
					grdMk.SetCellData("bd_exch", 0, szExch)
					grdMk.SetCellData("bd_code", 0, szCode)
				end
			end
		end
	end

	if gf_Tonumber(grdCode.rowcount) > 0 then
		 -- 관심종목 데이터조회
		DATAMANAGER.RequestTranData( "ohhts_6500_002r" )
	end
end

 --============================================================================
 -- Check_LocalOrServer : 로컬, 서버 구분하여 종목을 편집한다.
 --============================================================================
function Check_LocalOrServer( )
	if g_szCloud == "1" then
		DATAMANAGER.RequestTranData("ohhts_intr_029r")
		Save_GWList( )
	else
		Save_GWList( )
	end
end

 --============================================================================
 -- Change_Len
 --============================================================================
function Change_Len(szData)
	if string.string.string.len(szData) == 1 then
		return "0" .. gf_Tostring(szData)
	else
		return gf_Tostring(szData)
	end
end

 --============================================================================
 -- Move_Popup 
 --============================================================================
function Move_Popup( )
	local szExch, szData
	 -- 시장구분별로 화면을 연동해야한다.
	szExch = Form.GetItemCodeInfo(g_szSltCd, "exchname")
	szData =  nYPos .. "★" .. height .. "★" .. "1" .. "★" .. szExch .. "★현재가★차트★매수★매도★"
	
	 --20200331 HWG START : 고유MTS
	szMediaCode = Form.GetSharedData("..MEDIA_CODE", false)
	
	 --20210804 SWJ START : 모의투자 채널코드 추가
	if szMediaCode == "156" or szMediaCode == "157" or szMediaCode == "412" or szMediaCode == "413" then
		Screen_No(szData, "43100", "44300", "43300")
	elseif szMediaCode == "158" or szMediaCode == "159" then
		Screen_No(szData, "43100", "03000", "43300")
	end
	 --20200331 HWG END
	
end

 --============================================================================
 -- Screen_No : 종목선택시 연결화면(0:연결화면, 1:현재가, 2:주문, 3:차트)
 --============================================================================	
function Screen_No(szScreen0, szScreen1, szScreen2, szScreen3)
	-- SELECT CASE 변환 (수동 보정 필요)
		if g_szMove == "0" then -- 연결팝업(메인에서 제공하는 팝업 오픈 end end
			Form.OpenPopup("movepopup" , szScreen0, "")
		elseif g_szMove == "1" then -- 현재가
			Form.OpenScreen(szScreen1, g_szSltCd)
		elseif g_szMove == "2" then -- 주문화면
			Form.OpenScreen(szScreen2, "관심종목★0" .. "★" .. g_szSltCd)		 -- 선택없으면 매수선택
		elseif g_szMove == "3" then -- 차트
			Form.OpenScreen(szScreen3, g_szSltCd)
	end
end

 --============================================================================
 -- Add_Item : 종목추가 20060309 , 20160407 종목다중선택위해 변수 추가
 --============================================================================
function Add_Item(nGbn)
	local szName, szMk
	szName, szMk = "", ""
	
	grdCode.insertrow = 0
	grdCode.SetCellData("bd_memo", 0, "")

	szName = Form.GetItemCodeInfo(g_szCd, "name")		 -- 20160325 위젯위해 종목명 추가
	szMk   = Form.GetItemCodeInfo(g_szCd, "exchname")
	
	
	grdCode.SetCellData("bd_code", 0, g_szCd)
	grdCode.SetCellData("bd_exch",   0, szMk)
	grdCode.SetCellData("bd_name", 0, szName)		 -- 20160325 위젯위해 종목명 추가
	
	g_szCd = ""
	
	if nGbn == 0 then -- 20160407 end end
		Check_LocalOrServer( )
	end
end

 --============================================================================
 -- Init_grdMk : 실시간 해제
 --============================================================================
function Init_grdMk( )
	DATAMANAGER.ClearInputData( 1, "ohhts_ovdv_cntf" )
	
	local szCode , szExch
	for j = 0, grdMk.rowcount - 1 do
		szCode = gf_Trim(grdMk.GetCellData("bd_code", j))
		szExch = gf_Trim(grdMk.GetCellData("bd_exch",   j))
		
		if szCode ~= "" and szExch ~= "" then
			tCode = gf_Split(szCode, "★")
			
			for k = 0, #tCode-1 do
				 -- MTS에서 보여주는 상품의 종목만 선택
				Set_Real_Input(k, tCode[k+1])
			end
			
			Cancel_RequestReal( )
		end
	end
	
	grdMk.rowcount = 0
end


