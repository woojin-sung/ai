<ROOT>
	<MAP_INFO scrno="16000" scrname="해외주식현재가_팝업_뉴스연동" version="2" writer="아이티젠" />
	<FORM_INFO name="Form" ly_vert="0,0,375,607,1" />
	<CONTROL_INFO>
		<WEBVIEW name="webNews" urlpath="about:blank" ly_vert="0,0,375,606,1" />
	</CONTROL_INFO>
	<SCRIPT_INFO _len="1929" _ulen="1891" >
dofile("scr/script.lua")
dofile("scr/json.lua")
 ------------------------------------------------------------------------------
 -- 01. 화 면 명 : 팝업_뉴스연동
 -- 02. 화면설명 : 
 -- 03. 작    성 : 2022.07.26 HSZ
 ------------------------------------------------------------------------------

 --****************************************************************************
 --           GROBAL VARIABLE
 --****************************************************************************
local g_szItemCode, g_szExid

 --============================================================================
function Form_OnFormInitBefore()
	local szData, arrData, szItemName

	szData = Form.GetOpenLinkData()
	arrData = gf_Split(szData,"|")
	
	if #arrData < 1 then
	    return
	end
	g_szItemCode	= arrData[0+1]
	g_szExid		= Transform_Exid(arrData[1+1])
	
	Form.SetScreenName( "종목 토론" )
	
end

 --============================================================================
function Form_OnFormInit()
	if gf_Trim(g_szItemCode) == "" then
		return
	end
	if string.string.len(g_szExid) < 1 then
		szExid = ""
	else
		szExid = "."..g_szExid
	end
 --	Form.ShowAlert("g_szItemCode .. szExid", g_szItemCode .. szExid)
	szUrl = "http://m.stock.naver.com/worldstock/stock/" .. g_szItemCode .. szExid .. "/discuss"
	webNews.urlpath = szUrl

end
 --============================================================================
function Transform_Exid(szExid)

	if szExid == "HK" then
		if string.sub(g_szItemCode, 1, 1)=="0" then
			g_szItemCode = string.sub(g_szItemCode, -4)
		end
		return "HK"
	elseif szExid == "SH" then
		return "SS"
	elseif szExid == "SZ" then
		return "SZ"
	elseif szExid == "OQ" then
		return "O"
	elseif szExid == "JP" then
		return "T"
	else
		return ""
	end

end
 --============================================================================
	
</SCRIPT_INFO>
</ROOT>