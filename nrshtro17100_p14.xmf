	<SCRIPT_INFO _len="5392" _ulen="5210" >
dofile("scr/script.lua")
dofile("scr/json.lua")

-- ****************************************************************************
--                G  L  O  B  A  L       V  A  R  I  A  B  L  E
-- ****************************************************************************
-- -----------------------------------------------
-- OS TYPE
-- -----------------------------------------------
local g_szOsType
g_szOsType = Form.GetSharedData("&OS_TYPE", false)

-- -----------------------------------------------
-- 설정 글자크기
-- -----------------------------------------------
local g_szTextSize
g_szTextSize = Form.getEnvData("common.textsize")

-- -----------------------------------------------
-- 공통 이미지
-- -----------------------------------------------
local g_szBgImg
g_szBgImg = "popup_bg.9"

local g_szCloseImg  
g_szCloseImg = "icon_close"

-- -----------------------------------------------
-- 컬러코드
-- -----------------------------------------------
-- 기본 텍스트 컬러 (검정색)
local g_szTxtColor_Normal 
g_szTxtColor_Normal 	= "334"

-- 기본 텍스트 컬러 (회색)
local g_szTxtColor_Grey 
g_szTxtColor_Grey 	= "333"

-- -----------------------------------------------
-- 기타 전역변수
-- -----------------------------------------------
local g_szTitle


-- ****************************************************************************
--             P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N              
-- ****************************************************************************

-- ===============================================
-- 컨트롤 초기설정
-- ===============================================
function Init_Control()
	-- -----------------------------------------------
	-- 배경이미지 초기화
	-- -----------------------------------------------
	imgBg.imgpath = g_szBgImg
	
	-- -----------------------------------------------
	-- 타이틀 초기화
	-- -----------------------------------------------
	
	-- -----------------------------------------------
	-- 닫기 버튼 초기화
	-- -----------------------------------------------
	imgClose.SetMaintainingRatio("3")
	imgClose.imgpath = g_szCloseImg
	
	cont0.FormTab0.setTabHeaderImage("img_bgcircle_black.9" , "img_bgcircle_line.9" , 5) -- 활성화/비활성화/여백
	cont0.FormTab0.setTabHeaderFgColor("28" , "321") -- 활성화/비활성화 폰트색상
	cont0.cont1.SetUseScrollingEvent(true)
end

-- ****************************************************************************
--                C  O  M  M  O  N       F  U  N  C  T  I  O  N               
-- ****************************************************************************

-- ===============================================
-- Form_OnFormInitBefore
-- ===============================================
function Form_OnFormInitBefore()
end

-- ===============================================
-- Form_OnFormInit
-- ===============================================
function Form_OnFormInit()
	Form.setDelayEvent(1, 0.1)
end

-- ===============================================
-- Form_OnDelayEvent(1회 실행)
-- ===============================================
function Form_OnDelayEvent(nID)
	if gf_Tonumber(nID) == 1 then
		Init_Control()
	end
end

-- ===============================================
-- imgInfo_OnClick
-- ===============================================
function imgClose_OnClick()
	Form.CloseForm()
end

-- ===============================================
-- imgAlpha_OnClick
-- ===============================================
function imgAlpha_OnClick()
	Form.CloseForm()
end

local g_nTop_1
g_nTop_1 = 0

local g_nTop_2
g_nTop_2 = 0

local g_nTop_3
g_nTop_3 = 0

-- ============================================================================

function Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "TOP_SIZE" then
		cont0.link0.height = sParam
		cont0.lblDiv0.visible = true
		cont0.lblDiv0.top = sParam
		cont0.FormTab0.visible = true
		cont0.FormTab0.top = sParam + 30
		cont0.cont1.top = sParam + 30 + 40 + 20
		cont0.setScrollAutoSize()
		cont0.cont1.link1.linkfile = "nrshtro17100_s2"
	elseif sEventName == "MID_1_SIZE" then	
		cont0.cont1.link1.height = sParam
		cont0.cont1.link1.top = g_nTop_1
		g_nTop_2 = g_nTop_1 + sParam + 20
		cont0.cont1.link2.linkfile = "nrshtro17100_s3"
	elseif sEventName == "MID_2_SIZE" then	
		cont0.cont1.link2.height = sParam
		cont0.cont1.link2.top = g_nTop_2
		g_nTop_3 = g_nTop_2 + sParam + 20
		cont0.cont1.link3.linkfile = "nrshtro17100_s4"
	elseif sEventName == "MID_3_SIZE" then	
		cont0.cont1.link3.height = sParam
		cont0.cont1.link3.top = g_nTop_3
		cont0.cont1.SetNotifyScrollPos(g_nTop_1..":"..g_nTop_2..":"..g_nTop_3)
		cont0.cont1.setScrollAutoSize()
	end
end

function cont0_cont1_OnNotifyScrolling(nIndex)
	cont0.FormTab0.currenttab = nIndex
end

-- ============================================================================

function cont0_FormTab0_OnTabChanged(nCurrentTab)
	if gf_Tonumber(nCurrentTab) == 0 then
		cont0.cont1.scroll_pos = g_nTop_1
	elseif gf_Tonumber(nCurrentTab) == 1 then
		cont0.cont1.scroll_pos = g_nTop_2 + 1
	elseif gf_Tonumber(nCurrentTab) == 2 then
		cont0.cont1.scroll_pos = g_nTop_3
	end
end
	</SCRIPT_INFO>
</ROOT>