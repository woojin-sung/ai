				<LABEL name="lblDiv0" visible="0" bgcolor="272:246246246" transmode="0" ly_vert="0,568,375,10,0" />
				<FORMTAB name="FormTab0" fontsize="-2" currenttab="2" tabcount="3" tabheadwidth="108" tabheadheight="36" ly_vert="20,1000,335,36,1" >
					<PAGE name="page009952" caption="이익실현" linkfile="nrsempty" />
