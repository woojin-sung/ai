 --============================================================================
 -- 20241128 LES START : 해외주식 매수 시장가 주문유형 추가
 -- 20241216 LES START : (미국)해외주식 휴일/휴장일때는 정규장종가 보여주도록 수정
 -- 20250804 YSH START : 장 운영 정보 조회 방식 변경
 --============================================================================

local gGubun
local gCode,gMarket
local gCredit
local g_szCurPrice,gHighPrice,gLowPrice
local gPrc,gQty
local gOrderGubun
local g_szCurrency
local g_szDecimal

local gCalcOrderPrice
local gCalcOrderPriceWon
local gExchangeRate
local g_szOrdSize
local gMarketCode
local gTickType
local gMaeMaeGubun
local gAcno
local gAsno
local gTotalYN


local g_szUnit

local g_szFocusIndex
local g_szFocusEditClear

local gQty10_Size,gQty100_Size,gQty1000_Size
gQty10_Size = 10
gQty100_Size = 100
gQty1000_Size = 1000

local gOsType
local gMaxLen
gMaxLen = 12

 --============================================================================
function Form_OnFormInitBefore()

	 --tblData.visible = true
	 --tblData0.visible = true
	
	gOsType = Form.GetSharedData("..OS_TYPE", false )
	
	if gOsType == "1" then
		lblOrderPrice.paddinginfo = "10,0,10,2"
		lblOrderPriceWon.paddinginfo = "10,2,10,0"
	end
	
end

 --============================================================================
function Form_OnFormInit()

	 --==================================================
	 -- 컨트롤 설정
	 --==================================================
	grdPrc.SetUseScriptImageCell("1")  --IOS 그리드 반복그림 관련 버그 수정

	 --==================================================
	 -- 연결화면 링크값 세팅
	 --==================================================
	 -- 0 : gGubun 				= 타이틀구분(단가/수량/금액)
	 -- 1 : gMarket 			= 시장구분(2자리)
	 -- 2 : gCode				= 종목코드
	 -- 3 : gCredit				= 현금/신용구분
	 -- 4 : g_szCurPrice 		= 현재가
	 -- 5 : gPrc				= 입력가격
	 -- 6 : gQty 				= 입력수량
	 -- 7 : gHighPrice 			= 상한가
	 -- 8 : gLowPrice 			= 하한가
	 -- 9 : gOrderGubun 		= 주문구분(시장가/지정가..)
	 -- 10 : g_szCurrency		= 통화구분
	 -- 11 : g_szDecimal		= 소수점자리수
	 -- 12 : gCalcOrderPrice 	= 주문금액(통화)
	 -- 13 : gCalcOrderPriceWon 	= 주문금액(원화)
	 -- 14 : gExchangeRate 		= 환율
	 -- 15 : g_szOrdSize		= 매매단위
	 -- 16 : gMarketCode		= 거래소코드(4자리)
	 -- 17 : gTickType			= 틱타입
	 -- 18 : gMaeMaeGubun		= 매수(BUY), 매도(SELL), 정정/취소
	 -- 19 : gAcno				= 계좌번호(8자리)
	 -- 20 : gAsno				= 계좌번호(2자리)
	 -- 21 : gTotalYN			= 통합증거금여부(Y/N)
	 --==================================================
	
	szData = Form.GetOpenLinkData()
	arrData = gf_Split(szData,"|")
	
	gGubun 				= arrData[0+1]
	gMarket 				= arrData[1+1]
	gCode 				= arrData[2+1]
	gCredit 				= arrData[3+1]
	g_szCurPrice 			= arrData[4+1]
	gPrc 				= arrData[5+1]
	gQty 				= arrData[6+1]
	gHighPrice 			= arrData[7+1]
	gLowPrice 			= arrData[8+1]
	gOrderGubun 			= arrData[9+1]
	g_szCurrency 			= arrData[10+1]
	g_szDecimal 			= arrData[11+1]
	gCalcOrderPrice		= arrData[12+1]
	gCalcOrderPriceWon 	= arrData[13+1]
	gExchangeRate 		= arrData[14+1]
	g_szOrdSize			= arrData[15+1]
	gMarketCode			= arrData[16+1]
	gTickType			= arrData[17+1]
	gMaeMaeGubun			= arrData[18+1]
	gAcno				= arrData[19+1]
	gAsno				= arrData[20+1]
	gTotalYN				= arrData[21+1]
	
	g_szUnit				= GetHogaUnit(gMarketCode, g_szCurPrice, 0) 
	
	 --==================================================
	 -- 시세데이터 조회(매도1호가/현재가/매수1호가 )
	 --==================================================
	RequestSiseData(gMarket,gCode)
	
	 --==================================================
	 -- 링크데이터 중 시세 데이터 세팅
	 --==================================================
	SetSiseData()
	
	 --==================================================
	 -- 타이틀 구분 세팅
	 --==================================================
	SetTitle(gGubun)
	
	 --==================================================
	 -- 타이틀 구분에 따른 퀵버튼 생성
	 --==================================================
	SetMakeQuickButton(gGubun)
	
	 --==================================================
	 -- 타이틀 구분에 따른 포커스 입력창 설정
	 --==================================================
	SetFocusEdit(gGubun)
	
	 --==================================================
	 -- 가격입력창/수량입력창/금액창 초기화
	 --==================================================
	SetInitPrcEdit()
	SetInitQtyEdit()
	SetInitOrdPriceLabel()
	Calc_OrderPrice()
	
end

