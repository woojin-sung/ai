		sData = string.gsub(sData, string.gsub(", "([%p])", "%%%1"), ","")
		SetPrice("AUTO",sData,g_szDecimal,g_szCurrency)
		Calc_OrderPrice()
	end
	
end

 --============================================================================
function DATAMANAGER_OnReceiveTranComplete(szTranID)
	
	 --==========================================================
	 -- 시세데이터 조회(정규장)
	 --==========================================================
	if szTranID == "ohhts_6000_002r" then
		
		sDayYN = Form.GetSharedData( "..OVRS_DAYMARKET", false )
		sAfterYN = Form.GetSharedData("OVRS_AFTER_MARKET_ORDER", false )
		
		 --20241216 LES START
		
		 --20250804 YSH START
		 --해외주식 장운영 정보 조회방식 변경
		 --sMarketClsCode = Form.GetSharedData("OVRS_MARKET_CLS_CODE", false )
		sMarketClsCode = Form.GetSharedData("..OVRS_MARKET_OPERATION_US", false)
		 --20250804 YSH END
		
		 --======================================================================
		 -- [주간장일 경우] 
		 -- 미국종목인 경우에는 주간장 시세조회 서비스 호출 
		 --======================================================================
		if sDayYN == "Y" and (gMarket == "OQ" or gMarket == "NY" or gMarket == "AX") and (sMarketClsCode ~= "000" and sMarketClsCode ~= "013" ) then --20241216 LES START - 휴장(000)/휴일(013) 조건추가
			
			RequestDayMarketSiseData(gMarket,gCode)
			
		elseif sAfterYN == "Y" and (gMarket == "OQ" or gMarket == "NY" or gMarket == "AX") then
			
			RequestAfterMarketSiseData(gMarket,gCode)
		
		 --======================================================================
		 -- [정규장일 경우]
		 -- 입력가격 데이터가 없으면 조회한 현재가 가격창에 넣어줌.
		 --======================================================================
		else
			
			sPrc = gf_Tonumber(DATAMANAGER.GetDataValue(0, "ohhts_6000_002r", "OutBlock1", "FIDX_PRPR" , 0))
			
			 ----------------------------------------
			 -- 현재가 데이터 있을 시,
			 ----------------------------------------
			if sPrc > 0 then
			
				if gPrc == "" or gPrc == "0" then
					if g_szDecimal ~= "" and g_szCurrency ~= "" then
						
						if Check_PrcOrd() ~= "시장가" then
							sTransPrc = gf_CommaValue(sPrc,g_szDecimal).." " .. g_szCurrency
							edtPrc.caption = sTransPrc
						end
					
					end
				end
				
				 ------------------------------------------------------------------------------------
				 -- 현재가 데이터 변경
				 ------------------------------------------------------------------------------------
				g_szCurPrice = sPrc
				tblData.SetCellString(1, 1, sPrc)
				tblData0.SetCellString(1, 1, sPrc)
				
				 ------------------------------------------------------------------------------------
				 -- 호가리스트 생성
				 ------------------------------------------------------------------------------------
				MakeHogaList(50)
				
				 ------------------------------------------------------------------------------------
				 -- 정규장 실시간 서비스 호출
				 ------------------------------------------------------------------------------------
				RequestRealSiseData(gMarket,gCode)
			
			 ----------------------------------------
			 -- 현재가 데이터 없을 시
			 ----------------------------------------
			else
			
				 ------------------------------------------------------------------------------------
				 -- 호가리스트 생성
				 ------------------------------------------------------------------------------------
				MakeHogaList(50)
				
				 ------------------------------------------------------------------------------------
				 -- 정규장 실시간 서비스 호출
				 ------------------------------------------------------------------------------------
				RequestRealSiseData(gMarket,gCode)
			
			end
			
			
			
		end
		
		
	 --==========================================================
	 -- 시세데이터 조회(주간장)
	 --==========================================================
	elseif szTranID == "ohhts_6000_017r" then
	
		sPrc = gf_Tonumber(DATAMANAGER.GetDataValue(0, "ohhts_6000_017r", "OutBlock1", "FIDX_DYTM_PRPR" , 0))
		
		 ------------------------------------------------------------------------------------
		 --주간장 현재가가 있는 경우 현재가 데이터를 변경해주고 호가리스트 생성.
		 ------------------------------------------------------------------------------------
		if sPrc > 0 then
			
			 -----------------------------------------------------------
			 -- 입력가격이 없는 경우 & 소수점자리수/통화코드가 있는 경우
			 -----------------------------------------------------------
			if gPrc == "" or gf_Tonumber(gPrc) == 0 then
				if g_szDecimal ~= "" and g_szCurrency ~= "" then
					
					 ------------------------------------------
					 -- 주문유형이 시장가가 아닌 경우 
					 ------------------------------------------
					if Check_PrcOrd() ~= "시장가" then
						sTransPrc = gf_CommaValue(sPrc,g_szDecimal).." " .. g_szCurrency
						edtPrc.caption = sTransPrc
					end
					
				end
			end
		
			 ------------------------------------------------------------------------------------
			 -- 현재가 데이터 변경
			 ------------------------------------------------------------------------------------
			g_szCurPrice = sPrc
			tblData.SetCellString(1, 1, sPrc)
			tblData0.SetCellString(1, 1, sPrc)
			
			 ------------------------------------------------------------------------------------
			 -- 호가리스트 생성
			 ------------------------------------------------------------------------------------
			MakeHogaList(50)
			
			 ------------------------------------------------------------------------------------
			 -- 주간장 현재가가 있는 경우 주간장 실시간 서비스 호출(현재는 미국종목만 해당 됨)
			 ------------------------------------------------------------------------------------
			RequestDayMarketRealSiseData(gMarket,gCode)
		
		
		 ------------------------------------------------------------------------------------
		 --주간장 현재가가 없는 경우 정규장에서 조회한 현재가를 기준으로 호가리스트 생성.
		 ------------------------------------------------------------------------------------
		else
		
			 -----------------------------------------------------------
			 -- 주간장 현재가가 없는 경우 정규장 현재가 가져와
			 -- 입력가격이 없는 경우 자동세팅
			 -----------------------------------------------------------
			sPrc = gf_Tonumber(tblData0.GetCellString(1, 1))
			
			if sPrc > 0 then
				
				 -----------------------------------------------------------
				 -- 입력가격이 없는 경우 & 소수점자리수/통화코드가 있는 경우
				 -----------------------------------------------------------
				if gPrc == "" or gf_Tonumber(gPrc) == 0 then
				
					if Check_PrcOrd() ~= "시장가" then
						sTransPrc = gf_CommaValue(sPrc,g_szDecimal).." " .. g_szCurrency
						edtPrc.caption = sTransPrc
					end
					
				end
			
			end
			
			
			 ------------------------------------------------------------------------------------
			 -- 호가리스트 생성
			 ------------------------------------------------------------------------------------
			MakeHogaList(50)
			
			 ------------------------------------------------------------------------------------
			 -- 주간장 현재가가 없는 경우 정규장 실시간 서비스 호출
			 ------------------------------------------------------------------------------------
			RequestRealSiseData(gMarket,gCode)
			
			
		end
		
	 --==========================================================
	 -- 시세데이터 조회(애프터)
	 --==========================================================
	elseif szTranID == "ohhts_6000_020r" then
	
		sPrc = gf_Tonumber(DATAMANAGER.GetDataValue(0, "ohhts_6000_020r", "OutBlock1", "FIDX_MKT_AFT_PRPR" , 0))
		
		 ------------------------------------------------------------------------------------
		 --애프터 현재가가 있는 경우 현재가 데이터를 변경해주고 호가리스트 생성.
		 ------------------------------------------------------------------------------------
		if sPrc > 0 then
			
			 -----------------------------------------------------------
			 -- 입력가격이 없는 경우 & 소수점자리수/통화코드가 있는 경우
			 -----------------------------------------------------------
			if gPrc == "" or gf_Tonumber(gPrc) == 0 then
				if g_szDecimal ~= "" and g_szCurrency ~= "" then
					
					 ------------------------------------------
					 -- 주문유형이 시장가가 아닌 경우 
					 ------------------------------------------
					if Check_PrcOrd() ~= "시장가" then
						sTransPrc = gf_CommaValue(sPrc,g_szDecimal).." " .. g_szCurrency
						edtPrc.caption = sTransPrc
					end
					
				end
			end
		
			 ------------------------------------------------------------------------------------
			 -- 현재가 데이터 변경
			 ------------------------------------------------------------------------------------
			g_szCurPrice = sPrc
			tblData.SetCellString(1, 1, sPrc)
			tblData0.SetCellString(1, 1, sPrc)
			
			 ------------------------------------------------------------------------------------
			 -- 호가리스트 생성
			 ------------------------------------------------------------------------------------
			MakeHogaList(50)
			
			 ------------------------------------------------------------------------------------
			 -- 애프터 현재가가 있는 경우 주간장 실시간 서비스 호출(현재는 미국종목만 해당 됨)
			 ------------------------------------------------------------------------------------
			RequestAfterMarketRealSiseData(gMarket,gCode)
		
		
		 ------------------------------------------------------------------------------------
		 --애프터 현재가가 없는 경우 정규장에서 조회한 현재가를 기준으로 호가리스트 생성.
		 ------------------------------------------------------------------------------------
		else
		
			 -----------------------------------------------------------
			 -- 주간장 현재가가 없는 경우 정규장 현재가 가져와
			 -- 입력가격이 없는 경우 자동세팅
			 -----------------------------------------------------------
			sPrc = gf_Tonumber(tblData0.GetCellString(1, 1))
			
			if sPrc > 0 then
				
				 -----------------------------------------------------------
				 -- 입력가격이 없는 경우 & 소수점자리수/통화코드가 있는 경우
				 -----------------------------------------------------------
				if gPrc == "" or gf_Tonumber(gPrc) == 0 then
				
					if Check_PrcOrd() ~= "시장가" then
						sTransPrc = gf_CommaValue(sPrc,g_szDecimal).." " .. g_szCurrency
						edtPrc.caption = sTransPrc
					end
					
				end
			
			end
			
			
			 ------------------------------------------------------------------------------------
			 -- 호가리스트 생성
			 ------------------------------------------------------------------------------------
			MakeHogaList(50)
			
			 ------------------------------------------------------------------------------------
			 -- 애프터 현재가가 없는 경우 정규장 실시간 서비스 호출
			 ------------------------------------------------------------------------------------
			RequestRealSiseData(gMarket,gCode)
			
			
		end
	
	 -------------------------------------------
	 -- 주문가능수량 조회
	 -------------------------------------------
	elseif szTranID == "obtro_oder_264r" then
		
		 -------------------------------------------
		 -- 매수가능 수량
		 -------------------------------------------
		if gMaeMaeGubun == "BUY" then
			
			 -------------------------------------------
			 -- 통합증거금 여부
			 -------------------------------------------
			if gTotalYN == "Y" then
				sAbleQty = DATAMANAGER.GetDataValue(0, "obtro_oder_264r", "OutBlock1", "INTG_MARG_ODER_ABLE_QTY" , 0)
			else
				sAbleQty = DATAMANAGER.GetDataValue(0, "obtro_oder_264r", "OutBlock1", "ODER_ABLE_QTY" , 0)
			end
		
		 -------------------------------------------
		 -- 매도가능 수량
		 -------------------------------------------
		elseif gMaeMaeGubun == "SELL" then
		
			 -------------------------------------------
			 -- 현금/대출 구분
			 -------------------------------------------
			if gCredit == 1 or gCredit == "1" then
				sAbleQty = DATAMANAGER.GetDataValue(0, "obtro_oder_264r", "OutBlock1", "LOAN_SELN_RDMP_ABLE_QTY" , 0)
			else
				sAbleQty = DATAMANAGER.GetDataValue(0, "obtro_oder_264r", "OutBlock1", "ODER_ABLE_QTY" , 0)
			end
		
		end
		
		edtQty.caption = gf_Tonumber(sAbleQty)
		Calc_OrderPrice()
	
	end
	
end
 --============================================================================
function MakeHogaList(nRowCnt)

	 -------------------------------------------------------------
	 --기준가/상한가/하한가
	 -------------------------------------------------------------
	sDpr = gf_Tonumber(tblData0.GetCellString(1, 0))
	sHighPrice = gf_Tonumber(tblHigh.GetCellString(0, 1))
	sLowPrice = gf_Tonumber(tblLow.GetCellString(0, 1))
	
	 -------------------------------------------------------------
	 --현재가(호가리스트 중앙값)
	 -------------------------------------------------------------
	local nCurPriceIndex
	nCurPriceIndex = -1
	sCurPrice = gf_Tonumber(tblData0.GetCellString(1, 1))
	
	 -------------------------------------------------------------
	 -- 현재가가 없으면 호가리스트 생성안함.
	 -------------------------------------------------------------
	if sCurPrice == 0 then
		return
	end
	
	 -------------------------------------------------------------
	 -- 20240715 미국종목 1달러이상인 종목의 현재가가 소수점4자리로
	 -- 들어왔을때, 소수점 2자리 단위로 호가리스트 생성하도록 변환
	 -------------------------------------------------------------
	if gMarket == "OQ" or gMarket == "NY" or gMarket == "AX" then
	
		if sCurPrice > 1 then
			
			 ------------------------------------------------------------------------------
			 --FormatNumber변환 시, 천단위 부호 생기면 Cdbl이 0으로 나오므로 그전에 replace
			 ------------------------------------------------------------------------------
			sCurPrice = gf_Tonumber(string.gsub(gf_CommaValue(sCurPrice, string.gsub(2), "([%p])", "%%%1"), ",",""))
			
		end
		
	end
	
	 -------------------------------------------------------------
	 --시/고/저가
	 -------------------------------------------------------------
	sOprc = gf_Tonumber(lblOprc.caption)
	sHprc = gf_Tonumber(lblHprc.caption)
	sLprc = gf_Tonumber(lblLprc.caption)

	 -------------------------------------------------------------
	 -- (현재가를 기준으로) 상단호가 생성
	 -------------------------------------------------------------
	for i = 0, nRowCnt - 1 do
	
		sData = sCurPrice + (g_szUnit * (nRowCnt - i))
		
		 ---------------------------------------------------------------------------------
		 -- (생성호가 > 현재가) and (생성호가 < 상한가 or 상한가 == 0) and (생성호가 > 0 )
		 ---------------------------------------------------------------------------------
		if sData > sCurPrice and (sData < sHighPrice or sHighPrice == 0) and (sData > 0 ) then
		
			grdPrc.AddRow()
			sTransData = gf_CommaValue(sData , g_szDecimal)
			grdPrc.SetCellData("bd_prc", grdPrc.rowcount - 1, sTransData)
						
			sDebi = gf_Round((sData - sDpr) / sDpr * 100,2)
			grdPrc.SetCellData("bd_debi", grdPrc.rowcount - 1, sDebi)
			
			if sDebi > 0 or gf_Tonumber(sData - sDpr) > 0 then
				grdPrc.SetCellFgColor("bd_prc", grdPrc.rowcount - 1 , "1")
			elseif sDebi < 0 or gf_Tonumber(sData - sDpr) < 0 then
				grdPrc.SetCellFgColor("bd_prc", grdPrc.rowcount - 1 , "2")
			else
				grdPrc.SetCellFgColor("bd_prc", grdPrc.rowcount - 1 , "3")
			end
			
			 -------------------------------------------------------------
			 --현재 생성한 호가행이 현재가인지 체크
			 -------------------------------------------------------------
			 --if sData == sCurPrice then
			 --	nCurPriceIndex = grdPrc.rowcount - 1
			 --end if
			
			 -------------------------------------------------------------
			 --현재 생성한 호가행이 시/고/저가인지 체크
			 --시/고/저 값이 모두 동일한 케이스가 있을 수 있으므로, 각각 if문으로 체크
			 --모두 동일한 케이스일때 우선순위는 고 > 저 > 시
			 -------------------------------------------------------------
			if sData == sOprc then
				grdPrc.SetCellImage("bd_cell0", grdPrc.rowcount - 1, "hoga_marking01")
				grdPrc.SetMaintainingRatio("bd_cell0", grdPrc.rowcount - 1, "1")
			end
			
			if sData == sLprc then
				grdPrc.SetCellImage("bd_cell0", grdPrc.rowcount - 1, "hoga_marking03")
				grdPrc.SetMaintainingRatio("bd_cell0", grdPrc.rowcount - 1, "1")
			end
			
			if sData == sHprc then
				grdPrc.SetCellImage("bd_cell0", grdPrc.rowcount - 1, "hoga_marking02")
				grdPrc.SetMaintainingRatio("bd_cell0", grdPrc.rowcount - 1, "1")
			end
			
		end
		
	end

	 -------------------------------------------------------------
	 -- 호가리스트 중앙값(현재가) 세팅
	 -------------------------------------------------------------
	grdPrc.AddRow()
	sTransCenterData = gf_CommaValue(sCurPrice,g_szDecimal)
		
	grdPrc.SetCellData("bd_prc", grdPrc.rowcount - 1, sTransCenterData)
	
	sDebi = gf_Round((sCurPrice - sDpr) / sDpr * 100,2)
	grdPrc.SetCellData("bd_debi", grdPrc.rowcount - 1, sDebi)
	
	if sDebi > 0 then
		grdPrc.SetCellFgColor("bd_prc", grdPrc.rowcount - 1 , "1")
	elseif sDebi < 0 then
		grdPrc.SetCellFgColor("bd_prc", grdPrc.rowcount - 1 , "2")
	else
		grdPrc.SetCellFgColor("bd_prc", grdPrc.rowcount - 1 , "3")
	end
	
	 -------------------------------------------------------------
	 -- 중앙호가(현재가) 인덱스값 설정
	 -------------------------------------------------------------
	 --if sDpr == sCurPrice then
		nCurPriceIndex = grdPrc.rowcount - 1
	 --end if
	
	 -------------------------------------------------------------
	 --현재 생성한 호가행이 시/고/저가인지 체크
	 --시/고/저 값이 모두 동일한 케이스가 있을 수 있으므로, 각각 if문으로 체크
	 --모두 동일한 케이스일때 우선순위는 고/저/시
	 -------------------------------------------------------------
	if sCurPrice == sOprc then
		grdPrc.SetCellImage("bd_cell0", grdPrc.rowcount - 1, "hoga_marking01")
		grdPrc.SetMaintainingRatio("bd_cell0", grdPrc.rowcount - 1, "1")
	end
			
	if sCurPrice == sLprc then
		grdPrc.SetCellImage("bd_cell0", grdPrc.rowcount - 1, "hoga_marking03")
		grdPrc.SetMaintainingRatio("bd_cell0", grdPrc.rowcount - 1, "1")
	end
			
	if sCurPrice == sHprc then
		grdPrc.SetCellImage("bd_cell0", grdPrc.rowcount - 1, "hoga_marking02")
		grdPrc.SetMaintainingRatio("bd_cell0", grdPrc.rowcount - 1, "1")
	end
	
	 -------------------------------------------------------------
	 -- (현재가를 기준으로) 하단호가 생성
	 -------------------------------------------------------------
	for i = nRowCnt + 1, nRowCnt * 2 do
		
		sData = sCurPrice - (g_szUnit * (i - nRowCnt))
		
		 ---------------------------------------------------------------------------------
		 -- (생성호가 < 현재가) and (생성호가 > 하한가 or 하한가 == 0) and (생성호가 > 0 )
		 ---------------------------------------------------------------------------------
		if sData < sCurPrice and (sData > sLowPrice or sLowPrice == 0) and (sData > 0) then
			
			grdPrc.AddRow()
			sTransData = gf_CommaValue(sData , g_szDecimal)
			grdPrc.SetCellData("bd_prc", grdPrc.rowcount - 1, sTransData)
			
			sDebi = gf_Round((sData - sDpr) / sDpr * 100,2)
			grdPrc.SetCellData("bd_debi", grdPrc.rowcount - 1, sDebi)
			
			if sDebi > 0 or gf_Tonumber(sData - sDpr) > 0 then
				grdPrc.SetCellFgColor("bd_prc", grdPrc.rowcount - 1 , "1")
			elseif sDebi < 0 or gf_Tonumber(sData - sDpr) < 0 then
				grdPrc.SetCellFgColor("bd_prc", grdPrc.rowcount - 1 , "2")
			else
				grdPrc.SetCellFgColor("bd_prc", grdPrc.rowcount - 1 , "3")
			end
			
			 -------------------------------------------------------------
			 --현재 생성한 호가행이 현재가인지 체크
			 -------------------------------------------------------------
			 --if sData == sCurPrice then
			 --	nCurPriceIndex = grdPrc.rowcount - 1
			 --end if
			
			 -------------------------------------------------------------
			 --현재 생성한 호가행이 시/고/저가인지 체크
			 --시/고/저 값이 모두 동일한 케이스가 있을 수 있으므로, 각각 if문으로 체크
			 --모두 동일한 케이스일때 우선순위는 고 > 저 > 시
			 -------------------------------------------------------------
			if sData == sOprc then
				grdPrc.SetCellImage("bd_cell0", grdPrc.rowcount - 1, "hoga_marking01")
				grdPrc.SetMaintainingRatio("bd_cell0", grdPrc.rowcount - 1, "1")
			end
			
			if sData == sLprc then
				grdPrc.SetCellImage("bd_cell0", grdPrc.rowcount - 1, "hoga_marking03")
				grdPrc.SetMaintainingRatio("bd_cell0", grdPrc.rowcount - 1, "1")
			end
			
			if sData == sHprc then
				grdPrc.SetCellImage("bd_cell0", grdPrc.rowcount - 1, "hoga_marking02")
				grdPrc.SetMaintainingRatio("bd_cell0", grdPrc.rowcount - 1, "1")
			end
		
			
		end
		
	end
	
	 -------------------------------------------------------------
	 -- 현재가가 중앙에 표시되도록 위치 이동
	 -------------------------------------------------------------
	if nCurPriceIndex > 0 then
		grdPrc.toprow = nCurPriceIndex - 5
	end
	

end

 --============================================================================
function grdPrc_OnClickUp(lRow, szCellID)
	
	 --20241108 LES START => 호가클릭 가격연동 범위 개선
	 --등락률 클릭 시에도 해당 호가 연동
	if szCellID == "bd_prc" or szCellID == "bd_debi" then
		
		if Check_PrcOrd() ~= "시장가" then
			g_szFocusEditClear = false
			sData = grdPrc.GetCellData("bd_prc", lRow)
			sData = string.gsub(sData, string.gsub(", "([%p])", "%%%1"), ","")
			SetPrice("AUTO",sData,g_szDecimal,g_szCurrency)
			
			Calc_OrderPrice()
			
		end
		
	end
	
end

 --============================================================================
 -- 주문가능수량 조회
 -- 매수 : 통합증거금 여부에 따라 수량 입력(통증:통합증거금 최대가능 수량/ 일반:현금 최대가능수량)
 -- 매도 : 매도가능수량 입력
 --============================================================================
function contQty_btnAble_OnClick()
	
	
	 -----------------------------------------------------------------------------
	 -- IQRY_CLS_CODE
	 -----------------------------------------------------------------------------
	 -- : 해당 서비스에서 외화예수금/환전가능 금액들도 조회 가능
	 -- : 해당값이 전체(1)일때는 위 데이터도 같이 조회
	 -- : 현재화면에서는 예수금/환전가능금액 데이터 불필요하여 수량만 조회되도록
	 -- : 일부조회(2) 구분값으로 호출. 매도일때는 상관없음. 알아서 수량만 조회됨
	 -----------------------------------------------------------------------------
	if gMaeMaegubun == "BUY" then
	
		DATAMANAGER.ClearInputData(0, "obtro_oder_264r")
		DATAMANAGER.SetDataValue(0, "obtro_oder_264r", "InBlock1", "IQRY_CLS_CODE" 		, 0 , "2")  --조회범위(1:전체/2:주문가능수량/금액만) 
		DATAMANAGER.SetDataValue(0, "obtro_oder_264r", "InBlock1", "ACNO" 				, 0 , gAcno)
		DATAMANAGER.SetDataValue(0, "obtro_oder_264r", "InBlock1", "ASNO" 				, 0 , gAsno)
		DATAMANAGER.SetDataValue(0, "obtro_oder_264r", "InBlock1", "OVRS_STCK_SYMB_ISCD" 	, 0 , gCode)
		DATAMANAGER.SetDataValue(0, "obtro_oder_264r", "InBlock1", "OVRS_EXCH_VNDR_IDNO" 	, 0 , gMarketCode)
		DATAMANAGER.SetDataValue(0, "obtro_oder_264r", "InBlock1", "SELN_BYOV_CLCD" 		, 0 , "2")  --매도(1)/매수(2)
		DATAMANAGER.SetDataValue(0, "obtro_oder_264r", "InBlock1", "ODER_CRNC_PRC" 		, 0 , GetPrice())
		DATAMANAGER.SetDataValue(0, "obtro_oder_264r", "InBlock1", "IF_INTG_MARG_IQRY_YN"	, 0 , "Y")
		
		 --20241128 LES START
		DATAMANAGER.SetDataValue(0, "obtro_oder_264r", "InBlock1", "ODER_CLS_CODE"	, 0 , gOrderGubun)
		

	elseif gMaeMaegubun == "SELL" then
	
		DATAMANAGER.ClearInputData(0, "obtro_oder_264r")
		DATAMANAGER.SetDataValue(0, "obtro_oder_264r", "InBlock1", "IQRY_CLS_CODE" 		, 0 , "1")  --조회범위(1:전체/2:주문가능수량/금액만)
		DATAMANAGER.SetDataValue(0, "obtro_oder_264r", "InBlock1", "ACNO" 				, 0 , gAcno)
		DATAMANAGER.SetDataValue(0, "obtro_oder_264r", "InBlock1", "ASNO" 				, 0 , gAsno)
		DATAMANAGER.SetDataValue(0, "obtro_oder_264r", "InBlock1", "OVRS_STCK_SYMB_ISCD" 	, 0 , gCode)
		DATAMANAGER.SetDataValue(0, "obtro_oder_264r", "InBlock1", "OVRS_EXCH_VNDR_IDNO" 	, 0 , gMarketCode)
		DATAMANAGER.SetDataValue(0, "obtro_oder_264r", "InBlock1", "SELN_BYOV_CLCD" 		, 0 , "1")  --매도(1)/매수(2)
		DATAMANAGER.SetDataValue(0, "obtro_oder_264r", "InBlock1", "ODER_CRNC_PRC" 		, 0 , GetPrice())
		DATAMANAGER.SetDataValue(0, "obtro_oder_264r", "InBlock1", "IF_INTG_MARG_IQRY_YN"	, 0 , "Y")
		
		if gCredit == 1 or gCredit == "1" then
			DATAMANAGER.SetDataValue(0, "obtro_oder_264r", "InBlock1", "LOAN_DTL_TYPE_CODE" 	, 0 , "0251")
		end
		
	end

	DATAMANAGER.RequestTranData("obtro_oder_264r")	
	
end

 --============================================================================
 -- Check_PrcOrd 지정가/시장가 구분
 --============================================================================
function Check_PrcOrd()
	
	 --시장가/MOO(장개시시장가)/MOC(장마감시장가)/VWAP(수량분할)/TWAP(시간분할)
	if gOrderGubun == "05" or gOrderGubun == "33" or gOrderGubun == "34" or gOrderGubun == "37" or gOrderGubun == "38" then
		return "시장가"
	else
		return "지정가"
	end
	
end

	
