function imgBg_OnClick()
	Form.CloseForm()
end

 --============================================================================
 -- (공통) 가격입력창 가격SET
 --============================================================================
function SetPrice(sType,nPrc,nDecimalLen,sCurrency)
	
	szChk = string.find(gf_Tostring(nPrc), ".")
	 --lblTitle.caption = szChk .. "//" .. nDecimalLen .. "//" .. nPrc '.. "//".. sResult
	 --================================================================
	 --소수점(dot)이 있는 경우
	 --================================================================
	if szChk > 0 then
		
		 --------------------------------
		 --소수점영역 길이
		 --------------------------------
		szCha = gf_Tonumber(string.len(nPrc) - szChk)
		
		 ---------------------------------------------------------
		 --소수점영역의 길이가 국가별 소수점 자리수를 다 채운 경우
		 ---------------------------------------------------------
		if szCha >= gf_Tonumber(nDecimalLen) then
			 
			 if szCha == gf_Tonumber(nDecimalLen) then
				 sResult = gf_CommaValue(nPrc,nDecimalLen).." " .. sCurrency
				 edtPrc.caption = sResult
			 else
				 return
			 end
		
		 ---------------------------------------------------------	 
		 -- 소수점영역의 길이를 아직 다 안채운 경우
		 ---------------------------------------------------------
		else
			
			 ---------------------------------------------------------------------
			 --자동으로 호가가격이 입력되는 경우(초기값 세팅/ 호가 +,- 버튼 클릭)
			 --국가별 소수점 자리수로 가격을 다시 맞춰준다.
			 ---------------------------------------------------------------------
			if sType == "AUTO" then
				
				sResult = gf_CommaValue(nPrc,nDecimalLen).." " .. sCurrency
				edtPrc.caption = sResult
			
			 ---------------------------------------------------------------------
			 --가격이 수동으로 입력되는 경우(키패드 입력)에는 입력받은대로 표시
			 ---------------------------------------------------------------------
			else
				sResult = nPrc.." " .. sCurrency
				edtPrc.caption = sResult
			end
			
		end
	
	 --================================================================
	 -- 소수점(dot)이 없는 경우
	 --================================================================
	else
	
		if sType == "AUTO" then
			sResult = gf_CommaValue(nPrc,nDecimalLen) .." " .. sCurrency
			edtPrc.caption = sResult
		else
			sResult = gf_CommaValue(nPrc,0) .." " .. sCurrency
			edtPrc.caption = sResult
		end
		
	end
	
end
 --============================================================================
 -- (공통) 가격입력창 가격GET
 --============================================================================
function GetPrice()
	
	sResult = string.gsub(edtPrc.caption, string.gsub(" " .. g_szCurrency, "([%p])", "%%%1"), "")
	sResult = string.gsub(sResult, string.gsub(", "([%p])", "%%%1"), " , "")
	
	return sResult

end
 --============================================================================
 -- 타이틀 세팅
 --============================================================================
function SetTitle(sGubun)
	
	 -------------------------------------
	 --sGubun 0:단가 / 1:수량 / 2:금액
	 -------------------------------------
	if sGubun == "0" then
		lblTitle.caption = "단가 입력"
	elseif sGubun == "1" then
		lblTitle.caption = "수량 입력"
	elseif sGubun == "2" then
		lblTitle.caption = "금액 입력"
	else
		lblTitle.caption = "입력"
	end
	
end

 --============================================================================
 -- 포커스 에디트 설정
 --============================================================================
function SetFocusEdit(sGubun)

	g_szFocusIndex = sGubun
	g_szFocusEditClear = false
	
	 -------------------------------------
	 --sGubun 0:단가 / 1:수량 / 2:금액
	 -------------------------------------
	if sGubun == "0" then
	
		btnPMinus0.visible = true
		btnPMinus.visible = false
		btnPPlus0.visible = true
		btnPPlus.visible = false
		
		btnQMinus0.visible = false
		btnQMinus.visible = true
		btnQPlus0.visible = false
		btnQPlus.visible = true
		
		edtPrc.imagefilepth = "input_07_o.9"
		edtQty.imagefilepth = "input_07_n.9"
		 --imgOrderPrc.imgpath = "input_06_n.9"
		
	elseif sGubun == "1" then
	
		btnPMinus0.visible = false
		btnPMinus.visible = true
		btnPPlus0.visible = false
		btnPPlus.visible = true
		
		btnQMinus0.visible = true
		btnQMinus.visible = false
		btnQPlus0.visible = true
		btnQPlus.visible = false
	
		edtPrc.imagefilepth = "input_07_n.9"
		edtQty.imagefilepth = "input_07_o.9"
		 --imgOrderPrc.imgpath = "input_06_n.9"
		
	elseif sGubun == "2" then
	
		btnPMinus0.visible = false
		btnPMinus.visible = true
		btnPPlus0.visible = false
		btnPPlus.visible = true
		
		btnQMinus0.visible = false
		btnQMinus.visible = true
		btnQPlus0.visible = false
		btnQPlus.visible = true
	
		edtPrc.imagefilepth = "input_07_n.9"
		edtQty.imagefilepth = "input_07_n.9"
		 --imgOrderPrc.imgpath = "input_06_o.9"
		
	end
	
end


