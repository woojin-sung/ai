function SetSiseData()

	if gf_Tonumber(gHighPrice) > 0 and gf_Tonumber(gLowPrice) then
	
		tblHigh.SetCellString(0, 1, gf_CommaValue(gHighPrice,g_szDecimal))
		tblLow.SetCellString(0, 1, gf_CommaValue(gLowPrice,g_szDecimal))
		
	else
	
		tblHigh.visible = false
		tblLow.visible = false
		
		grdPrc.top = 151
		grdPrc.height = 495
		
	end

end

 --============================================================================
function tblHigh_OnClick(lRow , lColumn)
	
	if Check_PrcOrd() ~= "시장가" then
		g_szFocusEditClear = false
		sData = tblHigh.GetCellString(0, 1)
		sData = string.gsub(sData, string.gsub(", "([%p])", "%%%1"), ","")
		SetPrice("AUTO",sData,g_szDecimal,g_szCurrency)
		Calc_OrderPrice()
	end
	
end

 --============================================================================
function tblLow_OnClick(lRow , lColumn)
	
	if Check_PrcOrd() ~= "시장가" then
