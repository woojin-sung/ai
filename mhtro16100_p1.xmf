 --============================================================================
function RequestSiseData(sMarket,sCode)
	
	szDelay = Form.GetSharedData("REALTIME_"..sMarket, 0 )
	
	DATAMANAGER.SetDataValue( 0, "ohhts_6000_002r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE"  	, 0 , "OV" )
	DATAMANAGER.SetDataValue( 0, "ohhts_6000_002r", "InBlock1", "FID_INPUT_OVRS_ISCD"				, 0 , sCode)
	DATAMANAGER.SetDataValue( 0, "ohhts_6000_002r", "InBlock1", "FID_COND_MRKT_CLS_CODE" 			, 0 , sMarket)
	DATAMANAGER.SetDataValue( 0, "ohhts_6000_002r", "InBlock1", "FIDX_INPUT_DELY_RLTM_CLS_CODE" 	, 0 , szDelay)
	DATAMANAGER.RequestTranData("ohhts_6000_002r")
	
end

 --============================================================================
function RequestRealSiseData(sMarket,sCode)

	if sMarket ~= "" and sCode ~= "" then
		DATAMANAGER.CancelRealData("ohhts_exst_cntg")
		DATAMANAGER.ClearInputData(1, "ohhts_exst_cntg")
		
		DATAMANAGER.SetDataValue(1, "ohhts_exst_cntg", "InBlock1", "FIDXR_ISCD" , 0 , sMarket .. "@" .. sCode )
		DATAMANAGER.RequestRealData("ohhts_exst_cntg")
		
		DATAMANAGER.CancelRealData("ohhts_exst_aspr")
		DATAMANAGER.ClearInputData(1, "ohhts_exst_aspr")
		
		DATAMANAGER.SetDataValue(1, "ohhts_exst_aspr", "InBlock1", "FIDXR_ISCD" , 0 , sMarket .. "@" .. sCode )
		DATAMANAGER.RequestRealData("ohhts_exst_aspr")
		
	end
	
end
