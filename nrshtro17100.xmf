-- =============================================================================
-- Form_OnTriggerEvent
-- =============================================================================
function Form_OnTriggerEvent(sEventName, sParam, sParam2)
	
--	Form.ShowAlert("TEST", sEventName .. "|" .. sParam)
	-- --------------------------------
	-- 자동 토큰 발급
	-- --------------------------------
	if sEventName ==  "ISSUE_TOKEN_MAIN" then
		-- ----------------------------------------
		-- 성공
		-- ----------------------------------------
		if sParam == "SUCCESS" then
			sAccessToken = Form.GetSharedData("..REST_API_TOKEN", false)
			
			if IsEmpty(sAccessToken) == true then
				-- ----------------------------------
				-- 1. SEMI SSO 키 MCI 등록
				-- ----------------------------------
				DATAMANAGER.RequestRealData("ohhts_semi_ssor")
				
				-- ----------------------------------
				-- 2. 자동감시주문 서버 TOKEN 발급
				-- ----------------------------------
				Form.SetDelayEvent(3, 0.2)
			else
				-- --------------------------------
				-- 데이터 조회 
				-- --------------------------------
				sLinkData = act0.total .. "`" .. act0.sequence .. "`" .. act0.accountname .. "`" .. edtPwd.caption 
				Form.TriggerEvent("fmtabSearch." .. fmtabSearch.currenttabpageid, "TOKEN_SUCCESS", sLinkData)
				
				-- --------------------------------
				-- 데이터 재조회 실시간 등록
				-- --------------------------------
				DATAMANAGER.RequestRealData("ohhts_cntg_auto")
			end
		else
			-- ----------------------------------
			-- 1. SEMI SSO 키 MCI 등록
			-- ----------------------------------
			DATAMANAGER.RequestRealData("ohhts_semi_ssor")
			
			-- ----------------------------------
			-- 2. 자동감시주문 서버 TOKEN 발급
			-- ----------------------------------
			Form.SetDelayEvent(3, 0.2)
		end
		
	-- --------------------------------
	-- REST API 응답
	-- --------------------------------
	elseif sEventName ==  "RESTAPI_RETURN" then
		sStep = g_sStep
		g_sStep = ""
		
		-- ----------------------------------------
		-- 서버 검증용 토큰 발급
		-- ----------------------------------------
		if sStep == "ISSUE_TOKEN" then
		
			-- ----------------------------------------
			-- 성공
			-- ----------------------------------------
			if sParam == "SUCCESS" then
			
				data = Form.ResponseRestAPI("JSONOBJ", 0, "data", sParam2)
				
				accessToken = Form.ResponseRestAPI("DATA", 0, "accessToken", data)
				refreshToken = Form.ResponseRestAPI("DATA", 0, "refreshToken", data)
				
				if IsEmpty(accessToken) == false then
					Form.SetSharedData("..REST_API_TOKEN", " Bearer " .. accessToken )
				end
				
				if IsEmpty(refreshToken) == false then
					Form.SetSharedData("..REST_API_REFRESH_TOKEN", " Bearer " .. refreshToken )
				end
				
				-- --------------------------------
				-- 토큰 발급 성공 트리거
				-- --------------------------------
				sLinkData = act0.total .. "`" .. act0.sequence .. "`" .. act0.accountname .. "`" .. edtPwd.caption 
				Form.TriggerEvent("fmtabSearch." .. fmtabSearch.currenttabpageid, "TOKEN_SUCCESS", sLinkData)
				
				DATAMANAGER.RequestRealData("ohhts_cntg_auto")
				
			-- ----------------------------------------
			-- 실패(ERROR or EXCEPTION)
			-- ----------------------------------------
			else
				Form.MsgBox("알림", "현재 자동감시주문 실행이 불가합니다.\n고객지원센터에 문의해주세요.", "CLOSE_FORM", 6)
			end
		end
		
--		Form.SetDelayEvent(4, 0.2)
--		Button0.left = 1000
	-- --------------------------------
	-- 계좌 비밀번호 체크 요청
	-- --------------------------------
	elseif sEventName == "CHECK_ACCT_PWD" then
		sSavePwd = Form.GetEnvData("order.save_orderpwd")
		
		if sSavePwd == "1" and IsEmpty(edtPwd.caption) == false then
			-- --------------------------------
			-- 비밀번호 검증 성공
			-- --------------------------------
			Form.TriggerEvent("fmtabSearch." .. fmtabSearch.currenttabpageid, "ACCT_PWD_CHECK", "SUCCESS`" .. edtPwd.caption )
			return
		end
		
		Form.OpenPopupAnimation("pwdcheckpopup", act0.caption ,"","2")
	end
end

-- =============================================================================
-- Form_OnPopupReturn
-- =============================================================================
function Form_OnPopupReturn(sKeyName, sRet)
	-- --------------------------------
	-- 비밀번호 입력 (직접 / 주문자동)
	-- --------------------------------
	if sKeyName == "CORRECT_PWD" then
		
		-- --------------------------------
		-- 비밀번호 입력 완료
		-- --------------------------------
		if sRet ~= "" then
			local szAcnt
			
			tData = gf_Split(sRet, "★")
			
			if #tData > 0 then
				edtPwd.pwdlen = tData[2+1]
				edtPwd.caption = tData[1+1]
			end
			
		-- --------------------------------
		-- 비밀번호 입력 취소
		-- --------------------------------
		else
			sSavePwd = Form.GetEnvData("order.save_orderpwd")
			
			if sSavePwd == "0" then
				edtPwd.caption = ""
			else
				-- -------------------------------------------------------------
				-- 저장기능이 켜져있는 경우는 저장된 비밀번호가 있을 수 있음
				-- 계좌리스트를 뒤져서 한번 계좌를 넣어준다
				-- -------------------------------------------------------------
				szCurAcc = act0.caption
				nCnt = gf_Tonumber(act0.accountcount)
				for i = 1, gf_Tonumber - 1 do
					szCompAcc = act0.GetAccountByIndex(i)
					
					if szCurAcc == szCompAcc then
						act0.currentindex = i
						break
					end
				end
			end
			
		end 
		
		-- --------------------------------
		-- 비밀번호 입력 체크
		-- --------------------------------
		if IsEmpty(edtPwd.caption) == true then
			-- --------------------------------
			-- 비밀번호 검증 실패 
			-- --------------------------------
			Form.TriggerEvent("fmtabSearch." .. fmtabSearch.currenttabpageid, "ACCT_PWD_CHECK", "FAIL")
			return
		end
		
		-- --------------------------------
		-- 비밀번호 검증 성공
		-- --------------------------------
		Form.TriggerEvent("fmtabSearch." .. fmtabSearch.currenttabpageid, "ACCT_PWD_CHECK", "SUCCESS`" .. edtPwd.caption)
	
	end
end

