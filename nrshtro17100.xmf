-- ****************************************************************************
--                G  L  O  B  A  L       V  A  R  I  A  B  L  E
-- ****************************************************************************
local g_sStep = "" -- REST API 통신 인덱스

local g_isRefresh = false

local g_isChangeTab = false

local g_sOSType = Form.GetSharedData("..OS_TYPE", false)

local g_isForeigner = false

local g_isIssueToken_Main = false

-- ****************************************************************************
--             P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N              
-- ****************************************************************************

-- ===============================================
-- nil 체크 
-- ===============================================
function IsEmpty(sData)
	if gf_Trim(sData) == "" or sData == nil or gf_Trim(sData) == "nil" then
		return true
	else
		return false
	end
end

-- ===============================================
-- 숫자 소수점 절사 함수
-- ===============================================
function TruncateToDecimalPlaces(nVal, nDeimalPlaces)
	nVal = gf_Tonumber(nVal)
	nFactor = 10 ^ nDeimalPlaces
	szNumStr = gf_CommaValue(nVal*nFactor,12,0,0,0,1)
	nDecimalIdx = string.find(szNumStr, ".")
	
	nTotalData = 0
	if gf_Tonumber(nDecimalIdx) > 0 then
		nTotalData = gf_Tonumber(string.sub(szNumStr, 1, gf_Tonumber(nDecimalIdx)-1))
	else
		nTotalData = gf_Tonumber(szNumStr)
	end
	
	return nTotalData / nFactor
end

-- ===============================================
-- (NonNull) 문자열 -> 배열 변환함수
-- ===============================================
function Convert_StrToArr(szData, szSeperator)

	local arrData
	
	-- --------------------------------------------
	-- 링크데이터 값 체크
	-- --------------------------------------------
	if IsEmpty(szData) then
		arrData = {}
		return arrData
	end
	
	-- --------------------------------------------
	-- 구분자 값 체크
	-- --------------------------------------------
	if IsEmpty(szSeperator) then
		-- 단일변수
		arrData = {}
		table.Insert(arrData, szData)
	else
		-- 다중변수
		arrData = gf_Split(szData, szSeperator)
	end
	
	return arrData

end

-- ===============================================
-- REST API_토큰발급
-- ===============================================
function IssueToken()
	g_sStep = "ISSUE_TOKEN"
	
	Form.ReleaseRequestData()
	
	sData0  = Form.GetSharedData("..MEDIA_CODE", false )
	sData1  = Form.GetSharedData("..USER_ID", false )
	sData2  = Form.GetSharedData("..MCI_SESSION_KEY", false )
	sData3  = Form.GetSharedData("..SEMI_SSO_KEY", false )
	
	Form.MakeRequestData("channelClsCode", 	sData0)
	Form.MakeRequestData("userId", 			sData1)
	Form.MakeRequestData("sessionKey", 		sData2)
	Form.MakeRequestData("semiSsoKey", 		sData3)
	
	sDev = Form.GetSharedData("..SERVER_MODE", false)
	sUrl = ""
	if sDev == "1" then --개발기 end
		sUrl = "https://dev-api-gateway.imeritz.com:8443/"
	else
		sUrl = "https://api-gateway.imeritz.com:8443/"
	end
	
	Form.RequestRestAPI(sUrl.."auth/issue-token", "")
end

-- ===============================================
-- REST API_토큰발급
-- ===============================================
function RefreshToken()
	g_sStep = "ISSUE_TOKEN"
	
	Form.ReleaseRequestData()
	
	sData0  = Form.GetSharedData("..MEDIA_CODE", false )
	sData1  = Form.GetSharedData("..USER_ID", false )
	sData2  = Form.GetSharedData("..REST_API_REFRESH_TOKEN", false )
	
	Form.MakeRequestData("channelClsCode", 	sData0)
	Form.MakeRequestData("userId", 			sData1)
	Form.MakeRequestData("refreshToken", 	sData2)

	sDev = Form.GetSharedData("..SERVER_MODE", false)
	sUrl = ""
	if sDev == "1" then --개발기 end
		sUrl = "https://dev-api-gateway.imeritz.com:8443/"
	else
		sUrl = "https://api-gateway.imeritz.com:8443/"
	end
	
	Form.RequestRestAPI(sUrl.."auth/refresh-token", "")
end

-- ****************************************************************************
--                C  O  M  M  O  N       F  U  N  C  T  I  O  N               
-- ****************************************************************************

-- ===============================================
-- Form_OnDelayEvent(1회 실행)
-- ===============================================
function Form_OnDelayEvent(nID)
	
	--최초진입 or 재로그인
	if gf_Tonumber(nID) == 1 then
		-- ----------------------------------
		-- 1. 내국인 체크
		-- ----------------------------------
		DATAMANAGER.RequestTranData("obcsb_acif_002r")
		
	--실시간 해제 시 재등록
	elseif gf_Tonumber(nID) == 2 then
		-- ----------------------------------
		-- 1. SEMI SSO 키 MCI 등록
		-- ----------------------------------
		DATAMANAGER.RequestRealData("ohhts_semi_ssor")
		
	elseif gf_Tonumber(nID) == 3 then
		-- ----------------------------------
		-- 2. 자동감시주문 서버 TOKEN 발급
		-- ----------------------------------
		IssueToken() 
		
	elseif gf_Tonumber(nID) == 4 then
		Button0.left = 1000
	end
end


-- =============================================================================
-- Form_OnFormInitBefore
-- =============================================================================
function Form_OnFormInitBefore()
	imgBack.maintainratio = "2"
	imgInfo.maintainratio = "3"
	
	lblTitle.paddinginfo = "0,0,0,0"
	
end

-- =============================================================================
-- Form_OnFormInit
-- =============================================================================
function Form_OnFormInit()
--	Button0.left = 0
	
	sLinkData = Form.GetOpenLinkData()

	-- ------------------------------------------------------------------------
	--탭 변경 이벤트 미처리용 플래그 (currenttabpageid 프로퍼티 설정)
	--(AOS) OnTabChanged 이벤트 발생
	--(iOS) OnTabChanged 이벤트 미발생(직접 탭 클릭할 떄만 이벤트 발생함)
	--직접 클릭할 때 만 이벤트 처리
	-- ------------------------------------------------------------------------
	if g_sOSType == "1" then
		g_isChangeTab = true
	end
	
	if sLinkData == "1" then
		fmtabSearch.currenttabpageid = "page1"
	elseif sLinkData == "0" then
		fmtabSearch.currenttabpageid = "page0"
	elseif sLinkData == "2" then
		fmtabSearch.currenttabpageid = "page2"
	else
		arrData = ""
		isChange = false
		
		if IsEmpty(sLinkData) == false then
			
			arrData = Convert_StrToArr(sLinkData, "★")
			
			nArrCnt = #arrData
			if nArrCnt > 0 then
				if gf_Trim(arrData[1+1]) == "기타" then
					if nArrCnt > 2 then
						sGbn = gf_Trim(arrData[3+1])
						
						if sGbn == "OS" then
							fmtabSearch.currenttabpageid = "page0"
							isChange = true
						elseif sGbn == "OB" then
							fmtabSearch.currenttabpageid = "page1"
							isChange = true
						elseif sGbn == "OF" then
							fmtabSearch.currenttabpageid = "page2"
							isChange = true
						end
					end
				end
			end
		end
		
		if isChange == false then
			sPageID = Form.GetEnvData("17100_FORMTAB_PAGEID")
			
			if IsEmpty(sPageID) == false then
				fmtabSearch.currenttabpageid = sPageID
			else
				if g_sOSType == "1" then
					g_isChangeTab = false
				end
			end
		end
	end
	
	if fmtabSearch.currenttabpageid == "page2" then
		btnOrderList.caption = "주문내역"
--		btnOrderList.visible = true
	else
		btnOrderList.caption = "현재가"
--		btnOrderList.visible = false
	end
	
	Form.SetEnvData(1, "17100_FORMTAB_PAGEID", fmtabSearch.currenttabpageid)
	
	-- ------------------------------------------------------------------------
	-- 고객정보조회(내국인/외국인)
	-- ------------------------------------------------------------------------
	Form.SetDelayEvent(1, 0.2)
end

-- =============================================================================
-- fmtabSearch_OnTabChanged
-- =============================================================================
function fmtabSearch_OnTabChanged(nCurrentTab)
--	Button0.left = 0

	if fmtabSearch.currenttabpageid == "page2" then
		btnOrderList.caption = "주문내역"
--		btnOrderList.visible = true
	else
		btnOrderList.caption = "현재가"
--		btnOrderList.visible = false
	end
	
	--탭 변경 이벤트 미처리용 (AOS)
	if g_sOSType == "1" and g_isChangeTab == true then
		g_isChangeTab = false
		return
	end
	
	Form.SetEnvData(1, "17100_FORMTAB_PAGEID", fmtabSearch.currenttabpageid)
	
	-- --------------------------------
	-- 탭 변경 트리거
	-- --------------------------------
	sLinkData = act0.total .. "`" .. act0.sequence .. "`" .. act0.accountname .. "`" .. edtPwd.caption 
	Form.TriggerEvent("fmtabSearch." .. fmtabSearch.currenttabpageid, "TAB_CHANGE", sLinkData)
	
--	Form.SetDelayEvent(4, 0.2)
end

