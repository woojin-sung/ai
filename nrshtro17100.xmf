-- =============================================================================
-- DATAMANAGER_OnSendRealBefore
-- =============================================================================
function DATAMANAGER_OnSendRealBefore(szTranID)
	if szTranID == "ohhts_semi_ssor" then
		sSemiSSO = Form.GetSharedData("..SEMI_SSO_KEY", false)
		DATAMANAGER.SetDataValue(1,"ohhts_semi_ssor", "InBlock1", "FID_MCI_LOGN_KEY", 0 , sSemiSSO)
		
	elseif szTranID == "ohhts_cntg_auto" then
		sCsno = Form.GetSharedData("..CUST_NUM", false)
		DATAMANAGER.SetDataValue(1, "ohhts_cntg_auto", "InBlock1", "FIDR_CSNO", 0 , sCsno)
	end
end

-- =============================================================================
-- DATAMANAGER_OnSendTranBefore
-- =============================================================================
function DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID == "obcsb_acif_002r" then
		DATAMANAGER.ClearInputData(0, "obcsb_acif_002r")
		
		DATAMANAGER.SetDataValue(0, "obcsb_acif_002r", "InBlock1", "PROS_CLS_CODE", 0 , 1)
		DATAMANAGER.SetDataValue(0, "obcsb_acif_002r", "InBlock1", "ACNO", 0 , act0.total)
	end
end

-- =============================================================================
-- DATAMANAGER_OnReceiveTranComplete
-- =============================================================================
function DATAMANAGER_OnReceiveTranComplete(szTranID)
	-- ----------------
	-- 내국인 체크
	-- ----------------
	if szTranID == "obcsb_acif_002r" then
		sCode = DATAMANAGER.GetDataMsgCode("obcsb_acif_002r")
		
		if sCode == "5820" then
			if g_isForeigner == false then
				g_isForeigner = true
				-- ----------------------------------------
				-- 외국인인 경우 거래불가
				-- ----------------------------------------
				Form.MsgBox("알림", "주문 가능한 계좌가 없어요.", "CHECK_FOREIGNER", 6)
				return
			end
		end
		
		-- --------------------------------------
		-- 1 : 내국인, 2 : 외국인
		-- --------------------------------------
		sNtfrClsCode = DATAMANAGER.GetDataValue(0, "obcsb_acif_002r", "OutBlock1", "NTFR_CLS_CODE", 0)
		
		if sNtfrClsCode == "1" then
			
			sAccessToken = Form.GetSharedData("..REST_API_TOKEN", false)
			if IsEmpty(sAccessToken) == true then
				-- ----------------------------------
				-- 1. SEMI SSO 키 MCI 등록
				-- ----------------------------------
				DATAMANAGER.RequestRealData("ohhts_semi_ssor")
				
				-- ----------------------------------
				-- 2. 자동감시주문 서버 TOKEN 발급
				-- ----------------------------------
				Form.SetDelayEvent(3, 0.2)
			else
--				Form.SetDelayEvent(4, 0.2)
				
				-- --------------------------------
				-- 데이터 조회 
				-- --------------------------------
				sLinkData = act0.total .. "`" .. act0.sequence .. "`" .. act0.accountname .. "`" .. edtPwd.caption 
				Form.TriggerEvent("fmtabSearch." .. fmtabSearch.currenttabpageid, "TOKEN_SUCCESS", sLinkData)
				
				-- --------------------------------
				-- 데이터 재조회 실시간 등록
				-- --------------------------------
				DATAMANAGER.RequestRealData("ohhts_cntg_auto")
			end
			
		else
			if g_isForeigner == false then
				g_isForeigner = true
				-- ----------------------------------------
				-- 외국인인 경우 거래불가
				-- ----------------------------------------
				Form.MsgBox("알림", "해외주식거래는 거주 내국인만\n가능해요.", "CHECK_FOREIGNER", 6)
				return
			end
		end
	end
end

-- =============================================================================
-- DATAMANAGER_OnReceiveRealComplete
-- =============================================================================
function DATAMANAGER_OnReceiveRealComplete(szTranID)
	if szTranID == "ohhts_cntg_auto" then
		sAcno = DATAMANAGER.GetDataValue(1, "ohhts_cntg_auto", "OutBlock1", "FIDR_ACNO", 0)				-- 계좌번호
		sAsno = DATAMANAGER.GetDataValue(1, "ohhts_cntg_auto", "OutBlock1", "FIDR_ASNO", 0)				-- 계좌 일련번호
		sSellBuy = DATAMANAGER.GetDataValue(1, "ohhts_cntg_auto", "OutBlock1", "FIDR_SELN_SHNU_CLS_CODE", 0)	-- 1:매도 2:매수
		sDmab = DATAMANAGER.GetDataValue(1, "ohhts_cntg_auto", "OutBlock1", "FIDR_DMAB_CLS_CODE", 0)		-- 1:국내 2:미국
		sEvnt = DATAMANAGER.GetDataValue(1, "ohhts_cntg_auto", "OutBlock1", "FIDR_EVNT_CLS_CODE", 0)		-- 01:조건상태 변경
		
--		Button0.left = 0
		-- 조건상태 변경 .. 해외(미국)
		if sEvnt == "01" and sDmab == "2" then
			sAcnoTmp = act0.total
			sAsnoTmp = act0.sequence
			
			-- 계좌번호 체크
			if sAcno == sAcnoTmp and sAsno == sAsnoTmp then
				sLinkData = act0.total .. "`" .. act0.sequence .. "`" .. act0.accountname .. "`" .. edtPwd.caption 
				-- 매도
				if sSellBuy == "1" and fmtabSearch.currenttabpageid == "page0" then
					Form.TriggerEvent("fmtabSearch.page0", "REFRESH_LIST", sLinkData)
				-- 매수
				elseif sSellBuy == "2" and fmtabSearch.currenttabpageid == "page1" then
					Form.TriggerEvent("fmtabSearch.page1", "REFRESH_LIST", sLinkData)
				
				elseif fmtabSearch.currenttabpageid == "page2" then
					Form.TriggerEvent("fmtabSearch.page2", "REFRESH_LIST", sLinkData)
				
				end
			end
		end
		
--		Form.SetDelayEvent(4, 0.2)
	end
end

-- =============================================================================
-- DATAMANAGER_OnReceiveTranError
-- =============================================================================
function DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	
--	Form.SetDelayEvent(4, 0.2)
	
	if string.len(gf_Trim(szSubMsg))	>	0 then
		Form.MsgBox("알림", szErrMsg .. "\n(" .. szSubMsg .. ")", "CHECK_FOREIGNER", 6)
	else
		Form.MsgBox("알림", szErrMsg, "CHECK_FOREIGNER", 6)
	end	
end

-- =============================================================================
function Form_OnMsgBoxClose(sKeyName, sRet)
	if sKeyName == "CHECK_FOREIGNER" then
		Form.OpenStartScreen()
	end
end

-- =============================================================================
function Form_OnRefresh()
	Form.SetDelayEvent(1, 0.2)
end

-- =============================================================================
function Form_OnLinkData(sKey, sValue)
	if sKey == "&LOGIN_AUTH" then
		if gf_Tonumber(sValue) > 1 then
			--Form.SetDelayEvent(1, 0.2)
		else
			Form.OpenStartScreen()
		end
	elseif sKey == "17100_PWD_CHANGE" then
		-- --------------------------------
		-- 비밀번호 입력 완료
		-- --------------------------------
		if sValue ~= "" then
			local szAcnt
			
			tData = gf_Split(sValue, "★")
			
			if #tData > 0 then
				edtPwd.pwdlen = tData[2+1]
				edtPwd.caption = tData[1+1]
			end
		end
	end
end
	
