function Check_Version2()

	szOsType = Form.GetSharedData("..OS_TYPE", False) 
	szAppVer	= Form.GetSharedData("..APP_VERSION", False)
	szAppVer	= string.gsub(szAppVer, string.gsub(".", "([%p])", "%%%1"), "")
	
	 -------------------------------------------------------------------------
	 --안드로이드
	 -------------------------------------------------------------------------
	if szOsType == "1" then
		
		if gf_Tonumber(szAppVer) > 260 then
			return true
		else
			return false
		end
	
	 -------------------------------------------------------------------------
	 --iOS
	 -------------------------------------------------------------------------
	elseif szOsType == "2" then
		
		if gf_Tonumber(szAppVer) > 2559 then
			return true
		else
			return false
		end
	
	end
	
end

 --============================================================================
function Form_OnFormInitBefore()
	ChartEx0.SetLoadChart("foreignstock")
	
	szMin0 = Form.GetEnvData( "mhtro16000_chart_min0" )
	szTic0 = Form.GetEnvData( "mhtro16000_chart_tic0" )

	if szMin0 == "" or szMin0 == 0 then
		szMin0 = "1"
	end
	
	if szTic0 == "" or szTic0 == 0 then
		szTic0 = "1"
	end
	
	RadioGroup0.SetRadioCaption( 2, szMin0.."분" )
	RadioGroup0.SetRadioCaption( 3, szTic0.."틱" )
	
	ChartEx0.SetMarketCategory("7")
end

 --============================================================================
function Form_OnFormInit()
	g_flagInit = true
	g_flagMin = false
	g_flagTic = false
	g_flagWeek = false
	g_flagLine = false
	
	 --20250417 MSH START 화면이 완전히 뜨기 이전에 currentindex 설정시 다른 주기차트를 호출하는 오류 개선
 --	Dim szRadio
 --	szRadio = Form.GetEnvData("mhtro16000_t03_RADIO")
 --	if szRadio ~= nil and szRadio ~= ""	then
 --		RadioGroup0.currentindex = szRadio
 --	end if
	 --20250417 MSH END 
	
	g_szToday = Form.GetSharedData( "..HOST_DATE", 0 )
	setChart()
	
 --	PeriodSet(g_szChrtType)  --20250417 MSH
	
	 --20240610 SWJ START
	g_sUserID = Form.GetSharedData("..USER_ID", false)
	 --20240610 SWJ END
	
	
	 --20250313_01 HWG START : 차트 높이조정 로직 추가 
	if Check_Version2() == true then
		ChartEx0.height = 365
	end
	 --20250313_01 HWG END
			
end

 --============================================================================
function Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "RequestData" then
		g_sCode = sParam
		sTemp = gf_Split(g_sCode, "@")
		g_szExid = sTemp[0+1]  --시장구분
		g_szCode = sTemp[1+1]  --종목코드 
		g_rtChk = Form.GetSharedData( "REALTIME_"..g_szExid, false )
		
		 --20231016 LES START
		Check_Version()
		 --20231016 LES END
	
		RequestData()
		
		Form.SetTimerEvent2("2", 1, 0.2)
		ChartEx0.SetTradeData("")
	
	 --20250313_01 HWG START : 차트 높이조정 로직 추가 
	elseif sEventName == "RESIZE_CHART" then
		if Check_Version2() == true then
			if sParam == "TOP" then
				ChartEx0.height = 365
			else
				ChartEx0.height = 465
			end
		end
	elseif sEventName == "ENABLE_SCROLL" then
		if Check_Version2() == true then
			if sParam == "END" then
				ChartEx0.height = 465
			end
		end
	end
	 --20250313_01 HWG END
end

 --============================================================================
function SetChart()
	local szValue, szValueMinTick

     szValue 			= Form.GetEnvData( "mhtro16000_chart_setting" ) 			 --2^000000001
     szValueMinTick 	= Form.GetEnvData( "mhtro16000_chart_settingmintick" )    	 --1^1
     tempStock		= Form.GetEnvData( "mhtro16000_chart_stockmode" )    
      
	if tempStock ~= "" then
		g_sStockMode = tempStock
		ChartEx0.SetAdjustedStock(g_sStockMode)
	end
	
	if szValue == "" then
		Form.SetEnvData(1, "mhtro16000_chart_settingmintick", "2^001")
	     g_sPeriod 	 = "001"
	     g_sPeriodType = "2"
	     
	else
		temp = gf_Split(szValue, "^")
		g_sPeriodType = temp[0+1]
		g_sPeriod	= temp[1+1]
		
	end
	
	if szValueMinTick ~= "" then
		temp1 = gf_Split(szValueMinTick, "^")
		g_szMinType = temp1[0+1]
		g_szTicType = temp1[1+1]
		
	else
		 -- 20190404 HWG START
		 -- 차트 분,틱 설정값 세팅 오류 수정
		szMin0 = Form.GetEnvData( "mhtro16000_chart_min0" )
		szTic0 = Form.GetEnvData( "mhtro16000_chart_tic0" )
	
		if szMin0 ~= "" and szMin0 ~= 0 then
			g_szMinType = szMin0
		else
			g_szMinType = "1"
		end
		
		if szTic0 ~= "" and szTic0 ~= 0 then
			g_szTicType = szTic0
		else
			g_szTicType = "1"
		end
		 -- 20190404 HWG END     
	     
	end
	
	 --분틱 셋팅	
	tmpIndex = nil 
	if g_sPeriodType == "0" or g_sPeriodType == "1" then
		if g_sPeriodType == "0" then
			g_TempIndex = 3
			g_szChrtType = "T"
			RadioGroup0.SetRadioCaption( g_TempIndex, g_szTicType.."틱" )
			
		else
			g_TempIndex = 2
			g_szChrtType = "A"
			RadioGroup0.SetRadioCaption( g_TempIndex, g_szMinType.."분" )
			
		end
	
	else
		if g_sPeriodType == "2" then
			g_TempIndex = 0
			g_szChrtType = "D"
			
		elseif g_sPeriodType == "3" then
			g_TempIndex = 1
			g_flagWeek = false
			g_szChrtType = "W"
			RadioGroup0.SetRadioCaption( g_TempIndex, "주" )
			
 --PENTA13 START => 2019.05.08
		elseif g_sPeriodType == "4" then
			g_TempIndex = 1
			g_flagWeek = false
			g_szChrtType = "M"
			RadioGroup0.SetRadioCaption( g_TempIndex, "월" )
			
		else
			g_TempIndex = 1
			g_flagWeek = false
			g_szChrtType = "Y"
			RadioGroup0.SetRadioCaption( g_TempIndex, "년" )
			
		end
 --PENTA13 END
	end
	
	RadioGroup0.currentindex = g_TempIndex

end

 --======================================
function RequestData()
	DATAMANAGER.CancelRealData("ohhts_exst_cntg")
	DATAMANAGER.CancelRealData("ohhts_exst_cntd")  --20221213_01 KBC 해외주식주간거래
 --	20250513 KSJ START : 애프터장 분틱 챠트 시세 실시간 처리
	DATAMANAGER.CancelRealData("ohhts_exst_cnta")
 --	20250513 KSJ END

	szStockMode = "0"
	if g_sStockMode == "0" then
		szStockMode = "1"
	end
	
	PeriodSetChart(g_szChrtType)   --20230905 한국금융IT : 일주월분 차트 주기 설정
	
	if g_szChrtType == "A" then --분차트 end
		sMin = gf_Split(g_szMinType, "분", -1, 1)
		sTemp = sMin[0+1] * 60
		
		DATAMANAGER.SetDataValue( 0, "ohhts_5041_005r", "InBlock2", "FID_INPUT_HOUR_CLS_CODE", 0, sTemp )
		DATAMANAGER.SetDataValue( 0, "ohhts_5041_005r", "InBlock2", "FID_INPUT_DATE1" ,0,g_szToday)	
		DATAMANAGER.SetDataValue( 0, "ohhts_5041_005r", "InBlock2", "FID_INPUT_PAST_DATA_INCU_YN" , 0,"Y")
		DATAMANAGER.RequestTranData("ohhts_5041_005r")
		
	elseif g_szChrtType == "T" then --틱차트
		sTic = gf_Split(g_szTicType, "틱", -1, 1)
		
		DATAMANAGER.SetDataValue( 0, "ohhts_5041_006r", "InBlock2", "FID_INPUT_CNT1" , 0, sTic[0+1])
		DATAMANAGER.SetDataValue( 0, "ohhts_5041_006r", "InBlock2", "FID_INPUT_PAST_DATA_INCU_YN" , 0, "Y")
		DATAMANAGER.RequestTranData("ohhts_5041_006r")
		
	elseif g_szChrtType == "D" then --일차트
		DATAMANAGER.SetDataValue( 0, "ohhts_5041_001r", "InBlock2", "FID_INPUT_MOD_STPR_CLS_CODE", 0, szStockMode )
		DATAMANAGER.SetDataValue( 0, "ohhts_5041_001r", "InBlock2", "FID_INPUT_DATE1" ,0,g_szToday)	
		DATAMANAGER.RequestTranData("ohhts_5041_001r")
		
	elseif g_szChrtType == "W" then --주차트
		DATAMANAGER.SetDataValue( 0, "ohhts_5041_002r", "InBlock2", "FID_INPUT_DATE1" ,0,g_szToday)	
		DATAMANAGER.RequestTranData("ohhts_5041_002r")
		
	elseif g_szChrtType == "M" then --월차트
		DATAMANAGER.SetDataValue( 0, "ohhts_5041_003r", "InBlock2", "FID_INPUT_DATE1" ,0,g_szToday)	
		DATAMANAGER.RequestTranData("ohhts_5041_003r")
		
	elseif g_szChrtType == "Y" then --년차트
		DATAMANAGER.SetDataValue( 0, "ohhts_5041_004r", "InBlock2", "FID_INPUT_DATE1" ,0,g_szToday)	
		DATAMANAGER.RequestTranData("ohhts_5041_004r")
		
	end

end
