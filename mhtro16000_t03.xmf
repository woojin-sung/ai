 --			return 
 --		end if
 --
 --		Form.OpenPopupAnimation("mhcht13000_p5", "100,119,200" , "", "2")
 --		
 --	end if
	
	 --매매내역 추가
	sLineSetting = Form.LoadConfigData( "CHART_USE_LINE_OVERSTOCK".."_"..g_sUserID,"USE")
	
	if sLineSetting == "AvgBuyPrice" then
		
		gUseAvgBuyPrice = Form.LoadConfigData("CHART_AVGBUY_PRICE_OVERSTOCK".."_"..g_sUserID, "USE")
		
		if gUseAvgBuyPrice == "1" then
		
			 --로그인 여부 체크
			local sLOGIN_TYPE
			sLOGIN_TYPE = Form.GetSharedData("..LOGIN_TYPE", false )
			
			if gf_Tonumber(sLOGIN_TYPE) > 1 then --로그인상태 end
				Change_Use_AvgBuyPrice()
			else
				Form.OpenScreen("90020" , "90022")
				return 
			end
		
		else
			LoginCheck_PopupSetting()
		end
		
		
	elseif sLineSetting == "OrderList" then
		
		gUseOrderList = Form.LoadConfigData("CHART_ORDER_LIST_OVERSTOCK".."_"..g_sUserID, "USE")

		if gUseOrderList == "1" then
		
			 --로그인 여부 체크
			local sLOGIN_TYPE
			sLOGIN_TYPE = Form.GetSharedData("..LOGIN_TYPE", false )
			
			if gf_Tonumber(sLOGIN_TYPE) > 1 then --로그인상태 end
				Change_Use_OrderList()
			else
				Form.OpenScreen("90020" , "90022")
				return 
			end
		else
			
			LoginCheck_PopupSetting()
			
		end
	
	 --둘 다
	elseif sLineSetting == "Both" then
	
		gUseAvgBuyPrice = Form.LoadConfigData("CHART_AVGBUY_PRICE_OVERSTOCK".."_"..g_sUserID, "USE")
		gUseOrderList = Form.LoadConfigData("CHART_ORDER_LIST_OVERSTOCK".."_"..g_sUserID, "USE")
		
		if gUseAvgBuyPrice == "1" then
		
			 --로그인 여부 체크
			local sLOGIN_TYPE
			sLOGIN_TYPE = Form.GetSharedData("..LOGIN_TYPE", false )
			
			if gf_Tonumber(sLOGIN_TYPE) > 1 then --로그인상태 end
				Change_Use_AvgBuyPrice()
			else
				Form.OpenScreen("90020" , "90022")
				return 
			end
			
		end
		
		if gUseOrderList == "1" then
		
			 --로그인 여부 체크
			local sLOGIN_TYPE
			sLOGIN_TYPE = Form.GetSharedData("..LOGIN_TYPE", false )
			
			if gf_Tonumber(sLOGIN_TYPE) > 1 then --로그인상태 end
				Change_Use_OrderList()
			else
				Form.OpenScreen("90020" , "90022")
				return 
			end
		end

		LoginCheck_PopupSetting()
		
	else
	
		LoginCheck_PopupSetting()
			
	end
 --20240610 SWJ END
	
	
end
