 --======================================
function RadioGroup0_OnClick(nIndex)
	if nIndex == 0 then --일 end
		g_flagMin = false
		g_flagTic = false
		g_flagWeek = false
		g_szChrtType = "D"
		
		PeriodSet(g_szChrtType)
		
	elseif nIndex == 1 then --주/월/년
		g_flagMin = false
		g_flagTic = false
		
		if g_flagWeek == false then
			sTemp = RadioGroup0.GetRadioCaption(1)
			if sTemp == "월" then
				g_szChrtType = "M"
			elseif sTemp == "년" then
				g_szChrtType = "Y"	
			else
				g_szChrtType = "W"
			end
			
			g_flagWeek = true
			PeriodSet(g_szChrtType)
			
		else
			sTemp = RadioGroup0.GetRadioCaption(1)
			Form.OpenPopup( "mhcht13000_p4.xmf", sTemp, "" )
			
		end
		
	elseif nIndex == 2 then --분
		g_flagTic = false
		g_flagWeek = false
		g_szChrtType = "A"
		
		if g_flagMin == false then
			g_flagMin = true
			tmpMin = gf_Split(RadioGroup0.GetRadioCaption(2),"분")
			g_szMinType = tmpMin[0+1]
			
			PeriodSet(g_szChrtType)
			
		else
			if g_flagInit == true then
				PeriodSet(g_szChrtType)
			else
				Form.OpenPopup( "mhtro16020_p1.xmf" , g_szMinType , "" )
			end
			
		end
		
	elseif nIndex == 3 then --틱
		g_flagMin = false
		g_flagWeek = false
		g_szChrtType = "T"

		if g_flagTic == false then
			g_flagTic = true
			tmpTic = gf_Split(RadioGroup0.GetRadioCaption(3),"틱")
			g_szTicType = tmpTic[0+1]
			
			PeriodSet(g_szChrtType)
			
		else
			if g_flagMinTic == true then
				PeriodSet(g_szChrtType)
			else
				Form.OpenPopup( "mhtro16020_p2.xmf" , g_szTicType , "" )
			end

		end
	end

	Form.SetEnvData(1, "mhtro16000_t03_RADIO", RadioGroup0.currentindex)
	
	 --20240610 SWJ START
	 --처음 오픈했을 때 방지 및
	 --클릭했을 때는 인덱스가 달라졌을 때만
	if g_sInitFlag == False then
		if gRadioIndex ~= nIndex then
			Form.SetTimerEvent2(1, 1, 0.2)
			ChartEx0.SetTradeData("")
		end
	end
	
	
	gRadioIndex = nIndex
	 --20240610 SWJ END
end

 --======================================
function Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName == "Chart_Min" then
		g_szMinType = sRet
		RadioGroup0.SetRadioCaption( 2, g_szMinType )
		tmpMin = gf_Split(RadioGroup0.GetRadioCaption(2),"분")
		g_szMinType = tmpMin[0+1]
		
		PeriodSet(g_szChrtType)
		
		 --20240610 SWJ START
		 --콤보 인덱스가 달라졌을 때만
		if gCmbIndex ~= g_szMinType then
			 --Chart_UseWhatLine()
			Form.SetTimerEvent2("2", 1, 0.2)
			ChartEx0.SetTradeData("")
		end
		
		gCmbIndex = g_szMinType
		 --20240610 SWJ END
		
	elseif sKeyName == "Chart_Tic" then
		g_szTicType = sRet		
		RadioGroup0.SetRadioCaption( 3, g_szTicType)
		tmpTic = gf_Split(RadioGroup0.GetRadioCaption(3),"틱")
		g_szTicType = tmpTic[0+1]
		
		PeriodSet(g_szChrtType)
 --		
	elseif sKeyName == "Chart_WEEK" then
		if sRet == "월" then
			g_szChrtType = "M"
			
		elseif sRet == "년" then
			g_szChrtType = "Y"
			
		else
			g_szChrtType = "W"
			
		end
		
		RadioGroup0.SetRadioCaption( 1, sRet )
		PeriodSet(g_szChrtType)
		
 --20231016 LES START
	elseif sKeyName == "AvgBuyPrice_Accnt_Select" then
		Form.SaveConfigData("CHART_USE_LINE_OVERSTOCK".."_"..g_sUserID, "USE", "AvgBuyPrice")	 --20240610 SWJ
		Form.SaveConfigData("CHART_AVGBUY_PRICE_OVERSTOCK".."_"..g_sUserID, "USE", "1")		 --20240610 SWJ  : 다른 ID일 때 고려
		Form.SaveConfigData("CHART_AVGBUY_PRICE_OVERSTOCK".."_"..g_sUserID, "ACNT", sRet)		 --20240610 SWJ : 다른 ID일 때 고려
		Apply_Use_AvgBuyPrice()
	 --20231016 LES END
	
	 --20240610 SWJ START
	elseif sKeyName == "OrderList_Accnt_Select" then
		
 --		Form.SaveConfigData("CHART_AVGBUY_PRICE_OVERSTOCK", "USE", "1")
 --		Form.SaveConfigData("CHART_AVGBUY_PRICE_OVERSTOCK", "ACNT", sRet)
 --		Apply_Use_AvgBuyPrice()

		szData = gf_Split(sRet, "★")
		
		if #szData > 0 then
			
			g_sUserID = Form.GetSharedData("..USER_ID", false)
			
			Form.SaveConfigData("CHART_USE_LINE_OVERSTOCK".."_"..g_sUserID, "USE", szData[1+1])
			
			 --매수평균단가
			if szData[1+1] == "AvgBuyPrice" then
				
				Form.SaveConfigData("CHART_AVGBUY_PRICE_OVERSTOCK".."_"..g_sUserID, "USE", "1")
				Form.SaveConfigData("CHART_AVGBUY_PRICE_OVERSTOCK".."_"..g_sUserID, "ACNT", szData[0+1])
				Apply_Use_AvgBuyPrice()
		
			 --매매내역
			elseif szData[1+1] == "OrderList" then
				
				Form.SaveConfigData("CHART_ORDER_LIST_OVERSTOCK".."_"..g_sUserID, "USE", "1")
				Form.SaveConfigData("CHART_ORDER_LIST_OVERSTOCK".."_"..g_sUserID, "ACNT", szData[0+1])
				Apply_Use_OrderList()
			
			 --둘 다
			elseif szData[1+1] == "Both" then
				
				Form.SaveConfigData("CHART_AVGBUY_PRICE_OVERSTOCK".."_"..g_sUserID, "USE", "1")
				Form.SaveConfigData("CHART_ORDER_LIST_OVERSTOCK".."_"..g_sUserID, "USE", "1")
				
				Form.SaveConfigData("CHART_AVGBUY_PRICE_OVERSTOCK".."_"..g_sUserID, "ACNT", szData[0+1])
				Form.SaveConfigData("CHART_ORDER_LIST_OVERSTOCK".."_"..g_sUserID, "ACNT", szData[0+1])
				
				Apply_Use_OrderList()
				Apply_Use_AvgBuyPrice()
			
			end
			
		end
	 --20240610 SWJ END

	end
end

 --============================================================================
function ChartEx0_OnChangeAdjustedStock(sData)
	if g_sStockMode ~= sData then
		g_sStockMode = sData
		Form.SetEnvData( 1, "mhtro16000_chart_stockmode", g_sStockMode )
		RequestData()
	end
end
