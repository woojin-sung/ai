function Save_ini()
	local sMin, sTic, sflag
	
	for i = 0, 6 do
		Form.SetEnvData( 1, "mhtro16000_chart_mflag"..i, g_chartMinFlagArr[i] )
		Form.SetEnvData( 1, "mhtro16000_chart_min"..i, g_chartMinArr[i] )
		
		Form.SetEnvData( 1, "mhtro16000_chart_tflag"..i, g_chartTicFlagArr[i] )
		Form.SetEnvData( 1, "mhtro16000_chart_tic"..i, g_chartTicArr[i] )
	end
 --	Form.SetEnvData( 1, "chart_Count", g_sChartCnt )			 -- 데이터갯수...필요 없음 삭제 해도 됩니다.

end

