 --============================================================================
 -- 20231016 LES START
 --============================================================================
function Change_ItemCode()
	
	local sCodeData
	
	 --20250731 YSH START
	if g_sCode ~= "" and g_sCode ~= nil then
	 --if g_szItemCode == "" or g_szItemCode == nil then
		g_szItemCode = g_sCode
	end
	 --20250731 YSH END
	
	if g_szItemCode ~= "" and g_szItemCode ~= nil then
	
		sCodeData = gf_Split(g_szItemCode, "@")
	
		if #sCodeData > 1 then
	
			szExid = sCodeData[0+1]  --시장구분
			szCode = sCodeData[1+1]  --종목코드 
			
			 --20240610 SWJ START
			if szExid == "JP" then
				g_sCurrency = "JPY"
				g_sMarketCode = "05"
			elseif szExid == "SH" then
				g_sCurrency = "CNY"
				g_sMarketCode = "03"
			elseif szExid == "SZ" then
				g_sCurrency = "CNY"
				g_sMarketCode = "04"
			elseif szExid == "AX" or szExid == "NY" or szExid == "OQ" then
				g_sCurrency = "USD"
				g_sMarketCode = "01"
			elseif szExid == "HK" then
				g_sCurrency = "HKD"
				g_sMarketCode = "02"
			end
			 --20240610 SWJ END
			
			return szCode.."."..szExid
		
		end
	
	end

	 --20250731 YSH START
	return ""
	 --20250731 YSH END
	
end
 --============================================================================
 -- 20240610 SWJ START
 --============================================================================
function Chart_UseWhatLine()
	
	sLineSetting = Form.LoadConfigData( "CHART_USE_LINE_OVERSTOCK".."_"..g_sUserID,"USE")
	g_sUserID = Form.GetSharedData("..USER_ID", false)	
	
	if sLineSetting == "AvgBuyPrice" then
		Apply_Use_AvgBuyPrice()
	elseif sLineSetting == "OrderList" then
		Apply_Use_OrderList()
	
	elseif sLineSetting == "Both" then
		Apply_Use_OrderList()
		Apply_Use_AvgBuyPrice()

	end
	
	 --화면 첫 오픈 여부 판단
	g_sInitFlag = False
end
 --============================================================================
function LoginCheck_PopupSetting()
	
	 --로그인 여부 체크
	local sLOGIN_TYPE
	sLOGIN_TYPE = Form.GetSharedData("..LOGIN_TYPE", false )
			
	if gf_Tonumber(sLOGIN_TYPE) > 1 then --로그인상태 end
		
	else
		Form.OpenScreen("90020" , "90022")
		return
	end
	
	Form.OpenPopupAnimation(g_sChartPopup, "100,119,200" , "", "2") 

end

 --============================================================================
function Form_OnTimerEvent(sTimerID)
	
	Form.SetTimerEvent2(sTimerID, 0, 0.2)
	
	if gf_Tonumber(sTimerID) == 1 then
		sLineSetting = Form.LoadConfigData( "CHART_USE_LINE_OVERSTOCK".."_"..g_sUserID,"USE")
	
		if sLineSetting == "OrderList" then
			Apply_Use_OrderList()
		
		elseif sLineSetting == "Both" then
			Apply_Use_OrderList()
		
		end
	elseif gf_Tonumber(sTimerID) == 2 then
		Chart_UseWhatLine()
	end
end
 --============================================================================
function SetPriceMask(nPrice)
	
	LblInvisible.caption = nPrice
	
	if g_sCurrency == "JPY" then
		LblInvisible.mask = "0,0,,"..""..""..",1,1,1,1,0,0,0"
	elseif g_sCurrency == "CNY" then
		LblInvisible.mask = "0,0,,"..""..""..",1,1,3,1,0,0,0"
	elseif g_sCurrency == "USD" then
		LblInvisible.mask = "0,0,,"..""..""..",1,1,4,1,0,0,0"
	elseif g_sCurrency == "HKD" then
		LblInvisible.mask = "0,0,,"..""..""..",1,1,3,1,0,0,0"
	end
	
	nMaskedPrice = LblInvisible.dispcaption
	
	return nMaskedPrice
end
 --============================================================================
function DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	if szTranID == "obtro_cntg_611r" then
		ChartEx0.SetTradeData("")
	end
end

