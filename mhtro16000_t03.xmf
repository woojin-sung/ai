function Form_OnFormClose()
	Form.SetEnvData( 1,"mhtro16000_chart_setting" 	   , g_sPeriodType.."^"..g_sPeriod )
	Form.SetEnvData( 1,"mhtro16000_chart_settingmintick" , g_szMinType.."^"..g_szTicType )
		
	ChartEx0.SetSaveChart("1")
end

