function Image4_OnClick()

	 --20240610 SWJ START : gUseAvgBuyPrice 분기 밖 다 수정
	 --매매내역 추가
 --	gUseAvgBuyPrice = Form.LoadConfigData("CHART_AVGBUY_PRICE_OVERSTOCK", "USE")
