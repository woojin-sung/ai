function Form_OnRefresh()
	RequestData()
end
 --============================================================================
function ChartEx0_OnScrollEnd()
	 -- Chart Next Data
	if g_szChrtType == "A" then
		DATAMANAGER.RequestNextData("ohhts_5041_005r")
		
	elseif g_szChrtType == "T" then
		DATAMANAGER.RequestNextData("ohhts_5041_006r")
		
	elseif g_szChrtType == "D" then
		DATAMANAGER.RequestNextData("ohhts_5041_001r")
		
	elseif g_szChrtType == "W" then
		DATAMANAGER.RequestNextData("ohhts_5041_002r")
		
	elseif g_szChrtType == "M" then
		DATAMANAGER.RequestNextData("ohhts_5041_003r")
		
	elseif g_szChrtType == "Y" then
		DATAMANAGER.RequestNextData("ohhts_5041_004r")
		
	end
end

 --차트 불러오기
 --============================================================================
function ChartEx0_OnRequestData(nIndex, sData)
	if sData == "" or sData == nil then
		return
	end
	
	Data = gf_Split(sData, ";")

    --현재가내의 차트에서는 종목코드를 변경하지 않는다.
	g_szItemCode	= gf_Tostring(gf_Trim(Data[0+1]))              --코드
	g_sPeriodType	= gf_Tostring(gf_Trim(Data[1+1]))              --일주월년분틱
	g_sPeriod	= gf_Tostring(gf_Trim(Data[2+1]))              --주기(1,5,...)
	sRefresh 	= gf_Tostring(gf_Trim(Data[3+1]))
	radioIndex 	= ""
	
	if sRefresh == 1 or sRefresh == "1" or sRefresh == true then
		g_sPeriodType = "2"
		g_sPeriod = "1"
		radioIndex = 0
		g_szChrtType = "D"
		
		sTic = Form.GetEnvData( "mhtro16000_chart_tic0" )
		sMin = Form.GetEnvData( "mhtro16000_chart_min0" )

		if sTic == "" then
			sTic = "1"
		end
		
		if sMin == "" then
			sMin = "1"
		end
		
		RadioGroup0.SetRadioCaption( 3, sTic.."틱" )
		RadioGroup0.SetRadioCaption( 2, sMin.."분" )
		
	else
		 --PENTA13 START => 2023.07.04(차트성능개선)
		-- SELECT CASE 변환 (수동 보정 필요)
			if g_sPeriodType == "0" then
				g_szChrtType = "T"
				radioIndex = 3
				RadioGroup0.SetRadioCaption( radioIndex, g_sPeriod.."틱" )
				g_szTicType = g_sPeriod
				
			elseif g_sPeriodType == "1" then
				g_szChrtType = "A"
				radioIndex = 2
				RadioGroup0.SetRadioCaption( radioIndex, g_sPeriod.."분" )
				g_szMinType = g_sPeriod	 --한국금융IT => 2023.08.08(차트성능개선)
			
			elseif g_sPeriodType == "2" then
				g_szChrtType = "D"
				radioIndex = 0
			
			elseif g_sPeriodType == "3" then
				g_szChrtType = "W"
				radioIndex = 1
				RadioGroup0.SetRadioCaption( radioIndex, "주" )
			
			elseif g_sPeriodType == "4" then
				g_szChrtType = "M"
				radioIndex = 1
				RadioGroup0.SetRadioCaption( radioIndex, "월" )

			elseif g_sPeriodType == "5" then --PENTA13 START => 2019.03.04
				g_szChrtType = "Y"
				radioIndex = 1
				RadioGroup0.SetRadioCaption( radioIndex, "년" )

		end
		 --PENTA13 END
	end
	
 --PENTA13 START => 2023.07.31(차트성능개선)
	if ChartEx0.GetDivideNum() == 1 then
		RadioGroup0.currentindex = radioIndex
	else
		RadioGroup0.SetCurIndexSilent(radioIndex)
	end
	
	local sDwmm
	sDwmm = ChartEx0.GetStateDWMM()
	if sDwmm == "0" then
		RadioGroup0.enable = 1
	end
 --PENTA13 END
	
	ChartEx0.SetPeriodType(g_sPeriodType)
	ChartEx0.SetPeriodTime(g_sPeriod)

	local szName
	szName = Form.GetItemCodeInfo(g_szItemCode, "name")
	Form.SetOverStockItemCode(g_szItemCode.."★"..szName)

	RequestData()
end
 --============================================================================
 --PENTA13 START => 2023.07.25(차트성능개선)
function ChartEx0_OnSelectedChart(nIndex, sData)
	if sData == "" then
		return
	end

	if nIndex < 1 then
		return
	end

	Data = gf_Split(sData, ";")
	
	g_sPeriodType   = gf_Tostring(gf_Trim(Data[2+1]))
	g_sPeriod       = gf_Tostring(gf_Trim(Data[3+1]))
	
	if g_sPeriodType == "0" or g_sPeriodType == "1" then
		if g_sPeriodType == "0" then --틱 end
			g_TempIndex = 3
			g_szChrtType = "T"
			g_szTicType = g_sPeriod
			
			RadioGroup0.SetRadioCaption( g_TempIndex, g_szTicType.."틱" )
			
		else --분
			g_TempIndex = 2
			g_szChrtType = "A"
			g_szMinType = g_sPeriod
			
			RadioGroup0.SetRadioCaption( g_TempIndex, g_szMinType.."분" )
			
		end
	
	else
		g_sPeriod = "1"
		
		if g_sPeriodType == "2" then --일 end
			g_TempIndex = 0
			g_szChrtType = "D"			 --PENTA13 START => 2023.08.08(차트성능개선)
			
		elseif g_sPeriodType == "3" then --주
			g_TempIndex = 1
			g_flagWeek = false
			g_szChrtType = "W"
			RadioGroup0.SetRadioCaption( g_TempIndex, "주" )
			
		elseif g_sPeriodType == "4" then --월
			g_TempIndex = 1
			g_flagWeek = false
			g_szChrtType = "M"
			RadioGroup0.SetRadioCaption( g_TempIndex, "월" )
			
		else --년
			g_TempIndex = 1
			g_flagWeek = false
			g_szChrtType = "Y"
			RadioGroup0.SetRadioCaption( g_TempIndex, "년" )
		
		end
		
	end
	
	RadioGroup0.SetCurIndexSilent(g_TempIndex)
	
	local sDwmm
	sDwmm = ChartEx0.GetStateDWMM()
	if sDwmm == "1" then
		RadioGroup0.enable = 0
	end

end
 --PENTA13 END
 --============================================================================
function BtnLine_OnClick()
	if g_flagLine == false then
		g_flagLine = true
		ChartEx0.SetShowCrossLine("true")
		BtnLine.imgpath = "btn_chart01_o.9.png"
		
	else
		g_flagLine = false
		ChartEx0.SetShowCrossLine("false")
		BtnLine.imgpath = "btn_chart01_n.9.png"
		
	end
end

 --============================================================================
function Form_OnLinkData(sKey, sValue)
	if "&ITEM_CODE" == sKey then
 --PENTA13 START => 2023.07.31(차트성능개선)
		if g_szItemCode == sValue and g_flagInit == false then
			return
		end
 --PENTA13 END
	
		g_szItemCode = sValue
		RequestData()
		
		 --20240610 SWJ START
		 --20231016 LES START
		if g_bApplyVersion then
			
			if g_sInitFlag == False then
				Form.SetTimerEvent2("2", 1, 0.2)
				ChartEx0.SetTradeData("")
			end
		else
			Apply_Use_AvgBuyPrice()
		end
		 --20231016 LES END
		 --20240610 SWJ END
		
	 --20231016 LES START
	elseif sKey ==	"&LOGIN" then
	
		 --20240610 SWJ START
		 --Apply_Use_AvgBuyPrice()
		 --Chart_UseWhatLine()

		 --20231016 LES START
		if g_bApplyVersion then
			Form.SetTimerEvent2("2", 1, 0.2)
			ChartEx0.SetTradeData("")
		else
			Apply_Use_AvgBuyPrice()
		end
		 --20240610 SWJ END
		
	 --20231016 LES END
		
		
	end
end

