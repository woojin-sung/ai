	elseif szTranID == "ohhts_5041_006r" then
		DATAMANAGER.SetDataValue( false, "ohhts_5041_006r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" , 0 , "OV" )
		DATAMANAGER.SetDataValue( false, "ohhts_5041_006r", "InBlock1", "FID_INPUT_OVRS_ISCD" , 0 , g_szCode )
		DATAMANAGER.SetDataValue( false, "ohhts_5041_006r", "InBlock1", "FID_COND_MRKT_CLS_CODE" , 0 , g_szExid)
		DATAMANAGER.SetDataValue( false, "ohhts_5041_006r", "InBlock1", "FIDX_INPUT_DELY_RLTM_CLS_CODE" , 0 , g_rtChk )
		
		DATAMANAGER.SetDataValue( false, "ohhts_5041_006r", "InBlock2", "FID_INPUT_COND_MRKT_DIV_CODE" , 0 , "OV" )
		DATAMANAGER.SetDataValue( false, "ohhts_5041_006r", "InBlock2", "FID_INPUT_OVRS_ISCD" , 0 , g_szCode )
		DATAMANAGER.SetDataValue( false, "ohhts_5041_006r", "InBlock2", "FID_COND_MRKT_CLS_CODE" , 0 , g_szExid)
		DATAMANAGER.SetDataValue( false, "ohhts_5041_006r", "InBlock2", "FIDX_INPUT_DELY_RLTM_CLS_CODE" , 0 , g_rtChk )
		
	end
	
end

 --============================================================================
function DATAMANAGER_OnReceiveTranData(szTranID)
	local nDecimal
	nDecimal = gf_Tonumber(DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "FIDX_DCPN_CNT" , 0))
	ChartEx0.SetDecimal(nDecimal)
	ChartEx0.SetJisuCode(g_sCode)
	
	 --20211209 HWG START : 해외주식 차트 종목명 길이체크 로직추가
	local szName, sz40Name
	szName = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "FIDX_KOR_ISNM" , 0)
	
	if string.string.len(szName) > 39 then
		sz40Name = string.sub(szName, 1, 39)
		DATAMANAGER.SetDataValue(0, szTranID, "OutBlock1", "FIDX_KOR_ISNM" , 0 , sz40Name)
	end
	 --20211209 HWG END
	
	 --20221213_01 KBC START : 해외주식주간거래
	if szTranID == "ohhts_5041_006r" or szTranID == "ohhts_5041_005r" then
		sPRPR 			= DATAMANAGER.GetDataValue(false, szTranID , "OutBlock2" , "FIDX_PRPR" , 0)
		sPRDY_VRSS_SIGN 	= DATAMANAGER.GetDataValue(false, szTranID , "OutBlock2" , "FIDX_PRDY_VRSS_SIGN" , 0)
		sPRDY_CTRT 		= DATAMANAGER.GetDataValue(false, szTranID , "OutBlock2" , "FIDX_PRDY_CTRT" , 0)
		sACML_VOL 		= DATAMANAGER.GetDataValue(false, szTranID , "OutBlock2" , "FIDX_ACML_VOL" , 0)
		
		DATAMANAGER.SetDataValue(false, szTranID , "OutBlock1" , "FIDX_PRPR"				, 0 , sPRPR)
		DATAMANAGER.SetDataValue(false, szTranID , "OutBlock1" , "FIDX_PRDY_VRSS_SIGN"	, 0 , sPRDY_VRSS_SIGN)
		DATAMANAGER.SetDataValue(false, szTranID , "OutBlock1" , "FIDX_PRDY_CTRT"		, 0 , sPRDY_CTRT)
		DATAMANAGER.SetDataValue(false, szTranID , "OutBlock1" , "FIDX_ACML_VOL"			, 0 , sACML_VOL)
	end
	 --20221213_01 KBC END
end

 --============================================================================
function DATAMANAGER_OnReceiveTranComplete(szTranID)
	 --20250522_01 HWG START : 차트VOC 대응
	if szTranID = "ohhts_5041_001r" or szTranID = "ohhts_5041_002r"  or szTranID = "ohhts_5041_003r"  or szTranID = "ohhts_5041_004r"  or szTranID = "ohhts_5041_005r" or szTranID = "ohhts_5041_006r"then
		sLinkData = "PreOpen,;PreLow,;PreHigh,;PreClose,"
		ChartEx0.SetPrePriceData(sLinkData)
		
		ChartEx0.SetHolidaySchedule("")
	end
	 --20250522_01 HWG END
	
	DATAMANAGER.SetDataValue( 1, "ohhts_exst_cntg", "InBlock1", "FIDXR_ISCD", 0, g_sCode )
	DATAMANAGER.RequestRealData( "ohhts_exst_cntg" )
	
	 --20221213_01 KBC 해외주식주간거래
	if szTranID == "ohhts_5041_006r" or szTranID == "ohhts_5041_005r" then
		DATAMANAGER.SetDataValue( 1, "ohhts_exst_cntd", "InBlock1", "FIDXR_ISCD", 0, g_sCode )
		DATAMANAGER.RequestRealData( "ohhts_exst_cntd" )
 --		20250513 KSJ START : 애프터장 분틱 챠트 시세 실시간 처리
		DATAMANAGER.SetDataValue( 1, "ohhts_exst_cnta", "InBlock1", "FIDXR_ISCD", 0, g_sCode )
		DATAMANAGER.RequestRealData( "ohhts_exst_cnta" )
 --		20250513 KSJ END

		 --20250522_01 HWG START : 차트VOC 대응
		if szTranID == "ohhts_5041_005r" then
			sPRDY_OPRC	= DATAMANAGER.GetDataValue(false, "ohhts_5041_005r", "OutBlock1", "FIDX_PRDY_OPRC" , 0)
			sPRDY_HPRC 	= DATAMANAGER.GetDataValue(false, "ohhts_5041_005r", "OutBlock1", "FIDX_PRDY_HPRC" , 0)
			sPRDY_LPRC 	= DATAMANAGER.GetDataValue(false, "ohhts_5041_005r", "OutBlock1", "FIDX_PRDY_LPRC" , 0)
			sPRDY_CLPR 	= DATAMANAGER.GetDataValue(false, "ohhts_5041_005r", "OutBlock1", "FIDX_PRDY_CLPR" , 0)
			
			sLinkData = "PreOpen," .. gf_Tonumber(sPRDY_OPRC) .. ";PreLow," .. gf_Tonumber(sPRDY_LPRC) .. ";PreHigh," .. gf_Tonumber(sPRDY_HPRC) .. ";PreClose," .. gf_Tonumber(sPRDY_CLPR)
			ChartEx0.SetPrePriceData(sLinkData)
			
			if g_szExid == "OQ" or g_szExid == "AX" or g_szExid == "NY" then
				g_sHoliday = ""
				
				DATAMANAGER.ClearInputData(0, "obpdf_oscm_101r")
				
				sDate = Form.GetSharedData("..HOST_DATE", false)
				sYear = ""
				if sDate ~= "" then
					sYear = string.sub(sDate, 1, 4)
				end
			
				DATAMANAGER.SetDataValue(false, "obpdf_oscm_101r", "InBlock1", "STND_YEAR", 0 , sYear)
				DATAMANAGER.SetDataValue(false, "obpdf_oscm_101r", "InBlock1", "OVRS_STCK_MRKT_TR_CLS_CODE", 0 , "01")
				
				DATAMANAGER.RequestTranData("obpdf_oscm_101r")
			end
		end
		 --20250522_01 HWG END
		
	 --20231016 LES START
	elseif szTranID == "obtrs_comn_430r" then
		avgPrice = DATAMANAGER.GetDataValue(0, "obtrs_comn_430r", "OutBlock1", "AVRG_BYOV_PRC" , 0)
		
		if g_szItemCode == "" or g_szItemCode == nil then
			g_szItemCode = g_sCode
		end
		
		ChartEx0.SetAvgBuyPrice(g_szItemCode..";"..Gf_Tonumber(avgPrice))
	 --20231016 LES END
	
	end
	
	 --20240610 SWJ START
	
	local sChartSetting
	sChartSetting = ""
	
	if szTranID == "obtro_cntg_611r" then
		
		nCount = DATAMANAGER.GetDataCount(0, "obtro_cntg_611r" , "OutBlock1")
		
		sAcnt = Form.LoadConfigData("CHART_ORDER_LIST_OVERSTOCK".."_"..g_sUserID, "ACNT")
		sAcntNumber = string.sub(sAcnt, 1, 4) .. "-" .. string.sub(sAcnt, 5, 5 + 4 - 1) .. "-" .. string.sub(sAcnt, -2)
		
		local arrayOrderDate, arrayOrderTime, arrayBuyPrice, arraySellPrice, arrayBuyQuantity, arraySellQuantity, arrayDealClsCode
		
		arrayOrderDate = Array()
		
		arrayOrderTime = Array()
		
		arrayBuyPrice = Array()
		
		arraySellPrice = Array()

		arrayBuyQuantity = Array()
		
		arraySellQuantity = Array()
		
		arrayDealClsCode = Array()
		
		for i = 0, nCount - 1 do
			
			 --주문일자
			arrayOrderDate[i+1] = DATAMANAGER.GetDataValue(0, "obtro_cntg_611r", "OutBlock1", "ODER_DATE" , i)
			
			 --체결시각
			arrayOrderTime[i+1] = DATAMANAGER.GetDataValue(0, "obtro_cntg_611r", "OutBlock1", "CNTG_RCMS_TIME" , i)
			
			 --매수평균단가
			arrayBuyPrice[i+1] = DATAMANAGER.GetDataValue(0, "obtro_cntg_611r", "OutBlock1", "BYOV_UNPR" , i)
			
			 --매도평균단가
			arraySellPrice[i+1] = DATAMANAGER.GetDataValue(0, "obtro_cntg_611r", "OutBlock1", "SELN_UNPR" , i)
			
			 --매수평균체결합계
			arrayBuyQuantity[i+1] = DATAMANAGER.GetDataValue(0, "obtro_cntg_611r", "OutBlock1", "BYOV_CNTG_SMTN" , i)
			
			 --매도평균체결합계
			arraySellQuantity[i+1] = DATAMANAGER.GetDataValue(0, "obtro_cntg_611r", "OutBlock1", "SELN_CNTG_SMTN" , i)
			
			 --매매구분코드
			arrayDealClsCode[i+1] = DATAMANAGER.GetDataValue(0, "obtro_cntg_611r", "OutBlock1", "SELN_BYOV_CLCD" , i)
			
			
			if gChartPeriod == "D" then
				
				 --매수 2, 매도 1
				if arrayDealClsCode[i+1] == "2" then
					 --차트엔 매수구분 0으로 세팅
					 --sSetting = "0".."^"..arrayOrderDate[i+1].."^"..sAcntNumber.."^"..Gf_Tonumber(arrayBuyPrice[i+1]).."원".."^"..Gf_Tonumber(arrayBuyQuantity[i+1]).."주"
					sSetting = "0".."^"..arrayOrderDate[i+1].."^"..sAcntNumber.."^"..SetPriceMask(gf_Tonumber(arrayBuyPrice[i+1])).."^"..Gf_Tonumber(arrayBuyQuantity[i+1])
				else
					 --sSetting = arrayDealClsCode[i+1].."^"..arrayOrderDate[i+1].."^"..sAcntNumber.."^"..Gf_Tonumber(arraySellPrice[i+1]).."원".."^"..Gf_Tonumber(arraySellQuantity[i+1]).."주"
					sSetting = arrayDealClsCode[i+1].."^"..arrayOrderDate[i+1].."^"..sAcntNumber.."^"..SetPriceMask(gf_Tonumber(arraySellPrice[i+1])).."^"..Gf_Tonumber(arraySellQuantity[i+1])
				end
				
			else
			
				 --매수 2, 매도 1
				if arrayDealClsCode[i+1] == "2" then
					 --차트엔 매수구분 0으로 세팅
					 --sSetting = "0".."^"..arrayOrderTime[i+1].."^"..sAcntNumber.."^"..Gf_Tonumber(arrayBuyPrice[i+1]).."원".."^"..Gf_Tonumber(arrayBuyQuantity[i+1]).."주"
					sSetting = "0".."^"..string.sub(arrayOrderDate[i+1], -4)..arrayOrderTime[i+1].."^"..sAcntNumber.."^"..SetPriceMask(gf_Tonumber(arrayBuyPrice[i+1])).."^"..Gf_Tonumber(arrayBuyQuantity[i+1])
				else
					 --sSetting = arrayDealClsCode[i+1].."^"..arrayOrderTime[i+1].."^"..sAcntNumber.."^"..Gf_Tonumber(arraySellPrice[i+1]).."원".."^"..Gf_Tonumber(arraySellQuantity[i+1]).."주"
					sSetting = arrayDealClsCode[i+1].."^"..string.sub(arrayOrderDate[i+1], -4)..arrayOrderTime[i+1].."^"..sAcntNumber.."^"..SetPriceMask(gf_Tonumber(arraySellPrice[i+1])).."^"..Gf_Tonumber(arraySellQuantity[i+1])
				end
			end
			
			if i == 0 then
				sChartSetting = sSetting
			else
				sChartSetting = sChartSetting .. ";"..sSetting
			end
			
		end
		
		if sChartSetting ~= "" then
			 --Form.ShowAlert("TEST", nCount..";"..sChartSetting)
			ChartEx0.SetTradeData(nCount..";"..sChartSetting)
		else
			ChartEx0.SetTradeData("")
		end
		
	 --20250522_01 HWG START : 차트VOC 대응
	elseif szTranID == "obpdf_oscm_101r" then
		sDate = Form.GetSharedData("..HOST_DATE", false)
		sYear = ""
		if sDate ~= "" then
			sYear = string.sub(sDate, 1, 4)
		end
			
		for i = 0, 11 do
			nMonthIdx = i + 1
			for j = 0, 30 do
				nDayIdx = j + 1
				sYN = DATAMANAGER.GetDataValue(0,"obpdf_oscm_101r", "OutBlock1", "HLDY_YN" .. nDayIdx  , i)
				
				if sYN == "Y" then
					sMonth = string.sub("00" .. nMonthIdx, -2)
					sDay = string.sub("00" .. nDayIdx, -2)
					
					sWeekDate = WeekDay( CDate(sYear .. "-" .. sMonth .. "-" .. sDay) )
					
					if gf_Trim(sWeekDate) ~= "1" then
						if g_sHoliday ~= "" then
							g_sHoliday = g_sHoliday .. ";"
						end
					
						g_sHoliday = g_sHoliday .. sYear..sMonth..sDay
					end
				end
			end
		end
		
		DATAMANAGER.ClearInputData(0, "obpdf_oscm_101r_1")
				
		sDate = Form.GetSharedData("..HOST_DATE", false)
		sYear = ""
		if sDate ~= "" then
			sYear = gf_Tonumber(string.sub(sDate, 1, 4)) - 1
		end
	
		DATAMANAGER.SetDataValue(false, "obpdf_oscm_101r_1", "InBlock1", "STND_YEAR", 0 , sYear)
		DATAMANAGER.SetDataValue(false, "obpdf_oscm_101r_1", "InBlock1", "OVRS_STCK_MRKT_TR_CLS_CODE", 0 , "01")
		
		DATAMANAGER.RequestTranData("obpdf_oscm_101r_1")
		
	elseif szTranID == "obpdf_oscm_101r_1" then
		sDate = Form.GetSharedData("..HOST_DATE", false)
		sYear = ""
		if sDate ~= "" then
			sYear = gf_Tonumber(string.sub(sDate, 1, 4)) - 1
		end
			
		sHoliday = ""
		for i = 0, 11 do
			nMonthIdx = i + 1
			for j = 0, 30 do
				nDayIdx = j + 1
				sYN = DATAMANAGER.GetDataValue(0,"obpdf_oscm_101r_1", "OutBlock1", "HLDY_YN" .. nDayIdx  , i)
				
				if sYN == "Y" then
					sMonth = string.sub("00" .. nMonthIdx, -2)
					sDay = string.sub("00" .. nDayIdx, -2)
					
					sWeekDate = WeekDay( CDate(sYear .. "-" .. sMonth .. "-" .. sDay) )
					
					if gf_Trim(sWeekDate) ~= "1" then
						if sHoliday ~= "" then
							sHoliday = sHoliday .. ";"
						end
					
						sHoliday = sHoliday .. sYear..sMonth..sDay
					end
				end
			end
		end
		
		g_sHoliday = sHoliday .. ";" .. g_sHoliday
		
		ChartEx0.SetHolidaySchedule(g_sHoliday)
	 --20250522_01 HWG END
		
	end
	 --20240610 SWJ END
	
	g_flagInit = false
	g_flagMinTic = false
	
end

 --======================================
 --Chart 불러오기(기간)
 -- 설정창 닫을때 분,틱 주기 넘겨줌.
 --======================================
function ChartEx0_OnGetPeriodInfo()
	local sPeriodType
	local sMin, sTic
	sPeriodType = ""
	
    -- 차트 설정창에서 주기 값 넘어온 경우
    -- 분주기#틱주기 => 1;3;5;.../1;3;5;...
	for i = 0, 8 do
		sMin = Form.GetEnvData( "mhtro16000_chart_min"..i )  --분차트
		if sMin ~= "" then
			if i == 7 then
			    sPeriodType = sPeriodType..sMin.."/"
			else
				sPeriodType = sPeriodType..sMin..";"
			end
		end
	end
	
	for i = 0, 8 do
		sTic = Form.GetEnvData( "mhtro16000_chart_tic"..i )  --분차트
		if sTic ~= "" then
			if i == 7 then
			    sPeriodType = sPeriodType..sTic.."/"
			else
			    sPeriodType = sPeriodType..sTic..";"
			end
		end
	end
	
	if sPeriodType ~= "" then
		ChartEx0.SetSyncPeriodValueToChart(sPeriodType)
	end
end

 -- 차트설정 변경시
 --======================================
 function ChartEx0_OnChangePeriod(sPeriodType)
	 sMinArr = {}
	 sTicArr = {}
	 sDataArr = {}
 
	 g_sIsRequestChartEvent = "1"

    -- 차트 설정창에서 주기 값 넘어온 경우
    -- 분주기#틱주기 => 1;3;5;.../1;3;5;...
	if string.find(sPeriodType, "/") > 0 then
	    sTemp = gf_Split(sPeriodType, "/")
	    sMinArr = gf_Split(sTemp[0+1], ";")
	    sTicArr = gf_Split(sTemp[1+1], ";")
	     --Form.Log("sPeriodType",sPeriodType)
    
	    for i = 0, 7, 1 do
			Form.SetEnvData( 1, "mhtro16000_chart_min"..i, sMinArr[i] )
			Form.SetEnvData( 1, "mhtro16000_chart_tic"..i, sTicArr[i] )
	    end
	end
end

 --======================================
 -- 차트 설정 개수 변경시
 --======================================
function ChartEx0_OnByNumber(Count)
	if #Count == 1 then
		Count = "000"..Count
	   
	elseif #Count == 2 then
		Count = "00"..Count
	   
	elseif #Count == 3 then
		Count = "0"..Count
	   
	end

	g_sChartCnt = Count
	RequestData()
	
end

 --======================================
 -- 일,분,틱 주기별 차트 설정
 -- 0(틱),1(분) ,2(일), 3(주), 4(월), 5(년)
 --======================================
function PeriodSet(sPeriodType)
	if sPeriodType == "T" then
		g_sPeriod = g_szTicType
		g_sPeriodType = "0"
	   
	elseif sPeriodType == "A" then
		g_sPeriod = gf_Tonumber(g_szMinType) 
		g_sPeriodType = "1"
	   
	elseif sPeriodType == "D" then
		g_sPeriodType = "2"
		g_sPeriod ="1"
	   
	elseif sPeriodType == "W" then
		g_sPeriodType = "3"
		g_sPeriod = "1"
	   
	elseif sPeriodType == "M" then
		g_sPeriodType = "4"
		g_sPeriod = "1"
		
	elseif sPeriodType == "Y" then --PENTA13 START => 2019.05.08
		g_sPeriodType = "5"
		g_sPeriod = "1"

	end
	
	sPeriod = gf_Tonumber(g_sPeriod)
	if string.string.len(sPeriod)== 1 then
	   g_sPeriod = "00"..g_sPeriod
	   
	elseif string.string.len(sPeriod)== 2 then
	   g_sPeriod = "0"..g_sPeriod
	   
	end
	
	ChartEx0.SetPeriodType(g_sPeriodType)
	ChartEx0.SetPeriodTime(g_sPeriod)
 --   
	 -- 조회TR 보내기
	RequestData()	
end
 --======================================
 --20230905 한국금융IT START : 일주월분 차트 주기 설정
function PeriodSetChart(sPeriodType)
	if sPeriodType == "T" then
		g_sPeriod = g_szTicType
		g_sPeriodType = "0"
	   
	elseif sPeriodType == "A" then
		g_sPeriod = gf_Tonumber(g_szMinType) 
		g_sPeriodType = "1"
	   
	elseif sPeriodType == "D" then
		g_sPeriodType = "2"
		g_sPeriod ="1"
	   
	elseif sPeriodType == "W" then
		g_sPeriodType = "3"
		g_sPeriod = "1"
	   
	elseif sPeriodType == "M" then
		g_sPeriodType = "4"
		g_sPeriod = "1"
		
	elseif sPeriodType == "Y" then
		g_sPeriodType = "5"
		g_sPeriod = "1"

	end
	
	sPeriod = gf_Tonumber(g_sPeriod)
	if string.string.len(sPeriod)== 1 then
	   g_sPeriod = "00"..g_sPeriod
	   
	elseif string.string.len(sPeriod)== 2 then
	   g_sPeriod = "0"..g_sPeriod
	   
	end
	
	ChartEx0.SetPeriodType(g_sPeriodType)
	ChartEx0.SetPeriodTime(g_sPeriod)
end
 --20230905 한국금융IT END : 일주월분 차트 주기 설정
