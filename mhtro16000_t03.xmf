 --============================================================================
function Change_Use_AvgBuyPrice()

	gUseAvgBuyPrice = Form.LoadConfigData("CHART_AVGBUY_PRICE_OVERSTOCK".."_"..g_sUserID, "USE")

	if gUseAvgBuyPrice == "1" then
		
		gUseAvgBuyPrice = "0"
		Form.SaveConfigData("CHART_AVGBUY_PRICE_OVERSTOCK".."_"..g_sUserID, "USE", "0")
		
	
	else
	
		gUseAvgBuyPrice = "1"
		Form.SaveConfigData("CHART_AVGBUY_PRICE_OVERSTOCK".."_"..g_sUserID, "USE", "1")
		Image5.imgpath = "btn_switch_o"
	
	end
	
	Apply_Use_AvgBuyPrice()

end
