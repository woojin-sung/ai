		if gf_Tonumber(szAppVer) > 2547 then
			
			 -------------------------------------------------------------------------
			 -- 적용가능 버전
			 -------------------------------------------------------------------------
			g_bApplyVersion = true
			
			Label0.caption = "매매내역"
			g_sChartPopup = "mhcht13000_p6"
