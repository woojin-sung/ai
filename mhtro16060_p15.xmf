 ---------------------------------------------------------------------------------------------
 -- 01. 화 면 명 : PTP종목 경고안내
 -- 02. 화면설명 : 
 -- 03. 작    성 : 2022.12.06 KBC
 ---------------------------------------------------------------------------------------------

 --****************************************************************************
 --               G  L  O  B  A  L       V  A  R  I  A  B  L  E
 --****************************************************************************
local g_nCount
local g_nIndex -- 매도수구분 (0:매수, 1:매도, 2:정정, 3:취소)
local g_szErrMsg -- 경고메세지

g_nCount = 0
g_nIndex = "0"

 --****************************************************************************
 --            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             
 --****************************************************************************

 --============================================================================
function SendOrder()
    if g_nCount == 0 then
	    Form.SendReturnToParent( "PTP주문경고" , "1")
	    
	    g_nCount = 1
	    Form.CloseForm( )
    end
end
 --****************************************************************************
 --               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
 --****************************************************************************
 --============================================================================
function Form_OnFormInitBefore()
	local szData, arrData, szItemName

	szData = Form.GetOpenLinkData()
	
	arrData = gf_Split(szData,"|")
	
	if #arrData < 1 then
	    return
	end

	g_nIndex				= arrData[0+1]  -- 매도수구분 (0:매수, 1:매도, 2:정정, 3:취소, 10:예약매수, 11:예약매도, 12:예약취소)
	g_szErrMsg	 		= arrData[1+1]	 -- 경고메세지
	
end

 --============================================================================
function Form_OnFormInit()
	if g_nIndex == "0" then
		lblTitle.bgcolor = "92"
		btnOrder.btnimage = "btn_05.9"
		btnOrder.caption="매수"
		
	elseif g_nIndex == "1" then
		lblTitle.bgcolor = "91"
		btnOrder.btnimage = "btn_06.9"
		btnOrder.caption="매도"
	
	end
end

 --============================================================================
function btnOrder_OnClick()
	SendOrder()
end

 --============================================================================
function btnClose_OnClick()
	Form.CloseForm( )	
end

 --============================================================================
function imgClose1_OnClick()
	Form.CloseForm( )
end



	
</SCRIPT_INFO>
