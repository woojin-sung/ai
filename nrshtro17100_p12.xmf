		szInfo40 = "감시 설정 및 감시 시간      "
	else
		szInfo40 = "감시 설정 및 감시 시간"
	end
	
	local szInfo41 = "감시 조건 설정 가능 시간 : 24시간"
	local szInfo42 = "(단, 당사 시스템 점검 시간 제외)"
	local szInfo43 = "감시 설정 가능 개수 : 매수/ 매도 각 50개"
	local szInfo44 = "감시 유효 기간"
	local szInfo45 = "최대 90일 (달력 일자 기준/ 휴일, 공휴일 포함)"
	local szInfo46 = "유효기간 만료 시 종료일은 해당 시장의 정규장 마감 시간을 기준으로 종료되며 감시조건은 자동으로 중지됩니다."
	local szInfo47 = "ex) 종료일이 5월 12일 인 경우 한국시간으로 5월13일 06:00(서머타임05:00)에 종료"
	local szInfo48 = "감시 및 주문 가능 시간 "
