	end
	
	local szInfo51 = "미국 거래소 (뉴욕, 나스닥, 아멕스)의 주식, ETF, ETN 종목만 가능합니다."
	local szInfo52 = "ETF, ETN 종목은 ETP 거래 신청 후 이용 가능하며 해외(주식/ETP) 거래신청화면에서 신청 가능 합니다."
	local szInfo53 = "소수점, 대출 잔고, 일부PTP종목, OTC장외시장 종목은 설정이 불가합니다."
	local szInfo54 = "신규상장 등으로 전일종가가 없는 경우, 전일종가 또는 직전 체결가가 2달러 미만인 종목은 시장가 주문이 불가합니다."
	
	local szInfo60
	if g_szOsType == "2" then
		szInfo60 = "기타 유의사항    "
	else
		szInfo60 = "기타 유의사항"
	end
	
	local szInfo61 = "감시조건 등록 시에는 주문가능금액(예수금), 주문가능수량 등을 체크하지 않고 등록됩니다."
	local szInfo62 = "감시조건에 도달하여 실제 주문이 실행되는 시점에 예수금, 주문가능수량 부족 등의 문제로 주문이 거부 될 수 있으므로 반드시 감시내역과 주문내역을 확인하시기 바랍니다."
	local szInfo63 = "주문가능금액은 외화예수금으로 주문 가능하며, 통합증거금 서비스 신청 계좌는 통합주문가능금액으로 주문됩니다."
	local szInfo64 = "감시 설정 후 계좌 비밀번호를 변경 한 경우 주문 실행 시 거부 처리되므로 계좌비밀번호 변경 후 반드시 감시 조건을 삭제 후 재설정 하시기 바랍니다."
	local szInfo65 = "감시 유효 기간이 종료 되거나, 감시 조건에 도달하여 주문이 실행된 경우(체결 여부와 상관 없음) 자동감시주문이 종료되어 감시내역에서 삭제되므로 실행내역을 확인해 주시기 바라며 같은 조건 주문이 필요한 경우에는 신규 설정을 해주시기 바랍니다."
	local szInfo66 = "감시에 의한 자동주문 실행 후 부분 체결에 의한 잔량 상황은 고려하지 않습니다."
	local szInfo67 = "시스템 오류 및 종목 정보 오류 시 해당 감시 조건은 감시내역에서 삭제될 수 있으므로 감시내역, 실행내역, 주문체결 여부를 수시로 확인하시기 바랍니다."
	local szInfo68 = "감시 조건 변경 시, 실행 중인 감시 종목은 중지 처리되며 변경된 조건으로 감시 실행을 원하는 경우 감시 작동을 재 실행 해주시기 바랍니다."
	local szInfo69 = "거래정지, 권리 (권리락, 배당락, 액면분할, 액면병합, 증자, 감자 등) 발생, 종목정보변경 (ISIN코드, Tiker, 거래소 변경, 재상장 등), 상장폐지, OTC 종목으로 전환, 전일 종가 대비 기준가격이 변동된 경우 감시가 중지 처리 되며 정규장 마감 후 감시내역에서 삭제되므로 실행내역에서 종료 여부를 확인하시기 바랍니다."
	local szInfo610 = "감시 중지 CASE에 해당 하더라도 시장 급변에 의해 매도될 수 있음을 유의하시기 바랍니다."
	local szInfo611 = "감시 조건에 도달하였으나 주문 실행 시점에 주문가능금액 부족, 주문가능수량 부족(보유잔고가 청산되어 주문가능수량이 없는 경우 포함), 주문금액이 개인 15억 / 법인 20억을 초과하는 주문, 조건 설정 후 비밀번호가 변경된 경우, 사고/질권설정 등 계좌상태가 정상이 아닌 경우 등 주문 실행이 불가한 경우 자동주문 실행이 거부 처리 되오니 실행내역 및 주문 체결 여부를 수시로 확인하시기 바랍니다."
	local szInfo612 = "감시 조건에 도달하여 주문 실행 후 브로커 거부(브로커의 수량 및 주문 가격 제한 범위에 벗어난 주문, 호가단위 불일치, MOC/LOC 장마감 10분 이후 주문 등) 및 거래소 매매 체결 시스템에서 거부가 발생 할 수 있습니다."
	local szInfo613 = "해외 현지 거래소 휴일 및 기타 사유로 인하여 거래소 거래가 정지될 경우, 정지된 시간 이후 낸 주문에 대해 주문이 거부 될 수 있습니다."
	local szInfo614 = "시세급변에 따라 감시시작과 동시에 감시조건에 만족되어 주문이 실행 될 수 있습니다."
	local szInfo615 = "시세 급변 및 주문폭주 시 체결 전송 지연, 시세 누락 등 으로 인하여 주문 미처리 및 미체결등의 오류가 발생 하거나 지연될 수 있습니다. 또한 원하지 않은 호가에 주문 처리될 수 있습니다."
	local szInfo616 = "시세 급변 및 주문 폭주 시 감시에 의한 이익실현, 이익보존, 손실제한 주문 미체결 건이 현재가보다 높거나 낮을 경우 주문 체결이 되지 않을 수 있습니다."
	local szInfo617 = "감시조건을 만족했을때 미리 설정한 주문가격에 따라 다시 현재 시세를 조회하므로 시세급변 시에는 감시조건을 만족한 가격과 시차가 생길 수 있습니다."
	local szInfo618 = "사용자 PC상태, 통신회선상태, 해당 거래소 주문접수 상태 및 체결지연상태, 시세정보의 전송지연 등으로 인하여 주문 미처리등의 오류가 발생할 수 있습니다."
	local szInfo619 = "당사는 전산 부하를 방지하기 위해 자동주문의 조건입력 횟수나 이용할 수 있는 고객 자격 등을 회사 내부 기준에 의해 제한할 수도 있습니다."
	local szInfo620 = "자동주문시스템에 장애 등이 발생하여 주문 불가 상황이 지속될 경우 전체 등록 조건을 모두 임의 해지 할 수 있습니다."
	local szInfo621 = "고객 의사가 아닌 감시 중지 처리 및 자동주문 전송이 실패한 경우 PUSH 및 알림톡으로 안내 드리며 알림을 원치 않는 경우 환경설정 > 알림 > 푸시알리미 > 자동감시주문 알림설정에서 off 로 변경 가능 합니다."
	
