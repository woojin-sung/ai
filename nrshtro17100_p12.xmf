-- 컨트롤 초기설정
-- ===============================================
function Init_Control()
	-- -----------------------------------------------
	-- 배경이미지 초기화
	-- -----------------------------------------------
	imgBg.imgpath = g_szBgImg
	
	-- -----------------------------------------------
	-- 타이틀 초기화
	-- -----------------------------------------------
	lblTitle.paddinginfo = "0,0,0,0"
	g_szTitle = "유의사항 "
	lblTitle.caption = g_szTitle
	
	-- -----------------------------------------------
	-- 닫기 버튼 초기화
	-- -----------------------------------------------
	imgClose.SetMaintainingRatio("3")
	imgClose.imgpath = g_szCloseImg
	local sTheme = Form.GetEnvData("common.theme")
	
	-- -----------------------------------------------
	-- 유의사항 본문내용 초기화
	-- -----------------------------------------------
	local szInfo10
	if g_szOsType == "2" then
		szInfo10 = "자동감시주문이란?     "
	else
		szInfo10 = "자동감시주문이란?"
	end
	
	local szInfo11 = "사용자가 원하는 종목에 대해 감시 조건과 주문설정을 저장하고 감시를 시작하면 유효기간 동안 당사 시스템에서 감시가 진행되며 감시조건이 충족하는 시점에 자동으로 주문을 실행하는 기능입니다."
	
	local szInfo20
	if g_szOsType == "2" then
		szInfo20 = "설정방법   "
	else
		szInfo20 = "설정방법"
	end
	
	local szInfo210 = "자동감시주문은 종합매매, Super365계좌만 이용 가능하며 주문대리인은 자동감시주문 이용이 불가 합니다."
	local szInfo21 = "감시조건, 주문조건, 유효기간을 입력하여 설정합니다."
	local szInfo22 = "매수 감시 조건으로는 현재가, 시가, 고가, 저가, 전일종가대비, 등락률(전일종가대비)이 있으며 시가, 고가, 저가는 당일 기준으로 처리 됩니다."
	local szInfo23 = "매도 감시 조건으로는 이익실현, 이익보존, 손실제한이 있으며, 조건 설정 시 기준가를 기준으로 감시 조건을 설정합니다."
	local szInfo24 = "기준가는 이익청산(이익실현,이익보존), 손절매(손익제한) 가격을 설정하기 위한 기준가격으로 평균단가, 직접입력, 전일종가 중 선택하여 사용합니다."
	local szInfo25 = "기준가를 평균단가로 설정한 경우 평균단가는 조건 설정 시점의 평균매입단가로 설정이 되며, 설정 후 해당 종목의 평균단가가 변동된 경우 자동으로 반영되지 않습니다. 평균단가 조정을 원하시면 조건을 조건수정 또는 삭제 후 재설정하여 사용하시기 바랍니다."
	local szInfo26 = "매도 감시 조건 설정 시 이익실현, 이익보존, 손실제한을 모두 설정하거나, 1개 조건도 설정이 가능합니다."
	local szInfo27 = "(단, 이익보존은 이익실현 조건 설정 시에만 설정이 가능합니다.)"
	local szInfo28 = "감시조건 등록 후 반드시 감시 실행 버튼을 클릭해야지만 감시가 시작되며, 조건 설정만으로는 감시가 실행되지 않습니다."
	local szInfo29 = "감시 시작과 동시 설정한 감시 조건에 도달하면 주문이 바로 실행 되오니 감시내역, 실행내역, 주문체결내역을 확인하시기 바랍니다."
	
	local szInfo30
	if g_szOsType == "2" then
		szInfo30 = "매도 감시 조건 상세 알아보기        "
	else
		szInfo30 = "매도 감시 조건 상세 알아보기"
	end
	
	local szInfo31 = "1. 이익실현 이란?"
	local szInfo32 = "주가가 기준가 대비 상승하여 목표로 정한 이익실현 가격에 도달 시 감시가 실행되어, 설정한 주문 방법으로 매도 주문이 실행돼요."
	local szInfo33 = "$500(기준가)를 초과하여, $550(이익실현) 도달 시 설정한 주문 조건으로 자동 주문이 실행돼요."
	local szInfo34 = "2. 이익보존 이란?"
	local szInfo35 = "주가가 기준가 대비 상승하여, 이익보존 가격 도달 후 초과 상승하였으나, 이익실현 가격에 도달하지 못하고 하락하여 이익보존 가격 이하로 도달 시 매도주문이 실행돼요."
	local szInfo36 = "$500(기준가)를 초과하여 $550(이익실현) 도달 시 이익실현 주문이 실행되고"
