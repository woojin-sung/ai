 --============================================================================
 -- 주문전송 전 입력값 정합성 검증
 --============================================================================
function Check_InputData(sGubun)
	
	
	if sGubun == "Order" then
		
		 --계좌번호
		szAcnt = Form.GetTopCtlProp("acnt", "caption")
		if string.len(szAcnt) < 10 then
			Form.ShowAlert(g_szTitle, "계좌번호를 확인후 다시 입력하십시오.")
			return False
		end
		
		 --계좌비밀번호
		szPwd = Form.GetTopCtlProp("edtPwd", "caption")
		if gf_Trim(szPwd) == "" then
			 --Form.ShowAlert(g_szTitle, "비밀번호를 확인후 다시 입력하십시오.")
			Form.TriggerEvent("#", "ShowPasswordKeyPad", "")
			return False
		end
		
		 --종목코드
		if gf_Trim(g_szCd) == "" then
			Form.ShowAlert(g_szTitle, "종목코드를 입력하십시요.")
			return false
		end
		
		 --수량
		if gf_Trim(edtQty.caption) == "" or gf_Trim(edtQty.caption) == "0" then
			Form.ShowAlert(g_szTitle, "주문수량을 입력하십시요.")
			return false
		end
		
		 --가격
		if gf_Trim(edtPrc.caption) == "" or gf_Trim(edtPrc.caption) == "0" then
			
			 --20241128 LES START
			 --시장가일때는 가격체크 무시
			if Check_PrcOrd() ~= "시장가" then
				Form.ShowAlert(g_szTitle, "주문가격을 입력하십시요.")
				return false
			end
			
			
		end
		
		return true
		
	end
	
end

 --============================================================================
 -- 주문확인창/경고팝업 오픈
 --============================================================================
function Open_ConfirmPopup(szWarn)
	
	local szData, szOrdNm
	szOrdNm = Check_OrdName()
	
	 --20241128 LES START
	 --시장가/지정가 구분 텍스트 넘기기
	szPrcOrdNm = Check_PrcOrd()
	
	sCodeData = gf_Split(g_szCd, "@")	
	szData = "10"													 -- 0.매매구분
	szData = szData .. "|" .. Form.GetTopCtlProp("acnt", "caption")		 -- 1.계좌번호
	szData = szData .. "|" .. Form.GetTopCtlProp("acnt", "accountname")	 -- 2.계좌명
	szData = szData .. "|" .. sCodeData[1+1]								 -- 3.종목코드
	szData = szData .. "|" .. g_szKorName								 -- 4.종목명
	szData = szData .. "|" .. szOrdNm									 -- 5.주문구분
	szData = szData .. "|" .. "0"										 -- 6.현금
	szData = szData .. "|" .. edtQty.caption							 -- 7.주문수량
	szData = szData .. "|" .. edtPrc.caption							 -- 8.주문가격
	szData = szData .. "|" .. ""										 -- 9.원주문번호
	szData = szData .. "|" .. ""										 -- 10.전량전부
	szData = szData .. "|" .. g_szDecimal								 -- 11.가격자릿수
	szData = szData .. "|" .. g_szCurrency								 -- 12.통화기호
	
	szType = Label0.caption
	szData = szData .. "|" .. Label0.caption							 -- 13.예약주문유형
	if szType == "일반예약" then
		szData = szData .. "|" .. ""											 -- 14.예약기간
	elseif szType == "특정일주문" then
		szData = szData .. "|" .. lblstart.dispcaption							 -- 14.예약기간
	else
		szData = szData .. "|" .. lblstart.dispcaption .. "~" .. lblend.dispcaption	 -- 14.예약기간
	end
	
	szData = szData .. "|" .. lblgubnStr.caption								 -- 15.예약주문시간구분
	
	 --20241128 LES START
	szData = szData .. "|" .. szPrcOrdNm										 -- 16.시장가or지정가
	
	 --주문확인창 주문가격 20250102 HSZ
	gConfirmPrice		= edtPrc.caption								 -- 주문가격
	
	 ------------------------------------------------------
	 -- 경고팝업 오픈
	 ------------------------------------------------------
	if gf_Trim(szWarn) ~= "" then
		
		 --경고메세지 추가	
		szData = szData .. "|" .. szWarn										 -- 17.경고메시지	
		Form.OpenPopupAnimation("mhtro16100_p8", szData , "", "2")
	
	 ------------------------------------------------------
	 -- 주문확인팝업 오픈
	 ------------------------------------------------------
	else
		
		Form.OpenPopupAnimation("mhtro16100_p3", szData , "", "2")
		
	end
	
end

 --============================================================================
 -- 주문유형코드
 --============================================================================
function Check_OrdType()
	local szIdx
	szIdx = gf_Tostring(cmbType.currentindex)
	
	-- SELECT CASE 변환 (수동 보정 필요)
		if szIdx == "0" then
			return "01"  --지정가
		
		 --20241128 LES START
		elseif szIdx == "1" then
			return "05"  --시장가
		
 --		Case "1"        
 --			return "31" 'LOO
		elseif szIdx == "2" then
			return "32"  --LOC
		elseif szIdx == "3" then
			return "35"  --Limit VWAP
		elseif szIdx == "4" then
			return "36"  --Limit TWAP
	end
	
end

 --============================================================================
 -- 20241128 Check_PrcOrd 지정가/시장가 구분
 --============================================================================
function Check_PrcOrd()
	
	local szIdx
	szIdx = Check_OrdType()
	
	 --시장가/MOO(장개시시장가)/MOC(장마감시장가)/VWAP(수량분할)/TWAP(시간분할)
	if szIdx == "05" then
		return "시장가"
	else
		return "지정가"
	end
	
end

 --============================================================================
 -- 주문조건구분코드
 --============================================================================
function Check_OrdCond()
	local szIdx
	szIdx = Check_OrdType()
	
	-- SELECT CASE 변환 (수동 보정 필요)
		if szIdx == "01" then
			return "1"  --지정가 '20220725 LES START 구분값 오류수정
		
		 --20241128 LES START
		elseif szIdx == "05" then
			return "2"  --시장가
		
		elseif szIdx == "31" then
			return "4"  --LOO
		elseif szIdx == "32" then
			return "5"  --LOC
		elseif szIdx == "35" then
			return "8"  --Limit VWAP
		elseif szIdx == "36" then
			return "9"  --Limit TWAP
	end
	
end

 --============================================================================
 -- 주문유형명 가져오기
 --============================================================================
function Check_OrdName()
	
	local szIdx
	szIdx = Check_OrdType()
	
	-- SELECT CASE 변환 (수동 보정 필요)
		if szIdx == "01" then
			return "보통(지정가)"
		elseif szIdx == "05" then
			return "시장가"
		elseif szIdx == "31" then
			return "LOO(장개시지정가)" 
		elseif szIdx == "32" then
			return "LOC(장마감지정가)" 
		elseif szIdx == "33" then
			return "MOO" 
		elseif szIdx == "34" then
			return "MOC" 
		elseif szIdx == "35" then
			return "Limit VWAP(가격제한수량분할)" 
		elseif szIdx == "36" then
			return "Limit TWAP(가격제한시간분할)" 
		elseif szIdx == "37" then
			return "VWAP" 
		elseif szIdx == "38" then
			return "TWAP" 
	end
	
end

 --============================================================================
 -- 주문전송
 --============================================================================
function Request_Order()
	
	 --------------------------
	 -- 해외주식 주문착오 방지
	 --------------------------
	g_szWarnFlag	= "N"
	
	 --------------------------
	 -- 주문서비스 호출
	 --------------------------
	DATAMANAGER.RequestTranData("obtro_oder_112a")
	
end

 --============================================================================
 -- 팝업창 리턴처리
 --============================================================================
function Form_OnPopupReturn(sKeyName, sRet)
	
	 -- ----------------------------------------------------------------------
	 -- (사용)해외주식 주문착오 방지 (경고팝업에서 리턴)
	 -- ----------------------------------------------------------------------	
	if sKeyName == "주문경고" then
		if sRet == "1" then
			g_szWarnFlag = "Y"
			DATAMANAGER.RequestTranData(g_szTR)
		end
	
	 -- ----------------------------------------------------------------------
	 -- (사용)PTP경고팝업에서 리턴 (20221206_01 KBC START : 해외주식 미국PTP 종목과세관련)
	 -- ----------------------------------------------------------------------	
	elseif sKeyName == "PTP주문경고" then
		if sRet == "1" then
			g_szWarnFlag = "Y"
			DATAMANAGER.RequestTranData(g_szTR)
		end
	
	 -- ----------------------------------------------------------------------
	 -- (사용)주문확인창에서 리턴
	 -- ----------------------------------------------------------------------	
	elseif sKeyName == "주문전송" then
		if sRet == "1" then
			 --20250102 HSZ START
			if gf_Tonumber(cmbType.currentindex) == 0 and g_szOdrPop == "1" then --지정가&주문확인창 사용 CASE
				if gf_Trim(gConfirmPrice) ~= "" then
					if gf_Tonumber(edtPrc.caption) ~= gf_Tonumber(gConfirmPrice) then --입력된 주문 가격이 다른 경우에만
						edtPrc.caption = gConfirmPrice
						
						gNoSettingQty = true
						Request_Able()
						Calc_OrderPrice()
					end
				end
			end
			 --20250102 HSZ END
		
			Request_Order()	
		end
	
	 -- ----------------------------------------------------------------------
	 -- (미사용)수량/금액입력창에서 리턴
	 -- ----------------------------------------------------------------------	
	elseif sKeyName == "QTY_POPUP" then
		edtQty.caption = sRet
		edtQty_OnEditComplete()
		
		 btnCash.btnimage = "btn_02.9.png"
		 btnMax.btnimage  = "btn_02.9.png"
			
	 -- ----------------------------------------------------------------------
	 -- (미사용)가격입력창에서 리턴
	 -- ----------------------------------------------------------------------	
	elseif sKeyName == "PRC_POPUP" then
		edtPrc.caption = sRet		
		 --edtPrc_OnEditComplete()
	
	 -- ----------------------------------------------------------------------
	 -- (사용)가격/수량 입력창에서 리턴
	 -- ----------------------------------------------------------------------	
	elseif sKeyName == "InputKeyPad" then
		
		arrData = gf_Split(sRet,"★")
		edtPrc.caption = arrData[0+1]	
		edtQty.caption = arrData[1+1]	
		Calc_OrderPrice()
		
		gNoSettingQty = true
		Request_Able()
	
	 -- ----------------------------------------------------------------------
	 -- (사용) 주문가능수량 조회팝업에서 수량라벨 클릭 후 수량 리턴
	 -- ----------------------------------------------------------------------	
	elseif sKeyName == "OrderAble_Popup" then
	
		arrData = gf_Split(sRet,"★")
		edtPrc.caption = arrData[0+1]	
		edtQty.caption = arrData[1+1]	
		Calc_OrderPrice()
		
		gNoSettingQty = true
		Request_Able()
		
	 ------------------------------------------------------------------------
	 -- (사용) 20241128 LES START - 주문가능수량 조회팝업 그냥 닫음
	----------------------------------------------------------------------
	elseif sKeyName == "OrderAble_Popup_Close" then
	
		 --gNoSettingQty = true : 주문가능수량 조회 후, [수량입력] 에디트 그대로 유지
		gNoSettingQty = true
		Request_Able()
		
	 ------------------------------------------------------------------------
	 -- (미사용) 20210329 LES START 통합증거금 - 수량조회팝업 리턴
	 ------------------------------------------------------------------------
	elseif sKeyName == "16060_p8" then
		edtQty.caption = sRet
		edtQty_OnEditComplete()
	 -- ----------------------------------------------------------------------
	 -- (사용) 기간예약창에서 리턴 YGH Edit 
	 -- ----------------------------------------------------------------------
	elseif sKeyName == "Range" then
		
		 --예약구분★시작일자★종료일자★시간구분
		tData = gf_Split(sRet, "★")
		if #tData > 0 then
		
			local szGubun
 --			0`장개시
 --			3`장개시 30분 후
 --			1`장마감 10분 전
 --			2`장마감 30분 전
			szGubun = tData[3+1]
			-- SELECT CASE 변환 (수동 보정 필요)
			if szGubun == "0" then
				szGubun = "장개시"
			elseif szGubun == "1" then
				szGubun = "장마감 10분 전"
			elseif szGubun == "2" then
				szGubun = "장마감 30분 전"
			elseif szGubun == "3" then
				szGubun = "장개시 30분 후"
			end

			if tData[0+1] == "0" then
				Label0.caption = "일반예약"
				lblstart.caption = tData[1+1]
				lblend.caption = tData[2+1]
				lblgubn.caption = tData[3+1]
				lblgubnStr.caption = szGubun

			elseif tData[0+1] == "1" then
				Label0.caption = "기간잔량"
				lblstart.caption = tData[1+1]
				lblend.caption = tData[2+1]
				lblgubn.caption = tData[3+1]
				lblgubnStr.caption = szGubun

			elseif tData[0+1] == "2" then
				Label0.caption = "기간예약"
				lblstart.caption = tData[1+1]
				lblend.caption = tData[2+1]
				lblgubn.caption = tData[3+1]
				lblgubnStr.caption = szGubun

			elseif tData[0+1] == "3" then
				Label0.caption = "특정일주문"
				lblstart.caption = tData[1+1]
				lblend.caption = tData[2+1]
				lblgubn.caption = tData[3+1]
				lblgubnStr.caption = szGubun

			end
			
			
			 -- 주문확인창 오픈여부
			if g_szOdrPop == "1" then
				Open_ConfirmPopup("")
			else
				Request_Order()
			end
		end
		
	end
	
end

 --============================================================================
 -- 주문가능수량 조회
 --============================================================================
function Request_Able()
	
	g_szWarnFlag = "N"							
	
	if g_szCd ~= "" then
		DATAMANAGER.ClearInputData(0, "obtro_oder_264r")
		DATAMANAGER.SetDataValue(0, "obtro_oder_264r", "InBlock1", "IQRY_CLS_CODE" 		, 0 , "2")
		DATAMANAGER.SetDataValue(0, "obtro_oder_264r", "InBlock1", "ACNO" 				, 0 , Form.GetTopCtlProp("acnt", "total"))
		DATAMANAGER.SetDataValue(0, "obtro_oder_264r", "InBlock1", "ASNO" 				, 0 , Form.GetTopCtlProp("acnt", "sequence"))
		
		sCodeData = gf_Split(g_szCd, "@")
		DATAMANAGER.SetDataValue(0, "obtro_oder_264r", "InBlock1", "OVRS_STCK_SYMB_ISCD" 	, 0 , sCodeData[1+1])
		
		DATAMANAGER.SetDataValue(0, "obtro_oder_264r", "InBlock1", "OVRS_EXCH_VNDR_IDNO" 	, 0 , g_szMk)
		DATAMANAGER.SetDataValue(0, "obtro_oder_264r", "InBlock1", "SELN_BYOV_CLCD" 		, 0 , "2")
		DATAMANAGER.SetDataValue(0, "obtro_oder_264r", "InBlock1", "ODER_CRNC_PRC" 		, 0 , edtPrc.caption)
		
		if gTotalYN == true then
			DATAMANAGER.SetDataValue(0, "obtro_oder_264r", "InBlock1", "IF_INTG_MARG_IQRY_YN"	, 0 , "Y")
		else
			DATAMANAGER.SetDataValue(0, "obtro_oder_264r", "InBlock1", "IF_INTG_MARG_IQRY_YN"	, 0 , "N")
		end
		
		 --20241128 LES START
		DATAMANAGER.SetDataValue(0, "obtro_oder_264r", "InBlock1", "ODER_CLS_CODE" , 0 , Check_OrdType())
		
		DATAMANAGER.RequestTranData("obtro_oder_264r")
	end
	
end

 --============================================================================
 -- 단가버튼 클릭
 --============================================================================
function btnPrc_OnClick()
	
	szData = GetLinkData(0)
	
	 --20241014 LES START - 애니메이션 제거
	 --Form.OpenPopupAnimation("mhtro16100_p1", szData, "", "2")
	Form.OpenPopup("mhtro16100_p1", szData, "")
	
end

 --============================================================================
 -- 수량버튼 클릭
 --============================================================================
function btnQty_OnClick()
	
	szData = GetLinkData(1)
	
	 --20241014 LES START - 애니메이션 제거
	 --Form.OpenPopupAnimation("mhtro16100_p1", szData, "", "2")
