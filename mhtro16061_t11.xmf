 --============================================================================
 -- Calc_Price : +, - 버튼클릭시 호가단위로 가격계산
 --============================================================================
function Calc_Price(nGbn)

	szPrc  = ReSet_Prc(edtPrc.caption, nGbn)
	szHigh = g_szUpLimit
	szLow  = g_szDnLimit

	g_szUnit = GetHogaUnit(g_szMk, szPrc, nGbn)  --20180710 HAMWG : 호가단위 설정함수 변경
	szUnit = g_szUnit
	
	if gf_Trim(szPrc) == "" or gf_Tonumber(szPrc) == 0 then
		if g_szCurPrice == "" or gf_Tonumber(g_szCurPrice) == 0 then
			szPrc = 0
		else
			szPrc = g_szCurPrice
		end
	else
		
		 --------------------------------------------------
		 -- + 버튼 클릭
		 --------------------------------------------------
		if nGbn == 0 then
			if gf_Tonumber(szPrc) >= gf_Tonumber(szHigh) then -- 상한가와 같거나 높은가격에서 +버튼 클릭시 상한가로 복귀
				if szHigh ~= "0" then
					szPrc = gf_Tonumber(szHigh)
				else
					szPrc = gf_Tonumber(szPrc) + gf_Tonumber(szUnit)
				end
			elseif gf_Tonumber(szPrc) < gf_Tonumber(szLow) then -- 하한가보다 낮은가격에서 +버튼 클릭시 하한가로 복귀
				if szLow ~= "0" then
					szPrc = gf_Tonumber(szLow)
				else
					szPrc = gf_Tonumber(szPrc) + gf_Tonumber(szUnit)
				end
			else
				szPrc = gf_Tonumber(szPrc) + gf_Tonumber(szUnit)
			end
		
		 --------------------------------------------------
		 -- - 버튼 클릭 
		 --------------------------------------------------
		elseif nGbn == 1 then
			if gf_Tonumber(szPrc) > gf_Tonumber(szHigh) then -- 상한가보다 높은가격에서 -버튼 클릭시 상한가로 복귀
				if szHigh ~= "0" then
					szPrc = gf_Tonumber(szHigh)
				else
					szPrc = gf_Tonumber(szPrc) - gf_Tonumber(szUnit)
				end
			elseif gf_Tonumber(szPrc) <= gf_Tonumber(szLow) then -- 하한가와 같거나 낮은가격에서 -버튼 클릭시 하한가로 복귀
				if szLow ~= "0" then
					szPrc = gf_Tonumber(szLow)
				else
					szPrc = gf_Tonumber(szPrc) - gf_Tonumber(szUnit)
				end
			else
				szPrc = gf_Tonumber(szPrc) - gf_Tonumber(szUnit)
			end
		end
	end
	
	if gf_Tonumber(szPrc) < 0 then
		szPrc = 0
	end
	
	edtPrc.caption = szPrc
	Calc_OrderPrice()
	
end

 --============================================================================
 -- 가격 호가단위 맞추기 
 --============================================================================
function ReSet_Prc(szData, nGbn)
	if nGbn == 0 then
		nResult = gf_Round(gf_Tonumber(szData) % gf_Tonumber(g_szUnit), gf_Tonumber(g_szDecimal))

		if nResult ~= 0 and nResult ~= gf_Tonumber(g_szUnit) then
			return gf_Tonumber(szData) - nResult
		else
			return szData
		end
	else
		nResult = gf_Round(gf_Tonumber(szData) % gf_Tonumber(g_szUnit), gf_Tonumber(g_szDecimal))
	
		if nResult ~= 0 then
			return gf_Tonumber(szData) + (gf_Tonumber(g_szUnit) - nResult)
		else
			return szData
		end
	end
end

 --============================================================================
 -- btnPPlus_OnClick : 가격 + 버튼
 --============================================================================
function btnPPlus_OnClick()
	
	Calc_Price(0)
	
	gNoSettingQty = true
	Request_Able()
	
end

 --============================================================================
 -- btnPMinus_OnClick : 가격 - 버튼
 --============================================================================
function btnPMinus_OnClick()
	
	Calc_Price(1)
	
	gNoSettingQty = true
	Request_Able()
	
end

 --============================================================================
 -- Calc_Qty : +, - 버튼클릭시 수량 length로 수량단위 계산
 --============================================================================
function Calc_Qty(nGbn,nUnit)
	
	szQty = edtQty.caption
	
	 -----------------------------------------------------------
	 -- (기존요건) 최대입력 가능 수량 99000000
	 -----------------------------------------------------------
 --	if Trim(szQty) <> "" then
 --		if CDbl(szQty) >= 99000000 then
 --			if nGbn == 0 then
 --				Exit Function
 --			end if
 --		end if
 --	end if
	
	 -----------------------------------------------------------
	 -- 수량이 빈값인 경우 매매단위로 초기화
	 -----------------------------------------------------------
	if gf_Trim(szQty) == "" then
		if nGbn == 0 then
			szQty = gf_Tonumber(nUnit)
		else
			return
		end
	
	 -----------------------------------------------------------
	 -- 수량이 빈값이 아닌 경우
	 -----------------------------------------------------------
	else
			
		 -----------------------------------------------------------
		 -- [+]버튼 클릭
		 -----------------------------------------------------------
		if nGbn == 0 then
			szQty = gf_Tonumber(szQty) + gf_Tonumber(nUnit)
			nResult = gf_Tonumber(szQty) % gf_Tonumber(nUnit)
			
			if nResult ~= 0 then
				szQty = gf_Tonumber(szQty) - nResult
			end
			
		 -----------------------------------------------------------
		 -- [-]버튼 클릭
		 -----------------------------------------------------------
		elseif nGbn == 1 then
			
			if gf_Tonumber(szQty) == 0 then
				return
			else
				szQty = szQty - gf_Tonumber(nUnit)
				nResult = gf_Tonumber(szQty) % gf_Tonumber(nUnit)
				
				 --20240726
				if gf_Tonumber(szQty) < 0 then
					szQty = 0
				end
				
			end
			
		end
		
	end
	
	 -----------------------------------------------------------
	 -- 입력값 자리수 체크
	 -----------------------------------------------------------
	if string.len(szQty) <= gMaxLen then
		if gf_Tostring(szQty) == "0" or gf_Tostring(szQty) == "" then
			edtQty.caption = ""
		else
			edtQty.caption = szQty
		end
	end
	
	Calc_OrderPrice()
	
	
end

 --============================================================================
function btnQPlus_OnClick()
	Calc_Qty(0,g_szOrdSize)
end

 --============================================================================
function btnQMinus_OnClick()
	Calc_Qty(1,g_szOrdSize)
end

 --============================================================================
 -- 주문금액 가계산
 --============================================================================
function Calc_OrderPrice()
	
	nPrc = gf_Tonumber(edtPrc.caption)
	nQty = gf_Tonumber(edtQty.caption)
	
	if nPrc ~= "" and nPrc > 0 and nQty ~= "" and nQty > 0 then
		
		nOrderPrice = nPrc * nQty
		
		if g_szDecimal ~= "" then
			lblOrderPrice.caption = gf_CommaValue(nOrderPrice,g_szDecimal).." " .. g_szCurrency
		else
			lblOrderPrice.caption = gf_CommaValue(nOrderPrice,0).." " .. g_szCurrency
		end
		
		nExChangeRate = gf_Tonumber(LabelExchangeRate.caption)
		
		if nExChangeRate ~= "" and nExChangeRate > 0 then
			nOrderPriceWon = nOrderPrice * nExChangeRate
			nOrderPriceWon = gf_Tonumber(nOrderPriceWon)
			lblOrderPriceWon.caption = gf_CommaValue(nOrderPriceWon,0).."원"
		else
			lblOrderPriceWon.caption = "- " .. "원"
		end
	
	else
	
		lblOrderPrice.caption = "- " .. g_szCurrency
		lblOrderPriceWon.caption = "- " .. "원"
		
	end
	
end

 --============================================================================
 -- (공통) 주문 환경설정값 적용
 --============================================================================
function Load_OrderSet()
	
	g_szOdrPop     = Form.LoadConfigData("SET_ORDER", "OPEN_CONFIRM")			 -- 주문확인창
	g_szAfterInit  = Form.LoadConfigData("SET_ORDER", "AFERTORD_INIT")			 -- 주문전송 후 초기화
	g_szChangeInit = Form.LoadConfigData("SET_ORDER", "CHANGE_INIT")			 -- 종목/탭 변경시 초기화
	g_szAfterOrg   = Form.LoadConfigData("SET_ORDER", "AUTO_ORGNO")				 -- 원주문번호 자동입력
	
	g_szBuyQty     = Form.LoadConfigData("SET_ORDER", "AUTO_STOCK_BUYQTY")		 -- 매수수량 자동입력(0:미사용, 1:현금가능수량, 2:최대가능수량(미수포함), 3:수량입력
	g_szBuyQtyCnt  = Form.LoadConfigData("SET_ORDER", "AUTO_STOCK_BUYQTYCNT")	 -- 매수수량 주수(수량입력 선택시)
	
	 ----------------------------------------------
	 -- 주문확인창(기본값 : 사용)
	 ----------------------------------------------
	if gf_Trim(g_szOdrPop) == "" then
		g_szOdrPop = "1"
	end
	
	 ----------------------------------------------
	 -- 주문전송 후 초기화(기본값 : 사용)
	 ----------------------------------------------
	if gf_Trim(g_szAfterInit) == "" then
		g_szAfterInit = "1"
	end
	
	 ----------------------------------------------
	 --종목/탭 변경시 초기화 사용을 초기값으로 설정
	 --종목/탭 변경시 초기화(기본값 : 사용)
	 ----------------------------------------------
	if gf_Trim(g_szChangeInit) == "" then
		g_szChangeInit = "1"
	end

	 ----------------------------------------------
	 -- 원주문번호 자동입력(기본값 : 사용)
	 ----------------------------------------------
	if gf_Trim(g_szAfterOrg) == "" then
		g_szAfterOrg = "1"
	end
	
	 ----------------------------------------------
	 -- 매수수량 자동입력(기본값 : 사용하지 않음)
	 ----------------------------------------------
	if gf_Trim(g_szBuyQty) == "" then
		g_szBuyQty = "0"		
	end
	
end

 --============================================================================
 -- 시장에 따른 주문유형
 --============================================================================
function SetOrderTypeList(sNation)
	cmbType.clear = true
	
	if gOsType == "1" or gOsType == "2" then
		if sNation == "USA" then
			if gOsType == "2" then
				cmbType.SetPopupHeight(420)  --20241128 LES START
			else
				cmbType.SetPopupHeight(350)  --20241128 LES START
			end
			
			 --20241128 LES START
			 --20220524 (예약주문에서 LOO 삭제 요청)
			cmbType.cbinputdatatext =  "00`보통(지정가)`원하는 가격을 지정하여 주문\r\n" ..
			"01`시장가`시장가격으로 즉시 체결되는 주문\r\n" ..
			"32`LOC(장마감지정가)`장 마감과 동시에 종가가 지정한 가격보다 같거나 유리하면 체결시키는 주문\r\n" .. 
			"35`Limit VWAP(가격제한수량분할)`과거 거래량을 분석하여 현지 브로커 자체 기준으로 가격을 제한한 장중 분할 체결하는 알고리즘 주문\r\n" ..
			"36`Limit TWAP(가격제한시간분할)`과거 거래시간을 분석하여 현지 브로커 자체 기준으로 장중 시간별로 분할 체결하는 알고리즘 주문으로 지정한 가격과 동일하거나 유리하면 체결하는 주문\r\n"
	
		else
			cmbType.SetPopupHeight(0)
			
			cmbType.cbinputdatatext =  "00`보통(지정가)`원하는 가격을 지정하여 주문\r\n"
		end
		
	else
		if sNation == "USA" then
			 --20220524 (예약주문에서 LOO 삭제 요청)
			cmbType.cbinputdatatext =  "00`보통(지정가)\r\n" .. 
			"32`LOC(장마감지정가)\r\n" .. 
			"35`Limit VWAP(가격제한수량분할)\r\n" ..
			"36`Limit TWAP(가격제한시간분할)\r\n"
	
		else
			cmbType.cbinputdatatext =  "00`보통(지정가)\r\n"
		end
	end
	
	 --20241128 LES START
	 --종목이 변경될 경우 주문유형 콤보 초기화를 위해 자동으로 인덱스 0으로 변경
	gCmbTypeChangeAuto = true
	
	cmbType.currentindex = "0"	
	
end

 --============================================================================
 -- 통합증거금 약정여부 조회 서비스 호출
 --============================================================================
function RequestCombinedMargin()
	
	g_TotalReqComplete = false
	
	DATAMANAGER.SetDataValue(0, "obpds_srvc_323r", "InBlock1", "PROS_CLS_CODE" 	, 0 , "1")
	DATAMANAGER.SetDataValue(0, "obpds_srvc_323r", "InBlock1", "CSNO" 			, 0 , " ")
	DATAMANAGER.SetDataValue(0, "obpds_srvc_323r", "InBlock1", "SVCD" 			, 0 , "081")
		
	DATAMANAGER.SetDataValue(0, "obpds_srvc_323r", "InBlock1", "ACNO" 			, 0 , Form.GetTopCtlProp("acnt", "total"))
	DATAMANAGER.SetDataValue(0, "obpds_srvc_323r", "InBlock1", "ASNO" 			, 0 , Form.GetTopCtlProp("acnt", "sequence"))
	DATAMANAGER.SetDataValue(0, "obpds_srvc_323r", "InBlock1", "RMND_SRNO" 		, 0 , " ")
	
	DATAMANAGER.RequestTranData("obpds_srvc_323r")
	

end

 --============================================================================
 -- 고시환율 조회 서비스 호출
 --============================================================================
function RequestExChangeRate()

	szDate = Form.GetSharedData("..HOST_DATE", false)
	DATAMANAGER.SetDataValue( 0, "obtro_comn_025r", "InBlock1", "STND_DATE" 	, 0 , szDate )
	DATAMANAGER.SetDataValue( 0, "obtro_comn_025r", "InBlock1", "CRCD"		, 0 , g_szCurrency )
	
	DATAMANAGER.RequestTranData("obtro_comn_025r")

end

 --============================================================================
function DATAMANAGER_OnSendTranBefore(szTranID)

	if szTranID == "obtro_oder_112a" then
		
		g_szTR = szTranID
		szPrc = edtPrc.caption
		
		sCodeData = gf_Split(g_szCd, "@")
		DATAMANAGER.ClearInputData(0, "obtro_oder_112a")

		DATAMANAGER.SetDataValue(0, "obtro_oder_112a", "InBlock1", "ACNO"				, 0, Form.GetTopCtlProp("acnt", "total"))		 -- 계좌번호(8)
		DATAMANAGER.SetDataValue(0, "obtro_oder_112a", "InBlock1", "ASNO"				, 0, Form.GetTopCtlProp("acnt", "sequence"))		 -- 계좌일련번호(2)
		DATAMANAGER.SetDataValue(0, "obtro_oder_112a", "InBlock1", "ACNT_PWD"			, 0, Form.GetTopCtlProp("edtPwd", "caption"))		 -- 계좌 비밀번호
		
		DATAMANAGER.SetDataValue(0, "obtro_oder_112a", "InBlock1", "OVRS_STCK_SYMB_ISCD"	, 0, sCodeData[1+1])							 -- 종목코드
		DATAMANAGER.SetDataValue(0, "obtro_oder_112a", "InBlock1", "OVRS_EXCH_VNDR_IDNO"	, 0, g_szMk)									 -- 거래소코드	
		DATAMANAGER.SetDataValue(0, "obtro_oder_112a", "InBlock1", "SELN_BYOV_CLCD"		, 0, "2")									 -- 매도/매수구분코드
		DATAMANAGER.SetDataValue(0, "obtro_oder_112a", "InBlock1", "RSEV_ASPR_TPCD"		, 0, Check_OrdCond())								 -- 주문조건구분코드
		DATAMANAGER.SetDataValue(0, "obtro_oder_112a", "InBlock1", "ODQT"				, 0, edtQty.caption)							 -- 주문수량
		
		DATAMANAGER.SetDataValue(0, "obtro_oder_112a", "InBlock1", "OVRS_STCK_ODER_PRC"	, 0, szPrc)									 -- 주문단가
		DATAMANAGER.SetDataValue(0, "obtro_oder_112a", "InBlock1", "WARN_CNFR_YN"		, 0, g_szWarnFlag)
		DATAMANAGER.SetDataValue(0, "obtro_oder_112a", "InBlock1", "ODER_GRP_NO"			, 0, "0")	
	
		if Label0.caption == "일반예약" then
			DATAMANAGER.SetDataValue(0,"obtro_oder_112a", "InBlock1", "ODER_RSEV_CLS_CODE" , 0, "1")								 --예약구분 1: 일반예약 2: 기간잔량 3: 기간예약 4: 특정일주문
			DATAMANAGER.SetDataValue(0, "obtro_oder_112a", "InBlock1", "ODER_RSEV_HOUR_CLCD", 0, lblgubn.caption)
			DATAMANAGER.SetDataValue(0, "obtro_oder_112a", "InBlock1", "ODER_STA_DATE", 0, Form.GetSharedData("..HOST_DATE", false))
			DATAMANAGER.SetDataValue(0, "obtro_oder_112a", "InBlock1", "ODER_FIN_DATE", 0, Form.GetSharedData("..HOST_DATE", false))
		elseif Label0.caption == "기간잔량" then
			DATAMANAGER.SetDataValue(0, "obtro_oder_112a", "InBlock1", "ODER_RSEV_CLS_CODE", 0, "2")
			DATAMANAGER.SetDataValue(0, "obtro_oder_112a", "InBlock1", "ODER_RSEV_HOUR_CLCD", 0, lblgubn.caption)
			DATAMANAGER.SetDataValue(0, "obtro_oder_112a", "InBlock1", "ODER_STA_DATE", 0, lblstart.caption)
			DATAMANAGER.SetDataValue(0, "obtro_oder_112a", "InBlock1", "ODER_FIN_DATE", 0, lblend.caption)
		elseif Label0.caption == "기간예약" then
			DATAMANAGER.SetDataValue(0, "obtro_oder_112a", "InBlock1", "ODER_RSEV_CLS_CODE", 0, "3")
			DATAMANAGER.SetDataValue(0, "obtro_oder_112a", "InBlock1", "ODER_RSEV_HOUR_CLCD", 0, lblgubn.caption)
			DATAMANAGER.SetDataValue(0, "obtro_oder_112a", "InBlock1", "ODER_STA_DATE", 0, lblstart.caption)
			DATAMANAGER.SetDataValue(0, "obtro_oder_112a", "InBlock1", "ODER_FIN_DATE", 0, lblend.caption)
		elseif Label0.caption == "특정일주문" then
			DATAMANAGER.SetDataValue(0, "obtro_oder_112a", "InBlock1", "ODER_RSEV_CLS_CODE", 0, "4")
			DATAMANAGER.SetDataValue(0, "obtro_oder_112a", "InBlock1", "ODER_RSEV_HOUR_CLCD", 0, lblgubn.caption)
			DATAMANAGER.SetDataValue(0, "obtro_oder_112a", "InBlock1", "ODER_STA_DATE", 0, lblstart.caption)
			DATAMANAGER.SetDataValue(0, "obtro_oder_112a", "InBlock1", "ODER_FIN_DATE", 0, lblstart.caption)
		end
	end
	
end
 --============================================================================
function DATAMANAGER_OnReceiveTranComplete(szTranID)
	
	 --==========================================================================
	 --해외주식 매수주문 
	 --==========================================================================
	if szTranID == "obtro_oder_112a" then
	
		szWarnCd  = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "WARN_CLS_CODE", 0)	 --경고구분코드 (0.정상, 1.경고, 2.보류)
		szWarnMsg = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "UI_MSG_CNTT"  , 0)
	
		 ----------------------------------
		 -- 경고
		 ----------------------------------
		if szWarnCd == "1" then
		
			Open_ConfirmPopup(szWarnMsg)
		
		 ----------------------------------
		 -- 보류(해외주식 제외)
		 ----------------------------------
		elseif szWarnCd == "2" then --
			
			g_szTR = ""
		
		 ----------------------------------
		 -- 해외주식 미국PTP 종목과세관련
		 ----------------------------------
		elseif szWarnCd == "3" then
			
			szData = "0" .. "|" .. szWarnMsg	 -- 매매구분|메시지
			 --Form.OpenPopup("mhtro16100_p15", szData , "")	'OnPopupReturn -> "PTP주문경고"
			Form.OpenPopupAnimation("mhtro16100_p15", szData, "", "2")
			
		 ----------------------------------
		 -- 정상주문 처리
		 ----------------------------------
		else
		
			g_szTR = ""
				
			szOrdCd  = DATAMANAGER.GetDataMsgCode(szTranID)
			szOrdMsg = DATAMANAGER.GetDataMsgText(szTranID)
	
			 -------------------------------
			 -- 정상주문
			 -------------------------------
			if gf_Trim(szOrdCd) == "0001" or gf_Trim(szOrdCd) == "5620" then
				
				 -------------------------------
				 -- 주문가능수량을 재조회한다.
				 -------------------------------
				gNoSettingQty = true
				Request_Able()
				
				 -------------------------------
				 -- 주문후 초기화
				 -------------------------------
				if g_szAfterInit == "1" then
					Reset_AfterOrd()
				end
				
				 -------------------------------
				 -- 주문번호 연동
				 -------------------------------
				if g_szAfterOrg == "1" then
					szOrgNo = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "ODER_NO", 0)
					Form.TriggerEvent("#", "AfterOrd", szOrgNo)
				end
				
				 -------------------------------
				 -- 주문처리 메시지 출력
				 -------------------------------
				Form.Toast(0, szOrdMsg, true)
				
					
			end
			
		end
	
	
	 --==========================================================================
	 --통합증거금 약정조회
	 --==========================================================================
	elseif szTranID == "obpds_srvc_323r" then
	
		 --------------------------------------------------------------------------------------
		 --SVCD 값이 0이면, 통합증거금 미약정 계좌
		 --------------------------------------------------------------------------------------
		gTotalReqFirst = false
		g_TotalReqComplete = true
		
		szCnt = DATAMANAGER.GetDataValue(0, "obpds_srvc_323r" , "OutBlock1" , "SVC_SRNO" , 0)
		
		if gf_Tonumber(szCnt) ~= 0 then
			gTotalYN = true
		else
			
			gTotalYN = false
			
		end
		
		 --------------------------------------------------------------------------------------
		 -- ★ [화면 최초 진입 시] (g_TotalReqComplete == false 상태)
		 --------------------------------------------------------------------------------------
		 -- 통합증거금 약정여부 조회 후 주문 가능수량 조회
		 -- 수량자동입력 설정(g_szBuyQty)이 현금가능수량(1) or 최대가능수량(2) 되어있는 경우
		 -- 수량조회 완료 후 세팅 해준다. 기존처럼 [RequestAutoQty]에서 해주면 통합증거금 약정여부
		 -- 조회전에 조회한 값으로 세팅됨.
		 --------------------------------------------------------------------------------------
		Request_Able()
		
	 --==========================================================================
	 --통화별 환율조회
	 --==========================================================================
	elseif szTranID == "obtro_comn_025r" then
	
		szAnncExrt = DATAMANAGER.GetDataValue( 0, "obtro_comn_025r", "OutBlock1", "ANNC_EXRT" , 0 )	 -- 고시환율
		
		 --엔화일때만 환율 4자리 표기 그외에는 2자리 표기
		if g_szCurrency == "JPY" then
			LabelExchangeRateMaskData = "0,1,환율 ," .."".. ",0,,4,1,1,0,0"
		else
			LabelExchangeRateMaskData = "0,1,환율 ," .."".. ",0,,2,1,1,0,0"	
		end
		
		LabelExchangeRate.mask = LabelExchangeRateMaskData
		LabelExchangeRate.caption = szAnncExrt
		
		 --수량/가격 자동입력 설정 시
		 --환율조회가 되기 전, 주문금액 가계산이 진행된 경우 
		 --원화금액이 빈값으로 나올 수 있어 환율 조회 이후에 다시 한번 주문금액 계산
		Calc_OrderPrice()
		
		
	 --==========================================================================
	 --주문가능수량 조회 Complete
	 --==========================================================================
	elseif szTranID == "obtro_oder_264r" then
	
		sOrdAbleQty 		= DATAMANAGER.GetDataValue(0, "obtro_oder_264r", "OutBlock1", "ODER_ABLE_QTY"			 , 0)
		sOrdAbleTotalQty 	= DATAMANAGER.GetDataValue(0, "obtro_oder_264r", "OutBlock1", "INTG_MARG_ODER_ABLE_QTY" , 0)
		
		 -----------------------------------------------------------
		 -- 마스킹처리 & 주문가능수량 세팅
		 -- 통합증거금 약정 시 해당통화 라벨만 앞에 통화기호 넣어줘야되서 스크립트로 마스킹 처리
		 -----------------------------------------------------------
		LabelMaskData = "0,0,"..g_szCurrency.."가능 ".. "," .. "주".. ",0,,0,1,1,2,0"
		LabelCurrencyAbleQty.mask = LabelMaskData
		
		if gf_Trim(edtPrc.caption) == "" or gf_Trim(edtPrc.caption) == "0" then
			
			 --20241128 LES START
			 --매수 시장가일 경우 가격이 비어도 수량표시
			if Check_OrdType() == "05" then
				LabelCashAbleQty.caption = sOrdAbleQty
				LabelCurrencyAbleQty.caption = sOrdAbleQty
				LabelTotalAbleQty.caption = sOrdAbleTotalQty
			else
				LabelCashAbleQty.caption = "  "
				LabelCurrencyAbleQty.caption = "  "
				LabelTotalAbleQty.caption = "  "
			end
			 --20241128 LES END
			
		else
			LabelCashAbleQty.caption = sOrdAbleQty
			LabelCurrencyAbleQty.caption = sOrdAbleQty
			LabelTotalAbleQty.caption = sOrdAbleTotalQty
		end
		
		 -----------------------------------------------------------
		 -- 주문가능수량 세팅 후 라벨 보임처리
		 -----------------------------------------------------------
		if gTotalYN == true then
			SetAbleLabel("TOTAL")
		else
			SetAbleLabel("NORMAL")
		end
		
		 ------------------------------------------------------------------------------------------
		 -- 수량 자동입력 설정이 (g_szBuyQty 1:현금가능수량, 2:최대가능수량)으로 설정되어있는 경우
		 -- 주문가능수량 조회 후 수량입력창에 자동 세팅
		 ------------------------------------------------------------------------------------------
		 -- 통합증거금 약정되어있는 고객일 경우 
		 -- 1:현금가능수량 => [해당통화가능수량] 2:최대가능수량 => [통합가능수량] 세팅
		 ------------------------------------------------------------------------------------------
		if g_szChangeInit ~= "1" then
			
			 ---------------------------------------------------------------
			 --[InputKeyPad]에서 가격/수량 리턴 후 조회한 경우
			 --[+],[-]로 가격을 변경한 경우
			 --[가능수량 조회팝업]에서 수량을 선택한 경우
			 --리턴받은 수량을 세팅해주기 위해 조회된 가능수량을 세팅안해줌.
			 --주문금액만 재조회
			 ---------------------------------------------------------------
			if gNoSettingQty == true then
			
				gNoSettingQty = false
				Calc_OrderPrice()
		
			else
				if g_szBuyQty == "1" or g_szBuyQty == "2" then
					
					if gTotalYN == true then
						
						if g_szBuyQty == "1" then
							edtQty.caption = sOrdAbleQty
						elseif g_szBuyQty == "2" then
							edtQty.caption = sOrdAbleTotalQty
						end
						
					else
						edtQty.caption = sOrdAbleQty
					end
					
					Calc_OrderPrice()
					
				end
			end
			
			
		end
		
	end
	
	 --해외주식 주문착오 방지
	g_szWarnFlag = "N"	
	
end

 --============================================================================
 -- 서비스 오류처리
 --============================================================================
function DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	
	local szSubMsg
	szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	
	 --------------------------------------------------------------------
	 -- 주문가능수량 조회/고시환율 조회 에러메시지는 스킵처리
	 --------------------------------------------------------------------
	if szTranID == "obtro_oder_264r" then
		
		LabelMaskData = "0,0,"..g_szCurrency.."가능 ".. "," .. "주".. ",0,,0,1,1,2,0"
		LabelCurrencyAbleQty.mask = LabelMaskData
		
		LabelCashAbleQty.caption = "  "
		LabelCurrencyAbleQty.caption = "  "
		LabelTotalAbleQty.caption = "  "
	
		return
		
	elseif szTranID == "obtro_comn_025r" then
	end
	
 --	'---------------------------------------------------------------------
 --	' 주문가능금액 부족(obtro_oder101a) 에러메시지 발생 시, 환전화면 연동 -> 예약주문은 주문서비스에서 체크X
 --	'---------------------------------------------------------------------
 --	if szTranID == "obtro_oder_101a" and szErrCode == "5988" then
 --		
 --		if Trim(szSubMsg) <> "" then
 --			Form.MsgBox("안내", szErrMsg & "(" & szSubMsg & ")", "ORDER_ABLE_MONEY", 7, "환전하러가기","확인")
 --		else
 --			Form.MsgBox("안내", szErrMsg, "ORDER_ABLE_MONEY", 7, "환전하러가기","확인")
 --		end if
 --		
 --		Exit Sub
 --	end if
	
	 -----------------------------------------------------------------------
	 -- 해외주식 미약정 계좌상태에서 주문냈을때 에러메시지, 거래신청화면 연동
	 -----------------------------------------------------------------------
	if szTranID == "obtro_oder_112a" and szErrCode == "6205" then
		
		Form.MsgBox("안내", "해외주식 거래신청 미등록 계좌는 약정 신청 후 거래가 가능합니다. 해당 화면으로 이동하시겠습니까?" , "REG", 7, "거래신청하기" , "취소")
		return
	
	end
	
	 --------------------------------------------------------------------
	 -- 해외ETP 미약정 고객
	 --------------------------------------------------------------------
	if szErrCode == "6207" then
		
		Form.MsgBox("안내", "해외ETP 거래 미신청 계좌 입니다.\n해당 화면으로 이동하시겠습니까?", "ETP_MSG", 7, "거래신청하기","취소")
		
	 --------------------------------------------------------------------
	 -- 그외
	 --------------------------------------------------------------------
	else
		if gf_Trim(szSubMsg) ~= "" then
			Form.ShowAlert(g_szTitle, szErrMsg .. "\n(" .. szSubMsg .. ")")
		else
			Form.ShowAlert(g_szTitle, szErrMsg)
		end
	end
	
end

