 --============================================================================
 -- 20241128 LES START : 해외주식 매수 시장가 주문유형 추가
 --============================================================================
local g_szOdrPop
local g_szAfterInit
local g_szChangeInit
local g_szBuyQty, g_szBuyQtyCnt
local g_szAfterOrg

local g_szCd, g_szMk, g_szNg -- 종목코드, 거래소코드, 국가코드
g_szCd = ""
g_szMk = ""
g_szNg = ""

local g_szWarnFlag -- 주문 경고 확인플래그
g_szWarnFlag	= "N"

local g_szTR
g_szTR = ""

local g_szTitle
g_szTitle = "알림"

local g_szOrdSize -- 매매단위
g_szOrdSize = ""

local g_szCurPrice -- 현재가
g_szCurPrice = ""

local g_szUpLimit -- 상한가
g_szUpLimit =  ""

local g_szDnLimit -- 하한가
g_szDnLimit =  ""

local g_szUnit -- 호가단위
g_szUnit =  ""

local g_szDecimal -- 종목가격 자릿수
g_szDecimal =  ""

local g_szKorName -- 한글종목명
g_szKorName =  ""

local g_szTickType -- 종목틱타입
g_szTickType =  ""

local g_szCurrency -- 통화
g_szCurrency = ""

local gTotalReqFirst -- 통합증거금 약정여부 최초조회 여부
gTotalReqFirst = true

local gTotalYN -- 통합증거금 약정여부
gTotalYN = false

local g_TotalReqComplete -- 통합증거금 조회완료 여부
g_TotalReqComplete = false

local gNoSettingQty
gNoSettingQty = false

local gSettingSelectPrice -- 현재가 화면에서 연동된 가격이 있는지 여부
gSettingSelectPrice = false

local gOsType
local gMaxLen
gMaxLen = 12

 --20241128 LES START - 주문유형 콤보박스 수동/자동 변경 여부
local gCmbTypeChangeAuto
gCmbTypeChangeAuto = false

local gConfirmPrice --20250102 HSZ: 주문확인창 전송가격

 --============================================================================
function Form_OnFormInitBefore()
	
	 ----------------------------------------------------
	 -- 매체구분
	 ----------------------------------------------------
	gOsType = Form.GetSharedData("..OS_TYPE", false)
	
	 ----------------------------------------------------
	 --이미지 찌그러짐 방지 API
	 ----------------------------------------------------
	imgInfo.SetMaintainingRatio("1")
	
	 ----------------------------------------------------
	 --컨트롤 패딩값 조절
	 ----------------------------------------------------
	lblOrderPrice.paddinginfo = "0,0,0,0"
	lblOrderPriceWon.paddinginfo = "0,0,0,0"
	
	LabelCashAbleQty.paddinginfo = "0,0,0,0"
	LabelCurrencyAbleQty.paddinginfo = "0,0,0,0"
	LabelTotalAbleQty.paddinginfo = "0,0,0,0"
	
end

 --============================================================================
function Form_OnFormInit()
	
	 ----------------------------------------------------
	 --주문환경설정 값 Load
	 ----------------------------------------------------
	Load_OrderSet()
	
end

 --============================================================================
function Form_OnTriggerEvent(sEventName, sParam)
	
	 --============================================================================
	 -- 종목정보 연동
	 --============================================================================
	if sEventName == "SEND_ITEM_INFO" then
	
		 -------------------------------------------------------------------------
		 --현재가★상한가★하한가★매매단위★통화★소수점자리수★한글종목명★틱타입
		 -------------------------------------------------------------------------
		arrItemInfo = gf_Split(sParam, "★")
		
		g_szCurPrice 	= arrItemInfo[0+1]
		g_szUpLimit	= arrItemInfo[1+1]
		g_szDnLimit	= arrItemInfo[2+1]
		g_szOrdSize 	= arrItemInfo[3+1]
		g_szCurrency	= arrItemInfo[4+1]
		g_szDecimal	= arrItemInfo[5+1]
		g_szKorName	= arrItemInfo[6+1]
		g_szTickType	= arrItemInfo[7+1]
		g_szUnit		= GetHogaUnit(g_szMk, g_szCurPrice, 0)
	
		 -------------------------------------------------------------------------
		 --가격입력창 소수점 자리수 세팅 / 통화기호 세팅
		 -------------------------------------------------------------------------
		if g_szCurrency ~= "" then
			sMask = "0,0,,".. " " .. g_szCurrency .. ",0,,"..g_szDecimal..",1,1,2,0"
		else
			sMask = "0,0,,,0,,"..g_szDecimal..",1,1,2,0"
		end
		
		edtPrc.mask = sMask
		
		 -------------------------------------------------------------------------
		 --수량입력창 매매단위 세팅
		 -------------------------------------------------------------------------
		if g_szOrdSize ~= "" then
			edtQty.hintcaption = gf_CommaValue(g_szOrdSize,0).."주 단위"
		end
		
		 -------------------------------------------------------------------------
		 --주문금액 가계산 초기세팅
		 -------------------------------------------------------------------------
		if g_szCurrency ~= "" then
			lblOrderPrice.caption = "- ".. g_szCurrency
			lblOrderPriceWon.caption = "- " .. "원"
		else
			lblOrderPrice.caption = "- "
			lblOrderPriceWon.caption = "- " .. "원"
		end
		
		 -------------------------------------------------------------------------
		 --종목/탭 변경시 가격입력창/수량입력창 입력값 초기화 
		 -------------------------------------------------------------------------
		if g_szChangeInit == "1" then
			Init_InputControl()
		end
		
		 -------------------------------------------------------------------------
		 --국가별 주문가능 주문유형 설정
		 -------------------------------------------------------------------------
		SetOrderTypeList(g_szNg)
		
		 -------------------------------------------------------------------------
		 --통화별 환율 조회
		 -------------------------------------------------------------------------
		RequestExChangeRate()
	
	 --============================================================================
	 -- 호가조회 완료(가격/수량 자동입력 요청)
	 --============================================================================
	elseif sEventName == "HOGA_COMPLETE" then
	
		 -----------------------------------------------------------------------------------
		 -- [금액 자동입력]
		 -----------------------------------------------------------------------------------
		 -- 현재가 호가테이블에서 진입 :  현재가 화면에서 선택한 호가 세팅 (위치변경 ChangeAcnt)
		 -- 그 외 진입 : 종목/탭 변경 시 초기화 설정이 꺼져있는 경우 설정한 자동가격으로 세팅
		 -----------------------------------------------------------------------------------
		 --sPrice = Form.GetSharedData("PRICE", true)
		 --
		 --if sPrice <> "" and sPrice <> null	then
		 --	edtPrc.caption = sPrice
		 --	
		 --else
			
			if g_szChangeInit ~= "1" then
				RequestAutoPrice()
			end
		
		 --end if
		
		 -----------------------------------------------------------------------------------
		 -- [수량 자동입력]
		 -----------------------------------------------------------------------------------
		if g_szChangeInit ~= "1" then
			RequestAutoQty()
		end
		
		
	 --============================================================================
	 -- 클릭 호가 연동
	 --============================================================================
	elseif sEventName == "CLICK_HOGA" then
		
		 --20241128 LES START
		 --시장가일 경우 호가연동 무시
		if Check_PrcOrd() ~= "시장가" then
			edtPrc.caption = sParam
			Calc_OrderPrice()
			
			 ----------------------
			 -- 주문가능수량 조회
			 ----------------------
			gNoSettingQty = true
			Request_Able()
			
		end
		
	 --============================================================================
	 -- 종목코드 초기화/종목코드 변경/탭 변경
	 --============================================================================
	elseif sEventName == "InitCode" or sEventName == "ChangeCode" or sEventName == "ChangeTab" then
		
		 ---------------------------------------------------------------------------
		 --종목이 바뀐 경우
		 ---------------------------------------------------------------------------
		if g_szCd ~= sParam then
			
			g_szCd = sParam
			g_szNg = Form.GetItemCodeInfo(g_szCd, "ovsnation")	 -- 국가구분코드
			g_szMk = Form.GetItemCodeInfo(g_szCd, "exchid")		 -- 거래소벤더코드
			
			 --환율정보 라벨 클리어(이전 데이터 남아있어 깜빡임 방지)
			LabelExchangeRate.caption = ""
			
			if sEventName == "ChangeTab" then
				
				 -----------------------------------------------------------------------------------
				 -- [금액 자동입력]
				 -----------------------------------------------------------------------------------
				 -- 현재가 호가테이블에서 진입 :  현재가 화면에서 선택한 호가 세팅(위치변경 ChangeAcnt)
				 -- 그 외 진입 : 종목/탭 변경 시 초기화 설정이 꺼져있는 경우 설정한 자동가격으로 세팅
				 -----------------------------------------------------------------------------------
				 --sPrice = Form.GetSharedData("PRICE", true)
				 --
				 --if sPrice <> "" and sPrice <> null	then
				 --	edtPrc.caption = sPrice
				 --	
				 --else
					
					if g_szChangeInit ~= "1" then
						RequestAutoPrice()
					end
				
 --				end if
			
				 -----------------------------------------------------------------------------------
				 -- [수량 자동입력] "종목/탭 변경 시 초기화" 설정 해제된 상태일때 
				 -- 통합증거금 약정 조회를 한번도 하지 않은 경우 통합증거금 약정 조회 후 > 수량입력
				 -- 톧합증거금 약정을 한번이라도 조회했던 경우는 바로 수량 자동입력
				 -----------------------------------------------------------------------------------
				if gTotalReqFirst == true then
					
					RequestCombinedMargin()
				
				else
					
					if g_szChangeInit ~= "1" then
						RequestAutoQty()
					end
				
				end
				
			end
		
		 ---------------------------------------------------------------------------
		 -- 종목이 안바뀐 경우
		 ---------------------------------------------------------------------------
		else
		
			if sEventName == "ChangeTab" then
				
				 -----------------------------------------------------------------------------------
				 -- [금액 자동입력]
				 -----------------------------------------------------------------------------------
				 -- 현재가 호가테이블에서 진입 :  현재가 화면에서 선택한 호가 세팅(위치변경 ChangeAcnt)
				 -- 그 외 진입 : 종목/탭 변경 시 초기화 설정이 꺼져있는 경우 설정한 자동가격으로 세팅
				 -----------------------------------------------------------------------------------
				 --sPrice = Form.GetSharedData("PRICE", true)
				 --
				 --if sPrice <> "" and sPrice <> null	then
				 --	edtPrc.caption = sPrice
					
				 --else
					
					if g_szChangeInit ~= "1" then
						RequestAutoPrice()
					end
				
				 --end if
			
				 -----------------------------------------------------------------------------------
				 -- [수량 자동입력]
				 -- 통합증거금 약정 조회를 한번도 하지 않은 경우 통합증거금 약정 조회 후 > 수량입력
				 -- 톧합증거금 약정을 한번이라도 조회했던 경우는 바로 수량 자동입력
				 -----------------------------------------------------------------------------------
				if gTotalReqFirst == true then
					
					RequestCombinedMargin()
				
				else
					
					if g_szChangeInit ~= "1" then
						RequestAutoQty()
					end
				
				end
				
			
			end
		
			
			
		end
		
		
	 --============================================================================
	 -- 매수가격 자동입력
	 --============================================================================
	elseif sEventName == "ReturnAutoPrice" then
		
		 ----------------------------------------------------------
		 -- 종목/탭 변경 시 초기화가 꺼져있어도, 
		 -- 주문가격 자동입력이 미사용으로 되어있으면 빈값이 넘어옴.
		 -- 빈값으로 넘어온 경우에는 세팅해주지 않는다
		 ----------------------------------------------------------
		if g_szChangeInit ~= "1" and sParam ~= "" then
			edtPrc.caption = sParam
			Calc_OrderPrice()
		end
		
		 ----------------------------------------------------------
		 -- ★ [가격 자동입력 설정 시] 종목변경 시 수량가능 재조회
		 --    가격이 0이면 조회안함. => 0으로 올리면 어차피 서비스에서 0주로 주니 걍 호출함
		 ----------------------------------------------------------
		if g_TotalReqComplete == true then
			 --if CDbl(sParam) > 0 then
				Request_Able()
			 --end if
		end
		
	 --============================================================================
	 -- 계좌변경(통합증거금 약정여부 조회 및 입력창 초기화)
	 --============================================================================	
	elseif sEventName == "ChangeAcnt" then
	
		RequestCombinedMargin()
		
		if g_szChangeInit == "1" then
			Init_InputControl()
		end
		
		 -------------------------------------------
		 -- 해외주식현재가 화면에서 가격연동 데이터가 있으면 데이터 세팅
		 -------------------------------------------
		sPrice = Form.GetSharedData("PRICE", true)
		
		if sPrice ~= "" and sPrice ~= nil then
			gSettingSelectPrice = true
			edtPrc.caption = sPrice
		end
		
	 --============================================================================
	 -- 주간장 현재가 세팅(가격자동입력 활성화 & 현재가 세팅으로 되어있을때)
	 --============================================================================
	elseif sEventName == "SEND_DAYMARKET_PRC" or sEventName == "SEND_AFTERMARKET_PRC" then
		
		if g_szChangeInit ~= "1" and sParam ~= "" then
			
			g_szCurPrice 	= sParam  --20240627
			szAuto  = Form.LoadConfigData("SET_ORDER", "AUTO_STOCK_BUYPRC")
			
			if szAuto == "11" and gSettingSelectPrice ~= true then
				
				 --20241128 LES START
				 --시장가일 경우 가격자동입력 무시
				if Check_PrcOrd() ~= "시장가" then
					edtPrc.caption = sParam
					Calc_OrderPrice()
				end
				
			end
			
		end
	
	 --============================================================================
	 -- 비밀번호 검증 후 주문확인창 자동 오픈
	 --============================================================================
	elseif sEventName == "OPEN_CONFIRM" then
		btnBuy_OnClick()

	 --============================================================================
	 -- 20240715 종목 미변경 시, 필요한 데이터만 재조회(통합증거금여부/매수가능수량/환율)
	 --============================================================================
	elseif sEventName == "RefreshData" then
		RequestExChangeRate()
		RequestCombinedMargin()
	end
	
end

 --============================================================================
function edtPrc_OnEditComplete()
	
end

 --============================================================================
function edtQty_OnEditComplete()
	
end

 --============================================================================
 -- (가격)자동입력값 요청
 --============================================================================
function RequestAutoPrice()

	Form.TriggerEvent("#", "RequestAutoPrice", "BUY")

end

 --============================================================================
 -- (수량)자동입력값 요청
 --============================================================================
function RequestAutoQty()

	if g_szBuyQty == "1" then -- 현금가능수량
		
		if g_TotalReqComplete == true then
			Request_Able()
		end
		
	elseif g_szBuyQty == "2" then -- 최대가능수량 (해외주식은 미수가 없어 현금가능수량으로 조회)
		
		if g_TotalReqComplete == true then
			Request_Able()
		end
		
	elseif g_szBuyQty == "3" then -- 수량입력
	
		edtQty.caption = g_szBuyQtyCnt
		Calc_OrderPrice()
		
	end

	 --Form.triggerEvent("#", "RequestAutoQty", "BUY")

end

 --============================================================================
 -- (가격/수량)입력창 입력값 초기화
 --============================================================================
function Init_InputControl()
	
	if g_szChangeInit == "1" then
		
		edtQty.caption = ""
		edtPrc.caption = ""
		
		 -------------------------------------------------------------------------
		 -- ★ (가격/수량 자동입력 미사용 시)종목이 변경되면 가능수량을 다시 조회함.
		 -------------------------------------------------------------------------
		if g_TotalReqComplete == true then
			Request_Able()
		end
		
		 --edtQty_OnEditComplete()
		 --edtPrc_OnEditComplete()
		
	end
	
end

 --============================================================================
 -- (가격/수량)입력창 주문전송 후 초기화
 --============================================================================
function Reset_AfterOrd()
	
	edtQty.caption = ""
	edtPrc.caption = ""
		
end

 --============================================================================
 -- 거래소 호가단위 설정
 --============================================================================
function GetHogaUnit(szMk, szPrc, nGbn)
	
	 -------------------------------------------------------------------------
	 -- 호가단위 초기화
	 -------------------------------------------------------------------------
	szOrdPrc = gf_Tonumber(szPrc)
	
	if szOrdPrc == "" then
		if g_szCurPrice == "" or gf_Tonumber(g_szCurPrice) == 0 then
			szOrdPrc = 0		
		else
			szOrdPrc = gf_Tonumber(g_szCurPrice)
		end
	end
	
	szUnit = "1.000"
	
	 -------------------------------------------------------------------------
	 -- 틱타입 확인
	 -------------------------------------------------------------------------
	szTtype = gf_Tonumber(g_szTickType)

	if szTtype == 0 or szTtype == "" then
		szTtype = "0"
	end
	
	 -------------------------------------------------------------------------
	 -- 중국(상해/심천) 호가단위 설정
	 -------------------------------------------------------------------------
	if szMk == "0215" then --상해
	
		 --20240613 LES START 틱단위 수정
		if szTtype == 2 then --ETF
			szUnit = "0.001"
		else
			szUnit = "0.010"
		end
		 --20240613 LES END
		
	elseif szMk == "0214" then --심천
		
		 --20240613 LES START 틱단위 수정
		if szTtype == 2 then --ETF
			szUnit = "0.001"
		else
			szUnit = "0.010"
		end
		 --20240613 LES END
		
	 -------------------------------------------------------------------------
	 -- 미국(뉴욕/나스닥/아멕스) 호가단위 설정
	 -------------------------------------------------------------------------
	elseif szMk == "0321" or szMk == "0537" or szMk == "0066" then --뉴욕, 나스닥, 아멕스
		
		 --20240702 LES START - 1달러미만 종목 0.0001단위
		if szOrdPrc < 1.00 then
			szUnit = "0.0001" 
		else
			if szTtype == 1 then
				szUnit = "0.010"
				
			elseif szTtype == 2 then
				szUnit = "0.050"
				
			elseif szTtype == 3 then
				szUnit = "0.050"
				
			elseif szTtype == 4 then
				szUnit = "0.050"
				
			else
				szUnit = "0.010"
			end
		end
	
	 -------------------------------------------------------------------------
	 -- 홍콩 호가단위 설정, (홍콩ETF종목 호가단위 변경)
	 -------------------------------------------------------------------------
	elseif szMk == "0104" then --홍콩
		
		if szTtype == 3 then
			szUnit = "0.050"
			
		 --홍콩 ETF종목 호가단위 변경
		 --type = 5 (ETF종목) 추가
		 --20250728 MSH START 홍콩거래소 틱사이즈 변경 및 추가 
		elseif szTtype == 5 then
			
			if nGbn == 0 then
				if szOrdPrc < 1.00 then
					szUnit = "0.001"
