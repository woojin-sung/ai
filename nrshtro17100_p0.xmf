end

-- ... existing code ...

function Form_OnFormInit()
    local sLinkData = Form.GetOpenLinkData()
    
    local arrLinkData = Convert_StrToArr(sLinkData, "`")
    local nArrCnt = #arrLinkData
    
    if nArrCnt > 5 then
        g_sOrdGbn		= arrLinkData[1+1]
        g_sProcGbn		= arrLinkData[2+1]
        g_sInputData	= arrLinkData[3+1]
        g_sInteger		= arrLinkData[4+1]
        g_sDecimal		= arrLinkData[5+1]
        g_sPostFix		= arrLinkData[6+1]
        g_sRetKey		= arrLinkData[7+1]
        
        Init_Control()
    end
end

