-- ... existing code ...

function cont1_btnPlus_OnClick()
    if string.find(g_sInputData, "-") > 0 then
        g_sInputData = string.gsub(g_sInputData, string.gsub("-", "([%p])", "%%%1"), "") 
    end
    
    SetPrice("MANUAL", g_sInputData, g_sDecimal, g_sPostFix)
end

-- ... existing code ...

function cont1_btnMinus_OnClick()
    if string.find(g_sInputData, "-") == 0 and gf_Tonumber(g_sInputData) > 0 then
        g_sInputData = "-" .. g_sInputData
    end

    SetPrice("MANUAL", g_sInputData, g_sDecimal, g_sPostFix)
end

-- ... existing code ...

function cont1_btnClear_OnClick()
    InputKeypad("CLEAR", "")
end

-- ... existing code ...

function btnOk_OnClick()
    Form.SendReturnToParent("AUTO_RULE_KEYPAD_END" , g_sRetKey .. "`" .. g_sInputData)
    Form.CloseForm()
end

-- ... existing code ...

function imgBg_OnClick()
    Form.CloseForm()
end


	
