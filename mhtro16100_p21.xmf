dofile("scr/json.lua")

local g_szCode --거래국가코드
local g_szCodeName --거래국가코드한글명


local g_tCrCd --거래국가코드 인덱스
 --g_tCrCd = Array("000", "840", "156", "344", "392", "276@246@250@056@528@620@300@372@380@724@040", "704", "124", "702", "036", "756")
g_tCrCd = Array("000", "840", "156", "344", "392", "999", "704", "124", "702", "036", "756")

local g_tCrCdNm --거래국가코드명 인덱스
g_tCrCdNm = Array("전체", "미국", "중국", "홍콩", "일본", "유로", "베트남", "캐나다", "싱가포르", "호주", "스위스")


 --============================================================================
function Form_OnFormInitBefore()

	contMain.icon1.SetMaintainingRatio("1")
	contMain.icon2.SetMaintainingRatio("1")
	contMain.icon3.SetMaintainingRatio("1")
	contMain.icon4.SetMaintainingRatio("1")
	contMain.icon5.SetMaintainingRatio("1")
	contMain.icon6.SetMaintainingRatio("1")
	contMain.icon7.SetMaintainingRatio("1")
	contMain.icon8.SetMaintainingRatio("1")
	contMain.icon9.SetMaintainingRatio("1")
	contMain.icon10.SetMaintainingRatio("1")
	
end

 --============================================================================
function Form_OnFormInit()
	local szOpenData
	szOpenData = Form.GetOpenLinkData()
	if szOpenData ~= "" and szOpenData ~= nil then
		tData = gf_Split(szOpenData, "★")	
		
		g_szCode = tData[0+1]
		g_szCodeName = tData[1+1]
	else
		g_szCode = g_tCrCd[0]
		g_szCodeName = g_tCrCdNm[0]
	end

	 --기선택된 코드 표시
	for i = 0, #g_tCrCdNm - 1 do
		if g_szCodeName == g_tCrCdNm[i] then
			Form.SetCtlProp("contMain.img" .. i, "imgpath", "btn_line2_o.9.png")
		else
			Form.SetCtlProp("contMain.img" .. i, "imgpath", "btn_line2_n.9.png")
		end
	end
end

 --============================================================================
function BtnClose_OnClick()
	Form.CloseForm()
end

 --============================================================================
function Form_OnFormClose()
	 --Form.SendReturnToParent("STOCK_COUNTRY_SELECT", g_szCode .. "★" .. g_szCodeName)
end

 --============================================================================
function SetCheckFilter(iPos)
	
	 --체크된 버튼 라인 색 변경하고
	for i = 0, 10 do
		 --비활성화
		Form.SetCtlProp("contMain.img" .. gf_Tostring(i), "imgpath", "btn_line2_n.9.png")
 --		Form.SetCtlProp("contMain.lbl" .. gf_Tostring(i), "fgcolor", "146")
 --		Form.SetCtlProp("contMain.lbl" .. gf_Tostring(i), "fontstyle", "00")
	
		if i == iPos then
			 --활성화
			Form.SetCtlProp("contMain.img" .. gf_Tostring(i), "imgpath", "btn_line2_o.9.png")
 --			Form.SetCtlProp("contMain.lbl" .. gf_Tostring(i), "fgcolor", "334")
 --			Form.SetCtlProp("contMain.lbl" .. gf_Tostring(i), "fontstyle", "01")			
		end
	end
	
	g_szCode = g_tCrCd[iPos]		 --거래국가코드
	g_szCodeName = g_tCrCdNm[iPos]	 --거래국가명
	Form.SendReturnToParent("STOCK_COUNTRY_SELECT", g_szCode .. "★" .. g_szCodeName)
	
	Form.CloseForm()
	
end
 --============================================================================
function contMain_lbl0_OnClick()
	SetCheckFilter(0)
end

 --============================================================================
function contMain_lbl1_OnClick()
	SetCheckFilter(1)
end

 --============================================================================
function contMain_lbl2_OnClick()
	SetCheckFilter(2)
end

