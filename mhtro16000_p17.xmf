 --============================================================================
function Form_OnMsgBoxClose(sKeyName, sRet)
	if sKeyName == "MEMO_ADD" then
		Form.SendReturnToParent("REG_MEMO" , "ADD")
	elseif sKeyName == "MEMO_DEL" then
		Form.SendReturnToParent("REG_MEMO" , "DEL")
	end
	
	Form.CloseForm()
end

 --============================================================================
function Edit0_OnClick()
	Label5.visible = false
	
	 --20240904_01 HWG START : 종목메모 컨트롤위치 동적변경 기능 추가
	if g_isExpand == true then
		nReduce = 260
		
		Image0.height = 414 - nReduce
		Edit0.height = 394 - nReduce
		
		Label5.top = 337 - (nReduce/2)
		Label4.top = 560 - nReduce
		
		Button2.top = 596 - nReduce
		Button0.top = 596 - nReduce
	end
	 --20240904_01 HWG END
end

 --============================================================================
function Edit0_OnEditComplete()
	
	if gf_Trim(Edit0.caption) == "" then
		Label4.caption = "0 / 4000 Byte"
		Label5.visible = true
	else
		szByte = Form.GetLenByte(Edit0.caption)
		Label4.caption = szByte .. " / 4000 Byte"
		Label5.visible = false
	end
	
	g_szPrevText = ""
end

 --============================================================================
function Edit0_OnEditChar(CharCode)
	if CharCode == "" then
		Label4.caption = "0 / 4000 Byte"
	else
		szByte = Form.GetLenByte(CharCode)

		if szByte ~= "" then
			if gf_Tonumber(szByte) > 4000 then
				 --Edit0.caption = g_szPrevText
				 --szByte = Form.getLenByte(g_szPrevText)
				
				nTotalLen = Form.GetLen(CharCode)
				nCnt = nTotalLen
				for i = 0, nCnt-1 do
					nTotalLen = nTotalLen - 1
					szSub = Form.GetSubString(CharCode, 0, nTotalLen)
					szByte = Form.GetLenByte(szSub)

					if gf_Tonumber(szByte) <= 4000 then
						
						Edit0.caption = szSub	
						break
					end
				end
			else
				g_szPrevText = CharCode
			end
	
			Label4.caption = szByte .. " / 4000 Byte"
		end
	end
	
end

 --============================================================================
function Edit0_OnKeypadStatus(sStatus, nHeight)
	 --20240904_01 HWG START : 종목메모 컨트롤위치 동적변경 기능 추가
	if g_isExpand == true then
		if sStatus == "hide" and gf_Tonumber(nHeight) == 0 then
			Image0.height = 414
			Edit0.height = 394
			
			Label5.top = 337
			Label4.top = 560
			
			Button2.top = 596
			Button0.top = 596
			
			if gf_Trim(Edit0.caption) == "" then
				Label4.caption = "0 / 4000 Byte"
				Label5.visible = true
			else
				szByte = Form.GetLenByte(Edit0.caption)
				Label4.caption = szByte .. " / 4000 Byte"
				Label5.visible = false
			end
		elseif sStatus == "show" then
			Label5.visible = false
			 --20240904_01 HWG START : 종목메모 컨트롤위치 동적변경 기능 추가
			if g_isExpand == true then
				nReduce = 260
				
				Image0.height = 414 - nReduce
				Edit0.height = 394 - nReduce
				
				Label5.top = 337 - (nReduce/2)
				Label4.top = 560 - nReduce
				
				Button2.top = 596 - nReduce
				Button0.top = 596 - nReduce
			end
			 --20240904_01 HWG END
		end
		
		
	end
	 --20240904_01 HWG END
end

 --20240828_01 KBC START : 관심종목 종목메모 연계 (국내+해외 종목메모 통합)
function Request_Tran_ohhts_memo_013r_1()
	DATAMANAGER.ClearInputData(false, "ohhts_memo_013r_1")
	
	szUserID		= Form.GetSharedData("..USER_ID", false )
	szToday		= Form.GetSharedData("..HOST_DATE", 0 )
	szName		= Form.GetItemCodeInfo(g_szItemCd, "name")
	
	 --MsgBox g_szItemCd & ".." & g_szItemMarket & ".." & szName
	
	if g_saveFg == false then
		DATAMANAGER.SetDataValue( 0, "ohhts_memo_013r_1", "InBlock1", "FID_USER_ID" 				, 0 ,  szUserID)
		DATAMANAGER.SetDataValue( 0, "ohhts_memo_013r_1", "InBlock1", "FID_MEMO_MANG_CLS_CODE" 	, 0 , "2" )		 --1일반메모,2종목메모
		DATAMANAGER.SetDataValue( 0, "ohhts_memo_013r_1", "InBlock1", "FID_INPUT_SLCT_YN" 		, 0 , "1" )		 --1검색,2전체검색,3추가,4수정,5삭제,9전체삭제
		DATAMANAGER.SetDataValue( 0, "ohhts_memo_013r_1", "InBlock1", "FID_INPUT_CLS_CODE" 		, 0 , "1" )		 --1제목,2내용,3제목+내용, 1종목,2내용
		DATAMANAGER.SetDataValue( 0, "ohhts_memo_013r_1", "InBlock1", "FID_NEW_ISSU_CODE" 		, 0 , g_szItemCd )
		DATAMANAGER.SetDataValue( 0, "ohhts_memo_013r_1", "InBlock1", "FID_INPUT_MRKT_CLS_CODE" 	, 0 , g_szItemMarket )
	else
		DATAMANAGER.SetDataValue( 0, "ohhts_memo_013r_1", "InBlock1", "FID_USER_ID" 				, 0 ,  szUserID)
		DATAMANAGER.SetDataValue( 0, "ohhts_memo_013r_1", "InBlock1", "FID_MEMO_MANG_CLS_CODE" 	, 0 , "2" )		 --1일반메모,2종목메모
		
		if gf_Trim(Edit0.caption) == "" then
			DATAMANAGER.SetDataValue( 0, "ohhts_memo_013r_1", "InBlock1", "FID_INPUT_SLCT_YN" 	, 0 , "5" ) 		 --1검색,2전체검색,3추가,4수정,5삭제,9전체삭제
		else
			DATAMANAGER.SetDataValue( 0, "ohhts_memo_013r_1", "InBlock1", "FID_INPUT_SLCT_YN" 	, 0 , "4" )		 --1검색,2전체검색,3추가,4수정,5삭제,9전체삭제
		end
		
		DATAMANAGER.SetDataValue( 0, "ohhts_memo_013r_1", "InBlock1", "FID_INPUT_CLS_CODE" 		, 0 , "" )
		DATAMANAGER.SetDataValue( 0, "ohhts_memo_013r_1", "InBlock1", "FID_MOD_YMDH"				, 0 , szToday )
		DATAMANAGER.SetDataValue( 0, "ohhts_memo_013r_1", "InBlock1", "FID_NEW_ISSU_CODE"			, 0 , g_szItemCd)
			
		DATAMANAGER.SetDataValue( 0, "ohhts_memo_013r_1", "InBlock1", "FID_KOR_ISNM" 				, 0 , szName )
		DATAMANAGER.SetDataValue( 0, "ohhts_memo_013r_1", "InBlock1", "FID_ISSU_MEMO_CNTT"		, 0 , Edit0.caption )
		DATAMANAGER.SetDataValue( 0, "ohhts_memo_013r_1", "InBlock1", "FID_INPUT_MRKT_CLS_CODE" 	, 0 , g_szItemMarket)
	
	end
	DATAMANAGER.RequestTranData("ohhts_memo_013r_1")
end

function Request_Tran_ohhts_1001_001r()
	
	DATAMANAGER.CancelRealData("ohhts_stck_incg")
	
	 --************************************ SOR_START
	 -- 20250507 이윤성 2차 대체거래소 거래소구분 추가작업
	DATAMANAGER.CancelRealData("ohhts_unt_incg")
	 --************************************ SOR_END		
	
	DATAMANAGER.ClearInputData(false, "ohhts_1001_001r")
	DATAMANAGER.SetDataValue( 0, "ohhts_1001_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE"	, 0 , g_szItemMarket )
	DATAMANAGER.SetDataValue( 0, "ohhts_1001_001r", "InBlock1", "FID_INPUT_ISCD" 				, 0 , g_szItemCd )
	DATAMANAGER.RequestTranData("ohhts_1001_001r")
end
