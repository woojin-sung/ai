			end
			
			szByte = Form.GetLenByte(Edit0.caption)
			
			Label4.caption = szByte .. " / 4000 Byte"
			
			if szMemo == "" then
				Label5.visible = true
			else
				Label5.visible = false
			end
		end
		
	 --20240828_01 KBC START : 관심종목 종목메모 연계 (국내+해외 종목메모 통합)
	elseif szTranID == "ohhts_memo_013r_1" then
