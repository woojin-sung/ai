function Request_Tran_ohhts_memo_013r()
	DATAMANAGER.ClearInputData(false, "ohhts_memo_013r")
	szUserID = Form.GetSharedData("..USER_ID", false )
	g_szToday = Form.GetSharedData("..HOST_DATE", 0 )
	szName = Form.GetItemCodeInfo(g_szExidCd.."@"..g_szOnlyCd, "name")
	if g_saveFg == false then
		DATAMANAGER.SetDataValue( 0, "ohhts_memo_013r", "InBlock1", "FID_USER_ID" 			, 0 ,  szUserID)
		DATAMANAGER.SetDataValue( 0, "ohhts_memo_013r", "InBlock1", "FID_MEMO_MANG_CLS_CODE" 	, 0 , "2" )
		DATAMANAGER.SetDataValue( 0, "ohhts_memo_013r", "InBlock1", "FID_INPUT_SLCT_YN" 		, 0 , "1" )
		DATAMANAGER.SetDataValue( 0, "ohhts_memo_013r", "InBlock1", "FID_INPUT_CLS_CODE" 		, 0 , "1" )
		DATAMANAGER.SetDataValue( 0, "ohhts_memo_013r", "InBlock1", "FID_NEW_ISSU_CODE" 		, 0 , g_szExidCd.."@"..g_szOnlyCd )
		
		DATAMANAGER.SetDataValue( 0, "ohhts_memo_013r", "InBlock1", "FID_INPUT_MRKT_CLS_CODE" 	, 0 , "OV" )
	else
		DATAMANAGER.SetDataValue( 0, "ohhts_memo_013r", "InBlock1", "FID_USER_ID" 			, 0 ,  szUserID)
		DATAMANAGER.SetDataValue( 0, "ohhts_memo_013r", "InBlock1", "FID_MEMO_MANG_CLS_CODE" 	, 0 , "2" )
		if gf_Trim(Edit0.caption) == "" then
			DATAMANAGER.SetDataValue( 0, "ohhts_memo_013r", "InBlock1", "FID_INPUT_SLCT_YN" 	, 0 , "5" )
		else
			DATAMANAGER.SetDataValue( 0, "ohhts_memo_013r", "InBlock1", "FID_INPUT_SLCT_YN" 	, 0 , "4" )
		end
		DATAMANAGER.SetDataValue( 0, "ohhts_memo_013r", "InBlock1", "FID_INPUT_CLS_CODE" 		, 0 , "1" )
		DATAMANAGER.SetDataValue( 0, "ohhts_memo_013r", "InBlock1", "FID_MOD_YMDH"			, 0 , g_szToday )
		DATAMANAGER.SetDataValue( 0, "ohhts_memo_013r", "InBlock1", "FID_NEW_ISSU_CODE"		, 0 , g_szExidCd.."@"..g_szOnlyCd )
		
		DATAMANAGER.SetDataValue( 0, "ohhts_memo_013r", "InBlock1", "FID_KOR_ISNM" 			, 0 , szName )
		DATAMANAGER.SetDataValue( 0, "ohhts_memo_013r", "InBlock1", "FID_ISSU_MEMO_CNTT"		, 0 , Edit0.caption )
		DATAMANAGER.SetDataValue( 0, "ohhts_memo_013r", "InBlock1", "FID_INPUT_MRKT_CLS_CODE" 	, 0 ,  "OV" )
	
	end
	DATAMANAGER.RequestTranData("ohhts_memo_013r")
end

 --==============================================
 -- 장운영 정보 기반 시세서비스 호출
 --==============================================
function Request_MktOp(szMkOpClsCd)
	
	 --해외주식 체결(프리/정규) 실시간 해제
	DATAMANAGER.CancelRealData("ohhts_exst_cntg")
	
	 --해외주식 체결(주간) 실시간 해제
	DATAMANAGER.CancelRealData("ohhts_exst_cntd")
	
	 --해외주식 체결(애프터) 실시간 해제
	DATAMANAGER.CancelRealData("ohhts_exst_cnta")
	
	-- SELECT CASE 변환 (수동 보정 필요)
			
		if szMkOpClsCd == "001" then --주간장 개시
			Request_Tran_ohhts_6000_017r()
	
		elseif szMkOpClsCd == "002" then --주간장 종료
			Request_Tran_ohhts_6000_001r()

		elseif szMkOpClsCd == "003" then --프리장 개시
			Request_Tran_ohhts_6000_001r()

		elseif szMkOpClsCd == "004" then --정규장 개시
			Request_Tran_ohhts_6000_001r()

		elseif szMkOpClsCd == "005" then --애프터장 개시
			Request_Tran_ohhts_6000_023r()

		elseif szMkOpClsCd == "006" then --애프터장 종료
			Request_Tran_ohhts_6000_001r()
			
		elseif szMkOpClsCd == "011" or szMkOpClsCd == "012" then --미국 외 장개시/종료
			Request_Tran_ohhts_6000_001r()
			
		elseif szMkOpClsCd == "013" then
			Request_Tran_ohhts_6000_001r()
			
		else
			Request_Tran_ohhts_6000_001r()

	end

end


 --****************************************************************************
 --               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
 --****************************************************************************
 --===============================================
 -- Form_OnFormInitBefore
 --===============================================
function Form_OnFormInitBefore()
end

 --===============================================
 -- Form_OnFormInit
 --===============================================
function Form_OnFormInit()
	g_szOsType = Form.GetSharedData("..OS_TYPE", false)
	Init_Control()
	
	local szLinkData
	szLinkData = Form.GetOpenLinkData()
	
	sTemp = gf_Split(szLinkData, "@")
	
	
	 --************************************ SOR_START
	 -- 20250507 이윤성 2차 대체거래소 거래소구분 추가작업
	g_szAtsSelectCd = Form.GetEnvData("MARKET_TOGGLE")	 -- 거래소구분코드(SOR, KRX, NXT)	
	 --************************************ SOR_END
	
		
	if #sTemp > 2 then
		g_szOvrsYn = "Y"  --20240828_01 KBC : 관심종목 종목메모 연계 (국내+해외 종목메모 통합)
	
		g_szExidCd = sTemp[0+1]  --시장구분
		g_szOnlyCd = sTemp[1+1]  --종목코드 
		g_szMkOpClsCd = sTemp[2+1]
		
		szCrcd = ""
		if g_szExidCd =="AX" or g_szExidCd =="NY" or g_szExidCd =="OQ" then
			szCrcd = "USD"
		elseif g_szExidCd =="HK" then
				szCrcd = "HKD"
		elseif g_szExidCd =="SH" or g_szExidCd =="SZ" then
				szCrcd = "CNY"
		elseif g_szExidCd =="JP" then
				szCrcd = "JPY"
		end
		
		Label2.caption = szCrcd
		
		szName = Form.GetItemCodeInfo(g_szExidCd.."@"..g_szOnlyCd, "name")
		Label1.caption = szName
		Request_MktOp(g_szMkOpClsCd)
		
		Request_Tran_ohhts_memo_013r()
		
	 --20240828_01 KBC START : 관심종목 종목메모 연계 (국내+해외 종목메모 통합)
	elseif #sTemp > 1 then
		if szLinkData == "" then
			return
		end

		g_szOvrsYn = "N"
		g_szItemCd = sTemp[0+1]
		g_szItemMarket = sTemp[1+1]
		
		 --************************************ SOR_START
		 -- 20250507 이윤성 2차 대체거래소 거래소구분 추가작업
		if gf_Trim(g_szAtsSelectCd) == "SOR" then
			g_szItemMarket = "TJ"
		end
		 --************************************ SOR_END
		
		Label2.caption = ""
		szName = Form.GetItemCodeInfo(g_szItemCd, "name")
		Label1.caption = szName
		
		Request_Tran_ohhts_1001_001r()
		Request_Tran_ohhts_memo_013r_1() 
		
	 --20240828_01 KBC END		
	end

end

 --===============================================
 -- imgBg_OnClick
 --===============================================
function imgClose_OnClick()
	Form.CloseForm()
end

 --============================================================================
function DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "ohhts_6230_001r" then
		Process_Tran_ohhts_6230_001r()
		
	elseif szTranID == "ohhts_6230_002r" then
		Process_Tran_ohhts_6230_002r()
		
	elseif szTranID == "ohhts_6000_017r" then
		szPrpr = DATAMANAGER.GetDataValue(0,  "ohhts_6000_017r", "OutBlock1", "FIDX_DYTM_PRPR", 0)
		
