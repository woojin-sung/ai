			end
			
			szByte = Form.GetLenByte(Edit0.caption)
			
			Label4.caption = szByte .. " / 4000 Byte"
			
			if szMemo == "" then
				Label5.visible = true
			else
				Label5.visible = false
			end
		end
		
	elseif szTranID == "ohhts_1001_001r" then
		
		 --************************************ SOR_START
		 -- 20250507 이윤성 2차 대체거래소 거래소구분 추가작업
