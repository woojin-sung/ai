 --20240904_01 HWG START : 종목메모 컨트롤위치 동적변경 기능 추가 
 --===============================================
 -- 앱 버전코드 숫자로 변경
 --===============================================
function Convert_AppVer()
	g_nAppVer = 0
	
	local szAppVer
	szAppVer = Form.GetSharedData("..APP_VERSION", false)
	
	arrAppVer = gf_Split(szAppVer, ".")
	
	if #arrAppVer > 2 then
		g_nAppVer = (gf_Tonumber(arrAppVer[0+1]) * 1000) + (gf_Tonumber(arrAppVer[1+1]) * 100) + (gf_Tonumber(arrAppVer[2+1]))
	end
end

 --===============================================
 -- 컨트롤 초기화
 --===============================================
function Init_Control()
	Convert_AppVer()
	
	if (g_szOsType == "1" and g_nAppVer > 2501) or (g_szOsType == "2" and g_nAppVer > 2550) then
		g_isExpand = true
		
		Image0.height = 414
		Edit0.height = 394
		
		Label5.top = 337
		Label4.top = 560
		
		Button2.top = 596
		Button0.top = 596
		
	else
		g_isExpand = false
		
		nReduce = 260
		Image0.height = 414 - nReduce
		Edit0.height = 394 - nReduce
		
		Label5.top = 337 - (nReduce/2)
		Label4.top = 560 - nReduce
		
		Button2.top = 596 - nReduce
		Button0.top = 596 - nReduce
	
	end

	lblTitle.fgcolor = g_szTxtColor_Normal
	lblTitle.paddinginfo = "0,0,0,0"
	
	Label4.fgcolor = g_szTxtColor_Grey

	imgBack.maintainratio = "2"
	imgBack.imgpath = g_szBackImg
	
	Label0.bgcolor = g_szContBgColor
	
	lblPrc.paddinginfo = "0,0,0,0"
	lblConvAmt.paddinginfo = "0,0,0,0"
	
	lblDiff0.paddinginfo = "0,0,0,0"
	lblRate0.paddinginfo = "0,0,0,0"
	
	lblPrc.bgcolor = g_szContBgColor
	lblRate0.bgcolor = g_szContBgColor
	lblDiff0.bgcolor = g_szContBgColor
	lblConvAmt.bgcolor = g_szContBgColor
	
	imgClose.SetMaintainingRatio("3")
	imgClose.imgpath = "icon_close"
end
 --20240904_01 HWG END

function Request_Tran_ohhts_6000_001r()
	DATAMANAGER.ClearInputData(false, "ohhts_6000_001r")
	
	g_rtChk = Form.GetSharedData( "REALTIME_"..g_szExidCd, false )
	DATAMANAGER.SetDataValue( false, "ohhts_6000_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" 	, 0 , "OV" )		 --시장구분			
	DATAMANAGER.SetDataValue( false, "ohhts_6000_001r", "InBlock1", "FID_COND_MRKT_CLS_CODE" 		, 0 , g_szExidCd )	 --마켓구분
	DATAMANAGER.SetDataValue( false, "ohhts_6000_001r", "InBlock1", "FID_INPUT_OVRS_ISCD" 			, 0 , g_szOnlyCd )	 --종목코드
	DATAMANAGER.SetDataValue( false, "ohhts_6000_001r", "InBlock1", "FIDX_INPUT_DELY_RLTM_CLS_CODE" , 0 , g_rtChk )	 --실시간 여부
	
	DATAMANAGER.RequestTranData("ohhts_6000_001r")
	
	Request_Real_ohhts_exst_cntg()
end


