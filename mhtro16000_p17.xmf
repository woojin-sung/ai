			end
			 --Form.closeForm()
		else
			szMemo = DATAMANAGER.GetDataValue(0, "ohhts_memo_013r_1", "OutBlock1", "FID_ISSU_MEMO_CNTT" , 0)
			Edit0.caption = szMemo
			
			if gf_Trim(Edit0.caption) == "" then
