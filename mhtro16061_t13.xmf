 --============================================================================
 -- 주문확인창/경고팝업 오픈
 --============================================================================
function Open_ConfirmPopup(szWarn)
	
	local szData, szOrdNm, szOrdGubun,szPrcOrd
	 ----------------------------------------------------
	 --취소
	 ----------------------------------------------------
	if gOrderReqIndex == 2 then
	
		 --선택행
		nRowIdx = GetCheckIndex()
		
	     -- 주문구분
		szOrdType    = Grid0.GetCellData( "bd_cell6"	, nRowIdx)
		 -- 계좌번호, 계좌명
		szAcctNo 	= Form.GetTopCtlProp("acnt", "caption")
		szAcctName 	= Form.GetTopCtlProp("acnt", "accountname")
	
		 -- 종목코드확인   
		g_szItmCode 	= Grid0.GetCellData("bd_cell3", nRowIdx)
	
		 -- 예약주문번호  
		g_szOrdNo = Grid0.GetCellData("bd_cell11", nRowIdx)		
	
		 -- 예약등록일자
		g_szDate = Grid0.GetCellData( "bd_cell1", nRowIdx)
		
		 -- 종목명
		szItmName = Grid0.GetCellData("bd_cell13", nRowIdx)
	
		 -- 잔량전부(취소주문은 잔량 전부)
		g_szOrd_ChkAll = "Y"
	
		 --주문유형명
		szOrdNm = Grid0.GetCellData("bd_cell12", nRowIdx)
		
		 --주문수량
		szOrdQty = Grid0.GetCellData("bd_cell14", nRowIdx)
		
		 --주문가격
		szOrdPrc = Grid0.GetCellData("bd_cell4", nRowIdx)
	
		 --현금/대출구분(선택행의 대출상세유형 코드로 구분)
		szLoanType = Grid0.GetCellData("bd_loantype", nRowIdx)
		szLoanDate = Grid0.GetCellData("bd_loandate", nRowIdx)
		szLoanSrno = Grid0.GetCellData("bd_loansrno", nRowIdx)
		
		if szLoanType == "0251" then
			szOrdGubun = "1"
		else
			szOrdGubun = "0"
		end
		
		 --주문데이터    
		szData = szOrdType													 -- 매수/매도
		szData = szData .. "|" .. Form.GetTopCtlProp("acnt", "caption")		 -- 계좌번호
		szData = szData .. "|" .. Form.GetTopCtlProp("acnt", "accountname")	 -- 계좌명
		szData = szData .. "|" .. g_szItmCode								 -- 종목코드
		szData = szData .. "|" .. szItmName								 -- 종목명
		szData = szData .. "|" .. szOrdNm									 -- 주문구분
		szData = szData .. "|" .. szOrdGubun								 -- 현금(0:현금/1:대출)
		szData = szData .. "|" .. szOrdQty								 -- 주문수량
		szData = szData .. "|" .. szOrdPrc								 -- 주문가격
		szData = szData .. "|" .. g_szOrdNo								 -- 원주문번호
		szData = szData .. "|" .. g_szOrd_ChkAll							 -- 잔량전부
		szData = szData .. "|" .. g_szDecimal								 -- 가격자릿수
		szData = szData .. "|" .. g_szCurrency							 -- 통화기호
		szData = szData .. "|" .. szOrdNm									 -- 시장가or지정가
			
		 --대출관련 추가 정보
		szData = szData .. "|" .. szLoanType 								 -- 대출구분
		szData = szData .. "|" .. szLoanDate 								 -- 대출일자
		szData = szData .. "|" .. szLoanSrno 								 -- 대출일련번호
    
	
	 ----------------------------------------------------
	 -- 전체취소
	 ----------------------------------------------------
	elseif gOrderReqIndex == 3 then

		szData = Form.GetTopCtlProp("acnt", "caption")					 -- 계좌번호
		szData = szData .. "|" .. Form.GetTopCtlProp("acnt", "accountname")	 -- 계좌명
		
		nGridRowCnt = gf_Tonumber(Grid0.rowcount)
		nCheckNum = gf_Tonumber(GetCheckNum())
		
		szData = szData .. "|" .. nCheckNum								 -- 선택건수
		
		if nGridRowCnt == nCheckNum then
			szData = szData .. "|" .. "Y" .. "|"							 -- 선택건수가 전체선택인지 여부
		else
			szData = szData .. "|" .. "N" .. "|"
		end
	
	end

	 ------------------------------------------------------
	 -- 경고팝업 오픈 (취소는 경고팝업 안뜸)
	 ------------------------------------------------------
	if gf_Trim(szWarn) ~= "" then
		
		 --경고메세지 추가	
		szData = szData .. "|" .. szWarn			
		Form.OpenPopupAnimation("mhtro16100_p8", szData , "", "2")
	
	 ------------------------------------------------------
	 -- 주문확인팝업 오픈
	 ------------------------------------------------------
	else
		
		 --gOrderReqIndex => 1:정정/2:취소/3:전체취소 서비스 호출
		if gOrderReqIndex == 2 then
			Form.OpenPopupAnimation("mhtro16061_p6", szData , "", "2")
		elseif gOrderReqIndex == 3 then
			Form.OpenPopupAnimation("mhtro16061_p7", szData , "", "2")
		end
		
	end
	
end

 --============================================================================
 -- 주문전송
 --============================================================================
function Request_Order()
	
	 --------------------------
	 -- 해외주식 주문착오 방지
	 --------------------------
	g_szWarnFlag	= "N"
	
	 ------------------------------------
	 -- 주문서비스 호출
	 ------------------------------------
	DATAMANAGER.RequestTranData("obtro_oder_113a")
	
end

 --============================================================================
 -- 전체취소 주문전송
 --============================================================================
function Request_OrderAllCancel()

	 ----------------------------------------------
	 -- 주문나갈 행 인덱스
	 ----------------------------------------------
	local szIdx
	szIdx = "" 
	
	 ----------------------------------------------
	 --gCanCelItemCnt : 주문이 나가야되는 전체건수
	 --gRemainItemCnt : 주문이 나가고 남은 건수
	 ----------------------------------------------
	if gCanCelItemCnt < 0 then
		gCanCelItemCnt = GetCheckNum()
		gRemainItemCnt = gCanCelItemCnt
		gOrderIndex = 0
		gCanCelFirstItem = true
	end
	
	
	 ------------------------------------------------
	 -- 첫번째 주문은 0번째 행부터 서칭
	 ------------------------------------------------
	if gCanCelFirstItem == true then
		
		for i = gOrderIndex, gf_Tonumber(Grid0.rowcount) - 1 do
			
			szChk = gf_Tonumber(Grid0.GetCellData("bd_cell21", i))
			
			if szChk == 1 then
				szIdx = i
				gOrderIndex  = szIdx
				gCanCelFirstItem = false
				break
			end
			
		end
	
	 ------------------------------------------------
	 -- 두번째 주문부터는 직전 인덱스 다음부터 서칭
	 ------------------------------------------------
	else
		
		for i = gOrderIndex + 1, gf_Tonumber(Grid0.rowcount) - 1 do
			
			szChk = gf_Tonumber(Grid0.GetCellData("bd_cell21", i))
			
			if szChk == 1 then
				szIdx = i
				gOrderIndex  = szIdx
				break
			end
		
		end
	
	end
	
	
	 ------------------------------------------------
	 -- 주문나갈 종목 정보가져오기
	 ------------------------------------------------
	if gOrderIndex  ~= "" then
		
		nGridLastIndex = gf_Tonumber(Grid0.rowcount) - 1
		
		if gOrderIndex <= nGridLastIndex then
			
			 --Form.ShowAlert("TEST", "(예정)총 주문건수 : " .. gCanCelItemCnt .."\n".. "주문전송행 : "..gOrderIndex.."\n".. "남은 건수 : " .. gRemainItemCnt .."\n".. "실패건수 : "..gOrdFailItemCnt)
			
			g_szTR = "obtro_oder_113a_1"
		
			szOrdDate = Grid0.GetCellData("bd_cell1", gOrderIndex)
			szOrdOrgnNo = Grid0.GetCellData("bd_cell11", gOrderIndex)
			szModeCancelType = "2" 
			
			szAcno = Form.GetTopCtlProp("acnt", "total")
			szAsno = Form.GetTopCtlProp("acnt", "sequence")
			szAcpw = Form.GetTopCtlProp("edtPwd", "caption")
	
			DATAMANAGER.ClearInputData(0, "obtro_oder_113a_1")
	
			DATAMANAGER.SetDataValue(0, "obtro_oder_113a_1", "InBlock1", "ACNO"					, 0, szAcno)		 -- 계좌번호(8)
			DATAMANAGER.SetDataValue(0, "obtro_oder_113a_1", "InBlock1", "ASNO"					, 0, szAsno)		 -- 계좌일련번호(2)
			DATAMANAGER.SetDataValue(0, "obtro_oder_113a_1", "InBlock1", "ACNT_PWD"				, 0, szAcpw)		 -- 계좌 비밀번호
			
			DATAMANAGER.SetDataValue( 0, "obtro_oder_113a_1", "InBlock1", "ODER_RSEV_MST_DATE"	, 0 , szOrdDate	)	 -- 주문예약마스터일자(8) - 2019.10.14
			DATAMANAGER.SetDataValue( 0, "obtro_oder_113a_1", "InBlock1", "ODER_RSEV_MST_NO"		, 0 , szOrdOrgnNo	)	 -- 주문예약마스터번호
			
			DATAMANAGER.RequestTranData("obtro_oder_113a_1")
			
		end
	
	end
	
	
	
end

 --============================================================================
 -- 팝업창 리턴처리
 --============================================================================
function Form_OnPopupReturn(sKeyName, sRet)
	
	 -- ----------------------------------------------------------------------
	 -- (사용)해외주식 주문착오 방지 (경고팝업에서 리턴)
	 -- ----------------------------------------------------------------------	
	if sKeyName == "주문경고" then
		if sRet == "1" then
			g_szWarnFlag = "Y"
			DATAMANAGER.RequestTranData(g_szTR)
		end
	
	 -- ----------------------------------------------------------------------
	 -- (사용)PTP경고팝업에서 리턴 (20221206_01 KBC START : 해외주식 미국PTP 종목과세관련)
	 -- ----------------------------------------------------------------------	
	elseif sKeyName == "PTP주문경고" then
		if sRet == "1" then
			g_szWarnFlag = "Y"
			DATAMANAGER.RequestTranData(g_szTR)
		end
	
	 -- ----------------------------------------------------------------------
	 -- (사용)주문확인창에서 리턴
	 -- ----------------------------------------------------------------------	
	elseif sKeyName == "주문전송" then
		if sRet == "1" then
			Request_Order()	
		end
		
	 ------------------------------------------------------------------------
	 -- (사용) 전체취소 주문확인창에서 리턴
	 ------------------------------------------------------------------------
	elseif sKeyName == "전체취소주문전송" then
		if sRet == "1" then
			Request_OrderAllCancel()
		end
		
	elseif sKeyName == "mhtro16061_p8" then
		arrData = gf_Split(sRet,"★")
		
		g_orderClsCode = arrData[0+1]
		g_idntClcd = arrData[1+1]
		g_selnByovClcd = arrData[2+1]
		
		Form.SetSharedData("..mhtro16061_t13_order_cls_code", g_orderClsCode)
		Form.SetSharedData("..mhtro16061_t13_idnt_clcd", g_idntClcd)
		Form.SetSharedData("..mhtro16061_t13_seln_byov_clcd", g_selnByovClcd)
		
		setLabelFilterCaption()
		RequestData()
	end
	
end


 --============================================================================
 -- 거래소코드(4자리) <- 거래명(2자리)
 --============================================================================
function Transform_Exid(sValue)
	if sValue == "0104" then -- 홍콩
		return "HK"
	elseif sValue == "0215" then -- 상해
		return "SH"
	elseif sValue == "0214" then -- 심천
		return "SZ"
	elseif sValue == "0321" then -- 뉴욕
		return "NY"
	elseif sValue == "0066" then -- 아멕스
		return "AX"
	elseif sValue == "0537" then -- 나스닥
		return "OQ"
	elseif sValue == "0106" then -- 도쿄
		return "JP"
	end
end

 --============================================================================
 -- 정정/취소화면 전용 함수
 --============================================================================
function ChangeGridType(sType)
	
	 --sType : 3 => 선택종목이 없는 경우(디폴트)
	if sType == "3" then
	
		Grid0.height = 321
		
		btnCancel.visible = false
		btnAllCancel.visible = false

	
	 --sType : 4 => 선택종목이 있는 경우
	elseif sType == "4" then
	
		Grid0.height = 250
		
		btnCancel.visible = true
		btnAllCancel.visible = false

		
	 --sType : 5 => 전체취소 모드
	elseif sType == "5" then
	
		Grid0.height = 250
		
		btnCancel.visible = false
		btnAllCancel.visible = true

	
	end

end

 --============================================================================
 -- 예약내역 조회
 --============================================================================
function RequestData()

	 --------------------------------------------------------------------------------------
	 -- 미체결 내역
	 --------------------------------------------------------------------------------------
	Grid0.rowcount = 0
	Grid0.SetClear()
	chkAllCancel.chksilence = "0"
	ChangeGridType("3")
	
	DATAMANAGER.ClearInputData(0, "obtro_oder_114r")
	
	szAcno = Form.GetTopCtlProp("acnt", "total")
	szAsno = Form.GetTopCtlProp("acnt", "sequence")
	szAcpw = Form.GetTopCtlProp("edtPwd", "caption")

	DATAMANAGER.SetDataValue( 0, "obtro_oder_114r", "InBlock1", "ACNO" 		, 0 , szAcno 	)	 -- 계좌번호(8)
	DATAMANAGER.SetDataValue( 0, "obtro_oder_114r", "InBlock1", "ASNO" 		, 0 , szAsno 	)	 -- 계좌일련번호(2)
	DATAMANAGER.SetDataValue( 0, "obtro_oder_114r", "InBlock1", "ACNT_PWD" 	, 0 , szAcpw	)	 -- 계좌비밀번호
	
	 --v1000
	DATAMANAGER.SetDataValue( 0, "obtro_oder_114r", "InBlock1", "ODER_RSEV_CLS_CODE" 	, 0 , g_orderClsCode)	 -- 예약유형 0:전체 1:일반예약 2:기간잔량 3:기간예약 4:특정일
	DATAMANAGER.SetDataValue( 0, "obtro_oder_114r", "InBlock1", "PROS_CLS_CODE" 		, 0 , "2")			 -- 처리구분 2로 고정
	DATAMANAGER.SetDataValue( 0, "obtro_oder_114r", "InBlock1", "IQRY_STA_DATE" 		, 0 , cld0.caption)	 -- 검색시작일
	DATAMANAGER.SetDataValue( 0, "obtro_oder_114r", "InBlock1", "IQRY_FIN_DATE" 		, 0 , cld1.caption)	 -- 검색시작일
	DATAMANAGER.SetDataValue( 0, "obtro_oder_114r", "InBlock1", "IQRY_CLS_CODE" 		, 0 , g_clsCode)		 -- 검색일 구분 1:주문일 2:예약일
	DATAMANAGER.SetDataValue( 0, "obtro_oder_114r", "InBlock1", "IQRY_IDNT_CLCD" 		, 0 , g_idntClcd)		 -- 검색 처리 구분 0:전체 1:전체(취소제외) 2:예약
	DATAMANAGER.SetDataValue( 0, "obtro_oder_114r", "InBlock1", "SELN_BYOV_CLCD" 		, 0 , g_selnByovClcd)	 -- 검색 매매 구분 0:전체 1:매도 2:매수
	DATAMANAGER.SetDataValue( 0, "obtro_oder_114r", "InBlock1", "TDAY_DEAL_YN" 		, 0 , g_tdayDealYn)	 -- 검색 당일매매여부
	
	DATAMANAGER.RequestTranData("obtro_oder_114r")
	
end

 --============================================================================
 -- 국가코드 => 국가명 가져오기
 --============================================================================
function GetCountryNameByCode(sCountryCode,sVndrCode)

	if sCountryCode == "01" then
		return "미국"
	elseif sCountryCode == "02" then
		return "홍콩"
	elseif sCountryCode == "03" then
 --		return "상해"
		return "중국"
	elseif sCountryCode == "04" then
 --		return "심천"
		return "중국"
	elseif sCountryCode == "05" then
		return "일본"
	elseif sCountryCode == "06" then
		return "호주"
	elseif sCountryCode == "07" then
		return "싱가폴"
	elseif sCountryCode == "08" then
		return "영국"
	elseif sCountryCode == "09" then
		return "영국"
	elseif sCountryCode == "10" then
		return "독일"
	elseif sCountryCode == "11" then
		return "핀란드"
	elseif sCountryCode == "12" then
		return "프랑스"
	elseif sCountryCode == "13" then
		return "벨기에"
	elseif sCountryCode == "14" then
		return "네덜란드"
	elseif sCountryCode == "15" then
		return "포르투갈"
	elseif sCountryCode == "16" then
		return "그리스"
	elseif sCountryCode == "17" then
		return "아일랜드"
	elseif sCountryCode == "18" then
		return "이탈리아"
	elseif sCountryCode == "19" then
		return "스페인"
	elseif sCountryCode == "20" then
		return "오스트리아"
	elseif sCountryCode == "21" then
		return "캐나다"
	elseif sCountryCode == "23" then
		return "인도네시아"
	elseif sCountryCode == "24" then
		
		if sVndrCode == "XSTC" then
			return "호치민"
		elseif sVndrCode == "HSTC" then
			return "하노이"
		end
	
	elseif sCountryCode == "26" then
		return "스위스"
		
	else
		return ""
	end

end

 --============================================================================
 -- 주문유형코드 => 주문유형명 가져오기
 --============================================================================
function GetOrderNameByCode(sCode)
	
	if sCode == "1" then
		return "지정가"
	elseif sCode == "2" then
		return "시장가"
	elseif sCode == "4" then
		return "LOO"
	elseif sCode == "5" then
		return "LOC"
	elseif sCode == "6" then
		return "MOO"
	elseif sCode == "7" then
		return "MOC"
	elseif sCode == "8" then
		return "Limit VWAP"
	elseif sCode == "9" then
		return "Limit TWAP"
	elseif sCode == "A" then
		return "VWAP"
	elseif sCode == "B" then
		return "TWAP"
	else
		return ""
	end

end

 --============================================================================
 -- 주문상태코드 => 주문상태명 가져오기
 --============================================================================
function GetOrderStateNameByCode(sCode)

	if sCode == "0" then
		return "정상"
	elseif sCode == "1" then
		return "거부"
	elseif sCode == "2" then
		return "자동거부"
	elseif sCode == "3" then
		return "자동취소"
	elseif sCode == "4" then
		return "미접수"
	else
		return ""
	end
	
end

 --============================================================================
 -- 미체결 종목 선택
 --============================================================================
function Grid0_OnClickUp(lRow, szCellID)

	 --v1000
	szAble = gf_Trim(Grid0.GetCellData("bd_able", lRow))	 --주문 취소가능여부: Y/N
	if szAble == "N" then
		return false
	end

	 -------------------------------------------------
	 --전체취소 체크 상태
	 -------------------------------------------------
	if chkAllCancel.checkstate == "1" then
	
		 -------------------------------------------------
		 -- 선택한 행이 체크상태이면 미체크/미체크상태이면 체크
		 -------------------------------------------------
		SetCheckReverse(lRow,szCellID)
		
		 -------------------------------------------------
		 --체크종목 개수 확인
		 -------------------------------------------------
		nCheckCnt = GetCheckNum()
		 -------------------------------------------------
		 --체크된 행의 개수에 따라 전체취소모드 설정/해제
		 -------------------------------------------------
		nRowCnt = Grid0.rowcount
 --		nRowCnt = GetCheckboxCnt()
		
		 -------------------------------------------------
		 --모든행이 체크되어있는 경우 전체취소모드 자동전환
		 -------------------------------------------------
		if nCheckCnt == nRowCnt then
			chkAllCancel.chksilence = "1"
			ChangeGridType("5")
		end
		 -------------------------------------------------
		 --모든행이 미체크되어있는 경우 전체취소모드 자동해제
		 -------------------------------------------------
		if nCheckCnt == 0 then
			chkAllCancel.chksilence = "0"
			ChangeGridType("3")
		end
		
	
	 -------------------------------------------------
	 --전체취소 미체크 상태
	 -------------------------------------------------
	else
		
		 -------------------------------------------------
		 --선택한 행 이외에 나머지 행 체크되어있다면 해제
		 -------------------------------------------------
		SetCheckExceptSelectRow(lRow,szCellID)
		
		 -------------------------------------------------
		 --체크종목 개수 확인
		 -------------------------------------------------
		nCheckCnt = GetCheckNum()
		
		 -------------------------------------------------
		 --체크된 행개수에 따른 현재화면 컨트롤 위치조정
		 -------------------------------------------------
		if nCheckCnt > 0 then
			ChangeGridType("4")
		else
			ChangeGridType("3")
		end

		 -------------------------------------------------
		 --취소 불가 주문인 경우, 밑에 로직 안타게끔
		 -------------------------------------------------
		if gOrderAble then
 --			Form.ShowAlert("알림", "이미 주문 처리되거나 예약기간이 경과하여 취소가 불가합니다.")
			gOrderAble = false
			return
		end
		
		 -------------------------------------------------
		 --메인화면에 선택한 종목정보 던지기
		 -------------------------------------------------
		sVndrCode = Grid0.GetCellData("bd_vndrcode", lRow)
		
		sMarektCode = Transform_Exid(sVndrCode)
		sCode = Grid0.GetCellData("bd_cell25", lRow) 
		sName = Grid0.GetCellData("bd_cell26", lRow)
		
		szData = sMarektCode .. "@" .. sCode .. "★" .. sName
		Form.TriggerEvent("#", "SendModCancelItem", szData)
		
		 -------------------------------------------------
		 --선택행 주문에 필요한 데이터 가져오기
		 -------------------------------------------------
		szChk = gf_Tonumber(Grid0.GetCellData("bd_cell21", lRow))
		
		if szChk == 1 then
		
			 --미체결그리드에서 넘어온 가격/수량이 클리어 되지 않도록해주는 변수
			gReturnQtyPrice = true
			
 --			'자동 수량/가격 세팅해주기 위해 일회성으로 얻어오는 값.
 --			'실제로 주문전송 시에는 컨트롤에 있는 값을 읽어와서 주문 낸다.
 --			sOrdMiChecQty	 = Grid0.GetCellData("bd_micheqty", lRow)
 --			sOrdPrice	 = Grid0.GetCellData("bd_orderprice", lRow)
			
		end
		
	
	end

	
	
end

 --============================================================================
 -- 선택행의 체크상태를 반대로 바꿔준다.
 --============================================================================
function SetCheckReverse(nRow,sCellD)
	if sCellD ~= "bd_cell21" then
	
		szChk = gf_Tonumber(Grid0.GetCellData("bd_cell21", nRow))
		szAble = gf_Trim(Grid0.GetCellData("bd_able", nRow))	 --주문 취소가능여부: Y/N

		if szChk == 1 then
			Grid0.SetCellData("bd_cell21", nRow, "0")
		else
			if szAble ~= "N" then --주문 불가면 체크안해줌
				Grid0.SetCellData("bd_cell21", nRow, "1")
			elseif szAble == "N" then --주문 불가면 알럿처리
 --				Form.ShowAlert("알림", "이미 주문 처리되거나 예약기간이 경과하여 취소가 불가합니다.")
			end
		end
	
	end
	

end
 --============================================================================
 -- 선택행 외에 체크된 행이 있다면 체크해제 / 선택행이 이미 체크되어있는 상태이면 체크해제
 --============================================================================
function SetCheckExceptSelectRow(nRow,sCellID)
	
	nRowCnt = Grid0.rowcount
	
	for i = 0, nRowCnt - 1 do

		if i ~= nRow then
			Grid0.SetCellData("bd_cell21", i, "0")
		else
		
			 --체크버튼을 직접 클릭한 경우에는 자기가 알아서 체크/체크해제 되므로
			 --toprow세팅만 해준다.
			if sCellID ~= "bd_cell21" then
		
				szChk = gf_Tonumber(Grid0.GetCellData("bd_cell21", i))
				szAble = gf_Trim(Grid0.GetCellData("bd_able", nRow))	 --주문 취소가능여부: Y/N
				
				if szChk == 1 then
					Grid0.SetCellData("bd_cell21", i, "0")
				else
					if szAble ~= "N" then --주문 불가면 체크안해줌
						Grid0.SetCellData("bd_cell21", i, "1")
						Grid0.toprow = nRow
					else
						gOrderAble = true
					end
					
				end
			else
			
				Grid0.toprow = nRow
			
			end
			
		end
	
	end


end
 --============================================================================
 -- 체크종목 개수 확인
 --============================================================================
function GetCheckNum()
	
	nRowCnt = Grid0.rowcount
	nCheckCnt = 0
	
	for i = 0, nRowCnt - 1 do
		szChk = gf_Tonumber(Grid0.GetCellData("bd_cell21", i))
		
		if szChk == 1 then
			nCheckCnt = nCheckCnt + 1
		end
		
	
	end
	
	return nCheckCnt

end

 --============================================================================
 -- 활성화 된 체크박스 개수 확인 (취소 불가 건 제외한 건수) 'v1000
 --============================================================================
function GetCheckboxCnt()
	
	nRowCnt = Grid0.rowcount
	checkboxCnt = 0
	
	for i = 0, nRowCnt - 1 do
		szChk = gf_Trim(Grid0.GetCellData("bd_able", i))
 --		if i == 2 then
 --			Form.ShowAlert("", szChk)
 --		end if
		if szChk == "Y" then
			checkboxCnt = checkboxCnt + 1
		end
		
	
	end
	
	return checkboxCnt

end
 --============================================================================
 -- 체크되어있는 인덱스 가져오기
 -- for문 돌아서 비효율적이긴한데 안전하게...
 --============================================================================
function GetCheckIndex()
	
	local nRowCnt
	nRowCnt = Grid0.rowcount
	
	for i = 0, nRowCnt - 1 do
	
		szChk = gf_Tonumber(Grid0.GetCellData("bd_cell21", i))
		
		if szChk == 1 then
			return i
		end
	end
	
	return -1

end

 --============================================================================
function chkAllCancel_OnChange(sCheckState)
	
	chkCount = GetCheckboxCnt()
	if chkCount == 0 then
 --		Form.MsgBox("알림", "취소할 내역이 없습니다.", "", 0)
		Form.ShowAlert("알림", "취소할 내역이 없습니다.")
		chkAllCancel.chksilence = "0"
		return false
	end
	
	if sCheckState == 1 or sCheckState == "1" then
		
		 ------------------------------------
		 -- 전체 미체결내역 체크
		 ------------------------------------
 --		if gOsType == "1" then
			
			nCnt = Grid0.rowcount
			
			for i = 0, nCnt - 1 do
				szAble = gf_Trim(Grid0.GetCellData("bd_able", i))	 --주문 취소가능여부: Y/N
				if szAble ~= "N" then
					Grid0.SetCellData("bd_cell21", i, "1")
				end
			end
			
 --		else
 --			Grid0.SetPropGridCell("allcheck","bd_cell21",0,"")
 --		end if
		
		 --전체취소 모드 일때는 
		 --현재화면/메인화면 선택종목 없을때 처럼 컨트롤 위치 이동
		ChangeGridType("5")
	
	else
		
		 ------------------------------------
		 -- 전체 미체결내역 체크해제
		 ------------------------------------
		if gOsType == "1" then
			
			nCnt = Grid0.rowcount
			
			for i = 0, nCnt - 1 do
				Grid0.SetCellData("bd_cell21", i, "0")
			end
			
		else
			Grid0.SetPropGridCell("alluncheck","bd_cell21",0,"")
		end
		
		
		ChangeGridType("3")
	
	end
	
end

 --============================================================================
 -- 새로고침
 --============================================================================
function imgRefresh_OnClick()
	
	 --미체결조회 서비스 호출
	RequestData()
	
	 --전체취소버튼 미체크 상태로 전환
	chkAllCancel.chksilence = "0"
	
	 --그리드상태 초기화
	ChangeGridType("3")
	Grid0.SetPropGridCell("alluncheck","bd_cell21",0,"")
	
end

