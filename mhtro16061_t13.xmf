end

 --============================================================================ 'v1000
function setLabelFilterCaption()
	local s_orderCls, s_idnt, s_selnByov
	
	-- SELECT CASE 변환 (수동 보정 필요)
		if g_orderClsCode == "0" then
			s_orderCls = "전체"
		elseif g_orderClsCode == "1" then
			s_orderCls = "일반"
		elseif g_orderClsCode == "2" then
			s_orderCls = "기간잔량"
		elseif g_orderClsCode == "3" then
			s_orderCls = "기간예약"
		elseif g_orderClsCode == "4" then
			s_orderCls = "특정일"
	end
	
	-- SELECT CASE 변환 (수동 보정 필요)
		if g_idntClcd == "0" then
			s_idnt = "처리전체"
		elseif g_idntClcd == "1" then
			s_idnt = "처리전체(취소제외)"
		elseif g_idntClcd == "2" then
			s_idnt = "예약"
	end
	
	-- SELECT CASE 변환 (수동 보정 필요)
		if g_selnByovClcd == "0" then
			s_selnByov = "매수매도"
		elseif g_selnByovClcd == "1" then
			s_selnByov = "매도"
		elseif g_selnByovClcd == "2" then
			s_selnByov = "매수"
	end
	
	LabelFilter.caption = s_orderCls .. "·" .. s_idnt .. "·" .. s_selnByov
	
end

