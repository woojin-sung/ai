 --============================================================================ 'v1000
function lblToggle_OnClick()
	if g_clsCode == "1" then
		imgToggle.imgpath = "toggle_2dots_02.9.png"
		lblToggle.caption = "예약일"
		g_clsCode = "2"
	else
		imgToggle.imgpath = "toggle_2dots_03.9.png"
		lblToggle.caption = "주문일"
		g_clsCode = "1"
	end
	
	Form.SetEnvData(1, "mhtro16061_t13_cls_code", g_clsCode)
	
 --	RequestData()
	chkToday_OnChange(g_checkToday)
end

 --============================================================================ 'v1000
function chkToday_OnChange(sCheckState)

	 -- 체크박스 직접 체크 시에만 툴팁 표시
	tooltipShowYn = "N"
	if g_checkToday ~= sCheckState then
		tooltipShowYn = "Y"
	end
	
	g_checkToday = sCheckState
	Form.SetEnvData(1, "mhtro16061_t13_check_today", sCheckState)
	
	if g_checkToday == "0" then
		contTooltip.visible = false
		Form.SetTimerEvent( 999, 0, 5 )
	
		if g_rangeDateStart == "" then
			Form.SetCtlProp("cld0", "addday", "-30")
			g_rangeDateStart = cld0.caption
		else
			cld0.caption = g_rangeDateStart
		end
		
		if g_rangeDateEnd == "" then
			cld1.caption = g_hostDate
		else
			cld1.caption = g_rangeDateEnd
		end
		g_tdayDealYn = "N"
		
		cld0.enable = true
		cld1.enable = true
	else
		if g_clsCode == "1" then
			cld0.caption = g_mangDate
			cld1.caption = g_hostDate
			g_tdayDealYn = "Y"
			
			if tooltipShowYn == "Y" then
				contTooltip.visible = true
				Form.SetTimerEvent( 999, 1, 5 )
			end
		else
			cld0.caption = g_hostDate
			cld1.caption = g_hostDate
			g_tdayDealYn = "N"
			
			contTooltip.visible = false
			Form.SetTimerEvent( 999, 0, 5 )
		end
		
		cld0.enable = false
		cld1.enable = false
		
	end
	
	RequestData()
end

 --============================================================================ 'v1000
function cld0_OnEditComplete()
 --	Grid0.rowcount = 0
 --	Grid0.SetClear()
 --	chkAllCancel.chksilence = "0"
 --	ChangeGridType("3")
	
	if cld0.caption > cld1.caption then
		cld1.caption = cld0.caption
		Form.SetSharedData("..mhtro16061_t13_range_date_end", cld1.caption)
		g_rangeDateEnd = cld1.caption
	end
	
	Form.SetSharedData("..mhtro16061_t13_range_date_start", cld0.caption)
	g_rangeDateStart = cld0.caption
	
	if g_clsCode == "1" then
		if (cld0.caption == g_mangDate) and (cld1.caption == g_hostDate) then
			chkToday.checkstate = "1"
			Form.SetEnvData(1, "mhtro16061_t13_check_today", "1")
			g_checkToday = "1"
			
			cld0.enable = false
			cld1.enable = false
			
			g_tdayDealYn = "Y"
		end
	else
		if (cld0.caption == g_hostDate) and (cld1.caption == g_hostDate) then
			chkToday.checkstate = "1"
			Form.SetEnvData(1, "mhtro16061_t13_check_today", "1")
			g_checkToday = "1"
			
			cld0.enable = false
			cld1.enable = false
			
			g_tdayDealYn = "N"
		end
	end
	
	RequestData()
	
end

 --============================================================================ 'v1000
function cld1_OnEditComplete()
 --	Grid0.rowcount = 0
 --	Grid0.SetClear()
 --	chkAllCancel.chksilence = "0"
 --	ChangeGridType("3")
	
	if cld0.caption > cld1.caption then
		cld0.caption = cld1.caption
		Form.SetSharedData("..mhtro16061_t13_range_date_start", cld0.caption)
		g_rangeDateStart = cld0.caption
	end
	
	Form.SetSharedData("..mhtro16061_t13_range_date_end", cld1.caption)
	g_rangeDateEnd = cld1.caption
	
	if g_clsCode == "1" then
		if (cld0.caption == g_mangDate) and (cld1.caption == g_hostDate) then
			chkToday.checkstate = "1"
			Form.SetEnvData(1, "mhtro16061_t13_check_today", "1")
			
			cld0.enable = false
			cld1.enable = false
			
			g_tdayDealYn = "Y"
		end
	else
		if (cld0.caption == g_hostDate) and (cld1.caption == g_hostDate) then
			chkToday.checkstate = "1"
			Form.SetEnvData(1, "mhtro16061_t13_check_today", "1")
			
			cld0.enable = false
			cld1.enable = false
			
			g_tdayDealYn = "N"
		end
	end
	
	RequestData()
	
end

