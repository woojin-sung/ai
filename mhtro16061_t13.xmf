end

 --============================================================================
function Form_OnTimerEvent(sTimerID)
	if sTimerID == "1" or sTimerID == 1 then
		Form.SetTimerEvent2(1, 0, 0.5)
		imgRefresh_OnClick()
	elseif sTimerID == "999" or sTimerID == 999 then
		contTooltip.visible = false
		Form.SetTimerEvent( 999, 0, 5 )
	end
end

