local gLoanSrno -- 대출일련번호
gLoanSrno = ""

local gReturnQtyPrice -- 미체결 그리드에서 리턴받은 가격/수량이있는지 여부
gReturnQtyPrice = false

local gSelectIndex -- 미체결 그리드에서 선택한 인덱스
gSelectIndex = -1

local gOrderReqIndex -- 1:정정/2:취소/3:전체취소 서비스 호출
gOrderReqIndex = -1

local gOsType

local gOrderAble --주문 취소가능 여부
gOrderAble = false

 --============================================================================
 -- 전체취소 관련 전역 변수
 --============================================================================
