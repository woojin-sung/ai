gOrdFailItemCnt = 0

local gOrderIndex
gOrderIndex = 0

 --============================================================================
 -- 주문/체결 탭 연동 관련 전역변수
 --============================================================================
local gbLinkMiCheItem
gbLinkMiCheItem = false

local gLinkMiCheItemInfo
gLinkMiCheItemInfo = ""

 --v1000
local g_clsCode --검색일 구분코드 1:주문일 2:예약일
local g_rangeDateStart --검색 시작일
local g_rangeDateEnd --검색 종료일
 --Dim g_orderDateStart	'검색 시작일(주문일 기준)
 --Dim g_orderDateEnd	'검색 종료일(주문일 기준)
 --Dim g_reserveDateStart	'검색 시작일(예약일 기준)
 --Dim g_reserveDateEnd	'검색 종료일(예약일 기준)
local g_checkToday --검색일 당일 체크여부
local g_orderClsCode --검색 예약유형 0:전체 1:일반예약 2:기간잔량 3:기간예약 4:특정일 (기본값 0)
local g_idntClcd --검색 처리구분 0:전체 1:전체(취소제외) 2:예약 (기본값 2)
local g_selnByovClcd --검색 매매구분 0:전체 1:매도 2:매수 (기본값 0)
local g_tdayDealYn --검색 당일매매여부
local g_mangDate --해외주식 당일 일자
local g_hostDate --호스트 일자

 --============================================================================
function Form_OnFormInitBefore()

	gOsType = Form.GetSharedData("..OS_TYPE", false)

	imgRefresh.Setmaintainingratio("1")
	imgNodata.Setmaintainingratio("1")
	imgDownArrow.SetMaintainingRatio("1")
	
end
 --============================================================================
function Form_OnFormInit()
 --	Form.SetCtlProp("cld0", "addday", "-30")
	
	 --============================================================================
	 --v1000
 --	g_clsCode = Form.GetSharedData("&mhtro16061_t13_cls_code", false)
	g_clsCode = Form.GetEnvData("mhtro16061_t13_cls_code")
	g_rangeDateStart = Form.GetSharedData("..mhtro16061_t13_range_date_start", false)
	g_rangeDateEnd = Form.GetSharedData("..mhtro16061_t13_range_date_end", false)
	g_checkToday = Form.GetEnvData("mhtro16061_t13_check_today")
	g_orderClsCode = Form.GetSharedData("..mhtro16061_t13_order_cls_code", false)
	g_idntClcd = Form.GetSharedData("..mhtro16061_t13_idnt_clcd", false)
	g_selnByovClcd = Form.GetSharedData("..mhtro16061_t13_seln_byov_clcd", false)
	g_mangDate = Form.GetSharedData("..mhtro16061_t13_mang_date", false)
	g_hostDate = Form.GetSharedData("..HOST_DATE", false)
	
	if g_clsCode == "" then
		g_clsCode = "2"
	end
	
	if g_clsCode == "1" then
		imgToggle.imgpath = "toggle_2dots_03.9.png"
		lblToggle.caption = "주문일"
	else
		imgToggle.imgpath = "toggle_2dots_02.9.png"
		lblToggle.caption = "예약일"
	end
	
	if g_checkToday == "" then
		g_checkToday = "0"
	end
	
	chkToday.checkstate = g_checkToday
	
	if g_checkToday == "0" then
		if g_rangeDateStart == "" then
			Form.SetCtlProp("cld0", "addday", "-30")
			g_rangeDateStart = cld0.caption
		else
			cld0.caption = g_rangeDateStart
		end
		
		if g_rangeDateEnd == "" then
			cld1.caption = g_hostDate
		else
			cld1.caption = g_rangeDateEnd
		end
		
		g_tdayDealYn = "N"
	
	else
		if g_clsCode == "1" then
			cld0.caption = g_mangDate
			cld1.caption = g_hostDate
			g_tdayDealYn = "Y"
		else
			cld0.caption = g_hostDate
			cld1.caption = g_hostDate
			g_tdayDealYn = "N"
		end
		cld0.enable = false
		cld1.enable = false
	end
	
	if g_orderClsCode == "" then
		g_orderClsCode = "0"
	end
	
	if g_idntClcd == "" then
		g_idntClcd = "2"
	end
	
	if g_selnByovClcd == "" then
		g_selnByovClcd = "0"
	end
	
	setLabelFilterCaption()
	
	 --============================================================================
	
	 ----------------------------------------------------
	 -- 컨트롤 설정
	 ----------------------------------------------------
	Grid0.SetUseLoadFast(true)  --iOS전용(체크이미지 변경 속도개선)
	
	szTextSize = Form.GetEnvData("common.textsize")
	
	if gf_Tonumber(szTextSize) > 0 then --큰글씨
		chkAllCancel.fontsize = - 2 - gf_Tonumber(szTextSize)
		cld0.fontsize = - 4 - gf_Tonumber(szTextSize)
		cld1.fontsize = - 4 - gf_Tonumber(szTextSize)
	end
	 ----------------------------------------------------
	 --그리드 타입 설정(디폴트:선택종목 없는 상태)
	 ----------------------------------------------------
	ChangeGridType("3")

	 ----------------------------------------------------
	 -- 주문환경설정 값 Load
	 ----------------------------------------------------
	Load_OrderSet()
	
	 ----------------------------------------------------
	 -- 미체결 내역 조회
	 ----------------------------------------------------
	RequestData()
	
end

 --============================================================================
function Form_OnTriggerEvent(sEventName, sParam)
	 --Form.ShowAlert(sEventName, sParam)
	 --============================================================================
	 -- 종목정보 연동
	 --============================================================================
	if sEventName == "SEND_ITEM_INFO" then
	
		 -------------------------------------------------------------------------
		 --현재가★상한가★하한가★매매단위★통화★소수점자리수★한글종목명★틱타입
		 -------------------------------------------------------------------------
		arrItemInfo = gf_Split(sParam, "★")
		
		g_szCurPrice 	= arrItemInfo[0+1]
		g_szUpLimit	= arrItemInfo[1+1]
		g_szDnLimit	= arrItemInfo[2+1]
		g_szOrdSize 	= arrItemInfo[3+1]
		g_szCurrency	= arrItemInfo[4+1]
		g_szDecimal	= arrItemInfo[5+1]
		g_szKorName	= arrItemInfo[6+1]
		g_szTickType	= arrItemInfo[7+1]
 --		g_szUnit		= GetHogaUnit(g_szMk, g_szCurPrice, 0)	'20250421 HSZ : 안써는 로직 삭제
		
		 -------------------------------------------------------------------------
		 --종목/탭 변경시 가격입력창/수량입력창 입력값 초기화 
		 -------------------------------------------------------------------------
		if g_szChangeInit == "1" then
			Init_InputControl()
		end
	
	 --============================================================================
	 -- 종목코드 초기화/종목코드 변경/탭 변경
	 --============================================================================
	elseif sEventName == "InitCode" or sEventName == "ChangeCode" or sEventName == "ChangeTab" then
		
		if g_szCd ~= sParam then
			
			g_szCd = sParam
			g_szNg = Form.GetItemCodeInfo(g_szCd, "ovsnation")	 -- 국가구분코드
			g_szMk = Form.GetItemCodeInfo(g_szCd, "exchid")		 -- 거래소벤더코드
			
			 -----------------------------------------------------------------------------------
			 --환율정보 라벨 클리어(이전 데이터 남아있어 깜빡임 방지)
			 -----------------------------------------------------------------------------------
			
			if sEventName == "ChangeTab" then
				
				 -----------------------------------------------------------------------------------
				 -- [금액 자동입력]
				 -----------------------------------------------------------------------------------
				 -- 현재가 호가테이블에서 진입 :  현재가 화면에서 선택한 호가 세팅
				 -- 그 외 진입 : 종목/탭 변경 시 초기화 설정이 꺼져있는 경우 설정한 자동가격으로 세팅
				 -----------------------------------------------------------------------------------
				 --sPrice = Form.GetSharedData("PRICE", true)
				 --
				 --if sPrice <> "" and sPrice <> null	then
				 --	edtPrc.caption = sPrice
				 --	
				 --else
				 --	
				 --	if g_szChangeInit <> "1" then
				 --		RequestAutoPrice()
				 --	end if
				 --
				 --end if
				
				 ----------------------------------------------------
				 -- 미체결 내역 조회
				 ----------------------------------------------------
				RequestData()
							
			end
			
		
		else
		
			 -----------------------------------------------------------------------------------
			 -- 정정/취소 탭에 위치한 상태에서 다시 정정/취소 탭 눌렀을때, 
			 -- 종목코드는 그대로지만 그리드 타입 초기화
			 -----------------------------------------------------------------------------------
			if sEventName == "ChangeTab" then
				 --전체취소버튼 미체크 상태로 전환
				chkAllCancel.chksilence = "0"
				
				 --그리드상태 초기화
				ChangeGridType("3")
				Grid0.SetPropGridCell("alluncheck","bd_cell21",0,"")
				
				 ----------------------------------------------------
				 -- 미체결 내역 조회
				 ----------------------------------------------------
				RequestData()
				
			end
			
		end

		
	 --============================================================================
	 -- 계좌변경(통합증거금 약정여부 조회 및 입력창 초기화)
	 --============================================================================	
	elseif sEventName == "ChangeAcnt" then
		imgRefresh_OnClick()
		
		if g_szChangeInit == "1" then
			Init_InputControl()
		end
		
	 --============================================================================
	 -- 주문/체결 탭에서 미체결수량이 있는 종목 선택 시 연동
	 --============================================================================
	elseif sEventName == "SendMiChegyulItem" then
		
		 ------------------------------------------------------------------------------------------
		 --Init_InputControl() 		: gReturnQtyPrice가 true 일떄 입력창 클리어안함
		 --obtro_oder_103r Complete 	: gbLinkMiCheItem가 true 일때 입력창 클리어 안함.
		 ------------------------------------------------------------------------------------------
		 --입력창 클리어해주는 부분이 호출되는 시점이 랜덤이라.. 둘다 true로 변환하여
		 --입력창이 클리어되지 않고, 주문/체결탭에서 넘어온 미체결종목의 수량/가격이 세팅되게한다.
		 ------------------------------------------------------------------------------------------
		gReturnQtyPrice = true
		gbLinkMiCheItem = true
		
		 ----------------------------------------------------
		 -- 미체결 종목정보
		 ----------------------------------------------------
		gLinkMiCheItemInfo = sParam	
		
		 ----------------------------------------------------
		 --전체취소버튼 미체크 상태로 전환
		 ----------------------------------------------------
		chkAllCancel.chksilence = "0"
	
		 ----------------------------------------------------
		 --그리드 체크 모두 해제
		 ----------------------------------------------------
		Grid0.SetPropGridCell("alluncheck","bd_cell21",0,"")
		
		 ----------------------------------------------------
		 -- 미체결 내역 조회
		 ----------------------------------------------------
		RequestData()
		
	 --============================================================================
	 -- 약정 계좌 > 미약정 계좌로 변경 시 데이터 클리어를 위해 호출
	 --============================================================================
	elseif sEventName == "ClearData" then
		
		imgRefresh_OnClick()
		
	 --============================================================================
	 -- 비밀번호 검증 후 주문확인창 자동 오픈
	 --============================================================================
	elseif sEventName == "OPEN_CONFIRM" then
		
		if gOrderReqIndex == 2 then
			btnCancel_OnClick()
		elseif gOrderReqIndex == 3 then
			btnAllCancel_OnClick()
		end
		
	 --주문번호 연동 => 원주문번호만으로 주문가능? 주문일자 반드시 넣어줘야하면 무쓸모임
	elseif sEventName == "AFTER_ORGNO" then
		
	end
	
end


 --============================================================================
 -- (가격)자동입력값 요청
 --============================================================================
function RequestAutoPrice()
	
	Form.TriggerEvent("#", "RequestAutoPrice", "%")

end

 --============================================================================
 -- (가격/수량)입력창 입력값 초기화
 --============================================================================
function Init_InputControl()
	
	if g_szChangeInit == "1" then
		
		 ------------------------------------------------------
		 -- 미체결 그리드에서 종목선택한 경우 gReturnQtyPrice = true
		 -- gReturnQtyPrice == true인 경우에는 미체결그리드에서 넘어온
		 -- 미체결수량/주문가격이 입력창에 세팅될 수 있도록 
		 -- 입력창 클리어해주지 않음.
		 --
		 -- 주문/체결탭에서 종목 선택한 경우 gbLinkMiCheItem = true
		 -- gbLinkMiCheItem == true인 경우에는 주문/체결탭에서 넘어온
		 -- 미체결수량/주문가격이 입력창에 세팅될 수 있도록
		 -- 입력창 클리어해주지 않음.
		 ------------------------------------------------------
		if gReturnQtyPrice == true then
			gReturnQtyPrice = false
		
		else
			gReturnQtyPrice = false
		end
		
	end
	
end

 --============================================================================
 -- (공통) 주문 환경설정값 적용
 --============================================================================
function Load_OrderSet()
	
	g_szOdrPop     = Form.LoadConfigData("SET_ORDER", "OPEN_CONFIRM")			 -- 주문확인창
	g_szAfterInit  = Form.LoadConfigData("SET_ORDER", "AFERTORD_INIT")			 -- 주문전송 후 초기화
	g_szChangeInit = Form.LoadConfigData("SET_ORDER", "CHANGE_INIT")			 -- 종목/탭 변경시 초기화
	g_szAfterOrg   = Form.LoadConfigData("SET_ORDER", "AUTO_ORGNO")				 -- 원주문번호 자동입력
	
	g_szSellQty     = Form.LoadConfigData("SET_ORDER", "AUTO_STOCK_SELQTY")		 -- 매도수량 자동입력(0:미사용, 1:현금가능수량, 2:최대가능수량(미수포함), 3:수량입력
	g_szSellQtyCnt  = Form.LoadConfigData("SET_ORDER", "AUTO_STOCK_SELQTYCNT")	 -- 매도수량 주수(수량입력 선택시)
	
	 ----------------------------------------------
	 -- 주문확인창(기본값 : 사용)
	 ----------------------------------------------
	if gf_Trim(g_szOdrPop) == "" then
		g_szOdrPop = "1"
	end
	
	 ----------------------------------------------
	 -- 주문전송 후 초기화(기본값 : 사용)
	 ----------------------------------------------
	if gf_Trim(g_szAfterInit) == "" then
		g_szAfterInit = "1"
	end
	
	 ----------------------------------------------
	 --종목/탭 변경시 초기화 사용을 초기값으로 설정
	 --종목/탭 변경시 초기화(기본값 : 사용)
	 ----------------------------------------------
	if gf_Trim(g_szChangeInit) == "" then
		g_szChangeInit = "1"
	end

	 ----------------------------------------------
	 -- 원주문번호 자동입력(기본값 : 사용)
	 ----------------------------------------------
	if gf_Trim(g_szAfterOrg) == "" then
		g_szAfterOrg = "1"
	end
	
	 ----------------------------------------------
	 -- 매수수량 자동입력(기본값 : 사용하지 않음)
	 ----------------------------------------------
	if gf_Trim(g_szSellQty) == "" then
		g_szSellQty = "0"		
	end
	
end


 --============================================================================
function DATAMANAGER_OnSendTranBefore(szTranID)

	 ------------------------------------------------------------
	 --취소 주문용
	 ------------------------------------------------------------
	if szTranID == "obtro_oder_113a" then
		
		g_szTR = szTranID
		
		nSelectIndex = GetCheckIndex()
		
		szOrdDate = Grid0.GetCellData("bd_cell1", nSelectIndex)
		szOrdOrgnNo = Grid0.GetCellData("bd_cell11", nSelectIndex)
		
		szAcno = Form.GetTopCtlProp("acnt", "total")
		szAsno = Form.GetTopCtlProp("acnt", "sequence")
		szAcpw = Form.GetTopCtlProp("edtPwd", "caption")
		
		DATAMANAGER.ClearInputData(0, "obtro_oder_113a")
		
		DATAMANAGER.SetDataValue(0, "obtro_oder_113a", "InBlock1", "ACNO"					, 0, szAcno)		 -- 계좌번호(8)
		DATAMANAGER.SetDataValue(0, "obtro_oder_113a", "InBlock1", "ASNO"					, 0, szAsno)		 -- 계좌일련번호(2)
		DATAMANAGER.SetDataValue(0, "obtro_oder_113a", "InBlock1", "ACNT_PWD"				, 0, szAcpw)		 -- 계좌 비밀번호
		
		DATAMANAGER.SetDataValue(0, "obtro_oder_113a", "InBlock1", "ODER_RSEV_MST_DATE"		, 0, szOrdDate)	 -- 주문예약마스터일자
		DATAMANAGER.SetDataValue(0, "obtro_oder_113a", "InBlock1", "ODER_RSEV_MST_NO"			, 0, szOrdOrgnNo)	 -- 주문예약마스터번호
		
	end
	
end
 --============================================================================
function DATAMANAGER_OnReceiveTranComplete(szTranID)
	
	 --==========================================================================
	 -- 취소 주문용(113a)
	 --==========================================================================
	if szTranID == "obtro_oder_113a" then
	
		szWarnCd  = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "WARN_CLS_CODE", 0)  --경고구분코드 (0.정상, 1.경고, 2.보류)
		szWarnMsg = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "UI_MSG_CNTT"  , 0)
	
		 ----------------------------------
		 -- 경고
		 ----------------------------------
		if szWarnCd == "1" then
		
			Open_ConfirmPopup(szWarnMsg)
		
		 ----------------------------------
		 -- 보류(해외주식 제외)
		 ----------------------------------
		elseif szWarnCd == "2" then --
			
			g_szTR = ""
		
		 ----------------------------------
		 -- 정상주문 처리
		 ----------------------------------
		else
		
			g_szTR = ""
				
			szOrdCd  = DATAMANAGER.GetDataMsgCode(szTranID)
			szOrdMsg = DATAMANAGER.GetDataMsgText(szTranID)
	
			 -------------------------------
			 -- 정상주문
			 -------------------------------
			
			if gf_Trim(szOrdCd) == "0000" then
				
				 -------------------------------
				 -- 주문처리 메시지 출력
				 -------------------------------
				Form.Toast(0, szOrdMsg, true)
				
				 -------------------------------
				 -- 주문후 초기화
				 -------------------------------
				if g_szAfterInit == "1" then
					Init_InputControl()
				end
				
				 -------------------------------
				 -- 주문번호 연동
				 -------------------------------
				if g_szAfterOrg == "1" then
					szOrgNo = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "ODER_NO", 0)
					Form.TriggerEvent("#", "AfterOrd", szOrgNo)
				end
				
				 -------------------------------
				 -- 정정/취소 주문 후 미체결내역 재조회
				 -------------------------------
				Form.SetTimerEvent2(1, 1, 0.5)
				 --imgRefresh_OnClick()
					
			end
			
		end
		
	
	 --==========================================================================
	 -- 일괄취소 주문용(113a_1)
	 --==========================================================================
	elseif szTranID == "obtro_oder_113a_1" then
	
		szWarnCd  = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "WARN_CLS_CODE", 0)  --경고구분코드 (0.정상, 1.경고, 2.보류)
		szWarnMsg = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "UI_MSG_CNTT"  , 0)
		
		 ----------------------------------
		 -- 경고
		 ----------------------------------
		if szWarnCd == "1" then
		
			Open_ConfirmPopup(szWarnMsg)
		
		 ----------------------------------
		 -- 보류(해외주식 제외)
		 ----------------------------------
		elseif szWarnCd == "2" then --
			
			g_szTR = ""
			
		 ----------------------------------
		 -- 정상주문 처리
		 ----------------------------------
		else
		
			g_szTR = ""
			
			 ------------------------------------
			 --남은 주문건수 -1
			 ------------------------------------
			gRemainItemCnt = gRemainItemCnt - 1
			
			 ------------------------------------
			 --남은 건수가 0건이면 주문완료
			 ------------------------------------
			if gRemainItemCnt == 0 then
			
				 ----------------------------------------
				 --주문전송에 실패한 건수가 있는지 체크
				 ----------------------------------------
				
				 --실패건수가 없을 때
				if gOrdFailItemCnt == 0 then
 --					Form.ShowAlert("알림", "주문이 취소되었습니다. 주문/체결내역에서 주문결과를 확인하시기 바랍니다.")
					Form.Toast(0, "정상 처리 되었습니다.", true)  --v1000
				
				 --모두 실패했을 때
				elseif gCanCelItemCnt == gOrdFailItemCnt then
					Form.ShowAlert("알림", "취소가 불가합니다. 주문/체결내역에서 주문결과를 확인하시기 바랍니다.")
				
				 --일부만 실패했을 때
				else
					Form.ShowAlert("알림", "주문이 일부만 취소되었습니다. 주문/체결내역에서 주문결과를 확인하시기 바랍니다.")
				end
				
				gCanCelItemCnt = -1
				gOrdFailItemCnt = 0
				gOrderIndex  = 0
				gCanCelFirstItem = true
				
				 ----------------------------------------
				 -- 일괄취소 후 미체결내역 재조회
				 ----------------------------------------
				Form.SetTimerEvent2(1, 1, 0.5)
				 --imgRefresh_OnClick()
				
				
			else
			
				Request_OrderAllCancel()
			
			end
			
		
		end

	 --==========================================================================
	 -- 미체결내역 조회
	 --==========================================================================
	elseif szTranID == "obtro_oder_114r" then
		
		if DATAMANAGER.IsMoreNextData("obtro_oder_114r") then
			DATAMANAGER.RequestNextData("obtro_oder_114r")
		else
			nDataCnt = gf_Tonumber(Grid0.rowcount)
			
			if nDataCnt == 0 then
				
				 --데이터없음 이미지/라벨 표시
				imgNodata.left = 162
				lblNodata.left = 0
				imgNodata.visible = true
				lblNodata.visible = true
				
				 --호가테이블 숨기기
				ChangeGridType("3")
				
				 --전체취소버튼 비활성화
				chkAllCancel.enable = false
				
			else
				imgNodata.left = 500
				lblNodata.left = 500
				imgNodata.visible = false
				lblNodata.visible = false
				
				 --전체취소버튼 활성화
				chkAllCancel.enable = true
				
			end
		
			 --------------------------------------------------------------
			 -- 종목명 최대라인수 설정
			 --------------------------------------------------------------
			Grid0.SetCellMaxLineCount("bd_cell26",2)
			Grid0.SetCellMaxLineCount("bd_cell25",2)
			
			for i = 0, Grid0.rowcount - 1 do
			
				 --------------------------------------------------------------
				 -- 현금/대출 구분
				 --------------------------------------------------------------
				sCashCredit = Grid0.GetCellData("bd_loantype", i)

				if sCashCredit == "0251" then
					Grid0.SetCellData("bd_cell24", i, "대출")
					Grid0.SetCellData("bd_cell240", i, "대출")
				else
					Grid0.SetCellData("bd_cell24", i, "현금")
					Grid0.SetCellData("bd_cell240", i, "현금")
				end
				
				 --------------------------------------------------------------
				 --매매구분
				 --------------------------------------------------------------
				szType    = Grid0.GetCellData( "bd_cell6"	, i)	 --매매구분
				-- SELECT CASE 변환 (수동 보정 필요)
					if szType == "1" then
						Grid0.SetCellFgColor( "bd_cell2", i, "2" )
						Grid0.SetCellFgColor( "bd_cell20", i, "2" )
						 --v1000 ------------------------ 예탁담보매도 -> 매도로 표시
 --						szGubun = Grid0.GetCellData("bd_loantype", i)
 --						
 --						if szGubun = "0251" then
 --							Grid0.SetCellData( "bd_cell2", i, "예탁담보매도" )
 --							Grid0.SetCellData( "bd_cell20", i, "예탁담보매도" )
 --						else
 --							Grid0.SetCellData( "bd_cell2", i, "매도" )
 --							Grid0.SetCellData( "bd_cell20", i, "매도" )
 --						end if
						
						Grid0.SetCellData( "bd_cell2", i, "매도" )
						Grid0.SetCellData( "bd_cell20", i, "매도" )
						 --v1000 ------------------------
					elseif szType == "2" then
						Grid0.SetCellFgColor( "bd_cell2", i, "1" )
						Grid0.SetCellFgColor( "bd_cell20", i, "1" )
						Grid0.SetCellData( "bd_cell2", i, "매수")
						Grid0.SetCellData( "bd_cell20", i, "매수")
				end
				
				 --------------------------------------------------------------
				 --주문예약구분코드
				 --------------------------------------------------------------
				rSevType  = Grid0.GetCellData( "bd_cell8"	, i)
				-- SELECT CASE 변환 (수동 보정 필요)
					if rSevType == "1" then
						Grid0.SetCellData( "bd_cell8", i, "일반예약")
					elseif rSevType == "2" then
						Grid0.SetCellData( "bd_cell8", i, "기간잔량")
					elseif rSevType == "3" then
						Grid0.SetCellData( "bd_cell8", i, "기간예약")
					elseif rSevType == "4" then
						Grid0.SetCellData( "bd_cell8", i, "특정일주문")
				end
				
				 --------------------------------------------------------------
				 --주문예약시간구분코드
				 --------------------------------------------------------------
				hOurType  = Grid0.GetCellData( "bd_cell18", i)	 --주문예약시간구분코드
				-- SELECT CASE 변환 (수동 보정 필요)
				if hOurType == "0" then
					Grid0.SetCellData( "bd_cell18", i, "장개시")
				elseif hOurType == "1" then
					Grid0.SetCellData( "bd_cell18", i, "장마감10분전")
				elseif hOurType == "2" then
					Grid0.SetCellData( "bd_cell18", i, "장마감30분전")
				elseif hOurType == "3" then
					Grid0.SetCellData( "bd_cell18", i, "장개시30분후")
				end
				
				 --------------------------------------------------------------
				 --시장구분
				 --------------------------------------------------------------
				sCountryCode = Grid0.GetCellData("bd_mrktcode", i)
				sVndrCode = Grid0.GetCellData("bd_vndrcode", i)
				sCountryName = GetCountryNameByCode(sCountryCode,sVndrCode)
				Grid0.SetCellData("bd_marketgubun", i, sCountryName)
				
				 --------------------------------------------------------------
				 --주문구분
				 --------------------------------------------------------------
				sOrderCode = Grid0.GetCellData("bd_cell22", i)
				sOrderName = GetOrderNameByCode(sOrderCode)
				Grid0.SetCellData("bd_cell12", i, sOrderName)
				
				 --------------------------------------------------------------
				 --주문구분
				 --------------------------------------------------------------
				szAble = gf_Trim(Grid0.GetCellData("bd_able", i))	 --주문 취소가능여부: Y/N
				if szAble == "N" then
					Grid0.SetCellEnable("bd_cell21", i, "0")
					Grid0.SetCellVisible("bd_cell21", i, false)
				else
					Grid0.SetCellEnable("bd_cell21", i, "1")
					Grid0.SetCellVisible("bd_cell21", i, true)
				end
				
				 --------------------------------------------------------------
				 --처리구분
				 --------------------------------------------------------------
				szResult = Grid0.GetCellData("bd_cell5", i)
				-- SELECT CASE 변환 (수동 보정 필요)
				if szResult == "1" then
					Grid0.SetCellData( "bd_result", i, "예약")
				elseif szResult == "2" then
					Grid0.SetCellData( "bd_result", i, "발주완료")
				elseif szResult == "3" then
					Grid0.SetCellData( "bd_result", i, "기간발주")
				elseif szResult == "4" then
					Grid0.SetCellData( "bd_result", i, "취소")
				end
			
			end
		end
	end
	
	 --해외주식 주문착오 방지
	g_szWarnFlag = "N"	
	
end

 --============================================================================
 -- 서비스 오류처리
 --============================================================================
function DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	
	local szSubMsg
	szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	
	if szTranID == "obtro_oder_113a_1" then
	
		
		g_szTR = ""
			
		 ------------------------------------
		 --남은 주문건수 -1
		 ------------------------------------
		gRemainItemCnt = gRemainItemCnt - 1
		gOrdFailItemCnt = gOrdFailItemCnt + 1
		
		 ------------------------------------
		 --남은 건수가 0건이면 주문완료
		 ------------------------------------
		if gRemainItemCnt == 0 then
		
			 ----------------------------------------
			 --주문전송에 실패한 건수가 있는지 체크
			 ----------------------------------------
			
			 --실패건수가 없을 때
			if gOrdFailItemCnt == 0 then
				Form.ShowAlert("알림", "주문이 취소되었습니다. 주문/체결내역에서 주문결과를 확인하시기 바랍니다.")
			
			 --모두 실패했을 때
			elseif gCanCelItemCnt == gOrdFailItemCnt then
				Form.ShowAlert("알림", "취소가 불가합니다. 주문/체결내역에서 주문결과를 확인하시기 바랍니다.")
			
			 --일부만 실패했을 때
			else
				Form.ShowAlert("알림", "주문이 일부만 취소되었습니다. 주문/체결내역에서 주문결과를 확인하시기 바랍니다.")
			end
			
			gCanCelItemCnt = -1
			gOrdFailItemCnt = 0
			gOrderIndex  = 0
			gCanCelFirstItem = true
			
			 ----------------------------------------
			 -- 일괄취소 후 미체결내역 재조회
			 ----------------------------------------
			Form.SetTimerEvent2(1, 1, 0.5)
			 --imgRefresh_OnClick()
			
		else
		
			Request_OrderAllCancel()
		
		end
	
	
	else
		
 --		'------------------------------------------------------------------
 --		' 해외ETP 미약정 고객
 --		'------------------------------------------------------------------
 --		if szErrCode == "6207" then
 --			
 --			Form.MsgBox("안내", "해외ETP 거래 미신청 계좌 입니다.\n해당 화면으로 이동하시겠습니까?", "ETP_MSG", 7, "거래신청하기","취소")
 --		
 --		'------------------------------------------------------------------
 --		' 대출주문 대출일자/대출일련번호 미입력 시
 --		'------------------------------------------------------------------
 --		elseif szErrCode == "1256" or szErrCode == "1258" then
 --			
 --			Form.ShowAlert("안내", "대출일자 선택 후 주문이 가능해요.\n잔고에서 매도할 종목 선택 후 매도를 진행해주세요.")
		
		 --------------------------------------------------------------------
		 -- 그외
		 --------------------------------------------------------------------
 --		else
			if gf_Trim(szSubMsg) ~= "" then
				Form.ShowAlert(g_szTitle, szErrMsg .. "(" .. szSubMsg .. ")")
			else
				Form.ShowAlert(g_szTitle, szErrMsg)
			end
		end
		
 --	end if
	
end

 --============================================================================
 -- 메시지박스 리턴
 --============================================================================
function Form_OnMsgBoxClose(sKeyName, sRet)

	if sKeyName == "ETP_MSG" then
		
		if sRet == "ok" then
			Form.OpenScreen("87051" , "")
		end
	
	end
	
end

 --============================================================================
 -- 취소버튼 클릭
 --============================================================================
function btnCancel_OnClick()

	gOrderReqIndex = 2
	
	if Check_InputData("Order") == true then
		
		 -- 주문확인창 오픈여부
		if g_szOdrPop == "1" then
			Open_ConfirmPopup("")
		else
			Request_Order()
		end
		
	end

	
	
end

 --============================================================================
 -- 전체취소 버튼
 --============================================================================
function btnAllCancel_OnClick()

	gOrderReqIndex = 3
	
	if Check_InputData("ALL_CANCEL") == true then
		
		 -- 주문확인창 오픈여부
		if g_szOdrPop == "1" then
			Open_ConfirmPopup("")
		else
			Request_OrderAllCancel()
		end
		
	end
	
end

 --============================================================================
 -- 주문전송 전 입력값 정합성 검증
 --============================================================================
function Check_InputData(sGubun)
	if sGubun == "Order" then
		 -------------------------------------------------------------------
		 --종목코드
		 -------------------------------------------------------------------
		if gf_Trim(g_szCd) == "" then
			Form.ShowAlert(g_szTitle, "종목코드를 입력하십시요.")
			return false
		end
	elseif sGubun == "ALL_CANCEL" then
	
		nCheckNum = GetCheckNum()
		
		if nCheckNum <= 0 then
			Form.MsgBox("안내", "일괄취소할 주문을 선택해주세요.", "CHECK_ALL_CANCEL", 6)
			return false
		end
		
	end

	 -------------------------------------------------------------------
	 --계좌번호
	 -------------------------------------------------------------------
	szAcnt = Form.GetTopCtlProp("acnt", "caption")
	if string.len(szAcnt) < 10 then
		Form.ShowAlert(g_szTitle, "계좌번호를 확인후 다시 입력하십시오.")
		return False
	end
	
	 -------------------------------------------------------------------
	 --계좌비밀번호
	 -------------------------------------------------------------------
	szPwd = Form.GetTopCtlProp("edtPwd", "caption")
	if gf_Trim(szPwd) == "" then
		Form.TriggerEvent("#", "ShowPasswordKeyPad", "")
		return False
	end
	
	return true
	
 --	if sGubun == "Order" then
 --		
