function Init_Control()
	contClick.lblClick0.fgcolor = g_szTxtColor_Grey
	contClick.lblClick1.fgcolor = g_szTxtColor_Grey
	contClick.lblClick2.fgcolor = g_szTxtColor_Grey
	
	contClick.lblGuide0.bgcolor = g_szTxtColor_Grey
	contClick.lblGuide1.bgcolor = g_szTxtColor_Grey
	
	imgRefresh.maintainratio = "1"
	imgRefresh.imgpath = "icon_refresh"
	
	szData = Form.GetEnvData("OVRS_JANGO_STANDARD_GBN")
	
	if szData ~= "" and szData ~= nil then
		g_nViewMode = gf_Tonumber(szData)
		
		if g_nViewMode == 1 then
			contBody.imgToggle.imgpath = "toggle_2dots_03.9.png"
			contBody.lblToggle.caption = "원화"
		else
			contBody.imgToggle.imgpath = "toggle_2dots_02.9.png"
			contBody.lblToggle.caption = "외화"
		end
	end
	
	contBody.gesture = true
	contBody2.gesture = true
	
	szReal = Form.GetEnvData("OVRS_REAL_JANGO")
	if szReal == "" then
		Form.SetEnvData("1", "OVRS_REAL_JANGO", "1")
		szReal = "1"
	end

	if szReal == "1" then
		g_isReal = true
	else
		g_isReal = false
	end
	
	g_szSortIdx = gf_Tonumber(Form.GetEnvData("OVRS_JANGO_SORT_IDX"))
	g_szSortHeader = Form.GetEnvData("OVRS_JANGO_SORT_HEADER")
	
	if g_szSortHeader == "" then
		g_szSortHeader = "th_cell01"
		g_szSortIdx = 2
		Form.SetEnvData(1, "OVRS_JANGO_SORT_HEADER", g_szSortHeader)
		Form.SetEnvData(1, "OVRS_JANGO_SORT_IDX", g_szSortIdx)
	end
	

	szDetail = Form.GetEnvData("OVRS_JANGO_TOP_EXPAND")
	if szDetail == "" then
		Form.SetEnvData("1", "OVRS_JANGO_TOP_EXPAND", "1")
		szDetail = "1"
	end

	if szDetail == "1" then
		g_bTopDetail = true
	else
		g_bTopDetail = false
	end
	
	 --20241125_01 HWG START
	lblTot.paddinginfo = "0,0,0,0"
	lblTot0.paddinginfo = "0,0,0,0"
	
	lblTop0.paddinginfo = "0,0,0,0"
	lblTop1.paddinginfo = "0,0,0,0"
	lblTop2.paddinginfo = "0,0,0,0"
	lblTop3.paddinginfo = "0,0,0,0"
	lblTop4.paddinginfo = "0,0,0,0"
	lblTop5.paddinginfo = "0,0,0,0"
	lblTop6.paddinginfo = "0,0,0,0"
	lblTop7.paddinginfo = "0,0,0,0"
	
	lblTop10.paddinginfo = "0,0,0,0"
	lblTop11.paddinginfo = "0,0,0,0"
	lblTop12.paddinginfo = "0,0,0,0"
	lblTop13.paddinginfo = "0,0,0,0"	 --v20251001_01
	lblTop14.paddinginfo = "0,0,0,0"
	lblTop16.paddinginfo = "0,0,0,0"
	lblTop17.paddinginfo = "0,0,0,0"
	 --20241125_01 HWG END

	if g_isReal == true then
		contBody.chk0.checkstate = 0
		Form.SetEnvData("1", "OVRS_JANGO_CHK_1", "0")
		contBody.chk0.visible = false
		
		contBody.chk1.left = 10
		contBody.chk2.left = 100
	else
		contBody.chk0.visible = true
		
		contBody.chk1.left = 100
		contBody.chk2.left = 190
	end
	
	g_szDytmYN = "Y"
	
	szChk1 =  Form.GetEnvData("OVRS_JANGO_CHK_1")
	szChk2 =  Form.GetEnvData("OVRS_JANGO_CHK_2")
	szChk3 =  Form.GetEnvData("OVRS_JANGO_CHK_3")
	
	contBody.chk0.checkstate = szChk1
	contBody.chk1.checkstate = szChk2
	contBody.chk2.checkstate = szChk3

	contBody2.grdDeposit.visible = False
	contBody2.Pannel0.visible = True
	
	g_nNextIdx = 0
	g_nGridIndex = 0 
	contBody2.Pannel0.rowcount = 0
	
	contBody2.imgNoData.visible = false
	contBody2.lblNoData.visible = false
	
	contBody.imgNoData.visible = false
	contBody.lblNoData.visible = false
	
	nWidth = Form.GetTextWidth(contBody2.lblTitle.caption, 0, true, false)
	contBody2.imgTooltip.left = 10 + nWidth + 7
	
	contBody.grd0.SetEnableScroll(false)
	contBody2.grdDeposit.SetEnableScroll(false)
	contBody2.Pannel0.SetEnableScroll(false)
	
	contBody2.lblGuideLine0.bgcolor = "220220220"
	
	 --20241216 SWJ START
	 --다크모드 적용
	g_szTheme = Form.GetEnvData("common.theme")
	
	if g_szTheme == "black" then
		contBody2.lblGuideLine0.bgcolor = "153153153"
	end
	 --20241216 SWJ END
	
end

function DisplaySetting_Grid()
	sMaskInfo_1 = ""
	sMaskInfo_2 = ""
	
	 --20241112 SWJ START
	sMaskInfo_3 = ""
	 --20241112 SWJ END
	
	if g_nViewMode == 1 then
		sMaskInfo_1 = sMaskInfo_1 .. "0,"	 --숫자:0 문자:1
		sMaskInfo_1 = sMaskInfo_1 .. "1,"	 --0 보이지 않기 
		sMaskInfo_1 = sMaskInfo_1 .. ","		 --앞첨자
		sMaskInfo_1 = sMaskInfo_1 .. ","		 --뒷첨자
		sMaskInfo_1 = sMaskInfo_1 .. "0,"	 --문자열 마스크
		sMaskInfo_1 = sMaskInfo_1 .. ","		 --문자열 마스크
		sMaskInfo_1 = sMaskInfo_1 .. "0,"	 --소숫점 자릿수
		sMaskInfo_1 = sMaskInfo_1 .. "1,"	 --천단위 부호
		sMaskInfo_1 = sMaskInfo_1 .. "1"		 --마이너스 부호 
		
		sMaskInfo_2 = sMaskInfo_2 .. "0,"	 --숫자:0 문자:1
		sMaskInfo_2 = sMaskInfo_2 .. "1,"	 --0 보이지 않기 
		sMaskInfo_2 = sMaskInfo_2 .. ","		 --앞첨자
		sMaskInfo_2 = sMaskInfo_2 .. ","		 --뒷첨자
		sMaskInfo_2 = sMaskInfo_2 .. "0,"	 --문자열 마스크
		sMaskInfo_2 = sMaskInfo_2 .. ","		 --문자열 마스크
		sMaskInfo_2 = sMaskInfo_2 .. "0,"	 --소숫점 자릿수
		sMaskInfo_2 = sMaskInfo_2 .. "1,"	 --천단위 부호
		sMaskInfo_2 = sMaskInfo_2 .. "1"		 --마이너스 부호 
		
		 --20241112 SWJ START
		 --매수/매도 수수료 0 보임 처리를 위해 마스킹 변수 한개 더 추가
		sMaskInfo_3 = sMaskInfo_3 .. "0,"	 --숫자:0 문자:1
		sMaskInfo_3 = sMaskInfo_3 .. "0,"	 --0 보이지 않기 
		sMaskInfo_3 = sMaskInfo_3 .. ","		 --앞첨자
		sMaskInfo_3 = sMaskInfo_3 .. ","		 --뒷첨자
		sMaskInfo_3 = sMaskInfo_3 .. "0,"	 --문자열 마스크
		sMaskInfo_3 = sMaskInfo_3 .. ","		 --문자열 마스크
		sMaskInfo_3 = sMaskInfo_3 .. "0,"	 --소숫점 자릿수
		sMaskInfo_3 = sMaskInfo_3 .. "1,"	 --천단위 부호
		sMaskInfo_3 = sMaskInfo_3 .. "1"		 --마이너스 부호 
		 --20241112 SWJ END
	else
		sMaskInfo_1 = sMaskInfo_1 .. "0,"	 --숫자:0 문자:1
		sMaskInfo_1 = sMaskInfo_1 .. "1,"	 --0 보이지 않기 
		sMaskInfo_1 = sMaskInfo_1 .. ","		 --앞첨자
		sMaskInfo_1 = sMaskInfo_1 .. ","		 --뒷첨자
		sMaskInfo_1 = sMaskInfo_1 .. "0,"	 --문자열 마스크
		sMaskInfo_1 = sMaskInfo_1 .. ","		 --문자열 마스크
		sMaskInfo_1 = sMaskInfo_1 .. "4,"	 --소숫점 자릿수
		sMaskInfo_1 = sMaskInfo_1 .. "1,"	 --천단위 부호
		sMaskInfo_1 = sMaskInfo_1 .. "1"		 --마이너스 부호 
		
		sMaskInfo_2 = sMaskInfo_2 .. "0,"	 --숫자:0 문자:1
		sMaskInfo_2 = sMaskInfo_2 .. "1,"	 --0 보이지 않기 
		sMaskInfo_2 = sMaskInfo_2 .. ","		 --앞첨자
		sMaskInfo_2 = sMaskInfo_2 .. ","		 --뒷첨자
		sMaskInfo_2 = sMaskInfo_2 .. "0,"	 --문자열 마스크
		sMaskInfo_2 = sMaskInfo_2 .. ","		 --문자열 마스크
		sMaskInfo_2 = sMaskInfo_2 .. "2,"	 --소숫점 자릿수
		sMaskInfo_2 = sMaskInfo_2 .. "1,"	 --천단위 부호
		sMaskInfo_2 = sMaskInfo_2 .. "1"		 --마이너스 부호 
		
		 --20241112 SWJ START
		 --매수/매도 수수료 0 보임 처리를 위해 마스킹 변수 한개 더 추가
		sMaskInfo_3 = sMaskInfo_3 .. "0,"	 --숫자:0 문자:1
		sMaskInfo_3 = sMaskInfo_3 .. "0,"	 --0 보이지 않기 
		sMaskInfo_3 = sMaskInfo_3 .. ","		 --앞첨자
		sMaskInfo_3 = sMaskInfo_3 .. ","		 --뒷첨자
		sMaskInfo_3 = sMaskInfo_3 .. "0,"	 --문자열 마스크
		sMaskInfo_3 = sMaskInfo_3 .. ","		 --문자열 마스크
		sMaskInfo_3 = sMaskInfo_3 .. "2,"	 --소숫점 자릿수
		sMaskInfo_3 = sMaskInfo_3 .. "1,"	 --천단위 부호
		sMaskInfo_3 = sMaskInfo_3 .. "1"		 --마이너스 부호 
		 --20241112 SWJ END
	end
	
	contBody.grd0.SetCellMaxLineCount("bd_cell01", "2")
	
	contBody.grd0.SetCellIDMaskInfo("bd_cell05", sMaskInfo_1)	 --현재가
	contBody.grd0.SetCellIDMaskInfo("bd_cell55", sMaskInfo_1)	 --매입가
	
	contBody.grd0.SetCellIDMaskInfo("bd_cell06", sMaskInfo_2)	 --평가손익
	
	contBody.grd0.SetCellIDMaskInfo("bd_cell07", sMaskInfo_2)	 --평가금액
	contBody.grd0.SetCellIDMaskInfo("bd_cell57", sMaskInfo_2)	 --매입금액
	
	 --contBody.grd0.setCellIDMaskInfo("bd_cell09", sMaskInfo_2)	'대출금액	'20241125_01 HWG START
	
	 --20241112 SWJ START
	contBody.grd0.SetCellIDMaskInfo("bd_cell12", sMaskInfo_3)	 --매수수수료
	contBody.grd0.SetCellIDMaskInfo("bd_cell62", sMaskInfo_3)	 --매도수수료
	
	contBody.grd0.SetCellIDMaskInfo("bd_cell13", sMaskInfo_3)	 --제세금
	contBody.grd0.SetCellIDMaskInfo("bd_cell63", sMaskInfo_3)	 --신용이자

	contBody.grd0.SetCellIDMaskInfo("bd_cell14", sMaskInfo_3)	 --매수수수료
	 --20241112 SWJ END
	
	contBody.grd0.SetCellIDMaskInfo("bd_cell64", sMaskInfo_2)	 --신용이자
end

 --============================================================================
function Transform_Exid2(sValue)
	if sValue == "HK" then
		return "HKS"
	elseif sValue == "SH" then
		return "SHS"
	elseif sValue == "SZ" then
		return "SZS"
	elseif sValue == "NY" then
		return "NYS"
	elseif sValue == "AX" then
		return "AMX"
	elseif sValue == "OQ" then
		return "NAS"
	elseif sValue == "JP" then
		return "TSE"
	end
end

function Calc_Data()

	 --20250317_01 HWG START : 해외주식 종합잔고 실시간 계산 로직 개선
	if gf_Tonumber(rdoGbn.currentindex) == 1 then
		return
	end
	 --20250317_01 HWG END
	
	nVltn_Won_Total = 0
	nVltn_Total = 0	 --20241125_01 HWG START
	for i = 0, contBody.grd0.rowcount-1 do
		 --잔고수량
		szAmt  = string.gsub(contBody.grd0.GetCellData("bd_cell04", string.gsub(i), "([%p])", "%%%1"), ",","")
		
		 --현재가(외화)
		szHyun = string.gsub(contBody.grd0.GetCellData("bd_cell71", string.gsub(i), "([%p])", "%%%1"), ",","")
		
		 --매입금액 
		szPurchaseAmt = string.gsub(contBody.grd0.GetCellData("bd_cell57", string.gsub(i), "([%p])", "%%%1"), ",","")
		
		 --기준환율
		stnd_exrt	= string.gsub(contBody.grd0.GetCellData("bd_cell15", string.gsub(i), "([%p])", "%%%1"), ",", "")	
		
		 --20240903_01 HWG START : 해외주식 잔고 최대자릿수 표기 개선
		 -------------------------------------------------------------------
		 --스크립트 오류 보완로직 
		 --빈값인 경우 0으로 대체해서 수치 계산 정상동작 하도록 예외처리
		 -------------------------------------------------------------------
		if szAmt == "" or szAmt == nil then
			szAmt = "0"
		end
		
		if szHyun == "" or szHyun == nil then
			szHyun = "0"
		end
		
		if szPurchaseAmt == "" or szPurchaseAmt == nil then
			szPurchaseAmt = "0"
		end
		
		if stnd_exrt == "" or stnd_exrt == nil then
			stnd_exrt = "0"
		end
		 -------------------------------------------------------------------
				
		 --1.평가금액 구하기 
		 --- 외화평가금액 : 현재가(외화) * 잔고수량 -> 소수점 2자리 절삭
		 --- 원화환산 : 평가금액(외화) * 기준환율 -> 소수점 0자리 절삭 
		nVltn = truncateToDecimalPlaces(gf_Tonumber(szAmt) * gf_Tonumber(szHyun), 2)
		nVltn_Total = nVltn_Total + nVltn	 --20241125_01 HWG START
		
		nVltn_Won = truncateToDecimalPlaces(nVltn * gf_Tonumber(stnd_exrt), 0)
		nVltn_Won_Total = nVltn_Won_Total + nVltn_Won
		
		
		nVltn_Stnd = 0
		
		 --외화
		if g_nViewMode == 0 then
			nVltn_Stnd = gf_CommaValue(nVltn, 2,0,0,0,1)
			
			contBody.grd0.SetCellData("bd_cell07", i, nVltn_Stnd)
			
			 --2.평가손익 구하기
			 --- 평가금액 - 매입금액
			nVltn_Camt = gf_Tonumber(nVltn_Stnd) - gf_Tonumber(szPurchaseAmt)
			contBody.grd0.SetCellData("bd_cell06", i, gf_CommaValue(nVltn_Camt,2,0,0,0,1))
			
		 --원화
		elseif g_nViewMode == 1 then
			nVltn_Stnd = gf_CommaValue(nVltn_Won, 0,0,0,0,1)
			
			contBody.grd0.SetCellData("bd_cell07", i, nVltn_Stnd)
			
			 --2.평가손익 구하기
			 --- 평가금액 - 매입금액
			nVltn_Camt = gf_Tonumber(nVltn_Stnd) - gf_Tonumber(szPurchaseAmt)
			contBody.grd0.SetCellData("bd_cell06", i, gf_CommaValue(nVltn_Camt,0,0,0,0,1))
			
			 --20260209 YSH START
			 --매매손익 구하기
			 --- 평가손익 - 환차손익
			nFedAmt  = string.gsub(contBody.grd0.GetCellData("bd_cell76", string.gsub(i), "([%p])", "%%%1"), ",","")
			nDealCamt = nVltn_Camt - gf_Tonumber(nFedAmt)
			contBody.grd0.SetCellData("bd_cell26", i, gf_CommaValue(nDealCamt,0,0,0,0,1))
			 --20260209 YSH END

		end
		
		 --3.손익률 구하기
		 --- 평가금액 / 매입금액 * 100 -> 소숫점 2자리 반올림
		 --20241125_01 HWG START
		nVltn_Rate = 0
		if gf_Tonumber(szPurchaseAmt) == 0 then
			nVltn_Rate = 0
		else
			nVltn_Rate = gf_Round(nVltn_Camt / gf_Tonumber(szPurchaseAmt) * 100, 2)
		end
		 --20241125_01 HWG END
		
		contBody.grd0.SetCellData("bd_cell56", i, gf_CommaValue(nVltn_Rate,2,0,0,0,1))
		
		 --20240919_01 HWG START : 종합잔고 텍스트 색상조정
		if nVltn_Camt > 0 then
			contBody.grd0.SetCellFgColor("bd_cell06", i, "10")
		elseif nVltn_Camt < 0 then
			contBody.grd0.SetCellFgColor("bd_cell06", i, "11")
		else
			contBody.grd0.SetCellFgColor("bd_cell06", i, "4")
		end
		 --20240919_01 HWG END
	end

	 --해외주식 평가금액 세팅
	lblTop0.caption = gf_CommaValue(nVltn_Won_Total,0,0,0,0,1)
	
	 --매입금액
	nPurchaseAmt 	= gf_Tonumber(lblTop1.caption)
	 --추정예수금
	nDeposit 		= gf_Tonumber(lblTop4.caption)
	 --대출금액
	nLoanAmt 		= gf_Tonumber(lblTop6.caption)
	
	 --평가손익 
	 --해외주식평가금액 - 매입금액
	nVltn_Camt = gf_Tonumber(nVltn_Won_Total) - nPurchaseAmt
	
	 --손익률
	 --평가금액 / 매입금액 * 100 -> 소숫점 2자리 반올림
	 --20241125_01 HWG START
	nVltn_Rate = 0
	if nPurchaseAmt == 0 then
		nVltn_Rate = 0
	else
		nVltn_Rate = gf_Round(nVltn_Camt / nPurchaseAmt * 100, 2)
	end
	 --20241125_01 HWG END
	
	lblTop2.caption = gf_CommaValue(nVltn_Camt,0,0,0,0,1)  --nVltn_Camt
	lblTop3.caption = gf_CommaValue(nVltn_Rate,2,0,0,0,1)  --nVltn_Rate
	
	 --총평가금액
	 --해외주식 평가금액 + 추정예수금 - 대출금액
 --	Table1.SetCellString(1, 0, FormatNumber(nVltn_Won_Total + nDeposit - nLoanAmt,0,0,0,0,1) )
	lblTot.caption = gf_CommaValue(nVltn_Won_Total + nDeposit - nLoanAmt,0,0,0,0,1)
	 --20240903_01 HWG END
	
	 --20241125_01 HWG START
	if g_nViewMode_Tot == 1 then
		lblTop10.caption = gf_CommaValue(nVltn_Total,2,0,0,0,1)
		
		 --매입금액
		nPurchaseAmt2 	= gf_Tonumber(lblTop11.caption)
		 --추정예수금
		nDeposit2 		= gf_Tonumber(lblTop14.caption)
		 --대출금액
		nLoanAmt2 		= gf_Tonumber(lblTop16.caption)
		
		 --평가손익 
		 --해외주식평가금액 - 매입금액
		nVltn_Camt2 = gf_Tonumber(nVltn_Total) - nPurchaseAmt2
		lblTop12.caption = gf_CommaValue(nVltn_Camt2,2,0,0,0,1)  --nVltn_Camt

		 --총평가금액
		 --해외주식 평가금액 + 추정예수금 - 대출금액
		lblTot0.caption = gf_CommaValue(nVltn_Total + nDeposit2 - nLoanAmt2,2) .. " " .. GetCrcd(g_szCrCdNm)
		
		 --v20251001_01 >>
		 --손익률
		 --평가금액 / 매입금액 * 100 -> 소숫점 2자리 반올림
		nVltn_Camt2 = nVltn_Total - nPurchaseAmt2
		nVltn_Rate2 = gf_Round(nVltn_Camt2 / nPurchaseAmt2 * 100, 2)
		lblTop13.caption = gf_CommaValue(nVltn_Rate2,2,0,0,0,1)  --nVltn_Rate
		 --v20251001_01 <<
	end
	 --20241125_01 HWG END
end

 --20240903_01 HWG START : 해외주식 잔고 최대자릿수 표기 개선
function truncateToDecimalPlaces(nVal, nDeimalPlaces)
	nFactor = 10 ^ nDeimalPlaces
	szNumStr = gf_CommaValue(nVal*nFactor,6,0,0,0,1)
	nDecimalIdx = string.find(szNumStr, ".")
	
	nTotalData = 0
	if gf_Tonumber(nDecimalIdx) > 0 then
		nTotalData = gf_Tonumber(string.sub(szNumStr, 1, Cint(nDecimalIdx)-1))
	else
		nTotalData = gf_Tonumber(szNumStr)
	end

	return nTotalData / nFactor
end
 --20240903_01 HWG END

 --20250703 YSH START
function RequestMarketInfo()
	szMktOp = Form.GetSharedData("..OVRS_MARKET_OPERATION_US", false)
	if szMktOp ~= "" then
		 --장 운영 정보값이 001 ~ 013 아닐 경우 004 정규장으로 구분값 세팅
		if CheckValidMktOp(szMktOp) == false then --v0003
			szMktOp = "004"
		end

		g_szMktOpClsCd = szMktOp
		showClosePriceChkBox()
		RequestData()
	end
end

function showClosePriceChkBox()
	if g_szMktOpClsCd == "001" then
		contBody.chk2.visible = true
	else
		contBody.chk2.checkstate = 0
		contBody.chk2.visible = false
	end
end
 --20250703 YSH END

function Request_Tran_obtro_oder_266r()

	
	contBody2.Pannel0.rowcount = 0
	DATAMANAGER.ClearInputData(false, "obtro_oder_266r")
	
	DATAMANAGER.SetDataValue(0, "obtro_oder_266r", "InBlock1", "ACNO" 		  , 0 , g_szAcno)
	DATAMANAGER.SetDataValue(0, "obtro_oder_266r", "InBlock1", "ASNO" 		  , 0 , g_szAsno)
	DATAMANAGER.SetDataValue(0, "obtro_oder_266r", "InBlock1", "UI_IQRY_COND_CNTT", 0 , g_szCrCd)
	DATAMANAGER.SetDataValue(0, "obtro_oder_266r", "InBlock1", "DYTM_TR_CLPR_APLY_YN", 0 , g_szDytmYN)
		
	DATAMANAGER.RequestTranData("obtro_oder_266r")
end

function Process_Tran_obtro_oder_266r()
	
	nCnt	= gf_Tonumber(DATAMANAGER.GetDataCount(0, "obtro_oder_266r" , "OutBlock1"))
	
	if nCnt == 0 then
		contBody2.imgNoData.visible = true
		contBody2.lblNoData.visible = true
		return
	else
		contBody2.imgNoData.visible = false
		contBody2.lblNoData.visible = false

		if g_nViewMode2 == 0 then
			contBody2.grdDeposit.visible = False
			contBody2.Pannel0.visible = True
		else
			contBody2.grdDeposit.visible = True
			contBody2.Pannel0.visible = False
		end
	end


	for i = 0, nCnt - 1 do
		szCRCD        = DATAMANAGER.GetDataValue(0, "obtro_oder_266r", "OutBlock1", "CRCD", i)	 --통화코드
		
		szVLTN_EXRT      = DATAMANAGER.GetDataValue(0, "obtro_oder_266r", "OutBlock1", "VLTN_EXRT", i)	 --평가환율
					
		szFRCR_AMT2      = DATAMANAGER.GetDataValue(0, "obtro_oder_266r", "OutBlock1", "UI_FRCR_AMT", i)	 --외화추정예수금
		szWNCR_VLTN_AMT2 = DATAMANAGER.GetDataValue(0, "obtro_oder_266r", "OutBlock1", "EXCL_WNCR_VLTN_AMT", i)	 --원화평가금액
		
		nIdx = contBody2.Pannel0.AddRow()
		szFlag = Form.GetIconImg("CRCD", szCRCD)
		if szFlag == "" then
			szFlag = "flag_general"
		end
		
		contBody2.grdDeposit.SetMaintainingRatio("bd_cell8", nIdx, "1")
		contBody2.grdDeposit.SetCellImage("bd_cell8", nIdx, szFlag)
		
		contBody2.grdDeposit.SetCellData("bd_cell10", nIdx, ">")
		
		 --20241216 SWJ START
		if g_szTheme == "black" then
			contBody2.Pannel0.SetPropCardCell("bgcolor","lblGuideLine1",nIdx,"051051051")
		else
			contBody2.Pannel0.SetPropCardCell("bgcolor","lblGuideLine1",nIdx,"230230230")
		end
		 --20241216 SWJ END
		
		contBody2.Pannel0.SetPropCardCell("maintainratio","imgCRCD",nIdx,"2")
		contBody2.Pannel0.SetCellValue( "imgCRCD",    nIdx, szFlag ) 	
		
		contBody2.Pannel0.SetCellValue( "lblCRCD",    nIdx, Form.GetMetaData("통화코드", szCRCD) ) 			
		contBody2.Pannel0.SetCellValue( "lblExRate",   nIdx, "환율 " .. gf_CommaValue(szVLTN_EXRT, 2)    ) 
		
		contBody2.Pannel0.SetCellValue( "lblFrAmt",   nIdx, gf_CommaValue(szFRCR_AMT2, 2) .. " " .. szCRCD  ) 
		contBody2.Pannel0.SetCellValue( "lblAmt",     nIdx, gf_CommaValue(szWNCR_VLTN_AMT2, 0) .. " " .. "원") 
		
		g_nGridIndex = gf_Tonumber(g_nGridIndex) + 1
	end
	
	 --20250521_01 HWG
	g_isDup = false
	
end


 --============================================================================
function Transform_Exid(sValue)
	if sValue == "0537" then -- 나스닥
		return "OQ"
	elseif sValue == "0321" then -- 뉴욕
		return "NY"
	elseif sValue == "0066" then -- 아멕스
		return "AX"
	elseif sValue == "0215" then -- 상해
		return "SH"
	elseif sValue == "0214" then -- 심천
		return "SZ"
	elseif sValue == "0104" then -- 홍콩
		return "HK"
	elseif sValue == "0106" then -- 일본
		return "JP"
	else
		return ""
	end
end


 --20241125_01 HWG START
 --============================================================================
 -- 국가명 -> 통화코드 반환
 --============================================================================
function GetCrcd(sCrcd)
	
	if sCrcd == "미국" then
		return "USD"
	elseif sCrcd == "중국" then
		return "CNY"
	elseif sCrcd == "홍콩" then
		return "HKD"
	elseif sCrcd == "일본" then
		return "JPY"
	elseif sCrcd == "유럽" then
		return "EUR"
	elseif sCrcd == "호주" then
		return "AUD"
	elseif sCrcd == "싱가포르" then
		return "SGD"
	elseif sCrcd == "캐나다" then
		return "CAD"
	elseif sCrcd == "스위스" then
		return "CHF"
	elseif sCrcd == "베트남" then
		return "VND"
	else
		return "USD"
	end
end
 --20241125_01 HWG END


 --============================================================================
function OpenMovePopup(nIndex)

	 ----------------------------------------------
	 --무브팝업 화면에 넘겨줄 데이터 가져옴
	 ----------------------------------------------
	listLocation =  gf_Split(contBody.grd0.location,":")
	
 --	if Cint(contBody.top) > 50 then
 --		nYPos = Int(listLocation[1]) - 110
 --		nHeight = listLocation[3]
 --	else
		nYPos = Int(listLocation[1+1])
		nHeight = listLocation[3+1]
 --	end if
	
	sIndex 		= nIndex
	sName 		= contBody.grd0.GetCellData("bd_cell01", nIndex)
	sCode 		= contBody.grd0.GetCellData("bd_cell16", nIndex)
	sVndrCode 	= contBody.grd0.GetCellData("bd_cell66", nIndex)

	 --v20250924_02 >>	
	sOrdGbn		= "현금"
	sType = contBody.grd0.GetCellData("bd_cell18", nIndex)

	if sType == "2" then
		sOrdGbn = "소수점"
	end
	
	sType = contBody.grd0.GetCellData("bd_cell53", nIndex)
		
	if sType == "02" then
		sOrdGbn = "대출"
	end
	 --v20250924_02 <<
			
	szOffChk = Transform_Exid(sVndrCode)
	if szOffChk == "" then
		Form.ShowAlert("알림", "해당 종목은 온라인에서\n거래가 불가합니다.\n\n영업점 또는 해외주식 데스크로 문의해주세요")
		return
	end
	
	 --v20251110_01 >>
	if CheckMasterFile(sCode, sVndrCode) == false then
		Form.ShowAlert("알림", "해당 종목은 온라인에서\n거래가 불가합니다.\n\n영업점 또는 해외주식 데스크로 문의해주세요")
		return
	end
	 --v20251110_01 <<
	
	 --v20250924_02 >>
	szData = "OVRS_ODER_JANGO" .. "★" .. nYPos .. "★" .. nHeight .. "★" .. sIndex .. "★" .. sName .. "★" .. sCode .. "★" .. sVndrCode .. "★" .. sOrdGbn
	 --v20250924_02 <<
	
	 ----------------------------------------------
	 --무브팝업 오픈
	 ----------------------------------------------
	Form.OpenPopup("mhtro16100_movepopup" , szData , "")
	

end


 --v20251110_01 >>
 --============================================================================
 -- 마스터파일에 있는 종목인지 체크
 --============================================================================
function CheckMasterFile(szCode, szVndrCode)
	
	szTransExidCode = Transform_Exid(szVndrCode)
	
	szTransItemCode = szTransExidCode .. "@" .. szCode
	
	szCheckData = Form.GetItemCodeInfo(szTransItemCode, "exchid")
	
	if szCheckData == "" or szCheckData == nil then
		return false
	end
	
	return true

end
 --v20251110_01 <<


 --============================================================================
 -- 무브팝업 연결화면 이동
 --============================================================================
function MoveScreen(sGubun,sIndex)

	local nIndex
	nIndex = gf_Tonumber(sIndex)
	
	szOnlineYN = contBody.grd0.GetCellData("bd_cell22", sIndex) 
	
	if szOnlineYN == "N" then
		Form.MsgBox("안내", "해당 종목은 온라인에서 거래가 불가합니다.\n영업점 또는 해외주식 데스크로 문의해주세요", "OnLineCheck", 6)
		return
	end
	
	Form.SetSharedData("16070_JANGO_INDEX" , sIndex)
	szItemCode 	= contBody.grd0.GetCellData("bd_cell21", sIndex) 
	szName 		= contBody.grd0.GetCellData("bd_cell01", sIndex) 
	sJangoGubun	= contBody.grd0.GetCellData("bd_cell68", sIndex) 
	sOrdAbleQty 	= contBody.grd0.GetCellData("bd_cell54", nIndex)
	sLoanType	= contBody.grd0.GetCellData("bd_cell23", nIndex)
	sLoanDate	= contBody.grd0.GetCellData("bd_cell24", nIndex)
	sLoanSrno	= contBody.grd0.GetCellData("bd_cell25", nIndex)
	
	 --v20250924_02 >>	
	sOrdQty 		= contBody.grd0.GetCellData("bd_cell04", nIndex)
	sAvgPrc 		= contBody.grd0.GetCellData("bd_cell55", nIndex)
	sRate 		= contBody.grd0.GetCellData("bd_cell56", nIndex)
	 --v20250924_02 <<

	Form.SetSharedData( "..ITEM_CODE" , szItemCode)
	Form.SetSharedData( "..ITEM_KORNAME" , szName  )	
	Form.SetSharedData( "..ITEM_OVERSTOCK", szItemCode.."★"..szName.."★".."", "" )
		
	 --v20250924_02 >>	
	if sGubun ~= "MOVE_WATER" then
		Form.SendMessageToMain( "CHANGE_ITEMCODE_OVERSTOCK", szItemCode.."★"..szName.."★".."", "" )
	end
	 --v20250924_02 <<
	
	 --------------------------------------
	 -- [현재가] : 종목연동
	 --------------------------------------
	if sGubun == "MOVE_HYUN" then
		if szItemCode ~= "" then
			Form.OpenScreen("16000", "")	
		end
	
	 --------------------------------------
	 -- [차트] : 종목연동
	 --------------------------------------
	elseif sGubun == "MOVE_CHART" then
		if szItemCode ~= "" then
			Form.OpenScreen("16020", "")
		end
	
	 --------------------------------------
	 -- [매수] : 종목연동
	 --------------------------------------
	elseif sGubun == "MOVE_MAESU" then
		 ----------------------------------------------
		 --소수점 잔고일 경우 소수점 주문화면으로 연동
		 ----------------------------------------------
		if sJangoGubun == "03" then
			if szItemCode ~= "" then
				szData = szItemCode .. "★" .. szName .. "♥" .. "0" .. "♥" .. "" .. "♥" .. "" .. "♥" .. "0000" .. "♥" .. "0" .. "♥" .. "00000000000"
				Form.OpenScreen("16092" , szData)
			end
		
		 ----------------------------------------------
		 -- 일반/대출 잔고일 경우 매수탭으로 연동
		 ----------------------------------------------
		else
			if szItemCode ~= "" then
				Form.OpenScreen("16060", "0")
			end
			
		end
	
	 --v20250924_02 >>
	 --------------------------------------
	 -- [물타기] : 종목연동/가격/수량연동
	 --------------------------------------	
	elseif sGubun == "MOVE_WATER" then
		 ----------------------------------------------
		 --소수점 잔고일 경우 소수점 주문화면으로 연동
		 ----------------------------------------------
		if sJangoGubun == "03" then
 --			if szItemCode <> "" then
 --				szData = szItemCode & "★" & szName & "♥" & "0" & "♥" & "" & "♥" & "" & "♥" & "0000" & "♥" & "0" & "♥" & "00000000000"
 --				Form.OpenScreen("16092" , szData)
 --			end if
			 --none
		
		 ----------------------------------------------
		 -- 일반/대출 잔고일 경우 매수탭으로 연동
		 ----------------------------------------------
		else
			if szItemCode ~= "" then
				 --------------------------------------------------
				 -- 링크데이터 구조
				 -- 국내/해외구분`종목코드`보유수량'평균단가'수익률
				 --------------------------------------------------
				sLinkData = "1"														
 --				sLinkData = sLinkData & "`" & szItemCode & "`" & sOrdQty & "`" & sAvgPrc & "`" & sRate
				g_sLinkData_Water = sLinkData .. "`" .. szItemCode .. "`" .. "수량교체" .. "`" .. "가격교체".. "`" .. sRate
				
				DATAMANAGER.ClearInputData(0, "obtro_acnt_175r")
		
				 --------------------------------------------------------------
				 -- 계좌번호/일련번호
				 --------------------------------------------------------------
				local sAcno,sAsno
				sAcno = acnt1.total
				sAsno = acnt1.sequence
				
				sCode = contBody.grd0.GetCellData("bd_cell16", nIndex)
				sExid = string.sub(contBody.grd0.GetCellData("bd_cell70", -nIndex),2)
				
				DATAMANAGER.ClearInputData(0, "obtro_acnt_175r")
				DATAMANAGER.SetDataValue(0, "obtro_acnt_175r", "InBlock1", "ACNO", 0, sAcno)		
				DATAMANAGER.SetDataValue(0, "obtro_acnt_175r", "InBlock1", "ASNO", 0, sAsno)
				DATAMANAGER.SetDataValue(0, "obtro_acnt_175r", "InBlock1", "ISCD", 0,   sCode .. "." .. sExid)
				DATAMANAGER.RequestTranData("obtro_acnt_175r")
				
				 --Form.OpenPopup("mhtro17200", sLinkData, "")
			end
			
		end
	 --v20250924_02 <<	
	 --------------------------------------
	 -- [매도] : 종목연동 / 매도가능수량 연동
	 --------------------------------------
	elseif sGubun == "MOVE_MAEDO" then
		 -----------------------------------------------------------------------------------------
		 -- 연동수량(주문가능수량) 천단위부호(,) 제거
		 -- 그리드에 있는 주문가능수량 데이터는 일반잔고/소수점 잔고의 수량을 
		 -- 표시하기 위해 문자형으로 세팅되어있음. 그대로 값을 가져오면 천단위 부호도 같이 넘어옴.
		 -- 넘어온 데이터를 그대로 천단위 부호까지 같이 넘기면
		 -- 안드로이드에서 천단위 부호 중복해서 보이는 현상 발생.
		 -----------------------------------------------------------------------------------------
		sOrdAbleQty = string.gsub(sOrdAbleQty, string.gsub(", "([%p])", "%%%1"), ","")
		
		 ----------------------------------------------
		 --소수점 잔고일 경우 소수점 주문화면으로 연동
		 ----------------------------------------------
		if sJangoGubun == "03" then
		
			if szItemCode ~= "" then
				szData = szItemCode .. "★" .. szName .. "♥" .. "1" .. "♥" .. "" .. "♥" .. "" .. "♥" .. "0000" .. "♥" .. "0" .. "♥" .. "00000000000"
				Form.OpenScreen("16092" , szData)
			end
		
		 ----------------------------------------------
		 -- 일반/대출 잔고일 경우 매도탭으로 연동
		 ----------------------------------------------
		else
			
			if szItemCode ~= "" then
				szData = szItemCode .. "★" .. szName .. "♥" .. "1" .. "♥" .. sOrdAbleQty .. "♥" .. sLoanDate .. "♥" .. sLoanType .. "♥" .. "0" .. "♥" .. sLoanSrno
				
				 ----------------------------------------------
				 -- 현재 해외주식 신용합산 주문이 불가하므로,
				 -- 대출일 경우 대출합산 체크 여부 확인하여
				 -- 체크되어있으면 주문불가 안내팝업 발생
				 ----------------------------------------------
				if sJangoGubun == "02" then
				
					nCheckHabsan = gf_Tonumber(contBody.chk1.checkstate)
					
					if nCheckHabsan == 1 then
						Form.MsgBox("안내", "합산 주문이 불가합니다.\n대출합산 해지 후 매도를 진행해주세요.", "MOVEPOPUP_CHECK_HABSAN", 6)
						return
					end
					
				end
				
				Form.OpenScreen("16060", szData)
			
			end
			
		end
	
	end

end

