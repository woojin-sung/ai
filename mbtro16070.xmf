function Form_OnPopupReturn(sKeyName, sRet)
	
	if sKeyName == "mbtro16070_p4" then
		
		 --거래 국가 선택후.
		if sRet ~= "" then
			tData = gf_Split(sRet, "★")	
			
			g_szCrCd = gf_Trim(tData[0+1])
			g_szCrCdNm = gf_Trim(tData[1+1])
			
			Form.SetEnvData(1, "OVRS_JANGO_NATION", g_szCrCd)
			Form.SetEnvData(1, "OVRS_JANGO_NATION_NM", g_szCrCdNm)
			
	
			lblCrCd.caption = g_szCrCd		
			
			if g_szCrCd == "000" or g_szCrCd == "" then
				lblCrCdNm.caption = "총 외화자산"
				
				nTxtWidth = Form.GetTextWidth("총 외화자산", 2, true, false)
				
				imgSearch.left = 15 + nTxtWidth + 7
			else
				arrCrcdNm = gf_Split(g_szCrCdNm, "@") 
				nArrCnt = #arrCrcdNm
				
				nTxtWidth = gf_Tonumber(Form.GetTextWidth("총 외화자산 ", 2, true, false))
	
				if nArrCnt == 1 then
					lblCrCdNm.caption = "총 외화자산 (" .. g_szCrCdNm .. ")"
					nTxtWidth = nTxtWidth +  gf_Tonumber(Form.GetTextWidth("(" .. g_szCrCdNm .. ")", -2, true, false))
				else
					lblCrCdNm.caption = "총 외화자산 (" ..arrCrcdNm[0+1] .. " 외 " .. nArrCnt-1 .. ")"
					nTxtWidth = nTxtWidth +  gf_Tonumber(Form.GetTextWidth("(" ..arrCrcdNm[0+1] .. " 외 " .. nArrCnt-1 .. ")", -2, true, false))
				end
				
				nTxtLen = Form.GetLen(lblCrCdNm.caption)
		
				lblCrCdNm.ChangeTextAttr(6, nTxtLen-6, 333, -2, true)
				
				imgSearch.left = 15 + nTxtWidth + 7
			end
		end
		
		Call_Tran()
	elseif sKeyName == "MOVEPOPUP_RETURN" then
	
		 --sRet = 선택행인덱스★이동화면 구분값 
		arrData = gf_Split(sRet,"★")
		
		sIndex = arrData[0+1]
		sGubun = arrData[1+1]
		
		if sIndex ~= "" and sGubun ~= "" then
			MoveScreen(sGubun,sIndex)
		end
	elseif sKeyName == "OVRS_REAL_JANGO" then
		Init_Control()
		imgDetail_OnClick()
		Call_Tran()
		
	 --v20251001_01 >>
	 --컬럼 편집 팝업 호출
 --	elseif sKeyName == "CHANGE_JANGO_COLUMN" then	
 --		Form.openPopupAnimation("mbtrs15000_p6", "16070" , "", "2")
		
	 --컬럼 편집 팝업 리턴
 --	elseif sKeyName == "mbtrs15000_p6_RETURN" then
 --		SetGridColIdx(sRet)
 --		if sRet <> "" then
 --			'컬럼인덱스 순서, 고정열 개수, 고정행 개수
 --			contBody.grd0.ChangeLayoutInfo(sRet, 1, 0)
 --			SetVisibleCol()
 --		end if
		
	 --상단 타이틀 터치 시 노출 팝업 리턴
	elseif sKeyName == "nrsbonl16072_p2" then
		imgTitleArrow.imgpath = "icon_arrow_down2.png"
	 --v20251001_01 <<
	
	end
end

 --============================================================================
function DATAMANAGER_OnReceiveTranComplete(szTranID)

	if szTranID == "obtro_oder_290r" then
		
		nCnt	= gf_Tonumber(DATAMANAGER.GetDataCount(0, szTranID , "OutBlock1"))
		
		for i = 0, contBody.grd0.rowcount-1 do
			contBody.grd0.SetCellFgColor("bd_cell51", i, g_szTxtColor_Grey)
			
			stnd_exrt	= string.gsub(contBody.grd0.GetCellData("bd_cell15", string.gsub(i), "([%p])", "%%%1"), ",", "")	 --기준환율
			
			szItemCd		= contBody.grd0.GetCellData("bd_cell16", i)	 --종목코드
			exch			= contBody.grd0.GetCellData("bd_cell72", i)	 --거래소구분코드

			vltn_prls_amt = string.gsub(contBody.grd0.GetCellData("bd_cell06", string.gsub(i), "([%p])", "%%%1"), ",", "")	 --평가손익
			byov_amt 	= string.gsub(contBody.grd0.GetCellData("bd_cell9", string.gsub(i), "([%p])", "%%%1"), ",", "")
			psnt_prc		= string.gsub(contBody.grd0.GetCellData("bd_cell10", string.gsub(i), "([%p])", "%%%1"), ",", "")
			nation		= contBody.grd0.GetCellData("bd_cell12", i)
			vltn_amt		= string.gsub(contBody.grd0.GetCellData("bd_cell8", string.gsub(i), "([%p])", "%%%1"), ",", "")
			byov_prc		= string.gsub(contBody.grd0.GetCellData("bd_cell11", string.gsub(i), "([%p])", "%%%1"), ",", "")
		
			local sType, nOwnQty, nAbleQty
			
			sTemp = contBody.grd0.GetCellData("bd_cell16", i)
			
			sType = contBody.grd0.GetCellData("bd_cell18", i)
			
			nOwnQty = gf_Tonumber(contBody.grd0.GetCellData("bd_cell17", i))
			nAbleQty = gf_Tonumber(contBody.grd0.GetCellData("bd_cell67", i))
			
			if sType == "1" then
				nOwnQty = gf_CommaValue(nOwnQty, 0)
				nAbleQty = gf_CommaValue(nAbleQty, 0)
				contBody.grd0.SetCellData("bd_cell11", i, "일반")
			elseif sType == "2" then
				 --20241023_01 HWG START : 소수점잔고 표기오류 개선
				arrData = gf_Split(gf_Tostring(nOwnQty), ".")
				arrData2 = gf_Split(gf_Tostring(nAbleQty), ".")
		
				nOwnQty = gf_CommaValue(arrData[0+1], 0)
				nAbleQty = gf_CommaValue(arrData2[0+1], 0)
				
				if #arrData > 1 then
					nOwnQty = nOwnQty .. "." .. arrData[1+1]
				end
				
				if #arrData2 > 1 then
					nAbleQty = nAbleQty .. "." .. arrData2[1+1]
				end
				 --20241023_01 HWG END
				
				contBody.grd0.SetCellData("bd_cell11", i, "소수점")
				contBody.grd0.SetCellData("bd_cell51", i, "소수점 | " .. sTemp )
			end
			
			contBody.grd0.SetCellData("bd_cell04", i, nOwnQty)
			contBody.grd0.SetCellData("bd_cell54", i, nAbleQty)

			sType = contBody.grd0.GetCellData("bd_cell53", i)
		
			if sType == "01" then
				contBody.grd0.SetCellData("bd_cell51", i, "현금 | " .. sTemp )
			elseif sType == "02" then
				contBody.grd0.SetCellData("bd_cell51", i, "대출 | " .. sTemp )
			end
			
			
			if gf_Tonumber(vltn_prls_amt) > 0 then
				contBody.grd0.SetCellFgColor("bd_cell06", i, "10")
			elseif gf_Tonumber(vltn_prls_amt) < 0 then
				contBody.grd0.SetCellFgColor("bd_cell06", i, "11")
			else
				contBody.grd0.SetCellFgColor("bd_cell06", i, "4")
			end
	
			szKorExch = Form.GetMetaData("해외주식거래국가코드", exch)
			contBody.grd0.SetCellData("bd_cell60", i, szKorExch)
			
			loan_type = Form.GetMetaData("대출상세유형코드", contBody.grd0.GetCellData("bd_cell69", i))
			contBody.grd0.SetCellData("bd_cell59", i, loan_type)
			
			 --20240919_01 HWG START : 종합잔고 텍스트 색상조정
			tmp_prc = string.gsub(contBody.grd0.GetCellData("bd_cell05", string.gsub(i), "([%p])", "%%%1"), ",", "")
			tmp_clpr = string.gsub(contBody.grd0.GetCellData("bd_cell20", string.gsub(i), "([%p])", "%%%1"), ",", "")
			 --20240919_01 HWG END
	
			if gf_Tonumber(tmp_prc) > gf_Tonumber(tmp_clpr) then
				contBody.grd0.SetCellFgColor("bd_cell05", i, "10")
			elseif gf_Tonumber(tmp_prc) < gf_Tonumber(tmp_clpr) then
				contBody.grd0.SetCellFgColor("bd_cell05", i, "11")
			else
				contBody.grd0.SetCellFgColor("bd_cell05", i, "4")
			end
			
			szItemCode = contBody.grd0.GetCellData("bd_cell16", i)
			szExchCode = string.sub(contBody.grd0.GetCellData("bd_cell70", -i),2)
			contBody.grd0.SetCellData("bd_cell21", i, szExchCode.."@"..szItemCode)
		end
		
		if DATAMANAGER.IsMoreNextData("obtro_oder_290r") == true then
			DATAMANAGER.RequestNextData("obtro_oder_290r")
		else
			 --20250521_01 HWG
			g_isDup = false
			
			if gf_Tonumber(contBody.grd0.rowcount) == 0 then
				contBody.imgNoData.visible = true
				contBody.lblNoData.visible = true
				
				Form.ClearWaitCursor()
				return
			else
				contBody.imgNoData.visible = false
				contBody.lblNoData.visible = false
			end
			
			if g_szSortHeader ~= "" and g_szSortIdx ~= -1 then
				 --v20251001_01 >>
 --				szData = replace(g_szSortHeader, "th_cell", "")
 --				if szData <> "" then
 --					szData = Cint(szData) - 1
 --					
 --					if szData > 50 then	'v20251001_01
 --						szData = szData - 50
 --					end if
 --					
 --					if szData > 2 then
 --						szData = szData - 2
 --					else 
 --						szData = 0
 --					end if
 --				end if
 --				
 --				contBody.grd0.onSortingByScript(g_szSortHeader, szData, g_szSortIdx)

				contBody.grd0.OnSortingByScript(g_szSortHeader, Return_ColIdx(g_szSortHeader), g_szSortIdx)
				 --v20251001_01 <<
				
				 --20240919_02 HWG START : 종합잔고 정렬기능 조정
				if g_szPrevIdx ~= 0 then
 --					Form.SetTimerEvent2(4, 1, 0.5)
					Form.SetDelayEvent(4, 0.5)
				end
				 --20240919_02 HWG END
			else
				 --20240919_02 HWG START : 종합잔고 정렬기능 조정
				if g_szPrevIdx ~= 0 then
					contBody.grd0.toprow = g_szPrevIdx
					g_szPrevIdx = 0
				end
				 --20240919_02 HWG END
			end
			
			if gf_Tonumber(contBody.grd0.rowcount) < 101 then
				 --v20251001_01 >>
				SetVisibleCol()
				 --v20251001_01 <<
			end
			
			 --20240919_02 HWG START : 종합잔고 정렬기능 조정
			Form.ClearWaitCursor()
		end
	elseif szTranID == "obtro_oder_266r" then
		Process_Tran_obtro_oder_266r()
		
	
	elseif szTranID == "obtro_oder_265r" then
		 --20241125_01 HWG START	
		if g_szCrCd == "000" or g_szCrCd == "" then
			g_nViewMode_Tot = 0
			Form.SetEnvData(1, "OVRS_JANGO_TOT", g_nViewMode_Tot)
			imgToggle.visible = false
			
			DisplaySetting_Top()
			
		else
			arrCrcdNm = gf_Split(g_szCrCdNm, "@") 
			nArrCnt = #arrCrcdNm
			
			if nArrCnt == 1 then
				imgToggle.visible = true
				DisplaySetting_Top()
				
				sTemp = DATAMANAGER.GetDataValue(0, "obtro_oder_265r", "OutBlock1", "ASET_VLTN_CAMT", 0)
				lblTot0.caption = gf_CommaValue(sTemp,2) .. " " .. GetCrcd(g_szCrCdNm)
			else
				g_nViewMode_Tot = 0
				Form.SetEnvData(1, "OVRS_JANGO_TOT", g_nViewMode_Tot)
				imgToggle.visible = false
			
				DisplaySetting_Top()
			end
			
		end
		 --20241125_01 HWG END
		
	 --v20250924_02 >>
	elseif szTranID == "obtro_acnt_175r" then
		sQty = DATAMANAGER.GetDataValue(0, "obtro_acnt_175r", "OutBlock1", "QTY" , 0)
		sAvgPrc = DATAMANAGER.GetDataValue(0, "obtro_acnt_175r", "OutBlock1", "AVRG_UNPR" , 0)
		g_sLinkData_Water = string.gsub(g_sLinkData_Water, string.gsub("수량교체", "([%p])", "%%%1"), sQty)
		g_sLinkData_Water = string.gsub(g_sLinkData_Water, string.gsub("가격교체", "([%p])", "%%%1"), sAvgPrc)

		Form.OpenPopup("mhtro17200", g_sLinkData_Water, "")
	 --v20250924_02 <<
	end
end

function contBody_OnGestureEvent(sParam)
	nRowCnt = gf_Tonumber(contBody.grd0.rowcount)

	if sParam == "Up" then
		 --20251124 YSH START
		 --상단 총자산 테이블 높이 길어지면서 스크롤 기능 패스하는 최소 rowCnt 변경
		if nRowCnt < 4 then
 --		if nRowCnt < 5 then
		 --20251124 YSH END
			return
		end
		
		 --v20251001_01 >>
 --		contBody.fixTopAreaWhenScrolling(true, 55, "Up")
		contBody.FixTopAreaWhenScrolling(true, 105, "Up")
		 --v20251001_01 <<
	elseif sParam == "Down" then
		contBody_OnScrollTop()
	end
end

function contBody2_OnGestureEvent(sParam)
	if sParam == "Up" then
		nRowCnt = 0
		if g_nViewMode2 == 1 then
		
			nRowCnt = gf_Tonumber(contBody2.grdDeposit.rowcount)
			
			 --20251124 YSH START
			 --상단 총자산 테이블 높이 길어지면서 스크롤 기능 패스하는 최소 rowCnt 변경
			if nRowCnt < 6 then
 --			if nRowCnt < 7 then
			 --20251124 YSH END
				return
			end
		else
			nRowCnt = gf_Tonumber(contBody2.Pannel0.rowcount)
			
			if nRowCnt < 4 then
				return
			end
		end
	
		 --v20251001_01 >>
 --		contBody2.fixTopAreaWhenScrolling(true, 55, "Up")
		contBody2.FixTopAreaWhenScrolling(true, 105, "Up")
		 --v20251001_01 <<
	elseif sParam == "Down" then
		contBody2_OnScrollTop()
	end
end
 --
function contBody_OnScrollTop()
	nrow = -1
	nrow = gf_Tonumber(contBody.grd0.toprow)
	 --v20251001_01 >>
	nTblHideHeight = g_nViewMode_Tot == 0 and 66 or 44
	 --v20251001_01 <<
	
	if nrow == 0 then
		if g_bTopDetail then
			 --v20251001_01 >>
 --			contBody.fixTopAreaWhenScrolling(true, 270, "Down")
			contBody.FixTopAreaWhenScrolling(true, 276 + nTblHideHeight, "Down")
			 --v20251001_01 <<
		else
			 --v20251001_01 >>
 --			contBody.fixTopAreaWhenScrolling(true, 270 - 44, "Down")
			contBody.FixTopAreaWhenScrolling(true, 276, "Down")
			 --v20251001_01 <<
		end
	end
end

function contBody2_OnScrollTop()
	 --v20251001_01 >>
	nTblHideHeight = g_nViewMode_Tot == 0 and 66 or 44
	 --v20251001_01 <<
	nrow = -1
	nRowCnt = 0
	if g_nViewMode2 == 1 then
		nrow = gf_Tonumber(contBody2.grdDeposit.toprow)
		nRowCnt = gf_Tonumber(contBody2.grdDeposit.rowcount)
	else
		nrow = gf_Tonumber(contBody2.Pannel0.toprow)
		nRowCnt = gf_Tonumber(contBody2.Pannel0.rowcount)
	end

	
	if nrow == 0 then
		if g_bTopDetail then
			 --v20251001_01 >>
 --			contBody2.fixTopAreaWhenScrolling(true, 270, "Down")
			contBody2.FixTopAreaWhenScrolling(true, 276 + nTblHideHeight, "Down")
			 --v20251001_01 <<
		else
			 --v20251001_01 >>
 --			contBody2.fixTopAreaWhenScrolling(true, 270 - 44, "Down")
			contBody2.FixTopAreaWhenScrolling(true, 276, "Down")
			 --v20251001_01 <<
		end
	end
end

function contBody_OnAnimationComplete(sParam, sParam2)
	if sParam == "Up" then
		contBody.grd0.SetEnableScroll(true)
	elseif sParam == "Down" then
		contBody.grd0.SetEnableScroll(false)
	end
end

function contBody2_OnAnimationComplete(sParam, sParam2)
	if sParam == "Up" then
		contBody2.grdDeposit.SetEnableScroll(true)
		contBody2.Pannel0.SetEnableScroll(true)
	elseif sParam == "Down" then
		contBody2.grdDeposit.SetEnableScroll(false)
		contBody2.Pannel0.SetEnableScroll(false)
	end
	
end

