 --============================================================================
 -- SetVisibleCol
 --============================================================================
function SetVisibleCol()
	isRealUse = false
				
	if contBody.chk0.checkstate == "0" and contBody.chk2.checkstate == "0" then
		isRealUse = true
	else
		isRealUse = false
	end
	
	if g_isReal == true and isRealUse == true then
		contBody.grd0.SetVisibleCol(g_nColIdx_fee, "0")
		contBody.grd0.SetVisibleCol(g_nColIdx_tax, "0")
		contBody.grd0.SetVisibleCol(g_nColIdx_itst, "1")
		
		g_isStart = true
		
 --		Form.SetTimerEvent(3, 1, 1)
		Form.SetDelayEvent(3, 1)
	else
		nIdx = g_sOsType == "1" and g_nColIdx_fee or 9
		contBody.grd0.SetVisibleCol(g_nColIdx_fee, "1")
		contBody.grd0.SetVisibleCol(g_nColIdx_tax, "1")
		contBody.grd0.SetVisibleCol(g_nColIdx_itst, "0")
		
	end
	
	if g_nViewMode == 0 then
		contBody.grd0.SetVisibleCol(g_nColIdx_PL, "0")
	else
		contBody.grd0.SetVisibleCol(g_nColIdx_PL, "1")
	end
end

 --============================================================================
 -- Return_ColIdx
 --============================================================================
function Return_ColIdx(szCellID)
	if szCellID == "th_cell01" or szCellID == "th_cell51" or szCellID == "th_cell52" then
		return "0"
	elseif szCellID == "th_cell04" or szCellID == "th_cell54" then
		return "1"
	elseif szCellID == "th_cell05" or szCellID == "th_cell55" then
		return "2"
	elseif szCellID == "th_cell06" or szCellID == "th_cell56" then
		return "3"
	elseif szCellID ==  "th_cell07" or szCellID == "th_cell57" then
		return "4"
	elseif szCellID ==  "th_cell26" or szCellID == "th_cell76" then
		return "5"
	elseif szCellID ==  "th_cell27" or szCellID == "th_cell77" then
		return "6"
	elseif szCellID ==  "th_cell10" or szCellID == "th_cell60" then
		return "7"
	elseif szCellID ==  "th_cell11" or szCellID == "th_cell61" then
		return "8"
	elseif szCellID ==  "th_cell12" or szCellID == "th_cell62" then
		return "9"
	elseif szCellID ==  "th_cell13" or szCellID == "th_cell63" then
		return "10"
	elseif szCellID ==  "th_cell14" or szCellID == "th_cell64" then
		return "11"
	elseif szCellID ==  "th_cell09" or szCellID == "th_cell59" then
		return "12"
	elseif szCellID ==  "th_cell08" or szCellID == "th_cell58" then
		return "13"
	end
end
