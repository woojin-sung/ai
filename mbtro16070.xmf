function contBody_grd0_OnClickUp(lRow, szCellID)
	OpenMovePopup(lRow)
end

 --============================================================================
function contBody_imgToggle_OnClick()

	if g_isDup == true then
		return 
	end
	
	if g_nViewMode == 0 then
		g_nViewMode = 1	 --원화
		
		contBody.imgToggle.imgpath = "toggle_2dots_03.9.png"
		contBody.lblToggle.caption = "원화"
		 --v20251001_01 >>
		contBody.grd0.SetVisibleCol(g_nColIdx_PL, "1")
		 --v20251001_01 <<
	else
		g_nViewMode = 0	 --외화
	
		contBody.imgToggle.imgpath = "toggle_2dots_02.9.png"
		contBody.lblToggle.caption = "외화"
		 --v20251001_01 >>
		contBody.grd0.SetVisibleCol(g_nColIdx_PL, "0")
		 --v20251001_01 <<
	end
	
	Form.SetEnvData(1, "OVRS_JANGO_STANDARD_GBN", g_nViewMode)
	Call_Tran()
end

