 --============================================================================
function Form_OnLinkData(sKey, sValue)
     --20250703 YSH START
     --해외주식 장운영 정보 조회방식 변경
	if sKey == "OVRS_MARKET_OPERATION_TRAN" then
		if sValue == "SUCCESS" then
			 --Form.ShowAlert("mhtro16070_해외주식 잔고 예수금 메인", "조회 성공: g_isDup - " & g_isDup)
			if g_isDup == true then
				RequestMarketInfo()
			else
				Call_Tran()
			end
		end
    elseif sKey == "OVRS_MARKET_OPERATION_REAL" then
		arrMktData = gf_Split(sValue, "@")
		 --Form.ShowAlert("mhtro16070_해외주식 잔고 예수금 메인", "실시간 성공: arrMktData(0) - " & arrMktData(0) & " / arrMktData(1) - " & arrMktData(1))
		if arrMktData[0+1] == "US" and arrMktData[1+1] == "006" then
			g_isDup = false
			Form.SetDelayEvent(2, 5)
		end
	end
     --20250703 YSH END
end

