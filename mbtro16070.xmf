function ShowTblHide()
	local nTblHideHeight
	nTblHideHeight = g_nViewMode_Tot == 0 and 66 or 44

	rdoGbn.top = 241 + nTblHideHeight
	contBody.top = 276 + nTblHideHeight
	contBody2.top = 276 + nTblHideHeight
	
	contClick.top = 241 + nTblHideHeight

	Image0.height = 95 + nTblHideHeight
	
	if g_nViewMode_Tot == 0 then
		tblHide.visible = false
		tblHide2.visible = true
	else
		tblHide.visible = true
		tblHide2.visible = false
	end
end

