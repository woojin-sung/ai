 --==============================================
 -- 장 운영 정보값 적합 여부 확인
 --==============================================
function CheckValidMktOp(sMktOp)
	 -----------------------------------------
	 --- 000: 휴장 (미국)
	 --- 001: 주간 시작 (미국)
	 --- 002: 주간 종료 (미국)
	 --- 003: 프리장 시작 (미국)
	 --- 004: 정규장 시작 (미국)
	 --- 005: 애프터장 시작 (미국)
	 --- 006: 애프터장 종료 (미국)
	 --- 011: 미국 외 장 시작
	 --- 012: 미국 외 장 종료
	 --- 013: 휴일 (미국/중국/홍콩/일본)
	 -----------------------------------------
	if sMktOp == "" then
		return false
	else
		local nMktOp
		nMktOp = gf_Tonumber(sMktOp)
		
		if nMktOp >= 0 and nMktOp <= 13 then
			return true
		else
			return false
		end
	end
end

