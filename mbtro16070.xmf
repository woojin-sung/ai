 --============================================================================
function RequestData()
	Form.AddWaitCursor()
	g_NextCnt = 0
	
	g_nTotal = 0
	
	contBody.imgNoData.visible = false
	contBody.lblNoData.visible = false
	
	DATAMANAGER.CancelRealData("ohhts_exst_cntg")
	DATAMANAGER.CancelRealData("ohhts_exst_cntg_1")
	DATAMANAGER.CancelRealData("ohhts_exst_cntd")
	DATAMANAGER.CancelRealData("ohhts_exst_cntd_1")
	
	 --v0001 >>
	DATAMANAGER.CancelRealData("ohhts_exst_cnta")
	DATAMANAGER.CancelRealData("ohhts_exst_cnta_1")
	 --v0001 <<
		
	DATAMANAGER.ClearInputData(0, "obtro_oder_290r")
	DATAMANAGER.SetDataValue(0, "obtro_oder_290r", "InBlock1", "ACNO" 		  , 0 , g_szAcno)
	DATAMANAGER.SetDataValue(0, "obtro_oder_290r", "InBlock1", "ASNO" 		  , 0 , g_szAsno)
	DATAMANAGER.SetDataValue(0, "obtro_oder_290r", "InBlock1", "ELFN_ID" 	  , 0 , g_szUserID)  --v002
	
	szChk0 = "N"
	szChk1 = "N"
	szChk2 = "N"
	szChk3 = "1"
	
	if contBody.chk0.checkstate == "1" or gf_Tonumber(contBody.chk0.checkstate) == 1 then --비용포함
		szChk0 = "Y"
	else
		szChk0 = "N"
	end
		
	if contBody.chk1.checkstate == "1" or gf_Tonumber(contBody.chk1.checkstate) == 1 then --대출합산
		szChk1 = "2"
	else
		szChk1 = "1"
	end

	if contBody.chk2.checkstate == "1" or gf_Tonumber(contBody.chk2.checkstate) == 1 then --정규종가
		szChk2 = "N"
	else
		szChk2 = "Y"
	end
	
	 -- 0 외화 1 원화
	if g_nViewMode == 1 then
		szChk3 = "2"
	else
		szChk3 = "1"
	end
	
	DATAMANAGER.SetDataValue(0, "obtro_oder_290r", "InBlock1", "FEE_INCU_YN"	  , 0 , 			szChk0)
	DATAMANAGER.SetDataValue(0, "obtro_oder_290r", "InBlock1", "DYTM_TR_CLPR_APLY_YN", 0 , 	szChk2)  --v004
	
	DATAMANAGER.SetDataValue(0,"obtro_oder_290r", "InBlock1", "IQRY_CLS_CODE" , 0 , 	szChk1)  --v004
	DATAMANAGER.SetDataValue(0,"obtro_oder_290r", "InBlock1", "PROS_CLS" , 0 , 		szChk3)  --v004
	DATAMANAGER.SetDataValue(0,"obtro_oder_290r", "InBlock1", "UI_IQRY_COND_CNTT" , 0 , g_szCrCd)  --v004
	DATAMANAGER.SetDataValue(0,"obtro_oder_290r", "InBlock1", "RMND_CLCD" , 0 , "0")

	DATAMANAGER.RequestTranData("obtro_oder_290r")
end

 --============================================================================
function contBody_chk0_OnChange(sCheckState)
	Form.SetEnvData(1, "OVRS_JANGO_CHK_1", sCheckState)
	
	if sCheckState == "1" then
		szToolTipText = "비용포함 조건을 설정 시, 평가손익과 수익률은 수수료/세금/이자를 포함한 추정치로 오차가 생길 수 있습니다."
		
		contBody.imgTooltip.OpenToolTip(szToolTipText, 320, 100, 2)	 --20241125_01 HWG
	end
	Call_Tran()
end

 --============================================================================
function contBody_chk1_OnChange(sCheckState)
	Form.SetEnvData(1, "OVRS_JANGO_CHK_2", sCheckState)
	Call_Tran()
end

 --============================================================================
function contBody_chk2_OnChange(sCheckState)
	Form.SetEnvData(1, "OVRS_JANGO_CHK_3", sCheckState)
	if contBody.chk2.checkstate == "1" or gf_Tonumber(contBody.chk2.checkstate) == 1 then --정규종가
		szChk2 = "N"
		g_szDytmYN = "N"
	else
		szChk2= "Y"
		g_szDytmYN = "Y"
	end
	Call_Tran()
end
 --============================================================================
function DATAMANAGER_OnSendRealBefore(szTranID)
	if "ohhts_exst_cntg" == szTranID or "ohhts_exst_cntg_1" == szTranID or "ohhts_exst_cnta_1" == szTranID or "ohhts_exst_cnta" == szTranID or "ohhts_exst_cntd_1" == szTranID or "ohhts_exst_cntd" == szTranID then
		DATAMANAGER.ClearInputData( 1, szTranID )
		DATAMANAGER.ClearOutputData( 1, szTranID )
		
		local szCode,szNowCode,InputCode
		local nIdx
		nIdx = 0
		szCode = ""
		
		for i = 0, contBody.grd0.rowcount - 1 do
			szNowCode = contBody.grd0.GetCellData("bd_cell21", i) --종목코드
			
			szExchCd = string.sub(contBody.grd0.GetCellData("bd_cell70", -i),2)
			
			if szExchCd == "OQ" or szExchCd == "NY" or szExchCd == "AX" or szExchCd == "HK"  or szExchCd == "SH"  or szExchCd == "SZ"  or szExchCd == "JP" then
				 --동일한 종목은 제외시킨 후 담는다.
				
				if szNowCode ~= szCode then
					szCode = szNowCode
					DATAMANAGER.SetDataValue( 1, szTranID, "InBlock1", "FIDXR_ISCD" 	, nIdx , szNowCode ) 
					nIdx = nIdx + 1
				end
			end
		end
		
	end
end

