function contBody2_grdDeposit_OnClickUp(lRow, szCellID)
	local szData
	local szCRCD

	if lRow >= 0 then
		
		szCRCD = contBody2.grdDeposit.GetCellData("bd_cell0", lRow)
			
		 --계좌번호★계좌순번★통화코드
		szData = g_szAcno .. "★" .. g_szAsno .. "★" .. szCRCD
	
		 --시세적용기준안내 팝업
		Form.OpenPopupAnimation("mbtro16070_p2" , szData , "" , "2")		
	end
	
end

 --============================================================================
function contBody2_imgViewMode_OnClick()
	if g_nViewMode2 == 0 then
		g_nViewMode2 = 1	 --Grid
		contBody2.lblTitle.caption = "외화 예수금"
		contBody2.imgViewMode.imgpath = "btn_view_grid"
		contBody2.imgTooltip.visible = False
		contBody2.imgBg.visible = False
		contBody2.grdDeposit.visible = True
		contBody2.Pannel0.visible = False
	else
		g_nViewMode2 = 0	 --Pannel
		contBody2.lblTitle.caption = "외화 추정 예수금"
		contBody2.imgViewMode.imgpath = "btn_view_list"
		contBody2.imgTooltip.visible = True
		contBody2.imgBg.visible = True
		contBody2.grdDeposit.visible = False
		contBody2.Pannel0.visible = True
	end
	
	nWidth = Form.GetTextWidth(contBody2.lblTitle.caption, 0, true, false)
	contBody2.imgTooltip.left = 10 + nWidth + 7
end

 --============================================================================
function Form_OnTimerEvent(sTimerID)
	if gf_Tonumber(sTimerID) == 1 then
		Calc_Data()
		
	elseif gf_Tonumber(sTimerID) == 2 then
		Form.SetTimerEvent2(gf_Tonumber(sTimerID), 0, 0)
		Call_Tran()
		
	elseif gf_Tonumber(sTimerID) == 3 then
		Form.SetTimerEvent(gf_Tonumber(sTimerID), 0, 0)
		
		if g_nViewMode == 1 then
			DATAMANAGER.RequestRealData("ohhts_exst_cntd_1")
			DATAMANAGER.RequestRealData("ohhts_exst_cntg_1")
			DATAMANAGER.RequestRealData("ohhts_exst_cnta_1")	 --v0001
		else
			DATAMANAGER.RequestRealData("ohhts_exst_cntd")
			DATAMANAGER.RequestRealData("ohhts_exst_cntg")
			DATAMANAGER.RequestRealData("ohhts_exst_cnta")	 --v0001
		end
		
	 --20240919_02 HWG START : 종합잔고 정렬기능 조정
	elseif gf_Tonumber(sTimerID) == 4 then
		Form.SetTimerEvent2(gf_Tonumber(sTimerID), 0, 0)
		
		contBody.grd0.toprow = g_szPrevIdx
		g_szPrevIdx = 0
	 --20240919_02 HWG END
	
	end
end

 --20250521_01 HWG START
function Form_OnDelayEvent(nID)
	if gf_Tonumber(nID) == 2 then
		Call_Tran()
		
	elseif gf_Tonumber(nID) == 3 then
		if g_nViewMode == 1 then
			DATAMANAGER.RequestRealData("ohhts_exst_cntd_1")
			DATAMANAGER.RequestRealData("ohhts_exst_cntg_1")
			DATAMANAGER.RequestRealData("ohhts_exst_cnta_1")	 --v0001
		else
			DATAMANAGER.RequestRealData("ohhts_exst_cntd")
			DATAMANAGER.RequestRealData("ohhts_exst_cntg")
			DATAMANAGER.RequestRealData("ohhts_exst_cnta")	 --v0001
		end
	elseif gf_Tonumber(nID) == 4 then
		contBody.grd0.toprow = g_szPrevIdx
		g_szPrevIdx = 0
	elseif gf_Tonumber(nID) == 5 then
		g_isDup = false
		
	end
end


 --============================================================================
function Form_OnTriggerEventSCREEN(sEventName,sParam)
	if g_isOpen == true then
		g_isOpen = false
		
		 --20240919_02 HWG START : 종합잔고 정렬기능 조정
		szTemp = Form.GetSharedData("16070_JANGO_INDEX", true)	
		if sEventName == "PREV" then
			if szTemp == "" then
				g_szPrevIdx = 0
			else
				g_szPrevIdx = szTemp
			end
		end
		 --20240919_02 HWG END
	end
end

 --============================================================================
function contBody_grd0_OnHeaderClickUp(lRow, szCellID)
	g_szSortIdx = g_szSortIdx + 1 
	if g_szSortIdx > 2 then
		g_szSortIdx = 0
	end
	
	if szCellID ~= g_szSortHeader then
		g_szSortHeader = szCellID
		g_szSortIdx = 0
	end
	
	 --v20251001_01 >>
 --	szData = replace(g_szSortHeader, "th_cell", "")
	
 --	if szData <> "" then
 --		szData = Cint(szData) - 1
 --		
 --		if szData > 50 then	'v20251001_01
 --			szData = szData - 50
 --		end if
 --		
 --		if szData > 2 then
 --			szData = szData - 2
 --		else 
 --			szData = 0
 --		end if
 --	end if
 --
 --	contBody.grd0.onSortingByScript(g_szSortHeader, szCellID, g_szSortIdx)

	contBody.grd0.OnSortingByScript(g_szSortHeader, Return_ColIdx(szCellID), g_szSortIdx)
	 --v20251001_01 <<
	
	Form.SetEnvData(1, "OVRS_JANGO_SORT_HEADER", g_szSortHeader)
	Form.SetEnvData(1, "OVRS_JANGO_SORT_IDX", g_szSortIdx)
end


