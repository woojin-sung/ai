 --============================================================================
function Call_Tran()
	 --20250521_01 HWG START
	g_isDup = true
	
	Form.SetDelayEvent(5, 1)
	
	 --20250317_01 HWG START : 해외주식 종합잔고 실시간 계산 로직 개선
	DATAMANAGER.CancelRealData("ohhts_exst_cntg")
	DATAMANAGER.CancelRealData("ohhts_exst_cntg_1")
	DATAMANAGER.CancelRealData("ohhts_exst_cntd")
	DATAMANAGER.CancelRealData("ohhts_exst_cntd_1")
	
	 --v0001 >>
	DATAMANAGER.CancelRealData("ohhts_exst_cnta")
	DATAMANAGER.CancelRealData("ohhts_exst_cnta_1")
	 --v0001 <<
	 --20250317_01 HWG END
	
	Form.SetTimerEvent(1, 0, 0)
	
	g_szAcno = string.sub(acnt1.caption, 1, 8)
	g_szAsno = string.sub(acnt1.caption, -2)
	
	DATAMANAGER.SetDataValue(0, "obtro_oder_265r", "InBlock1", "ACNO"                 , 0 , g_szAcno)
	DATAMANAGER.SetDataValue(0, "obtro_oder_265r", "InBlock1", "ASNO"                 , 0 , g_szAsno)
	DATAMANAGER.SetDataValue(0, "obtro_oder_265r", "InBlock1", "DYTM_TR_CLPR_APLY_YN" , 0 , g_szDytmYN)
	
	szChk0 = "N"
	szChk1 = "N"
	szChk2 = "N"
	szChk3 = "1"
	
	if contBody.chk0.checkstate == "1" or gf_Tonumber(contBody.chk0.checkstate) == 1 then --비용포함
		szChk0 = "Y"
	else
		szChk0 = "N"
	end
		
	if contBody.chk1.checkstate == "1" or gf_Tonumber(contBody.chk1.checkstate) == 1 then --대출합산
		szChk1 = "2"
	else
		szChk1 = "1"
	end

	if contBody.chk2.checkstate == "1" or gf_Tonumber(contBody.chk2.checkstate) == 1 then --정규종가
		szChk2 = "N"
	else
		szChk2 = "Y"
	end

	
	DATAMANAGER.SetDataValue(0, "obtro_oder_265r", "InBlock1", "FEE_INCU_YN"	  , 0 , 		szChk0)
	DATAMANAGER.SetDataValue(0, "obtro_oder_265r", "InBlock1", "DYTM_TR_CLPR_APLY_YN", 0 , 	szChk2) 
	
	DATAMANAGER.SetDataValue(0,"obtro_oder_265r", "InBlock1", "IQRY_CLS_CODE" , 0 , 	szChk1)  --v004
	DATAMANAGER.SetDataValue(0,"obtro_oder_265r", "InBlock1", "UI_IQRY_COND_CNTT" , 0 , g_szCrCd)  --v004
	
	
		
	DATAMANAGER.RequestTranData("obtro_oder_265r")
	
	contBody.grd0.SetClear()
	
	 --v002
	if gf_Tonumber(rdoGbn.currentindex) == 0 then
 --		'해외주식잔고 TAB
		contBody.visible = true
		contBody2.visible = false
		DisplaySetting_Grid()
		
		RequestMarketInfo()  --20250703 YSH : 해외주식 장운영 정보 조회방식 변경
		
	elseif gf_Tonumber(rdoGbn.currentindex) == 1 then
		contBody.visible = false
		contBody2.visible = true
		 --외화예수금 TAB
		Request_Tran_obtro_oder_266r()
	else
		Form.ShowAlert("Error", "유효하지않은 탭입니다.")
		return
	end
end

 --============================================================================
function btnRefresh_OnClick()
	if g_isDup == true then
		return 
	end
	
	Call_Tran()
end

