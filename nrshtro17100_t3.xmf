function Form_OnDelayEvent(nID)
	if gf_Tonumber(nID) == 1 then
		AutoRule_SelectOrderHistory() 
	elseif gf_Tonumber(nID) == 2 then
		DATAMANAGER.RequestTranData("obtro_oder_268r")
	elseif gf_Tonumber(nID) == 3 then
		contToast.visible = false
		contToast.left = 500
	end
end

 --============================================================================
function Form_OnTriggerEvent(sEventName, sParam, sParam2)

	if sEventName ==  "TOKEN_SUCCESS" or sEventName ==  "TAB_CHANGE" then
		if isEmpty(sParam) == false then
			arrData = Convert_StrToArr(sParam, "`")
			nArrCnt = #arrData
			
			if nArrCnt > 2 then
				g_sAcno = arrData[0+1]
				g_sAsno = arrData[1+1]
				g_sAccName = arrData[2+1]
			end
			
			if nArrCnt > 3 then
				g_sPwd = arrData[3+1]
			end
		end
		
		g_sOrderGbn = Form.GetSharedData("17100_T3_ORDER_GBN" , false)
		g_sResultGbn = Form.GetSharedData("17100_T3_RESULT_GBN" , false)
		
		sFilter = ""
		nCnt_Total = 0
		
		if isEmpty(g_sOrderGbn) == false then
			sFilter = Return_OrderText(g_sOrderGbn)
			
			g_szSaveFilterData1 = Return_OrderText(g_sOrderGbn)
			
			if Return_OrderText(g_sOrderGbn) == "전체" then
				nCnt_Total = nCnt_Total + 1
			end
		else
			sFilter = "전체"
		end
		
		if isEmpty(g_sResultGbn) == false then
			if isEmpty(sFilter) == true then
				sFilter = Return_ResultText(g_sResultGbn)
			else
				if Return_ResultText(g_sResultGbn) == "감시종료(주문미실행)" or Return_ResultText(g_sResultGbn) == "전체(종료제외)" or Return_ResultText(g_sResultGbn) == "주문취소" then
					sFilter = sFilter .. "ㆍ\n" .. Return_ResultText(g_sResultGbn)
				else
					sFilter = sFilter .. "ㆍ" .. Return_ResultText(g_sResultGbn)
				end
			end
			
			g_szSaveFilterData2 =  Return_ResultText(g_sResultGbn)
			
			if Return_ResultText(g_sResultGbn) == "전체" then
				nCnt_Total = nCnt_Total + 1
			end
		else
			if isEmpty(sFilter) == true then
				sFilter = "필터"
			else
				sFilter = sFilter .. "ㆍ전체"
			end
		end
		
		if nCnt_Total == 2 or sFilter == "전체ㆍ전체" then
			sFilter = "필터"
		end
		
		LabelFilter.fontsize = -2
		LabelFilter.maxlinecnt = "2"
		LabelFilter.caption = "1"
		LabelFilter.caption = sFilter
		
		sCode = Form.GetSharedData("17100_T3_ITEMCODE" , false)
 --		if isEmpty(sCode) == false then
 --			Check_ItemCode(sCode)
 --		end if
		
 --		sDate = Form.GetSharedData("17100_T3_CALENDAR" , false)
 --		
 --		if isEmpty(sDate) == false then
 --			Calendar0.caption = sDate
 --			
 --			sDateBase = Form.GetSharedData("17100_T3_CALENDAR_BASE" , false)
 --			if isEmpty(sDateBase) == false then
 --				Calendar1.caption = sDateBase
 --			end if
 --		else
 --			sCal = CalcDate("d",-30)
 --			Calendar0.caption = sCal
 --		end if

		Calendar1.caption = CalcDate("d",0)
		Calendar0.caption = CalcDate("d",-30)
		
		sChk = Form.GetSharedData("17100_T3_CHK0" , false)
		sChk = Form.GetEnvData("17100_T3_CHK0")
		if isEmpty(sChk) == false then
			chk0.chksilence = sChk
			g_isFst = true
			
			if sChk == "1" then
				chk0_OnChange(sChk)
			else
				g_isFst = false
				AutoRule_SelectOrderHistory() 
			end
		else
			AutoRule_SelectOrderHistory() 
		end
		
		
 --		Form.SetDelayEvent(1, 0.2)
 --		AutoRule_SelectOrderHistory() 
	end
	
	if sEventName ==  "ACCT_CHANGE" then
		if isEmpty(sParam) == false then
			arrData = Convert_StrToArr(sParam, "`")
			nArrCnt = #arrData
			
			if nArrCnt > 2 then
				g_sAcno = arrData[0+1]
				g_sAsno = arrData[1+1]
				g_sAccName = arrData[2+1]
			end
			
			if nArrCnt > 3 then
				g_sPwd = arrData[3+1]
			end
		end
		
		AutoRule_SelectOrderHistory() 
	end
	
	if sEventName ==  "REFRESH_LIST" then
		if isEmpty(sParam) == false then
			arrData = Convert_StrToArr(sParam, "`")
			nArrCnt = #arrData
			
			if nArrCnt > 2 then
				g_sAcno = arrData[0+1]
				g_sAsno = arrData[1+1]
				g_sAccName = arrData[2+1]
			end
			
			if nArrCnt > 3 then
				g_sPwd = arrData[3+1]
			end
		end
		
		AutoRule_SelectOrderHistory() 
	end
	
	if gf_Tonumber(string.find(sEventName, "RESTAPI_RETURN_ORDER_LIST")) > 0 then
		sStep = string.gsub(sEventName, "RESTAPI_RETURN_ORDER_LIST_", "")  --g_sStep
		g_sStep = ""
		
 --		if sParam ~= "SUCCESS" then
 --			oError = Form.ResponseRestAPI("JSONOBJ", 0, "error", sParam2)
 --			
 --			if isEmpty(oError) == false then
 --				errorCode = Form.ResponseRestAPI("DATA", 0, "errorCode", oError)
 --
 --				if errorCode == "INVALID_TOKEN" then
 --					g_sStep_Prev = sStep
 --					IssueToken() 
 --					return 
 --				end if
 --			end if
 --		end if
		
		 ------------------------------------------
		 -- 서버 검증용 토큰 발급
		 ------------------------------------------
		if sStep == "ISSUE_TOKEN" then
		
			 ------------------------------------------
			 -- 성공
			 ------------------------------------------
			if sParam == "SUCCESS" then
			
				data = Form.ResponseRestAPI("JSONOBJ", 0, "data", sParam2)
				
				accessToken = Form.ResponseRestAPI("DATA", 0, "accessToken", data)
				refreshToken = Form.ResponseRestAPI("DATA", 0, "refreshToken", data)
				
				if isEmpty(accessToken) == false then
					Form.SetSharedData("..REST_API_TOKEN", " Bearer " .. accessToken )
				end
				
				if isEmpty(refreshToken) == false then
					Form.SetSharedData("..REST_API_REFRESH_TOKEN", " Bearer " .. refreshToken )
				end
				
				if g_sStep_Prev == "SELECT_ORDER_HISTORY" then
					AutoRule_SelectOrderHistory()
				end
				
			 ------------------------------------------
			 -- 실패(ERROR or EXCEPTION)
			 ------------------------------------------
			else
				Form.MsgBox("알림", "현재 자동감시주문 실행이 불가합니다.\n고객지원센터에 문의해주세요.", "CLOSE_FORM", 6)
			end
			
			g_sStep_Prev = ""
		
		elseif sStep == "SELECT_ORDER_HISTORY" or sStep == "SELECT_ORDER_HISTORY_NEXT" then
			 ------------------------------------------
			 -- 성공
			 ------------------------------------------
			if sParam == "SUCCESS" then
				
				if sStep == "SELECT_ORDER_HISTORY" then
					g_sNextKey = ""
					Grid0.SetClear()
					Grid0.rowcount = 0
					Grid0.InitScrollX()
				end
				 ----------------------
				 -- 응답데이터(전체)
				 ----------------------
				oData = Form.ResponseRestAPI("JSONOBJ", 0, "data", sParam2)	
				
				 ----------------------
				 -- ROW COUNT
				 ----------------------
				nDataCnt = Form.ResponseRestAPI("DATA", 0, "dataCount", oData)
				
				 ----------------------
				 -- NEXT KEY
				 ----------------------
				shasNext = Form.ResponseRestAPI("DATA", 0, "hasNext", oData)
				
				if shasNext == true or shasNext == "true" or shasNext == "1" then
					g_sNextKey = Form.ResponseRestAPI("DATA", 0, "nextKey", oData)
				else
					g_sNextKey = ""
				end

				if gf_Tonumber(nDataCnt) > 0 then
					for i = 0, gf_Tonumber(nDataCnt) - 1 do
					
						 ----------------------
						 -- ROW DATA
						 ----------------------
						oListData = Form.ResponseRestAPI("JSONLIST", i, "data", oData)
						
						 ----------------------
						 -- 내역 정보
						 ----------------------
						orderConditionId 	= Form.ResponseRestAPI("DATA", 0, "orderConditionId", 	oListData)
						registrationDate 	= Form.ResponseRestAPI("DATA", 0, "registrationDate", 	oListData)
						accountNumber		= Form.ResponseRestAPI("DATA", 0, "accountNumber", 		oListData)
						accountSeqNumber	= Form.ResponseRestAPI("DATA", 0, "accountSeqNumber", 	oListData)
						stockExchangeCode	= Form.ResponseRestAPI("DATA", 0, "stockExchangeCode", 	oListData)
						stockExchangeName	= Form.ResponseRestAPI("DATA", 0, "stockExchangeName", 	oListData)
						stockCode			= Form.ResponseRestAPI("DATA", 0, "stockCode", 			oListData)
						stockKoreaName		= Form.ResponseRestAPI("DATA", 0, "stockKoreaName", 		oListData)
						tradeType			= Form.ResponseRestAPI("DATA", 0, "tradeType", 			oListData)
						procResultName		= Form.ResponseRestAPI("DATA", 0, "procResultName", 		oListData)
						watchBasePrice		= Form.ResponseRestAPI("DATA", 0, "watchBasePrice", 		oListData)
						watchCondition		= Form.ResponseRestAPI("DATA", 0, "watchCondition", 		oListData)
						orderPaymentType	= Form.ResponseRestAPI("DATA", 0, "orderPaymentType", 	oListData)
						orderClsType		= Form.ResponseRestAPI("DATA", 0, "orderClsType", 		oListData)
						orderClsTypeNm		= Form.ResponseRestAPI("DATA", 0, "orderClsTypeNm", 		oListData)
						orderPriceType		= Form.ResponseRestAPI("DATA", 0, "orderPriceType", 		oListData)
						orderPrice			= Form.ResponseRestAPI("DATA", 0, "orderPrice", 		oListData)
						orderPriceDesc		= Form.ResponseRestAPI("DATA", 0, "orderPriceDesc", 		oListData)
						orderQty			= Form.ResponseRestAPI("DATA", 0, "orderQty", 			oListData)
						expirationDate		= Form.ResponseRestAPI("DATA", 0, "expirationDate", 		oListData)
						cntgQty			= Form.ResponseRestAPI("DATA", 0, "cntgQty", 			oListData)
						cntgCamt			= Form.ResponseRestAPI("DATA", 0, "cntgCamt", 			oListData)
						orderResponseCode	= Form.ResponseRestAPI("DATA", 0, "orderResponseCode", 	oListData)
						orderMsg			= Form.ResponseRestAPI("DATA", 0, "orderMsg", 			oListData)
						orderNo			= Form.ResponseRestAPI("DATA", 0, "orderNo", 			oListData)
						orderDate			= Form.ResponseRestAPI("DATA", 0, "orderDate", 			oListData)
						canModifyYn		= Form.ResponseRestAPI("DATA", 0, "canModifyYn", 		oListData)
						
						 ----------------------
						 -- ADD ROW
						 ----------------------
						Grid0.AddRow()
						nIdx = gf_Tonumber(Grid0.rowcount) - 1 
						
						 ----------------------
						 -- ROW DATA 저장
						 ----------------------
						DisplaySet_Pannel(nIdx, orderConditionId, registrationDate, accountNumber, accountSeqNumber, stockExchangeCode, stockExchangeName,
						stockCode, stockKoreaName, tradeType, procResultName, watchBasePrice, watchCondition, orderPaymentType, orderClsType, orderClsTypeNm,
						orderPriceType, orderPrice, orderPriceDesc, orderQty, expirationDate, cntgQty, cntgCamt, orderResponseCode, orderMsg, orderNo, orderDate, canModifyYn)
						
					end
				end
				
			 ------------------------------------------
			 -- 실패(ERROR or EXCEPTION)
			 ------------------------------------------
			else
 --				oError = Form.ResponseRestAPI("JSONOBJ", 0, "error", "")
 --			
 --				if isEmpty(oError) == false then
 --					errorCode = Form.ResponseRestAPI("DATA", 0, "errorCode", oError)
 --					errorMessage = Form.ResponseRestAPI("DATA", 0, "errorMessage", oError)
 --					
 --					if isEmpty(errorMessage) == false then
 --						Form.ShowAlert("알림", errorMessage)
 --						return 
 --					end if
 --				end if
				
				Form.ShowAlert("알림", g_sCommonErrorMsg)
			end
			
			nRowCnt = gf_Tonumber(Grid0.rowcount)
				
			if nRowCnt > 0 then
				DisplaySet_EmptyNotice(false)
			else
				DisplaySet_EmptyNotice(true)
			end
			
			g_isClick = false
		end
	end
	
	
	if sEventName ==  "ACCT_PWD_CHECK" then
		sRet = ""
		if isEmpty(sParam) == false then
			arrData = Convert_StrToArr(sParam, "`")
			nArrCnt = #arrData
			
			if nArrCnt > 1 then
				sRet = arrData[0+1]
				g_sPwd = arrData[1+1]
			else
				sRet = sParam
			end
		end
		
		if sRet == "SUCCESS" then
			sAcno 	= g_sAcno  --Form.GetTopCtlProp("act0","total")
			sAsno 	= g_sAsno  --Form.GetTopCtlProp("act0","sequence")
			
			sAcntNm 	= g_sAccName  --Form.GetTopCtlProp("act0","accountname")
			
			sPwd 	= g_sPwd	 --Form.GetTopCtlProp("edtPwd","caption")
			
			sLinkData = "1"
			sLinkData = sLinkData .. "`" .. sAcno
			sLinkData = sLinkData .. "`" .. sAsno
			sLinkData = sLinkData .. "`" .. sPwd
			sLinkData = sLinkData .. "`" .. sAcntNm
			
			if g_isModify == true then
				sLinkData = sLinkData .. "`" .. g_sModifyInfo
				
				g_sModifyInfo = ""
				g_isModify = false
			end

			Form.OpenPopup("nrshtro17100_p2" , sLinkData , "")
		end
	end
end
 --============================================================================
function Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName == "COMPLETE_ORDER" then
		AutoRule_SelectByAccount() 
		
	elseif sKeyName == "INFO_DELETE" then
		AutoRule_SelectByAccount() 
		
	elseif sKeyName == "INFO_MODIFY" then
		g_isModify = true
		g_sModifyInfo = sRet
		
		Form.TriggerEvent("#", "CHECK_ACCT_PWD", "")
	elseif sKeyName == "DLG_SELECT" then
		Check_ItemCode(sRet)
		
		AutoRule_SelectOrderHistory()
		
	elseif sKeyName == "17100_RETURN_DATA_HISTORY" then
		arrLinkData = Convert_StrToArr(sRet, "★")
		nArrCnt = #arrLinkData
		
		sFilter = ""
		nCnt_Total = 0
		if nArrCnt > 0 then
			g_sOrderGbn = Return_OrderCode(arrLinkData[0+1])
			Form.SetSharedData("17100_T3_ORDER_GBN" , g_sOrderGbn)
			sFilter = arrLinkData[0+1]
			
			g_szSaveFilterData1 =  arrLinkData[0+1]
			
			if arrLinkData[0+1] == "전체" then
				nCnt_Total = nCnt_Total + 1
			end
		end
		
		if nArrCnt > 1 then
			g_sResultGbn = Return_ResultCode(arrLinkData[1+1])
			Form.SetSharedData("17100_T3_RESULT_GBN" , g_sResultGbn)
			if isEmpty(sFilter) == true then
				sFilter = arrLinkData[1+1]
			else
				if Return_ResultText(g_sResultGbn) == "감시종료(주문미실행)" or Return_ResultText(g_sResultGbn) == "전체(종료제외)" or Return_ResultText(g_sResultGbn) == "주문취소" then
					sFilter = sFilter .. "ㆍ\n" .. arrLinkData[1+1]
				else
					sFilter = sFilter .. "ㆍ" .. arrLinkData[1+1]
				end
				
			end
			
			g_szSaveFilterData2 =  arrLinkData[1+1]
			
			if arrLinkData[1+1] == "전체" then
				nCnt_Total = nCnt_Total + 1
			end
		end
		
		if nCnt_Total == 2 then
			sFilter = "필터"
		end
		
		LabelFilter.fontsize = -2
		LabelFilter.maxlinecnt = "2"
		LabelFilter.caption = "1"
		LabelFilter.caption = sFilter
		
		
		AutoRule_SelectOrderHistory()
		
	elseif sKeyName == "MOVEPOPUP_RETURN" then
		 --sRet = 선택행인덱스★이동화면 구분값 
		arrData = gf_Split(sRet,"★")
		
		sIndex = arrData[0+1]
		sGubun = arrData[1+1]
		
		if sIndex ~= "" and sGubun ~= "" then
			MoveScreen(sGubun,sIndex)
		end
	end
end

function Return_OrderCode(sCode)
	-- SELECT CASE 변환 (수동 보정 필요)
		if sCode == "전체" then
			return ""
			
		elseif sCode == "매도" then
			return "1"
			
		elseif sCode == "매수" then
			return "2"
			
		else
			return ""
	end
end

function Return_OrderText(sCode)
	-- SELECT CASE 변환 (수동 보정 필요)
		if sCode == "" then
			return "전체"
			
		elseif sCode == "1" then
			return "매도"
			
		elseif sCode == "2" then
			return "매수"
			
		else
			return "전체"
	end
end

function Return_ResultCode(sCode)
	-- SELECT CASE 변환 (수동 보정 필요)
		if sCode == "전체" or sCode == "전체(종료포함)" then
			return ""
			
		elseif sCode == "전체(종료제외)" then
			return "0"
			
		elseif sCode == "주문실행" or sCode == "주문" then
			return "1"
			
		elseif sCode == "주문체결" or sCode == "체결" then
			return "2"
		
		elseif sCode == "거부" or sCode == "주문거부" then
			return "3"
			
		elseif sCode == "주문취소" or sCode == "취소" then
			return "4"
		
		elseif sCode == "감시종료(주문미실행)" or sCode == "감시종료" then
			return "5"
			
		else
			return ""
	end
end

function Return_ResultText(sCode)
	-- SELECT CASE 변환 (수동 보정 필요)
		if sCode == "" then
			return "전체"
			
		elseif sCode == "0" then
			return "전체(종료제외)"
			
		elseif sCode == "1" then
			return "주문"
			
		elseif sCode == "2" then
			return "체결"
		
		elseif sCode == "3" then
			return "거부"
			
		elseif sCode == "4" then
			return "주문취소"
			
		elseif sCode == "5" then
			return "감시종료(주문미실행)"
			
		else
			return ""
	end
end


 --============================================================================
 -- 마스터파일에 있는 종목인지 체크
 --============================================================================
function CheckMasterFile(szCode)
	if szCode == "" or szCode == nil then
		return false
	end
	arrCode = gf_Split(szCode,"@")
	
	if #arrCode < 2 then
		return false
	end
	
	g_sMarket = arrCode[0+1]
	
	szTransExidCode = Transform_Exid2(arrCode[0+1])
	szTransItemCode = szTransExidCode .. "@" .. arrCode[1+1]
	szCheckData = Form.GetItemCodeInfo(szTransItemCode, "exchid")
	
	if szCheckData == "" or szCheckData == nil then
		return false
	end
	
	return true
	
end

 --==============================================
 -- 종목코드 변경 
 --==============================================
function Check_ItemCode(szCode)
	arrLinkCode = gf_Split(szCode,"★")
	
	if #arrLinkCode < 1 then
		return
	end
	
	szCheckData = Form.GetItemCodeInfo(arrLinkCode[0+1], "name")
	szCheckData2 = Form.GetItemCodeInfo(arrLinkCode[0+1], "enablefst")
	
	 --종목정보 확인 (name 없는 경우, 마스터 파일에 없다고 판단)
	if CheckMasterFile(arrLinkCode[0+1]) == false then
		return
	end
	
	 --------------------------------------------------------
	 -- 종목코드 분리 (거래소코드@종목코드)
	 --------------------------------------------------------
	arrCode = gf_Split(arrLinkCode[0+1], "@")
	
	if #arrCode > 1 then
		Form.SetSharedData("17100_T3_ITEMCODE" , arrLinkCode[0+1])
		g_sCode = arrCode[1+1]		
		g_sExid = Transform_Exid2(arrCode[0+1])
		g_sMarket = Transform_Exid3(arrCode[0+1])
		g_sItemCode = g_sExid .. "@" .. g_sCode
		
		g_sNation 	= Form.GetItemCodeInfo(g_sItemCode, "ovsnation")  --국가구분 코드
		g_sExid2 	= Form.GetItemCodeInfo(g_sItemCode, "exchcode3")  --거래소 구분코드
		g_sExid3	= Form.GetItemCodeInfo(g_sItemCode, "exchid")
		g_sItemName = Form.GetItemCodeInfo(g_sItemCode, "name")
		
		sTicker = Form.GetEnvData("common.ticker_text")
		
		if g_sExid == "AX" or g_sExid == "NY" or g_sExid == "OQ" then
			if sTicker == "1" then
				lblItemName.caption = g_sItemName
			elseif sTicker == "2" then
				lblItemName.caption = g_sCode
			else
				sName = g_sItemName
				
				if Form.GetItemCodeInfo(g_sItemCode, "etfyn") == "Y" then
					sName = g_sCode
				end
				
				lblItemName.caption = sName
			end
		else
			lblItemName.caption = g_sItemName
		end
		
		Image1.visible = true
	else
		return
	end
end

 --==============================================
 -- 거래소 구분코드 변경(3자리 -> 2자리)
 -- 원장조회 종목연동 시, 과거 거래소 코드로 연동되는 경우 예외처리를 위해 필요
 --==============================================
function Transform_Exid2(sValue)
	if sValue == "HKS" then
		return "HK"
	elseif sValue == "SHS" then
		return "SH"
	elseif sValue == "SZS" then
		return "SZ"
	elseif sValue == "NYS" then
		return "NY"
	elseif sValue == "AMX" then
		return "AX"
	elseif sValue == "NAS" then
		return "OQ"
	elseif sValue == "TSE" then
		return "JP"
	else
		return sValue
	end
end

function Transform_Exid3(sValue)
	if sValue == "HK" then
		return "HKS"
	elseif sValue == "SH" then
		return "SHS"
	elseif sValue == "SZ" then
		return "SZS"
	elseif sValue == "NY" then
		return "NYS"
	elseif sValue == "AX" then
		return "AMX"
	elseif sValue == "OQ" then
		return "NAS"
	elseif sValue == "JP" then
		return "TSE"
	else
		return sValue
	end
end


 --============================================================================
 -- From일로부터 + @일/개월 가져오기
 --============================================================================
function CalcDate(sType,nDiff)
	
	sDate = Form.GetSharedData("&HOST_DATE", false )
	sYear = string.sub(sDate, 1, 4)
	sMonth = string.sub(sDate, 5, 5 + 2 - 1)
	sDay = string.sub(sDate, -2)
	
	sRsltDate = string.gsub(gf_DateAdd(sType, nDiff, sYear.."-".. sMonth .."-".. sDay), "-", "")
	return sRsltDate

end

