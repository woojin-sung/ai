 --****************************************************************************
 --            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N              
 --****************************************************************************
 --===============================================
 -- nil 체크 
 --===============================================
function isEmpty(sData)
	if gf_Trim(sData) == "" or sData == nil or gf_Trim(sData) == "nil" then
		return true
	else
		return false
	end
end

 --===============================================
 -- 숫자 소수점 절사 함수
 --===============================================
function truncateToDecimalPlaces(nVal, nDeimalPlaces)
	nVal = gf_Tonumber(nVal)
	nFactor = 10 ^ nDeimalPlaces
	szNumStr = gf_CommaValue(nVal*nFactor,12,0,0,0,1)
	nDecimalIdx = string.find(szNumStr, ".")
	
	nTotalData = 0
	if gf_Tonumber(nDecimalIdx) > 0 then
		nTotalData = gf_Tonumber(string.sub(szNumStr, 1, gf_Tonumber(nDecimalIdx)-1))
	else
		nTotalData = gf_Tonumber(szNumStr)
	end

	return nTotalData / nFactor
end

 --===============================================
 -- (NonNull) 문자열 -> 배열 변환함수
 --===============================================
function Convert_StrToArr(szData, szSeperator)

	local arrData
	
	 ----------------------------------------------
	 -- 링크데이터 값 체크
	 ----------------------------------------------
	if isEmpty(szData) then
		arrData = {}
		return arrData
	end
	
	 ----------------------------------------------
	 -- 구분자 값 체크
	 ----------------------------------------------
	if isEmpty(szSeperator) then
		 -- 단일변수
		arrData = {}
		Table.Insert(arrData, szData)
	else
		 -- 다중변수
		arrData = gf_Split(szData, szSeperator)
	end
	
	return arrData
	
end

function AutoRule_SelectOrderHistory()
	g_sStep = "SELECT_ORDER_HISTORY"
	
	sAcno 	= g_sAcno  --Form.GetTopCtlProp("act0","total")
	sAsno 	= g_sAsno  --Form.GetTopCtlProp("act0","sequence")
	
	Form.ReleaseRequestData()
	
	sCode = g_sCode
	
	g_sNextKey = ""
	Grid0.SetClear()
	Grid0.rowcount = 0
	Grid0.InitScrollX()
	
	Form.MakeRequestData("accountNumber", sAcno)
	Form.MakeRequestData("accountSeqNumber", sAsno)
	Form.MakeRequestData("dataTargetType", "2")
	Form.MakeRequestData("queryStartDate", Calendar0.caption)
	Form.MakeRequestData("queryEndDate", Calendar1.caption)
	
	if isEmpty(sCode) == false then
		Form.MakeRequestData("stockCode", sCode)
	end
	
	if isEmpty(g_sOrderGbn) == false then
		Form.MakeRequestData("tradeType", g_sOrderGbn)
	end
	
	if isEmpty(g_sResultGbn) == false then
		Form.MakeRequestData("procResultType", g_sResultGbn)
	end
	
	sState = chk0.checkstate
	if isEmpty(sState) == false and sState == "1" then
		Form.MakeRequestData("todayFlagType", sState)
	end

	
	if isEmpty(g_sNextKey) == false then
		Form.MakeRequestData("nextKey", g_sNextKey)
	end
	
	Form.MakeRequestData("pageInfo", "20")
	
	sDev = Form.GetSharedData("&SERVER_MODE", false)
	sUrl = ""
	if sDev == "1" then --개발기 end
		sUrl = "https://dev-api-gateway.imeritz.com:8443/"
	else
		sUrl = "https://api-gateway.imeritz.com:8443/"
	end
		
	Form.RequestRestAPI(sUrl.."api/v1/rule/select-order-history", "ORDER_LIST_"..g_sStep)
end

