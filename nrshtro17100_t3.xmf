 --============================================================================
function OpenMovePopup(nIndex)

	 ----------------------------------------------
	 --무브팝업 화면에 넘겨줄 데이터 가져옴
	 ----------------------------------------------
	listLocation =  gf_Split(Grid0.location,":")
	
	nYPos = Int(listLocation[1+1])
	nHeight = listLocation[3+1]

	sIndex 		= nIndex
	sName 		= Grid0.GetCellData("bd_cell15", nIndex)
	sCode 		= Grid0.GetCellData("bd_cell16", nIndex)
	sVndrCode 		= Grid0.GetCellData("bd_cell11", nIndex)
	sCanMod		= Grid0.GetCellData("bd_cell12", nIndex)
	
	sExid		= Transform_Exid2(sVndrCode)
	sExid3		= Form.GetItemCodeInfo(sExid.."@"..sCode, "exchid")
	
	sResult       = Grid0.GetCellData("bd_cell2", nIndex)
	sResultCode   = Return_ResultCode(sResult)
	
	if sExid == "" then
		 --Form.ShowAlert("알림", "해당 종목은 온라인에서\n거래가 불가합니다.\n\n영업점 또는 해외주식 데스크로 문의해주세요")
		return
	end
	
	szData = "OVRS_ODER_JANGO" .. "★" .. nYPos .. "★" .. nHeight .. "★" .. sIndex .. "★" .. sName .. "★" .. sCode .. "★" .. sExid3 .. "★" .. sResultCode  .. "★" .. sCanMod 

	
	 ----------------------------------------------
	 --무브팝업 오픈
	 ----------------------------------------------
	Form.OpenPopup("nrshtro17100_pmove" , szData , "")
	

end

function MoveScreen(sGubun,sIndex)

	local nIndex
	nIndex = gf_Tonumber(sIndex)
	
	szName 		= Grid0.GetCellData("bd_cell15", nIndex)
	
	sCode 		= Grid0.GetCellData("bd_cell16", nIndex)
	sVndrCode 		= Grid0.GetCellData("bd_cell11", nIndex)
	
	sCanMod		= Grid0.GetCellData("bd_cell12", nIndex)
	
	sResultGbn 	= Grid0.GetCellData("bd_cell2", nIndex)
	
	sExid		= Transform_Exid2(sVndrCode)
	sExid3		= Form.GetItemCodeInfo(sExid.."@"..sCode, "exchid")
	szItemCode = sExid.."@"..sCode

	if sExid == "" then
 --		Form.ShowAlert("알림", "해당 종목은 온라인에서\n거래가 불가합니다.\n\n영업점 또는 해외주식 데스크로 문의해주세요")
		return
	end

 --	showalert  szItemCode .. "|" .. szName .. "|" .. sJangoGubun .. "|" .. sOrdAbleQty .. "|" .. sLoanType .. "|" .. sLoanDate .. "|" .. sLoanSrno
	Form.SetSharedData( "..ITEM_CODE" , szItemCode)
	Form.SetSharedData( "..ITEM_KORNAME" , szName  )	
	Form.SetSharedData( "..ITEM_OVERSTOCK", szItemCode.."★"..szName.."★".."", "" )			
	Form.SendMessageToMain( "CHANGE_ITEMCODE_OVERSTOCK", szItemCode.."★"..szName.."★".."", "" )
	
	 --------------------------------------
	 -- [현재가] : 종목연동
	 --------------------------------------
	if sGubun == "MOVE_HYUN" then
		if szItemCode ~= "" then
			Form.OpenScreen("16000", "")	
		end
	
	 --------------------------------------
	 -- [차트] : 종목연동
	 --------------------------------------
	elseif sGubun == "MOVE_CHART" then
		if szItemCode ~= "" then
			Form.OpenScreen("16020", "")
		end
	
	 --------------------------------------
	 -- [매수] : 종목연동
	 --------------------------------------
	elseif sGubun == "MOVE_MOD" then
		
		if sResultGbn == "주문" and sCanMod == "1" then
			if szItemCode ~= "" then
				Form.OpenScreen("16060", "2")
			end
		else
			Form.OpenScreen("16074", "")
		end
		
