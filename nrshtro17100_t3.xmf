function IssueToken()
	g_sStep = "ISSUE_TOKEN"
	
	Form.ReleaseRequestData()
	
	sData0  = Form.GetSharedData("&MEDIA_CODE", false )
	sData1  = Form.GetSharedData("&USER_ID", false )
	sData2  = Form.GetSharedData("&MCI_SESSION_KEY", false )
	sData3  = Form.GetSharedData("&SEMI_SSO_KEY", false )
	
	Form.MakeRequestData("channelClsCode", 	sData0)
	Form.MakeRequestData("userId", 			sData1)
	Form.MakeRequestData("sessionKey", 		sData2)
	Form.MakeRequestData("semiSsoKey", 		sData3)
	
	sDev = Form.GetSharedData("&SERVER_MODE", false)
	sUrl = ""
	if sDev == "1" then --개발기 end
		sUrl = "https://dev-api-gateway.imeritz.com:8443/"
	else
		sUrl = "https://api-gateway.imeritz.com:8443/"
	end
	
	Form.RequestRestAPI(sUrl.."auth/issue-token", "ORDER_LIST_"..g_sStep)
end

