 --============================================================================
function Grid0_OnScrollEnd()
	if isEmpty(g_sNextKey) == false then
		AutoRule_SelectOrderHistory_Next()
	end
end

 --============================================================================
function Form_OnFormInit()
	LabelFilter.maxlinecnt = "2"
	lblItemName.maxlinecnt = "1"
	
	contToast.LabelText.caption = "00:00 ~ After 시간에 당일 버튼 클릭 시 미국 현지일 기준으로 조회되어 정규장에 실행된 전체 내역을 확인 할 수 있어요."
	
 --	Form.SetDelayEvent(2, 0.2)
end

 --============================================================================
 -- 비용포함 체크 시, 안내메시지 보임여부
 --============================================================================
function SetShowToast(bShow)
	
	if g_isFst == false then
		if bShow then
			contToast.left = 30
			contToast.visible = true
			
			Form.SetDelayEvent(3, 5)
		else
			contToast.visible = false
			contToast.left = 500
		end
	end

end



 --============================================================================
function DATAMANAGER_OnSendTranBefore(szTranID)
	 ------------------------------------------
	 -- 미국장 영업일 조회
	 ------------------------------------------
	if szTranID == "obtro_comn_005r" then
		DATAMANAGER.ClearInputData(0, "obtro_comn_005r")
		
		DATAMANAGER.SetDataValue(0, "obtro_comn_005r", "InBlock1", "OVRS_STCK_MRKT_TR_CLS_CODE", 0 ,  "01")	 --미국 거래소로 고정
	elseif szTranID == "obtro_oder_268r" then
		DATAMANAGER.ClearInputData(0, "obtro_oder_268r")
		
		DATAMANAGER.SetDataValue(0, "obtro_oder_268r", "InBlock1", "OVRS_STCK_MRKT_TR_CLS_CODE"		, 0, "01")		 -- 해외주식시장 거래구분코드 : 미국
		DATAMANAGER.SetDataValue(0, "obtro_oder_268r", "InBlock1", "OVRS_MKOP_CLS_CODE"				, 0, "005")		 -- 해외장 운영구분코드 : 정규장+에프터
		
	end
end

 --============================================================================
function DATAMANAGER_OnReceiveTranComplete(szTranID)
	 ------------------------------------------
	 -- 미국장 영업일 조회
	 ------------------------------------------
	if szTranID == "obtro_comn_005r" then
		g_sBizDate   		= DATAMANAGER.GetDataValue(0, "obtro_comn_005r", "OutBlock1", "BSOP_DATE"	, 0)  -- 미국장 영업일

		if gf_Tonumber(g_sBizDate) < gf_Tonumber(CalcDate("d",-1)) then
			Calendar0.caption = CalcDate("d",0)
			Calendar1.caption = CalcDate("d",0)
		else
			Calendar0.caption = g_sBizDate
			Calendar1.caption = CalcDate("d",0)
		end
		
		AutoRule_SelectOrderHistory()
		
	elseif szTranID == "obtro_oder_268r" then
		g_sBizDate = DATAMANAGER.GetDataValue(0, szTranID, "OutBlock1", "MANG_DATE", 0)
		sHostDate = Form.GetSharedData("&HOST_DATE", false)
		
		Calendar0.caption = g_sBizDate
		Calendar1.caption = sHostDate
		
		AutoRule_SelectOrderHistory()
	end
end

 --============================================================================
 -- 비용포함 체크 시, 안내메시지 닫기
 --============================================================================
function contToast_ImageClose_OnClick()
	
	SetShowToast(false)
	
end

 --============================================================================
 -- 비용포함 체크 시, 안내메시지 닫기
 --============================================================================
function contToast_LabelText_OnClick()

	SetShowToast(false)
		
end

 --============================================================================
function Image2_OnClick()
	if g_isClick == false then
		g_isClick = true
		AutoRule_SelectOrderHistory()
	end
end
