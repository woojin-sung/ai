 --============================================================================
function Calendar0_OnEditComplete()
	
	if gf_Tonumber(Calendar0.caption) >  gf_Tonumber(Calendar1.caption) then
		Form.ShowAlert("알림", "과거일자가 기준일자보다 큽니다.")
		Calendar0.caption = Calendar1.caption
	end
	
	 --sCal = CalcDate("d",-365)
	
	sDate = Calendar1.caption
	sYear = string.sub(sDate, 1, 4)
	sMonth = string.sub(sDate, 5, 5 + 2 - 1)
	sDay = string.sub(sDate, -2)
	
	sRsltDate = string.gsub(gf_DateAdd("d", -365, sYear.."-".. sMonth .."-".. sDay), "-", "")
	
	if gf_Tonumber(Calendar0.caption) <  gf_Tonumber(sRsltDate) then
		Form.ShowAlert("알림", "최대 1년 단위로만 조회 가능합니다.")
		Calendar0.caption = sRsltDate
	end
	
	Form.SetSharedData("17100_T3_CALENDAR" , Calendar0.caption)
	Form.SetSharedData("17100_T3_CALENDAR_BASE" , Calendar1.caption)
	
	AutoRule_SelectOrderHistory()
end

 --============================================================================
function Calendar1_OnEditComplete()
	
	if gf_Tonumber(Calendar0.caption) >  gf_Tonumber(Calendar1.caption) then
		Form.ShowAlert("알림", "과거일자가 기준일자보다 큽니다.")
		Calendar1.caption = Calendar0.caption
	end
	
	sDate = Calendar0.caption
	sYear = string.sub(sDate, 1, 4)
	sMonth = string.sub(sDate, 5, 5 + 2 - 1)
	sDay = string.sub(sDate, -2)
	
	sRsltDate = string.gsub(gf_DateAdd("d", 365, sYear.."-".. sMonth .."-".. sDay), "-", "")
	
	sHostDate = Form.GetSharedData("&HOST_DATE", false)
	
	if gf_Tonumber(sRsltDate) > gf_Tonumber(sHostDate) then
		if gf_Tonumber(Calendar1.caption) >  gf_Tonumber(sHostDate) then
			Form.ShowAlert("알림", "당일 이후 날짜는 선택 불가해요.")
			Calendar1.caption = sHostDate
		end
	else
		if gf_Tonumber(Calendar1.caption) >  gf_Tonumber(sRsltDate) then
			Form.ShowAlert("알림", "최대 1년 단위로만 조회 가능합니다.")
			Calendar1.caption = sRsltDate
		end
	end
	
	Form.SetSharedData("17100_T3_CALENDAR" , Calendar0.caption)
	Form.SetSharedData("17100_T3_CALENDAR_BASE" , Calendar1.caption)
	
	AutoRule_SelectOrderHistory()
end



