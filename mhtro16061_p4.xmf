				<CELL cell_ly="0,8,0,8" fgcolor="146:124124124" bgcolor="038:255255255" line="0,0" text="·" fontsize="5" fontstyle="01" impidxs="" />
				<CELL cell_ly="1,8,1,8" fgcolor="146:124124124" bgcolor="038:255255255" halign="0" line="0,0" text="예약주문 접수시 해당종목의 회사분할이나 주식합병" fontsize="-2" autofontsize="1" impidxs="" />
				<CELL cell_ly="0,9,0,9" fgcolor="146:124124124" bgcolor="038:255255255" line="0,0" fontsize="5" fontstyle="01" impidxs="" />
				<CELL cell_ly="1,9,1,9" fgcolor="146:124124124" bgcolor="038:255255255" halign="0" line="0,0" text="등으로 인하여 주문이 거부될 수 있으니 정규시장" fontsize="-2" autofontsize="1" impidxs="" />
