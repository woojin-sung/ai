				<CELL cell_ly="1,13,1,13" fgcolor="146:124124124" bgcolor="038:255255255" halign="0" line="0,0" text="해당 국가의 시장상황에 따라 예약주문으로 접수된 " fontsize="-2" autofontsize="1" impidxs="" />
