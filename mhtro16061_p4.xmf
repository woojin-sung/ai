function btnSave_OnClick()
	Form.SaveConfigData("mhtro16061", "mhtro16061_p4", "0" )
	Form.CloseForm()
	
end

 --============================================================================
function Form_OnFormInit()
	local szPopup
	szPopup = Form.LoadConfigData( "mhtro16061", "mhtro16061_p4" )
	
	if szPopup == "1" then
		Form.CloseForm()
	end
end

 --============================================================================
function btnCancel_OnClick()
