				<TABLE name="Table0" outlinecolor="038:255255255" colcount="2" rowcount="41" outline="0000" designorder="1" ly_vert="15,5,345,756,1" >
					<COL_INFO ly_vert_width="10,335" />
					<ROW_INFO ly_vert_height="21,10,21,21,21,21,10,21,20,21,21,10,21,21,21,20,10,21,21,21,20,10,21,21,21,20,10,21,21,20,10,21,21,10,21,20,10,21,21,21,21" />
					<CELL_INFO>
						<CELL cell_ly="0,0,0,0" fgcolor="004:000000000" bgcolor="038:255255255" line="0,0" text="·" fontsize="5" fontstyle="01" impidxs="" />
						<CELL cell_ly="1,0,1,0" fgcolor="004:000000000" bgcolor="038:255255255" halign="0" line="0,0" text="TWAP, VWAP 주문은 정규장에서만 유효한 주문입니다. " fontsize="-2" impidxs="" />
						<CELL cell_ly="0,1,0,1" fgcolor="061:239059036" bgcolor="038:255255255" line="0,0" fontsize="5" fontstyle="01" impidxs="" />
						<CELL cell_ly="1,1,1,1" fgcolor="004:000000000" bgcolor="038:255255255" halign="0" line="0,0" fontsize="-2" impidxs="" />
						<CELL cell_ly="0,2,0,2" fgcolor="004:000000000" bgcolor="038:255255255" line="0,0" text="·" fontsize="5" fontstyle="01" impidxs="" />
						<CELL cell_ly="1,2,1,2" fgcolor="004:000000000" bgcolor="038:255255255" halign="0" line="0,0" text="VWAP 주문은 주문하신 수량을 장중에 나누어 체결시키는" fontsize="-2" impidxs="" />
						<CELL cell_ly="0,3,0,3" fgcolor="004:000000000" bgcolor="038:255255255" line="0,0" fontsize="5" fontstyle="01" impidxs="" />
						<CELL cell_ly="1,3,1,3" fgcolor="004:000000000" bgcolor="038:255255255" halign="0" line="0,0" text="알고리즘 매매의 방법으로 과거 거래량을 분석하여 현지 " fontsize="-2" impidxs="" />
						<CELL cell_ly="0,4,0,4" fgcolor="004:000000000" bgcolor="038:255255255" line="0,0" fontsize="5" fontstyle="01" impidxs="" />
						<CELL cell_ly="1,4,1,4" fgcolor="004:000000000" bgcolor="038:255255255" halign="0" line="0,0" text="브로커 자체 기준으로 거래량이 많을 때 많이 적을 때 적게" fontsize="-2" impidxs="" />
						<CELL cell_ly="0,5,0,5" fgcolor="004:000000000" bgcolor="038:255255255" line="0,0" fontsize="5" fontstyle="01" impidxs="" />
						<CELL cell_ly="1,5,1,5" fgcolor="004:000000000" bgcolor="038:255255255" halign="0" line="0,0" text="배분하여 분할 체결하는 주문입니다." fontsize="-2" impidxs="" />
						<CELL cell_ly="0,6,0,6" fgcolor="049:000000000" bgcolor="038:255255255" line="0,0" fontsize="5" fontstyle="01" impidxs="" />
						<CELL cell_ly="1,6,1,6" fgcolor="004:000000000" bgcolor="038:255255255" halign="0" line="0,0" fontsize="-2" impidxs="" />
						<CELL cell_ly="0,7,0,7" fgcolor="004:000000000" bgcolor="038:255255255" line="0,0" text="·" fontsize="5" fontstyle="01" impidxs="" />
						<CELL cell_ly="1,7,1,7" fgcolor="004:000000000" bgcolor="038:255255255" halign="0" line="0,0" text="수량분할 주문은 VWAP(Volume Weighted Averaged " fontsize="-2" impidxs="" />
						<CELL cell_ly="0,8,0,8" fgcolor="004:000000000" bgcolor="038:255255255" line="0,0" fontsize="5" impidxs="" />
						<CELL cell_ly="1,8,1,8" fgcolor="004:000000000" bgcolor="038:255255255" halign="0" line="0,0" text="Price) 이라고도 부르며, 장중 시장 평균가격을 추구할 수" fontsize="-2" impidxs="" />
						<CELL cell_ly="0,9,0,9" fgcolor="004:000000000" bgcolor="038:255255255" line="0,0" fontsize="5" fontstyle="01" impidxs="" />
						<CELL cell_ly="1,9,1,9" fgcolor="004:000000000" bgcolor="038:255255255" halign="0" line="0,0" text="있는 매매 전략입니다. 그러나 시장 평균 가격을 보장할 수" fontsize="-2" impidxs="" />
						<CELL cell_ly="0,10,0,10" fgcolor="004:000000000" bgcolor="038:255255255" line="0,0" fontsize="5" fontstyle="01" impidxs="" />
						<CELL cell_ly="1,10,1,10" fgcolor="004:000000000" bgcolor="038:255255255" halign="0" line="0,0" text=" 없습니다." fontsize="-2" impidxs="" />
						<CELL cell_ly="0,11,0,11" fgcolor="004:000000000" bgcolor="038:255255255" line="0,0" fontsize="5" fontstyle="01" impidxs="" />
						<CELL cell_ly="1,11,1,11" fgcolor="004:000000000" bgcolor="038:255255255" halign="0" line="0,0" fontsize="-2" impidxs="" />
						<CELL cell_ly="0,12,0,12" fgcolor="004:000000000" bgcolor="038:255255255" line="0,0" text="·" fontsize="5" fontstyle="01" impidxs="" />
						<CELL cell_ly="1,12,1,12" fgcolor="004:000000000" bgcolor="038:255255255" halign="0" line="0,0" text="TWAP 주문은 주문하신 수량을 장중 시간별로 나누어" fontsize="-2" impidxs="" />
						<CELL cell_ly="0,13,0,13" fgcolor="004:000000000" bgcolor="038:255255255" line="0,0" fontsize="5" fontstyle="01" impidxs="" />
						<CELL cell_ly="1,13,1,13" fgcolor="004:000000000" bgcolor="038:255255255" halign="0" line="0,0" text="체결 시키는 알고리즘 매매의 방법으로 과거 거래 시간을 " fontsize="-2" impidxs="" />
						<CELL cell_ly="0,14,0,14" fgcolor="004:000000000" bgcolor="038:255255255" line="0,0" fontsize="5" fontstyle="01" impidxs="" />
						<CELL cell_ly="1,14,1,14" fgcolor="004:000000000" bgcolor="038:255255255" halign="0" line="0,0" text="분석하여 현지 브로커 자체 기준으로 장중 분할 체결하는 " fontsize="-2" impidxs="" />
						<CELL cell_ly="0,15,0,15" fgcolor="004:000000000" bgcolor="038:255255255" halign="0" line="0,0" fontsize="-2" impidxs="" />
						<CELL cell_ly="1,15,1,15" fgcolor="004:000000000" bgcolor="038:255255255" halign="0" line="0,0" text="주문입니다." fontsize="-2" impidxs="" />
						<CELL cell_ly="0,16,0,16" fgcolor="004:000000000" bgcolor="038:255255255" line="0,0" fontsize="5" fontstyle="01" impidxs="" />
						<CELL cell_ly="1,16,1,16" fgcolor="004:000000000" bgcolor="038:255255255" halign="0" line="0,0" fontsize="-2" impidxs="" />
						<CELL cell_ly="0,17,0,17" fgcolor="004:000000000" bgcolor="038:255255255" line="0,0" text="·" fontsize="5" fontstyle="01" impidxs="" />
						<CELL cell_ly="1,17,1,17" fgcolor="004:000000000" bgcolor="038:255255255" halign="0" line="0,0" text="시간분할 주문은 TWAP(Time Weighted Averaged" fontsize="-2" impidxs="" />
						<CELL cell_ly="0,18,0,18" fgcolor="004:000000000" bgcolor="038:255255255" line="0,0" fontsize="5" fontstyle="01" impidxs="" />
						<CELL cell_ly="1,18,1,18" fgcolor="004:000000000" bgcolor="038:255255255" halign="0" line="0,0" text="Price) 이라고도 부르며, 장중 시장 평균 가격을 추구할 수 " fontsize="-2" impidxs="" />
						<CELL cell_ly="0,19,0,19" fgcolor="004:000000000" bgcolor="038:255255255" line="0,0" fontsize="5" impidxs="" />
						<CELL cell_ly="1,19,1,19" fgcolor="004:000000000" bgcolor="038:255255255" halign="0" line="0,0" text="있는 매매전략입니다. 그러나 시장 평균가격을 보장할 수 " fontsize="-2" impidxs="" />
						<CELL cell_ly="0,20,0,20" fgcolor="004:000000000" bgcolor="038:255255255" line="0,0" impidxs="" />
						<CELL cell_ly="1,20,1,20" fgcolor="004:000000000" bgcolor="038:255255255" halign="0" line="0,0" text="없습니다." fontsize="-2" impidxs="" />
						<CELL cell_ly="0,21,0,21" fgcolor="004:000000000" bgcolor="038:255255255" line="0,0" fontsize="5" impidxs="" />
						<CELL cell_ly="1,21,1,21" fgcolor="004:000000000" bgcolor="038:255255255" halign="0" line="0,0" fontsize="-2" impidxs="" />
						<CELL cell_ly="0,22,0,22" fgcolor="004:000000000" bgcolor="038:255255255" line="0,0" text="·" fontsize="5" fontstyle="01" impidxs="" />
						<CELL cell_ly="1,22,1,22" fgcolor="004:000000000" bgcolor="038:255255255" halign="0" line="0,0" text="수량(시간)분할주문은 현지 브로커의 알고리즘에 주문을" fontsize="-2" impidxs="" />
						<CELL cell_ly="0,23,0,23" fgcolor="004:000000000" bgcolor="038:255255255" line="0,0" fontsize="5" impidxs="" />
						<CELL cell_ly="1,23,1,23" fgcolor="004:000000000" bgcolor="038:255255255" halign="0" line="0,0" text="전송하여 처리하므로, 주문 입력 및 취소 요청 시 " fontsize="-2" impidxs="" />
						<CELL cell_ly="0,24,0,24" fgcolor="004:000000000" bgcolor="038:255255255" line="0,0" fontsize="5" impidxs="" />
						<CELL cell_ly="1,24,1,24" fgcolor="004:000000000" bgcolor="038:255255255" halign="0" line="0,0" text="취소확인이 보통주문(=지정가주문)보다 현저히 늦을" fontsize="-2" impidxs="" />
						<CELL cell_ly="0,25,0,25" fgcolor="004:000000000" bgcolor="038:255255255" line="0,0" impidxs="" />
						<CELL cell_ly="1,25,1,25" fgcolor="004:000000000" bgcolor="038:255255255" halign="0" line="0,0" text="수 있습니다." fontsize="-2" impidxs="" />
						<CELL cell_ly="0,26,0,26" fgcolor="004:000000000" bgcolor="038:255255255" line="0,0" fontsize="5" impidxs="" />
						<CELL cell_ly="1,26,1,26" fgcolor="004:000000000" bgcolor="038:255255255" halign="0" line="0,0" fontsize="-2" impidxs="" />
						<CELL cell_ly="0,27,0,27" fgcolor="004:000000000" bgcolor="038:255255255" line="0,0" text="·" fontsize="5" fontstyle="01" impidxs="" />
						<CELL cell_ly="1,27,1,27" fgcolor="004:000000000" bgcolor="038:255255255" halign="0" line="0,0" text="수량(시간)분할주문의 정정은 불가하므로 취소 후 " fontsize="-2" impidxs="" />
						<CELL cell_ly="0,28,0,28" fgcolor="004:000000000" bgcolor="038:255255255" line="0,0" fontsize="5" impidxs="" />
						<CELL cell_ly="1,28,1,28" fgcolor="004:000000000" bgcolor="038:255255255" halign="0" line="0,0" text="재주문 하시기 바랍니다." fontsize="-2" impidxs="" />
						<CELL cell_ly="0,29,0,29" fgcolor="004:000000000" bgcolor="038:255255255" line="0,0" impidxs="" />
						<CELL cell_ly="1,29,1,29" fgcolor="333:115118124" bgcolor="038:255255255" halign="0" line="0,0" text="(단, Limit VWAP, Limit TWAP는 정정 가능)" fontsize="-2" impidxs="" />
						<CELL cell_ly="0,30,0,30" fgcolor="004:000000000" bgcolor="038:255255255" line="0,0" fontsize="5" impidxs="" />
						<CELL cell_ly="1,30,1,30" fgcolor="004:000000000" bgcolor="038:255255255" halign="0" line="0,0" fontsize="-2" impidxs="" />
						<CELL cell_ly="0,31,0,31" fgcolor="004:000000000" bgcolor="038:255255255" line="0,0" text="·" fontsize="5" fontstyle="01" impidxs="" />
						<CELL cell_ly="1,31,1,31" fgcolor="004:000000000" bgcolor="038:255255255" halign="0" line="0,0" text="취소주문은 미체결 수량에 한해 처리되며 일부 체결된 " fontsize="-2" impidxs="" />
						<CELL cell_ly="0,32,0,32" fgcolor="004:000000000" bgcolor="038:255255255" line="0,0" fontsize="5" impidxs="" />
						<CELL cell_ly="1,32,1,32" fgcolor="004:000000000" bgcolor="038:255255255" halign="0" line="0,0" text="경우 해당 수량의 취소는 불가합니다." fontsize="-2" impidxs="" />
						<CELL cell_ly="0,33,0,33" fgcolor="004:000000000" bgcolor="038:255255255" line="0,0" fontsize="5" impidxs="" />
						<CELL cell_ly="1,33,1,33" fgcolor="004:000000000" bgcolor="038:255255255" halign="0" line="0,0" fontsize="-2" impidxs="" />
						<CELL cell_ly="0,34,0,34" fgcolor="004:000000000" bgcolor="038:255255255" line="0,0" text="·" fontsize="5" fontstyle="01" impidxs="" />
						<CELL cell_ly="1,34,1,34" fgcolor="004:000000000" bgcolor="038:255255255" halign="0" line="0,0" text="현지 사정에 따라 100주 이상의 주문은 분할주문이" fontsize="-2" impidxs="" />
						<CELL cell_ly="0,35,0,35" fgcolor="004:000000000" bgcolor="038:255255255" line="0,0" impidxs="" />
						<CELL cell_ly="1,35,1,35" fgcolor="004:000000000" bgcolor="038:255255255" halign="0" line="0,0" text="가능합니다." fontsize="-2" impidxs="" />
						<CELL cell_ly="0,36,0,36" fgcolor="004:000000000" bgcolor="038:255255255" line="0,0" fontsize="5" impidxs="" />
						<CELL cell_ly="1,36,1,36" fgcolor="004:000000000" bgcolor="038:255255255" halign="0" line="0,0" fontsize="-2" impidxs="" />
						<CELL cell_ly="0,37,0,37" fgcolor="004:000000000" bgcolor="038:255255255" line="0,0" text="·" fontsize="5" fontstyle="01" impidxs="" />
						<CELL cell_ly="1,37,1,37" fgcolor="004:000000000" bgcolor="038:255255255" halign="0" line="0,0" text="VWAP, TWAP주문은 현지 브로커의 알고리즘에 의해 " fontsize="-2" impidxs="" />
						<CELL cell_ly="0,38,0,38" fgcolor="004:000000000" bgcolor="038:255255255" line="0,0" fontsize="5" impidxs="" />
						<CELL cell_ly="1,38,1,38" fgcolor="004:000000000" bgcolor="038:255255255" halign="0" line="0,0" text="지정된 시점에 각 시점의 시장가로 주문이 실행 됩니다." fontsize="-2" impidxs="" />
						<CELL cell_ly="0,39,0,39" fgcolor="004:000000000" bgcolor="038:255255255" line="0,0" fontsize="5" impidxs="" />
						<CELL cell_ly="1,39,1,39" fgcolor="004:000000000" bgcolor="038:255255255" halign="0" line="0,0" text="VWAP,TWAP는 매도주문 시에만 가능하오니 매매 시 " fontsize="-2" impidxs="" />
						<CELL cell_ly="0,40,0,40" fgcolor="004:000000000" bgcolor="038:255255255" line="0,0" fontsize="5" impidxs="" />
