 -- 20160317 가격 Max : 7 (전요셉과장)

 --============================================================================
 -- 화 면 명 : 주식주문_가격입력창
 -- 화면설명 : 주식주문 가격입력시
 -- 작    성 : 2016.02.15 ~ 2016.  .       ssang
 --============================================================================

 --****************************************************************************
 --               G  L  O  B  A  L       V  A  R  I  A  B  L  E
 --****************************************************************************
local g_szCd, g_szMk, g_szUnit, g_szType, g_szReceive, g_szopenPrc
g_szCd, g_szMk, g_szUnit, g_szType, g_szReceive = "", "", "", "", ""

 --****************************************************************************
 --            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             
 --****************************************************************************

 --============================================================================
 -- Calc_Price : +, - 버튼클릭시 호가단위로 가격계산
 --============================================================================
function Calc_Price(nGbn)
	local szPrc, szUnit, szHigh, szLow, szHyun, nResult
	
	g_szReceive = ""
	szPrc  = edtPrc.caption
 --	szUnit = g_szUnit
 --	szHigh = edtHigh.caption
 --	szLow  = edtLow.caption
 --	szHyun = tblData.GetCellString(1, 0)

	  -- 20160317 예외처리 추가 //////////////////////////////////////////////
	if gf_Trim(szPrc) ~= "" then
		if gf_Tonumber(szPrc) >= 9900000 then
			if nGbn == 0 then
				return
			end
		end
	end
	 -- //////////////////////////////////////////////////////////////////////
	

	
	Sum_Prc(szPrc)
end

 --============================================================================
 -- Calc_Plus
 --============================================================================
function Calc_Plus(nPlus)
	local szPrc
	
	if g_szReceive == "1" then
		g_szReceive = ""
		edtPrc.caption = nPlus
	else
		szPrc = edtPrc.caption
		
	 --	if gf_Trim(szPrc) == "" then
	 --		szPrc = 0
	 --	end if	
		szPrc = szPrc .. nPlus
		Sum_Prc(szPrc)
	end
end

 --============================================================================
 -- Calc_Zero
 --============================================================================
function Calc_Zero(szPlus)
	local szPrc

	if g_szReceive == "1" then
		g_szReceive = ""
		edtPrc.caption = ""
	else
		szPrc = edtPrc.caption	
		
		if string.string.len(edtPrc.caption) > 0 then
			szPrc = edtPrc.caption .. szPlus
			
			Sum_Prc(szPrc)
		end
	end
end

 --============================================================================
 -- Sum_Prc
 --============================================================================
function Sum_Prc(szData)
	 --if string.len(szData) < 16 then
	if string.string.len(szData) < 12 then -- Max 11 end
		edtPrc.caption = szData
	end
end
 --****************************************************************************
 --               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
 --****************************************************************************

 --============================================================================
 -- Form_OnFormInit
 --============================================================================
function Form_OnFormInit()
	local szOpen

	Form.SetScreenName("가격입력기")
	szOpen = Form.GetOpenLinkData()
	if gf_Trim(szOpen) ~= "" then
		tData = int(szOpen)
		g_szopenPrc = tData
 --		g_szReceive = "1"
		edtPrc.caption = tData
 --		g_szCd   = tData[1+1]
 --		g_szMk   = tData[2+1]
 --		g_szUnit = tData[3+1]
 --		g_szType = tData[4+1]
 --		edtHigh.caption = tData[5+1]
 --		edtLow.caption  = tData[6+1]
 --		
	else
		g_szReceive = "1"
		tData = 0
	end

end

 --============================================================================
 -- btnPlus1_OnClick
 --============================================================================
function btnPlus1_OnClick()
	Calc_Plus(1)
end

