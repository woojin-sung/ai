end

 --============================================================================
 -- btnBack_OnClick
 --============================================================================
function btnBack_OnClick()
	local nLen
	nLen = string.string.len(edtPrc.caption)

	if nLen ~= 0 then
		szPrc = string.sub(edtPrc.caption, 1, nLen-1)
		edtPrc.caption = szPrc
	end
	
	g_szReceive = ""
end

 --============================================================================
 -- btnClear_OnClick
 --============================================================================
function btnClear_OnClick()
	edtPrc.caption = ""
end

 --============================================================================
 -- btnConfirm_OnClick
 --============================================================================
function btnConfirm_OnClick()
	szPrc = edtPrc.caption
 --	if gf_Trim(szPrc) ~= "" then
 --		szPrc = edtPrc.caption
 --		szMod = szPrc % 1000
 --		szPrc = szPrc-szMod
		Form.SendReturnToParent("PRC_POPUP", szPrc)
 --	end if
	Form.CloseForm()
end

 --============================================================================
 -- LblClose_OnClick : 닫기
 --============================================================================
function LblClose_OnClick()
	if g_szopenPrc ~= "" and g_szopenPrc ~= nil then
		Form.SendReturnToParent("PRC_POPUP", g_szopenPrc)
	end
						
	Form.CloseForm()
end
 --============================================================================
function Form_OnRefresh()
	Form.CloseForm()
end
 --============================================================================
 -- BtnClose_OnClick : 닫기
 --============================================================================
function BtnClose_OnClick()
	if g_szopenPrc ~= "" and g_szopenPrc ~= nil then
		Form.SendReturnToParent("PRC_POPUP", g_szopenPrc)
	end
						
	Form.CloseForm()	
end

	
