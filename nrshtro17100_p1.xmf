function cont1_cmb0_OnEditComplete(iIndex)
    local sKey = cont1.cmb0.cbkeydata
    Form.SetEnvData(1, "17100_SELL_MONITOR_COND_BASE", sKey)
    if sKey == "01" then
        cont1.btnPMinus.enable = false
        cont1.btnPPlus.enable = false
        cont1.btnPrc.enable = false
        cont1.edtPrc.enable = false
        cont1.btnPMinus.visible = true
        cont1.btnPPlus.visible = true
        cont1.btnPrc.visible = true
        cont1.edtPrc.visible = true
        local sPrc = SetPrice("AUTO", g_sAvrgPrc, contHidden.lblDecimal.caption, contHidden.lblCrcd.caption)
        cont1.edtPrc.caption = sPrc
    elseif sKey == "02" then
        cont1.btnPMinus.enable = true
        cont1.btnPPlus.enable = true
        cont1.btnPrc.enable = true
        cont1.edtPrc.enable = true
        cont1.btnPMinus.visible = true
        cont1.btnPPlus.visible = true
        cont1.btnPrc.visible = true
        cont1.edtPrc.visible = true
        local sPrc = SetPrice("AUTO", g_sAvrgPrc, contHidden.lblDecimal.caption, contHidden.lblCrcd.caption)
        cont1.edtPrc.caption = sPrc
    elseif sKey == "03" then
        cont1.btnPMinus.enable = false
        cont1.btnPPlus.enable = false
        cont1.btnPrc.enable = false
        cont1.edtPrc.enable = false
        cont1.btnPMinus.visible = false
        cont1.btnPPlus.visible = false
        cont1.btnPrc.visible = false
        cont1.edtPrc.visible = false
        cont1.edtPrc.caption = ""
    elseif sKey == "04" then
        cont1.btnPMinus.enable = false
        cont1.btnPPlus.enable = false
        cont1.btnPrc.enable = false
        cont1.edtPrc.enable = false
        cont1.btnPMinus.visible = true
        cont1.btnPPlus.visible = true
        cont1.btnPrc.visible = true
        cont1.edtPrc.visible = true
        local sPrc = SetPrice("AUTO", contHidden.lblClose.caption, contHidden.lblDecimal.caption, contHidden.lblCrcd.caption)
        cont1.edtPrc.caption = sPrc
    end
    cont1.btnPrc.BringFront("1")
    if isEmpty(cont1.lblSellCond0.caption) == false and cont1.cmb1.cbkeydata ~= "01" then
        DisplaySet_Cond1(Replace_Prc(cont1.lblSellCond0.caption), false)
    else
        cont1_cmb1_OnEditComplete(0)
    end
    if isEmpty(cont1.lblSellCond2.caption) == false and cont1.cmb2.cbkeydata ~= "01" then
        DisplaySet_Cond2( Replace_Prc(cont1.lblSellCond2.caption), false)
    else
        cont1_cmb2_OnEditComplete(0)
    end
    if isEmpty(cont1.lblSellCond4.caption) == false and cont1.cmb3.cbkeydata ~= "01" then
        DisplaySet_Cond3(Replace_Prc(cont1.lblSellCond4.caption), false)
    else
        cont1_cmb3_OnEditComplete(0)
    end
    --	cont1.cmb1.cbkeydata = "01"
    --	cont1.cmb2.cbkeydata = "01"
    --	cont1.cmb3.cbkeydata = "01"
    --	cont1_cmb1_OnEditComplete(0)
    --	cont1_cmb2_OnEditComplete(0)
    --	cont1_cmb3_OnEditComplete(0)
end

function Check_InputData()
    if isEmpty(cont1.lblSellCond0.caption) == true and isEmpty(cont1.lblSellCond2.caption) == true and isEmpty(cont1.lblSellCond4.caption) == true then
        Form.ShowAlert("알림", "감시 조건을 입력해 주세요.")
        return false
    end
    if cont1.cmb4.cbkeydata ~= "05" and cont1.cmb4.cbkeydata ~= "34" then
        if (cont1.cmb5.cbkeydata == "01" or cont1.cmb5.cbkeydata == "09") and isEmpty(cont1.edtPrc0.caption) == true then
            Form.ShowAlert("알림", "주문 가격을 입력해 주세요.")
            return false
        end
    end
    if (cont1.cmb6.cbkeydata == "01" and isEmpty(cont1.edtQty.caption) == true) or (cont1.cmb6.cbkeydata == "02" and isEmpty(cont1.lblAbleQty.caption) == true) then
        Form.ShowAlert("알림", "주문 수량을 입력해 주세요.")
        return false
    end
    return true
end

function Check_InputData2()
    if Check_Cond1() == false then
        return false
    end
    if Check_Cond2() == false then
        return false
    end
    if Check_Cond3() == false then
        return false
    end
    return true
end

function Replace_Affix(nIdx, sAffix, sText)
    local sTempAffix = ""
    if sAffix == "$" then
        sTempAffix = "USD"
    elseif sAffix == "USD" then
        sTempAffix = "$"
    else
        sTempAffix = sAffix
    end
    local sResult = sText
    if string.find(sResult, sAffix) > 0 then
        ----------------
        -- Prefix
        ----------------
        if nIdx == 0 then
            sResult = sTempAffix .. " " .. gf_Trim(string.gsub(sResult, string.gsub(sAffix, "([%p])", "%%%1"), ""))
            ----------------
            -- Suffix
            ----------------
        elseif nIdx == 1 then
            sResult = gf_Trim(string.gsub(sResult, string.gsub(sAffix, "([%p])", "%%%1"), "")) .. " " .. sTempAffix
        end
    end
    return sResult
end

function Open_Confirm()
    -------------------------------
    --계좌정보
    -------------------------------
    local sLinkData = string.sub(g_sAcno, 1, 4) .. "-" .. string.sub(g_sAcno, -4)  .. "-" .. g_sAsno .. " " .. g_sAcntNm
    -------------------------------
    --종목정보
    -------------------------------
    sLinkData = sLinkData .. "`" .. g_sCode
    sLinkData = sLinkData .. "`" .. g_sItemName
    -------------------------------
    --감시기준가
    -------------------------------
    sLinkData = sLinkData .. "`" .. cont1.cmb0.caption
    sLinkData = sLinkData .. "`" .. Replace_Affix(1, "$", cont1.edtPrc.caption)
    -------------------------------
    --감시조건
    -------------------------------
    sLinkData = sLinkData .. "`" .. Replace_Affix(1, "$", cont1.lblSellCond1.caption)
    sLinkData = sLinkData .. "`" .. Replace_Affix(1, "$", "$") 
    sLinkData = sLinkData .. "`" .. Replace_Affix(1, "$", cont1.lblSellCond3.caption)
    sLinkData = sLinkData .. "`" .. Replace_Affix(1, "$", "$") 
    sLinkData = sLinkData .. "`" .. Replace_Affix(1, "$", cont1.lblSellCond5.caption)
    sLinkData = sLinkData .. "`" .. Replace_Affix(1, "$", "$") 
    --	sLinkData = sLinkData .. "`" .. cont1.lblSellCond0.caption
    --	sLinkData = sLinkData .. "`" .. Replace_Affix(1, cont1.cmb1.caption, cont1.cmb1.caption) 
    --	sLinkData = sLinkData .. "`" .. cont1.lblSellCond2.caption
    --	sLinkData = sLinkData .. "`" .. Replace_Affix(1, cont1.cmb2.caption, cont1.cmb2.caption) 
    --	sLinkData = sLinkData .. "`" .. cont1.lblSellCond4.caption
    --	sLinkData = sLinkData .. "`" .. Replace_Affix(1, cont1.cmb3.caption, cont1.cmb3.caption) 
    -------------------------------
    --주문정보
    -------------------------------
    sLinkData = sLinkData .. "`" .. cont1.cmb4.caption 
    if cont1.cmb4.cbkeydata ~= "05" and cont1.cmb4.cbkeydata ~= "34" then
        if cont1.cmb5.cbkeydata == "01" then
            sLinkData = sLinkData .. "`" .. cont1.Combo0.caption 
        elseif cont1.cmb5.cbkeydata == "09" then
            sLinkData = sLinkData .. "`" .. Replace_Affix(1, "$", cont1.edtPrc0.caption)  
        else
            sLinkData = sLinkData .. "`" .. cont1.cmb5.caption 
        end
    else
        sLinkData = sLinkData .. "`" .. "-"
    end
    if cont1.cmb6.cbkeydata == "01" then
        if isEmpty(cont1.edtQty.caption) == true then
            sLinkData = sLinkData .. "`" .. "-"
        else
            sLinkData = sLinkData .. "`" .. gf_CommaValue(cont1.edtQty.caption , 0) .. " 주"
        end
    elseif cont1.cmb6.cbkeydata == "02" then
        if isEmpty(cont1.lblAbleQty.caption) == true then
            sLinkData = sLinkData .. "`" .. "-"
        else
            sLinkData = sLinkData .. "`" .. gf_CommaValue(cont1.lblAbleQty.caption , 0) .. " 주"
        end
    end
    local sDate = cont1.Calendar0.caption
    local sConvDate = string.sub(sDate, 3, 3 + 2 - 1) .. "." .. string.sub(sDate, 5, 5 + 2 - 1) .. "." .. string.sub(sDate, -2) .. " 까지"
    sLinkData = sLinkData .. "`" .. sConvDate
    Form.OpenPopup("nrshtro17100_pb" , sLinkData , "")
end

