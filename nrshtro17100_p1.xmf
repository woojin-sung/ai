function cont1_cmb4_OnEditComplete(iIndex)
    local sKey = cont1.cmb4.cbkeydata
    Form.SetSharedData("17100_SELL_ORDER_COND_TYPE" , sKey)
    if sKey == "05" then
        local bPopYN = Form.GetEnvData("OrdNotice_17100_p13_1")
        if (bPopYN == "" or bPopYN == "0") and g_isFst == false then
            local sText = "상/하한가가 없는 미국 시장의 특성 상\n해당종목의 가격이 급등락할 수 있으며 "..
            "시장가 주문 시 현재가 또는 원하는 가격보다 낮거나 불리한 가격에 체결될 수 있음을 유의하시기 바랍니다."
            Form.MsgBox("시장가 주문 유의사항 안내",sText, "MARKET_ORDER_NOTICE" ,7, "확인","다시보지않기")
            --			Form.OpenPopup("nrshtro17100_p13" , "" , "") 
        end
        cont1.cmb5.enable = false
        cont1.cmb5.caption = ""
    elseif sKey == "34" then
        cont1.cmb5.enable = false
        cont1.cmb5.caption = ""
    else
        cont1.cmb5.enable = true
        cont1.cmb5.cbkeydata = cont1.cmb5.cbkeydata
    end
    Change_OrderType()
end

function DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
    if szTranID == "obtro_oder_132r" then
        btnReg.enable = true
        -------------------------
        --일부메시지 하드코딩
        -------------------------
        if szErrCode == "6090" then
            Form.ShowAlert("알림", "자동주문 설정이 불가한 종목입니다.\n(권리락, 배당락, 액면분할 등 권리 발생 또는 종목 정보 변경 종목은 설정 불가)" )
            return
        elseif szErrCode == "6119" then
            --			Form.ShowAlert("알림", "자동주문 설정이 불가한 종목입니다.\n(주문 제한 PTP 종목)" )
            if g_isModify == true then
                Form.MsgBox("알림", "자동주문 설정이 불가한 종목입니다.\n(주문 제한 PTP 종목)" , "DISABLE_PTP", 7, "확인", "삭제하기")
            else
                Form.MsgBox("알림", "자동주문 설정이 불가한 종목입니다.\n(주문 제한 PTP 종목)" , "DISABLE_PTP", 6)
            end
            return
        elseif szErrCode == "2438" then
            Form.OpenPopupAnimation("pwdcheckpopup", g_sAcno..g_sAsno ,"","2")
            return
        end
    end
    local szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
    if string.len(gf_Trim(szSubMsg))	>	0 then
        Form.ShowAlert("알림", szErrMsg .. "\n(" .. szSubMsg .. ")")
    else
        Form.ShowAlert("알림", szErrMsg )
    end
end

function DATAMANAGER_OnReceiveTranData(szTranID)
    if szTranID == "ohhts_6000_017r" then
        local sHyun 	= DATAMANAGER.GetDataValue(0, "ohhts_6000_017r", "OutBlock1", "FIDX_DYTM_PRPR", 0)	--현재가
        ------------------------------------
        --주간시세 현재가 없는 경우 시세보정
        ------------------------------------
        if isEmpty(sHyun) == true or gf_Tonumber(sHyun) == 0 then
            DATAMANAGER.SetDataValue(0, "ohhts_6000_017r", "OutBlock1", "FIDX_DYTM_PRPR", 0 , g_sHyun)
            DATAMANAGER.SetDataAttr(0, "ohhts_6000_017r", "OutBlock1", "FIDX_DYTM_PRPR", 0 , g_sHyun_ATTR)
            DATAMANAGER.SetDataValue(0, "ohhts_6000_017r", "OutBlock1", "FIDX_DYTM_UNCH_PRPR", 0 , g_sHyunEx)
            DATAMANAGER.SetDataAttr(0, "ohhts_6000_017r", "OutBlock1", "FIDX_DYTM_UNCH_PRPR", 0 , g_sHyunEx_ATTR)
            DATAMANAGER.SetDataValue(0, "ohhts_6000_017r", "OutBlock1", "FIDX_DYTM_PRDY_VRSS_SIGN", 0 , g_sCloseSign)
            DATAMANAGER.SetDataValue(0, "ohhts_6000_017r", "OutBlock1", "FIDX_DYTM_PRDY_VRSS", 0 , g_sClose)
            DATAMANAGER.SetDataAttr(0, "ohhts_6000_017r", "OutBlock1", "FIDX_DYTM_PRDY_VRSS", 0 , g_sClose_ATTR)
            DATAMANAGER.SetDataValue(0, "ohhts_6000_017r", "OutBlock1", "FIDX_DYTM_PRDY_CTRT", 0 , g_sCloseRate)
            DATAMANAGER.SetDataAttr(0, "ohhts_6000_017r", "OutBlock1", "FIDX_DYTM_PRDY_CTRT", 0 , g_sCloseRate_ATTR)
        end
    elseif szTranID == "ohhts_6000_023r" then
        local sHyun 	= DATAMANAGER.GetDataValue(0, "ohhts_6000_023r", "OutBlock1", "FIDX_MKT_AFT_PRPR", 0)	--현재가
        ------------------------------------
        --애프터시세 현재가 없는 경우 시세보정
        ------------------------------------
        if isEmpty(sHyun) == true or gf_Tonumber(sHyun) == 0 then
            DATAMANAGER.SetDataValue(0, "ohhts_6000_023r", "OutBlock1", "FIDX_MKT_AFT_PRPR", 0 , g_sHyun)
            DATAMANAGER.SetDataAttr(0, "ohhts_6000_023r", "OutBlock1", "FIDX_MKT_AFT_PRPR", 0 , g_sHyun_ATTR)
            DATAMANAGER.SetDataValue(0, "ohhts_6000_023r", "OutBlock1", "FIDX_MKT_AFT_UNCH_PRPR", 0 , g_sHyunEx)
            DATAMANAGER.SetDataAttr(0, "ohhts_6000_023r", "OutBlock1", "FIDX_MKT_AFT_UNCH_PRPR", 0 , g_sHyunEx_ATTR)
            DATAMANAGER.SetDataValue(0, "ohhts_6000_023r", "OutBlock1", "FIDX_MKT_AFT_PRDY_VRSS_SIGN", 0 , g_sCloseSign)
            DATAMANAGER.SetDataValue(0, "ohhts_6000_023r", "OutBlock1", "FIDX_MKT_AFT_PRDY_VRSS", 0 , g_sClose)
            DATAMANAGER.SetDataAttr(0, "ohhts_6000_023r", "OutBlock1", "FIDX_MKT_AFT_PRDY_VRSS", 0 , g_sClose_ATTR)
            DATAMANAGER.SetDataValue(0,"ohhts_6000_023r", "OutBlock1", "FIDX_MKT_AFT_PRDY_CTRT" , 0 , g_sCloseRate)
            DATAMANAGER.SetDataAttr(0, "ohhts_6000_023r", "OutBlock1", "FIDX_MKT_AFT_PRDY_CTRT", 0 , g_sCloseRate_ATTR)
        end
    end
end

