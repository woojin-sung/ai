function AutoRule_Create()
    g_sStep = "CREATE"
    Form.ReleaseRequestData()
    local sUserID = Form.GetSharedData("..USER_ID", false )
    Form.MakeRequestData("userId", sUserID)
    Form.MakeRequestData("accountNumber", 	g_sAcno)
    Form.MakeRequestData("accountSeqNumber", g_sAsno)
    Form.MakeRequestData("accountPassword", g_sPwd)
    Form.MakeRequestData("stockExchangeCode", g_sMarket)
    Form.MakeRequestData("stockCode", g_sCode)
    Form.MakeRequestData("tradeType", "1")
    --	Form.MakeRequestData("conditionName", "매도자동조건")
    local s_profitRealization = ""
    local s_profitPreservation = ""
    local s_stopLoss = ""
    if isEmpty(cont1.lblSellCond0.caption) == false then
        Form.StartBuildJson()
        Form.PutJsonData("priceType", cont1.cmb1.cbkeydata)
        Form.PutJsonData("priceTypeValue", Replace_Prc(cont1.lblSellCond0.caption))
        Form.PutJsonData("price", Replace_Prc(cont1.lblSellCond1.caption))
        s_profitRealization = Form.EndBuildJson()
    end
    if isEmpty(cont1.lblSellCond2.caption) == false then
        Form.StartBuildJson()
        Form.PutJsonData("priceType", cont1.cmb2.cbkeydata)
        Form.PutJsonData("priceTypeValue",  Replace_Prc(cont1.lblSellCond2.caption))
        Form.PutJsonData("price", Replace_Prc(cont1.lblSellCond3.caption))
        s_profitPreservation = Form.EndBuildJson()
    end
    if isEmpty(cont1.lblSellCond4.caption) == false then
        Form.StartBuildJson()
        Form.PutJsonData("priceType", cont1.cmb3.cbkeydata)
        Form.PutJsonData("priceTypeValue",  Replace_Prc(cont1.lblSellCond4.caption))
        Form.PutJsonData("price", Replace_Prc(cont1.lblSellCond5.caption))
        s_stopLoss = Form.EndBuildJson()
    end
    Form.StartBuildJson()
    Form.PutJsonData("basePriceClsType", cont1.cmb0.cbkeydata)
    local sPrc =  Replace_Prc(cont1.edtPrc.caption)
    if isEmpty(sPrc) == true then
        sPrc = "0"
    end
    Form.PutJsonData("basePrice", sPrc)
    if isEmpty(s_profitRealization) == false then
        Form.PutJsonData("profitRealization", s_profitRealization)
    end
    if isEmpty(s_profitPreservation) == false then
        Form.PutJsonData("profitPreservation", s_profitPreservation)
    end
    if isEmpty(s_stopLoss) == false then
        Form.PutJsonData("stopLoss", s_stopLoss)
    end
    local sData = Form.EndBuildJson()
    Form.MakeRequestData("sellCondition", sData)
    Form.MakeRequestData("orderPaymentType", "1")
    Form.MakeRequestData("orderClsType", cont1.cmb4.cbkeydata)
    if cont1.cmb4.cbkeydata ~= "05" and cont1.cmb4.cbkeydata ~= "34" then
        Form.MakeRequestData("orderPriceType", cont1.cmb5.cbkeydata)
        if cont1.cmb5.cbkeydata == "01" then
            Form.MakeRequestData("tickValue", cont1.Combo0.cbkeydata)
            Form.MakeRequestData("orderPrice", "0")
            --		sPrc = contHidden.lblHyun.caption
            --		nUnit = gf_Tonumber(GetHogaUnit(g_sExid3, sPrc, 0))
            --		
            --		nResultPrc = gf_Tonumber(sPrc) + (nUnit * gf_Tonumber(cont1.Combo0.cbkeydata))
            --		Form.MakeRequestData("orderPrice", nResultPrc)
        elseif cont1.cmb5.cbkeydata == "09" then
            Form.MakeRequestData("tickValue","0")
            Form.MakeRequestData("orderPrice", Replace_Prc(cont1.edtPrc0.caption))
        else
            Form.MakeRequestData("tickValue","0")
            Form.MakeRequestData("orderPrice", "0")
        end
    end
    if cont1.cmb6.cbkeydata == "01" then
        Form.MakeRequestData("orderQty", gf_Tonumber(cont1.edtQty.caption))
    elseif cont1.cmb6.cbkeydata == "02" then
        Form.MakeRequestData("orderQty", gf_Tonumber(cont1.lblAbleQty.caption))
    end
    local sMonth = cont1.Calendar0.calmonth
    if gf_Tonumber(cont1.Calendar0.calmonth) < 10 then
        sMonth = "0"..sMonth
    end
    local sDate = cont1.Calendar0.caption
    Form.MakeRequestData("expirationDate", string.sub(sDate, 1, 4) .. "-" ..  string.sub(sDate, 5, 5 + 2 - 1)  .. "-" .. string.sub(sDate, -2))
    Form.MakeRequestData("conditionStatusCode", g_sAutoRule)
    local sDev = Form.GetSharedData("..SERVER_MODE", false)
    local sUrl = ""
    if sDev == "1" then --개발기 end
        sUrl = "https://dev-api-gateway.imeritz.com:8443/"
    else
        sUrl = "https://api-gateway.imeritz.com:8443/"
    end
    Form.RequestRestAPI(sUrl.."api/v1/rule/create", "")
    g_sAutoRule = "01"
end

function AutoRule_Update()
    g_sStep = "UPDATE"
    Form.ReleaseRequestData()
    Form.MakeRequestData("orderConditionId", orderConditionId)
    Form.MakeRequestData("accountPassword", g_sPwd)
    Form.MakeRequestData("stockExchangeCode", g_sMarket)
    Form.MakeRequestData("stockCode", g_sCode)
    Form.MakeRequestData("tradeType", "1")
    --	Form.MakeRequestData("conditionName", "매도자동조건")
    local s_profitRealization = ""
    local s_profitPreservation = ""
    local s_stopLoss = ""
    if isEmpty(cont1.lblSellCond0.caption) == false then
        Form.StartBuildJson()
        Form.PutJsonData("priceType", cont1.cmb1.cbkeydata)
        Form.PutJsonData("priceTypeValue", Replace_Prc(cont1.lblSellCond0.caption))
        Form.PutJsonData("price", Replace_Prc(cont1.lblSellCond1.caption))
        s_profitRealization = Form.EndBuildJson()
    end
    if isEmpty(cont1.lblSellCond2.caption) == false then
        Form.StartBuildJson()
        Form.PutJsonData("priceType", cont1.cmb2.cbkeydata)
        Form.PutJsonData("priceTypeValue",  Replace_Prc(cont1.lblSellCond2.caption))
        Form.PutJsonData("price", Replace_Prc(cont1.lblSellCond3.caption))
        s_profitPreservation = Form.EndBuildJson()
    end
    if isEmpty(cont1.lblSellCond4.caption) == false then
        Form.StartBuildJson()
        Form.PutJsonData("priceType", cont1.cmb3.cbkeydata)
        Form.PutJsonData("priceTypeValue",  Replace_Prc(cont1.lblSellCond4.caption))
        Form.PutJsonData("price", Replace_Prc(cont1.lblSellCond5.caption))
        s_stopLoss = Form.EndBuildJson()
    end
    Form.StartBuildJson()
    Form.PutJsonData("basePriceClsType", cont1.cmb0.cbkeydata)
    local sPrc =  Replace_Prc(cont1.edtPrc.caption)
    if isEmpty(sPrc) == true then
        sPrc = "0"
    end
    Form.PutJsonData("basePrice", sPrc)
    if isEmpty(s_profitRealization) == false then
        Form.PutJsonData("profitRealization", s_profitRealization)
    end
    if isEmpty(s_profitPreservation) == false then
        Form.PutJsonData("profitPreservation", s_profitPreservation)
    end
    if isEmpty(s_stopLoss) == false then
        Form.PutJsonData("stopLoss", s_stopLoss)
    end
    local sData = Form.EndBuildJson()
    Form.MakeRequestData("sellCondition", sData)
    Form.MakeRequestData("orderPaymentType", "1")
    Form.MakeRequestData("orderClsType", cont1.cmb4.cbkeydata)
    if cont1.cmb4.cbkeydata ~= "05" and cont1.cmb4.cbkeydata ~= "34" then
        Form.MakeRequestData("orderPriceType", cont1.cmb5.cbkeydata)
        if cont1.cmb5.cbkeydata == "01" then
            Form.MakeRequestData("tickValue", cont1.Combo0.cbkeydata)
            Form.MakeRequestData("orderPrice", "0")
            --		sPrc = contHidden.lblHyun.caption
            --		nUnit = gf_Tonumber(GetHogaUnit(g_sExid3, sPrc, 0))
            --		
            --		nResultPrc = gf_Tonumber(sPrc) + (nUnit * gf_Tonumber(cont1.Combo0.cbkeydata))
            --		Form.MakeRequestData("orderPrice", nResultPrc)
        elseif cont1.cmb5.cbkeydata == "09" then
            Form.MakeRequestData("tickValue","0")
            Form.MakeRequestData("orderPrice", Replace_Prc(cont1.edtPrc0.caption))
        else
            Form.MakeRequestData("tickValue","0")
            Form.MakeRequestData("orderPrice", "0")
        end
    end
    if cont1.cmb6.cbkeydata == "01" then
        Form.MakeRequestData("orderQty", gf_Tonumber(cont1.edtQty.caption))
    elseif cont1.cmb6.cbkeydata == "02" then
        Form.MakeRequestData("orderQty", gf_Tonumber(cont1.lblAbleQty.caption))
    end
    local sMonth = cont1.Calendar0.calmonth
    if gf_Tonumber(cont1.Calendar0.calmonth) < 10 then
        sMonth = "0"..sMonth
    end
    local sDate = cont1.Calendar0.caption
    Form.MakeRequestData("expirationDate", string.sub(sDate, 1, 4) .. "-" ..  string.sub(sDate, 5, 5 + 2 - 1)  .. "-" .. string.sub(sDate, -2))
    Form.MakeRequestData("conditionStatusCode", g_sAutoRule)
    local sDev = Form.GetSharedData("..SERVER_MODE", false)
    local sUrl = ""
    if sDev == "1" then --개발기 end
        sUrl = "https://dev-api-gateway.imeritz.com:8443/"
    else
        sUrl = "https://api-gateway.imeritz.com:8443/"
    end
    Form.RequestRestAPI(sUrl.."api/v1/rule/update", "")
    g_sAutoRule = "01"
end

function Form_OnTriggerEvent(sEventName, sParam)
    if sEventName ==  "RESTAPI_RETURN" then
        local sStep = g_sStep
        g_sStep = ""
        ------------------------------------
        -- 조건 등록
        ------------------------------------
        if sStep == "CREATE" then
            ------------------------------------------
            -- 성공
            ------------------------------------------
            if sParam == "SUCCESS" then
                local status = Form.ResponseRestAPI("DATA", 0, "status", "")
                if status == "00" then
                    Form.CloseForm()
                    Form.SendReturnToParent("COMPLETE_ORDER" , "")
                end
                ------------------------------------------
                -- 실패(ERROR or EXCEPTION)
                ------------------------------------------
            else
                local oError = Form.ResponseRestAPI("JSONOBJ", 0, "error", "")
                if isEmpty(oError) == false then
                    local errorCode = Form.ResponseRestAPI("DATA", 0, "errorCode", oError)
                    local errorMessage = Form.ResponseRestAPI("DATA", 0, "errorMessage", oError)
                    if errorCode == "LIMIT_REACHED" then
                        Form.ShowAlert("알림", "자동 감시 주문은\n50개 까지만 등록 가능해요.")
                        return 
                    end
                end
                Form.ShowAlert("알림", g_sCommonErrorMsg)
                return 
            end
            ------------------------------------
            -- 조건 수정
            ------------------------------------
        elseif sStep == "UPDATE" then
            ------------------------------------------
            -- 성공
            ------------------------------------------
            if sParam == "SUCCESS" then
                local status = Form.ResponseRestAPI("DATA", 0, "status", "")
                if status == "00" then
                    Form.CloseForm()
                    Form.SendReturnToParent("COMPLETE_MODIFY" , "")
                end
                ------------------------------------------
                -- 실패(ERROR or EXCEPTION)
                ------------------------------------------
            else
                local oError = Form.ResponseRestAPI("JSONOBJ", 0, "error", "")
                if isEmpty(oError) == false then
                    local errorCode = Form.ResponseRestAPI("DATA", 0, "errorCode", oError)
                    local errorMessage = Form.ResponseRestAPI("DATA", 0, "errorMessage", oError)
                    if errorCode == "UNMODIFIABLE_STATUS" then
                        Form.MsgBox("알림", "감시가 실행되어 수정이 불가해요.\n내역조회에서 확인해 주세요.", "DISABLE_ORDER", 6)
                        return 
                    elseif errorCode == "FORCED_STOP_STATUS" then
                        Form.ShowAlert("알림", errorMessage)
                        return 
                    end
                end
                Form.ShowAlert("알림", g_sCommonErrorMsg)
                return 
            end
        end
    end
end

function cont1_cmb1_OnEditComplete(iIndex)
    cont1.lblSellCond0.caption = ""
    cont1.lblSellCond1.caption = ""
    cont1.Image0.imgpath = "checkmenu_n"
    ---------------------------------
    --이익보존도 같이 초기화 
    ---------------------------------
    cont1.lblSellCond2.caption = ""
    cont1.lblSellCond3.caption = ""
    cont1.lblSellCond2.enable = false
    cont1.cmb2.enable = false
    DisplaySet_CondSet(false)
    cont1.Image2.imgpath = "checkmenu_n"
    g_isChk2 = false
    ---------------------------------
    local sKey = cont1.cmb1.cbkeydata
    Form.SetEnvData(1, "17100_SELL_MONITOR_COND_1", sKey)
    if sKey == "01" then
        cont1.img2.visible = false
        cont1.lblSellCond1.visible = false
        cont1.lbl3.left = 182
    elseif sKey == "02" then
        cont1.img2.visible = true
        cont1.lblSellCond1.visible = true
        cont1.lbl3.left = 277
    elseif sKey == "03" then
        cont1.img2.visible = true
        cont1.lblSellCond1.visible = true
        cont1.lbl3.left = 277
    else
        cont1.img2.visible = false
        cont1.lblSellCond1.visible = false
        cont1.lbl3.left = 182
    end
end

