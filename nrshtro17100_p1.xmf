function cont1_cmb6_OnEditComplete(iIndex)
    cont1.edtQty.caption = ""
    cont1.lblAbleRatio.caption = ""
    cont1.lblAbleQty.caption = ""
    local sKey = cont1.cmb6.cbkeydata
    Form.SetSharedData("17100_SELL_ORDER_COND_QTY" , sKey)
    if sKey == "01" then
        cont1.edtQty.hintcaption = "수량 입력"
        cont1.btnQPlus.visible = true
        cont1.btnQMinus.visible = true
        cont1.edtQty.visible = true
        cont1.btnQty.visible = true
        cont1.btnQty.BringFront("1")
        cont1.lblAbleRatio.visible = false
        cont1.lblAbleQty.visible = false
        cont1.img8.visible = false
    elseif sKey == "02" then
        cont1.cmb6.caption = "가능수량"
        local isOpen = Form.GetEnvData("AUTO_RULE_ABLE_QTY")
        if gf_Trim(isOpen) ~= "N"  and g_isFst == false then
            Form.MsgBox("안내", "감시 조건 설정 시점의 보유\n잔고를 기준으로 수량이 설정돼요.", "ABLEQTY", 7, "확인", "다시보지않기")
        end
        cont1.btnQPlus.visible = false
        cont1.btnQMinus.visible = false
        cont1.edtQty.visible = false
        cont1.btnQty.visible = false
        cont1.lblAbleRatio.visible = true
        cont1.lblAbleQty.visible = true
        cont1.img8.visible = true
        cont1.lblAbleRatio.caption = "100"
        DATAMANAGER.RequestTranData("obtro_oder_264r")
    end
end

function cont1_btnPrc0_OnClick()
    if gf_Tonumber(cont1.cmb5.currentindex) == 0 then
        cont1.Combo0.OpenList()
    elseif gf_Tonumber(cont1.cmb5.currentindex) == 4 then
        local sLinkData = "0"									--매도/매수 구분 (매도:0, 매수:1)
        sLinkData = sLinkData .. "`" .. "0"					--가격/수량 구분 (가격:0, 수량:1)
        sLinkData = sLinkData .. "`" .. Replace_Prc(cont1.edtPrc0.caption)		--가격/수량 값   
        sLinkData = sLinkData .. "`" .. "12"							--정수부 자릿수
        sLinkData = sLinkData .. "`" .. contHidden.lblDecimal.caption	--소숫점 자리
        sLinkData = sLinkData .. "`" .. contHidden.lblCrcd.caption	--뒷첨자 
        sLinkData = sLinkData .. "`" .. "매도_주문가격"			--리턴받을 키값
        Form.OpenPopup("nrshtro17100_p0" , sLinkData, "")
    end
end

