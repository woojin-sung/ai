-- --------------------------------------------------------------
-- 1?? 공통함수 import
-- --------------------------------------------------------------
dofile("scr/script.lua")
dofile("scr/json.lua")

function Form_OnPopupReturn(sKeyName, sRet)
    if sKeyName == "DLG_SELECT" then
        Check_ItemCode(sRet)
    elseif sKeyName == "AUTO_RULE_KEYPAD_END" then
        local arrRet = Convert_StrToArr(sRet, "`")
        local nArrCnt = #arrRet
        if nArrCnt > 1 then
            local sKey = arrRet[1+1]
            local sValue = arrRet[2+1]
            if sKey == "매도_기준가" then
                DisplaySet_BasePrc(sValue, true, true)
            elseif sKey == "매도_이익실현" then
                if isEmpty(sValue) == true or gf_Tonumber(sValue) == 0 then
                    Form.ShowAlert("알림", "이익 실현 값을 입력해 주세요.")
                    return
                end
                --				sKey2 = cont1.cmb1.cbkeydata
                --				if sKey2 == "03" and gf_Tonumber(sValue) == 0 then
                --					Form.ShowAlert("알림", "이익 실현 값을 입력해 주세요.")
                --					return
                --				end
                DisplaySet_Cond1(sValue, true)
            elseif sKey == "매도_이익보존" then
                if isEmpty(sValue) == true or gf_Tonumber(sValue) == 0 then
                    Form.ShowAlert("알림", "이익 보존 값을 입력해 주세요.")
                    return
                end
                --				sKey2 = cont1.cmb2.cbkeydata
                --				if sKey2 == "03" and gf_Tonumber(sValue) == 0 then
                --					Form.ShowAlert("알림", "이익 보존 값을 입력해 주세요.")
                --					return
                --				end
                DisplaySet_Cond2(sValue, true)
            elseif sKey == "매도_손실제한" then
                if isEmpty(sValue) == true or gf_Tonumber(sValue) == 0 then
                    Form.ShowAlert("알림", "손실 제한 값을 입력해 주세요.")
                    return
                end
                --				sKey2 = cont1.cmb3.cbkeydata
                --				if sKey2 == "03" and gf_Tonumber(sValue) == 0 then
                --					Form.ShowAlert("알림", "손실 제한 값을 입력해 주세요.")
                --					return
                --				end
                DisplaySet_Cond3(sValue, true)
            elseif sKey == "매도_주문수량" then
                --				if isEmpty(sValue) == true or gf_Tonumber(sValue) == 0 then
                --					Form.ShowAlert("알림", "주문 수량을 입력해 주세요.")
                --					return
                --				end
                DisplaySet_OrderQty(sValue)
            elseif sKey == "매도_주문가격" then
                --				if isEmpty(sValue) == true or gf_Tonumber(sValue) == 0 then
                --					cont1.edtPrc0.caption = ""
                --					Form.ShowAlert("알림", "주문 가격을 입력해 주세요.")
                --					return
                --				end
                DisplaySet_OrderPrc(sValue, true)
            elseif sKey == "매도_주문가능수량" then
                if isEmpty(sValue) == true or gf_Tonumber(sValue) == 0 then
                    Form.ShowAlert("알림", "주문 수량 비율을 입력해 주세요.")
                    return
                end
                DisplaySet_OrderAbleQty(sValue)
            end
        end
    elseif sKeyName == "ORDER_CONFIRM_CHECK" then
        if sRet == "ok" then
            if g_isPTP == "Y" then
                local szData = "91" .. "|" .. ""	-- 매매구분|메시지
                --Form.OpenPopup("mhtro16060_p15", szData , "")	--OnPopupReturn -> "PTP주문경고"
                Form.OpenPopupAnimation("mhtro16100_p15", szData, "", "2")
            else
                --				g_sAutoRule = "01"
                --				if g_isModify == true then
                --					AutoRule_Update() 
                --				else
                --					AutoRule_Create()
                --				end
                --v20250729_01 >>
                Form.MsgBox("안내", "등록하신 감시 조건을\n바로 실행하시겠습니까?\n(감시는 정규장에서만 실행돼요.)", "MONITORING_EXECUTE", 7, "실행하기", "취소")
                --v20250729_01 <<
            end
        end
    elseif sKeyName == "PTP주문경고" then
        --		g_sAutoRule = "01"
        --		if g_isModify == true then
        --			AutoRule_Update() 
        --		else
        --			AutoRule_Create()
        --		end
        --v20250729_01 >>
        Form.MsgBox("안내", "등록하신 감시 조건을\n바로 실행하시겠습니까?\n(감시는 정규장에서만 실행돼요.)", "MONITORING_EXECUTE", 7, "실행하기", "취소")
        --v20250729_01 <<
    elseif sKeyName == "MYCOND_RETURN" then
        local arrLinkData = Convert_StrToArr(sRet, "`")
        local nArrCnt = #arrLinkData
        if nArrCnt > 0 then
            --			g_isModify_OneTime = true
            local orderConditionId 		= ""
            local registrationDate 		= ""
            local accountNumber			= arrLinkData[1+1]
            local accountSeqNumber		= arrLinkData[2+1]
            local stockExchangeCode		= arrLinkData[3+1]
            local stockCode				= arrLinkData[4+1]
            local stockKoreaName			= arrLinkData[5+1]
            local tradeType				= arrLinkData[6+1]
            local priceTypeprofit			= arrLinkData[7+1]
            local priceTypeNameprofit		= arrLinkData[8+1]
            local priceTypeValueprofit		= arrLinkData[9+1]
            local priceprofit			= arrLinkData[10+1]
            local priceTypepreserve		= arrLinkData[11+1]
            local priceTypeNamepreserve	= arrLinkData[12+1]
            local priceTypeValuepreserve	= arrLinkData[13+1]
            local pricepreserve			= arrLinkData[14+1]
            local priceTypestopLoss		= arrLinkData[15+1]
            local priceTypeNamestopLoss	= arrLinkData[16+1]
            local priceTypeValuestopLoss	= arrLinkData[17+1]
            local pricestopLoss 			= arrLinkData[18+1]
            local orderPaymentType		= arrLinkData[19+1]
            local orderClsType			= arrLinkData[20+1]
            local orderClsTypeNm			= arrLinkData[21+1]
            local orderPriceType			= arrLinkData[22+1]
            local tickValue				= arrLinkData[23+1]
            local orderPrice				= arrLinkData[24+1]
            local orderQty				= arrLinkData[25+1]
            local expirationDate			= arrLinkData[26+1]
            local conditionStatusCode		= ""
            local conditionStatusName		= ""
            local basePriceClsType		= arrLinkData[27+1]
            local basePriceClsTypeName		= arrLinkData[28+1]
            local basePrice				= arrLinkData[29+1]
            local sItemCode = Transform_Exid2(stockExchangeCode) .. "@" .. stockCode
            Check_ItemCode(sItemCode)
            if isEmpty(expirationDate) == false then
                cont1.Calendar0.caption = replace(expirationDate, "-")
            end
        end
        ----------------------------------
        -- 비밀번호 입력 (직접 / 주문자동)
        ----------------------------------
    elseif sKeyName == "CORRECT_PWD" then
        ----------------------------------
        -- 비밀번호 입력 완료
        ----------------------------------
        if sRet ~= "" then
            local szAcnt
            local tData = gf_Split(sRet, "★")
            if #tData > 0 then
                g_sPwd = tData[1+1]
                Form.PostLinkData("17100_PWD_CHANGE", sRet)
            end
            DATAMANAGER.RequestTranData("obtro_oder_132r")
        end 
    end
end

function DATAMANAGER_OnSendTranBefore(szTranID)
    ------------------------------------------
    -- 해외주식 현재가 - 프리/정규장
    ------------------------------------------
    if szTranID == "ohhts_6000_001r" then
        DATAMANAGER.ClearInputData(0, "ohhts_6000_001r")
        DATAMANAGER.SetDataValue( 0, "ohhts_6000_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" 	, 0 , "OV" )		--시장구분			
        DATAMANAGER.SetDataValue( 0, "ohhts_6000_001r", "InBlock1", "FID_COND_MRKT_CLS_CODE" 		, 0 , g_sExid )		--마켓구분
        DATAMANAGER.SetDataValue( 0, "ohhts_6000_001r", "InBlock1", "FID_INPUT_OVRS_ISCD" 			, 0 , g_sCode )		--종목코드
        DATAMANAGER.SetDataValue( 0, "ohhts_6000_001r", "InBlock1", "FIDX_INPUT_DELY_RLTM_CLS_CODE" 	, 0 , g_rtChk )		--실시간 여부
        --해외주식 종목 기본정보 및 주간시세 보정용
    elseif szTranID == "ohhts_6000_001r_1" then
        DATAMANAGER.ClearInputData(0, "ohhts_6000_001r_1")
        DATAMANAGER.SetDataValue( 0, "ohhts_6000_001r_1", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" 	, 0 , "OV" )		--시장구분			
        DATAMANAGER.SetDataValue( 0, "ohhts_6000_001r_1", "InBlock1", "FID_COND_MRKT_CLS_CODE" 		, 0 , g_sExid )		--마켓구분
        DATAMANAGER.SetDataValue( 0, "ohhts_6000_001r_1", "InBlock1", "FID_INPUT_OVRS_ISCD" 			, 0 , g_sCode )		--종목코드
        DATAMANAGER.SetDataValue( 0, "ohhts_6000_001r_1", "InBlock1", "FIDX_INPUT_DELY_RLTM_CLS_CODE" 	, 0 , g_rtChk )		--실시간 여부
        ------------------------------------------
        -- 해외주식 현재가 - 주간장
        ------------------------------------------
    elseif szTranID == "ohhts_6000_017r" then
        DATAMANAGER.ClearInputData(0, "ohhts_6000_017r")
        DATAMANAGER.SetDataValue( 0, "ohhts_6000_017r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" 	, 0 , "OV" )		--시장구분			
        DATAMANAGER.SetDataValue( 0, "ohhts_6000_017r", "InBlock1", "FID_COND_MRKT_CLS_CODE" 		, 0 , g_sExid )		--마켓구분
        DATAMANAGER.SetDataValue( 0, "ohhts_6000_017r", "InBlock1", "FID_INPUT_OVRS_ISCD" 			, 0 , g_sCode )		--종목코드
        DATAMANAGER.SetDataValue( 0, "ohhts_6000_017r", "InBlock1", "FIDX_INPUT_DELY_RLTM_CLS_CODE" 	, 0 , g_rtChk )		--실시간 여부
        ------------------------------------------
        -- 해외주식 현재가 - 야간장
        ------------------------------------------
    elseif szTranID == "ohhts_6000_023r" then
        DATAMANAGER.ClearInputData(0, "ohhts_6000_023r")
        DATAMANAGER.SetDataValue( 0, "ohhts_6000_023r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" 	, 0 , "OV" )		--시장구분			
        DATAMANAGER.SetDataValue( 0, "ohhts_6000_023r", "InBlock1", "FID_COND_MRKT_CLS_CODE" 		, 0 , g_sExid )		--마켓구분
        DATAMANAGER.SetDataValue( 0, "ohhts_6000_023r", "InBlock1", "FID_INPUT_OVRS_ISCD" 			, 0 , g_sCode )		--종목코드
        DATAMANAGER.SetDataValue( 0, "ohhts_6000_023r", "InBlock1", "FIDX_INPUT_DELY_RLTM_CLS_CODE" 	, 0 , g_rtChk )		--실시간 여부
        ------------------------------------------
        -- 미국장 영업일 조회
        ------------------------------------------
    elseif szTranID == "obtro_comn_006r" then
        DATAMANAGER.ClearInputData(0, "obtro_comn_006r")
        DATAMANAGER.SetDataValue(0, "obtro_comn_006r", "InBlock1", "OVRS_EXCH_VNDR_IDNO" , 0 , g_sExid3)
        ------------------------------------------
        -- 해외주식 종목정보
        ------------------------------------------
    elseif szTranID == "obsim_oscm_331r" then
        DATAMANAGER.ClearInputData(0, "obsim_oscm_331r")
        DATAMANAGER.SetDataValue(0, "obsim_oscm_331r", "InBlock1", "ISCD" , 0 , g_sCode.."."..g_sExid)
    elseif szTranID == "obtro_oder_264r" then
        DATAMANAGER.ClearInputData(0, "obtro_oder_264r")
        DATAMANAGER.SetDataValue(0, "obtro_oder_264r", "InBlock1", "IQRY_CLS_CODE" 		, 0 , "1")
        DATAMANAGER.SetDataValue(0, "obtro_oder_264r", "InBlock1", "ACNO" 				, 0 , g_sAcno)
        DATAMANAGER.SetDataValue(0, "obtro_oder_264r", "InBlock1", "ASNO" 				, 0 , g_sAsno)
        DATAMANAGER.SetDataValue(0, "obtro_oder_264r", "InBlock1", "OVRS_STCK_SYMB_ISCD" 	, 0 , g_sCode)
        DATAMANAGER.SetDataValue(0, "obtro_oder_264r", "InBlock1", "OVRS_EXCH_VNDR_IDNO" 	, 0 , g_sExid3)
        DATAMANAGER.SetDataValue(0, "obtro_oder_264r", "InBlock1", "SELN_BYOV_CLCD" 		, 0 , "1")
        local sRatio = Replace_Prc(cont1.lblAbleRatio.caption)
        DATAMANAGER.SetDataValue(0, "obtro_oder_264r", "InBlock1", "APLY_RATE" 		, 0 , sRatio)
    elseif szTranID == "obtro_oder_132r" then
        DATAMANAGER.SetDataValue(0, "obtro_oder_132r", "InBlock1", "ACNO"			, 0 , g_sAcno)
        DATAMANAGER.SetDataValue(0, "obtro_oder_132r", "InBlock1", "ASNO"			, 0 , g_sAsno)
        DATAMANAGER.SetDataValue(0, "obtro_oder_132r", "InBlock1", "ACNT_PWD"		, 0 , g_sPwd)
        DATAMANAGER.SetDataValue(0, "obtro_oder_132r", "InBlock1", "OVRS_STCK_SYMB_ISCD"	, 0 , g_sCode)
        DATAMANAGER.SetDataValue(0, "obtro_oder_132r", "InBlock1", "OVRS_EXCH_VNDR_IDNO"	, 0 , g_sExid3)
        DATAMANAGER.SetDataValue(0, "obtro_oder_132r", "InBlock1", "SELN_BYOV_CLCD"		, 0, "1")									-- 매도/매수구분코드
        DATAMANAGER.SetDataValue(0, "obtro_oder_132r", "InBlock1", "ODER_CLS_CODE"			, 0, cont1.cmb4.cbkeydata)							-- 주문구분코드
        DATAMANAGER.SetDataValue(0, "obtro_oder_132r", "InBlock1", "ODER_COND_CLS_CODE"		, 0, Check_OrdCond(cont1.cmb4.cbkeydata))				-- 주문조건구분코드
      
        local nQty = 0
        
        if cont1.cmb6.cbkeydata == "01" then
            nQty = gf_Tonumber(cont1.edtQty.caption)
        elseif cont1.cmb6.cbkeydata == "02" then
            nQty =  gf_Tonumber(cont1.lblAbleQty.caption)
        end
        
        DATAMANAGER.SetDataValue(0, "obtro_oder_132r", "InBlock1", "ODQT"				, 0, nQty)							-- 주문수량
      
        local szPrc = ""
        
        if cont1.cmb4.cbkeydata ~= "05" and cont1.cmb4.cbkeydata ~= "34" then
            --			if cont1.cmb5.cbkeydata == "01" then
            --
            --				sPrc = contHidden.lblHyun.caption
            --				nUnit = gf_Tonumber(GetHogaUnit(g_sExid3, sPrc, 0))
            --				
            --				nResultPrc = gf_Tonumber(sPrc) + (nUnit * gf_Tonumber(cont1.Combo0.cbkeydata))
            --	
            --				szPrc = nResultPrc
            
            if cont1.cmb5.cbkeydata == "09" then
                szPrc = Replace_Prc(cont1.edtPrc0.caption)
                --			else
                --				szPrc = contHidden.lblHyun.caption
            end
            
            szPrc = ReSet_Prc(szPrc, 0)
            
        end
        
        DATAMANAGER.SetDataValue(0, "obtro_oder_132r", "InBlock1", "OVRS_STCK_ODER_PRC"	, 0, szPrc)									-- 주문단가
        DATAMANAGER.SetDataValue(0, "obtro_oder_132r", "InBlock1", "ODER_OCRN_TYPE_CODE"	, 0, "01")									-- 주문발생유형코드(01:일반주문)
        DATAMANAGER.SetDataValue(0, "obtro_oder_132r", "InBlock1", "WARN_CNFR_YN"		, 0, g_szWarnFlag)	
        
    elseif szTranID == "obtro_acnt_174r" then
        DATAMANAGER.ClearInputData(0, "obtro_acnt_174r")
        DATAMANAGER.SetDataValue(0, "obtro_acnt_174r", "InBlock1", "ACNO"			, 0 , g_sAcno)
        DATAMANAGER.SetDataValue(0, "obtro_acnt_174r", "InBlock1", "ASNO"			, 0 , g_sAsno)
        DATAMANAGER.SetDataValue(0, "obtro_acnt_174r", "InBlock1", "ACNT_PWD"		, 0 , g_sPwd)
        --뉴욕/아멕스/나스닥
        local sMktClsCd = ""
        if g_sExid3 == "0321" or g_sExid3 == "0066" or g_sExid3 == "0537" then
            sMktClsCd = "01"		
            --심천
        elseif g_sExid3 == "0214" then
            sMktClsCd = "04"
            --상해
        elseif g_sExid3 == "0215" then
            sMktClsCd = "03"
            --홍콩
        elseif g_sExid3 == "0104" then
            sMktClsCd = "02"
            --일본
        elseif g_sExid3 == "0106" then
            sMktClsCd = "05"							
        end
        DATAMANAGER.SetDataValue(0, "obtro_acnt_174r", "InBlock1", "OVRS_STCK_MRKT_TR_CLS_CODE"		, 0 , sMktClsCd)
        DATAMANAGER.SetDataValue(0, "obtro_acnt_174r", "InBlock1", "ISCD"		, 0 , g_sCode .. "." .. g_sExid)
    end
end

function Check_OrdCond(szIdx)
    if szIdx == "01" then
        return "0" --지정가
    elseif szIdx == "05" then
        return "0" --시장가
    elseif szIdx == "31" then
        return "2" --LOO
    elseif szIdx == "32" then
        return "7" --LOC
    elseif szIdx == "33" then
        return "2" --MOO
    elseif szIdx == "34" then
        return "7" --MOC
    elseif szIdx == "35" then
        return "0" --Limit VWAP
    elseif szIdx == "36" then
        return "0" --Limit TWAP
    elseif szIdx == "37" then
        return "0" --VWAP
    elseif szIdx == "38" then
        return "0" --TWAP
    else
        return "0"
    end
end

function DATAMANAGER_OnReceiveTranComplete(szTranID)
    local sOsType = Form.GetSharedData("..OS_TYPE", false)
    if szTranID == "ohhts_6000_001r_1" then
        local sBusinessName 	= DATAMANAGER.GetDataValue(0, "ohhts_6000_001r_1", "OutBlock1", "FIDX_BSTP_MDDV_NAME", 0)	-- 업종명
        local sEtfEtn 		= DATAMANAGER.GetDataValue(0, "ohhts_6000_001r_1", "OutBlock1", "FIDX_ETF_TYPE_CODE", 0) 	-- ETF여부
        local sLvrg 		= DATAMANAGER.GetDataValue(0, "ohhts_6000_001r_1", "OutBlock1", "FID_LVRG", 0) 			-- 레버리지
        local sData = g_sCode .. " | " .. Transform_Exid(g_sExid2)
        local szLvrg = Form.GetItemCodeInfo(g_sItemCode, "lvrgratio")
        if sEtfEtn == "001" then
            if gf_Tonumber(szLvrg) == 89 then
                sData = sData .. " | ETF(변동)"
            else
                sData = sData .. " | ETF(" .. gf_CommaValue(sLvrg,1) .. ")"
            end
        elseif sEtfEtn == "002" then
            if gf_Tonumber(szLvrg) == 89 then
                sData = sData .. " | ETN(변동)"
            else
                sData = sData .. " | ETN(" .. gf_CommaValue(sLvrg,1) .. ")"
            end
        else
            sData = sData .. " | " .. sBusinessName
        end
        ---------------------------------
        -- 종목정보 세팅
        ---------------------------------
        DisplaySetting_ItemSubInfo(sData, g_isTradingSuspend, g_isSellOnly, g_isPTP)
        ---------------------------------
        -- 주간시세 보정용 시세정보
        ---------------------------------
        g_sHyun 	= DATAMANAGER.GetDataValue(0, "ohhts_6000_001r_1", "OutBlock1", "FIDX_PRPR", 0)	--현재가
        g_sHyunEx 	= DATAMANAGER.GetDataValue(0, "ohhts_6000_001r_1", "OutBlock1", "FIDX_UNCH_PRPR" , 0)	--환산현재가
        g_sOpen 	= DATAMANAGER.GetDataValue(0, "ohhts_6000_001r_1", "OutBlock1", "FIDX_OPRC", 0)	--시가
        g_sHigh 	= DATAMANAGER.GetDataValue(0, "ohhts_6000_001r_1", "OutBlock1", "FIDX_MXPR", 0)	--상한가
        g_sLow 	= DATAMANAGER.GetDataValue(0, "ohhts_6000_001r_1", "OutBlock1", "FIDX_LLAM", 0)	--하한가
        g_sClose 	= DATAMANAGER.GetDataValue(0, "ohhts_6000_001r_1", "OutBlock1", "FIDX_PRDY_VRSS", 0)	--전일대비
        g_sCloseRate = DATAMANAGER.GetDataValue(0, "ohhts_6000_001r_1", "OutBlock1", "FIDX_PRDY_CTRT", 0)	--전일대비율
        g_sCloseSign = DATAMANAGER.GetDataValue(0, "ohhts_6000_001r_1", "OutBlock1", "FIDX_PRDY_VRSS_SIGN" , 0)	--전일대비부호
        g_sHyun_ATTR 	= DATAMANAGER.GetDataAttr(0, "ohhts_6000_001r_1", "OutBlock1", "FIDX_PRPR", 0)	
        g_sHyunEx_ATTR 	= DATAMANAGER.GetDataAttr(0, "ohhts_6000_001r_1", "OutBlock1", "FIDX_UNCH_PRPR", 0)	
        g_sClose_ATTR 	= DATAMANAGER.GetDataAttr(0, "ohhts_6000_001r_1", "OutBlock1", "FIDX_PRDY_VRSS", 0)	
        g_sCloseRate_ATTR 	= DATAMANAGER.GetDataAttr(0, "ohhts_6000_001r_1", "OutBlock1", "FIDX_PRDY_CTRT", 0)	
        ---------------------------------
        -- 매입단가 조회 (최신화)
        ---------------------------------
        DATAMANAGER.RequestTranData("obtro_acnt_174r")
        --		---------------------------------
        --		-- 해외주식 시세조회
        --		---------------------------------
        --		Request_MktOp(g_szMktOpClsCd)
    elseif szTranID == "obtro_acnt_174r" then
        g_sAvrgPrc = DATAMANAGER.GetDataValue(0, "obtro_acnt_174r", "OutBlock1", "AVRG_UNPR", 0)	
        ---------------------------------
        -- 해외주식 시세조회
        ---------------------------------
        Request_MktOp(g_szMktOpClsCd)
    elseif szTranID == "ohhts_6000_001r" or szTranID == "ohhts_6000_017r" or szTranID == "ohhts_6000_023r" then
        DisplaySet_CondSet(false) 
        --		if g_isModify == true then
        --			DisplayPrevSet_LinkInfo()
        if isEmpty(basePriceClsType) == false then
            cont1.cmb0.cbkeydata = basePriceClsType
            if basePriceClsType == "01" then
                basePrice = g_sAvrgPrc
                Form.Toast(2, "현재 시점의 평균단가로 조건 수정이 가능해요.", 1)
            end
        else
            cont1.cmb0.cbkeydata = g_mCondBase
        end
        cont1_cmb0_OnEditComplete(0)
        DisplaySet_BasePrc(basePrice, false, false)
        if isEmpty(priceTypeprofit) == false then
            cont1.cmb1.cbkeydata = priceTypeprofit
        else
            cont1.cmb1.cbkeydata = g_mCond1
        end
        cont1_cmb1_OnEditComplete(0)
        if priceTypeprofit == "01" then
            DisplaySet_Cond1(priceprofit, false)
        else
            DisplaySet_Cond1(priceTypeValueprofit, false)
        end
        if isEmpty(priceTypepreserve) == false then
            cont1.cmb2.cbkeydata = priceTypepreserve
        end
        cont1_cmb2_OnEditComplete(0)
        if priceTypepreserve == "01" then
            DisplaySet_Cond2(pricepreserve, false)
        else
            DisplaySet_Cond2(priceTypeValuepreserve, false)
        end
        if isEmpty(priceTypestopLoss) == false then
            cont1.cmb3.cbkeydata = priceTypestopLoss
        else
            cont1.cmb3.cbkeydata = g_mCond3
        end
        cont1_cmb3_OnEditComplete(0)
        if priceTypestopLoss == "01" then
            DisplaySet_Cond3(pricestopLoss, false)
        else
            DisplaySet_Cond3(priceTypeValuestopLoss, false)
        end
        if isEmpty(orderClsType) == false then
            cont1.cmb4.cbkeydata = orderClsType
        else
            cont1.cmb4.cbkeydata = g_oCondType
        end
        cont1_cmb4_OnEditComplete(0)
        if cont1.cmb4.cbkeydata ~= "05" and cont1.cmb4.cbkeydata ~= "34" then
            if isEmpty(orderPriceType) == false then
                cont1.cmb5.cbkeydata = orderPriceType
            else
                cont1.cmb5.cbkeydata = g_oCondPrc
            end
            cont1_cmb5_OnEditComplete(0)
        end
        --			DisplaySet_OrderQty(orderQty)
        if isEmpty(orderQty) == false then
            DisplaySet_OrderQty(orderQty)
        elseif isEmpty(g_oCondQty) == false then
            cont1.cmb6.cbkeydata = g_oCondQty
            cont1_cmb6_OnEditComplete(0)
        end
        --			if cont1.cmb5.enable == true then
        local sKey = cont1.cmb5.cbkeydata
        local sOrderPrc = ""
        if sKey == "01" then
            sOrderPrc = tickValue
        elseif sKey == "09" then
            sOrderPrc = orderPrice
        end
        DisplaySet_OrderPrc(sOrderPrc, false)
        --			end if
        --		end if
        g_isFst = false
        --		g_isModify_OneTime = false
        -----------------------
        -- 실시간 등록
        -----------------------
        if szTranID == "ohhts_6000_001r" then
            DATAMANAGER.RequestRealData( "ohhts_exst_cntg" )
        elseif szTranID == "ohhts_6000_017r" then
            DATAMANAGER.RequestRealData( "ohhts_exst_cntd" )
        elseif szTranID == "ohhts_6000_023r" then
            DATAMANAGER.RequestRealData( "ohhts_exst_cnta" )
        end
    elseif szTranID == "obtro_comn_006r" then
        g_sBizDate   		= DATAMANAGER.GetDataValue(0, "obtro_comn_006r", "OutBlock1", "BSOP_DATE"	, 0) -- 미국장 영업일
        if isEmpty(expirationDate) == false then
            cont1.Calendar0.caption = string.gsub(expirationDate, "-", "")
        else
            cont1.Calendar0.caption = CalcDate("d",89)
        end
    elseif szTranID == "obsim_oscm_331r" then
        g_isSellOnly   		= DATAMANAGER.GetDataValue(0, "obsim_oscm_331r", "OutBlock1", "BYOV_PRHB_YN"	, 0) -- 매수불가여부
        g_isTradingSuspend   = DATAMANAGER.GetDataValue(0, "obsim_oscm_331r", "OutBlock1", "TRHT_YN"		, 0) -- 거래정지여부
        g_szBaseDate   		= DATAMANAGER.GetDataValue(0, "obsim_oscm_331r", "OutBlock2", "STND_DATE"		, 0) -- 기준일
        g_isHoliday    		= DATAMANAGER.GetDataValue(0, "obsim_oscm_331r", "OutBlock2", "HLDY_YN"		, 0) -- 휴일여부
        g_isPTP      		= DATAMANAGER.GetDataValue(0, "obsim_oscm_331r", "OutBlock2", "PTP_ISSU_YN"	, 0) -- PTP종목여부
        Convert_MktOpInfo(g_szMktOpClsCd)
        DisplaySetting_MktOperation(g_szMktOp, g_isMktClosed, g_szSubMktOp, g_szBaseDate, g_isHoliday)
        --해외주식 종목 기본정보 및 주간시세 보정용
        DATAMANAGER.RequestTranData("ohhts_6000_001r_1")
    elseif szTranID == "obtro_oder_264r" then
        g_sOrderAbleQty = DATAMANAGER.GetDataValue(0, "obtro_oder_264r", "OutBlock1", "ODER_ABLE_QTY"	, 0)
    elseif szTranID == "obtro_oder_132r"then
        btnReg.enable = true
        if g_szOdrPop == "1" then
            Open_Confirm()
        else
            if g_isPTP == "Y" then
                local szData = "90" .. "|" .. ""	-- 매매구분|메시지
                --Form.OpenPopup("mhtro16060_p15", szData , "")	--OnPopupReturn -> "PTP주문경고"
                Form.OpenPopupAnimation("mhtro16100_p15", szData, "", "2")
            else
                --				g_sAutoRule = "01"
                --				if g_isModify == true then
                --					AutoRule_Update() 
                --				else
                --					AutoRule_Create()
                --				end if
                --v20250729_01 >>
                Form.MsgBox("안내", "등록하신 감시 조건을\n바로 실행하시겠습니까?\n(감시는 정규장에서만 실행돼요.)", "MONITORING_EXECUTE", 7, "실행하기", "취소")
                --v20250729_01 << 
            end
        end
    end
end

