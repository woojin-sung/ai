function Form_OnLinkData(sKey, sValue)
    --20250804_01 YSH START
    --해외주식 장운영 정보 조회방식 변경
    if sKey == "OVRS_MARKET_OPERATION_TRAN" then
        --Form.ShowAlert("자동감시주문_매도_nrshtro17100_p1", "조회 성공 여부 : " .. sValue)
        if sValue == "SUCCESS" then
            if g_sExid ~= "" then
                local sKey = "..OVRS_MARKET_OPERATION_" .. Transform_Exid4(g_sExid)
                g_szMktOpClsCd = Form.GetSharedData(sKey, false)
                Check_ItemCode(g_sItemCode)
            end
        end
    elseif sKey == "OVRS_MARKET_OPERATION_REAL" then
        --Form.ShowAlert("자동감시주문_매도_nrshtro17100_p1", "실시간 조회 성공 여부 : " .. sValue .. " / g_sExid : " .. Transform_Exid4(g_sExid))
        local arrMktData = gf_Split(sValue, "@")
        if arrMktData[1+1] == Transform_Exid4(g_sExid) and g_szMktOpClsCd ~= arrMktData[2+1] then
            g_szMktOpClsCd = arrMktData[2+1]
            Convert_MktOpInfo(g_szMktOpClsCd)
            DisplaySetting_MktOperation(g_szMktOp, g_isMktClosed, g_szSubMktOp, g_szBaseDate, g_isHoliday)
            Cancel_Real_Total()
            --해외주식 종목 기본정보 및 주간시세 보정용
            DATAMANAGER.RequestTranData("ohhts_6000_001r_1")
        end
    end
    --20250804_01 YSH END
end

