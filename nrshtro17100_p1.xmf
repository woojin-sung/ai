    ---------------------------------
    cont1.lblSellCond2.caption = ""
    cont1.lblSellCond3.caption = ""
    cont1.lblSellCond2.enable = false
    cont1.cmb2.enable = false
    DisplaySet_CondSet(false)
    cont1.Image2.imgpath = "checkmenu_n"
    g_isChk2 = false
    ---------------------------------
    local sLinkData = ""
    if sKey == "01" then
        sLinkData = "0"											--매도/매수 구분 (매도:0, 매수:1)
        sLinkData = sLinkData .. "`" .. "0"							--가격/수량 구분 (가격:0, 수량:1, 등락률:2)
        sLinkData = sLinkData .. "`" .. Replace_Prc(cont1.lblSellCond0.caption)--가격/수량 값   
        sLinkData = sLinkData .. "`" .. "12"							--정수부 자릿수
        sLinkData = sLinkData .. "`" .. contHidden.lblDecimal.caption		--소숫점 자리
        sLinkData = sLinkData .. "`" .. contHidden.lblCrcd.caption			--뒷첨자 
    elseif sKey == "02" then
        sLinkData = "0"											--매도/매수 구분 (매도:0, 매수:1)
        sLinkData = sLinkData .. "`" .. "2"							--가격/수량 구분 (가격:0, 수량:1, 등락률:2)
        sLinkData = sLinkData .. "`" .. Replace_Prc(cont1.lblSellCond0.caption)--가격/수량 값   
        sLinkData = sLinkData .. "`" .. "4"							--정수부 자릿수
        sLinkData = sLinkData .. "`" .. "2"							--소숫점 자리
        sLinkData = sLinkData .. "`" .. "%"							--뒷첨자 
    elseif sKey == "03" then
        sLinkData = "0"											--매도/매수 구분 (매도:0, 매수:1)
        sLinkData = sLinkData .. "`" .. "3"							--가격/수량 구분 (가격:0, 수량:1, 등락률:2)
        sLinkData = sLinkData .. "`" .. Replace_Prc(cont1.lblSellCond0.caption)--가격/수량 값
        sLinkData = sLinkData .. "`" .. "4"							--정수부 자릿수
        sLinkData = sLinkData .. "`" .. "0"							--소숫점 자리
        sLinkData = sLinkData .. "`" .. "틱"							--뒷첨자 
    else
        return
    end
    sLinkData = sLinkData .. "`" .. "매도_이익실현"					--리턴받을 키값
    Form.OpenPopup("nrshtro17100_p0" , sLinkData, "")
end

