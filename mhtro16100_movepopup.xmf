Sub contOvrsStock_ButtonLink1_OnClick()
	
	if gMarket <> "" then
		
		Form.SendReturnToParent("MOVEPOPUP_RETURN" , gIndex & "★" & "MOVE_CHART")
		Form.CloseForm()
		
	else
		
		Form.MsgBox("안내", "해당 종목은 온라인에서\n거래가 불가합니다.\n\n영업점 또는 해외주식 데스크로 문의해주세요.", "OnLineCheck", 6)
	
	end if
	
End Sub

