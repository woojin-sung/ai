	<SCRIPT_INFO _len="20796" _ulen="19278" >
'20241216 LES START - 해외주식 미국종목 휴일인 경우에는 정규장 종가로 조회
'20250522 JSH - PTP종목조회 무브팝업(시세조회가능하도록 화면번호추가)
' 20250627 HWG : v0001 : 미국주식 애프터장 실시간 시세 추가 
' 20250708 YSH : v0002 : 해외주식 장운영 정보 조회방식 변경
' 20250924 : HWG : v20250924_02 : 물타기 계산기 신규개발

Dim gType
Dim gYPos
Dim gHeight
Dim gIndex
Dim gName
Dim gCode
Dim gVndrCode
Dim gMarket

Dim gOsType

Dim gUSItem
gUSItem = "N"

Dim gDayMarket
gDayMarket = "N"

Dim gApplyRealSise
gApplyRealSise = "N"

Dim gAddTopPos
gAddTopPos = 0

'v0001 >>
Dim gAfterMarket
gAfterMarket = "N"
'v0001 <<

'v0002 >>
Dim g_szMkOpClsCd
g_szMkOpClsCd = ""
'v0002 <<

'============================================================================
Sub Form_OnFormInitBefore()

	gOsType = Form.GetSharedData("&OS_TYPE", false )
	
	'--------------------------------------
	' 대비/등락률 간격 조정을 위해서 호출
	'--------------------------------------
	contOvrsStock.LabelDebi.sizeAutoFit()
	
	
	contOvrsStock.imgLink4.maintainratio = "3"
	
	szTheme = Form.GetEnvData("common.theme")
	
	if szTheme == "black" then
		contOvrsStock.imgLink4.imgpath = "icon_w_calculator_d"
	else
		contOvrsStock.imgLink4.imgpath = "icon_w_calculator_l"
	end if
	
	nWidth = Form.getTextWidth("물타기 계산기",-2,true,false)
	
	contOvrsStock.imgLink4.left = 375 - nWidth - 20 - 45
End Sub

'============================================================================
Sub Form_OnFormInit()
	
	
	'-----------------------------------------
	' 컨트롤 설정
	'-----------------------------------------
	contOvrsStock.LabelName.transmode = "1"
	
	contOvrsStock.LabelName.paddinginfo		 = "0,0,0,0"
	contOvrsStock.LabelPrice.paddinginfo 	 = "0,0,0,0"
	contOvrsStock.LabelDebiSign.paddinginfo 	 = "0,0,0,0"
	contOvrsStock.LabelDebi.paddinginfo 		 = "0,0,0,0"
	contOvrsStock.LabelRate.paddinginfo 		 = "0,0,0,0"
	
	contOvrsStock.LabelName.maxlinecnt = "2^-4"

	'---------------------------------------------------------------------------------------------------
	'호출화면구분명★선택행의Y좌표★선택행의높이★선택행인덱스★종목명★종목코드★거래소벤더코드(4자리)
	'---------------------------------------------------------------------------------------------------
	szData = Form.GetOpenLinkData()
	arrData = Split(szData , "★")
	
	if #arrData > 2 then
	
		gType 		= arrData(0) 
		gYPos 		= arrData(1)
		gHeight 		= arrData(2)
		gIndex 		= arrData(3)
		gName 		= arrData(4)
		gCode 		= arrData(5)
		gVndrCode 	= arrData(6)
		gMarket		= GetMarketCode(gVndrCode)
		
		'v20250924_02 >>
		sOrdGbn		= ""
		if #arrData >= 8 then
			sOrdGbn = arrData(7)
		end if
		'v20250924_02 <<
		'-----------------------------------------
		' 주간장 여부
		'-----------------------------------------
		gDayMarket = Form.GetSharedData( "&OVRS_DAYMARKET", false ) 

		'-----------------------------------------
		' 미국종목 여부
		'-----------------------------------------
		if gMarket == "OQ" or gMarket == "AX" or gMarket == "NY" then
			gUSItem = "Y"
		end if
		
		'-----------------------------------------
		' 실시간 시세 적용여부(해외종합잔고에서 호출시에만 시세 조회/실시간 호출)
		'-----------------------------------------
		sParentScrNo = Form.GetSharedData("&SCREEN_NO", false)
		if sParentScrNo == "16070" or sParentScrNo == "16037" then '20250522 JSH - PTP종목조회(16037)
			gApplyRealSise = "Y"
			
			'-----------------------------------------------------------
			' 시세조회
			'-----------------------------------------------------------
			'20241216 LES START - 미국종목의 경우 장운영정보 먼저 조회
			'-----------------------------------------------------------
			if gUSItem == "Y" then
				RequestMarketInfo()
			else
				RequestData()
			end if
			'-----------------------------------------------------------
			'20241216 LES END
			'-----------------------------------------------------------
			
			'v20250924_02 >>
			if sParentScrNo <> "16070" then
				contOvrsStock.height = 107
				contOvrsStock.ImageBg.height = 107
				contOvrsStock.ButtonLink4.visible = false
				contOvrsStock.imgLink4.visible = false
			else
				if sOrdGbn == "현금" then
					contOvrsStock.height = 150
					contOvrsStock.ImageBg.height = 150
					
					contOvrsStock.ButtonLink4.visible = true
					contOvrsStock.imgLink4.visible = true
				else
					contOvrsStock.height = 107
					contOvrsStock.ImageBg.height = 107
					contOvrsStock.ButtonLink4.visible = false
					contOvrsStock.imgLink4.visible = false
				end if
			end if
			'v20250924_02 <<
		else
		
			'--------------------------
			' 종목명/시세영역 숨김처리
			'--------------------------
			SetHideSiseLabel()
			
			'v20250924_02 >>
			if sParentScrNo == "16060" then
				if sOrdGbn == "현금" then
					contOvrsStock.height = 57 + 42
					contOvrsStock.ImageBg.height = 57 + 42
					
					contOvrsStock.ButtonLink4.visible = true
					contOvrsStock.imgLink4.visible = true
				else
					contOvrsStock.ButtonLink4.visible = false
					contOvrsStock.imgLink4.visible = false
				end if
			else
				contOvrsStock.ButtonLink4.visible = false
				contOvrsStock.imgLink4.visible = false
			end if
			'v20250924_02 <<
		end if
		
		'-----------------------
		' 종목명 세팅
		'-----------------------
		contOvrsStock.LabelName.caption = gName
		
		'-----------------------
		' 위치설정
		'-----------------------
		SetMovePopupPos()
	
	else
		
		'Form.CloseForm()
	
	end if
	
End Sub
'============================================================================
Sub BtnClose_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Function SetMovePopupPos()
	
	'------------------------------------------------------------
	'(해외주식 주문 > 잔고 탭) : [현재가] [차트] [매수] [매도]
	'------------------------------------------------------------
	if gType == "OVRS_ODER_JANGO" then
	
		contOvrsStock.visible = true
		
		nScreenHeight = 600
		nConHeight 	= contOvrsStock.height
		nImageTop 	= contOvrsStock.ImageBg.top
		nImageHeight 	= contOvrsStock.ImageBg.height
		
		'---------------------------------------------------
		' 위로 떠야 하는 경우
		'---------------------------------------------------
		if nConHeight + gYPos + gHeight > nScreenHeight then
			
			if gOsType == "1" then
				contOvrsStock.top = gYPos - nConHeight + 3
				contOvrsStock.ImageBg.top = -2
			else
				contOvrsStock.top = gYPos - nConHeight - 3
				contOvrsStock.ImageBg.top = -3
			end if
		
			
			contOvrsStock.ImageBg.imgpath = "btn_link_shadow_bg2.9"
			
			contOvrsStock.LabelName.top 	= 15
			contOvrsStock.LabelPrice.top 	= 15
			contOvrsStock.LabelRate.top 	= 33
			contOvrsStock.LabelDebi.top 	= 33
			
			if gOsType == "1" then
				contOvrsStock.LabelDebiSign.top = 35
			else
				contOvrsStock.LabelDebiSign.top = 33
			end if
			
			contOvrsStock.ButtonLink0.top = gAddTopPos + 59
			contOvrsStock.ButtonLink1.top = gAddTopPos + 59
			contOvrsStock.ButtonLink2.top = gAddTopPos + 59
			contOvrsStock.ButtonLink3.top = gAddTopPos + 59
			contOvrsStock.ButtonLink4.top = gAddTopPos + 59 + 38	'v20250924_02 >>
			contOvrsStock.imgLink4.top = gAddTopPos + 59 + 46
			
			contOvrsStock.LabelBg.visible = true
			contOvrsStock.LabelBg.top = gAddTopPos + 68
			
		'---------------------------------------------------
		' 아래로 떠야 하는 경우
		'---------------------------------------------------
		else
		
			contOvrsStock.top = gYPos + gHeight - 10
			contOvrsStock.ImageBg.imgpath = "btn_link_shadow_bg.9"
			
			contOvrsStock.LabelName.top 	= 20
			contOvrsStock.LabelPrice.top 	= 20
			
			if gOsType == "1" then
				contOvrsStock.LabelRate.top 	= 34
				contOvrsStock.LabelDebi.top 	= 34
				contOvrsStock.LabelDebiSign.top = 36
			else
				contOvrsStock.LabelRate.top 	= 36
				contOvrsStock.LabelDebi.top 	= 36
				contOvrsStock.LabelDebiSign.top = 36
			end if
			
			contOvrsStock.ButtonLink0.top = gAddTopPos + 65
			contOvrsStock.ButtonLink1.top = gAddTopPos + 65
			contOvrsStock.ButtonLink2.top = gAddTopPos + 65
			contOvrsStock.ButtonLink3.top = gAddTopPos + 65
			contOvrsStock.ButtonLink4.top = gAddTopPos + 65 + 38	'v20250924_02 >>
			contOvrsStock.imgLink4.top = gAddTopPos + 65 + 46
			
			contOvrsStock.LabelBg.visible = true
		
		end if
	
	end if


End Function

'============================================================================
' 장운영정보 조회 
'============================================================================
Function RequestMarketInfo()
	'20250704 YSH START : 해외주식 장운영 정보 조회방식 변경
	szMkOpClsCd = Form.GetSharedData("&OVRS_MARKET_OPERATION_US", false)
	if szMkOpClsCd <> "" and g_szMkOpClsCd <> szMkOpClsCd then
		g_szMkOpClsCd = szMkOpClsCd
		'000:휴장/013:휴일
		if szMkOpClsCd == "013" or szMkOpClsCd == "000" then
			gDayMarket = "N"
		end if
		
		'v0001 >>
		if szMkOpClsCd == "005" then
			gAfterMarket = "Y"
		end if
		'v0001 <<
		
		RequestData()
	end if
	'20250704 YSH END
End Function

'============================================================================
' 종목 시세조회
'============================================================================
Function RequestData()
	
	'----------------------------------
	'해당 거래소 실시간 신청여부
	'----------------------------------
	szDelay = Form.GetSharedData("REALTIME_"..gMarket, false)
	
	
	'----------------------------------------------------
	'주간장 & 미국종목일 경우에만 주간현재가 조회 서비스 호출
	'----------------------------------------------------
	if gDayMarket == "Y" and gUSItem == "Y" then
	
		DATAMANAGER.SetDataValue( 0, "ohhts_6000_017r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" 	, 0 , "OV" ) 		' 해외주식 OV
		DATAMANAGER.SetDataValue( 0, "ohhts_6000_017r", "InBlock1", "FID_INPUT_OVRS_ISCD" 		, 0 , gCode ) 	' 종목코드
		DATAMANAGER.SetDataValue( 0, "ohhts_6000_017r", "InBlock1", "FID_COND_MRKT_CLS_CODE" 		, 0 , gMarket ) 	' 거래소코드
		DATAMANAGER.SetDataValue( 0, "ohhts_6000_017r", "InBlock1", "FIDX_INPUT_DELY_RLTM_CLS_CODE"	, 0 , szDelay ) 	' 실시간구분 0 : 실시간 (Default), 1:지연
		DATAMANAGER.RequestTranData("ohhts_6000_017r")
	
	else
		'v0001 >>
		if gAfterMarket == "Y" and gUSItem == "Y" then
			DATAMANAGER.SetDataValue( 0, "ohhts_6000_023r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" 	, 0 , "OV" ) 		' 해외주식 OV
			DATAMANAGER.SetDataValue( 0, "ohhts_6000_023r", "InBlock1", "FID_INPUT_OVRS_ISCD" 		, 0 , gCode ) 	' 종목코드
			DATAMANAGER.SetDataValue( 0, "ohhts_6000_023r", "InBlock1", "FID_COND_MRKT_CLS_CODE" 		, 0 , gMarket ) 	' 거래소코드
			DATAMANAGER.SetDataValue( 0, "ohhts_6000_023r", "InBlock1", "FIDX_INPUT_DELY_RLTM_CLS_CODE"	, 0 , szDelay ) 	' 실시간구분 0 : 실시간 (Default), 1:지연
			DATAMANAGER.RequestTranData("ohhts_6000_023r")
			
		else
			DATAMANAGER.SetDataValue( 0, "ohhts_6000_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" 	, 0 , "OV" ) 		' 해외주식 OV
			DATAMANAGER.SetDataValue( 0, "ohhts_6000_001r", "InBlock1", "FID_INPUT_OVRS_ISCD" 		, 0 , gCode ) 	' 종목코드
			DATAMANAGER.SetDataValue( 0, "ohhts_6000_001r", "InBlock1", "FID_COND_MRKT_CLS_CODE" 		, 0 , gMarket ) 	' 거래소코드
			DATAMANAGER.SetDataValue( 0, "ohhts_6000_001r", "InBlock1", "FIDX_INPUT_DELY_RLTM_CLS_CODE"	, 0 , szDelay ) 	' 실시간구분 0 : 실시간 (Default), 1:지연
			DATAMANAGER.RequestTranData("ohhts_6000_001r")
			
		end if
		'v0001 <<
		
	end if
	
End Function
'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	
	'v0001
	if szTranID == "ohhts_6000_001r" or szTranID == "ohhts_6000_017r" or szTranID == "ohhts_6000_023r"then
		
		'---------------------------------------
		'실시간 해제 및 인풋값 클리어
		'---------------------------------------
		DATAMANAGER.CancelRealData("ohhts_exst_cntg")
		DATAMANAGER.CancelRealData("ohhts_exst_cntd")
		DATAMANAGER.CancelRealData("ohhts_exst_cnta")		'v0001 
		
		DATAMANAGER.ClearInputData(1, "ohhts_exst_cntg")
		DATAMANAGER.ClearInputData(1, "ohhts_exst_cntd")
		DATAMANAGER.ClearInputData(1, "ohhts_exst_cnta")	'v0001 	
		
		'---------------------------------------
		' 실시간 호출 여부
		'---------------------------------------
		if gApplyRealSise == "Y" then
			
			'---------------------------------------
			'미국
			'---------------------------------------
			if gUSItem == "Y" then
				'---------------------------------------
				' 주간장
				'---------------------------------------
				if gDayMarket == "Y" then
					
					DATAMANAGER.SetDataValue(1, "ohhts_exst_cntd", "InBlock1", "FIDXR_ISCD" , 0 , gMarket & "@" & gCode)
					DATAMANAGER.RequestRealData("ohhts_exst_cntd")
				
				'---------------------------------------
				' 정규장 
				'---------------------------------------
				else
				
					DATAMANAGER.SetDataValue(1, "ohhts_exst_cntg", "InBlock1", "FIDXR_ISCD" , 0 , gMarket & "@" & gCode)
					DATAMANAGER.RequestRealData("ohhts_exst_cntg")
					
					'v0001 >>
					DATAMANAGER.SetDataValue(1, "ohhts_exst_cnta", "InBlock1", "FIDXR_ISCD" , 0 , gMarket & "@" & gCode)
					DATAMANAGER.RequestRealData("ohhts_exst_cnta")
					'v0001 <<
				
				end if
				
			'---------------------------------------
			'중국/홍콩/일본
			'---------------------------------------
			else
			
				DATAMANAGER.SetDataValue(1, "ohhts_exst_cntg", "InBlock1", "FIDXR_ISCD" , 0 , gMarket & "@" & gCode)
				DATAMANAGER.RequestRealData("ohhts_exst_cntg")
			
			end if
		
		end if
		
		'------------------------------------------------------------------------------
		' 주간장 조회 시 거래량이 0이면 정규장 시세 서비스 호출
		'------------------------------------------------------------------------------
		if szTranID == "ohhts_6000_017r" then
			nVol = Cint(DATAMANAGER.GetDataValue(0, "ohhts_6000_017r", "OutBlock1", "FIDX_DYTM_ACML_VOL" , 0))
			
			if nVol == 0 then
			
				szDelay = Form.GetSharedData("REALTIME_"..gMarket, false)
				DATAMANAGER.SetDataValue( 0, "ohhts_6000_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" 	, 0 , "OV" ) 		' 해외주식 OV
				DATAMANAGER.SetDataValue( 0, "ohhts_6000_001r", "InBlock1", "FID_INPUT_OVRS_ISCD" 		, 0 , gCode ) 	' 종목코드
				DATAMANAGER.SetDataValue( 0, "ohhts_6000_001r", "InBlock1", "FID_COND_MRKT_CLS_CODE" 		, 0 , gMarket ) 	' 거래소코드
				DATAMANAGER.SetDataValue( 0, "ohhts_6000_001r", "InBlock1", "FIDX_INPUT_DELY_RLTM_CLS_CODE"	, 0 , szDelay ) 	' 실시간구분 0 : 실시간 (Default), 1:지연
				DATAMANAGER.RequestTranData("ohhts_6000_001r")
			
			else
				
				contOvrsStock.LabelPrice.visible = true
				contOvrsStock.LabelDebi.visible = true
				contOvrsStock.LabelRate.visible = true
			
			end if
		
		'v0001
		elseif szTranID == "ohhts_6000_001r" or szTranID == "ohhts_6000_023r" then
		
			contOvrsStock.LabelPrice.visible = true
			contOvrsStock.LabelDebi.visible = true
			contOvrsStock.LabelRate.visible = true
			
		end if
		
	end if
	
End Sub
'============================================================================
' 거래소벤더코드(4자리) -> 거래소코드(2자리)
'============================================================================
Function GetMarketCode(sValue)

	if sValue == "0104" then	' 홍콩
		return "HK"
	elseif sValue == "0215" then ' 상해
		return "SH"
	elseif sValue == "0214" then ' 심천
		return "SZ"
	elseif sValue == "0321" then ' 뉴욕
		return "NY"
	elseif sValue == "0066" then ' 아멕스
		return "AX"
	elseif sValue == "0537" then ' 나스닥
		return "OQ"
	elseif sValue == "0106" then ' 도쿄
		return "JP"
	else
		return ""
	end if
	
end Function


'============================================================================
' 현재가
'============================================================================
Sub contOvrsStock_ButtonLink0_OnClick()

	if gMarket <> "" then

		Form.SendReturnToParent("MOVEPOPUP_RETURN" , gIndex & "★" & "MOVE_HYUN")
		Form.CloseForm()
	else
		
		Form.MsgBox("안내", "해당 종목은 온라인에서\n거래가 불가합니다.\n\n영업점 또는 해외주식 데스크로 문의해주세요.", "OnLineCheck", 6)
	
	end if
	
End Sub

