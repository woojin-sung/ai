End Sub

'============================================================================
Sub contOvrsStock_LabelDebi_OnSizeAutoFit()

	if gOsType == "1" then
		nLeftDebi = Form.calcUnResize(contOvrsStock.LabelDebi.left, "2")
		nWidthSign = Form.calcUnResize(contOvrsStock.LabelDebiSign.width, "2")
	else
		nLeftDebi = contOvrsStock.LabelDebi.left
		nWidthSign = contOvrsStock.LabelDebiSign.width
	end if
	
	contOvrsStock.LabelDebiSign.left = nLeftDebi - nWidthSign - 2

End Sub

'============================================================================
Function SetHideSiseLabel()

	contOvrsStock.LabelName.visible = false
	contOvrsStock.LabelPrice.visible = false
	contOvrsStock.LabelDebiSign.visible = false
	contOvrsStock.LabelDebi.visible = false
	contOvrsStock.LabelRate.visible = false
	
	contOvrsStock.height = 57
	contOvrsStock.ImageBg.height = 57
	gAddTopPos = -50
	
End Function

'============================================================================
Sub Form_OnFormClose()
	Form.SendReturnToParent("MOVEPOPUP_CLOSE" , "")
End Sub

'============================================================================
Sub Form_OnRefresh()
	if gApplyRealSise == "Y" then
		Form.CloseForm()
	end if
End Sub

'============================================================================
Sub Form_OnLinkData(sKey, sValue)
	'20250707 YSH TEST
	'showAlert(sKey & sValue)
	'20250704 YSH START : 해외주식 장운영 정보 조회방식 변경
	if sKey == "OVRS_MARKET_OPERATION_TRAN" then
		if gApplyRealSise == "Y" and gUSItem == "Y" then
			if sValue == "SUCCESS" then
				RequestMarketInfo()
			end if
		end if

	elseif sKey == "OVRS_MARKET_OPERATION_REAL" then
		arrMktData = Split(sValue, "@")
		if gApplyRealSise == "Y" and gUSItem == "Y" then
			if arrMktData(0) == "US" and arrMktData(1) == "006" then
				gAfterMarket = "N" 
				RequestData()
			end if
		end if
    end if
    '20250704 YSH END
End Sub



