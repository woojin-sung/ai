-- ****************************************************************************
--                C  O  M  M  O  N       F  U  N  C  T  I  O  N               
-- ****************************************************************************

-- ===============================================
-- Form_OnFormInit
-- ===============================================
function Form_OnFormInit()
	-- -----------------------------------------------
	-- 패딩값 초기화 (위치변경 X)
	-- -----------------------------------------------
	lblTemp335.paddinginfo = "0,0,0,0"
	lblTemp310.paddinginfo = "0,0,0,0"
	lblTemp295.paddinginfo = "0,0,0,0"
	lblTemp280.paddinginfo = "0,0,0,0"
	Pannel0.setNotUseRecycleView(true)
	
	-- ------------------------------------------------------------------------------
	-- 라벨컨트롤 라인수 체크 시 OS별 동작 타이밍 다름
	-- iOS : 즉시 라인수 체크 가능
	-- 안드로이드 : 지연처리 후 라인수 체크 가능(컨트롤 생성 타이밍 때문으로 보임)
	-- ------------------------------------------------------------------------------
	if g_szOsType == "2" then
		Init_Control()
	else
		Form.setDelayEvent(1, 0.1)
	end if
end

-- ===============================================
-- Form_OnDelayEvent(1회 실행)
-- ===============================================
function Form_OnDelayEvent(nID)
	if gf_Tonumber(nID) == 1 then
		Init_Control()
	end if
end

-- ===============================================
-- imgInfo_OnClick
-- ===============================================
function imgClose_OnClick()
	Form.CloseForm()
end

-- ===============================================
-- imgAlpha_OnClick
-- ===============================================
function imgAlpha_OnClick()
	Form.CloseForm()
end

-- ===============================================
-- imgAlpha_OnClick
-- ===============================================
function btnOk_OnClick()
	Form.SendReturnToParent("CHECK_AGREE" , "ok")
	Form.CloseForm()
end

-- ============================================================================

function ChkButton0_OnChange(sCheckState)
	if gf_Tonumber(sCheckState) == 1 then
		btnOk.enable = true
	else
		btnOk.enable = false
	end if
end

-- ============================================================================

function Label0_OnClick()
	local nStat = gf_Tonumber(ChkButton0.checkstate)
	if gf_Tonumber(nStat) == 0 then
		ChkButton0.chksilence = "1"
		btnOk.enable = true
	else
		ChkButton0.chksilence = "0"
		btnOk.enable = false
	end if
end

