	g_szOcrnType 		= cont0.grdOrder.GetCellData( "bd_ocrntype", g_CnclOrdRow)
	g_szOrdDate 		= cont0.grdOrder.GetCellData( "bd_date", g_CnclOrdRow)
	g_szIndex 		= g_szIndex + 1
	DATAMANAGER.RequestTranData("obtro_oder_802a")
end

 --============================================================================
 -- Check_Account
 --============================================================================
function Check_Account(nGbn)
	local szAcnt, szPwd
 --	
	szAcnt = Form.GetTopCtlProp("acnt", "caption")
	
	if string.len(szAcnt) < 10 then
		Form.ShowAlert(g_szTitle, "계좌번호를 확인후 다시 입력하십시오.")
		return False
	end
	
	if nGbn ~= 2 then
		szPwd = Form.GetTopCtlProp("edtPwd", "caption")
		if gf_Trim(szPwd) == "" then
			Form.ShowAlert(g_szTitle, "비밀번호를 확인후 다시 입력하십시오.")
			return False
		end
	end
	
	return True
end

 --============================================================================
 -- Return_ContractScreen : 미체결팝업에서 리턴된 값 적용
 --============================================================================
function Return_ContractScreen(szRet)
	tData = gf_Split(szRet, "★")
	
	if #tData > 0 then
		szMkCd = Transform_Exid(tData[2+1])
		Form.TriggerEvent("#", "16060_CONTRACT", szMkCd .. "@" .. tData[1+1] .. "★" .. tData[3+1])
		
		 -- 주문번호
		edtOrgNo.caption = tData[5+1]						
		edtOrgNo_OnEditComplete()
		
		 -- 주문일자
		g_szOrdDate = tData[4+1]

		 -- 수량
		g_szQty = ""
		edtQty.caption = tData[6+1]	
		edtQty_OnEditComplete()
		g_szQty = tData[6+1]
	end
end

 --============================================================================
 -- 거래소코드 <- 거래소 벤더코드
 --============================================================================
function Transform_Exid(sValue)
	if sValue == "0104" then -- 홍콩
		return "HK"
	elseif sValue == "0215" then -- 상해
		return "SH"
	elseif sValue == "0214" then -- 심천거래소 종목
		return "SZ"
	elseif sValue == "0321" then -- 뉴욕
		return "NY"
	elseif sValue == "0066" then -- 아멕스
		return "AX"
	elseif sValue == "0537" then -- 나스닥
		return "OQ"
	elseif sValue == "0106" then -- 도쿄
		return "JP"
	end
end
