 --			orderData = Split(arrData[i],"|")
 --			g_szOrdDate = orderData[4]
 --			g_szAcptSrno = orderData[5]
 --			g_szOcrnType = orderData[6]
 --			DATAMANAGER.RequestTranData("obtro_oder_802a")
 --		next
 --	elseif g_LngNumofOrd = 1 then
 --		orderData = Split(arrData[0],"|")
