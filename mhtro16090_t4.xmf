 --============================================================================
 -- Load_OrderSet : 환경설정값 정의
 --============================================================================
function Load_OrderSet()
	g_szOdrPop     = Form.LoadConfigData("SET_ORDER", "OPEN_CONFIRM")			 -- 주문확인창
	g_szAfterInit  = Form.LoadConfigData("SET_ORDER", "AFERTORD_INIT")			 -- 주문전송 후 초기화
	g_szChangeInit = Form.LoadConfigData("SET_ORDER", "CHANGE_INIT")			 -- 종목/탭 변경시 초기화
	g_szAfterOrg   = Form.LoadConfigData("SET_ORDER", "AUTO_ORGNO")				 -- 원주문번호 자동입력
	
	 -- 주문확인창(기본값 : 사용)
	if gf_Trim(g_szOdrPop) == "" then
		g_szOdrPop = "1"
	end
	
	 -- 주문전송 후 초기화(기본값 : 사용)
	if gf_Trim(g_szAfterInit) == "" then
		g_szAfterInit = "1"
	end
	
	 --20170725 HAMWG START : 종목/탭 변경시 초기화 사용을 초기값으로 설정
	 -- 종목/탭 변경시 초기화(기본값 : 사용)
	if gf_Trim(g_szChangeInit) == "" then
		g_szChangeInit = "1"
	end
	 --20170725 HAMWG END
	
	 -- 원주문번호 자동입력(기본값 : 사용)
	if gf_Trim(g_szAfterOrg) == "" then
		g_szAfterOrg = "1"
	end
end

 --============================================================================
 -- Check_InputData
 --============================================================================
function Check_InputData(nGbn)
	 -- 계좌번호와 계좌비밀번호 체크
	if Check_Account(nGbn) == false then
		return false
	end
	
 --	if Trim(g_szCd) == "" then
 --		Form.ShowAlert(g_szTitle, "종목코드를 입력하십시요.")
 --		return false
 --	end if
 --
 --	if Trim(edtOrgNo.caption) == "" then
 --		Form.ShowAlert(g_szTitle, "원주문번호를 입력하십시요.")
 --		return false
 --	end if
	
 --	if chkAll.checkstate == "0" then		' 일부잔량 선택시
 --		if Trim(edtQty.caption) == "" or Trim(edtQty.caption) == "0" then
 --			Form.ShowAlert(g_szTitle, "주문수량을 입력하십시요.")
 --			return false
 --		end if
 --	end if
	Data_CancelOrder()
	if g_LngNumofOrd == 0 then
		return false
	end
	
	if nGbn ~= 2 then
 --		Data_CancelOrder()
		 -- 주문확인창 오픈여부
		if g_szOdrPop == "1" then
			Open_ConfirmPopup()
		else
			g_szIndex = 0
			Request_Order(g_szIndex)
		end
	end
	
	return true
end

 --============================================================================
 -- Data_CancelOrder 0509
 --============================================================================
function Data_CancelOrder()
	szData = ""
	g_szOrdData = ""
	g_LngNumofOrd = 0
	for i = g_nCnt, 0, -1 do
		szCheck = cont0.grdOrder.GetCellData( "bd_check", i)
		if szCheck == "1" then
			szScno 		= cont0.grdOrder.GetCellData( "bd_srno", i)
			szOcrntype 	= cont0.grdOrder.GetCellData( "bd_ocrntype", i)
			szDate 		= cont0.grdOrder.GetCellData( "bd_date", i)
			szGubun 		= cont0.grdOrder.GetCellData( "bd_gubun", i)
			szItmcode	= cont0.grdOrder.GetCellData( "bd_code", i).."|"..cont0.grdOrder.GetCellData( "bd_name", i)
			szData = Form.GetTopCtlProp("acnt", "caption")	 --계좌번호
			szData = szData .. "|" .. szGubun					 --매매구분
			szData = szData .. "|" .. szItmcode				 --종목코드,종목명
			szData = szData .. "|" .. szDate					 --주문일자
			szData = szData .. "|" .. szScno					 --접수일련번호
			szData = szData .. "|" .. szOcrntype .. "★"		 --주문발생유형코드
			ArrIdx(g_LngNumofOrd) = i 						 --row 인덱스 추가
			g_LngNumofOrd = g_LngNumofOrd+1
		end
	end
	g_szOrdData = szData
	
	if g_LngNumofOrd == 0 then
		Form.ShowAlert("안 내", "취소할 주문을 선택해주세요")
		return 
	else
		g_szOrdData = g_LngNumofOrd .. "|" .. g_szOrdData
	end
	
 --	g_sCodeData = Split(g_szCd, "@")
 --	szData = "3"													' 매매구분
 --	szData = szData & "|" & Form.GetTopCtlProp("acnt", "caption")		' 계좌번호
 --	szData = szData & "|" & Form.GetTopCtlProp("acnt", "accountname")	' 계좌명
 --	szData = szData & "|" & g_sCodeData[1]							' 종목코드
 --	szData = szData & "|" & g_szKorName								' 종목명
 --	szData = szData & "|" & "지정가"								' 주문구분
 --	szData = szData & "|" & "0"										' 현금
 --	szData = szData & "|" & LblQty.caption							' 주문수량
 --	szData = szData & "|" & edtPrcin.caption							' 주문가격
 --	szData = szData & "|" & ""										' 원주문번호
 --	szData = szData & "|" & "1"										' 전량전부
	
	 -- 20181022 HWG START : 해외주식 주문착오 방지
 --	if Trim(szWarn) <> "" then		' 경고팝업 오픈
 --		szData = szData & "|" & szWarn		' 경고메세지		
 --		Form.OpenPopupAnimation("mhtro16060_p7", szData , "")		
 --	else							' 주문확인팝업 오픈
 --		Form.OpenPopupAnimation("mhtro16090_p7", szData , "", "2") 
 --	end if
	 -- 20181022 HWG END
end
