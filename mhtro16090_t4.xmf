 --	' 20181022 HWG START : 해외주식 주문착오 방지
	if gf_Trim(szWarn) ~= "" then -- 경고팝업 오픈
		g_szOrdData = g_szOrdData .. "|" .. szWarn		 -- 경고메세지		
