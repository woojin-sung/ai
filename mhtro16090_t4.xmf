 --============================================================================
 -- btnMiche_OnClick : 미체결버튼 클릭
 --============================================================================
function btnMiche_OnClick()
	szAcnt 		= Form.GetTopCtlProp("acnt", "total")
	szAcntCd 	= Form.GetTopCtlProp("acnt", "sequence")
	
	 --20200910 SWJ START
	 --MTS메모리평문제거 적용상태일 때
	if plain_rm == "1" then
		szAcntPwd	= Form.GetTopCtlProp("edtPwd", "caption")
	 --MTS메모리평문제거 미적용상태일 때
	else
		szAcntPwd	= Form.GetTopCtlProp("edtPwd", "encdata")
	end
	 --20200910 SWJ END
	
	 -- 계좌번호(8), 계좌일련번호(2), 비밀번호
	szData = szAcnt .. "★" .. szAcntCd .. "★" .. szAcntPwd 
	Form.OpenFramePopup("mhtro16060_pc", szData, "")
end

 --============================================================================
 -- btnQty_OnClick
 --============================================================================
function btnQty_OnClick()
	if cont0.chkAll.checkstate == "0" then
		szData = "3★" .. edtQty.caption .. "★" .. _tonumber(g_szOrdSize)
		Form.OpenPopup("mhtro16060_p1", szData, "")
	end
end

 --============================================================================
function _tonumber(data)
	return gf_Tonumber(data) or 0
end

 --============================================================================
 -- btnCnl_OnClick : 취소버튼 클릭
 --============================================================================
function btnCnl_OnClick()
	local szCLS
	
	Check_InputData(0)
end
 --============================================================================
function cont0_ChkAll_OnChange(sCheckState)
 --	Form.SetSharedData("C_QCK", sCheckState)
	if g_nCnt > 0 then
		if sCheckState == "0" then
			for i = 0, g_nCnt-1 do
				cont0.grdOrder.SetCellData( "bd_check", i , "0")
			end
		else
			for i = 0, g_nCnt-1 do
				cont0.grdOrder.SetCellData( "bd_check", i , "1")
			end
		end
	end
end
 --============================================================================
function cont0_grdOrder_OnClickUp(lRow, szCellID)
	if szCellID == "bd_check" then
		szCheck = cont0.grdOrder.GetCellData("bd_check", lRow )
		if szCheck == "0" then
			cont0.ChkAll.chksilence = "0"
		elseif szCheck == "1" then
			ChkallYN()
 --			For i = 0 To g_nCnt-1  
 --				szChk = cont0.grdOrder.GetCellData( "bd_check", i)
 --				if szChk = "0" then
 --					exit for
 --				else
 --					cont0.ChkAll.chksilence = "1"
 --				end if
 --			Next
		end
	end
		
end

 --============================================================================
function cont0_LblAll_OnClick()
	sChkstate = cont0.ChkAll.chksilence
	if sChkstate == "0" then
		sChkstate = "1"
	elseif sChkstate == "1" then
		sChkstate = "0"
	end
	cont0.ChkAll.chksilence = sChkstate
	cont0_ChkAll_OnChange(sChkstate)
end

 --============================================================================
function ChkallYN()
	numChk = 0
	for i = 0, g_nCnt-1 do
		szChk = cont0.grdOrder.GetCellData( "bd_check", i)
		
		if szChk == "0" then
			return
		elseif szChk == "1" then
			numChk = numChk + 1
		end
	end
	if numChk == g_nCnt then
		cont0.ChkAll.chksilence = "1"
	end
end
 --============================================================================
function cont0_grdOrder_OnScrollEnd()
	isMore = DATAMANAGER.IsMoreNextData( "obtro_oder_810r" )
	if isMore == true or isMore == 1 or isMore == "1" then
		DATAMANAGER.RequestNextData( "obtro_oder_810r" )
	end
end
 --============================================================================
function f_SetGridData()
	nRowCnt = gf_Tonumber(cont0.grdOrder.rowcount)
	iRow = nRowCnt - g_nCnt
	for i = iRow, nRowCnt-1 do
		szCode = cont0.grdOrder.GetCellData( "bd_iscd", i)  --종목코드
		szItmnm = cont0.grdOrder.GetCellData( "bd_korisnm", i)  --한글종목명
		szAmt = cont0.grdOrder.GetCellData( "bd_oderamt", i)  --주문금액
		szQty = cont0.grdOrder.GetCellData( "bd_oderqty", i)  --주문소수점수량
		szMaemae = cont0.grdOrder.GetCellData( "bd_clcd", i)  --매수매도구분코드
					
		if szCode ~= "" then
			szCode = gf_Split(szCode, ".")
			if #szCode > 1 then
				cont0.grdOrder.SetCellData( "bd_code", i , szCode[0+1].."."..szCode[1+1])
			else
				cont0.grdOrder.SetCellData( "bd_code", i , szCode[0+1])
			end
		else
			cont0.grdOrder.SetCellData( "bd_code", i , szCode)
		end
		cont0.grdOrder.SetCellData( "bd_txt", i , "|")
		cont0.grdOrder.SetCellData( "bd_name", i , szItmnm)
			         
		cont0.grdOrder.SetCellData( "bd_txtamt", i , "주문금액" )
		cont0.grdOrder.SetCellData( "bd_txtqty", i , "예상수량" )
			       
		cont0.grdOrder.SetCellData( "bd_valamt", i , gf_Tonumber(szAmt) )
		cont0.grdOrder.SetCellData( "bd_valqty" , i , gf_Tonumber(szQty) )
 --		cont0.grdOrder.SetCellEnable("bd_check", i ,0) '체크박스 비활성화
				  
 --		cont0.grdOrder.SetCellData( "bd_date", i , "20220601" )
		if szMaemae == "2" then
			cont0.grdOrder.SetCellData( "bd_maemae", i , "매수" )
			cont0.grdOrder.SetCellFgColor("bd_maemae", i , "290")
		elseif szMaemae == "1" then
			cont0.grdOrder.SetCellData( "bd_maemae", i , "매도" )
			cont0.grdOrder.SetCellFgColor( "bd_maemae", i , "291" )
		end
	end
end
	
