				elseif szOrdPrc < 10000000 then
					szUnit = "10000"
					
				elseif szOrdPrc < 30000000 then
					szUnit = "10000"
		
				 --20250425 SWJ START
				elseif szOrdPrc < 50000000 then
					
					szUnit = "50000"
				
				else
					szUnit = "100000"
				
				 --20250425 SWJ END
		
				end
			else
				if szOrdPrc <= 1000 then
					szUnit = "1"
		
				elseif szOrdPrc <= 3000 then
					szUnit = "1"
		
				elseif szOrdPrc <= 5000 then
					szUnit = "5"
		
				elseif szOrdPrc <= 10000 then
					szUnit = "10"
		
