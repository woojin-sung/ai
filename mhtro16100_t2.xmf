 --============================================================================
 -- 단가/수량/금액 입력 키패드 링크데이터 생성
 --============================================================================
function GetLinkData(sGubun)

	 --==================================================
	 -- 연결화면 링크값 세팅
	 --==================================================
	 -- 0 : gGubun 				= 타이틀구분(단가/수량/금액)
	 -- 1 : gMarket 			= 시장구분(2자리)
	 -- 2 : gCode				= 종목코드
	 -- 3 : gCredit				= 현금/신용구분
	 -- 4 : gCurPrice 			= 현재가
	 -- 5 : gPrc				= 입력가격
	 -- 6 : gQty 				= 입력수량
	 -- 7 : gHighPrice 			= 상한가
	 -- 8 : gLowPrice 			= 하한가
	 -- 9 : gOrderGubun 		= 주문구분
	 -- 10 : gCurrency			= 통화구분
	 -- 11 : gDecimal			= 소수점자리수
	 -- 12 : gCalcOrderPrice 	= 주문금액(통화)
	 -- 13 : gCalcOrderPriceWon 	= 주문금액(원화)
	 -- 14 : gExchangeRate 		= 환율
	 -- 15 : g_szOrdSize		= 매매단위
	 -- 16 : gMarketCode		= 거래소코드(4자리)
	 -- 17 : gTickType			= 틱타입
	 -- 18 : gMaeMaeGubun		= 매매구분 : 매수(BUY) , 매도(SELL)
	 -- 19 : gAcno				= 계좌번호(8자리)
	 -- 20 : gAsno				= 계좌번호(2자리)
	 -- 21 : gTotalYN			= 통합증거금여부(Y/N)
	 --==================================================
		
	sCodeData = gf_Split(g_szCd, "@")
	szData = sGubun												 -- [0]타이틀구분
	szData = szData .. "|" .. sCodeData[0+1]								 -- [1]시장구분(2자리)
	szData = szData .. "|" .. sCodeData[1+1]								 -- [2]종목코드
	szData = szData .. "|" .. rdoGbn.currentindex						 -- [3]현금(0)/신용(1)구분
	szData = szData .. "|" .. g_szCurPrice								 -- [4]현재가
	szData = szData .. "|" .. edtPrc.caption							 -- [5]입력가격
	szData = szData .. "|" .. edtQty.caption							 -- [6]입력수량
	szData = szData .. "|" .. g_szUpLimit								 -- [7]상한가
	szData = szData .. "|" .. g_szDnLimit								 -- [8]하한가
	szData = szData .. "|" .. Check_OrdType()							 -- [9]주문구분
	szData = szData .. "|" .. g_szCurrency								 -- [10]통화기호
	szData = szData .. "|" .. g_szDecimal								 -- [11]소수점 자리수
	szData = szData .. "|" .. lblOrderPrice.caption						 -- [12]주문금액(통화)
	szData = szData .. "|" .. lblOrderPriceWon.caption					 -- [13]주문금액(원화)
	szData = szData .. "|" .. LabelExchangeRate.caption					 -- [14]환율
	szData = szData .. "|" .. g_szOrdSize								 -- [15]매매단위
	szData = szData .. "|" .. g_szMk									 -- [16]거래소코드(4자리)
	szData = szData .. "|" .. g_szTickType								 -- [17]틱타입
	szData = szData .. "|" .. "SELL"									 -- [18]매매구분 : 매수(BUY) , 매도(SELL)
	szData = szData .. "|" .. Form.GetTopCtlProp("acnt", "total")			 -- [19]계좌번호(8자리)
	szData = szData .. "|" .. Form.GetTopCtlProp("acnt", "sequence")		 -- [20]계좌번호(2자리)
	
	if gTotalYN == true then
		szData = szData .. "|" .. "Y"									 -- [21]통합증거금여부(Y/N)
	else
		szData = szData .. "|" .. "N"
	end
	
	return szData
	
end
 --============================================================================
function cmbType_OnEditComplete(iIndex)
	
	
	 -------------------------------------------------------
	 -- 주간거래일시, 지정가 주문여부 확인
	 -------------------------------------------------------
	sDayYN = Form.GetSharedData( "..OVRS_DAYMARKET", false )
	
	if sDayYN == "Y" and Check_OrdType() ~= "01" then
		if g_szMk == "0537" or g_szMk == "0321" or g_szMk == "0066" then
			Form.MsgBox("안내", "주간거래는 보통(지정가) 주문만 가능합니다.", "DAYMARKET", 6)
		end
	end
	
	 -------------------------------------------------------
	 --시장가/지정가 여부에 따른 가격입력창 비활성화
	 -------------------------------------------------------
	 --지정가/LOO/LOC/Limit VWAP/Limit TWAP
	 -------------------------------------------------------
	if Check_OrdType() = "01" or Check_OrdType() == "31" or Check_OrdType() == "32" 
		or Check_OrdType() == "35" or Check_OrdType() == "36" then
		
		btnPrc.enable = true
		btnPPlus.enable = true
		btnPMinus.enable = true
		edtPrc.enable = true
		
	else
		
		 -------------------------------------------------------
		 --시장가 / MOO / MOC / VWAP / TWAP
		 -------------------------------------------------------
		if Check_OrdType() == "05" or Check_OrdType() == "33" or Check_OrdType() == "34" 
			or Check_OrdType() == "37" or Check_OrdType() == "38" then
			
			btnPrc.enable = false
			btnPPlus.enable = false
			btnPMinus.enable = false
			edtPrc.enable = false
		
			edtPrc.caption =""
			Calc_OrderPrice()
			
		end
		
	end
	
	 ----------------------------------------------------------------------------------
	 -- VWAP, TWAP 주문유형(Limit포함) 선택 시 유의사항팝업.주간거래시간에는 안띄워줌.
	 ----------------------------------------------------------------------------------
	if Check_OrdType() == "35" or Check_OrdType() == "36" or Check_OrdType() == "37" or Check_OrdType() == "38" then
		
		if sDayYN ~= "Y" then
			bPopYN = Form.GetEnvData("OrdNotice_16100_p12")
			
			if bPopYN == "" or bPopYN == "0" then
				Form.OpenPopup("mhtro16100_p12" , "" , "") 
			end
		end
		
		if Check_OrdType() == "35" or Check_OrdType() == "36" then
		
			 --큰글씨 모드일때 글자폰트 수치 변경
			szTextSize = Form.GetEnvData("common.textsize")
			if gf_Tonumber(szTextSize) > 0 then
				cmbType.fontsize = -gf_Tonumber(szTextSize) * 3
			else
				cmbType.fontsize = -3
			end
				
		else
			cmbType.fontsize = -2
		end
		
	else
	
		cmbType.fontsize = -2
		
	end
	
	 -------------------------------------------------------
	 -- 시장가 유의사항팝업.주간거래시간에는 안띄워줌.
	 -------------------------------------------------------
	if Check_OrdType() == "05" then
		
		if sDayYN ~= "Y" then
			bPopYN = Form.GetEnvData("OrdNotice_16100")
			
			if bPopYN == "" or bPopYN == "0" then
				
				sText = "상/하한가가 없는 미국 시장의 특성 상\n해당종목의 가격이 급등락할 수 있으며 "..
					   "시장가 주문 시 현재가 또는 원하는 가격보다 낮거나 불리한 가격에 체결될 수 있음을 유의하시기 바랍니다."
				
				Form.MsgBox("시장가 주문 유의사항 안내",sText, "MARKET_ORDER_NOTICE" ,7, "확인","다시보지않기")
				
			end
		end
	
	end
	
end

 --============================================================================
 -- 매도화면 전용 함수
 --============================================================================
function SetControlPos(sType)
	
	if sType == "LOAN" then
	
		 --주문금액 영역 컨트롤 위치 이동
		Image0.top 				= 250
		Label1.top				= 250
		lblOrderPrice.top 		= 250
		lblOrderPriceWon.top 		= 283
		btnPrderPricePopup.top 	= 259
		btnOrderPrice.top 		= 259
		imgInfo.top 				= 261
		
		 --환율 정보 라벨 위치이동 / 크기 변경
		LabelExchangeRate.top 		= 311
		LabelExchangeRate.width 	= 110
		LabelExchangeRate.halign 	= 0
		
		 --전액상환 체크박스 위치이동/보임처리
		chkRepay.left = 285
		chkRepay.top = 309
		chkRepay.visible = true
		
		 --대출관련 정보 위치이동/보임처리
		LabelLoanName.left = 170
		LabelLoanDate.left = 250
		LabelLoanSrno.left = 170
		
		 --LabelLoanName.visible = true
		LabelLoanDate.visible = true
		LabelLoanSrno.visible = false
		
		 --주문버튼 텍스트 변경
		btnSell.caption = "대출매도"
	
	else
	
		 --주문금액 영역 컨트롤 위치 이동
		Image0.top 				= 271
		Label1.top				= 271
		lblOrderPrice.top 		= 271
		lblOrderPriceWon.top 		= 304
		btnPrderPricePopup.top 	= 280
		btnOrderPrice.top 		= 280
		imgInfo.top 				= 282
		
		 --환율 정보 라벨 위치이동 / 크기 변경
		LabelExchangeRate.top 		= 250
		LabelExchangeRate.width 	= 195
		LabelExchangeRate.halign 	= 2
		
		 --전액상환 체크박스 위치이동/숨김처리
		chkRepay.left = 1000
		chkRepay.top = 309
		chkRepay.visible = false
		
		 --대출관련 정보 위치이동/숨김처리
		LabelLoanName.left = 10
		LabelLoanDate.left = 10
		LabelLoanSrno.left = 10
		
		LabelLoanName.visible = false
		LabelLoanDate.visible = false
		LabelLoanSrno.visible = false
		
		 --주문버튼 텍스트 변경
		btnSell.caption = "현금매도"
		
	end
	

end


