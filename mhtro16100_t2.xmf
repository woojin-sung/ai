dofile("scr/json.lua")
 --==================================================================================================================
 -- 20241118 LES START => 주문수량 연동 관련 수정 
 -- : 종합잔고/매도팝업잔고 종목 선택 시, 주문수량 자동입력 "수량입력"으로 설정 되어있는 경우 "수량입력값"으로 세팅
 -- 
 --==================================================================================================================

local g_szOdrPop
local g_szAfterInit
local g_szChangeInit
local g_szSellQty, g_szSellQtyCnt
local g_szAfterOrg

local g_szCd, g_szMk, g_szNg -- 종목코드, 거래소코드, 국가코드
g_szCd = ""
g_szMk = ""
g_szNg = ""

local g_szWarnFlag -- 주문 경고 확인플래그
g_szWarnFlag	= "N"

local g_szTR
g_szTR = ""

local g_szTitle
g_szTitle = "알림"

local g_szOrdSize -- 매매단위
g_szOrdSize = ""

local g_szCurPrice -- 현재가
g_szCurPrice = ""

local g_szUpLimit -- 상한가
g_szUpLimit =  ""

local g_szDnLimit -- 하한가
g_szDnLimit =  ""

local g_szUnit -- 호가단위
g_szUnit =  ""

local g_szDecimal -- 종목가격 자릿수
g_szDecimal =  ""

local g_szKorName -- 한글종목명
g_szKorName =  ""

local g_szTickType -- 종목틱타입
g_szTickType =  ""

local g_szCurrency -- 통화
g_szCurrency = ""

local g_szCashNT -- 통합증거금 조회구분(N:일반 / T:통합)
g_szCashNT = ""

local gLoanType -- 대출구분
gLoanType = ""

local gLoanDate -- 대출일자
gLoanDate = ""

local gLoanSrno -- 대출일련번호
gLoanSrno = ""

local gReturnQty -- 잔고팝업에서 리턴된 수량이 있는지 여부
gReturnQty = false

local gReturnLoanData -- 잔고팝업에서 리턴된 대출정보가 있는지 여부
gReturnLoanData = false

local gTotalYN -- 통합증거금 약정여부
gTotalYN = false

local g_TotalReqComplete -- 통합증거금 조회완료 여부
g_TotalReqComplete = false

local g_AfterOrdAbleReq -- 주문전송 후 가능수량 재조회 여부
g_AfterOrdAbleReq = false

local gSettingSelectPrice -- 현재가 화면에서 연동된 가격이 있는지 여부
gSettingSelectPrice = false

local gSettingSelectPriceForAutoPrice --20240729
gSettingSelectPriceForAutoPrice = false

local gAlReadyCallAutoPrice --20240729
gAlReadyCallAutoPrice = false

local gOsType
local gMaxLen
gMaxLen = 12

local gConfirmPrice --20250102 HSZ: 주문확인창 전송가격

 --============================================================================
function Form_OnFormInitBefore()
	
	 ----------------------------------------------------
	 -- 매체구분
	 ----------------------------------------------------
	gOsType = Form.GetSharedData("..OS_TYPE", false)
	
	 ----------------------------------------------------
	 --이미지 찌그러짐 방지 API
	 ----------------------------------------------------
	imgInfo.SetMaintainingRatio("1")
	
	 ----------------------------------------------------
	 --컨트롤 패딩값 조절
	 ----------------------------------------------------
	lblOrderPrice.paddinginfo = "0,0,0,0"
	lblOrderPriceWon.paddinginfo = "0,0,0,0"

end

 --============================================================================
function Form_OnFormInit()
	
	 ----------------------------------------------------
	 --주문환경설정 값 Load
	 ----------------------------------------------------
	Load_OrderSet()
	
end

 --============================================================================
function Form_OnTriggerEvent(sEventName, sParam)

	 --============================================================================
	 -- 종목정보 연동
	 --============================================================================
	if sEventName == "SEND_ITEM_INFO" then
	
		 -------------------------------------------------------------------------------------------------
		 --현재가★상한가★하한가★매매단위(매수)★통화★소수점자리수★한글종목명★틱타입★매매단위(매도)
		 -------------------------------------------------------------------------------------------------
		arrItemInfo = gf_Split(sParam, "★")
		
		g_szCurPrice 	= arrItemInfo[0+1]
		g_szUpLimit	= arrItemInfo[1+1]
		g_szDnLimit	= arrItemInfo[2+1]
		g_szOrdSize 	= arrItemInfo[8+1]
		g_szCurrency	= arrItemInfo[4+1]
		g_szDecimal	= arrItemInfo[5+1]
		g_szKorName	= arrItemInfo[6+1]
		g_szTickType	= arrItemInfo[7+1]
		g_szUnit		= GetHogaUnit(g_szMk, g_szCurPrice, 0)
	
		 -------------------------------------------------------------------------
		 --가격입력창 소수점 자리수 세팅 / 통화기호 세팅
		 -------------------------------------------------------------------------
		if g_szCurrency ~= "" then
			sMask = "0,0,,".. " " .. g_szCurrency .. ",0,,"..g_szDecimal..",1,1,2,0"
		else
			sMask = "0,0,,,0,,"..g_szDecimal..",1,1,2,0"
		end
		
		edtPrc.mask = sMask
		
		 -------------------------------------------------------------------------
		 --수량입력창 매매단위 세팅
		 -------------------------------------------------------------------------
		if g_szOrdSize ~= "" then
			edtQty.hintcaption = gf_CommaValue(g_szOrdSize,0).."주 단위"
		end
		
		 -------------------------------------------------------------------------
		 --주문금액 가계산 초기세팅
		 -------------------------------------------------------------------------
		if g_szCurrency ~= "" then
			lblOrderPrice.caption = "- ".. g_szCurrency
			lblOrderPriceWon.caption = "- " .. "원"
		else
			lblOrderPrice.caption = "- "
			lblOrderPriceWon.caption = "- " .. "원"
		end
		
		 -------------------------------------------------------------------------
		 --종목/탭 변경시 가격입력창/수량입력창 입력값 초기화 
		 -------------------------------------------------------------------------
		if g_szChangeInit == "1" then
			Init_InputControl()
		end
		
		 -------------------------------------------------------------------------
		 --국가별 주문가능 주문유형 설정
		 -------------------------------------------------------------------------
		SetOrderTypeList(g_szNg)
		
		 -------------------------------------------------------------------------
		 --통화별 환율 조회
		 -------------------------------------------------------------------------
		RequestExChangeRate()
	
	 --============================================================================
	 -- 호가조회 완료(가격/수량 자동입력 요청)
	 --============================================================================
	elseif sEventName == "HOGA_COMPLETE" then
	
		 -----------------------------------------------------------------------------------
		 -- [금액 자동입력]
		 -----------------------------------------------------------------------------------
		 -- 현재가 호가테이블에서 진입 :  현재가 화면에서 선택한 호가 세팅(위치변경 ChangeAcnt)
		 -- 그 외 진입 : 종목/탭 변경 시 초기화 설정이 꺼져있는 경우 설정한 자동가격으로 세팅
		 -----------------------------------------------------------------------------------
		 --sPrice = Form.GetSharedData("PRICE", true)
		 --
		 --if sPrice ~= "" and sPrice ~= nil	then
		 --	edtPrc.caption = sPrice
		 --	
		 --else
			
			if g_szChangeInit ~= "1" then
				RequestAutoPrice()
			end
		
		 --end if
		
		 -----------------------------------------------------------------------------------
		 -- [수량 자동입력]
		 -----------------------------------------------------------------------------------
		if g_szChangeInit ~= "1" then
			RequestAutoQty()
		end
		
		
	 --============================================================================
	 -- 클릭 호가 연동
	 --============================================================================
	elseif sEventName == "CLICK_HOGA" then
		
		if Check_PrcOrd() ~= "시장가" then
			edtPrc.caption = sParam
			Calc_OrderPrice()
		end
		
	 --============================================================================
	 -- 종목코드 초기화/종목코드 변경/탭 변경
	 --============================================================================
	elseif sEventName == "InitCode" or sEventName == "ChangeCode" or sEventName == "ChangeTab" then
		
		 ---------------------------------------------------------------------------
		 --종목이 바뀐 경우
		 ---------------------------------------------------------------------------
		if g_szCd ~= sParam then
			
			g_szCd = sParam
			g_szNg = Form.GetItemCodeInfo(g_szCd, "ovsnation")	 -- 국가구분코드
			g_szMk = Form.GetItemCodeInfo(g_szCd, "exchid")		 -- 거래소벤더코드
			
			 -----------------------------------------------------------------------------------
			 --환율정보 라벨 클리어(이전 데이터 남아있어 깜빡임 방지)
			 -----------------------------------------------------------------------------------
			LabelExchangeRate.caption = ""
			
			 -----------------------------------------------------------------------------------
			 --20240613대출정보 클리어 (잔고팝업에서 넘어온 대출정보가 있는 경우 제외)
			 --잔고팝업에서 발생한 리턴이벤트가 먼저 발생하여 선택한 대출종목 정보 세팅되있는 상태임.
			 -----------------------------------------------------------------------------------
			 --아 근데.. 대출잔고 보고 > 일반잔고로 종목변경하고 > 현금/신용 이동하면 대출정보 남아있네...
			 --그러면.. 잔고팝업 리턴 이벤트에서 일반종목일 경우에 대출정보 클리어해주자
			 -----------------------------------------------------------------------------------
			ClearLoanData()
			
			
			if sEventName == "ChangeTab" then
			
				 -----------------------------------------------------------------------------------
				 -- [금액 자동입력]
				 -----------------------------------------------------------------------------------
				 -- 현재가 호가테이블에서 진입 :  현재가 화면에서 선택한 호가 세팅
				 -- 그 외 진입 : 종목/탭 변경 시 초기화 설정이 꺼져있는 경우 설정한 자동가격으로 세팅
				 -----------------------------------------------------------------------------------
				 --sPrice = Form.GetSharedData("PRICE", true)
				 --
				 --if sPrice ~= "" and sPrice ~= nil	then
				 --	edtPrc.caption = sPrice
					
				 --else
					
					if g_szChangeInit ~= "1" then
						RequestAutoPrice()
					end
				
				 --end if
				
				 -----------------------------------------------------------------------------------
				 -- [수량 자동입력]
				 -----------------------------------------------------------------------------------
				if g_szChangeInit ~= "1" then
					RequestAutoQty()
				end
				
			end
			
			 -----------------------------------------------------------------------
			 --20240613매도가능수량 조회
			 --미사용(0)이거나 수량입력(2)으로 설정되어있는 경우 여기서 조회
			 --보유잔고수량(1) 인 경우 수량 자동입력가능 상태이면 => RequestAutoQty() 에서 Request_Able 호출
			 --보유잔고수량(1) 이지만 수량 자동입력가능 상태가 아닌 경우 => 여기서 조회
			 -----------------------------------------------------------------------
			if g_szSellQty ~= "1" then
				Request_Able()
			else
				
				if g_szChangeInit == "1" then
					Request_Able()
				end
			
			end
			
		 ---------------------------------------------------------------------------
		 --종목이 안바뀐 경우
		 ---------------------------------------------------------------------------
		else
			
			 -----------------------------------------------------------------------------------
			 -- [금액 자동입력]
			 -----------------------------------------------------------------------------------
			 -- 현재가 호가테이블에서 진입 :  현재가 화면에서 선택한 호가 세팅(위치변경 ChangeAcnt)
			 -- 그 외 진입 : 종목/탭 변경 시 초기화 설정이 꺼져있는 경우 설정한 자동가격으로 세팅
			 -----------------------------------------------------------------------------------
			 --sPrice = Form.GetSharedData("PRICE", true)
			 --
			 --if sPrice ~= "" and sPrice ~= nil	then
			 --	edtPrc.caption = sPrice
			 --	
			 --else
				
				if g_szChangeInit ~= "1" then
					RequestAutoPrice()
				end
			
			 --end if
			
			 -----------------------------------------------------------------------------------
			 -- [수량 자동입력]
			 -----------------------------------------------------------------------------------
			if g_szChangeInit ~= "1" then
				RequestAutoQty()
			end
			
			 -----------------------------------------------------------------------
			 --20240613매도가능수량 조회
			 --미사용(0)이거나 수량입력(2)으로 설정되어있는 경우 여기서 조회
			 --보유잔고수량(1) 인 경우 수량 자동입력가능 상태이면 => RequestAutoQty() 에서 Request_Able 호출
			 --보유잔고수량(1) 이지만 수량 자동입력가능 상태가 아닌 경우 => 여기서 조회
			 -----------------------------------------------------------------------
			if g_szSellQty ~= "1" then
				Request_Able()
			
			else
				
				if g_szChangeInit == "1" then
					Request_Able()
				end
				
			end
			
			 -----------------------------------------------------------------------------------
			 --20240613대출정보 클리어 (잔고팝업에서 넘어온 대출정보가 있는 경우 제외)
			 --잔고팝업에서 발생한 리턴이벤트가 먼저 발생하여 선택한 대출종목 정보 세팅되있는 상태임.
			 -----------------------------------------------------------------------------------
			ClearLoanData()
			
		end
		
	 --============================================================================
	 -- 매수가격 자동입력
	 --============================================================================
	elseif sEventName == "ReturnAutoPrice" then
		
		 ----------------------------------------------------------
		 -- 종목/탭 변경 시 초기화가 꺼져있어도, 
		 -- 주문가격 자동입력이 미사용으로 되어있으면 빈값이 넘어옴.
		 -- 빈값으로 넘어온 경우에는 세팅해주지 않는다
		 ----------------------------------------------------------
		if g_szChangeInit ~= "1" and sParam ~= "" and gSettingSelectPriceForAutoPrice ~= true then --20240729 end end
			edtPrc.caption = sParam
			Calc_OrderPrice()
		end
		
		 --20240729
		if sParam ~= "" then
			gAlReadyCallAutoPrice = true
			gSettingSelectPriceForAutoPrice = false
		end
		
	 --============================================================================
	 -- 계좌변경(통합증거금 약정여부 조회 및 입력창 초기화)
	 --============================================================================	
	elseif sEventName == "ChangeAcnt" then
	
		RequestCombinedMargin()
		
		if g_szChangeInit == "1" then
			Init_InputControl()
		end
		
		ClearLoanData()
		
		 ------------------------------------------------------------------------------------------------------------------
		 -- 해외주식현재가 화면에서 가격연동 데이터가 있으면 데이터 세팅
		 ------------------------------------------------------------------------------------------------------------------
		 -- ### gSettingSelectPrice 변수설명 ###
		 ------------------------------------------------------------------------------------------------------------------
		 -- : 현재가에서 연동된 호가가 있는 경우 [SEND_DAYMARKET_PRC] or [SEND_AFTERMARKET_PRC]에서 가격세팅 방지
		 --
		 ------------------------------------------------------------------------------------------------------------------
		 -- ### gSettingSelectPriceForAutoPrice 변수설명 ###
		 ------------------------------------------------------------------------------------------------------------------
		 -- 정상적인 호출 순서 : [ReturnAutoPrice]호출 후 [ChangeAcnt]가 호출되면서 현재가 링크가격을 세팅
		 -- 간헐적으로 [ChangeAcnt] 호출 후에 [ReturnAutoPrice]가 호출되는 케이스 발생(설정한 자동가격으로 덮어씌어짐)
		 -- [ChangeAcnt]가 먼저 호출되어 gSettingSelectPriceForAutoPrice = true인 경우 [ReturnAutoPrice]에서 가격세팅 방지
		 --
		 ------------------------------------------------------------------------------------------------------------------
		 -- ### gAlReadyCallAutoPrice 변수 설명 ###
		 -- 정상적으로 [ReturnAutoPrice]호출 후 [ChangeAcnt]가 호출되면 gSettingSelectPriceForAutoPrice를 true로 변경해줄 필요가 없음.
		 -- 정상적으로 호출되었을때 gSettingSelectPriceForAutoPrice를 true로 변경해주면 오히려 문제가됨. 
		 -- ex) 다른탭으로 이동 후에 다시 돌아왔을때 설정한 자동입력 가격으로 세팅이 안됨
		 -- [ReturnAutoPrice]가 먼저 호출되었는지 판단하기 위해 gAlReadyCallAutoPrice 변수를 사용
		 -------------------------------------------------------------------------------------------------------------------
		sPrice = Form.GetSharedData("PRICE", true)
		
		if sPrice ~= "" and sPrice ~= nil then
			gSettingSelectPrice = true
			
			 --20240729
			if gAlReadyCallAutoPrice ~= true then
				gSettingSelectPriceForAutoPrice = true 
			end
			
			edtPrc.caption = sPrice
		end
		
		 -----------------------------------------------
		 -- 20240617 LES START 외부 타화면에서 잔고 링크
		 -----------------------------------------------
		sJanGo = Form.GetSharedData("JANGO", true )
		
		if sJanGo ~= "" and sJanGo ~= nil then
			
			 -----------------------------------------------------------------------------
			 --매도매수구분/수량/대출일자/대출상세유형코드/대출일련번호
			 -----------------------------------------------------------------------------
			szData = gf_Split(sJanGo,"★")
			
			 -------------------------------------------------------------
			 -- 수량연동
			 -------------------------------------------------------------
			 -- 20241118 LES START => 타화면에서 잔고종목이 넘어온 경우
			 -- 매도수량 자동입력 설정되어있는 경우 해당 수량으로,
			 -- 그외(미설정or보유잔고수량)인 경우 넘어온 수량 값으로 세팅
			 -------------------------------------------------------------
			 --edtQty.caption = szData[1+1]
			if g_szChangeInit ~= "1" and g_szSellQty == "2" then
				RequestAutoQty()
			else
				edtQty.caption = szData[1+1]
			end
			
			 -------------------------------------------------------------
			 -- 대출유형코드 세팅
			 -------------------------------------------------------------
			gLoanType = szData[3+1]
			
			 -------------------------------------------------------------
			 --대출잔고인 경우
			 -------------------------------------------------------------
			if gLoanType ~= "0000" then
			
				 -------------------------------------------------------------
				 --대출탭으로 변경
				 -------------------------------------------------------------
				rdoGbn.currentindex = 1
				LabelLoanName.visible = true
				
				 -------------------------------------------------------------
				 --대출일자 세팅
				 -------------------------------------------------------------
				gLoanDate = szData[2+1]
				LabelLoanDate.caption = gLoanDate
				
				 -------------------------------------------------------------
				 --대출일련번호
				 -------------------------------------------------------------
				gLoanSrno =  szData[4+1]
				LabelLoanSrno.caption = gLoanSrno
				
			
			 -------------------------------------------------------------
			 --일반잔고인 경우
			 -------------------------------------------------------------
			else
				
				 -------------------------------------------------------------
				 -- 현금탭으로 변경
				 -------------------------------------------------------------
				rdoGbn.currentindex = 0
			
				 ---------------------------------------------------------------------------------------
				 --대출정보 클리어
				 --------------------------------------------------------------------------------------
				ClearLoanData()	
				
			end
			
			 --------------------------------------------
			 -- 주문유형 보통(지정가)로 초기화
			 --------------------------------------------
			cmbType.currentindex = "0"
		
		end
		
	 --============================================================================
	 -- 잔고탭 종목 연동
	 --============================================================================
	elseif sEventName == "SendJangoItem" then
		
		 ------------------------------------------------------------------------------------------------------
		 --sParam : MAESU★szMk@szItemCode★szName★sOrdAbleQty★sJangoGubun★sLoanType★sLoanDate★sLoanSrno
		 ------------------------------------------------------------------------------------------------------
		arrData = gf_Split(sParam,"★")
		
		 --============================================================================
		 -- 매도가능 수량 세팅
		 -- 수량세팅 우선순위 : 자동입력 설정값 > 리턴 데이터값
		 --============================================================================
		 --수량 자동입력 설정이 안되어있으면 넘어온 매도가능수량 세팅
		 --gReturnQty = true로 변경하여 클리어 방지
		 -----------------------------------------------------------------------------
		gReturnQty = true
		edtQty.caption = arrData[3+1]
		
		 --============================================================================
		 -- 현금/대출 구분에 따른 주문창 세팅
		 --============================================================================
		gLoanType = arrData[5+1]
		
		 -------------------------------------------------------------
		 -- 대출종목
		 -------------------------------------------------------------
		if gLoanType ~= "0000" then
			
			 -------------------------------------------------------------
			 -- 링크로 넘어온 대출정보가 있는지 여부 세팅
			 -------------------------------------------------------------
			gReturnLoanData = true
			
			 -------------------------------------------------------------
			 --대출탭으로 변경
			 -------------------------------------------------------------
			rdoGbn.currentindex = 1
			LabelLoanName.visible = true
			
			 -------------------------------------------------------------
			 --대출일자 세팅
			 -------------------------------------------------------------
			gLoanDate = arrData[6+1]
			LabelLoanDate.caption = gLoanDate
			
			 -------------------------------------------------------------
			 --대출일련번호
			 -------------------------------------------------------------
			gLoanSrno = arrData[7+1]
			LabelLoanSrno.caption = gLoanSrno
		
		 -------------------------------------------------------------
		 -- 일반종목 (gLoanType : 0000 = 일반종목)
		 -------------------------------------------------------------
		else
			
			 ---------------------------------------------------------------------------------------
			 --대출정보 클리어
			 --------------------------------------------------------------------------------------
			gLoanDate = ""
			LabelLoanDate.caption = ""
			gLoanSrno = ""
			LabelLoanSrno.caption = ""
			
			rdoGbn.currentindex = 0
			
		end
		
		 --------------------------------------------
		 -- 주문유형 보통(지정가)로 초기화
		 --------------------------------------------
		cmbType.currentindex = "0"
		
	
	 --============================================================================
	 -- 주간장 현재가 세팅(가격자동입력 활성화 .. 현재가 세팅으로 되어있을때)
	 --============================================================================
	elseif sEventName == "SEND_DAYMARKET_PRC" or sEventName == "SEND_AFTERMARKET_PRC" then
	
		if g_szChangeInit ~= "1" and sParam ~= "" then
			
			g_szCurPrice 	= sParam  --20240627
			szAuto  = Form.LoadConfigData("SET_ORDER", "AUTO_STOCK_SELPRC")
			
			if szAuto == "11" and gSettingSelectPrice ~= true then
				if Check_PrcOrd() ~= "시장가" then
					edtPrc.caption = sParam
					Calc_OrderPrice()
				end
			end
			
		end
		
		gSettingSelectPrice = false  --20240729
		
	 --============================================================================
	 -- 비밀번호 검증 후 주문확인창 자동 오픈
	 --============================================================================
	elseif sEventName == "OPEN_CONFIRM" then
		btnSell_OnClick()
		
	 --============================================================================
	 -- 20240715 종목 미변경 시, 필요한 데이터만 재조회(매도가능수량/환율)
	 --============================================================================
	elseif sEventName == "RefreshData" then
		
		gReturnLoanData = false
		RequestExChangeRate()
		g_AfterOrdAbleReq = true
		Request_Able()
		
	end
	
end

 --============================================================================
function edtPrc_OnEditComplete()
	
end

 --============================================================================
function edtQty_OnEditComplete()
	
end

 --============================================================================
 -- (가격)자동입력값 요청
 --============================================================================
function RequestAutoPrice()

	Form.TriggerEvent("#", "RequestAutoPrice", "SELL")

end

 --============================================================================
 -- (수량)자동입력값 요청
 --============================================================================
function RequestAutoQty()

	if g_szSellQty == "1" then -- 보유잔고수량 end end
		
		Request_Able()
		
	elseif g_szSellQty == "2" then -- 수량입력
	
		edtQty.caption = g_szSellQtyCnt
		Calc_OrderPrice()
		
	end

end

 --============================================================================
 -- (가격/수량)입력창 입력값 초기화
 --============================================================================
function Init_InputControl()
	
	if g_szChangeInit == "1" then
		
		 ------------------------------------------------------
		 -- 잔고팝업에서 종목선택한 경우 gReturnQty = true
		 -- gReturnQty == true인 경우에는 잔고팝업에서 넘어온
		 -- 매도가능수량이 수량입력창에 세팅될 수 있도록 
		 -- 수량입력창 클리어해주지 않음.
		 ------------------------------------------------------
		if gReturnQty == true then
			gReturnQty = false
		else
			gReturnQty = false
			edtQty.caption = ""
			
		end
		
		edtPrc.caption = ""
		
	end
	
end

 --============================================================================
 -- (가격/수량)입력창 주문전송 후 초기화
 --============================================================================
function Reset_AfterOrd()
	
	 ------------------------------
	 -- 수량/가격 클리어
	 ------------------------------
	edtQty.caption = ""
	edtPrc.caption = ""
	Calc_OrderPrice()
	
	 ------------------------------
	 -- 대출정보 클리어
	 ------------------------------
	LabelLoanName.visible = false
		
	gLoanSrno = ""
	LabelLoanSrno.caption = ""
			
	gLoanDate = ""
	LabelLoanDate.caption = ""
		
end

 --============================================================================
 -- 거래소 호가단위 설정
 --============================================================================
function GetHogaUnit(szMk, szPrc, nGbn)
	
	 -------------------------------------------------------------------------
	 -- 호가단위 초기화
	 -------------------------------------------------------------------------
	szOrdPrc = gf_Tonumber(szPrc)
	
	if szOrdPrc == "" then
		if g_szCurPrice == "" or gf_Tonumber(g_szCurPrice) == 0 then
			szOrdPrc = 0		
		else
			szOrdPrc = gf_Tonumber(g_szCurPrice)
		end
	end
	
	szUnit = "1.000"
	
	 -------------------------------------------------------------------------
	 -- 틱타입 확인
	 -------------------------------------------------------------------------
	szTtype = gf_Tonumber(g_szTickType)

	if szTtype == 0 or szTtype == "" then
		szTtype = "0"
	end
	
	 -------------------------------------------------------------------------
	 -- 중국(상해/심천) 호가단위 설정
	 -------------------------------------------------------------------------
	if szMk == "0215" then --상해 end end
		
		 --20240613 LES START 틱단위 수정
		if szTtype == 2 then
			szUnit = "0.001"
		else
			szUnit = "0.010"
		end
		 --20240613 LES END
		
	elseif szMk == "0214" then --심천
		
		 --20240613 LES START 틱단위 수정
		if szTtype == 2 then
			szUnit = "0.001"
		else
			szUnit = "0.010"
		end
		 --20240613 LES END
		
	 -------------------------------------------------------------------------
	 -- 미국(뉴욕/나스닥/아멕스) 호가단위 설정
	 -------------------------------------------------------------------------
	elseif szMk == "0321" or szMk == "0537" or szMk == "0066" then --뉴욕, 나스닥, 아멕스
		
		 --20240702 LES START - 1달러미만 종목 0.0001단위
		if szOrdPrc < 1.00 then
			szUnit = "0.0001"
		else
			
			if szTtype == 1 then
				szUnit = "0.010"
				
			elseif szTtype == 2 then
				szUnit = "0.050"
				
			elseif szTtype == 3 then
				szUnit = "0.050"
				
			elseif szTtype == 4 then
				szUnit = "0.050"
				
			else
				szUnit = "0.010"
			end
			
		end
	
	 -------------------------------------------------------------------------
	 -- 홍콩 호가단위 설정, (홍콩ETF종목 호가단위 변경)
	 -------------------------------------------------------------------------
	elseif szMk == "0104" then --홍콩
		
		if szTtype == 3 then
			szUnit = "0.050"
			
		 --홍콩 ETF종목 호가단위 변경
		 --type = 5 (ETF종목) 추가
		 --20250728 MSH START 홍콩거래소 틱사이즈 변경 및 추가 	
		elseif szTtype == 5 then
			
			if nGbn == 0 then
				if szOrdPrc < 1.00 then
					szUnit = "0.001"
				elseif szOrdPrc < 5.00 then
					szUnit = "0.002"
				elseif szOrdPrc < 10.00 then
					szUnit = "0.005"
				elseif szOrdPrc < 20.00 then
					szUnit = "0.010"
				elseif szOrdPrc < 100.00 then
					szUnit = "0.020"
				elseif szOrdPrc < 200.00 then
					szUnit = "0.050"
				elseif szOrdPrc < 500.00 then
					szUnit = "0.100"
				elseif szOrdPrc < 1000.00 then
					szUnit = "0.200"
				elseif szOrdPrc < 2000.00 then
					szUnit = "0.500"
				else
					szUnit = "1.000"
				end
			
			else
				if szOrdPrc <= 1.00 then
					szUnit = "0.001"
				elseif szOrdPrc <= 5.00 then
					szUnit = "0.002"
				elseif szOrdPrc <= 10.00 then
					szUnit = "0.005"
				elseif szOrdPrc <= 20.00 then
					szUnit = "0.010"
				elseif szOrdPrc <= 100.00 then
					szUnit = "0.020"
				elseif szOrdPrc <= 200.00 then
					szUnit = "0.050"
				elseif szOrdPrc <= 500.00 then
					szUnit = "0.100"
				elseif szOrdPrc <= 1000.00 then
					szUnit = "0.200"
				elseif szOrdPrc <= 2000.00 then
					szUnit = "0.500"
				else
					szUnit = "1.000"
				end
			
			end
			
		elseif szTtype == 6 then --20250728 MSH 사이즈 6 추가 
			
			if nGbn == 0 then
