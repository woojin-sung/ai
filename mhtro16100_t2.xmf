		 --20250728 MSH END 
	
	 -------------------------------------------------------------------------
	 -- 해외주식 일본시장(도쿄거래소) 추가
	 -------------------------------------------------------------------------
	elseif szMk == "0106" then --도쿄
		if szTtype == 3 then
			if nGbn == 0 then
				if szOrdPrc < 1000 then
					szUnit = "0.1"
		
				elseif szOrdPrc < 3000 then
