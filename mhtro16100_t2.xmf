				else
					szUnit = "100000"
				
				 --20250425 SWJ END
				
				end
			
			end
		
		end
	
	end
	
	return szUnit
	
end

 --============================================================================
 -- Calc_Price : +, - 버튼클릭시 호가단위로 가격계산
 --============================================================================
function Calc_Price(nGbn)

	szPrc  = ReSet_Prc(edtPrc.caption, nGbn)
	szHigh = g_szUpLimit
	szLow  = g_szDnLimit

	g_szUnit = GetHogaUnit(g_szMk, szPrc, nGbn)  --20180710 HAMWG : 호가단위 설정함수 변경
	szUnit = g_szUnit
	
	if gf_Trim(szPrc) == "" or gf_Tonumber(szPrc) == 0 then
		if g_szCurPrice == "" or gf_Tonumber(g_szCurPrice) == 0 then
			szPrc = 0
		else
			szPrc = g_szCurPrice
		end
	else
		
		 --------------------------------------------------
		 -- + 버튼 클릭
		 --------------------------------------------------
		if nGbn == 0 then
			if gf_Tonumber(szPrc) >= gf_Tonumber(szHigh) then -- 상한가와 같거나 높은가격에서 +버튼 클릭시 상한가로 복귀 end end
				if szHigh ~= "0" then
					szPrc = gf_Tonumber(szHigh)
				else
					szPrc = gf_Tonumber(szPrc) + gf_Tonumber(szUnit)
				end
			elseif gf_Tonumber(szPrc) < gf_Tonumber(szLow) then -- 하한가보다 낮은가격에서 +버튼 클릭시 하한가로 복귀
				if szLow ~= "0" then
					szPrc = gf_Tonumber(szLow)
				else
					szPrc = gf_Tonumber(szPrc) + gf_Tonumber(szUnit)
				end
			else
				szPrc = gf_Tonumber(szPrc) + gf_Tonumber(szUnit)
			end
		
		 --------------------------------------------------
		 -- - 버튼 클릭 
		 --------------------------------------------------
		elseif nGbn == 1 then
			if gf_Tonumber(szPrc) > gf_Tonumber(szHigh) then -- 상한가보다 높은가격에서 -버튼 클릭시 상한가로 복귀 end end
				if szHigh ~= "0" then
					szPrc = gf_Tonumber(szHigh)
				else
					szPrc = gf_Tonumber(szPrc) - gf_Tonumber(szUnit)
				end
			elseif gf_Tonumber(szPrc) <= gf_Tonumber(szLow) then -- 하한가와 같거나 낮은가격에서 -버튼 클릭시 하한가로 복귀
				if szLow ~= "0" then
					szPrc = gf_Tonumber(szLow)
				else
					szPrc = gf_Tonumber(szPrc) - gf_Tonumber(szUnit)
				end
			else
				szPrc = gf_Tonumber(szPrc) - gf_Tonumber(szUnit)
			end
		end
	end
	
	if gf_Tonumber(szPrc) < 0 then
		szPrc = 0
	end
	
	 -----------------------------------------------------------
	 -- 입력값 자리수 체크
	 -----------------------------------------------------------
	 --if string.string.len(szPrc) > gMaxLen then	
	 --	return
	 --end if
	
	edtPrc.caption = szPrc
	Calc_OrderPrice()
	
end

 --============================================================================
 -- 가격 호가단위 맞추기 
 --============================================================================
function ReSet_Prc(szData, nGbn)
	if nGbn == 0 then
		nResult = gf_Round(gf_Tonumber(szData) % gf_Tonumber(g_szUnit), gf_Tonumber(g_szDecimal))

		if nResult ~= 0 and nResult ~= gf_Tonumber(g_szUnit) then
			return gf_Tonumber(szData) - nResult
		else
			return szData
		end
	else
		nResult = gf_Round(gf_Tonumber(szData) % gf_Tonumber(g_szUnit), gf_Tonumber(g_szDecimal))
	
		if nResult ~= 0 then
			return gf_Tonumber(szData) + (gf_Tonumber(g_szUnit) - nResult)
		else
			return szData
		end
	end
end

 --============================================================================
 -- btnPPlus_OnClick : 가격 + 버튼
 --============================================================================
function btnPPlus_OnClick()
	Calc_Price(0)
end

 --============================================================================
 -- btnPMinus_OnClick : 가격 - 버튼
 --============================================================================
function btnPMinus_OnClick()
	Calc_Price(1)
end

 --============================================================================
 -- Calc_Qty : +, - 버튼클릭시 수량 length로 수량단위 계산
 --============================================================================
function Calc_Qty(nGbn,nUnit)
	
	szQty = edtQty.caption
	
	 -----------------------------------------------------------
	 -- (기존요건) 최대입력 가능 수량 99000000
	 -----------------------------------------------------------
	 --if gf_Trim(szQty) ~= "" then
	 --	if gf_Tonumber(szQty) >= 99000000 then
	 --		if nGbn == 0 then
	 --			return
	 --		end if
	 --	end if
	 --end if
	
	 -----------------------------------------------------------
	 -- 수량이 빈값인 경우 매매단위로 초기화
	 -----------------------------------------------------------
	if gf_Trim(szQty) == "" then
		if nGbn == 0 then
			szQty = gf_Tonumber(nUnit)
		else
			return
		end
	
	 -----------------------------------------------------------
	 -- 수량이 빈값이 아닌 경우
	 -----------------------------------------------------------
	else
			
		 -----------------------------------------------------------
		 -- [+]버튼 클릭
		 -----------------------------------------------------------
		if nGbn == 0 then
			szQty = gf_Tonumber(szQty) + gf_Tonumber(nUnit)
			nResult = gf_Tonumber(szQty) % gf_Tonumber(nUnit)
			
			if nResult ~= 0 then
				szQty = gf_Tonumber(szQty) - nResult
			end
			
		 -----------------------------------------------------------
		 -- [-]버튼 클릭
		 -----------------------------------------------------------
		elseif nGbn == 1 then
			
			if gf_Tonumber(szQty) == 0 then
				return
			else
				szQty = szQty - gf_Tonumber(nUnit)
				nResult = gf_Tonumber(szQty) % gf_Tonumber(nUnit)
				
				 --20240726
				if gf_Tonumber(szQty) < 0 then
					szQty = 0
				end
				
			end
			
		end
		
	end
	
	 -----------------------------------------------------------
	 -- 입력값 자리수 체크
	 -----------------------------------------------------------
	if string.string.string.len(szQty) <= gMaxLen then
		if gf_Tostring(szQty) == "0" or gf_Tostring(szQty) == "" then
			edtQty.caption = ""
		else
			edtQty.caption = szQty
		end
	end
	
	Calc_OrderPrice()
	
	
end

 --============================================================================
function btnQPlus_OnClick()
	Calc_Qty(0,g_szOrdSize)
end

 --============================================================================
function btnQMinus_OnClick()
	Calc_Qty(1,g_szOrdSize)
end

 --============================================================================
 -- 주문금액 가계산
 --============================================================================
function Calc_OrderPrice()
	
	nPrc = gf_Tonumber(edtPrc.caption)
	nQty = gf_Tonumber(edtQty.caption)
	
	if nPrc ~= "" and nPrc > 0 and nQty ~= "" and nQty > 0 then
		
		nOrderPrice = nPrc * nQty
		
		if g_szDecimal ~= "" then
			lblOrderPrice.caption = gf_CommaValue(nOrderPrice,g_szDecimal).." " .. g_szCurrency
		else
			lblOrderPrice.caption = gf_CommaValue(nOrderPrice,0).." " .. g_szCurrency
		end
		
		nExChangeRate = gf_Tonumber(LabelExchangeRate.caption)
		
		if nExChangeRate ~= "" and nExChangeRate > 0 then
			nOrderPriceWon = nOrderPrice * nExChangeRate
			nOrderPriceWon = gf_Tonumber(nOrderPriceWon)
			lblOrderPriceWon.caption = gf_CommaValue(nOrderPriceWon,0).."원"
		else
			lblOrderPriceWon.caption = "- " .. "원"
		end
	
	else
	
		lblOrderPrice.caption = "- " .. g_szCurrency
		lblOrderPriceWon.caption = "- " .. "원"
		
	end
	
end

 --============================================================================
 -- (공통) 주문 환경설정값 적용
 --============================================================================
function Load_OrderSet()
	
	g_szOdrPop     = Form.LoadConfigData("SET_ORDER", "OPEN_CONFIRM")			 -- 주문확인창
	g_szAfterInit  = Form.LoadConfigData("SET_ORDER", "AFERTORD_INIT")			 -- 주문전송 후 초기화
	g_szChangeInit = Form.LoadConfigData("SET_ORDER", "CHANGE_INIT")			 -- 종목/탭 변경시 초기화
	g_szAfterOrg   = Form.LoadConfigData("SET_ORDER", "AUTO_ORGNO")				 -- 원주문번호 자동입력
	
	g_szSellQty     = Form.LoadConfigData("SET_ORDER", "AUTO_STOCK_SELQTY")		 -- 매도수량 자동입력(0:미사용, 1:현금가능수량, 2:최대가능수량(미수포함), 3:수량입력
	g_szSellQtyCnt  = Form.LoadConfigData("SET_ORDER", "AUTO_STOCK_SELQTYCNT")	 -- 매도수량 주수(수량입력 선택시)
	
	 ----------------------------------------------
	 -- 주문확인창(기본값 : 사용)
	 ----------------------------------------------
	if gf_Trim(g_szOdrPop) == "" then
		g_szOdrPop = "1"
	end
	
	 ----------------------------------------------
	 -- 주문전송 후 초기화(기본값 : 사용)
	 ----------------------------------------------
	if gf_Trim(g_szAfterInit) == "" then
		g_szAfterInit = "1"
	end
	
	 ----------------------------------------------
	 --종목/탭 변경시 초기화 사용을 초기값으로 설정
	 --종목/탭 변경시 초기화(기본값 : 사용)
	 ----------------------------------------------
	if gf_Trim(g_szChangeInit) == "" then
		g_szChangeInit = "1"
	end

	 ----------------------------------------------
	 -- 원주문번호 자동입력(기본값 : 사용)
	 ----------------------------------------------
	if gf_Trim(g_szAfterOrg) == "" then
		g_szAfterOrg = "1"
	end
	
	 ----------------------------------------------
	 -- 매수수량 자동입력(기본값 : 사용하지 않음)
	 ----------------------------------------------
	if gf_Trim(g_szSellQty) == "" then
		g_szSellQty = "0"		
	end
	
end

 --============================================================================
 -- 시장에 따른 주문유형
 --============================================================================
function SetOrderTypeList(sNation)
	
	if gOsType == "1" or gOsType == "2" then
	
		if sNation == "USA" then
		
			if gOsType == "2" then
				cmbType.SetPopupHeight(480)
			else
				cmbType.SetPopupHeight(430)
			end
			
			sList = "00`보통(지정가)`원하는 가격을 지정하여주문\r\n" ..
				   "01`시장가`시장가격으로 즉시 체결되는 주문\r\n" ..
				   "31`LOO(장개시지정가)`장 개시와 동시에 시가가 지정한 가격보다 같거나 유리하면 체결 시키는 주문\r\n" ..
				   "32`LOC(장마감지정가)`장 마감과 동시에 종가가 지정한 가격보다 같거나 유리하면 체결 시키는 주문\r\n" ..
				   "33`MOO(장개시시장가)`장 개시와 동시에 시장가로 주문을 내어 시초가로 체결 시키는 주문\r\n" ..
				   "34`MOC(장마감시장가)`장 마감과 동시에 시장가로 주문을 내어 종가로 체결 시키는 주문\r\n" ..
				   "37`VWAP(수량분할)`주문한 수량을 장중에 나누어 체결시키는 알고리즘 주문으로, 과거 거래량을 분석하여 현지 브로커 자체 기준으로 장중 분할 체결하는 주문 \r\n" ..
				   "38`TWAP(시간분할)`주문한 수량을 장중 시간별로 나누어 체결시키는 알고리즘 주문으로, 과거 거래시간을 분석하여 현지 브로커 자체 기준으로 장중 분할 체결하는 주문\r\n" ..
				   "35`Limit VWAP(가격제한수량분할)`과거 거래량을 분석하여 현지 브로커 자체 기준으로 가격을 제한한 장중 분할 체결 하는 알고리즘 주문\r\n" ..
				   "36`Limit TWAP(가격제한시간분할)`과거 거래시간을 분석하여 현지 브로커 자체 기준으로 장중 시간별로 분할 체결하는 알고리즘 주문으로 지정한 가격과 동일하거나 유리하면 체결하는 주문"

		else
			
			cmbType.SetPopupHeight(0)
			
			sList = "00`보통(지정가)`원하는 가격을 지정하여주문\r\n"
			
		end
	
	else
	
		if sNation == "USA" then
			sList = "00`보통(지정가)\r\n01`시장가\r\n31`LOO(장개시지정가)\r\n32`LOC(장마감지정가)\r\n33`MOO(장개시시장가)\r\n34`MOC(장마감시장가)\r\n37`VWAP(수량분할)\r\n38`TWAP(시간분할)\r\n35`Limit VWAP(가격제한수량분할)\r\n36`Limit TWAP(가격제한시간분할)"
		else
			sList = "00`보통(지정가)\r\n"
		end
		
	end
	
	cmbType.currentindex = "0"	
	cmbType.clear = true
	cmbType.cbinputdatatext = sList
	
end

