'****************************************************************************
'               G  L  O  B  A  L       V  A  R  I  A  B  L  E
'****************************************************************************
Dim g_sOrdGbn	'매도/매수 구분 (매도:0, 매수:1)
Dim g_sProcGbn	'가격/수량 구분 (가격:0, 수량:1)
Dim g_sInputData'가격/수량 값   
Dim g_sInteger	'정수부 자릿수
Dim g_sDecimal	'소수부 자릿수
Dim g_sPostFix	'뒷첨자
Dim g_sRetKey	'리턴받을 키값

g_sOrdGbn = "0"
g_sProcGbn = "0"
g_sInputData = ""
g_sDecimal = "4"
g_sPostFix = "USD"
g_sRetKey = ""

Dim g_sFocusEditClear		'초기 데이터 클리어 여부
g_sFocusEditClear = false

'****************************************************************************
'            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N              
'****************************************************************************
'===============================================
' NULL 체크 
'===============================================
Function isEmpty(sData)
	if trim(sData) == "" or sData == null or trim(sData) == "null" then
		return true
	else
		return false
	end if
End Function

'===============================================
' 숫자 소수점 절사 함수
'===============================================
Function truncateToDecimalPlaces(nVal, nDeimalPlaces)
	nVal = Cdbl(nVal)
	nFactor = 10 ^ nDeimalPlaces
	szNumStr = FormatNumber(nVal*nFactor,12,0,0,0,1)
	nDecimalIdx = instr(szNumStr, ".")
	
	nTotalData = 0
	if Cint(nDecimalIdx) > 0 then
		nTotalData = Cdbl(left(szNumStr, Cint(nDecimalIdx)-1))
	else
		nTotalData = Cdbl(szNumStr)
	end if

	return nTotalData / nFactor
End Function

'===============================================
' (NonNull) 문자열 -> 배열 변환함수
'===============================================
Function Convert_StrToArr(szData, szSeperator)

	Dim arrData
	
	'--------------------------------------------
	' 링크데이터 값 체크
	'--------------------------------------------
	if isEmpty(szData) then
		arrData = {}
		return arrData
	end if
	
	'--------------------------------------------
	' 구분자 값 체크
	'--------------------------------------------
	if isEmpty(szSeperator) then
		' 단일변수
		arrData = {}
		Table.insert(arrData, szData)
	else
		' 다중변수
		arrData = split(szData, szSeperator)
	end if
	
	return arrData
	
End Function

'===============================================
' 키패드 컨트롤 초기화
'===============================================
Function Init_Control() 
	sTitle = "입력"
	
	if g_sOrdGbn == "0" then
		cont0.left = 0
		cont1.left = 1000
			
		if g_sProcGbn == "0" then
			
			sTitle = "단가 입력"
			
			if Cint(g_sDecimal) > 0 then
				cont0.btnPlus00.caption = "."
			else
				cont0.btnPlus00.caption = "00"
			end if
			
		elseif g_sProcGbn == "1" then
			sTitle = "수량 입력"
			cont0.btnPlus00.caption = "00"
			
		elseif g_sProcGbn == "2" then
			sTitle = "등락률 입력"
			cont0.btnPlus00.caption = "."
			
		elseif g_sProcGbn == "3" then
			sTitle = "틱 입력"
			cont0.btnPlus00.caption = "00"
			
		elseif g_sProcGbn == "4" then
			sTitle = "비율 입력"
			cont0.btnPlus00.caption = "00"
		end if
		
	elseif g_sOrdGbn == "1" then
		
			
		if g_sProcGbn == "0" then
			cont0.left = 0
			cont1.left = 1000
			sTitle = "단가 입력"
			cont0.btnPlus00.caption = "."
			
		elseif g_sProcGbn == "1" then
			cont0.left = 0
			cont1.left = 1000
			sTitle = "수량 입력"
			cont0.btnPlus00.caption = "00"
			
		elseif g_sProcGbn == "2" then
			cont0.left = 1000
			cont1.left = 0
			sTitle = "등락률 입력"
			cont0.btnPlus00.caption = "."
			
		elseif g_sProcGbn == "3" then
			cont0.left = 0
			cont1.left = 1000
			sTitle = "틱 입력"
			cont0.btnPlus00.caption = "00"
			
		
		end if
		 
	
	end if
	
	Label2.caption = sTitle
	if isEmpty(g_sInputData) == false then
		Image0.visible = true
		SetPrice("AUTO", g_sInputData, g_sDecimal, g_sPostFix)
	end if
End Function

'===============================================
' 데이터 정수부/소수부 자릿수 확인 함수
'===============================================
Function Check_NumDigits(sType, sValue)
	
	if isEmpty(sValue) == true then
		return true
	end if
	
	sValue = trim(replace(sValue, "+", ""))
	sValue = trim(replace(sValue, "-", ""))
	
	if isEmpty(sValue) == true then
		return true
	end if
	
	arrValue = split(sValue, ".")
	nArrCnt = #arrValue
	
	sInteger = arrValue(0)	'정수부
	sDecimal = ""			
	
	if nArrCnt >= 2 then
		sDecimal = arrValue(1)	'소수부
	end if
	
	'정수부 자리수 확인
	if sType == "I" then
		if isEmpty(sInteger) == true then
			return true
		end if
		
		nTextLen = Form.getLen(sInteger)
		
		if Cdbl(nTextLen) <= Cdbl(g_sInteger) then
			return true
		else
			return false
		end if
		
	'소수부 자리수 확인
	elseif sType == "D" then
		if isEmpty(sDecimal) == true then
			return true
		end if
		
		nTextLen = Form.getLen(sDecimal)
		
		if Cdbl(nTextLen) <= Cdbl(g_sDecimal) then
			return true
		else
			return false
		end if
	end if
End Function 



'============================================================================
' (공통) 가격입력창 가격SET
'============================================================================
Function SetPrice(sType, nPrc, nDecimalLen, sPostFix)

	if isEmpty(nPrc) == false then
		Label1.fgcolor = "4"
	else
		Label1.fgcolor = "333"
	end if
	
	sChk = Instr(Cstr(nPrc), ".")
	
	'================================================================
	'소수점(dot)이 있는 경우
	'================================================================
	if sChk > 0 then
		
		'------------------------------
		'소수점영역 길이
		'------------------------------
		sCha = CInt(Len(nPrc) - sChk)
		
		'-------------------------------------------------------
		'소수점영역의 길이가 국가별 소수점 자리수를 다 채운 경우
		'-------------------------------------------------------
		if sCha >= Cint(nDecimalLen) then
			 
			 if sCha >= Cint(nDecimalLen) then
				sResult = FormatNumber(nPrc, nDecimalLen).." " .. sPostFix
				Label1.caption = sResult
			 else
				 exit Function
			 end if
		
		'-------------------------------------------------------	 
		' 소수점영역의 길이를 아직 다 안채운 경우
		'-------------------------------------------------------
		else
			
			'-------------------------------------------------------------------
			'자동으로 호가가격이 입력되는 경우(초기값 세팅/ 호가 +,- 버튼 클릭)
			'국가별 소수점 자리수로 가격을 다시 맞춰준다.
			'-------------------------------------------------------------------
			if sType == "AUTO" then
				
				sResult = FormatNumber(nPrc,nDecimalLen).." " .. sPostFix
				Label1.caption = sResult
				
			'-------------------------------------------------------------------
			'가격이 수동으로 입력되는 경우(키패드 입력)에는 입력받은대로 표시
			'-------------------------------------------------------------------
			else
				sResult = nPrc.." " .. sPostFix
				Label1.caption = sResult
			end if
			
		end if
	
	'================================================================
	' 소수점(dot)이 없는 경우
	'================================================================
	else
		if sType == "AUTO" then
			sResult = FormatNumber(nPrc,nDecimalLen) .." " .. sPostFix
			Label1.caption = sResult
		else
			sResult = FormatNumber(nPrc,0) .." " .. sPostFix
			Label1.caption = sResult
		end if
		
	end if
	
End Function
'============================================================================
' 키패드 버튼 입력 시 처리
'============================================================================
Function InputKeypad(sType, sKeypad)

	'----------------------------------------------------------------------
	'sType = "NUM" : 숫자(1~9) 버튼
	'----------------------------------------------------------------------
	'sType = "ZERO" : 숫자(0) 버튼
	'----------------------------------------------------------------------
	'sType = "DOT" : 소수점(.) 버튼
	'----------------------------------------------------------------------
	'sType = "QUICK" : 퀵버튼
	'
	'- 단가 : 매도1호가/현재가/매수1호가
	'- 수량 : +10 / +100 / +1000 or +매매단위*1 / +매매단위*2 / +매매단위*3
	'- 금액 : +10만 / +100만 / +500만
	'
	'----------------------------------------------------------------------
	'sType = "ABLE" : 가능수량 버튼
	'----------------------------------------------------------------------
	'sType = "CLEAR" : 클리어 버튼
	'----------------------------------------------------------------------
	'sType = "DELETE" : 삭제버튼
	'----------------------------------------------------------------------
	
	'======================================================================
	' 숫자(1~9) 키패드 입력
	'======================================================================
	if sType == "NUM" then
		
		'---------------------------------------------------
		'[단가 입력창] 에 포커스가 되어있는 경우
		'---------------------------------------------------
'		if g_sProcGbn == "0" or g_sProcGbn == "2" or g_sProcGbn == "3" then
		
			sData = g_sInputData
			
			'---------------------------------------------------
			'[키패드로 최초 입력 시]
			'키패드 최초 입력 시에는 입력되어있는 값 클리어
			'---------------------------------------------------
			if g_sFocusEditClear <> true then
				
				g_sFocusEditClear = true
				
				sData = sKeypad
				g_sInputData = sData
				SetPrice("MANAUAL",sData,g_sDecimal,g_sPostFix)
			
			'---------------------------------------------------
			'[키패드로 최초 입력이 아닐시]
			''최초 클리어 이후에는 입력값 이어붙임
			'---------------------------------------------------
			else
				if Instr(Cstr(sData),".") == 0 and Cdbl(sData) == 0 then
					sData =  sKeypad
				else
					sData = sData & sKeypad
				end if
				
				if Check_NumDigits("I", sData) == false then
					Exit Function
				end if
				
				if Check_NumDigits("D", sData) == false then
					Exit Function
				end if
				
				g_sInputData = sData
				SetPrice("MANAUAL",sData,g_sDecimal,g_sPostFix)
				
			end if
			
'		'---------------------------------------------------
'		'[수량 입력창] 에 포커스가 되어있는 경우
'		'---------------------------------------------------
'		elseif g_sProcGbn == "1" then
'		
'			sData = g_sInputData
'			
'			if g_sFocusEditClear <> true then
'				
'				g_sFocusEditClear = true
'				sData = sKeypad
'				g_sInputData = sData
'				Label1.caption = FormatNumber(sData,0) .. " " ..  g_sPostFix
'				
'			else
'				if Cdbl(sData) == 0 then
'					sData = sKeypad
'				else
'					sData = sData & sKeypad
'				end if
'				
'				if Check_NumDigits("I", sData) == false then
'					Exit Function
'				end if
'				
'				if Check_NumDigits("D", sData) == false then
'					Exit Function
'				end if
'				
'				g_sInputData = sData
'				Label1.caption = FormatNumber(sData,0) .. " " ..  g_sPostFix
'			
'			end if
'		
'		end if
		
	
	'======================================================================
	' 숫자(0) 키패드 입력
	'======================================================================
	elseif sType == "ZERO" then
	
		'---------------------------------------------------
		'[단가 입력창] 에 포커스가 되어있는 경우
		'---------------------------------------------------
'		if g_sProcGbn == "0" or g_sProcGbn == "2" or g_sProcGbn == "3" then
			
			sData = g_sInputData
			
			if g_sFocusEditClear <> true then
			
				g_sFocusEditClear = true
				sData = sKeypad
				g_sInputData = sData
				SetPrice("MANAUAL",sData,g_sDecimal,g_sPostFix)
			
			else
				if Instr(Cstr(sData),".") > 0 then
					sData = sData & sKeypad
				else
					if Cdbl(sData) == 0 then
						sData = "0"
					else
						sData = CDbl(sData & sKeypad)
					end if
				end if
			
				if Check_NumDigits("I", sData) == false then
					Exit Function
				end if
				
				if Check_NumDigits("D", sData) == false then
					Exit Function
				end if
				
				g_sInputData = sData
				SetPrice("MANAUAL",sData,g_sDecimal,g_sPostFix)
			
			end if
		
'		'---------------------------------------------------
'		'[수량 입력창] 에 포커스가 되어있는 경우
'		'---------------------------------------------------
'		elseif g_sProcGbn == "1" then
'		
'			sData = g_sInputData
'		
'			if g_sFocusEditClear <> true then
'				
'				g_sFocusEditClear = true
'				sData = sKeypad
'				g_sInputData = sData
'				Label1.caption = FormatNumber(sData,0) .. " " ..  g_sPostFix
'				
'			else
'				if Check_NumDigits("I", sData & sKeypad) == false then
'					Exit Function
'				end if
'				
'				if Check_NumDigits("D", sData & sKeypad) == false then
'					Exit Function
'				end if
'			
'				'0이 입력되있는 경우에는 무시
'				if sData <> "0" then
'					sData = sData & sKeypad
