function cont0_btnPlus00_OnClick()
	
	if g_sProcGbn == "0" or g_sProcGbn == "2" then
		
		if g_sProcGbn == "0" and gf_Tonumber(g_sDecimal) == 0 then
			InputKeypad("ZERO", "00")
		else
			InputKeypad("DOT", ".")
		end
	else
		InputKeypad("ZERO", "00")
	end
	
end

