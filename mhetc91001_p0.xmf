'			end if
'			
'			nTotQty = Cdbl(sData) + nAdd
'			
'			if nTotQty < 1000 then
'				nTotQty = 1000
'			end if
'			
'			edtQty.caption = nTotQty
'			
'		elseif sKeypad == "PRC_MAEDO1" or sKeypad == "PRC_MAESU1" or sKeypad == "PRC_CUR" then
'		
'			if g_sFocusEditClear <> true then
'				g_sFocusEditClear = true
'			end if
'			
'			if sKeypad == "PRC_MAEDO1" then
'				sData = tblData1.GetCellString(1, 0)
'			elseif sKeypad == "PRC_CUR" then
'				sData = tblData0.GetCellString(1, 1)
'			else
'				sData = tblData1.GetCellString(1, 2)
'			end if
'			
'			SetPrice("AUTO", round(Cdbl(sData),2),g_sDecimal,g_sPostFix)
'				
'		end if
	
	
	'======================================================================
	' 가능수량 키패드 입력
	'======================================================================
	elseif sType == "ABLE" then
	
	'======================================================================
	' 가능수량 키패드 입력
	'======================================================================
	elseif sType == "CLEAR" then
	
		'---------------------------------------------------
		'[단가 입력창] 에 포커스가 되어있는 경우
		'---------------------------------------------------
'		if g_sProcGbn == "0" or g_sProcGbn == "2" or g_sProcGbn == "3" then
			
			sData = g_sInputData
			
			if g_sFocusEditClear <> true then
				g_sFocusEditClear = true
			end if
			
			sData = ""
			g_sInputData = ""
			SetPrice("NONE", sData, g_sDecimal,g_sPostFix)
		
		'---------------------------------------------------
		'[수량 입력창] 에 포커스가 되어있는 경우
		'---------------------------------------------------
'		elseif g_sProcGbn == "1" then
'		
'			sData = g_sInputData
'		
'			if g_sFocusEditClear <> true then
'				g_sFocusEditClear = true
'			end if
'			
'			sData = ""
'			g_sInputData = ""
'			Label1.caption = ""
'			
'		end if
		
		
	'======================================================================
	' 삭제(<-) 키패드 입력
	'======================================================================
	elseif sType == "DELETE" then
'		if g_sProcGbn == "0" or g_sProcGbn == "2" or g_sProcGbn == "3" then
		
			if g_sFocusEditClear <> true then
				
				g_sFocusEditClear = true
				sData = ""
				g_sInputData = ""
				SetPrice("NONE",sData,g_sDecimal,g_sPostFix)
			
			else
				
				sData = g_sInputData
				nLen = Len(sData)
				sData = left(sData ,nLen - 1)
				g_sInputData = sData
				

				SetPrice("MANAUAL",sData,g_sDecimal,g_sPostFix)
			
			end if
		
'		elseif g_sProcGbn == "1" then
'		
'			if g_sFocusEditClear <> true then
'			
'				g_sFocusEditClear = true
'				g_sInputData = ""
'				Label1.caption  = ""
'				
'			else
'				sData = g_sInputData
'				nLen = Len(sData)
'				sData = left(sData ,nLen - 1)
'				g_sInputData = sData
'				Label1.caption = FormatNumber(sData,0) .. " " ..  g_sPostFix
'				
'			end if
'		end if
	end if
	
	
	if g_sInputData == "" then
		Label1.caption = "입력해 주세요."
		Image0.visible = false
	else
		Image0.visible = true
	end if
	
End Function

'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************
'============================================================================
Sub Form_OnFormInit()
	sLinkData = Form.GetOpenLinkData()
	
	arrLinkData = Convert_StrToArr(sLinkData, "`")
	nArrCnt = #arrLinkData
	
	if nArrCnt > 5 then
		g_sOrdGbn		= arrLinkData(0)
		g_sProcGbn		= arrLinkData(1)
		g_sInputData	= arrLinkData(2)
		g_sInteger		= arrLinkData(3)
		g_sDecimal		= arrLinkData(4)
		g_sPostFix		= arrLinkData(5)
		g_sRetKey		= arrLinkData(6)
		
		Init_Control()
	end if
End Sub

