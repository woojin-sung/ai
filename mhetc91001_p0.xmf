	 --======================================================================
	 -- 소수점(.) 키패드 입력
	 --======================================================================
	elseif sType == "DOT" then
	
		 -----------------------------------------------------
		 --[단가 입력창] 에 포커스가 되어있는 경우에만 동작
		 -----------------------------------------------------
		if g_sProcGbn == "0" or g_sProcGbn == "2" then
		
			sData = g_sInputData
			
			 --이미 소수점이 입력되어 있는 경우에는 입력 무시
			if string.find(gf_Tostring(sData), ".") > 0 then
				return
			else
				
				if sData ~= "" then
					
					sData = sData .. sKeypad
					g_sInputData = sData
