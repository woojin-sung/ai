	end
	
	
	if g_sInputData == "" then
		Label1.caption = "입력해 주세요."
		Image0.visible = false
	else
		Image0.visible = true
	end
	
end

 --****************************************************************************
 --               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
 --****************************************************************************
 --============================================================================
function Form_OnFormInit()
	sLinkData = Form.GetOpenLinkData()
	
	arrLinkData = Convert_StrToArr(sLinkData, "`")
	nArrCnt = #arrLinkData
	
	if nArrCnt > 5 then
		g_sOrdGbn		= arrLinkData[0+1]
		g_sProcGbn		= arrLinkData[1+1]
		g_sInputData	= arrLinkData[2+1]
		g_sInteger		= arrLinkData[3+1]
		g_sDecimal		= arrLinkData[4+1]
		g_sPostFix		= arrLinkData[5+1]
		g_sRetKey		= arrLinkData[6+1]
		
		Init_Control()
	end
end

