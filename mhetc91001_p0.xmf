'============================================================================
Sub cont1_btnPlus_OnClick()
	if instr(g_sInputData, "-") > 0 then
		g_sInputData = replace(g_sInputData, "-", "") 
	end if
		
	SetPrice("MANUAL", g_sInputData, g_sDecimal, g_sPostFix)
End Sub

'============================================================================
Sub cont1_btnMinus_OnClick()
	if instr(g_sInputData, "-") == 0 and Cdbl(g_sInputData) > 0 then
		g_sInputData = "-" & g_sInputData
	end if

	SetPrice("MANUAL", g_sInputData, g_sDecimal, g_sPostFix)
End Sub

'============================================================================
Sub cont1_btnClear_OnClick()
	InputKeypad("CLEAR", "")
End Sub

'============================================================================
Sub btnOk_OnClick()
	Form.SendReturnToParent("AUTO_RULE_KEYPAD_END" , g_sRetKey & "`" & g_sInputData)
	Form.CloseForm()
End Sub

'============================================================================
Sub imgBg_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub Form_OnFormInitBefore()
	Image0.maintainratio = "1"
End Sub

