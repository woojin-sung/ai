	elseif sType == "CLEAR" then
	
		 -----------------------------------------------------
		 --[단가 입력창] 에 포커스가 되어있는 경우
		 -----------------------------------------------------
 --		if g_sProcGbn == "0" or g_sProcGbn == "2" or g_sProcGbn == "3" then
			
