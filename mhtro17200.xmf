End Function 

'==============================================
' 해외주식 호가단위 가격계산
'==============================================
Function Calc_Price_Ovrs(nGbn)

	sUnit = GetHogaUnit(g_sType, contMain.lblHidePrc.caption, nGbn) 
	
	szPrc  = ReSet_Prc(contMain.lblHidePrc.caption, nGbn)
	
	szHigh = sUpLimit
	szLow  = sDnLimit

'	Form.ShowAlert("TEST", szPrc.."|"..szHigh.."|"..szLow.."|"..sUnit)

	if Trim(szPrc) == "" or CDbl(szPrc) == 0 then
		szPrc = Cdbl(contHideTop.lblTopPrc.caption)
	else
		
		'------------------------------------------------
		' + 버튼 클릭
		'------------------------------------------------
		if nGbn == 0 then							
			if CDbl(szPrc) >= CDbl(szHigh) then		' 상한가와 같거나 높은가격에서 +버튼 클릭시 상한가로 복귀
				if szHigh <> "0" then
					szPrc = CDbl(szHigh)
				else
					szPrc = CDbl(szPrc) + CDbl(szUnit)
				end if 
			elseif CDbl(szPrc) < CDbl(szLow) then	' 하한가보다 낮은가격에서 +버튼 클릭시 하한가로 복귀
				if szLow <> "0" then
					szPrc = CDbl(szLow)
				else
					szPrc = CDbl(szPrc) + CDbl(szUnit)
				end if 
			else
				szPrc = CDbl(szPrc) + CDbl(szUnit)
			end if
		
		'------------------------------------------------
		' - 버튼 클릭 
		'------------------------------------------------
		elseif nGbn == 1 then						
			if CDbl(szPrc) > CDbl(szHigh) then		' 상한가보다 높은가격에서 -버튼 클릭시 상한가로 복귀
				if szHigh <> "0" then
					szPrc = CDbl(szHigh)
				else
					szPrc = CDbl(szPrc) - CDbl(szUnit)
				end if 		
			elseif CDbl(szPrc) <= CDbl(szLow) then	' 하한가와 같거나 낮은가격에서 -버튼 클릭시 하한가로 복귀
				if szLow <> "0" then
					szPrc = CDbl(szLow)
				else
					szPrc = CDbl(szPrc) - CDbl(szUnit)
				end if 
			else
				szPrc = CDbl(szPrc) - CDbl(szUnit)
			end if
		end if
	end if
	
	if CDbl(szPrc) < 0 then
		szPrc = 0
	end if
		
	contMain.lblHidePrc.caption = szPrc
	
	sCurPrc = FormatNumber(szPrc, sDecimalLen) .. " " .. sCurrency
	contMain.lblPrc.caption = sCurPrc
		
	Calc_OrderPrice()
	
End Function

'==============================================
' 국내주식 호가단위 가격계산
'==============================================
Function Calc_Price_Dmtc(nGbn)
	sUnit = GetHogaUnit(g_sType, contMain.lblHidePrc.caption, nGbn) 
	szPrc  = ReSet_Prc(contMain.lblHidePrc.caption, nGbn)

	'=======================================================================
	' +,- 버튼 클릭시 동작 
	'=======================================================================		
	
	'----------------------------------------------------------------------
	' ELW
	'----------------------------------------------------------------------
	if szMk = "W" then
	
		if nGbn == 0 then							
			szPrc = CDbl(szPrc) + CDbl(sUnit)
	
		elseif nGbn == 1 then		
			szPrc = CDbl(szPrc) - CDbl(sUnit)
			
			if CDbl(szPrc) <= 0 then
				szPrc = Cdbl(contHideTop.lblTopPrc.caption)
			end if
		end if

	' ----------------------------------------------------------------------
	' 그외 (코스피, 코스닥, KOTC, ETF, ETN ..)
	' ----------------------------------------------------------------------		
	else	
		if nGbn == 0 or nGbn == 2 then							
		
			if Left(g_sItemCode,1) == "J" then
				
				szPrc = CDbl(szPrc) + CDbl(sUnit)
				
				if szPrc <= 0 then
					szPrc = Cdbl(contHideTop.lblTopPrc.caption)
				end if
			else
				szPrc = CDbl(szPrc) + CDbl(sUnit)
				
				if CDbl(szPrc) <= 0 then
					szPrc = Cdbl(contHideTop.lblTopPrc.caption)
					
				elseif CDbl(szPrc) >= CDbl(sUpLimit) then		' 상한가와 같거나 높은가격에서 +버튼 클릭시 상한가로 복귀
					szPrc = sUpLimit
					
				elseif CDbl(szPrc) < CDbl(sDnLimit) then	' 하한가보다 낮은가격에서 +버튼 클릭시 하한가로 복귀	
					szPrc = sDnLimit
					
				end if
			end if
		
		elseif nGbn == 1 or nGbn == 3 then
		
			if Left(g_sItemCode,1) == "J" then
				
				szPrc = CDbl(szPrc) - CDbl(sUnit)
				
				if szPrc <= 0 then
					szPrc = Cdbl(contHideTop.lblTopPrc.caption)
				end if
			else
				szPrc = CDbl(szPrc) - CDbl(sUnit)
				
				if CDbl(szPrc) <= 0 then
					szPrc = Cdbl(contHideTop.lblTopPrc.caption)
				
				elseif CDbl(szPrc) > CDbl(sUpLimit) then		' 상한가보다 높은가격에서 -버튼 클릭시 상한가로 복귀
					szPrc = sUpLimit		
					
				elseif CDbl(szPrc) <= CDbl(sDnLimit) then	' 하한가와 같거나 낮은가격에서 -버튼 클릭시 하한가로 복귀
					szPrc = sDnLimit
		
				end if
			end if
		
		end if
	end if
	

	contMain.lblHidePrc.caption = szPrc
	
	sCurPrc = FormatNumber(szPrc, sDecimalLen) .. " " .. sCurrency
	contMain.lblPrc.caption = sCurPrc
		
	Calc_OrderPrice()

End Function

'============================================================================
' 가격 호가단위 맞추기 
'============================================================================
Function ReSet_Prc(szData, nGbn)	
	if nGbn == 0 then
		nResult = Round(CDbl(szData) Mod CDbl(sUnit), CInt(sDecimalLen))

		if nResult <> 0 and nResult <> CDbl(sUnit) then
			return CDbl(szData) - nResult
		else
			return szData
		end if
	else
		nResult = Round(CDbl(szData) Mod CDbl(sUnit), CInt(sDecimalLen))
		
		if nResult <> 0 then
			return CDbl(szData) + (CDbl(sUnit) - nResult)
		else
			return szData
		end if
	end if
End Function

'============================================================================
' 호가단위 설정
'============================================================================
Function GetHogaUnit(sType, szPrc, nGbn) 

	if sType == "0" then
		szMk = Form.GetItemCodeInfo(g_sItemCode, "market")
		szInnerMk = Form.GetItemCodeInfo(g_sItemCode, "innermarket")
		
		szUnit = 1
		
		'=======================================================================
		' ETN or ETF
		'=======================================================================
		if szMk == "Q" or szInnerMk = "013" then
			if CDbl(szPrc) < 2000 then
				szUnit = 1
			elseif CDbl(szPrc) >= 2000 then
				szUnit = 5
			end if
			
		'=======================================================================
		' ELW
		'=======================================================================	
		elseif szMk == "W" then
			szUnit = 5
			
		'=======================================================================
		' KOSPI/KOSDAQ/KONEX/신주인수권/수익증권 등
		'=======================================================================
		else
			if CDbl(szPrc) < 2000 then
				szUnit = 1
			elseif (CDbl(szPrc) >= 2000 and CDbl(szPrc) < 5000) then
				szUnit = 5 
			elseif (CDbl(szPrc) >= 5000 and CDbl(szPrc) < 20000) then
				szUnit = 10
			elseif (CDbl(szPrc) >= 20000 and CDbl(szPrc) < 50000) then
				szUnit = 50
			elseif (CDbl(szPrc) >= 50000 and CDbl(szPrc) < 200000) then
				szUnit = 100
			elseif (CDbl(szPrc) >= 200000 and CDbl(szPrc) < 500000) then
				szUnit = 500
			elseif CDbl(szPrc) >= 500000 then
				szUnit = 1000
			end if
			
			'--------------------------------------------------
			'20241212 LES START - 스톱가격(-) 추가 / nGbn = 3
			'--------------------------------------------------
			if nGbn == 1 or nGbn == 3 then
				if CDbl(szPrc) = 2000 then
					szUnit = 1
				elseif CDbl(szPrc) = 5000 then
					szUnit = 5 
				elseif CDbl(szPrc) = 20000 then
					szUnit = 10
				elseif CDbl(szPrc) = 50000 then
					szUnit = 50
				elseif CDbl(szPrc) = 200000 then
					szUnit = 100
				elseif CDbl(szPrc) = 500000 then
					szUnit = 500
				end if
			end if
		end if
		
		return szUnit

	elseif sType == "1" then
		szMk = Form.GetItemCodeInfo(g_sItemCode, "exchid")
		
		'-----------------------------------------------------------------------
		' 호가단위 초기화
		'-----------------------------------------------------------------------
		szOrdPrc = CDbl(szPrc)
		
		if szOrdPrc == "" then
			if g_szCurPrice = "" or CDbl(g_szCurPrice) == 0 then
				szOrdPrc = 0		
			else
				szOrdPrc = CDbl(g_szCurPrice)
			end if	
		end if
		
		szUnit = "1.000"
		
		'-----------------------------------------------------------------------
		' 틱타입 확인
		'-----------------------------------------------------------------------
		szTtype = Cint(sTickType)
	
		if szTtype == 0 or szTtype == "" then
			szTtype = "0"
		end if
		
		'-----------------------------------------------------------------------
		' 중국(상해/심천) 호가단위 설정
		'-----------------------------------------------------------------------
		if szMk == "0215" then '상해
		
			'20240613 LES START 틱단위 수정
			if szTtype = 2 then 'ETF
				szUnit = "0.001"
			else
				szUnit = "0.010"
			end if
			'20240613 LES END
			
		elseif szMk == "0214" then '심천
			
			'20240613 LES START 틱단위 수정
			if szTtype = 2 then 'ETF
				szUnit = "0.001"
			else
				szUnit = "0.010"
			end if
			'20240613 LES END
			
		'-----------------------------------------------------------------------
		' 미국(뉴욕/나스닥/아멕스) 호가단위 설정
		'-----------------------------------------------------------------------
		elseif szMk == "0321" or szMk == "0537" or szMk == "0066" then '뉴욕, 나스닥, 아멕스
			
			'20240702 LES START - 1달러미만 종목 0.0001단위
			if szOrdPrc < 1.00 then
				szUnit = "0.0001" 
			else
				if szTtype == 1 then
					szUnit = "0.010"
					
				elseif szTtype == 2 then
					szUnit = "0.050"
					
				elseif szTtype == 3 then
