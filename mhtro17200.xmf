'============================================================================
Sub contMain_lblPrc_OnClick()
	sLinkData = "0"														'매도/매수 구분 (매도:0, 매수:1)
	sLinkData = sLinkData & "`" & "0"										'가격/수량 구분 (가격:0, 수량:1)
	sLinkData = sLinkData & "`" & contMain.lblHidePrc.caption					'가격/수량 값   
	sLinkData = sLinkData & "`" & "9"										'정수부 자릿수
	sLinkData = sLinkData & "`" & sDecimalLen								'소숫점 자리
	sLinkData = sLinkData & "`" & sCurrency									'뒷첨자 
	sLinkData = sLinkData & "`" & "단가입력"									'리턴받을 키값

	Form.OpenPopup("mhetc91001_p0" , sLinkData, "")
End Sub

'============================================================================
Sub contMain_lblQty_OnClick()
	sLinkData = "0"														'매도/매수 구분 (매도:0, 매수:1)
	sLinkData = sLinkData & "`" & "1"										'가격/수량 구분 (가격:0, 수량:1)
	sLinkData = sLinkData & "`" & contMain.lblHideQty.caption					'가격/수량 값   
	sLinkData = sLinkData & "`" & "9"										'정수부 자릿수
	sLinkData = sLinkData & "`" & "0"										'소숫점 자리
	sLinkData = sLinkData & "`" & "주"										'뒷첨자 
	sLinkData = sLinkData & "`" & "수량입력"									'리턴받을 키값

	Form.OpenPopup("mhetc91001_p0" , sLinkData, "")
End Sub

'============================================================================
Sub contMain_lblM0_OnClick()
	if g_sType == "0" then
		Calc_Price_Dmtc(1)
	elseif g_sType == "1" then
		Calc_Price_Ovrs(1)
	end if
End Sub

'============================================================================
Sub contMain_lblP0_OnClick()
	if g_sType == "0" then
		Calc_Price_Dmtc(0)
	elseif g_sType == "1" then
		Calc_Price_Ovrs(0)
	end if
End Sub

'============================================================================
Sub contMain_lblM1_OnClick()
	Calc_Qty(1,sOrdSize)
End Sub

'============================================================================
Sub contMain_lblP1_OnClick()
	Calc_Qty(0,sOrdSize)
End Sub

'============================================================================
Sub Form_OnPopupReturn(sKeyName, sRet)
'	Form.ShowAlert(sKeyName, sRet)
	
	if sKeyName == "AUTO_RULE_KEYPAD_END" then
		arrRet = Convert_StrToArr(sRet, "`")
		nArrCnt = #arrRet
		
		if nArrCnt > 1 then
			sKey = arrRet(0)
			sValue = arrRet(1)
			
			if sKey == "단가입력" then
				DisplaySet_TargetPrc(sValue)
				
			elseif sKey == "수량입력" then
				'---------------------------------------------------------
				' 입력값 자리수 체크
				'---------------------------------------------------------
				if Len(sValue) <= gMaxLen then	
					nMod = CDbl(sValue) Mod CDbl(sOrdSize)
					
					if nMod > 0 then
						Form.ShowAlert("알림", "주문 수량 단위는\n" .. FormatNumber(sOrdSize, 0) .. "주입니다.")
					end if
					
					sValue = Cdbl(sValue) - nMod
					
					if CStr(sValue) == "0" or CStr(sValue) == "" then
						contMain.lblHideQty.caption = sOrdSize
						sQty = FormatNumber(sOrdSize, 0) .. " 주"
					else
						contMain.lblHideQty.caption = CDbl(sValue)
						sQty = FormatNumber(sValue, 0) .. " 주"
					end if
					
					contMain.lblQty.caption = sQty
				end if
				
			end if
			
			Calc_OrderPrice()
		
		end if
	end if
End Sub

'============================================================================
Sub contHideTop_imgTopBack_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub btnTopBack_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub btnCancel_OnClick()
	Form.CloseForm()
End Sub

'============================================================================
Sub contMain_lblSubTitle_OnSizeAutoFit()
	nleft = Cint(contMain.lblSubTitle.left)
	nWidth = Cint(contMain.lblSubTitle.width)
	
	if g_sOsType == "1" then
		nleft = Form.calcUnResize(nleft, "2")
		nWidth = Form.calcUnResize(nWidth, "2")
		
		contMain.imgInfo0.left = nleft + nWidth + 5
		
	elseif g_sOsType == "2" then
		contMain.imgInfo0.left = nleft + nWidth - 5
	end if
	
	
End Sub

'============================================================================
Sub contMain_imgInfo0_OnClick()
	Form.OpenPopupAnimation("mhtro17200_p0", "", "", 2)
End Sub

'============================================================================
Sub btnBuy_OnClick()
	
	if g_sType == "0" then
		sMarketGbn = "KRX"
		if g_sSor == "Y" then
			sMarketGbn = "SOR"
		end if
		
		Form.OpenScreen("12000" , "물타기" & "★" & "0" & "★" & g_sItemCode & "★" & sMarketGbn & "★" &contMain.lblHidePrc.caption & "★" & contMain.lblHideQty.caption )	
	elseif g_sType == "1" then
		itemName = Form.GetItemCodeInfo(g_sItemCode, "name")
		Form.SendMessageToMain( "CHANGE_ITEMCODE_OVERSTOCK", g_sItemCode.."★"..itemName.."★".."", "" )

		Form.OpenScreen("16060" ,  g_sItemCode & "★" & itemName & "♥" & "LINK_WATER" & "♥" & contMain.lblHidePrc.caption & "♥" & contMain.lblHideQty.caption  )	
	end if
	
	Form.CloseForm()
End Sub

'============================================================================
Sub Form_OnRefresh()
	if g_sType == "0" then
		Form.setDelayEvent(0, 0.3)
	end if
End Sub

'============================================================================
Sub Form_OnLinkData(sKey, sValue)
	if sKey == "OVRS_MARKET_OPERATION_TRAN" then
		if g_sType == "1" then
			Form.setDelayEvent(1, 0.3)
		end if
	end if
End Sub

