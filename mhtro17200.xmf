'==============================================
' 국내/해외 수량계산
'==============================================
Function Calc_Qty(nGbn,nUnit)
	
	szQty = contMain.lblHideQty.caption
	
	'---------------------------------------------------------
	' (기존요건) 최대입력 가능 수량 99000000
	'---------------------------------------------------------
	'if Trim(szQty) <> "" then
	'	if CDbl(szQty) >= 99000000 then
	'		if nGbn == 0 then
	'			Exit Function
	'		end if
	'	end if
	'end if
	
	'---------------------------------------------------------
	' 수량이 빈값인 경우 매매단위로 초기화
	'---------------------------------------------------------
	if Trim(szQty) == "" then
		if nGbn == 0 then
			szQty = CDbl(nUnit)
		else
			Exit Function
		end if
	
	'---------------------------------------------------------
	' 수량이 빈값이 아닌 경우
	'---------------------------------------------------------
	else
			
		'---------------------------------------------------------
		' [+]버튼 클릭
		'---------------------------------------------------------
		if nGbn == 0 then
			szQty = CDbl(szQty) + CDbl(nUnit)
			nResult = CDbl(szQty) Mod CDbl(nUnit)
			
			if nResult <> 0 then
				szQty = CDbl(szQty) - nResult
			end if
			
		'---------------------------------------------------------
		' [-]버튼 클릭
		'---------------------------------------------------------
		elseif nGbn == 1 then
			
			if CDbl(szQty) == 0 then
				Exit Function
			else		
				szQty = szQty - CDbl(nUnit)
				nResult = CDbl(szQty) Mod CDbl(nUnit)
				
				if nResult <> 0 then
					szQty = CDbl(szQty) - nResult
				end if
			
				'20240726
				if Cdbl(szQty) < CDbl(nUnit) then
					szQty = nUnit
				end if
				
			end if
			
		end if
		
	end if
	
	
	'---------------------------------------------------------
	' 입력값 자리수 체크
	'---------------------------------------------------------
	if Len(szQty) <= gMaxLen then		
		if CStr(szQty) == "0" or CStr(szQty) == "" then
			contMain.lblHideQty.caption = "1"
			sQty = "1 주"
		else
			contMain.lblHideQty.caption = CDbl(szQty)
			sQty = FormatNumber(szQty, 0) .. " 주"
		end if
		
		contMain.lblQty.caption = sQty
	end if
	
	Calc_OrderPrice()
	
	
End Function


'============================================================================
' 주문금액 가계산
'============================================================================
Function Calc_OrderPrice()
	
	nPrc = Cdbl(contMain.lblHidePrc.caption)
	nQty = Cint(contMain.lblHideQty.caption)
	nCurPrc = Cdbl(contHideTop.lblTopPrc.caption)
	
	if nPrc <> "" and nPrc > 0 and nQty <> "" and nQty > 0 then
		
		nOrderPrice = nPrc * nQty
		
		contMain.lblPreEst1.caption = FormatNumber(truncateToDecimalPlaces(nOrderPrice,sDecimalLen),sDecimalLen) .." " .. sCurrency
		
		nTotalPrice = (g_nAvgPrc * g_nQty) + nOrderPrice
		nTotalQty = g_nQty + nQty
		
		sResult = Form.getLen(FormatNumber(truncateToDecimalPlaces(nTotalPrice / nTotalQty, sDecimalLen), sDecimalLen) .." " .. sCurrency)
		sResult2 = Form.getLen(FormatNumber(truncateToDecimalPlaces(nTotalPrice / nTotalQty, sDecimalLen), sDecimalLen).." " )
	
		contMain.lblEst1.caption = FormatNumber(truncateToDecimalPlaces(nTotalPrice / nTotalQty, sDecimalLen), sDecimalLen).." " .. sCurrency
'		contMain.lblEst1.changeTextAttr(sResult2, sResult-sResult2, 4,-4, false)
		
		contMain.lblEst2.caption = Round((nCurPrc-(nTotalPrice / nTotalQty))/(nTotalPrice / nTotalQty) * 100, 2)
		contMain.lblEst3.caption = nTotalQty
	else
		contMain.lblPreEst1.caption = "-"
		contMain.lblEst1.caption = "-"
	end if
	
End Function

'==============================================
' 호가단위 체크 
'==============================================
Function Check_HogaUnit(sValue)
	szUnit = GetHogaUnit(g_sType, sValue, 0)
	
	nDiv = CDbl(sValue) / CDbl(szUnit)
	sDiv = FormatNumber(nDiv,4,1,0,0,1)
	nDecimalIdx = instr(sDiv, ".")
	nTotalLen = Form.getLen(sDiv)
	nMod = Cdbl(right(sDiv, Cint(nTotalLen) - Cint(nDecimalIdx)))

	if Cdbl(sValue) >= 1 and nMod > 0 then
		Form.ShowAlert("알림", "호가 단위를 확인해주세요.\n(호가 단위 : " & FormatNumber(szUnit, Cint(sDecimalLen)) & " " & sCurrency&")")
		return false
	else
		return true
	end if
End Function

'===============================================
' 가격입력 세팅
'===============================================
Function DisplaySet_TargetPrc(sValue)
	if isEmpty(sValue) == true or Cdbl(sValue) == 0 then
		Exit Function
	end if
		
	if Check_HogaUnit(sValue) == false then
		Exit Function
	end if
	
	sUnit = GetHogaUnit(g_sType, contMain.lblHidePrc.caption, nGbn) 
	
	sTmpPrc = ReSet_Prc(sValue, 1)
	
	if Cdbl(sUpLimit) <> 0 then
		if Cdbl(sUpLimit) < Cdbl(sTmpPrc) then
			Form.ShowAlert("알림", "최대 단가를 확인해주세요.\n".."(상한가 : " .. FormatNumber(sUpLimit, sDecimalLen) .. "" .. sCurrency..")")
			sTmpPrc = sUpLimit
		end if
	end if
	
	if Cdbl(sDnLimit) <> 0 then
		if Cdbl(sDnLimit) > Cdbl(sTmpPrc) then
			Form.ShowAlert("알림", "최소 단가를 확인해주세요.\n".."(하한가 : " ..FormatNumber(sDnLimit, sDecimalLen) .. "" .. sCurrency..")")
			sTmpPrc = sDnLimit
		end if
	end if
	
	contMain.lblHidePrc.caption = sTmpPrc
	sPrc = SetPrice("AUTO", sTmpPrc, sDecimalLen, sCurrency)
	contMain.lblPrc.caption = sPrc
End Function

'============================================================================
' 입력가격 세팅
'============================================================================
Function SetPrice(sType, nPrc, nDecimalLen, sPostFix)

	
	if isEmpty(nDecimalLen) == true or isEmpty(nPrc) == true then
		 return ""
	end if
	
	sChk = Instr(Cstr(nPrc), ".")
	
	'================================================================
	'소수점(dot)이 있는 경우
	'================================================================
	if sChk > 0 then
		
		'------------------------------
		'소수점영역 길이
		'------------------------------
		sCha = CInt(Len(nPrc) - sChk)
		
		'-------------------------------------------------------
		'소수점영역의 길이가 국가별 소수점 자리수를 다 채운 경우
		'-------------------------------------------------------
		if sCha >= Cint(nDecimalLen) then
			 
			 if sCha >= Cint(nDecimalLen) then
				sResult = FormatNumber(nPrc, nDecimalLen).." " .. sPostFix
				return sResult
			 else
				 return ""
			 end if
		
		'-------------------------------------------------------	 
		' 소수점영역의 길이를 아직 다 안채운 경우
		'-------------------------------------------------------
		else
			
			'-------------------------------------------------------------------
			'자동으로 호가가격이 입력되는 경우(초기값 세팅/ 호가 +,- 버튼 클릭)
			'국가별 소수점 자리수로 가격을 다시 맞춰준다.
			'-------------------------------------------------------------------
			if sType == "AUTO" then
				
				sResult = FormatNumber(nPrc,nDecimalLen).." " .. sPostFix
				return sResult
				
			'-------------------------------------------------------------------
			'가격이 수동으로 입력되는 경우(키패드 입력)에는 입력받은대로 표시
			'-------------------------------------------------------------------
			else
				sResult = nPrc.." " .. sPostFix
				return sResult
			end if
			
		end if
	
	'================================================================
	' 소수점(dot)이 없는 경우
	'================================================================
	else
		if sType == "AUTO" then
			sResult = FormatNumber(nPrc,nDecimalLen) .." " .. sPostFix
			return sResult
		else
			sResult = FormatNumber(nPrc,0) .." " .. sPostFix
			return sResult
		end if
	end if
	
End Function
'****************************************************************************
'               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
'****************************************************************************
'============================================================================
Sub Form_OnFormInitBefore()
	contMain.imgArrow.maintainratio = "1"
	contMain.imgInfo0.maintainratio = "1"
	contMain.lblSubTitle.sizeAutoFit()
End Sub

'============================================================================
Sub Form_OnFormInit()
	'------------------------------------------------
	' 링크데이터 구조
	' 국내/해외구분`종목코드`보유수량'평균단가'수익률
	'------------------------------------------------
	
	sLinkData = Form.GetOpenLinkData()
'	sLinkData = "0`003340`10`10`10"
	arrLinkData = Convert_StrToArr(sLinkData, "`")
	
	if #arrLinkData >= 5 then
		g_sType 		= arrLinkData(0)
		g_sItemCode 	= arrLinkData(1)
		g_nQty 		= CDbl(replace(arrLinkData(2), ",",""))
		g_nAvgPrc 	= CDbl(arrLinkData(3))
		g_nRate 		= CDbl(arrLinkData(4))

		Init_Control()
		
		Change_ContBgColor()
		
		if g_sType == "0" then
			g_sSor = arrLinkData(5)
			Form.setDelayEvent(0, 0.3)
		elseif g_sType == "1" then
			Form.setDelayEvent(1, 0.3)
		end if
	end if
End Sub

'============================================================================
Sub Form_OnDelayEvent(nID)

	if Cint(nID) == 0 then
		itemName = Form.GetItemCodeInfo(g_sItemCode, "name")
		contHideTop.lblItemName.setAutoScrollText(itemName)

		RequestDmtc()
	elseif Cint(nID) == 1 then
		itemName = Form.GetItemCodeInfo(g_sItemCode, "name")
		contHideTop.lblItemName.setAutoScrollText(itemName)
		
		RequestOvrs()
	end if
End Sub 

'============================================================================
Sub DATAMANAGER_OnSendTranBefore(szTranID)
	
	if szTranID == "ohhts_6000_001r" or szTranID == "ohhts_6000_001r_1" then
		rtChk = Form.GetSharedData( "REALTIME_"..g_sExid, false )
		
		DATAMANAGER.ClearInputData(false, szTranID)
	
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" 	, 0 , "OV" )		'시장구분			
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "FID_COND_MRKT_CLS_CODE" 		, 0 , g_sExid )	'마켓구분
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "FID_INPUT_OVRS_ISCD" 		, 0 , g_sCode )	'종목코드
		DATAMANAGER.SetDataValue( 0, szTranID, "InBlock1", "FIDX_INPUT_DELY_RLTM_CLS_CODE" , 0 , rtChk )	'실시간 여부
		
	elseif szTranID == "ohhts_6000_017r" then
		rtChk = Form.GetSharedData( "REALTIME_"..g_sExid, false )
		
		DATAMANAGER.ClearInputData(false, "ohhts_6000_017r")
	
		DATAMANAGER.SetDataValue( false, "ohhts_6000_017r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" 	, 0 , "OV" )		'시장구분			
		DATAMANAGER.SetDataValue( false, "ohhts_6000_017r", "InBlock1", "FID_COND_MRKT_CLS_CODE" 		, 0 , g_sExid )	'마켓구분
		DATAMANAGER.SetDataValue( false, "ohhts_6000_017r", "InBlock1", "FID_INPUT_OVRS_ISCD" 			, 0 , g_sCode )	'종목코드
		DATAMANAGER.SetDataValue( false, "ohhts_6000_017r", "InBlock1", "FIDX_INPUT_DELY_RLTM_CLS_CODE" , 0 , rtChk )	'실시간 여부

	elseif szTranID == "ohhts_6000_023r" then
		rtChk = Form.GetSharedData( "REALTIME_"..g_sExid, false )
		
		DATAMANAGER.ClearInputData(false, "ohhts_6000_023r")
	
		DATAMANAGER.SetDataValue( false, "ohhts_6000_023r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE" 	, 0 , "OV" )		'시장구분			
		DATAMANAGER.SetDataValue( false, "ohhts_6000_023r", "InBlock1", "FID_COND_MRKT_CLS_CODE" 		, 0 , g_sExid )	'마켓구분
		DATAMANAGER.SetDataValue( false, "ohhts_6000_023r", "InBlock1", "FID_INPUT_OVRS_ISCD" 			, 0 , g_sCode )	'종목코드
		DATAMANAGER.SetDataValue( false, "ohhts_6000_023r", "InBlock1", "FIDX_INPUT_DELY_RLTM_CLS_CODE" , 0 , rtChk )	'실시간 여부
	elseif szTranID = "ohhts_1001_001r" then
		sItemMarket = Form.GetItemCodeInfo( g_sItemCode , "market")
		
		if g_sSor == "Y" then
			sItemMarket = "TJ"
		end if
		
		DATAMANAGER.SetDataValue( 0, "ohhts_1001_001r", "InBlock1", "FID_INPUT_ISCD"				, 0 , g_sItemCode 	)
		DATAMANAGER.SetDataValue( 0, "ohhts_1001_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE"	, 0 , sItemMarket 	)	
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "ohhts_6000_001r_1"then
		'-------------------------------------------------------------------------
		' [종목정보] 선택종목 정보 탭별로 전달(호가단위는 각 주문화면에서 세팅됨)
		'-------------------------------------------------------------------------
		sOrdSize 	=  DATAMANAGER.GetDataValue( 0, "ohhts_6000_001r_1", "OutBlock1", "FIDX_SHNU_ODER_QTY_UNIT" 		, 0 )		' 매매단위(매수)
		sOrdSizeMaedo	=  DATAMANAGER.GetDataValue( 0, "ohhts_6000_001r_1", "OutBlock1", "FIDX_SELN_ODER_QTY_UNIT" 		, 0)			' 매매단위(매도)
		sCurrency	=  DATAMANAGER.GetDataValue( 0, "ohhts_6000_001r_1", "OutBlock1", "FIDX_CRNC_CODE" 				, 0 )		' 통화
		sKorName		=  DATAMANAGER.GetDataValue( 0, "ohhts_6000_001r_1", "OutBlock1", "FIDX_KOR_ISNM" 				, 0 )		' 한글종목명
		sTickType	=  DATAMANAGER.GetDataValue( 0, "ohhts_6000_001r_1", "OutBlock1", "FIDX_TICK_CLS" 				, 0 )		' 종목 틱타입
		
		sUpLimit		=  tostring(Cdbl(DATAMANAGER.GetDataValue( 0, "ohhts_6000_001r_1", "OutBlock1", "FIDX_MXPR" 		, 0 )))	' 상한가
		sDnLimit		=  tostring(Cdbl(DATAMANAGER.GetDataValue( 0, "ohhts_6000_001r_1", "OutBlock1", "FIDX_LLAM" 		, 0 )))	' 하한가
		sDecimalLen 	=  tostring(Cdbl(DATAMANAGER.GetDataValue( 0, "ohhts_6000_001r_1", "OutBlock1", "FIDX_DCPN_CNT" 	, 0 )))	' 가격소수점
		
		if g_sExid == "OQ" or g_sExid == "NY" or g_sExid == "AX" then
			sMkOp = Form.GetSharedData("&OVRS_MARKET_OPERATION_US", false)
			
			if sMkOp == "001" then
				DATAMANAGER.RequestTranData("ohhts_6000_017r")
			elseif sMkOp == "005" then
				DATAMANAGER.RequestTranData("ohhts_6000_023r")
			else
				DATAMANAGER.RequestTranData("ohhts_6000_001r")
			end if
		else
			DATAMANAGER.RequestTranData("ohhts_6000_001r")
		end if
	elseif szTranID == "ohhts_6000_001r"then
'		szAttr = DATAMANAGER.GetDataAttr(0, "ohhts_6000_001r", "OutBlock1", "FIDX_PRPR" , 0)
'		Change_ContBgColor(szAttr)

		Init_DataSet()
	
'		DATAMANAGER.RequestRealData("ohhts_exst_ictg")
	elseif szTranID == "ohhts_6000_017r"then
'		szAttr = DATAMANAGER.GetDataAttr(0, "ohhts_6000_017r", "OutBlock1", "FIDX_DYTM_PRPR" , 0)
'		Change_ContBgColor(szAttr)

		Init_DataSet()
		
'		DATAMANAGER.RequestRealData("ohhts_exst_cntd")
	elseif szTranID == "ohhts_6000_023r"then
'		szAttr = DATAMANAGER.GetDataAttr(0, "ohhts_6000_023r", "OutBlock1", "FIDX_MKT_AFT_PRPR" , 0)
'		Change_ContBgColor(szAttr)

		Init_DataSet()
		
'		DATAMANAGER.RequestRealData("ohhts_exst_cnta")
	elseif szTranID == "ohhts_1001_001r"then
'		szAttr = DATAMANAGER.GetDataAttr(0, "ohhts_1001_001r", "OutBlock1", "FID_STCK_PRPR" , 0)
'		Change_ContBgColor(szAttr)

		'-------------------------------------------------------------------------
		' [종목정보] 선택종목 정보 탭별로 전달(호가단위는 각 주문화면에서 세팅됨)
		'-------------------------------------------------------------------------
		sOrdSize 	=  "1"
		sOrdSizeMaedo	=  ""
		sCurrency	=  "원"
		sKorName		=  ""
		sTickType	=  ""
		
		sUpLimit		=  tostring(Cdbl(DATAMANAGER.GetDataValue( 0, "ohhts_1001_001r", "OutBlock1", "FID_MXPR" 		, 0 )))	' 상한가
		sDnLimit		=  tostring(Cdbl(DATAMANAGER.GetDataValue( 0, "ohhts_1001_001r", "OutBlock1", "FID_LLAM"		, 0 )))	' 하한가
		sDecimalLen 	=  "0"	' 가격소수점
		

		Init_DataSet()
		
'		if g_sSor == "Y" then
'			DATAMANAGER.RequestRealData("ohhts_unt_incg")
'		else
'			DATAMANAGER.RequestRealData("ohhts_stck_incg")
'		end if
		
	end if
End Sub

'============================================================================
Sub DATAMANAGER_OnReceiveTranData(szTranID)
	if szTranID == "ohhts_6000_017r"	then
		szVol = DATAMANAGER.GetDataValue(0, "ohhts_6000_017r", "OutBlock1", "FIDX_DYTM_ACML_VOL", 0)
		if Cdbl(szVol) == 0 then
			szPrpr = DATAMANAGER.GetDataValue(0, "ohhts_6000_001r_1", "OutBlock1", "FIDX_PRPR", 0)
			szSign = DATAMANAGER.GetDataValue(0, "ohhts_6000_001r_1", "OutBlock1", "FIDX_PRDY_VRSS_SIGN" , 0)
			szVrss = DATAMANAGER.GetDataValue(0, "ohhts_6000_001r_1", "OutBlock1", "FIDX_PRDY_VRSS" , 0)
			szCtrt = DATAMANAGER.GetDataValue(0, "ohhts_6000_001r_1", "OutBlock1", "FIDX_PRDY_CTRT" , 0)
			szUnch = DATAMANAGER.GetDataValue(0, "ohhts_6000_001r_1", "OutBlock1", "FIDX_UNCH_PRPR", 0)
			
			szPrpr_Attr = DATAMANAGER.GetDataAttr(0, "ohhts_6000_001r_1", "OutBlock1", "FIDX_PRPR", 0)
			szSign_Attr = DATAMANAGER.GetDataAttr(0, "ohhts_6000_001r_1", "OutBlock1", "FIDX_PRDY_VRSS_SIGN" , 0)
			szVrss_Attr = DATAMANAGER.GetDataAttr(0, "ohhts_6000_001r_1", "OutBlock1", "FIDX_PRDY_VRSS" , 0)
			szCtrt_Attr = DATAMANAGER.GetDataAttr(0, "ohhts_6000_001r_1", "OutBlock1", "FIDX_PRDY_CTRT" , 0)
			szUnch_Attr = DATAMANAGER.GetDataAttr(0, "ohhts_6000_001r_1", "OutBlock1", "FIDX_UNCH_PRPR", 0)

			DATAMANAGER.SetDataValue(0, "ohhts_6000_017r", "OutBlock1", "FIDX_DYTM_PRPR" , 0 , szPrpr)
			DATAMANAGER.SetDataValue(0, "ohhts_6000_017r", "OutBlock1", "FIDX_DYTM_PRDY_VRSS_SIGN" , 0 , szSign)
			DATAMANAGER.SetDataValue(0, "ohhts_6000_017r", "OutBlock1", "FIDX_DYTM_PRDY_VRSS" , 0 , szVrss)
			DATAMANAGER.SetDataValue(0, "ohhts_6000_017r", "OutBlock1", "FIDX_DYTM_PRDY_CTRT", 0 , szCtrt)
			DATAMANAGER.SetDataValue(0, "ohhts_6000_017r", "OutBlock1", "FIDX_DYTM_UNCH_PRPR", 0 , szUnch)
			
			DATAMANAGER.SetDataAttr(0, "ohhts_6000_017r", "OutBlock1", "FIDX_DYTM_PRPR" , 0 , szPrpr_Attr)
			DATAMANAGER.SetDataAttr(0, "ohhts_6000_017r", "OutBlock1", "FIDX_DYTM_PRDY_VRSS_SIGN" , 0 , szSign_Attr)
			DATAMANAGER.SetDataAttr(0, "ohhts_6000_017r", "OutBlock1", "FIDX_DYTM_PRDY_VRSS" , 0 , szVrss_Attr)
			DATAMANAGER.SetDataAttr(0, "ohhts_6000_017r", "OutBlock1", "FIDX_DYTM_PRDY_CTRT", 0 , szCtrt_Attr)
			DATAMANAGER.SetDataAttr(0, "ohhts_6000_017r", "OutBlock1", "FIDX_DYTM_UNCH_PRPR", 0 , szUnch_Attr)
		end if
		
	elseif szTranID == "ohhts_6000_023r"	then
		szPrpr = DATAMANAGER.GetDataValue(0, "ohhts_6000_023r", "OutBlock1", "FIDX_MKT_AFT_PRPR", 0)
		if Cdbl(szPrpr) == 0 then
			szPrpr = DATAMANAGER.GetDataValue(0, "ohhts_6000_001r_1", "OutBlock1", "FIDX_PRPR", 0)
			szSign = DATAMANAGER.GetDataValue(0, "ohhts_6000_001r_1", "OutBlock1", "FIDX_PRDY_VRSS_SIGN" , 0)
			szVrss = DATAMANAGER.GetDataValue(0, "ohhts_6000_001r_1", "OutBlock1", "FIDX_PRDY_VRSS" , 0)
			szCtrt = DATAMANAGER.GetDataValue(0, "ohhts_6000_001r_1", "OutBlock1", "FIDX_PRDY_CTRT" , 0)
			szUnch = DATAMANAGER.GetDataValue(0, "ohhts_6000_001r_1", "OutBlock1", "FIDX_UNCH_PRPR", 0)
			
			szPrpr_Attr = DATAMANAGER.GetDataAttr(0, "ohhts_6000_001r_1", "OutBlock1", "FIDX_PRPR", 0)
			szSign_Attr = DATAMANAGER.GetDataAttr(0, "ohhts_6000_001r_1", "OutBlock1", "FIDX_PRDY_VRSS_SIGN" , 0)
			szVrss_Attr = DATAMANAGER.GetDataAttr(0, "ohhts_6000_001r_1", "OutBlock1", "FIDX_PRDY_VRSS" , 0)
			szCtrt_Attr = DATAMANAGER.GetDataAttr(0, "ohhts_6000_001r_1", "OutBlock1", "FIDX_PRDY_CTRT" , 0)
			szUnch_Attr = DATAMANAGER.GetDataAttr(0, "ohhts_6000_001r_1", "OutBlock1", "FIDX_UNCH_PRPR", 0)

			DATAMANAGER.SetDataValue(0, "ohhts_6000_023r", "OutBlock1", "FIDX_MKT_AFT_PRPR" , 0 , szPrpr)
			DATAMANAGER.SetDataValue(0, "ohhts_6000_023r", "OutBlock1", "FIDX_MKT_AFT_PRDY_VRSS_SIGN" , 0 , szSign)
			DATAMANAGER.SetDataValue(0, "ohhts_6000_023r", "OutBlock1", "FIDX_MKT_AFT_PRDY_VRSS" , 0 , szVrss)
			DATAMANAGER.SetDataValue(0, "ohhts_6000_023r", "OutBlock1", "FIDX_MKT_AFT_PRDY_CTRT", 0 , szCtrt)
			DATAMANAGER.SetDataValue(0, "ohhts_6000_023r", "OutBlock1", "FIDX_MKT_AFT_UNCH_PRPR", 0 , szUnch)
			
			DATAMANAGER.SetDataAttr(0, "ohhts_6000_023r", "OutBlock1", "FIDX_MKT_AFT_PRPR" , 0 , szPrpr_Attr)
			DATAMANAGER.SetDataAttr(0, "ohhts_6000_023r", "OutBlock1", "FIDX_MKT_AFT_PRDY_VRSS_SIGN" , 0 , szSign_Attr)
			DATAMANAGER.SetDataAttr(0, "ohhts_6000_023r", "OutBlock1", "FIDX_MKT_AFT_PRDY_VRSS" , 0 , szVrss_Attr)
			DATAMANAGER.SetDataAttr(0, "ohhts_6000_023r", "OutBlock1", "FIDX_MKT_AFT_PRDY_CTRT", 0 , szCtrt_Attr)
			DATAMANAGER.SetDataAttr(0, "ohhts_6000_023r", "OutBlock1", "FIDX_MKT_AFT_UNCH_PRPR", 0 , szUnch_Attr)
		end if
	end if
End Sub



