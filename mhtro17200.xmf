'==============================================
' 초기데이터 세팅
'==============================================
Function Init_DataSet()

	if g_isFst == true then
		g_isFst = false
		
		'---------------------------------
		' 가격 초기화 : 진입시점 현재가
		'---------------------------------
		nCurPrc = Cdbl(contHideTop.lblTopPrc.caption)

		contMain.lblHidePrc.caption = nCurPrc
		
		sCurPrc = FormatNumber(nCurPrc, sDecimalLen) .. " " .. sCurrency
		contMain.lblPrc.caption = sCurPrc
		
		'---------------------------------
		' 수량 초기화 : 기본 단위 수량
		'---------------------------------
		contMain.lblHideQty.caption = CDbl(sOrdSize)
		sQty = FormatNumber(sOrdSize, 0) .. " 주"
		
		contMain.lblQty.caption = sQty
		
		'---------------------------------
		' 현재 잔고데이터 
		'---------------------------------
		sResult = Form.getLen(FormatNumber(g_nAvgPrc, sDecimalLen) .. " " .. sCurrency)
		sResult2 = Form.getLen(FormatNumber(g_nAvgPrc, sDecimalLen) .. " ")
		
		contMain.lblCur1.caption = FormatNumber(g_nAvgPrc, sDecimalLen) .. " " .. sCurrency
'		contMain.lblCur1.changeTextAttr(sResult2, sResult-sResult2, 4,-4, false)
		
		contMain.lblCur2.caption = g_nRate
		contMain.lblCur3.caption = g_nQty
		
		'---------------------------------
		' 예상 데이터 계산
		'---------------------------------
		Calc_OrderPrice()
	end if
End Function

'==============================================
' 상단 시세 색상지정
'==============================================
Function Change_ContBgColor()
	szTheme = Form.GetEnvData("common.theme")
	
	if Cdbl(g_nRate) > 0 then
		contMain.imgGIF.animation = "icon_fire.gif"
		contMain.lblSubTitle.caption = "불타기 결과"
	else
		contMain.imgGIF.animation = "icon_water.gif"
		contMain.lblSubTitle.caption = "물타기 결과"
	end if
		
			
	if szTheme == "black" then
		contMain.lblBg.bgcolor = "006006006"
	else
		if Cdbl(g_nRate) > 0 then
			contMain.lblBg.bgcolor = "252243242"
		else
			contMain.lblBg.bgcolor = "238242251"
		end if
	end if
End Function

