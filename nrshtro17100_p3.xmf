	Form.CloseForm()
	--	Form.SendReturnToParent("INFO_MODIFY" , g_sLinkData)
	--	Form.CloseForm()
end
-- =============================================================================
function Form_OnMsgBoxClose(sKeyName, sRet)
	if sKeyName == "DELETE" then
		if sRet == "ok" then
			AutoRule_Delete() 
		end
	end
end
-- ===============================================
-- Form_OnDelayEvent(1회 실행)
-- ===============================================
function Form_OnDelayEvent(nID)
	if gf_Tonumber(nID) == 1 then
		btnBlock.left = 1000
	end
end
-- =============================================================================
function Form_OnTriggerEvent(sEventName, sParam)
	if sEventName ==  "RESTAPI_RETURN" then
		btnBlock.left = 0
		------------------------------------
		-- 조건 단건 삭제
		------------------------------------
		if g_sStep == "DELETE"  then
			------------------------------------------
			-- 성공
			------------------------------------------
			if sParam == "SUCCESS" then
				Form.SendReturnToParent("INFO_DELETE" , "")
				Form.CloseForm()
			------------------------------------------
			-- 실패(ERROR or EXCEPTION)
			------------------------------------------
			else
				oError = Form.responseRestAPI("JSONOBJ", 0, "error", "")
				if IsEmpty(oError) == false then
					errorCode = Form.responseRestAPI("DATA", 0, "errorCode", oError)
					errorMessage = Form.responseRestAPI("DATA", 0, "errorMessage", oError)
					if errorCode == "UNMODIFIABLE_STATUS" then
						Form.ShowAlert("알림", "감시가 실행되어 수정이 불가해요.\n내역조회에서 확인해 주세요.")
						Form.setDelayEvent(1, 0.2)
						return 
					elseif errorCode == "FORCED_STOP_STATUS" then
						Form.OpenPopup("nrshtro17100_p10", "", "")
						Form.setDelayEvent(1, 0.2)
						return
					end
				end
				Form.ShowAlert("알림", g_sCommonErrorMsg)
				return 
			end
		------------------------------------
		-- 조건 단건 감시여부 변경
		------------------------------------
		elseif g_sStep == "UPDATE_STATUS"  then	
			------------------------------------------
			-- 성공
			------------------------------------------
			if sParam == "SUCCESS" then
				oData = Form.responseRestAPI("JSONOBJ", 0, "data", "")
				conditionStatusCode	= Form.responseRestAPI("DATA", 0, "conditionStatusCode", oData)
				conditionStatusName	= Form.responseRestAPI("DATA", 0, "conditionStatusName", oData)
				lblData1.caption = conditionStatusName
				if conditionStatusCode == "02" then
					lblData1.fgcolor = 290
					Image3.imgpath = "icon_watch_play"
				else
					lblData1.fgcolor = 4
					Image3.imgpath = "icon_watch_pause"
				end
				Form.SendReturnToParent("INFO_CHANGE" , "")
			------------------------------------------
			-- 실패(ERROR or EXCEPTION)
			------------------------------------------
			else
				oError = Form.responseRestAPI("JSONOBJ", 0, "error", "")
				if IsEmpty(oError) == false then
					errorCode = Form.responseRestAPI("DATA", 0, "errorCode", oError)
					errorMessage = Form.responseRestAPI("DATA", 0, "errorMessage", oError)
					if errorCode == "UNMODIFIABLE_STATUS" then
						Form.ShowAlert("알림", "감시가 실행되어 수정이 불가해요.\n내역조회에서 확인해 주세요.")
						Form.setDelayEvent(1, 0.2)
						return 
					elseif errorCode == "FORCED_STOP_STATUS" then
						Form.OpenPopup("nrshtro17100_p10", "", "")
						Form.setDelayEvent(1, 0.2)
						return
					end
				end
				Form.ShowAlert("알림", g_sCommonErrorMsg)
				return 
			end
		end
		Form.setDelayEvent(1, 0.2)
	end
end
-- =============================================================================
function lblData1_OnClick()
	AutoRule_UpdateStatus() 
end
-- =============================================================================
function Button0_OnClick()
	sLinkData = accountNumber .. "`" .. accountSeqNumber .. "`" .. orderConditionId
	Form.OpenPopup("nrshtro17100_p6" , sLinkData, "")
end
-- =============================================================================
function DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID == "obtro_oder_264r" then
		sItemCode = Transform_Exid2(stockExchangeCode) .. "@" .. stockCode
		g_sExid3	= Form.GetItemCodeInfo(sItemCode, "exchid")
		DATAMANAGER.ClearInputData(0, "obtro_oder_264r")
		DATAMANAGER.SetDataValue(0, "obtro_oder_264r", "InBlock1", "IQRY_CLS_CODE" 		, 0 , "1")
		DATAMANAGER.SetDataValue(0, "obtro_oder_264r", "InBlock1", "ACNO" 				, 0 , accountNumber)
		DATAMANAGER.SetDataValue(0, "obtro_oder_264r", "InBlock1", "ASNO" 				, 0 , accountSeqNumber)
		DATAMANAGER.SetDataValue(0, "obtro_oder_264r", "InBlock1", "OVRS_STCK_SYMB_ISCD" 	, 0 , stockCode)
		DATAMANAGER.SetDataValue(0, "obtro_oder_264r", "InBlock1", "OVRS_EXCH_VNDR_IDNO" 	, 0 , g_sExid3)
		DATAMANAGER.SetDataValue(0, "obtro_oder_264r", "InBlock1", "SELN_BYOV_CLCD" 		, 0 , "1")
	end
end
-- =============================================================================
function DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obtro_oder_264r" then
		sOrderAbleQty = DATAMANAGER.GetDataValue(0, "obtro_oder_264r", "OutBlock1", "ODER_ABLE_QTY"	, 0)
		tblBuyInfo1.SetCellString(3, 1, gf_CommaValue(sOrderAbleQty) .. " 주")
	end
end
-- =============================================================================
function Form_OnFormInitBefore()
	Image3.maintainratio = "1"
end
-- =============================================================================
function Image3_OnClick()
	lblData1_OnClick()
end
