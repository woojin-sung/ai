-- ****************************************************************************
--             P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N              
-- ****************************************************************************

-- ===============================================
-- NULL 체크 
-- ===============================================
function IsEmpty(sData)
	if gf_Trim(sData) == "" or sData == nil or gf_Trim(sData) == "null" then
		return true
	else
		return false
	end
end
-- ===============================================
-- 숫자 소수점 절사 함수
-- ===============================================
function TruncateToDecimalPlaces(nVal, nDeimalPlaces)
	nVal = gf_Tonumber(nVal)
	nFactor = 10 ^ nDeimalPlaces
	szNumStr = gf_CommaValue(nVal*nFactor,12,0,0,0,1)
	nDecimalIdx = instr(szNumStr, ".")
	nTotalData = 0
	if gf_Tonumber(nDecimalIdx) > 0 then
		nTotalData = gf_Tonumber(left(szNumStr, gf_Tonumber(nDecimalIdx)-1))
	else
		nTotalData = gf_Tonumber(szNumStr)
	end
	return nTotalData / nFactor
end
-- ===============================================
-- (NonNull) 문자열 -> 배열 변환함수
-- ===============================================
function Convert_StrToArr(szData, szSeperator)
	local arrData
	-- --------------------------------------------
	-- 링크데이터 값 체크
	-- --------------------------------------------
	if IsEmpty(szData) then
		arrData = {}
		return arrData
	end
	-- --------------------------------------------
	-- 구분자 값 체크
	-- --------------------------------------------
	if IsEmpty(szSeperator) then
		-- 단일변수
		arrData = {}
		table.insert(arrData, szData)
	else
		-- 다중변수
		arrData = gf_Split(szData, szSeperator)
	end
	return arrData
end
-- ==============================================
-- 거래소 구분코드 변경(3자리 -> 2자리)
-- 원장조회 종목연동 시, 과거 거래소 코드로 연동되는 경우 예외처리를 위해 필요
-- ==============================================
function Transform_Exid2(sValue)
	if sValue == "HKS" then
		Transform_Exid2 = "HK"
		return
	elseif sValue == "SHS" then
		Transform_Exid2 = "SH"
		return
	elseif sValue == "SZS" then
		Transform_Exid2 = "SZ"
		return
	elseif sValue == "NYS" then
		Transform_Exid2 = "NY"
		return
	elseif sValue == "AMX" then
		Transform_Exid2 = "AX"
		return
	elseif sValue == "NAS" then
		Transform_Exid2 = "OQ"
		return
	elseif sValue == "TSE" then
		Transform_Exid2 = "JP"
		return
	else
		Transform_Exid2 = sValue
		return
	end
end
function Get_Currency(sValue)
	if sValue == "OQ" or  sValue == "NY" or sValue == "AX"then
		return "USD"
	elseif sValue == "HK" then
		return "HKD"
	elseif sValue == "SH" or  sValue == "SZ" then
		return "CNY"
	elseif sValue == "JP" then
		return "JPY"
	else
		return "USD"
	end
end
function FormatNumber_Currency(sExchCd, sValue)
	if sExchCd == "OQ" or  sExchCd == "NY" or sExchCd == "AX"then
		return FormatNumber(sValue, 4) .. " USD"
	elseif sExchCd == "HK" then
		return FormatNumber(sValue, 3) .. " HKD"
	elseif sExchCd == "SH" or  sExchCd == "SZ" then
		return FormatNumber(sValue, 3) .. " CHN"
	elseif sExchCd == "JP" then
		return FormatNumber(sValue, 2) .. " JPY"
	else
		return FormatNumber(sValue, 4) .. " USD"
	end
end
function Init_Control()
end
function DisplaySet_CondInfo()
	sCurrency = Get_Currency(Transform_Exid2(stockExchangeCode))
	tblBuyInfo.SetCellString(0, 1, stockCode)
	lblItemName.maxlinecnt = 2
	lblItemName.caption = stockKoreaName
	--	tblBuyInfo.SetCellString(1, 1, stockKoreaName)
	tblBuyInfo0.SetCellString(0, 1, FormatNumber_Currency(Transform_Exid2(stockExchangeCode), basePrice))
	nCnt = 0
	sData = ""
	if IsEmpty(priceTypeprofit) == false then
		nCnt = nCnt + 1
		sData = "이익실현 "  .. FormatNumber_Currency(Transform_Exid2(stockExchangeCode), priceprofit)
		Label0.caption = sData
		Label0.visible = true
	end
	if IsEmpty(priceTypepreserve) == false then
		nCnt = nCnt + 1
		sData1 =  "이익보존 "  .. FormatNumber_Currency(Transform_Exid2(stockExchangeCode), pricepreserve)
		Label1.caption = sData1
		Label1.visible = true
	end
	if IsEmpty(priceTypestopLoss) == false then
		nCnt = nCnt + 1
		sData2 =  "손실제한 "  .. FormatNumber_Currency(Transform_Exid2(stockExchangeCode), pricestopLoss)
		Label2.caption = sData2
		Label2.visible = true
	end
	if (gf_Tonumber(Label2.visible) == 1 or Label2.visible == true) then
		Label2.top = 390 + 70
		if (gf_Tonumber(Label1.visible) == 1 or Label1.visible == true) then
			Label1.top = 360 + 70
			if (gf_Tonumber(Label0.visible) == 1 or Label0.visible == true) then
				Label0.top = 330 + 70
			end
		else
			if (gf_Tonumber(Label0.visible) == 1 or Label0.visible == true) then
				Label0.top = 360 + 70
			end
		end
	else
		if (gf_Tonumber(Label1.visible) == 1  or Label1.visible == true) then
			Label1.top = 390 + 70
			if (gf_Tonumber(Label0.visible) == 1  or Label0.visible == true) then
				Label0.top = 360 + 70
			end
		else
			if (gf_Tonumber(Label0.visible) == 1 or Label0.visible == true) then
				Label0.top = 390 + 70
			end
		end
	end
	nGap = 30 * (nCnt-1) 
	tblBuyInfo0.top = 360 + 70  - nGap
	lblDivLine0.top =  350 + 70 - nGap
	lblItemName.top = 305 + 70 - nGap
	tblBuyInfo.top = 280 + 70 - nGap
	imgBuyInfo.top = 260 + 70 - nGap
	imgBuyInfo.height = 345 + nGap
	lblSubTitle0.top = 215 + 70 - nGap
	lblData1.top = 220 + 70 - nGap
	Image3.top = 220 + 70 - nGap
	lblTitleComm.top = 160 + 70 - nGap
	imgMain.top = 150 + 70 - nGap
	tblBuyInfo1.SetCellString(0, 1, orderClsTypeNm)
	if orderClsType == "05" or orderClsType == "34" then
		tblBuyInfo1.SetCellString(2, 1, "-")
	else
		if orderPriceType == "09" then
			sOrdPrc = FormatNumber_Currency(Transform_Exid2(stockExchangeCode), orderPrice)
			tblBuyInfo1.SetCellString(2, 1, sOrdPrc)
		elseif orderPriceType == "01" then
			if gf_Tonumber(tickValue) > 0 then
				tblBuyInfo1.SetCellString(2, 1,"현재가" .. " +" .. tickValue.."틱")
			elseif gf_Tonumber(tickValue) < 0 then
				tblBuyInfo1.SetCellString(2, 1,"현재가" .. " " .. tickValue.."틱")
			elseif gf_Tonumber(tickValue) == 0 then
				tblBuyInfo1.SetCellString(2, 1,"현재가")
			end
		elseif orderPriceType == "02" then
			tblBuyInfo1.SetCellString(2, 1,"시가")
		elseif orderPriceType == "03" then
			tblBuyInfo1.SetCellString(2, 1,"고가")
		elseif orderPriceType == "04" then
			tblBuyInfo1.SetCellString(2, 1,"저가")
		end
	end
	tblBuyInfo1.SetCellString(4, 1, gf_CommaValue(orderQty) .. " 주")
	sDate1 = replace(registrationDate, "-", "")
	sDate = replace(expirationDate, "-", "")
	tblBuyInfo1.SetCellString(5, 1, mid(sDate1,3,2) .. "." .. mid(sDate1,5,2) .. "." .. right(sDate1,2) .. " ~ " .. mid(sDate,3,2) .. "." .. mid(sDate,5,2) .. "." .. right(sDate,2))
	lblData1.caption = conditionStatusName
	if conditionStatusCode == "02" then
		lblData1.fgcolor = 290
		Image3.imgpath = "icon_watch_play"
	else
		lblData1.fgcolor = 4
		Image3.imgpath = "icon_watch_pause"
	end
end
function AutoRule_Delete() 
	--	btnBlock.left = 0
	g_sStep = "DELETE"
	Form.releaseRequestData()
	Form.makeRequestData("orderConditionId", orderConditionId)
	Form.makeRequestData("conditionStatusCode", "99")
	sDev = Form.GetSharedData("&SERVER_MODE", false)
	sUrl = ""
	if sDev == "1" then	--개발기
		sUrl = "https://dev-api-gateway.imeritz.com:8443/"
	else
		sUrl = "https://api-gateway.imeritz.com:8443/"
	end
	Form.requestRestAPI(sUrl.."api/v1/rule/update-status", "")
end
function AutoRule_UpdateStatus() 
	--	btnBlock.left = 0
	g_sStep = "UPDATE_STATUS"
	Form.releaseRequestData()
	Form.makeRequestData("orderConditionId", orderConditionId)
	sStatus = conditionStatusCode
	if conditionStatusCode == "01" then
		sStatus = "02" 
	elseif conditionStatusCode == "02" then
		sStatus = "01" 
	end
	Form.makeRequestData("conditionStatusCode", sStatus)
	sDev = Form.GetSharedData("&SERVER_MODE", false)
	sUrl = ""
	if sDev == "1" then	--개발기
		sUrl = "https://dev-api-gateway.imeritz.com:8443/"
	else
		sUrl = "https://api-gateway.imeritz.com:8443/"
	end
	Form.requestRestAPI(sUrl.."api/v1/rule/update-status", "")
end
