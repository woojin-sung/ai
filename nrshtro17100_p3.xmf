-- =============================================================================
function btnDelete_OnClick()
	if conditionStatusCode == "04" then
		Form.OpenPopup("nrshtro17100_p15" , "", "")
	else
		Form.SendReturnToParent("INFO_MODIFY" , g_sLinkData)
		Form.CloseForm()
	end
	--	Form.MsgBox("안내", "감시 조건을\n삭제 하시겠습니까?", "DELETE", 7, "확인", "취소")
end
