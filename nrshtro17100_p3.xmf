function Form_OnFormInit()
	g_sLinkData = Form.GetOpenLinkData()
	arrLinkData = Convert_StrToArr(g_sLinkData, "`")
	nArrCnt = #arrLinkData
	if nArrCnt >= 32 then
		orderConditionId 		= arrLinkData[1]
		registrationDate 		= arrLinkData[2]
		accountNumber			= arrLinkData[3]
		accountSeqNumber		= arrLinkData[4]
		stockExchangeCode		= arrLinkData[5]
		stockCode				= arrLinkData[6]
		stockKoreaName			= arrLinkData[7]
		tradeType				= arrLinkData[8]
		priceTypeprofit			= arrLinkData[9]
		priceTypeNameprofit		= arrLinkData[10]	
		priceTypeValueprofit		= arrLinkData[11]
		priceprofit			= arrLinkData[12]	
		priceTypepreserve		= arrLinkData[13]
		priceTypeNamepreserve	= arrLinkData[14]
		priceTypeValuepreserve	= arrLinkData[15]
		pricepreserve			= arrLinkData[16]
		priceTypestopLoss		= arrLinkData[17]
		priceTypeNamestopLoss	= arrLinkData[18]
		priceTypeValuestopLoss	= arrLinkData[19]
		pricestopLoss 			= arrLinkData[20]
		orderPaymentType		= arrLinkData[21]
		orderClsType			= arrLinkData[22]
		orderClsTypeNm			= arrLinkData[23]
		orderPriceType			= arrLinkData[24]
		tickValue				= arrLinkData[25]
		orderPrice				= arrLinkData[26]
		orderQty				= arrLinkData[27]
		expirationDate			= arrLinkData[28]
		conditionStatusCode		= arrLinkData[29]
		conditionStatusName		= arrLinkData[30]
		basePriceClsType		= arrLinkData[31]
		basePriceClsTypeName		= arrLinkData[32]
		basePrice				= arrLinkData[33]
		DisplaySet_CondInfo()  
		DATAMANAGER.RequestTranData("obtro_oder_264r")
		return
	end
	Form.CloseForm()               
end
