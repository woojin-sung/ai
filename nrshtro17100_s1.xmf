<?xml version="1.0" encoding="utf-8"?>

<ROOT>
	<MAP_INFO scrno="17100" scrname="매도설정 안내" version="2" writer="함원규" scrtype="1" scripttype="1" />
	<FORM_INFO name="Form" ly_vert="0,0,375,755,1" />
	<CONTROL_INFO>
		<LABEL name="lbl0" caption="스탑로스(Stop Loss) 감시 조건 설정" fontstyle="01" ly_vert="10,0,355,32,1" />
		<IMAGE name="img0" autosize="1" imgpath="bg_infobox.9" ly_vert="20,45,335,123,1" />
		<LABEL name="lbl1" fgcolor="334:034034034" caption="스탑로스란?" fontsize="-2" fontstyle="01" ly_vert="25,45,325,46,1" />
		<LABEL name="lbl2" fgcolor="333:115118124" bgcolor="029:255212175" fontsize="-2" valign="0" multiline="1" ly_vert="25,91,325,50,1" />
		<LABEL name="lblGuide0" fgcolor="334:034034034" caption="ㆍ" fontsize="-2" fontstyle="01" halign="1" valign="0" ly_vert="20,180,10,10,1" />
		<LABEL name="lblInfo0" fgcolor="334:034034034" bgcolor="029:255212175" fontsize="-2" valign="0" multiline="1" ly_vert="25,180,335,60,1" />
		<IMAGE name="imgchk0" autosize="1" ly_vert="35,258,16,12,1" />
		<LABEL name="lblSubInfo0" fgcolor="333:115118124" bgcolor="029:255212175" fontsize="-2" valign="0" multiline="1" ly_vert="47,258,313,60,1" />
		<LABEL name="lblGuide1" fgcolor="334:034034034" caption="ㆍ" fontsize="-2" fontstyle="01" halign="1" valign="0" ly_vert="20,290,10,10,1" />
		<LABEL name="lblInfo1" fgcolor="334:034034034" bgcolor="029:255212175" fontsize="-2" valign="0" multiline="1" ly_vert="25,290,335,60,1" />
		<IMAGE name="imgchk1" autosize="1" ly_vert="35,330,16,12,1" />
		<LABEL name="lblSubInfo1" fgcolor="333:115118124" bgcolor="029:255212175" fontsize="-2" valign="0" multiline="1" ly_vert="47,330,313,60,1" />
		<IMAGE name="imgchk2" autosize="1" ly_vert="35,400,16,12,1" />
		<LABEL name="lblSubInfo2" fgcolor="333:115118124" bgcolor="029:255212175" fontsize="-2" valign="0" multiline="1" ly_vert="47,400,313,60,1" />
		<TABORDER_INFO horz="" vert="" />
	</CONTROL_INFO>
	<SCRIPT_INFO _len="4587" _ulen="4045" >
dofile("scr/script.lua")
dofile("scr/json.lua")
-- ============================================================================
-- ============================================================================
local g_sTheme
g_sTheme = Form.GetEnvData("common.theme")
local g_sOsType
g_sOsType = Form.GetSharedData("&OS_TYPE", false )
local nextTop
nextTop = 0
-- =============================================================================
function Form_OnFormInit()
	lbl0.highlight = "332"
	sText = "투자자가 사전에 설정한 조건이 충족되는 경우\n'자동으로 매도'하여 손실을 최소화 해주는 기능이예요."
	lbl2.sizeAutoFit()
	lbl2.caption = sText
end
-- =============================================================================
function lbl2_OnSizeAutoFit()
	nH = 0
	if g_sOsType == "2" then
		nH = gf_Tonumber(lbl2.height)
	else
		nH = gf_Tonumber(lbl2.height2)
	end
	img0.height = 46 + nH + 14
	if g_sOsType == "2" then
		nextTop = img0.top + img0.height + 20
	else
		nextTop = img0.top2 + img0.height2 + 20
	end
	lblGuide0.top = nextTop
	lblInfo0.top = nextTop
	sText = "감시조건으로는 이익실현, 이익보존, 손실제한이 있으며 조건을 모두 설정하거나, 1개 조건도 설정이 가능해요."
	lblInfo0.sizeAutoFit()
	lblInfo0.caption = sText
end
-- =============================================================================
function lblInfo0_OnSizeAutoFit()
	imgchk0.maintainratio = "2"
	if g_sTheme == "white" then
		imgchk0.imgpath = "icon_check_gray_l"
	else
		imgchk0.imgpath = "icon_check_gray_d"
	end
	--	nH = cint(lblInfo0.height2)
	nH = 0
	if g_sOsType == "2" then
		nH = gf_Tonumber(lblInfo0.height)
	else
		nH = gf_Tonumber(lblInfo0.height2)
	end
	nextTop = nextTop + nH + 8
	lblSubInfo0.top = nextTop
	imgchk0.top = nextTop + 2
	sText = "단, 이익보존은 이익실현 설정 시에만 설정 가능하며 단독 설정은 불가해요."
	lblSubInfo0.sizeAutoFit()
	lblSubInfo0.caption = sText
end
-- =============================================================================
function lblSubInfo0_OnSizeAutoFit()
	--	nH = cint(lblSubInfo0.height2)
	nH = 0
	if g_sOsType == "2" then
		nH = gf_Tonumber(lblSubInfo0.height)
	else
		nH = gf_Tonumber(lblSubInfo0.height2)
	end
	nextTop = nextTop + nH + 20
	lblGuide1.top = nextTop
	lblInfo1.top = nextTop
	sText = "기준가는 이익청산(이익실현,이익보존), 손절매(손익제한) 가격을 설정하기 위한 기준가격이예요."
	lblInfo1.sizeAutoFit()
	lblInfo1.caption = sText
end
-- =============================================================================
function lblInfo1_OnSizeAutoFit()
	imgchk1.maintainratio = "2"
	if g_sTheme == "white" then
		imgchk1.imgpath = "icon_check_gray_l"
	else
		imgchk1.imgpath = "icon_check_gray_d"
	end
	--	nH = cint(lblInfo1.height2)
	nH = 0
	if g_sOsType == "2" then
		nH = gf_Tonumber(lblInfo1.height)
	else
		nH = gf_Tonumber(lblInfo1.height2)
	end
	nextTop = nextTop + nH + 8
	lblSubInfo1.top = nextTop
	imgchk1.top = nextTop + 2
	sText = "평균단가, 직접입력, 전일종가 중 선택해요."
	lblSubInfo1.sizeAutoFit()
	lblSubInfo1.caption = sText
end
-- =============================================================================
function lblSubInfo1_OnSizeAutoFit()
	imgchk2.maintainratio = "2"
	if g_sTheme == "white" then
		imgchk2.imgpath = "icon_check_gray_l"
	else
		imgchk2.imgpath = "icon_check_gray_d"
	end
	--	nH = cint(lblSubInfo1.height2)
	nH = 0
	if g_sOsType == "2" then
		nH = gf_Tonumber(lblSubInfo1.height)
	else
		nH = gf_Tonumber(lblSubInfo1.height2)
	end
	nextTop = nextTop + nH + 8
	lblSubInfo2.top = nextTop
	imgchk2.top = nextTop + 2
	sText = "기준가를 평균단가로 설정한 경우 평균단가는 조건 설정 시점의 평균매입단가로 설정이 되며, " ..
	"설정 후 해당 종목의 평균단가가 변동된 경우 자동으로 반영되지 않아요. " ..
	"\n(변동된 평균단가로 설정을 원하는 경우 조건수정 또는 삭제 후 다시 설정해 주세요.)"
	lblSubInfo2.sizeAutoFit()
	lblSubInfo2.caption = sText
end
-- =============================================================================
function lblSubInfo2_OnSizeAutoFit()
	--	nH = cint(lblSubInfo2.height2)
	nH = 0
	if g_sOsType == "2" then
		nH = gf_Tonumber(lblSubInfo2.height)
	else
		nH = gf_Tonumber(lblSubInfo2.height2)
	end
	nextTop = nextTop + nH + 20
	Form.triggerEvent("#", "TOP_SIZE", nextTop)
end
	</SCRIPT_INFO>
</ROOT>