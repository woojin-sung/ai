	<SCRIPT_INFO _len="16052" _ulen="15098" >
dofile("scr/script.lua")
dofile("scr/json.lua")
local gGubun,gAcno,gAsno,gCode,gVndrCode,gCashCredit,gPrice,gQty,gDecimal,gCurrency
gGubun = ""
gAcno = ""
gAsno = "" 
gCode = ""
gVndrCode = ""
gCashCredit = ""
gPrice = ""
gQty = ""
gDecimal = ""
gCurrency = ""

local gHabsan,gLoanType,gLoanDate,gLoanSrno,gRepayAll
gHabsan = ""
gLoanType = ""
gLoanDate = ""
gLoanSrno = ""
gRepayAll = ""

local gMask
gMask = ""

local gOsType

local gbLargeFont
gbLargeFont = false

 --============================================================================
function Form_OnFormInitBefore()

	gOsType = Form.GetSharedData("..OS_TYPE", false)

	imgInfo0.SetMaintainingRatio("1")
	imgInfo1.SetMaintainingRatio("1")
	
	 -----------------------------------------------------
	 -- 공통(주문금액 영역) 
	 -----------------------------------------------------
	LabelTitle0.paddinginfo = "0,0,0,0"
	
	LabelPrcTitle.paddinginfo = "0,0,0,0"
	LabelPrcData.paddinginfo = "0,0,0,0"
	LabelQtyTitle.paddinginfo = "0,0,0,0"
	LabelQtyData.paddinginfo = "0,0,0,0"
	LabelOrdPrcTitle.paddinginfo = "0,0,0,0"
	LabelOrdPrcData.paddinginfo = "0,0,0,0"
	
	 -----------------------------------------------------
	 -- 현금(정산금액 영역)
	 -----------------------------------------------------
	contCash.LabelCashPrePrcTitle.paddinginfo = "0,0,0,0"
	contCash.LabelCashOrdPrcTitle.paddinginfo = "0,0,0,0"
	contCash.LabelCashFeeTitle.paddinginfo = "0,0,0,0"
	contCash.LabelCashTaxTitle.paddinginfo = "0,0,0,0"
	contCash.LabelCashPreOrdPrcTitle.paddinginfo = "0,0,0,0"
	contCash.LabelCashExchangeRatetitle.paddinginfo = "0,0,0,0"
	contCash.LabelCashWonTitle.paddinginfo = "0,0,0,0"
	
	contCash.LabelCashOrdPrcData.paddinginfo = "0,0,0,0"
	contCash.LabelCashFeeData.paddinginfo = "0,0,0,0"
	contCash.LabelCashTaxData.paddinginfo = "0,0,0,0"
	contCash.LabelCashPreOrdPrcData.paddinginfo = "0,0,0,0"
	contCash.LabelCashExchangeRateData.paddinginfo = "0,0,0,0"
	contCash.LabelCashWonData.paddinginfo = "0,0,0,0"
	
	 -----------------------------------------------------
	 -- 대출(정산금액 영역)
	 -----------------------------------------------------
	contCredit.LabelCreditPrePrcTitle.paddinginfo = "0,0,0,0"
	contCredit.LabelCreditOrdPrcTitle.paddinginfo = "0,0,0,0"
	contCredit.LabelCreditFeeTitle.paddinginfo = "0,0,0,0"
	contCredit.LabelCreditTaxTitle.paddinginfo = "0,0,0,0"
	contCredit.LabelCreditRepayTitle.paddinginfo = "0,0,0,0"
	contCredit.LabelCreditIntrTitle.paddinginfo = "0,0,0,0"
	contCredit.LabelCreditPreOrdPrcTitle.paddinginfo = "0,0,0,0"
	contCredit.LabelCreditExchangeRatetitle.paddinginfo = "0,0,0,0"
	contCredit.LabelCreditWonTitle.paddinginfo = "0,0,0,0"
	contCredit.LabelCreditFinalTitle.paddinginfo = "0,0,0,0"
	
	contCredit.LabelCreditOrdPrcData.paddinginfo = "0,0,0,0"
	contCredit.LabelCreditFeeData.paddinginfo = "0,0,0,0"
	contCredit.LabelCreditTaxData.paddinginfo = "0,0,0,0"
	contCredit.LabelCreditRepayData.paddinginfo = "0,0,0,0"
	contCredit.LabelCreditIntrData.paddinginfo = "0,0,0,0"
	contCredit.LabelCreditPreOrdPrcData.paddinginfo = "0,0,0,0"
	contCredit.LabelCreditExchangeRateData.paddinginfo = "0,0,0,0"
	contCredit.LabelCreditWonData.paddinginfo = "0,0,0,0"
	contCredit.LabelCreditFinalData.paddinginfo = "0,0,0,0"
	
	
end

 --============================================================================
function Form_OnFormInit()

	 ----------------------------------------------------------------
	 --큰글씨모드 대응
	 ----------------------------------------------------------------
	szTextSize = Form.GetEnvData("common.textsize")
	if gf_Tonumber(szTextSize) > 0 then
		gbLargeFont = true
	end


	 --매수/매도구분값★종합계좌★계좌일련번호★종목코드★거래소코드★현금/대출구분값★입력가격★입력수량★소수점자리수★통화
	 --★일반/신용합산여부★대출상세유형코드★대출일자★대출일련번호★전액상환여부
	szLinkData = Form.GetOpenLinkData()
	 --Form.ShowAlert("szLinkData", szLinkData)
	
	arrData = gf_Split(szLinkData,"★")
	
	if #arrData > 9 then
		
		gGubun 		= arrData[0+1]  --매수(2)/매도(1)
		gAcno 		= arrData[1+1]
		gAsno 		= arrData[2+1]
		gCode 		= arrData[3+1]
		gVndrCode 	= arrData[4+1]
		gCashCredit 	= arrData[5+1]  --현금(0)/대출(1)
		gPrice 		= arrData[6+1]
		gQty 		= arrData[7+1]
		gDecimal 	= arrData[8+1]
		gCurrency 	= arrData[9+1]
		gHabsan		= arrData[10+1]  --일반(1)/신용합산(2)
		
		 --대출일때 대출관련 데이터 GET
		if gCashCredit == "1" then
			gLoanType 	= arrData[11+1]
			gLoanDate 	= arrData[12+1]
			gLoanSrno 	= arrData[13+1]
			gRepayAll 	= arrData[14+1]
		end
	
	end
	
	SetContType(gCashCredit)
	SetOrderPrice(gPrice,gQty,gDecimal,gCurrency)
	
end

 --============================================================================
function DATAMANAGER_OnReceiveTranComplete(szTranID)

	if szTranID == "obtro_oder_263r" then
			
		ordPrcData 		= DATAMANAGER.GetDataValue(0, "obtro_oder_263r", "OutBlock1", "DEAL_CAMT" 		, 0)  --주문금액
		ordFeeData 		= DATAMANAGER.GetDataValue(0, "obtro_oder_263r", "OutBlock1", "ODER_CFEE" 		, 0)  --수수료
		ordTaxData 		= DATAMANAGER.GetDataValue(0, "obtro_oder_263r", "OutBlock1", "RCGN_CTAX" 		, 0)  --세금
		
		ordRepayData		= DATAMANAGER.GetDataValue(0, "obtro_oder_263r", "OutBlock1", "RDMP_AMT" 		, 0)  --상환금액
		ordIntrData		= DATAMANAGER.GetDataValue(0, "obtro_oder_263r", "OutBlock1", "RDMP_INT" 		, 0)  --상환이자
		
		ordPrePrcData 	= DATAMANAGER.GetDataValue(0, "obtro_oder_263r", "OutBlock1", "EXCL_CAMT" 		, 0)  --정산통화금액
		ordExchangeData  	= DATAMANAGER.GetDataValue(0, "obtro_oder_263r", "OutBlock1", "DEAL_STND_EXRT" 	, 0)  --환율
		ordWonData 		= DATAMANAGER.GetDataValue(0, "obtro_oder_263r", "OutBlock1", "WNCR_EXCL_AMT" 	, 0)  --원화정산금액
		
		ordFinalPrcData	= DATAMANAGER.GetDataValue(0, "obtro_oder_263r", "OutBlock1", "ANTC_CALC_AMT" 	, 0)  --최종금액
			
		 --==========================================================
		 -- 현금
		 --==========================================================
		if gCashCredit == "0" then
		
			 ------------------------------------------------------------
			 -- 주문금액
			 ------------------------------------------------------------
			if ordPrcData ~= "" then
				contCash.LabelCashOrdPrcData.mask = gMask
				contCash.LabelCashOrdPrcData.caption = ordPrcData
			else
				contCash.LabelCashOrdPrcData.caption = "-"
			end
			
			 ------------------------------------------------------------
			 -- 수수료
			 ------------------------------------------------------------
			contCash.LabelCashFeeData.mask = gMask
			contCash.LabelCashFeeData.caption = ordFeeData
			
			 ------------------------------------------------------------
			 -- 세금
			 ------------------------------------------------------------
			contCash.LabelCashTaxData.mask = gMask
			contCash.LabelCashTaxData.caption = ordTaxData
			
			 ------------------------------------------------------------
			 -- 정산금액(예상)
			 ------------------------------------------------------------
			if ordPrePrcData ~= "" then
				contCash.LabelCashPreOrdPrcData.mask = gMask
				contCash.LabelCashPreOrdPrcData.caption = ordPrePrcData
			else
				contCash.LabelCashPreOrdPrcData.caption = "-"
			end
			
			 ------------------------------------------------------------
			 -- 환율
			 ------------------------------------------------------------
			if gCurrency == "JPY" then
				LabelExchangeRateMaskData = "0,1,," .."".. ",0,,4,1,1,0,0"
			else
				LabelExchangeRateMaskData = "0,1,," .."".. ",0,,2,1,1,0,0"	
			end
			
			contCash.LabelCashExchangeRateData.mask = LabelExchangeRateMaskData
			contCash.LabelCashExchangeRateData.caption = ordExchangeData
			
			 ------------------------------------------------------------
			 -- 원화환산(예상)
			 ------------------------------------------------------------
			contCash.LabelCashWonData.caption = ordWonData
		
		 --==========================================================
		 -- 대출
		 --==========================================================
		elseif gCashCredit == "1" then
			
			 ------------------------------------------------------------
			 -- 주문금액
			 ------------------------------------------------------------
			if ordPrcData ~= "" then
				contCredit.LabelCreditOrdPrcData.mask = gMask
				contCredit.LabelCreditOrdPrcData.caption = ordPrcData
			else
				contCredit.LabelCreditOrdPrcData.caption = "-"
			end
			
			 ------------------------------------------------------------
			 -- 수수료
			 ------------------------------------------------------------
			contCredit.LabelCreditFeeData.mask = gMask
			contCredit.LabelCreditFeeData.caption = ordFeeData
			
			 ------------------------------------------------------------
			 -- 세금
			 ------------------------------------------------------------
			contCredit.LabelCreditTaxData.mask = gMask
			contCredit.LabelCreditTaxData.caption = ordTaxData
			
			 ------------------------------------------------------------
			 -- 정산금액(예상) : 주문금액  (수수료+세금)
			 ------------------------------------------------------------
			if ordPrePrcData ~= "" then
				contCredit.LabelCreditPreOrdPrcData.mask = gMask
				contCredit.LabelCreditPreOrdPrcData.caption = ordPrePrcData
			else
				contCredit.LabelCreditPreOrdPrcData.caption = "-"
			end
			
			 ------------------------------------------------------------
			 -- 환율
			 ------------------------------------------------------------
			if gCurrency == "JPY" then
				LabelExchangeRateMaskData = "0,1,," .."".. ",0,,4,1,1,0,0"
			else
				LabelExchangeRateMaskData = "0,1,," .."".. ",0,,2,1,1,0,0"	
			end
			
			contCredit.LabelCreditExchangeRateData.mask = LabelExchangeRateMaskData
			contCredit.LabelCreditExchangeRateData.caption = ordExchangeData
			
			 ------------------------------------------------------------
			 -- 원화환산(예상) : 정산금액(예상) * 환율
			 ------------------------------------------------------------
			contCredit.LabelCreditWonData.caption = ordWonData
			
			 ------------------------------------------------------------
			 -- 상환금액
			 ------------------------------------------------------------
			 --contCredit.LabelCreditRepayData.mask = gMask
			contCredit.LabelCreditRepayData.caption = ordRepayData
			
			 ------------------------------------------------------------
			 -- 이자
			 ------------------------------------------------------------
			 --contCredit.LabelCreditIntrData.mask = gMask
			contCredit.LabelCreditIntrData.caption = ordIntrData
			
			 ------------------------------------------------------------
			 -- 최종금액(예상)
			 ------------------------------------------------------------
			contCredit.LabelCreditFinalData.caption = ordFinalPrcData
			
		
		
		end
		
	end
	
end

 --============================================================================
function ButtonOK_OnClick()
	Form.CloseForm()
end

 --============================================================================
function imgBg_OnClick()
	Form.CloseForm()
end

 --============================================================================
function RequestData()

	DATAMANAGER.SetDataValue(0, "obtro_oder_263r", "InBlock1", "ACNO" 				, 0 , gAcno)
	DATAMANAGER.SetDataValue(0, "obtro_oder_263r", "InBlock1", "ASNO" 				, 0 , gAsno)
	DATAMANAGER.SetDataValue(0, "obtro_oder_263r", "InBlock1", "OVRS_STCK_SYMB_ISCD" 	, 0 , gCode)
	DATAMANAGER.SetDataValue(0, "obtro_oder_263r", "InBlock1", "OVRS_EXCH_VNDR_IDNO" 	, 0 , gVndrCode)
	DATAMANAGER.SetDataValue(0, "obtro_oder_263r", "InBlock1", "SELN_BYOV_CLCD" 		, 0 , gGubun)
	DATAMANAGER.SetDataValue(0, "obtro_oder_263r", "InBlock1", "ODQT" 				, 0 , gQty)
	DATAMANAGER.SetDataValue(0, "obtro_oder_263r", "InBlock1", "OVRS_STCK_ODER_PRC" 	, 0 , gPrice)
	
	 --대출일때
	if gCashCredit == "1" then
		DATAMANAGER.SetDataValue(0, "obtro_oder_263r", "InBlock1", "LOAN_DTL_TYPE_CODE" 	, 0 , gLoanType)
		DATAMANAGER.SetDataValue(0, "obtro_oder_263r", "InBlock1", "LOAN_DATE" 			, 0 , gLoanDate)
		DATAMANAGER.SetDataValue(0, "obtro_oder_263r", "InBlock1", "LOAN_SRNO" 			, 0 , gLoanSrno)
	end
	
	 --매도일때
	if gGubun == "1" then
		DATAMANAGER.SetDataValue(0, "obtro_oder_263r", "InBlock1", "RDMP_CLS_CODE" 		, 0 , gRepayAll)
	end
	
	DATAMANAGER.SetDataValue(0, "obtro_oder_263r", "InBlock1", "IQRY_CLS_CODE" 		, 0 , gHabsan)
	DATAMANAGER.RequestTranData("obtro_oder_263r")

end
 --============================================================================
function SetContType(sType)
	
	if sType == "1" then
		
		contCash.visible = false
		
		contCredit.left = 0
		contCredit.visible = true
		
		imgMain.top = 160
		imgMain.height = 489
		
		LabelTitle0.top = 180
		imgOrdPrcBg.top = 215
		
		LabelPrcTitle.top = 224
		LabelPrcData.top = 224
		
		LabelQtyTitle.top = 245
		LabelQtyData.top = 245
		
		LabelOrdPrcTitle.top = 267
		LabelOrdPrcData.top = 267
		
		if gOsType == "1" then
			imgInfo0.top = 184
			imgInfo1.top = 314
		else
			imgInfo0.top = 182
			imgInfo1.top = 312
		end
		
	end
	
	if gbLargeFont then
		imgInfo0.left = 90
		imgInfo1.left = 160
	end
	

end
 --============================================================================
function SetOrderPrice(sPrice,sQty,sDecimal,sCurrency)
	
	local sMask
	sMask = ""
	
	 -------------------------------------------------------------------------
	 -- 소수점 자리수 세팅 / 통화기호 세팅
	 -------------------------------------------------------------------------
	if sCurrency ~= "" and sDecimal ~= "" then
		sMask = "0,0,,".. " " .. sCurrency .. ",0,,"..sDecimal..",1,1,2,0"
	else
		sMask = "0,0,,,0,,".."4"..",1,1,2,0"
	end
	
	gMask = sMask
	
	 -------------------------------------------------------------------------
	 -- 주문금액 세팅
	 -------------------------------------------------------------------------
	if sPrice == "" then
		LabelPrcData.caption = "- "  .. sCurrency
	else
		LabelPrcData.mask = sMask
		LabelPrcData.caption = sPrice
	end
	
	if sQty == "" then
		LabelQtyData.caption = "-"
	else
		LabelQtyData.caption = gf_CommaValue(sQty,0)
	end
	
	if sPrice ~= "" and sQty ~= "" then
		nOrdPrice = gf_Tonumber(sPrice) * gf_Tonumber(sQty)
		LabelOrdPrcData.mask = sMask
		LabelOrdPrcData.caption = nOrdPrice
	else
		LabelOrdPrcData.caption = "- " .. sCurrency
	end
	
	 -------------------------------------------------------------------------
	 -- 정산금액 미리보기 
	 -------------------------------------------------------------------------
	 --contCash.LabelCashOrdPrcData.mask = sMask
	 --contCash.LabelCashFeeData.mask = sMask
	 --contCash.LabelCashPreOrdPrcData.mask = sMask
	
	
	 -------------------------------------------------------------------------
	 -- 정산금액 조회 서비스 호출
	 -------------------------------------------------------------------------
	if sPrice ~= "" and sQty ~= "" then
		RequestData()
	end

end

 --============================================================================
 -- 주문금액 툴팁
 --============================================================================
function imgInfo0_OnClick()
	
	if gbLargeFont then
		sText = " '단가, 수량' 을 모두 입력한 경우만 조회되며,\n주문화면에서는 제비용(수수료/세금)이 제외되어 조회돼요"
		imgInfo0.OpenToolTip(sText, 345, 90, 2)
	else
		sText = " '단가, 수량' 을 모두 입력한 경우만 조회되며,\n주문화면에서는 제비용(수수료/세금)이 제외되어 조회돼요"
		imgInfo0.OpenToolTip(sText, 320, 90, 2)
	end
	
end

 --============================================================================
 -- 정산금액 툴팁
 --============================================================================
function imgInfo1_OnClick()
	
	if gbLargeFont then
		sText = "종목별 합산되어 정산되므로, 최종 정산금액은 현재 조회되는 금액과 상이 할 수 있어요."
		imgInfo1.OpenToolTip(sText, 340, 75, 0)
	else
		sText = "종목별 합산되어 정산되므로, 최종 정산금액은 현재 조회되는 금액과 상이 할 수 있어요."
		imgInfo1.OpenToolTip(sText, 320, 70, 0)
	end
	
end

	
