<?xml version="1.0" encoding="utf-8"?>

<ROOT>
	<MAP_INFO scrno="17100" scrname="매도설정 안내" version="2" writer="함원규" scrtype="1" scripttype="1" />
	<FORM_INFO name="Form" ly_vert="0,0,375,1000,1" />
	<CONTROL_INFO>
		<LABEL name="lbl0" fgcolor="334:034034034" caption="2. 이익보존이란?" fontstyle="01" ly_vert="10,0,355,32,1" />
		<LABEL name="lblInfo0" fgcolor="333:115118124" bgcolor="029:255212175" fontsize="-2" valign="0" multiline="1" ly_vert="10,40,355,60,1" />
		<LABEL name="lblSubInfo0" fgcolor="333:115118124" bgcolor="029:255212175" fontsize="-2" halign="1" valign="0" multiline="1" ly_vert="20,258,335,42,1" />
		<IMAGE name="img0" autosize="1" ly_vert="0,90,375,159,1" />
		<IMAGE name="img1" autosize="1" ly_vert="0,390,375,201,1" />
		<LABEL name="lblDiv0" bgcolor="272:246246246" transmode="0" ly_vert="20,326,335,1,1" />
		<LABEL name="lbl1" fgcolor="334:034034034" caption="          설정방법 알아보기" fontstyle="01" halign="1" ly_vert="0,350,375,30,1" />
		<IMAGE name="imgicon0" autosize="1" imgpath="icon_book" ly_vert="100,350,35,30,1" />
		<LABEL name="lblSubInfo1" fgcolor="334:034034034" bgcolor="029:255212175" fontsize="-2" valign="0" multiline="1" ly_vert="27,550,338,42,1" />
		<LABEL name="lblSubInfo2" fgcolor="334:034034034" bgcolor="029:255212175" fontsize="-2" valign="0" multiline="1" ly_vert="27,580,338,42,1" />
		<LABEL name="lblGuide0" fgcolor="334:034034034" caption="ㆍ" fontsize="-2" fontstyle="01" halign="1" valign="0" multiline="1" ly_vert="15,550,20,20,1" />
		<LABEL name="lblGuide1" fgcolor="334:034034034" caption="ㆍ" fontsize="-2" fontstyle="01" halign="1" valign="0" multiline="1" ly_vert="15,580,20,20,1" />
		<TABORDER_INFO horz="" vert="" />
	</CONTROL_INFO>
	<SCRIPT_INFO _len="3843" _ulen="3359" >
dofile("scr/script.lua")
dofile("scr/json.lua")
-- ============================================================================
-- ============================================================================
local g_sTheme
g_sTheme = Form.GetEnvData("common.theme")
local g_sOsType
g_sOsType = Form.GetSharedData("..OS_TYPE", false )
local nextTop
nextTop = 0
-- =============================================================================
function Form_OnFormInitBefore()
	img0.maintainratio = "1"
	img1.maintainratio = "1"
	imgicon0.maintainratio = "1"
end
-- =============================================================================
function Form_OnFormInit()
	if g_sTheme == "white" then
		img0.imgpath = "guide_tab2_img1_l"
		img1.imgpath = "guide_tab2_img2_l"
	else
		img0.imgpath = "guide_tab2_img1_d"
		img1.imgpath = "guide_tab2_img2_d"
	end
	sText = "주가가 이익보존가격 도달 후 초과 상승하였으나, 목표로 정한 이익실현 가격에 도달하지 못하고 하락하여 이익보존 가격 이하로 도달 시 감시가 실행되어, 설정한 주문 방법으로 매도 주문이 실행돼요."
	--	nLen = gf_Tonumber(Form.GetLen("이익실현 가격에 도달하지 못하고 하락하여 이익보존 가격 이하로 도달 시"))
	--	nStart = gf_Tonumber(Form.GetLen("주가가 기준가 대비 상승하여, 이익보존가격 도달 후 초과 상승하였으나, "))
	lblInfo0.SizeAutoFit()
	lblInfo0.caption = sText
	--	lblInfo0.ChangeTextAttr(nStart, nLen, 290, -2, true)
end
-- =============================================================================
function lblInfo0_OnSizeAutoFit()
	--	nH = gf_Tonumber(lblInfo0.height2)
	nH = 0
	if g_sOsType == "2" then
		nH = gf_Tonumber(lblInfo0.height)
	else
		nH = gf_Tonumber(lblInfo0.height2)
	end
	nextTop = 40 + nH + 10
	img0.top = nextTop
	nextTop = nextTop + 159 + 20
	lblSubInfo0.top = nextTop
	sText = "예) 주가가 $525(이익보존) 돌파 후 $550(이익실현)에 도달하지 못하고 하락 전환하여 $525(이익보존) 도달 시 설정한 주문 조건으로 주문이 실행 돼요."
	lblSubInfo0.SizeAutoFit()
	lblSubInfo0.caption = sText
end
-- =============================================================================
function lblSubInfo0_OnSizeAutoFit()
	--	nH = gf_Tonumber(lblSubInfo0.height2)
	nH = 0
	if g_sOsType == "2" then
		nH = gf_Tonumber(lblSubInfo0.height)
	else
		nH = gf_Tonumber(lblSubInfo0.height2)
	end
	nextTop = nextTop + nH + 30
	lblDiv0.top = nextTop
	nextTop = nextTop + 30
	imgicon0.top = nextTop
	lbl1.top = nextTop
	nextTop = nextTop + 50
	img1.top = nextTop
	nextTop = nextTop + 201 + 20
	lblSubInfo1.top = nextTop
	lblGuide0.top = nextTop
	lblGuide0.caption = "①"
	sText = "이익실현 입력시에만 이익보존 입력이 가능해요.(선택사항)"
	lblSubInfo1.SizeAutoFit()
	lblSubInfo1.caption = sText
end
-- =============================================================================
function lblSubInfo1_OnSizeAutoFit()
	--	nH = gf_Tonumber(lblSubInfo1.height2)
	nH = 0
	if g_sOsType == "2" then
		nH = gf_Tonumber(lblSubInfo1.height)
	else
		nH = gf_Tonumber(lblSubInfo1.height2)
	end
	nextTop = nextTop + nH + 8
	lblSubInfo2.top = nextTop
	lblGuide1.top = nextTop
	lblGuide1.caption = "②"
	sText = "이익보존 가격은 이익실현보다 낮은 금액으로 입력 해야돼요."
	lblSubInfo2.SizeAutoFit()
	lblSubInfo2.caption = sText
end
-- =============================================================================
function lblSubInfo2_OnSizeAutoFit()
	--	nH = gf_Tonumber(lblSubInfo2.height2)
	nH = 0
	if g_sOsType == "2" then
		nH = gf_Tonumber(lblSubInfo2.height)
	else
		nH = gf_Tonumber(lblSubInfo2.height2)
	end
	nextTop = nextTop + nH + 20
	Form.TriggerEvent("#", "MID_2_SIZE", nextTop)
end
	
</SCRIPT_INFO>
</ROOT>