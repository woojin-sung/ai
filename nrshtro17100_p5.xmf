-- ===============================================
-- 문자열 -> 배열 변환
-- ===============================================
function Convert_StringToArr(szData, szSeperator)
	szArrData = ""
	if szData ~= nil and szData ~= "" then
		szArrData = gf_Split(szData, szSeperator)
	end
	return szArrData
end
-- ===============================================
-- 배열 데이터 확인
-- ===============================================
function Contains_Array(arrData, szData)
	if arrData == nil or arrData == "" then
		return false
	end
	if szData == nil or szData == "" then
		return false
	end
	nArrCnt = #arrData
	for i = 0, nArrCnt-1 do
		szArrData = arrData[i]
		if szArrData == szData then
			return true
		end
	end 
	return false
end
-- ===============================================
-- 체크배열 초기화
-- ===============================================
function Clear_ChkArray(arrData)
	if arrData == nil or arrData == "" then
		return false
	end
	if szData == nil or szData == "" then
		return false
	end
	nArrCnt = #arrData
	for i = 0, nArrCnt-1 do
		arrData[i] = "0"	
	end 
end
-- ===============================================
-- 체크배열 전체선택
-- ===============================================
function All_ChkArray(arrData)
	if arrData == nil or arrData == "" then
		return false
	end
	if szData == nil or szData == "" then
		return false
	end
	nArrCnt = #arrData
	for i = 0, nArrCnt-1 do
		arrData[i] = "1"	
	end 
end
-- ===============================================
-- 배열 인덱스 추출
-- ===============================================
function Return_ArrayIndex(arrData, szData)
	nReturn = -1
	if arrData == nil or arrData == "" then
		return nReturn
	end
	if szData == nil or szData == "" then
		return nReturn
	end
	nArrCnt = #arrData
	for i = 0, nArrCnt-1 do
		if arrData[i] == szData then
			nReturn = i
			break
		end	
	end 
	return nReturn
end
