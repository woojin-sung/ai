-- ===============================================
-- Form_OnFormInit
-- ===============================================
function Form_OnFormInit()
	szData = Form.GetOpenLinkData()
	if szData == nil or gf_Trim(szData) == "" then
		return
	end
	szArrData = gf_Split(szData, "★")
	nArrCnt = #szArrData
	if nArrCnt > 3 then
		g_szLinkGbn = szArrData[1+1]
		g_szDupSel_1 = szArrData[2+1]
		g_szDupSel_2 = szArrData[3+1]
		szContData = szArrData[4+1]
		szContData2 = szArrData[5+1]
		szSavaData1 = ""
		szSavaData2 = ""
		if #szArrData > 4 then
			szSavaData1 = szArrData[6+1]
		end
		if #szArrData > 5 then
			szSavaData2 = szArrData[7+1]
		end
		if g_szDupSel_1 == "1" then
			szContData = "전체`" .. szContData
		end
		g_arrContent = Convert_StringToArr(szContData, "`")
		nArrCnt = #g_arrContent
		g_arrContent_Check = {}
		for i = 0, nArrCnt-1 do
			if szSavaData1 == g_arrContent[i] then --string.find(szSavaData1, g_arrContent(i)) > 0 then
				g_arrContent_Check[i] = "1"
			else
				g_arrContent_Check[i] = "0"
			end
		end
		if g_szDupSel_2 == "1" then
			szContData2 = "전체`" .. szContData2
		end
		g_arrContent2 = Convert_StringToArr(szContData2, "`")
		nArrCnt = #g_arrContent2
		g_arrContent2_Check = {}
		for i = 0, nArrCnt-1 do
			if szSavaData2 == g_arrContent2[i] then --string.find(szSavaData2, g_arrContent2(i)) > 0 then
				g_arrContent2_Check[i] = "1"
			else
				g_arrContent2_Check[i] = "0"
			end
		end
	end
	Init_Control()
	Init_Content()
end
-- =============================================================================
function contBg_Pannel0_OnClick(nIndex, sCellID)
	if sCellID == "" then
		return
	end
	if contBg.Pannel0.GetCellValue(sCellID, nIndex) == "" then
		return
	end
	DisplaySetting_Pannel0(nIndex, sCellID)
end
-- =============================================================================
function contBg_Pannel1_OnClick(nIndex, sCellID)
	if sCellID == "" then
		return
	end
	if contBg.Pannel1.GetCellValue(sCellID, nIndex) == "" then
		return
	end
	DisplaySetting_Pannel1(nIndex, sCellID)
end
-- =============================================================================
function contBg_btnOk_OnClick()
	szContent0 = Convert_ChkArrToString(g_arrContent, g_arrContent_Check, "`")
	szContent1 = Convert_ChkArrToString(g_arrContent2, g_arrContent2_Check, "`")
	szReturnData = szContent0 .. "★" .. szContent1
	Form.SendReturnToParent("17100_RETURN_DATA_"..g_szLinkGbn, szReturnData)
	Form.CloseForm()
end
-- =============================================================================
function contBg_btnCancel_OnClick()
	Clear_Content("0")
	Clear_Content("1")
	g_arrContent_Check[0+1] = "1"
	contBg.Pannel0.SetPropCardCell("imagefilepth", "lbl0", 0, g_szBtnImg_Select)
	g_arrContent2_Check[0+1] = "1"
	contBg.Pannel1.SetPropCardCell("imagefilepth", "lbl0", 0, g_szBtnImg_Select)
end
-- =============================================================================
function imgBg_OnClick()
	Form.CloseForm()
end
	
</SCRIPT_INFO>
</ROOT>