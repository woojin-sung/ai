local g_szTxtColor_Normal 
g_szTxtColor_Normal = "334"
local g_szTxtColor_Grey 
g_szTxtColor_Grey = "333"
local g_szTxtColor_White 
g_szTxtColor_White = "338"
local g_szLineColor_Title 
g_szLineColor_Title = "334"
local g_nForm_Height  
g_nForm_Height = 755
local g_nContBg_Title_Height  
g_nContBg_Title_Height= 100
local g_nBottomBtn_Height 
g_nBottomBtn_Height= 60
local g_nPannel_Row_Height 
g_nPannel_Row_Height= 36
local g_nPannel_Row_Gap
g_nPannel_Row_Gap= 10
local g_nCommonMargin 
g_nCommonMargin= 20
local g_nContBtn_Height 
g_nContBtn_Height= 0
local g_nContList_Height 
g_nContList_Height= 0
