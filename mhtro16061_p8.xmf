		<BUTTON name="btnOk" caption="검색" btnimage="btn_20.9" ly_vert="187,592,190,60,1" />
		<CONTAINER name="cont0" ly_vert="0,277,375,125,1" scroll_ly_vert="0,277,375,125,1" >
			<CONTROL_INFO>
				<LABEL name="Label0" fontstyle="01" caption="예약 유형" paddinginfo="1,0,0,0" ly_vert="18,0,200,20,1" />
				<RADIOGROUP name="RadioOrderClsCode" fontsize="-2" buttonshape="1" buttonsnumber="5" initselectionuse="1" initselection="0" ly_vert="20,30,335,80,1" >
					<RADIO_INFO>
						<RADIO no="0" text="전체" radioimage="input_06.9.png" transfervalue="0" position="0,0,105,35" />
