				<IMAGE name="img1" autosize="1" imgpath="btn_line2_n.9" ly_vert="133,30,105,35,1" />
				<LABEL name="Label1" fontsize="-2" caption="전체
(취소 제외)" halign="1" multiline="1" click="1" ly_vert="133,30,105,35,1" />
				<IMAGE name="img2" autosize="1" imgpath="btn_line2_n.9" ly_vert="248,30,105,35,1" />
				<LABEL name="Label2" fontsize="-2" caption="예약" halign="1" click="1" ly_vert="248,30,105,35,1" />
