						<RADIO no="2" text="기간잔량" radioimage="input_06.9.png" transfervalue="2" position="0,45,105,35" />
						<RADIO no="3" text="기간예약" radioimage="input_06.9.png" transfervalue="3" position="115,45,105,35" />
						<RADIO no="4" text="특정일주문" radioimage="input_06.9.png" transfervalue="4" position="230,45,105,35" />
					</RADIO_INFO>
				</RADIOGROUP>
			</CONTROL_INFO>
