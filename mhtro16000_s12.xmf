 --****************************************************************************
 --==============================================
 -- 이미지
 --==============================================
local g_ImgArrow_Down
g_ImgArrow_Down = "icon_arrow_d"

local g_ImgArrow_Up
g_ImgArrow_Up = "icon_arrow_u"

 --==============================================
 -- 컬러코드
 --==============================================
 -- 기본 텍스트 컬러 (검정색)
local g_szTxtColor_Normal
g_szTxtColor_Normal 	= "334"

 -- 기본 텍스트 컬러 (회색)
local g_szTxtColor_Grey
g_szTxtColor_Grey 	= "333"

 -- 기본 텍스트 컬러 (흰색)
local g_szTxtColor_White
g_szTxtColor_White 	= "338"

 -- 빨강
local g_szTxtColor_Red
g_szTxtColor_Red = "290"

 -- 파랑
local g_szTxtColor_Blue
g_szTxtColor_Blue = "291"

 -- 기본 배경색상
local g_szContBgColor
g_szContBgColor = "320"

 -- 기본 구분선 색상
 -- 진한색
local g_szLineColor
g_szLineColor = "255255255" --"347"
 -- 중간색
local g_szLineColor2
g_szLineColor2 = "256"
 -- 연한색
local g_szLineColor3
g_szLineColor3 = "320"

 -- 빨강
local g_szBadgeBgColor_Red
g_szBadgeBgColor_Red = "339"

 -- 파랑
local g_szBadgeBgColor_Blue
g_szBadgeBgColor_Blue = "340"

 --==============================================
 -- 기타 전역변수
 --==============================================
local g_szItemCd
local g_szExidCd
local g_szOnlyCd
local g_sExid3
local g_rtChk

local g_szType
g_szType = "하드웨어 및 장비"

local g_szTypeCd
g_szTypeCd = ""

local g_isExpand
g_isExpand = ""
 --****************************************************************************
 --            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N              
 --****************************************************************************

 --===============================================
 -- 컨트롤 초기설정
 --===============================================
function Init_Control()
	contMain.SetEnableScroll(false)
	contExpand.SetEnableScroll(false)
	
	contMain.lblMainTitle0.paddinginfo = "0,0,0,0"
	contMain.lblMainTitle0.fgcolor = g_szTxtColor_Normal
	
	contMain.lblMore0.paddinginfo = "0,0,0,0"
	contMain.lblMore0.fgcolor = g_szTxtColor_Grey
	
	contMain.lblLine0.bgcolor = g_szLineColor
	
	contMain.lblLine1.bgcolor = g_szLineColor2

	for i = 0, 12 do
		Form.SetCtlProp("contMain.lblTitle" .. i, "paddinginfo", "0,0,0,0")
		Form.SetCtlProp("contMain.lblTitle" .. i, "fgcolor", g_szTxtColor_Grey)
		Form.SetCtlProp("contMain.lblTitle" .. i, "maxlinecnt", "1")
		
		Form.SetCtlProp("contMain.lblData" .. i, "paddinginfo", "0,0,0,0")
		Form.SetCtlProp("contMain.lblData" .. i, "fgcolor", g_szTxtColor_Normal)
		Form.SetCtlProp("contMain.lblData" .. i, "maxlinecnt", "1")
	end
	
	contExpand.lblExpand.paddinginfo = "0,0,0,0"
	contExpand.lblExpand.fgcolor = g_szTxtColor_Grey
	
	contExpand.lblDiv.bgcolor = g_szLineColor3
	
	contExpand.imgArrow.maintainratio = "1"
	contExpand.imgArrow.imgpath = g_ImgArrow_Down
	
	Expand_Cont()
end

function Expand_Cont()
	 --첫실행
	if g_isExpand == "" then
		g_isExpand = false
		
		contMain.height = 162
		contMain.lblLine1.top = 160
		contExpand.top = 161
		
		contExpand.lblExpand.caption = "펼치기"
		
		nWidth = Form.GetTextWidth("펼치기", -4, false, false)
		contExpand.imgArrow.left = 188 + (nWidth/2) + 5
	
		contExpand.imgArrow.imgpath = g_ImgArrow_Down
		
		contMain.lblTitle8.visible = false
		contMain.lblData8.visible = false
		contMain.lblTitle9.visible = false
		contMain.lblData9.visible = false
		
	 --펼치기 -> 접기 
	elseif g_isExpand == true then
		g_isExpand = false
		
		contMain.height = 162
		contMain.lblLine1.top = 160
		contExpand.top = 161
		
		contExpand.lblExpand.caption = "펼치기"
		
		nWidth = Form.GetTextWidth("펼치기", -4, false, false)
		contExpand.imgArrow.left = 188 + (nWidth/2) + 5
	
		contExpand.imgArrow.imgpath = g_ImgArrow_Down
		
		contMain.lblTitle8.visible = false
		contMain.lblData8.visible = false
		contMain.lblTitle9.visible = false
		contMain.lblData9.visible = false
		
		Form.TriggerEvent("#", "CHANGE_LAYOUT_S12", 236)
		
	 --접기 -> 펼치기
	else
		g_isExpand = true
		
		contMain.height = 245
		contMain.lblLine1.top = 244
		contExpand.top = 245
		
		contExpand.lblExpand.caption = "접기"
		
		nWidth = Form.GetTextWidth("접기", -4, false, false)
		contExpand.imgArrow.left = 188 + (nWidth/2) + 5
		
		contExpand.imgArrow.imgpath = g_ImgArrow_Up
		
		contMain.lblTitle8.visible = true
		contMain.lblData8.visible = true
		contMain.lblTitle9.visible = true
		contMain.lblData9.visible = true
		
		Form.TriggerEvent("#", "CHANGE_LAYOUT_S12", 320)
	end
end

function Request_Tran_ohhts_6000_001r()
	DATAMANAGER.ClearInputData(false, "ohhts_6000_001r")
	
	DATAMANAGER.SetDataValue( false, "ohhts_6000_001r", "InBlock1", "FID_INPUT_COND_MRKT_DIV_CODE"  , 0 , "OV" )
	DATAMANAGER.SetDataValue( false, "ohhts_6000_001r", "InBlock1", "FID_INPUT_OVRS_ISCD" 			, 0 , g_szOnlyCd )
	DATAMANAGER.SetDataValue( false, "ohhts_6000_001r", "InBlock1", "FID_COND_MRKT_CLS_CODE" 		, 0 , g_szExidCd)
	DATAMANAGER.SetDataValue( false, "ohhts_6000_001r", "InBlock1", "FIDX_INPUT_DELY_RLTM_CLS_CODE" , 0 , g_rtChk)

	DATAMANAGER.RequestTranData("ohhts_6000_001r")
end

function Process_Tran_ohhts_6000_001r()
	szData0 = DATAMANAGER.GetDataValue( false, "ohhts_6000_001r", "OutBlock1", "FIDX_AVLS", 0)				 --시가총액
	szData1 = DATAMANAGER.GetDataValue( false, "ohhts_6000_001r", "OutBlock1", "FIDX_LSTN_STCN", 0)			 --상장주수
	szData2 = DATAMANAGER.GetDataValue( false, "ohhts_6000_001r", "OutBlock1", "FIDX_PER", 0)				 --PER
	szData3 = DATAMANAGER.GetDataValue( false, "ohhts_6000_001r", "OutBlock1", "FIDX_EPS", 0)				 --EPS
	szData4 = DATAMANAGER.GetDataValue( false, "ohhts_6000_001r", "OutBlock1", "FIDX_CRNC_CODE", 0)			 --매매통화
	szData5 = DATAMANAGER.GetDataValue( false, "ohhts_6000_001r", "OutBlock1", "FIDX_SHNU_ODER_QTY_UNIT", 0)	 --매매단위
	szData9 = DATAMANAGER.GetDataValue( false, "ohhts_6000_001r", "OutBlock1", "FIDX_SDPR", 0)			 --기준가
	szData12 = DATAMANAGER.GetDataValue( false, "ohhts_6000_001r", "OutBlock1", "FIDX_BSTP_MDDV_NAME", 0)	 --업종명
	
	 --20240926_01 HWG START : 저사양 단말 데이터(자릿수) 표시 오류 수정
	 --시가총액(천)
	if szData0 ~= "" then
		nResult = gf_Tonumber(szData0)
		szResult = ""
		
		if nResult > 99999999 then
			szResult = gf_CommaValue(gf_Round(gf_Tonumber(nResult / 100000),0), 0)
			contMain.lblTitle0.caption = "시가총액(억)"
		else
			szResult = gf_CommaValue(nResult, 0)
			contMain.lblTitle0.caption = "시가총액(천)"
		end
		
		contMain.lblData0.caption = szResult
	else
		contMain.lblData0.caption = "-"
	end
	
	 --상장주수(천)
	if szData1 ~= "" then
		szResult = gf_CommaValue(gf_Round(gf_Tonumber(gf_Tonumber(szData1) / 1000),0), 0)
		contMain.lblData1.caption = szResult
	else
		contMain.lblData1.caption = "-"
	end
	 --20240926_01 HWG END
	
	 --PER
	if szData2 ~= "" then
		contMain.lblData2.caption = gf_CommaValue(szData2, 3)
	else
		contMain.lblData2.caption = "-"
	end
	
	 --EPS
	if szData3 ~= "" then
		contMain.lblData3.caption = gf_CommaValue(szData3, 3)
	else
		contMain.lblData3.caption = "-"
	end
	
	 --매매통화
	if szData4 ~= "" then
		contMain.lblData4.caption = szData4
		
 --		contMain.lblMainTitle0.caption = "기본정보 (단위 : "..Gf_Trim(szData4)..")"
 --		
 --		contMain.lblMainTitle0.ChangeTextAttr(0,5,334,0,true)
 --		contMain.lblMainTitle0.ChangeTextAttr(5,10,333,-6,true)
	else
		contMain.lblData4.caption = "-"
	end
	
	 --매매단위
	if szData5 ~= "" then
		contMain.lblData5.caption = gf_Tonumber(szData5)
	else
		contMain.lblData5.caption = "-"
	end
	
	 --기준가
	if szData9~= "" then
		szResult = ""
		if g_szExidCd == "AX" or g_szExidCd == "NY" or g_szExidCd == "OQ" then
			 szResult = gf_CommaValue(szData9, 4)
		elseif g_szExidCd == "SH" or g_szExidCd == "SZ" or g_szExidCd == "HK" then
			 szResult = gf_CommaValue(szData9, 3)
		elseif g_szExidCd == "JP" then
			 szResult = gf_CommaValue(szData9, 1)
		end
		
		contMain.lblData9.caption = szResult
	else
		contMain.lblData9.caption = "-"
	end
	
	 --업종명
	if szData12 ~= "" then
		contMain.lblData12.caption = szData12
	else
		contMain.lblData12.caption = "-"
	end
	
end

function Request_Tran_obsim_oscm_331r()
	DATAMANAGER.ClearInputData(false, "obsim_oscm_331r")
	
	DATAMANAGER.SetDataValue( false, "obsim_oscm_331r", "InBlock1", "ISCD" , 0 , g_szOnlyCd.."."..g_szExidCd )
	
	DATAMANAGER.RequestTranData("obsim_oscm_331r")
end

function Process_Tran_obsim_oscm_331r()
	sSellOnly   = DATAMANAGER.GetDataValue(false, "obsim_oscm_331r", "OutBlock1", "BYOV_PRHB_YN", 0)  -- 매수불가여부
	sStatus     = DATAMANAGER.GetDataValue(false, "obsim_oscm_331r", "OutBlock1", "TRHT_YN", 0) 		 -- 거래정지여부
	sWeekDate   = DATAMANAGER.GetDataValue(false, "obsim_oscm_331r", "OutBlock2", "STND_DATE", 0) 	 -- 기준일
	sMrktCls    = DATAMANAGER.GetDataValue(false, "obsim_oscm_331r", "OutBlock2", "HLDY_YN", 0) 		 -- 휴일여부
	
	sWeekDate = WeekDay( CDate( string.sub(sWeekDate, 1, 4) .. "-" .. string.sub(sWeekDate, 5, 5 + 2 - 1) .. "-" .. string.sub(sWeekDate, -2) ) )
	if gf_Trim(sMrktCls) == "Y" and sWeekDate ~= "1" and sWeekDate ~= "7" then --일요일, 토요일 제외 end
		contMain.lblData8.caption = "휴장"
	else
		if g_sClsCd == "Y" then
			contMain.lblData8.caption = "거래정지"
		else
			if g_sSellOnly == 1 then
				contMain.lblData8.caption = "매도만 가능"
			else
				contMain.lblData8.caption = "정상"
			end
		end
	end
end

function Request_Tran_obsim_oscm_350r()
	DATAMANAGER.ClearInputData(false, "obsim_oscm_350r")
	
	DATAMANAGER.SetDataValue( false, "obsim_oscm_350r", "InBlock1", "ISCD" , 0 , g_szOnlyCd.."."..g_szExidCd )
	
	DATAMANAGER.RequestTranData("obsim_oscm_350r")
end

function Process_Tran_obsim_oscm_350r()
	szData6 = DATAMANAGER.GetDataValue( false, "obsim_oscm_350r", "OutBlock1", "MGRT_VAL" , 0)				 --증거금율
	szData7 = DATAMANAGER.GetDataValue( false, "obsim_oscm_350r", "OutBlock1", "LOAN_ABLE_YN" , 0)			 --대출가능여부
	
	 --증거금울
	if szData6 ~= "" then
		contMain.lblData6.caption = gf_CommaValue(szData6, 0) .. "%"
	else
		contMain.lblData6.caption = "-"
	end
	
	 --대출가능여부
	if szData7 == "Y" then
		contMain.lblData7.caption = "가능"
	elseif szData7 == "N" then
		contMain.lblData7.caption = "불가능"
	else
		contMain.lblData7.caption = "-"
	end
end

 --==============================================
 -- 거래소코드 -> 거래소명 변환 
 --==============================================
function Transform_Exid(sValue)
	if sValue == "NY" then
		contMain.lblData10.caption = "미국"
		contMain.lblData11.caption = "뉴욕"
	elseif sValue == "OQ" then
		contMain.lblData10.caption = "미국"
		contMain.lblData11.caption = "나스닥"
	elseif sValue == "AX" then
		contMain.lblData10.caption = "미국"
		contMain.lblData11.caption = "아멕스"
	elseif sValue == "HK" then
		contMain.lblData10.caption = "홍콩"
		contMain.lblData11.caption = "홍콩"
	elseif sValue == "SH" then
		contMain.lblData10.caption = "중국"
		contMain.lblData11.caption = "상해"
	elseif sValue == "SZ" then
		contMain.lblData10.caption = "중국"
		contMain.lblData11.caption = "심천"
	elseif sValue == "JP" then
		contMain.lblData10.caption = "일본"
		contMain.lblData11.caption = "도쿄"
	else
		contMain.lblData10.caption = "-"
		contMain.lblData11.caption = "-"
	end
	
end

 --****************************************************************************
 --               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
 --****************************************************************************

 --===============================================
 -- Form_OnTriggerEvent(종목코드 연동)
 --===============================================
function Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "INIT_CODE" then
		if string.find(sParam, "@") > 0 then
			g_szItemCd = sParam
			g_szExidCd = ""
			sTemp = gf_Split(g_szItemCd, "@")
			g_szExidCd = sTemp[0+1]  --시장구분
			g_szOnlyCd = sTemp[1+1]  --종목코드 
			g_sExid3 = Form.GetItemCodeInfo(g_szItemCode, "exchcode3")  --거래소 구분코드
			
			g_rtChk = Form.GetSharedData( "REALTIME_"..g_szExidCd, false )
			
			Transform_Exid(g_szExidCd)
			Request_Tran_ohhts_6000_001r()
			Request_Tran_obsim_oscm_331r()
			Request_Tran_obsim_oscm_350r()
		end
	end
end

 --===============================================
 -- Form_OnFormInitBefore
 --===============================================
function Form_OnFormInitBefore()
end

 --===============================================
 -- Form_OnFormInit
 --===============================================
function Form_OnFormInit()
	Init_Control()
end

 --===============================================
 -- DATAMANAGER_OnReceiveTranComplete
 --===============================================
function DATAMANAGER_OnReceiveTranComplete(szTranID)

	if szTranID == "ohhts_6000_001r" then
		Process_Tran_ohhts_6000_001r()
		
	elseif szTranID == "obsim_oscm_331r" then
		Process_Tran_obsim_oscm_331r()
		
	elseif szTranID == "obsim_oscm_350r" then
		Process_Tran_obsim_oscm_350r()
		
		Form.TriggerEvent("#", "CHANGE_LAYOUT_S12", 236)
	end
	
end


 --============================================================================
function contMain_lblMore0_OnClick()
	Form.TriggerEvent("#", "RETURN_LAYOUT", "기업개요")
end

 --============================================================================
function contExpand_lblExpand_OnClick()
	Expand_Cont()
end

	
</SCRIPT_INFO>
