<ROOT>
	<MAP_INFO scrno="16072" scrname="해외주식 상단 메뉴 팝업" version="2" writer="이신혜" />
	<FORM_INFO name="Form" transmode="0" ly_vert="0,0,375,755,1" />
	<CONTROL_INFO>
		<IMAGE name="imgDim" autosize="1" imgpath="alpha128" ly_vert="0,100,375,655,1" />
		<CONTAINER name="cont0" containerimage="alpha.png" ly_vert="0,0,380,230,1" scroll_ly_vert="0,0,380,230,1" >
			<CONTROL_INFO>
				<IMAGE name="imgBg" imgpath="popup_bg.9" ly_vert="0,50,380,180,1" />
				<LABEL name="lblMenu0" fgcolor="065:102102102" fontsize="3" caption="해외주식 잔고" autofontsize="1" paddinginfo="33,1,0,1" click="1" ly_vert="10,50,344,40,1" />
				<LABEL name="lblMenu1" fgcolor="065:102102102" fontsize="3" caption="해외주식 매매손익" autofontsize="1" paddinginfo="33,1,0,1" click="1" ly_vert="10,90,344,40,1" />
				<LABEL name="lblMenu2" fgcolor="065:102102102" fontsize="3" caption="해외 예수금" autofontsize="1" paddinginfo="33,1,0,1" click="1" ly_vert="10,130,344,40,1" />
				<LABEL name="lblMenu3" fgcolor="065:102102102" fontsize="3" caption="해외주식 평균단가 변경" autofontsize="1" paddinginfo="33,1,0,1" click="1" ly_vert="10,170,344,40,1" />
				<LABEL name="LabelTop" click="1" ly_vert="0,0,375,50,1" />
			</CONTROL_INFO>
		</CONTAINER>
	</CONTROL_INFO>
	<SCRIPT_INFO _len="4437" _ulen="4289" >
 ---------------------------------------------------------------------------------------------
 -- 01. 화 면 명 : 해외주식 상단 메뉴 선택
 -- 02. 화면설명 : 해외주식 상단 메뉴 선택 팝업
 -- 03. 이    력 : 
 -- - 2025.09.16 YSH v0001 : 신규개발
 ---------------------------------------------------------------------------------------------
 --****************************************************************************
 --               G  L  O  B  A  L       V  A  R  I  A  B  L  E
 --****************************************************************************

 --****************************************************************************
 --            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N             	
 --****************************************************************************
function UpdateTitle(sScreenNo)
	local sTitle
	
	if sScreenNo == "16070" then --잔고 end end
		sTitle = cont0.lblMenu0.caption
	elseif sScreenNo == "16072" then --손익
		sTitle = cont0.lblMenu1.caption
	elseif sScreenNo == "16071" then --예수금
		sTitle = cont0.lblMenu2.caption
	elseif sScreenNo == "16079" then --평균단가 변경
		sTitle = cont0.lblMenu3.caption
	end
	
	cont0.lblTitle.caption = sTitle
end

function HighlightMenu(sScreenNo)
	if sScreenNo == "16070" then --잔고 end end
		cont0.lblMenu0.fgColor = "144"
		cont0.lblMenu0.bgColor = "66"
		cont0.lblMenu0.transmode = "0"
	elseif sScreenNo == "16072" then --손익
		cont0.lblMenu1.fgColor = "144"
		cont0.lblMenu1.bgColor = "66"
		cont0.lblMenu1.transmode = "0"
	elseif sScreenNo == "16071" then --예수금
		cont0.lblMenu2.fgColor = "144"
		cont0.lblMenu2.bgColor = "66"
		cont0.lblMenu2.transmode = "0"
	elseif sScreenNo == "16079" then --평균단가 변경
		cont0.lblMenu3.fgColor = "144"
		cont0.lblMenu3.bgColor = "66"
		cont0.lblMenu3.transmode = "0"
	end
end

 --****************************************************************************
 --               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
 --****************************************************************************
 --============================================================================
 -- Form_OnFormInitBefore
 --============================================================================
function Form_OnFormInitBefore()
	cont0.imgTitleArrow.Setmaintainingratio("2")
end

 --============================================================================
 -- Form_OnFormInit
 --============================================================================
function Form_OnFormInit()
	local sOpenData
	sOpenData = Form.GetOpenLinkData()
	if sOpenData ~= "" then
		UpdateTitle(sOpenData)
		HighlightMenu(sOpenData)
	end
end

 --============================================================================
 -- cont0_LabelTop_OnClick()
 --============================================================================
function cont0_LabelTop_OnClick()
	Form.SendReturnToParent("nrsbonl16072_p2", "cancel")
	Form.CloseForm()
end

 --============================================================================
 -- imgDim_OnClick
 --============================================================================
function imgDim_OnClick()
	Form.SendReturnToParent("nrsbonl16072_p2", "cancel")
	Form.CloseForm()
end


 --============================================================================
 -- cont0_lblMenu0_OnClick
 --============================================================================
function cont0_lblMenu0_OnClick()
	Form.OpenScreen("16070", "")	 --잔고
	Form.CloseForm()
end

 --============================================================================
 -- cont0_lblMenu1_OnClick
 --============================================================================
function cont0_lblMenu1_OnClick()
	Form.OpenScreen("16072", "")	 --손익
	Form.CloseForm()
end

 --============================================================================
 -- cont0_lblMenu2_OnClick
 --============================================================================
function cont0_lblMenu2_OnClick()
	Form.OpenScreen("16071", "")	 --예수금
	Form.CloseForm()
end

 --============================================================================
 -- cont0_lblMenu3_OnClick
 --============================================================================
function cont0_lblMenu3_OnClick()
	Form.OpenScreen("16079", "")	 --평균단가 변경
	Form.CloseForm()
end

	
</SCRIPT_INFO>
</ROOT>