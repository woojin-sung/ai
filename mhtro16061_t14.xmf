function Form_OnFormInitBefore()
	imgSearch.Setmaintainingratio("1")
	imgNodata.Setmaintainingratio("1")
	imgDownArrow.SetMaintainingRatio("1")  --v0002
end

 --============================================================================
function Form_OnFormInit()
	 --20200910 SWJ START
	 --MTS메모리평문 적용유무
	 --plain_rm = ( 0 : 미적용/ 1 : 적용)
	 plain_rm = Form.GetSharedData("..PLAIN_RM", false)
	 --20200910 SWJ END
	
	 --============================================================================
	 --v0002
	g_rsltCls 		= Form.GetSharedData("..mhtro16061_t14_RSLT_CLS", false)
	g_selnByovClcd 	= Form.GetSharedData("..mhtro16061_t14_SELN_BYOV_CLCD", false)
	g_mangDate 		= Form.GetSharedData("..mhtro16061_t13_mang_date", false)
	
	if g_mangDate ~= "" then
		cld0.caption = g_mangDate
	end
	
	if g_rsltCls == "" then
		g_rsltCls = "%"
	end
	
	if g_selnByovClcd == "" then
		g_selnByovClcd = "0"
	end
	
	setLabelFilterCaption()
	 --============================================================================
	
	btnSearch_OnClick()
end

