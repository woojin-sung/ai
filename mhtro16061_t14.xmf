end

 --============================================================================
function Form_OnTriggerEvent(sEventName, sParam)
	if sEventName == "InitCode" or sEventName == "ChangeCode" or sEventName == "ChangeTab" then
		btnSearch_OnClick()
	 --20160502 LKM START
	elseif sEventName == "ChangeAcnt" then
		
		grd0.rowcount = 0	 --기존내역 Clear
			
		if Check_Accout() == False then
			return
		end
		
		btnSearch_OnClick()
	 --20160502 LKM END
	end
	
end

 --============================================================================
function DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID == "obtro_oder_240r" then
		DATAMANAGER.SetDataValue( 0, "obtro_oder_240r", "InBlock1", "ACNO" 		, 0 , Form.GetTopCtlProp("acnt", "total"))		 -- 계좌번호(8)
		DATAMANAGER.SetDataValue( 0, "obtro_oder_240r", "InBlock1", "ASNO" 		, 0 , Form.GetTopCtlProp("acnt", "sequence"))		 -- 계좌일련번호(2)
		
		 --20200910 SWJ START
		 --MTS메모리평문제거 적용상태일 때
		if plain_rm == "1" then
			DATAMANAGER.SetDataValue( 0, "obtro_oder_240r", "InBlock1", "ACNT_PWD" 	, 0 , Form.GetTopCtlProp("edtPwd", "caption"))	 -- 계좌비밀번호
		 --MTS메모리평문제거 미적용상태일 때
		else
			DATAMANAGER.SetDataValue( 0, "obtro_oder_240r", "InBlock1", "ACNT_PWD" 	, 0 , Form.GetTopCtlProp("edtPwd", "encdata"))	 -- 계좌비밀번호
		end
		 --20200910 SWJ END
		
		DATAMANAGER.SetDataValue( 0, "obtro_oder_240r", "InBlock1", "RSEV_STA_DATE"	, 0 , cld0.caption)		 -- 예약시작일자
		DATAMANAGER.SetDataValue( 0, "obtro_oder_240r", "InBlock1", "RSEV_FIN_DATE"	, 0 , cld0.caption)		 -- 예약종료일자
		DATAMANAGER.SetDataValue( 0, "obtro_oder_240r", "InBlock1", "OVRS_STCK_MRKT_TR_CLS_CODE"	, 0 , "00")	 -- 해외시장구분코드
		
		 --v0002
		DATAMANAGER.SetDataValue( 0, "obtro_oder_240r", "InBlock1", "RSLT_CLS"		, 0 , g_rsltCls)			 -- 결과구분
		DATAMANAGER.SetDataValue( 0, "obtro_oder_240r", "InBlock1", "SELN_BYOV_CLCD"	, 0 , g_selnByovClcd)		 -- 해도매수구분코드
	end
end

 --============================================================================
function DATAMANAGER_OnReceiveTranComplete(szTranID)

	if szTranID == "obtro_oder_240r" then
		if gf_Tonumber(grd0.rowcount) == 0 then
			imgNodata.visible = true
			lblNodata.visible = true
		else
			imgNodata.visible = false
			lblNodata.visible = false
		end
		
		 --------------------------------------------------------------
		 -- 종목명 최대라인수 설정
		 --------------------------------------------------------------
		grd0.SetCellMaxLineCount("bd_cell25",2)
		grd0.SetCellMaxLineCount("bd_cell16",2)	 --거부사유
		
		for i = 0, grd0.rowcount -1 do
			szMkCd	 = grd0.GetCellData("bd_cell17", i)
			szType  	 = grd0.GetCellData("bd_cell8", i)
			szOdrStat = grd0.GetCellData("bd_cell18", i)
 --			szDecimal = grd0.GetCellData("bd_cell7", i)
			rSevType  = grd0.GetCellData( "bd_cell0"	, i)	 --주문예약구분코드     - 2019.10.14
			hOurType  = grd0.GetCellData( "bd_cell9", i)	 --주문예약시간구분코드 - 2019.10.14

 --			szOdrPrc = grd0.GetCellData("bd_cell15", i)
 --			szOdrPrc2 = Set_Unit(gf_Tonumber(szOdrPrc), szDecimal)
 --			grd0.SetCellData("bd_cell15", i, szOdrPrc2)

			
			 --20201124 LES START 해외주식 시장가매도
			szOrdType = grd0.GetCellData("bd_cell22", i)
			
				if szOrdType == "1" then
					grd0.SetCellData("bd_cell26", i, "지정가")
				elseif szOrdType == "2" then
					grd0.SetCellData("bd_cell26", i, "시장가")
				elseif szOrdType == "4" then
					grd0.SetCellData("bd_cell26", i, "LOO")
				elseif szOrdType == "5" then
					grd0.SetCellData("bd_cell26", i, "LOC")
				elseif szOrdType == "6" then
					grd0.SetCellData("bd_cell26", i, "MOO")
				elseif szOrdType == "7" then
					grd0.SetCellData("bd_cell26", i, "MOC")
				elseif szOrdType == "8" then
					grd0.SetCellData("bd_cell26", i, "Limit VWAP")
				elseif szOrdType == "9" then
					grd0.SetCellData("bd_cell26", i, "Limit TWAP")
				elseif szOrdType == "A" then
					grd0.SetCellData("bd_cell26", i, "VWAP")
				elseif szOrdType == "B" then
					grd0.SetCellData("bd_cell26", i, "TWAP")
			end
			
			 --20201124 LES END


			 --주문예약구분코드 - 2019.10.14
				if rSevType == "1" then
					grd0.SetCellData( "bd_cell0", i, "일반예약")
				elseif rSevType == "2" then
					grd0.SetCellData( "bd_cell0", i, "기간잔량")
				elseif rSevType == "3" then
					grd0.SetCellData( "bd_cell0", i, "기간예약")
				elseif rSevType == "4" then
					grd0.SetCellData( "bd_cell0", i, "특정일주문")
			end
			
			 --주문예약시간구분코드 - 2019.10.14
				if hOurType == "0" then
					grd0.SetCellData( "bd_cell9", i, "장개시")
				elseif hOurType == "1" then
					grd0.SetCellData( "bd_cell9", i, "장마감10분전")
				elseif hOurType == "2" then
					grd0.SetCellData( "bd_cell9", i, "장마감30분전")
				
				 --20200911 LES START 예약시간 추가
				elseif hOurType == "3" then
					grd0.SetCellData( "bd_cell9", i, "장개시30분후")
				 --20200911 LES END
				
			end


			 --매매구분
				if szType == "1" then
					grd0.SetCellFgColor( "bd_cell2", i, "2" )
					grd0.SetCellFgColor( "bd_cell142", i, "2" )
					
					 --v0002 --------------------------- 예탁담보매도 -> 매도로 표시
					grd0.SetCellData( "bd_cell2", i, "매도")
					grd0.SetCellData( "bd_cell142", i, "매도")
					
					 --20201021 LES START 해외주식 매도상환
 --					szGubun = grd0.GetCellData("bd_cell19", i)
 --					if szGubun == "0251" then
 --						grd0.SetCellData( "bd_cell2", i, "예탁담보매도")
 --						grd0.SetCellData( "bd_cell142", i, "예탁담보매도")
 --					else
 --						grd0.SetCellData( "bd_cell2", i, "매도")
 --						grd0.SetCellData( "bd_cell142", i, "매도")
 --					end if
					 --20201021 LES END
					 --v0002 -----------------------------
					
				elseif szType == "2" then
					grd0.SetCellFgColor( "bd_cell2", i, "1" )
					grd0.SetCellFgColor( "bd_cell142", i, "1" )
					grd0.SetCellData( "bd_cell2", i, "매수")
					grd0.SetCellData( "bd_cell142", i, "매수")
			end
			
			 --2024 HSZ START
			 -- 매매구분 추가
			szLoanDate = grd0.GetCellData("bd_cell11", i)
			if gf_Trim(szLoanDate) == "" then
				grd0.SetCellData( "bd_cell14", i, "현금")
				grd0.SetCellData( "bd_cell140", i, "현금")
			else
				grd0.SetCellData( "bd_cell14", i, "대출")
				grd0.SetCellData( "bd_cell140", i, "대출")
			end

			 --------------------------------------------------------------
			 --시장구분
			 --------------------------------------------------------------
			sCountryCode = grd0.GetCellData("bd_mrktcode", i)
			sVndrCode = grd0.GetCellData("bd_vndrcode", i)
			sCountryName = GetCountryNameByCode(sCountryCode,sVndrCode)
			grd0.SetCellData("bd_marketgubun", i, sCountryName)
			
			 -- 주문상태
			if szOdrStat == "0" then
				grd0.SetCellData("bd_cell6", i, "주문대기")
			elseif szOdrStat == "1" then
				grd0.SetCellData("bd_cell6", i, "정상")
			elseif szOdrStat == "2" then
				grd0.SetCellData("bd_cell6", i, "거부")
			end
		end
	end
end

 --============================================================================
function btnSearch_OnClick()
	
	if Check_Accout() == False then
		return
	end
	
	grd0.SetClear()
	grd0.rowcount = 0
	
	DATAMANAGER.RequestTranData( "obtro_oder_240r" )
	
end

