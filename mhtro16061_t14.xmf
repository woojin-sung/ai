 --============================================================================
 --	계좌번호/비밀번호 확인
 --	내역조회는 비밀번호 없이 조회가능하도록 수정함. 	20160502 LKM 
 --	주문올릴때만 비밀번호 확인하도록 로직 수정
 --============================================================================
function Check_Accout()

 --20160502 LKM START

	local szAcctNo
	
	szAcctNo = Form.GetTopCtlProp("acnt", "caption")
    
    if string.string.len(gf_Trim(szAcctNo)) < 10 then
	    Form.ShowAlert( g_szTitle, "계좌번호를 확인후 다시 입력하십시오." )
	    return False
	end

	return True
	
end

 --============================================================================
 -- 국가코드 => 국가명 가져오기
 --============================================================================
function GetCountryNameByCode(sCountryCode,sVndrCode)
	if sCountryCode == "01" then
		return "미국"
	elseif sCountryCode == "02" then
		return "홍콩"
	elseif sCountryCode == "03" then
 --		return "상해"
		return "중국"
	elseif sCountryCode == "04" then
 --		return "심천"
		return "중국"
	elseif sCountryCode == "05" then
		return "일본"
	elseif sCountryCode == "06" then
		return "호주"
	elseif sCountryCode == "07" then
		return "싱가폴"
	elseif sCountryCode == "08" then
		return "영국"
	elseif sCountryCode == "09" then
		return "영국"
	elseif sCountryCode == "10" then
		return "독일"
	elseif sCountryCode == "11" then
		return "핀란드"
	elseif sCountryCode == "12" then
		return "프랑스"
	elseif sCountryCode == "13" then
		return "벨기에"
	elseif sCountryCode == "14" then
		return "네덜란드"
	elseif sCountryCode == "15" then
		return "포르투갈"
	elseif sCountryCode == "16" then
		return "그리스"
	elseif sCountryCode == "17" then
		return "아일랜드"
	elseif sCountryCode == "18" then
		return "이탈리아"
	elseif sCountryCode == "19" then
		return "스페인"
	elseif sCountryCode == "20" then
		return "오스트리아"
	elseif sCountryCode == "21" then
		return "캐나다"
	elseif sCountryCode == "23" then
		return "인도네시아"
	elseif sCountryCode == "24" then
		
		if sVndrCode == "XSTC" then
			return "호치민"
		elseif sVndrCode == "HSTC" then
			return "하노이"
		end
	
	elseif sCountryCode == "26" then
		return "스위스"
		
	else
		return ""
	end

end

 --============================================================================
 -- Set_Unit
 --============================================================================
function Set_Unit(szData, sDecimal)
	
	sztemp = gf_Tostring(szData)
	szChk = string.find(sztemp, ".")
	sDecimal = gf_Tostring(gf_Tonumber(sDecimal))
	
	if gf_Tostring(szChk) == "0" then
		if sDecimal == "1" then
			sztemp = sztemp .. ".0"	
		elseif sDecimal == "2" then
			sztemp = sztemp .. ".00"	
		elseif sDecimal == "3" then
			sztemp = sztemp .. ".000"	
		elseif sDecimal == "4" then
			sztemp = sztemp .. ".0000"	
		end
	else
		szCha = gf_Tonumber(string.string.len(sztemp) - szChk)
	
	
		if gf_Tostring(szCha) == "1" then
			if sDecimal == "2" then
				sztemp = sztemp .. "0"	
			elseif sDecimal == "3" then
				sztemp = sztemp .. "00"	
			elseif sDecimal == "4" then
				sztemp = sztemp .. "000"
			else
				sztemp = sztemp
			end
		elseif gf_Tostring(szCha) == "2" then
			if sDecimal == "3" then
				sztemp = sztemp .. "0"	
			elseif sDecimal == "4" then
				sztemp = sztemp .. "00"
			else
				sztemp = sztemp
			end
		elseif gf_Tostring(szCha) == "3" then
			if sDecimal == "4" then
				sztemp = sztemp .. "0"
			else
				sztemp = sztemp
			end
		else
			sztemp = sztemp
		end
	end
	
	return sztemp
end

