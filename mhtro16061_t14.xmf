 --****************************************************************************
local g_szTitle
g_szTitle = "알림"

 -- 20200910 SWJ START : 메모리평문제거 적용구분값
local plain_rm
plain_rm = ""

 --v0002
local g_rsltCls -- 결과구분 			%:전체 1:정상 2:거부
local g_selnByovClcd -- 해도매수구분코드	0:전체 1:매도 2:매수
