function btnMove_OnClick()
	Form.OpenScreen("16074" , "")
end

 --============================================================================  --v0002
function LabelFilter_OnClick()
	Form.OpenPopupAnimation("mhtro16061_p9", g_rsltCls .. "★" .. g_selnByovClcd, "", "2")
end

 --============================================================================  --v0002
function ButtonFilter_OnClick()
	LabelFilter_OnClick()
end

 --============================================================================  --v0002
function Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName == "mhtro16061_p9" then
		arrData = gf_Split(sRet,"★")
		
		g_rsltCls = arrData[0+1]
		g_selnByovClcd = arrData[1+1]
		
		Form.SetSharedData("..mhtro16061_t14_RSLT_CLS", g_rsltCls)
		Form.SetSharedData("..mhtro16061_t14_SELN_BYOV_CLCD", g_selnByovClcd)
		
		setLabelFilterCaption()
		btnSearch_OnClick()
	end
end

 --============================================================================  --v0002
function setLabelFilterCaption()
	local s_rsltCls, s_selnByovClcd
	
		if g_rsltCls == "%" then
			s_rsltCls = "전체"
		elseif g_rsltCls == "1" then
			s_rsltCls = "정상"
		elseif g_rsltCls == "2" then
			s_rsltCls = "거부"
	end
	
		if g_selnByovClcd == "0" then
			s_selnByovClcd = "매수매도"
		elseif g_selnByovClcd == "1" then
			s_selnByovClcd = "매도"
		elseif g_selnByovClcd == "2" then
			s_selnByovClcd = "매수"
	end
	
	LabelFilter.caption = s_rsltCls .. "·" .. s_selnByovClcd
	
end

 --============================================================================  --v0002
function cld0_OnEditComplete()
	btnSearch_OnClick()
end
	
