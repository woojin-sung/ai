-- ****************************************************************************
--                G  L  O  B  A  L       V  A  R  I  A  B  L  E
-- ****************************************************************************
local g_sLinkData
local orderConditionId
local registrationDate
local accountNumber
local accountSeqNumber
local stockExchangeCode
local stockCode
local stockKoreaName
local tradeType
local watchConditionType
local watchConditionTypeNm
local watchType
local watchTypeNm
local price
local orderPaymentType
local orderClsType
local orderClsTypeNm
local orderPriceType
local tickValue
local orderPrice
local orderQty
local expirationDate
local conditionStatusCode
local conditionStatusName
local g_sStep
-- 공통 에러 문구(REST API 용)
local g_sCommonErrorMsg
g_sCommonErrorMsg = "현재 자동감시주문 실행이\n불가합니다.\n고객지원센터에 문의해주세요."
-- ****************************************************************************
--             P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N              
-- ****************************************************************************
-- ===============================================
-- nil 체크 
-- ===============================================
function isEmpty(sData)
	if gf_Trim(sData) == "" or sData == nil or gf_Trim(sData) == "nil" then
		return true
	else
		return false
	end
end
-- ===============================================
-- 숫자 소수점 절사 함수
-- ===============================================
function truncateToDecimalPlaces(nVal, nDeimalPlaces)
	nVal = gf_Tonumber(nVal)
	nFactor = 10 ^ nDeimalPlaces
	szNumStr = gf_CommaValue(nVal*nFactor,12,0,0,0,1)
	nDecimalIdx = string.find(szNumStr, "%.")
	nTotalData = 0
	if gf_Tonumber(nDecimalIdx) > 0 then
		nTotalData = gf_Tonumber(string.sub(szNumStr, 1, gf_Tonumber(nDecimalIdx)-1))
	else
		nTotalData = gf_Tonumber(szNumStr)
	end
	return nTotalData / nFactor
end
-- ===============================================
-- (NonNull) 문자열 -> 배열 변환함수
-- ===============================================
function Convert_StrToArr(szData, szSeperator)
	local arrData
	-- --------------------------------------------
	-- 링크데이터 값 체크
	-- --------------------------------------------
	if isEmpty(szData) then
		arrData = {}
		return arrData
	end
	-- --------------------------------------------
	-- 구분자 값 체크
	-- --------------------------------------------
	if isEmpty(szSeperator) then
		-- 단일변수
		arrData = {}
		table.Insert(arrData, szData)
	else
		-- 다중변수
		arrData = gf_Split(szData, szSeperator)
	end
	return arrData
end
-- ==============================================
-- 거래소 구분코드 변경(3자리 -> 2자리)
-- 원장조회 종목연동 시, 과거 거래소 코드로 연동되는 경우 예외처리를 위해 필요
-- ==============================================
function Transform_Exid2(sValue)
	if sValue == "HKS" then
		return "HK"
	elseif sValue == "SHS" then
		return "SH"
	elseif sValue == "SZS" then
		return "SZ"
	elseif sValue == "NYS" then
		return "NY"
	elseif sValue == "AMX" then
		return "AX"
	elseif sValue == "NAS" then
		return "OQ"
	elseif sValue == "TSE" then
		return "JP"
	else
		return sValue
	end
end
function Get_Currency(sValue)
	if sValue == "OQ" or  sValue == "NY" or sValue == "AX" then
		return "USD"
	elseif sValue == "HK" then
		return "HKD"
	elseif sValue == "SH" or  sValue == "SZ" then
		return "CNY"
	elseif sValue == "JP" then
		return "JPY"
	else
		return "USD"
	end
end
function FormatNumber_Currency(sExchCd, sValue)
	if sExchCd == "OQ" or  sExchCd == "NY" or sExchCd == "AX" then
		return gf_CommaValue(sValue, 4) .. " USD"
	elseif sExchCd == "HK" then
		return gf_CommaValue(sValue, 3) .. " HKD"
	elseif sExchCd == "SH" or  sExchCd == "SZ" then
		return gf_CommaValue(sValue, 3) .. " CNY"
	elseif sExchCd == "JP" then
		return gf_CommaValue(sValue, 2) .. " JPY"
	elseif sExchCd == "%" then
		return gf_CommaValue(sValue, 2) .. " %"
	else
		return gf_CommaValue(sValue, 4) .. " USD"
	end
end
function Init_Control()
end
function DisplaySet_CondInfo()
	sOrdPrc = FormatNumber_Currency(Transform_Exid2(stockExchangeCode), orderPrice)
	tblBuyInfo.SetCellString(0, 1, stockCode)
	lblItemName.maxlinecnt = 2
	lblItemName.caption = stockKoreaName
	--	tblBuyInfo.SetCellString(1, 1, stockKoreaName)
	tblBuyInfo.SetCellString(2, 1, "")
	tblBuyInfo.SetCellString(3, 1, watchConditionTypeNm)
	sPrc = ""
	if watchConditionType == "06" then
		sPrc = FormatNumber_Currency("%", price)
	else
		sPrc = FormatNumber_Currency(Transform_Exid2(stockExchangeCode), price)
	end
	tblBuyInfo.SetCellString(4, 1, sPrc .. " " .. watchTypeNm)
	tblBuyInfo.SetCellString(5, 1, "")
	tblBuyInfo.SetCellString(6, 1, orderClsTypeNm)
	if orderClsType == "05" or orderClsType == "34" then
		tblBuyInfo.SetCellString(7, 1, "-")
	else
		if orderPriceType == "09" then
			sOrdPrc = FormatNumber_Currency(Transform_Exid2(stockExchangeCode), orderPrice)
			tblBuyInfo.SetCellString(7, 1, sOrdPrc)
		elseif orderPriceType == "01" then
			if gf_Tonumber(tickValue) > 0 then
				tblBuyInfo.SetCellString(7, 1,"현재가" .. " +" .. tickValue.."틱")
			elseif gf_Tonumber(tickValue) < 0 then
				tblBuyInfo.SetCellString(7, 1,"현재가" .. " " .. tickValue.."틱")
			elseif gf_Tonumber(tickValue) == 0 then
				tblBuyInfo.SetCellString(7, 1,"현재가")
			end
		elseif orderPriceType == "02" then
			tblBuyInfo.SetCellString(7, 1,"시가")
		elseif orderPriceType == "03" then
			tblBuyInfo.SetCellString(7, 1,"고가")
		elseif orderPriceType == "04" then
			tblBuyInfo.SetCellString(7, 1,"저가")
		end
	end
	tblBuyInfo.SetCellString(8, 1, gf_CommaValue(orderQty, 0) .. " 주")
	sDate1 = string.gsub(registrationDate, "-", "")
	sDate = string.gsub(expirationDate, "-", "")
	tblBuyInfo.SetCellString(9, 1, string.sub(sDate1,3,4) .. "." .. string.sub(sDate1,5,6) .. "." .. string.sub(sDate1,7,8) .. " ~ " .. string.sub(sDate,3,4) .. "." .. string.sub(sDate,5,6) .. "." .. string.sub(sDate,7,8))
	lblData1.caption = conditionStatusName
	if conditionStatusCode == "02" then
		lblData1.fgcolor = 290
		Image3.imgpath = "icon_watch_play"
	else
		lblData1.fgcolor = 4
		Image3.imgpath = "icon_watch_pause"
	end
end
function AutoRule_Delete()
	--	btnBlock.left = 0
	g_sStep = "DELETE"
	Form.ReleaseRequestData()
	Form.MakeRequestData("orderConditionId", orderConditionId)
	Form.MakeRequestData("conditionStatusCode", "99")
	sDev = Form.GetSharedData("..SERVER_MODE", false)
	sUrl = ""
	if sDev == "1" then -- 개발기 end
		sUrl = "https://dev-api-gateway.imeritz.com:8443/"
	else
		sUrl = "https://api-gateway.imeritz.com:8443/"
	end
	Form.RequestRestAPI(sUrl.."api/v1/rule/update-status", "")
end
function AutoRule_UpdateStatus()
	--	btnBlock.left = 0
	g_sStep = "UPDATE_STATUS"
	Form.ReleaseRequestData()
	Form.MakeRequestData("orderConditionId", orderConditionId)
	sStatus = conditionStatusCode
	if conditionStatusCode == "01" then
		sStatus = "02" 
	elseif conditionStatusCode == "02" then
		sStatus = "01" 
	end
	Form.MakeRequestData("conditionStatusCode", sStatus)
	sDev = Form.GetSharedData("..SERVER_MODE", false)
	sUrl = ""
	if sDev == "1" then -- 개발기 end
		sUrl = "https://dev-api-gateway.imeritz.com:8443/"
	else
		sUrl = "https://api-gateway.imeritz.com:8443/"
	end
	Form.RequestRestAPI(sUrl.."api/v1/rule/update-status", "")
end
-- ****************************************************************************
--                C  O  M  M  O  N       F  U  N  C  T  I  O  N               
-- ****************************************************************************
-- =============================================================================
function Form_OnFormInit()
	g_sLinkData = Form.GetOpenLinkData()
	arrLinkData = Convert_StrToArr(g_sLinkData, "`")
	nArrCnt = #arrLinkData
	if nArrCnt >= 23 then
		orderConditionId	= arrLinkData[1+1]
		registrationDate	= arrLinkData[2+1]
		accountNumber		= arrLinkData[3+1]
		accountSeqNumber	= arrLinkData[4+1]
		stockExchangeCode	= arrLinkData[5+1]
		stockCode			= arrLinkData[6+1]
		stockKoreaName		= arrLinkData[7+1]
		tradeType			= arrLinkData[8+1]
		watchConditionType	= arrLinkData[9+1]
		watchConditionTypeNm	= arrLinkData[10+1]
		watchType			= arrLinkData[11+1]
		watchTypeNm		= arrLinkData[12+1]
		price			= arrLinkData[13+1]
		orderPaymentType	= arrLinkData[14+1]
		orderClsType		= arrLinkData[15+1]
		orderClsTypeNm		= arrLinkData[16+1]
		orderPriceType		= arrLinkData[17+1]
		tickValue			= arrLinkData[18+1]
		orderPrice			= arrLinkData[19+1]
		orderQty			= arrLinkData[20+1]
		expirationDate		= arrLinkData[21+1]
		conditionStatusCode	= arrLinkData[22+1]
		conditionStatusName	= arrLinkData[23+1]
		DisplaySet_CondInfo()
		return
	end
	Form.CloseForm()
end
