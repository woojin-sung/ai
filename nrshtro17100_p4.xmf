-- =============================================================================
function Form_OnMsgBoxClose(sKeyName, sRet)
	if sKeyName == "DELETE" then
		if sRet == "ok" then
			AutoRule_Delete() 
		end
	end
end
-- =============================================================================
-- Form_OnDelayEvent(1회 실행)
-- =============================================================================
function Form_OnDelayEvent(nID)
	if gf_Tonumber(nID) == 1 then
		btnBlock.left = 1000
	end
end
-- =============================================================================
function Form_OnTriggerEvent(sEventName, sParam)
	if sEventName ==  "RESTAPI_RETURN" then
		btnBlock.left = 0
		-- ----------------------------------
		-- 조건 단건 삭제
		-- ----------------------------------
		if g_sStep == "DELETE" then
			-- ----------------------------------------
			-- 성공
			-- ----------------------------------------
			if sParam == "SUCCESS" then
				Form.SendReturnToParent("INFO_DELETE" , "")
				Form.CloseForm()
				-- ----------------------------------------
				-- 실패(ERROR or EXCEPTION)
				-- ----------------------------------------
			else
				oError = Form.ResponseRestAPI("JSONOBJ", 0, "error", "")
				if isEmpty(oError) == false then
					errorCode = Form.ResponseRestAPI("DATA", 0, "errorCode", oError)
					errorMessage = Form.ResponseRestAPI("DATA", 0, "errorMessage", oError)
					if errorCode == "UNMODIFIABLE_STATUS" then
						Form.ShowAlert("알림", "감시가 실행되어 수정이 불가해요.\n내역조회에서 확인해 주세요.")
						Form.SetDelayEvent(1, 0.2)
						return 
					elseif errorCode == "FORCED_STOP_STATUS" then
						Form.OpenPopup("nrshtro17100_p10", "", "")
						Form.SetDelayEvent(1, 0.2)
						return
					end
				end
				Form.ShowAlert("알림", g_sCommonErrorMsg)
				return 
			end
			-- ----------------------------------
			-- 조건 단건 감시여부 변경
			-- ----------------------------------
		elseif g_sStep == "UPDATE_STATUS" then
			-- ----------------------------------------
			-- 성공
			-- ----------------------------------------
			if sParam == "SUCCESS" then
				oData = Form.ResponseRestAPI("JSONOBJ", 0, "data", "")
				conditionStatusCode	= Form.ResponseRestAPI("DATA", 0, "conditionStatusCode", oData)
				conditionStatusName	= Form.ResponseRestAPI("DATA", 0, "conditionStatusName", oData)
				lblData1.caption = conditionStatusName
				if conditionStatusCode == "02" then
					lblData1.fgcolor = 290
					Image3.imgpath = "icon_watch_play"
				else
					lblData1.fgcolor = 4
					Image3.imgpath = "icon_watch_pause"
				end
				Form.SendReturnToParent("INFO_CHANGE" , "")
				-- ----------------------------------------
				-- 실패(ERROR or EXCEPTION)
				-- ----------------------------------------
			else
				oError = Form.ResponseRestAPI("JSONOBJ", 0, "error", "")
				if isEmpty(oError) == false then
					errorCode = Form.ResponseRestAPI("DATA", 0, "errorCode", oError)
					errorMessage = Form.ResponseRestAPI("DATA", 0, "errorMessage", oError)
					if errorCode == "UNMODIFIABLE_STATUS" then
						Form.ShowAlert("알림", "감시가 실행되어 수정이 불가해요.\n내역조회에서 확인해 주세요.")
						Form.SetDelayEvent(1, 0.2)
						return 
					elseif errorCode == "FORCED_STOP_STATUS" then
						Form.OpenPopup("nrshtro17100_p10", "", "")
						Form.SetDelayEvent(1, 0.2)
						return
					end
				end
				Form.ShowAlert("알림", g_sCommonErrorMsg)
				return 
			end
		end
		Form.SetDelayEvent(1, 0.2)
	end
end
