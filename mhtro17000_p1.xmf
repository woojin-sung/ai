 --===============================================
 -- 컨트롤 초기화
 --===============================================
function Init_Control()
	contMain.lblTitle.fgcolor = g_szTxtColor_Normal
	contMain.lblTitle.paddinginfo = "0,0,0,0"
	
	contMain.imgBack.maintainratio = "3"
	contMain.imgBack.imgpath = g_szBtnImg_Close
	
	contMain.contCont.lblContent.maxlinecnt = 400
	contMain.contCont.lblContent.paddinginfo = "0,0,0,0"
	
	contMain.SetEnableScroll(false)
	contMain.SetExceptInvisibleCtl(true)
	contMain.contCont.SetExceptInvisibleCtl(true)
	
	g_szText_HK = "HKEX INFORMATION SERVICES LIMITED, ITS HOLDING COMPANIES and/or ANY SUBSIDIARIES OF SUCH HOLDING COMPANIES ENDEAVOUR TO ENSURE THE ACCURACY and RELIABILITY OF THE INFORMATION PROVIDED BUT DO not GUARANTEE ITS ACCURACY or RELIABILITY and ACCEPT NO LIABILITY (WHETHER IN TORT or CONTRACT or OTHERWISE) FOR ANY LOSS or DAMAGE ARISING FROM ANY INACCURACIES or OMISSIONS\n\n홍콩 투자 정보 서비스 유한회사, 지주 회사 또는 지주 회사의 자회사는 제공되는 정보의 정확성과 확실성을 보장하기 위해 노력하지만 그 적합성과 정확성을 보장하지 않으며 부정확성 또는 누락으로 인해 발생하는 모든 손실 또는 손해에 대해 어떠한 법적 책임(불법 행위 또는 계약 여부에 관계 없이)을 지지 않습니다."
	g_szText_SH = "China Investment Information Services Limited, it's holding companies and/or any subsidiary of such holding companies and/or its third party content provider(s) endeavor to ensure the accuracy and reliability of the information provided but do not guarantee its suitability, availability, service level, timelines, accuracy or reliability and accept no liability (whether in tort or contract or otherwise) for any loss or damage arising from any interruption, defect, delay, inaccuracies or omissions.\n\n중국 투자 정보 서비스 유한회사, 지주 회사 또는 지주 회사의 자회사 또는 제 3 자 콘텐츠 제공 업체는 제공되는 정보의 정확성과 확실성을 보장하기 위해 노력하지만 그 적합성, 유효성, 서비스 수준, 일정, 정확성 또는 확실성을 보장하지 않으며, 중단, 장애, 지연, 부정확성 또는 누락으로 인해 발생하는 모든 손실 또는 손해에 대해 어떠한 법적 책임(불법 행위 또는 계약 여부에 관계 없이)을 지지 않습니다."
	g_szText_SZ = "Although Vendor will use all reasonable endeavors to ensure the accuracy and reliability of its service, neither Vendor nor SSIC will be liable for any loss or damage in connection with the provision of failure to provide the service.\n\n공급 업체는 서비스의 정확성과 신뢰성을 보장하기 위해 모든 합당한 노력을 기울일 것이지만, 공급 업체나 SSIC는 서비스 제공 실패로 인해 발생한 손실이나 손해에 대해 책임을 지지 않습니다."
	g_szText_OQ = "UTP Quotation Feed: provides best bid and offer(BBO) quotes from UTP participant as well as the consolidated national best bid and offer (NBBO) quotes for securities listed on the NASDAQ Stock Market.® UTP Trade Feed:provides trade data from the UTP participants for securities listed on the NASDAQ Stock Market®.\n\nUTP 시세 피드: UTP 참가자의 최고 매입가/최저 매도가 시세 (우선호가)를 제공하며, NASDAQ 주식 시장에 상장 된 증권에 대한 통합된 최우선 최고 매입가/최저 매도가(최우선호가)시세를 제공합니다.\nUTP 거래 피드 : 나스닥 주식 시장에 상장된 증권에 대한 UTP 참가자의 거래 데이터를 제공합니다."
	g_szText_NYAX = "CTA Tape A:Last Sale: provides trade data from the CTA participants for securities listed on the New York Stock Exchange\nCTA Tape A:Bid/Ask: provides best bid and offer (BBO) quotes from CTA participants as well as the consolidated national best bid and offer (NBBO) quotes for securities listed on the New York Stock Exchange.\nCTA Tape B:Last Sale: provides trade data from the CTA participants for securities listed on the NYSE American LLC. National best bid and offer (NBBO) quotes for securities listed on the NYSE American LLC.\n\nCTA Tape A : Last Sale : 뉴욕 증권 거래소에 상장 된 증권에 대한 CTA 참가자의 거래 데이터를 제공합니다.\nCTA Tape A : Bid / Ask : CTA 참가자의 BBO(Best bid and Offer) 시세와 뉴욕 증권 거래소에 상장 된 증권에 대한 통합 된 NBBO (National Best bid and Offer) 시세를 제공합니다.\nCTA Tape B : Last Sale : NYSE American LLC에 상장 된 증권에 대한 CTA 참가자의 거래 데이터를 제공합니다. NYSE American LLC에 상장 된 증권에 대한 NBBO (National Best bid and Offer) 시세를 제공합니다."
end

 --****************************************************************************
 --               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
