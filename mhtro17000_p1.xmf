 --===============================================
 -- Form_OnFormInitBefore
 --===============================================
function Form_OnFormInitBefore()
	contMain.contCont.lblContent.SizeAutoFit()
end

 --===============================================
 -- Form_OnFormInit
 --===============================================
function Form_OnFormInit()
	Init_Control()
	
	local szLinkData
	szLinkData = Form.GetOpenLinkData()
	
 --	if szLinkData = "" then
 --		Form.CloseForm()
 --		exit Sub
 --	end if
	arrLinkData = gf_Split(szLinkData, "★")
	
	contMain.lblTitle.maxlinecnt = "1"
	contMain.lblTitle.caption = "Disclaimer"
 --	contMain.lblTitle.setAutoScrollText(arrLinkData(0))

 --	contMain.lblTitle.setUseAutoScroll(true, 30, true)
	
	szText = ""
	-- SELECT CASE 변환 (수동 보정 필요)
		if szLinkData == "HK" then
			szText = g_szText_HK
		elseif szLinkData == "SH" then
			szText = g_szText_SH
		elseif szLinkData == "SZ" then
			szText = g_szText_SZ
		elseif szLinkData == "OQ" then
			szText = g_szText_OQ
		elseif szLinkData == "NY" or szLinkData == "AX" then
			szText = g_szText_NYAX
 --		Case Else
 --			Form.CloseForm()
	end
	
	contMain.contCont.lblContent.caption = szText
	contMain.contCont.lblContent.SizeAutoFit()
end

 --===============================================
 -- contMain_imgBack_OnClick
 --===============================================
function contMain_imgBack_OnClick()
	Form.CloseForm()
end

 --===============================================
 -- contMain_lblContent_OnSizeAutoFit
 --===============================================
function contMain_contCont_lblContent_OnSizeAutoFit()

	contMain.visible = true
	nHeight = contMain.contCont.lblContent.height
	
	szOsType = Form.GetSharedData("..OS_TYPE", false ) 
	
	if szOsType == "1" then
		nHeight = Form.CalcUnResize(nHeight, "1")
	end
	
	nResultHeight = nHeight + 67 + 32 + 60
	nResultHeight2 = nHeight + 32 

	if nResultHeight > 500 then
		nResultHeight = 500
		nResultHeight2 = 500 - 87 - 60
	end

	contMain.height = nResultHeight
	contMain.Image0.height = nResultHeight
	contMain.top =  647 -  nResultHeight
	contMain.Button0.top = nResultHeight - 60
	
	contMain.contCont.height = nResultHeight2
	contMain.contCont.SetScrollAutoSize()
end

 --===============================================
 -- imgBg_OnClick
 --===============================================
function imgBg_OnClick()
	Form.CloseForm()
end

 --============================================================================
function contMain_Button0_OnClick()
	Form.CloseForm()
end

	
