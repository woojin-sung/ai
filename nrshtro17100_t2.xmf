Function Set_Info(nIdx,orderConditionId,registrationDate,accountNumber,accountSeqNumber,stockExchangeCode,stockCode,stockKoreaName,tradeType,
				watchConditionType,watchConditionTypeNm,watchType,watchTypeNm,price,
				orderPaymentType,orderClsType,orderClsTypeNm,orderPriceType,tickValue,orderPrice,orderQty,expirationDate,
				conditionStatusCode,conditionStatusName)	
	
	cont0.pnl0.SetPropCardCell("caption", "orderConditionId",		nIdx, orderConditionId)
	cont0.pnl0.SetPropCardCell("caption", "registrationDate",		nIdx, registrationDate)
	cont0.pnl0.SetPropCardCell("caption", "accountNumber",		nIdx, accountNumber)
	cont0.pnl0.SetPropCardCell("caption", "accountSeqNumber", 		nIdx, accountSeqNumber)
	cont0.pnl0.SetPropCardCell("caption", "stockExchangeCode", 	nIdx, stockExchangeCode)
	cont0.pnl0.SetPropCardCell("caption", "stockCode", 			nIdx, stockCode)
	cont0.pnl0.SetPropCardCell("caption", "stockKoreaName", 		nIdx, stockKoreaName)
	cont0.pnl0.SetPropCardCell("caption", "tradeType", 			nIdx, tradeType)
	cont0.pnl0.SetPropCardCell("caption", "watchConditionType", 	nIdx, watchConditionType)
	cont0.pnl0.SetPropCardCell("caption", "watchConditionTypeNm", 	nIdx, watchConditionTypeNm)
	cont0.pnl0.SetPropCardCell("caption", "watchType", 			nIdx, watchType)
	cont0.pnl0.SetPropCardCell("caption", "watchTypeNm", 		nIdx, watchTypeNm)
	cont0.pnl0.SetPropCardCell("caption", "price", 				nIdx, price)
	cont0.pnl0.SetPropCardCell("caption", "orderPaymentType", 		nIdx, orderPaymentType)
	cont0.pnl0.SetPropCardCell("caption", "orderClsType", 		nIdx, orderClsType)
	cont0.pnl0.SetPropCardCell("caption", "orderClsTypeNm", 		nIdx, orderClsTypeNm)
	cont0.pnl0.SetPropCardCell("caption", "orderPriceType", 		nIdx, orderPriceType)
	cont0.pnl0.SetPropCardCell("caption", "tickValue", 			nIdx, tickValue)
	cont0.pnl0.SetPropCardCell("caption", "orderPrice", 			nIdx, orderPrice)
	cont0.pnl0.SetPropCardCell("caption", "orderQty", 			nIdx, orderQty)
	cont0.pnl0.SetPropCardCell("caption", "expirationDate", 		nIdx, expirationDate)
	cont0.pnl0.SetPropCardCell("caption", "conditionStatusCode", 	nIdx, conditionStatusCode)
	cont0.pnl0.SetPropCardCell("caption", "conditionStatusName", 	nIdx, conditionStatusName)

end

 --==============================================
 -- 거래소 구분코드 변경(3자리 -> 2자리)
 -- 원장조회 종목연동 시, 과거 거래소 코드로 연동되는 경우 예외처리를 위해 필요
 --==============================================
function Transform_Exid2(sValue)
	if sValue == "HKS" then
		return "HK"
	elseif sValue == "SHS" then
		return "SH"
	elseif sValue == "SZS" then
		return "SZ"
	elseif sValue == "NYS" then
		return "NY"
	elseif sValue == "AMX" then
		return "AX"
	elseif sValue == "NAS" then
		return "OQ"
	elseif sValue == "TSE" then
		return "JP"
	else
		return sValue
	end
end

Function DisplaySet_Pannel(nIdx, stockExchangeCode, stockKoreaName, stockCode, 
					watchConditionType, watchConditionTypeNm, price, watchTypeNm,
					orderPrice, orderQty,orderClsType, orderClsTypeNm, expirationDate,
					conditionStatusCode, conditionStatusName)
					
	sTicker = Form.GetEnvData("common.ticker_text")
	sExch = Transform_Exid2(stockExchangeCode)
	
	cont0.pnl0.SetPropCardCell("maxlinecnt"	,"lblItemInfo"	,nIdx	,"1^0" )
	cont0.pnl0.SetPropCardCell("paddinginfo"		,"lblItemInfo"	,nIdx	,"5,0,0,0" )
	
	if sExch == "AX" or sExch == "NY" or sExch == "OQ" then
		if sTicker == "1" then
			cont0.pnl0.SetPropCardCell("caption"		,"lblItemInfo"	,nIdx	,stockKoreaName )
		elseif sTicker == "2" then
			cont0.pnl0.SetPropCardCell("caption"		,"lblItemInfo"	,nIdx	,stockCode)
		else
			sName = stockKoreaName
			
			if Form.GetItemCodeInfo(sExch&"@"&stockCode, "etfyn") == "Y" then
				sName = stockCode
			end
			
			cont0.pnl0.SetPropCardCell("caption"		,"lblItemInfo"	,nIdx	,sName)
		end
	else
		cont0.pnl0.SetPropCardCell("caption"		,"lblItemInfo"	,nIdx	,stockKoreaName )
	end
	
	sData1 = ""
	if watchConditionType == "06" then
		sData1 = watchConditionTypeNm .. " " .. gf_CommaValue(price,2) ..  " " .. "%" ..  " " .. watchTypeNm
	else
		sData1 = watchConditionTypeNm .. " " .. gf_CommaValue(price,4) ..  " " .. "USD" ..  " " .. watchTypeNm
	end
	
	cont0.pnl0.SetPropCardCell("caption"		,"lblData0"	,nIdx	,sData1)
	
	if orderClsType == "05" or orderClsType == "34" then
		cont0.pnl0.SetPropCardCell("caption"		,"lblData2"	,nIdx	,"-")
	else
		if orderPriceType == "09" then
			cont0.pnl0.SetPropCardCell("caption"		,"lblData2"	,nIdx	,gf_CommaValue(orderPrice,4))
		elseif orderPriceType == "01" then
			if gf_Tonumber(tickValue) > 0 then
				cont0.pnl0.SetPropCardCell("caption"		,"lblData2"	,nIdx	,"현재가" .. " +" .. tickValue.."틱")
			elseif gf_Tonumber(tickValue) < 0 then
				cont0.pnl0.SetPropCardCell("caption"		,"lblData2"	,nIdx	,"현재가" .. " " .. tickValue.."틱")
			elseif gf_Tonumber(tickValue) == 0 then
				cont0.pnl0.SetPropCardCell("caption"		,"lblData2"	,nIdx	,"현재가")
			end
			
		elseif orderPriceType == "02" then
			cont0.pnl0.SetPropCardCell("caption"		,"lblData2"	,nIdx	,"시가")
		elseif orderPriceType == "03" then
			cont0.pnl0.SetPropCardCell("caption"		,"lblData2"	,nIdx	,"고가")
		elseif orderPriceType == "04" then
			cont0.pnl0.SetPropCardCell("caption"		,"lblData2"	,nIdx	,"저가")
		end
	end
	

	
	 --cont0.pnl0.SetPropCardCell("caption"		,"lblData2"	,nIdx	,orderPrice)
	cont0.pnl0.SetPropCardCell("caption"		,"lblData3"	,nIdx	,orderQty)
	cont0.pnl0.SetPropCardCell("caption"		,"lblData5"	,nIdx	,orderClsTypeNm)
	
	sData4 = string.gsub(expirationDate, string.gsub("-", "([%p])", "%%%1"), "")
	sDate = string.sub(sData4, 3, 3 + 2 - 1) .. "." .. string.sub(sData4, 5, 5 + 2 - 1) .. "." .. string.sub(sData4, -2)
	cont0.pnl0.SetPropCardCell("caption"		,"lblData6"	,nIdx	,sDate)
	cont0.pnl0.SetPropCardCell("caption"		,"lblData4"	,nIdx	,sDate.." 까지")
	cont0.pnl0.SetPropCardCell("maintainratio"		,"Image5"	,nIdx	,"1" )
	cont0.pnl0.SetPropCardCell("imgpath"		,"Image5"	,nIdx	,"icon_remove" )
	
	cont0.pnl0.SetPropCardCell("maintainratio"		,"Image3"	,nIdx	,"1" )
	
	if conditionStatusCode == "02" then
		cont0.pnl0.SetPropCardCell("imgpath"		,"Image3"	,nIdx	,"icon_watch_play" )
		cont0.pnl0.SetPropCardCell("fgcolor"		,"lblData1"	,nIdx	,"290")
	else
		cont0.pnl0.SetPropCardCell("imgpath"		,"Image3"	,nIdx	,"icon_watch_pause" )
		cont0.pnl0.SetPropCardCell("fgcolor"		,"lblData1"	,nIdx	,"4")
	end
	
	cont0.pnl0.SetPropCardCell("caption"		,"lblData1"	,nIdx	,conditionStatusName)
	
end
