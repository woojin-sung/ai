 --****************************************************************************
 --               G  L  O  B  A  L       V  A  R  I  A  B  L  E
 --****************************************************************************
 -- 실행중인 감시조건 카운트
local g_nRunCnt
g_nRunCnt = 0

 -- 내역조회 NEXT KEY
local g_sNextKey
g_sNextKey = ""

 -- 클릭한 리스트 인덱스
local g_nClickIdx
g_nClickIdx = 0

 -- 상세/요약 보기 모드
local g_nViewMode
g_nViewMode = 0

 -- 조건수정 여부 (조건설정 화면 오픈 시 링크데이터 변환)
local g_isModify
g_isModify = false

 -- 조건수정 데이터
local g_sModifyInfo

 -- 공통 에러 문구(REST API 용)
local g_sCommonErrorMsg
g_sCommonErrorMsg = "현재 자동감시주문 실행이\n불가합니다.\n고객지원센터에 문의해주세요."

local g_sStep
g_sStep = ""

local g_sStep_Prev
g_sStep_Prev = ""

local g_sAcno
g_sAcno = ""

local g_sAsno
g_sAsno = ""

local g_sPwd
g_sPwd = ""

local g_sAccName
g_sAccName = ""

local g_isClickable
g_isClickable = true


 --****************************************************************************
 --            P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N              
 --****************************************************************************
 --===============================================
 -- nil 체크 
 --===============================================
function isEmpty(sData)
	if gf_Trim(sData) == "" or sData == nil or gf_Trim(sData) == "nil" then
		return true
	else
		return false
	end
end

 --===============================================
 -- 숫자 소수점 절사 함수
 --===============================================
function truncateToDecimalPlaces(nVal, nDeimalPlaces)
	nVal = gf_Tonumber(nVal)
	nFactor = 10 ^ nDeimalPlaces
	szNumStr = gf_CommaValue(nVal*nFactor,12,0,0,0,1)
	nDecimalIdx = string.find(szNumStr, ".")
	
	nTotalData = 0
	if gf_Tonumber(nDecimalIdx) > 0 then
		nTotalData = gf_Tonumber(string.sub(szNumStr, 1, gf_Tonumber(nDecimalIdx)-1))
	else
		nTotalData = gf_Tonumber(szNumStr)
	end

	return nTotalData / nFactor
end

 --===============================================
 -- (NonNull) 문자열 -> 배열 변환함수
 --===============================================
function Convert_StrToArr(szData, szSeperator)

	local arrData
	
	 ----------------------------------------------
	 -- 링크데이터 값 체크
	 ----------------------------------------------
	if isEmpty(szData) then
		arrData = {}
		return arrData
	end
	
	 ----------------------------------------------
	 -- 구분자 값 체크
	 ----------------------------------------------
	if isEmpty(szSeperator) then
		 -- 단일변수
		arrData = {}
		Table.Insert(arrData, szData)
	else
		 -- 다중변수
		arrData = gf_Split(szData, szSeperator)
	end
	
	return arrData
	
end

 --===============================================
 -- 조회데이터 없는 경우 가이드문구 표시
 --===============================================
function DisplaySet_EmptyNotice(isShow)
	if isShow == true then
		imgNotice.visible = true
		LabelGuideText2.visible = true
		LabelGuideText1.visible = true
	else
		imgNotice.visible = false
		LabelGuideText2.visible = false
		LabelGuideText1.visible = false
	end
end

 --===============================================
 -- 상세/요약 접기
 --===============================================
function Expand_List()

	nCnt = cont0.pnl0.rowcount
	
	nHeight = 160
	if g_nViewMode == 1 then
		nHeight = 100
	end
	
	for i = 0, nCnt-1 do
		
		cont0.pnl0.SetCardWHAt(i,nHeight)
		cont0.pnl0.SetPropCardCell("height", "Image4", i , nHeight )
		
		if g_nViewMode == 1 then
			cont0.pnl0.SetPropCardCell("width", "lblItemInfo", i , 125 )
			
			cont0.pnl0.SetPropCardCell("visible", "lblTitle2", i , false )
			cont0.pnl0.SetPropCardCell("visible", "lblTitle3", i , false )
			cont0.pnl0.SetPropCardCell("visible", "lblTitle5", i , false )
			cont0.pnl0.SetPropCardCell("visible", "lblTitle6", i , false )
			cont0.pnl0.SetPropCardCell("visible", "lblData2", i , false )
			cont0.pnl0.SetPropCardCell("visible", "lblData3", i , false )
			cont0.pnl0.SetPropCardCell("visible", "lblData5", i , false )
			cont0.pnl0.SetPropCardCell("visible", "lblData6", i , false )
			
			cont0.pnl0.SetPropCardCell("visible", "lblData4", i , true )
			
		else
			cont0.pnl0.SetPropCardCell("width", "lblItemInfo", i , 215 )
			
			cont0.pnl0.SetPropCardCell("visible", "lblTitle2", i , true )
			cont0.pnl0.SetPropCardCell("visible", "lblTitle3", i , true )
			cont0.pnl0.SetPropCardCell("visible", "lblTitle5", i , true )
			cont0.pnl0.SetPropCardCell("visible", "lblTitle6", i , true )
			cont0.pnl0.SetPropCardCell("visible", "lblData2", i , true )
			cont0.pnl0.SetPropCardCell("visible", "lblData3", i , true )
			cont0.pnl0.SetPropCardCell("visible", "lblData5", i , true )
			cont0.pnl0.SetPropCardCell("visible", "lblData6", i , true )
			
			cont0.pnl0.SetPropCardCell("visible", "lblData4", i , false )
		end
	end

end

 --===============================================
 -- REST API_등록된 감시조건 갯수조회 (최대 50건)
 --===============================================
function AutoRule_SelectCount()
	g_sStep = "SELECT_COUNT"
	
	sAcno 	= g_sAcno  --Form.GetTopCtlProp("act0","total")
	sAsno 	= g_sAsno  --Form.GetTopCtlProp("act0","sequence")
	
	Form.ReleaseRequestData()
	
	Form.MakeRequestData("accountNumber", sAcno)
	Form.MakeRequestData("accountSeqNumber", sAsno)
	Form.MakeRequestData("tradeType", "2")			 -- 매도/매수 구분(1:매도, 2:매수)
	Form.MakeRequestData("dataTargetType", "2")		 -- 국내/해외 구분(1:국내, 2:해외)
	
	sDev = Form.GetSharedData("..SERVER_MODE", false)
	sUrl = ""
	if sDev == "1" then --개발기 end end
		sUrl = "https://dev-api-gateway.imeritz.com:8443/"
	else
		sUrl = "https://api-gateway.imeritz.com:8443/"
	end
		
	Form.RequestRestAPI(sUrl.."api/v1/rule/select-valid-count", "BUY_"..g_sStep)
end

 --===============================================
 -- REST API_등록된 감시조건 조회 (최대 50건)
 --===============================================
function AutoRule_SelectByAccount()
	g_sStep = "SELECT_BY_ACCOUNT"
	
	 -------------------------------
	 -- 조회내역 초기화
	 -------------------------------
	g_nRunCnt = 0
	cont0.pnl0.rowcount = 0
	cont0.lblInfo.caption = ""
	
	sAcno 	= g_sAcno  --Form.GetTopCtlProp("act0","total")
	sAsno 	= g_sAsno  --Form.GetTopCtlProp("act0","sequence")
	
	Form.ReleaseRequestData()
	
	Form.MakeRequestData("accountNumber", sAcno)
	Form.MakeRequestData("accountSeqNumber", sAsno)
	Form.MakeRequestData("tradeType", "2")			 -- 매도/매수 구분(1:매도, 2:매수)
	Form.MakeRequestData("dataTargetType", "2")		 -- 국내/해외 구분(1:국내, 2:해외)
	Form.MakeRequestData("pageInfo", "50")			 -- 조회 데이터 최대갯수
	
	sDev = Form.GetSharedData("..SERVER_MODE", false)
	sUrl = ""
	if sDev == "1" then --개발기 end end
		sUrl = "https://dev-api-gateway.imeritz.com:8443/"
	else
		sUrl = "https://api-gateway.imeritz.com:8443/"
	end
		
	Form.RequestRestAPI(sUrl.."api/v1/rule/select-by-account", "BUY_"..g_sStep)
end

 --===============================================
 -- REST API_등록된 감시조건 조회 (최대 50건)
 --===============================================
function AutoRule_SelectByAccount_Next()
	g_sStep = "SELECT_BY_ACCOUNT"
	
	sAcno 	= g_sAcno  --Form.GetTopCtlProp("act0","total")
	sAsno 	= g_sAsno  --Form.GetTopCtlProp("act0","sequence")
	
	Form.ReleaseRequestData()
	
	Form.MakeRequestData("accountNumber", sAcno)
	Form.MakeRequestData("accountSeqNumber", sAsno)
	Form.MakeRequestData("tradeType", "2")			 -- 매도/매수 구분(1:매도, 2:매수)
	Form.MakeRequestData("dataTargetType", "2")		 -- 국내/해외 구분(1:국내, 2:해외)
	Form.MakeRequestData("pageInfo", "50")			 -- 조회 데이터 최대갯수
	
	if isEmpty(g_sNextKey) == false then
		Form.MakeRequestData("nextOrderConditionId", g_sNextKey)
	end
	
	sDev = Form.GetSharedData("..SERVER_MODE", false)
	sUrl = ""
	if sDev == "1" then --개발기 end end
		sUrl = "https://dev-api-gateway.imeritz.com:8443/"
	else
		sUrl = "https://api-gateway.imeritz.com:8443/"
	end
		
	Form.RequestRestAPI(sUrl.."api/v1/rule/select-by-account", "BUY_"..g_sStep)
end

 --===============================================
 -- REST API_조건 단건 삭제
 --===============================================
function AutoRule_Delete(nIdx)
	g_sStep = "DELETE"
	
	Form.ReleaseRequestData()
	
	sCondID = cont0.pnl0.GetPropCardCell("caption"		,"orderConditionId"	,nIdx)
	Form.MakeRequestData("orderConditionId", sCondID)
	
	Form.MakeRequestData("conditionStatusCode", "99")	 -- 상태구분(01:감시중지, 02:감시중, 99:삭제)
	
	sDev = Form.GetSharedData("..SERVER_MODE", false)
	sUrl = ""
	if sDev == "1" then --개발기 end end
		sUrl = "https://dev-api-gateway.imeritz.com:8443/"
	else
		sUrl = "https://api-gateway.imeritz.com:8443/"
	end
		
	Form.RequestRestAPI(sUrl.."api/v1/rule/update-status", "BUY_"..g_sStep)
end

 --===============================================
 -- REST API_조건 전체 삭제
 --===============================================
function AutoRule_AllDelete()
	g_sStep = "ALL_DELETE"
	
	sAcno 	= g_sAcno  --Form.GetTopCtlProp("act0","total")
	sAsno 	= g_sAsno  --Form.GetTopCtlProp("act0","sequence")
	
	Form.ReleaseRequestData()
	
	Form.MakeRequestData("accountNumber", sAcno)
	Form.MakeRequestData("accountSeqNumber", sAsno)
	Form.MakeRequestData("tradeType", "2")			 -- 매도/매수 구분(1:매도, 2:매수)
	Form.MakeRequestData("conditionStatusCode", "99")	 -- 상태구분(01:감시중지, 02:감시중, 99:삭제)
		
	sDev = Form.GetSharedData("..SERVER_MODE", false)
	sUrl = ""
	if sDev == "1" then --개발기 end end
		sUrl = "https://dev-api-gateway.imeritz.com:8443/"
	else
		sUrl = "https://api-gateway.imeritz.com:8443/"
	end
		
	Form.RequestRestAPI(sUrl.."api/v1/rule/bulk-update-status", "BUY_"..g_sStep)
end


 --===============================================
 -- REST API_조건 단건 감시여부 업데이트
 --===============================================
function AutoRule_UpdateStatus(nIdx)
	g_sStep = "UPDATE_STATUS"
	
	Form.ReleaseRequestData()
	
	sCondID = cont0.pnl0.GetPropCardCell("caption"		,"orderConditionId"	,nIdx)
	sStatus = cont0.pnl0.GetPropCardCell("caption"		,"conditionStatusCode"	,nIdx)
	
	Form.MakeRequestData("orderConditionId", sCondID)
	
	if sStatus == "01" then
		sStatus = "02" 
	elseif sStatus == "02" then
		sStatus = "01" 
	end
	
	Form.MakeRequestData("conditionStatusCode", sStatus)	 -- 상태구분(01:감시중지, 02:감시중, 99:삭제)
	
	sDev = Form.GetSharedData("..SERVER_MODE", false)
	sUrl = ""
	if sDev == "1" then --개발기 end end
		sUrl = "https://dev-api-gateway.imeritz.com:8443/"
	else
		sUrl = "https://api-gateway.imeritz.com:8443/"
	end
		
	Form.RequestRestAPI(sUrl.."api/v1/rule/update-status", "BUY_"..g_sStep)
end

 --===============================================
 -- REST API_조건 전체실행
 --===============================================
function AutoRule_AllUpdateStatus()
	g_sStep = "ALL_UPDATE_STATUS"
	
	sAcno 	= g_sAcno  --Form.GetTopCtlProp("act0","total")
	sAsno 	= g_sAsno  --Form.GetTopCtlProp("act0","sequence")
	
	Form.ReleaseRequestData()
	
	Form.MakeRequestData("accountNumber", sAcno)
	Form.MakeRequestData("accountSeqNumber", sAsno)
	Form.MakeRequestData("tradeType", "2")			 -- 매도/매수 구분(1:매도, 2:매수)
	Form.MakeRequestData("conditionStatusCode", "02")	 -- 상태구분(01:감시중지, 02:감시중, 99:삭제)
	
		sDev = Form.GetSharedData("..SERVER_MODE", false)
	sUrl = ""
	if sDev == "1" then --개발기 end end
		sUrl = "https://dev-api-gateway.imeritz.com:8443/"
	else
		sUrl = "https://api-gateway.imeritz.com:8443/"
	end
		
	Form.RequestRestAPI(sUrl.."api/v1/rule/bulk-update-status", "BUY_"..g_sStep)
end

function AutoRule_AllUpdateStatus_Stop()
	g_sStep = "ALL_UPDATE_STATUS_STOP"
	
	sAcno 	= g_sAcno  --Form.GetTopCtlProp("act0","total")
	sAsno 	= g_sAsno  --Form.GetTopCtlProp("act0","sequence")
	
	Form.ReleaseRequestData()
	
	Form.MakeRequestData("accountNumber", sAcno)
	Form.MakeRequestData("accountSeqNumber", sAsno)
	Form.MakeRequestData("tradeType", "2")			 -- 매도/매수 구분(1:매도, 2:매수)
	Form.MakeRequestData("conditionStatusCode", "01")	 -- 상태구분(01:감시중지, 02:감시중, 99:삭제)
	
		sDev = Form.GetSharedData("..SERVER_MODE", false)
	sUrl = ""
	if sDev == "1" then --개발기 end end
		sUrl = "https://dev-api-gateway.imeritz.com:8443/"
	else
		sUrl = "https://api-gateway.imeritz.com:8443/"
	end
		
	Form.RequestRestAPI(sUrl.."api/v1/rule/bulk-update-status", "BUY_"..g_sStep)
end

 --===============================================
 -- REST API_토큰발급
 --===============================================
function IssueToken()
	g_sStep = "ISSUE_TOKEN"
	
	Form.ReleaseRequestData()
	
	sData0  = Form.GetSharedData("..MEDIA_CODE", false )
	sData1  = Form.GetSharedData("..USER_ID", false )
	sData2  = Form.GetSharedData("..MCI_SESSION_KEY", false )
	sData3  = Form.GetSharedData("..SEMI_SSO_KEY", false )
	
	Form.MakeRequestData("channelClsCode", 	sData0)
	Form.MakeRequestData("userId", 			sData1)
	Form.MakeRequestData("sessionKey", 		sData2)
	Form.MakeRequestData("semiSsoKey", 		sData3)
	
	sDev = Form.GetSharedData("..SERVER_MODE", false)
	sUrl = ""
	if sDev == "1" then --개발기 end end
		sUrl = "https://dev-api-gateway.imeritz.com:8443/"
	else
		sUrl = "https://api-gateway.imeritz.com:8443/"
	end
	
	Form.RequestRestAPI(sUrl.."auth/issue-token", "BUY_"..g_sStep)
end

