 --============================================================================
function Form_OnTriggerEvent(sEventName, sParam, sParma2)
 --	Form.ShowAlert("TEST", sEventName .. "|" .. sParam)
	 ------------------------------------
	 -- 토큰발급 성공 -> 전체 재조회
	 ------------------------------------
	if sEventName ==  "TOKEN_SUCCESS" then
		if isEmpty(sParam) == false then
			arrData = Convert_StrToArr(sParam, "`")
			nArrCnt = #arrData
			
			if nArrCnt > 2 then
				g_sAcno = arrData[0+1]
				g_sAsno = arrData[1+1]
				g_sAccName = arrData[2+1]
				
				btnReg.enable = true
			end
			
			if nArrCnt > 3 then
				g_sPwd = arrData[3+1]
			end
		end
		
 --		Form.SetDelayEvent(1, 0.2)
		AutoRule_SelectByAccount() 
	end
	
	 ------------------------------------
	 -- 탭 변경 -> 전체 재조회
	 ------------------------------------
	if sEventName ==  "TAB_CHANGE" then
		if isEmpty(sParam) == false then
			arrData = Convert_StrToArr(sParam, "`")
			nArrCnt = #arrData
			
			if nArrCnt > 2 then
				g_sAcno = arrData[0+1]
				g_sAsno = arrData[1+1]
				g_sAccName = arrData[2+1]
				
				btnReg.enable = true
			end
			
			if nArrCnt > 3 then
				g_sPwd = arrData[3+1]
			end
		end
		
 --		Form.SetDelayEvent(1, 0.2)
		AutoRule_SelectByAccount() 
	end
	
	 ------------------------------------
	 -- (실시간) 감시조건 상태변경
	 ------------------------------------
	if sEventName ==  "REFRESH_LIST" then
		if isEmpty(sParam) == false then
			arrData = Convert_StrToArr(sParam, "`")
			nArrCnt = #arrData
			
			if nArrCnt > 2 then
				g_sAcno = arrData[0+1]
				g_sAsno = arrData[1+1]
				g_sAccName = arrData[2+1]
				
				btnReg.enable = true
			end
			
			if nArrCnt > 3 then
				g_sPwd = arrData[3+1]
			end
		end
		
 --		Form.SetDelayEvent(1, 0.2)
		AutoRule_SelectByAccount() 
	end
	
	 ------------------------------------
	 -- 계좌 변경 -> 전체 재조회
	 ------------------------------------
	if sEventName ==  "ACCT_CHANGE" then
		if isEmpty(sParam) == false then
			arrData = Convert_StrToArr(sParam, "`")
			nArrCnt = #arrData
			
			if nArrCnt > 2 then
				g_sAcno = arrData[0+1]
				g_sAsno = arrData[1+1]
				g_sAccName = arrData[2+1]
				
				btnReg.enable = true
