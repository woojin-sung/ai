					oData = Form.ResponseRestAPI("JSONOBJ", 0, "data", sParma2)
					
					validCount = Form.ResponseRestAPI("DATA", 0, "validCount", 	oData)	
					
					if gf_Tonumber(validCount) >= 50 then
						Form.ShowAlert("알림", "자동 감시 주문은\n50개 까지만 등록 가능해요.")
						return
					end
					
					DATAMANAGER.RequestTranData("obpds_srvc_323r")
				end
			 ------------------------------------------
			 -- 실패(ERROR or EXCEPTION)
			 ------------------------------------------
			else
 --				oError = Form.ResponseRestAPI("JSONOBJ", 0, "error", "")
 --			
 --				if isEmpty(oError) == false then
 --					errorCode = Form.ResponseRestAPI("DATA", 0, "errorCode", oError)
 --					errorMessage = Form.ResponseRestAPI("DATA", 0, "errorMessage", oError)
 --					
 --					if errorCode == "UNMODIFIABLE_STATUS" then
 --						Form.ShowAlert("알림", "감시가 실행되어 수정이 불가해요.\n내역조회에서 확인해 주세요.")
 --						return 
 --					end if
 --				end if

				Form.ShowAlert("알림", g_sCommonErrorMsg)
				return 
			end
		end
	end
	
	
	if sEventName ==  "ACCT_PWD_CHECK" then
		sRet = ""
		if isEmpty(sParam) == false then
			arrData = Convert_StrToArr(sParam, "`")
			nArrCnt = #arrData
			
			if nArrCnt > 1 then
				sRet = arrData[0+1]
				g_sPwd = arrData[1+1]
			else
				sRet = sParam
			end
		end
		
		if sRet == "SUCCESS" then
			sAcno 	= g_sAcno  --Form.GetTopCtlProp("act0","total")
			sAsno 	= g_sAsno  --Form.GetTopCtlProp("act0","sequence")
			
			sAcntNm 	= g_sAccName  --Form.GetTopCtlProp("act0","accountname")
			
			sPwd 	= g_sPwd	 --Form.GetTopCtlProp("edtPwd","caption")
			
			sLinkData = "1"
			sLinkData = sLinkData .. "`" .. sAcno
			sLinkData = sLinkData .. "`" .. sAsno
			sLinkData = sLinkData .. "`" .. sPwd
			sLinkData = sLinkData .. "`" .. sAcntNm
			
			if g_isModify == true then
				sLinkData = sLinkData .. "`" .. g_sModifyInfo
				
				g_sModifyInfo = ""
				g_isModify = false
			end

			Form.OpenPopup("nrshtro17100_p2" , sLinkData , "")
		end
	end
end

function Form_OnDelayEvent(nID)
	if gf_Tonumber(nID) == 1 then
		AutoRule_SelectByAccount() 
	elseif gf_Tonumber(nID) == 2 then
		AutoRule_Delete(g_nClickIdx)
	end
end

 --============================================================================
function Form_OnPopupReturn(sKeyName, sRet)
	 --(iOS전용) 판넬컨트롤 렌더링 오류 수정
	cont0.pnl0.SetDataNormal(true)
	
	 ------------------------------------
	 -- 조건 등록 성공 -> 전체 재조회
	 ------------------------------------	
	if sKeyName == "COMPLETE_ORDER" then
		g_nClickIdx = 0
 --		Form.SetDelayEvent(1, 0.5)
		AutoRule_SelectByAccount() 
		
	 ------------------------------------
	 -- 조건 변경 성공 -> 전체 재조회
	 ------------------------------------	
	elseif sKeyName == "COMPLETE_MODIFY" then
 --		Form.SetDelayEvent(1, 0.5)
		AutoRule_SelectByAccount() 
		
	 ------------------------------------
	 -- 조건 삭제 -> 전체 재조회
	 ------------------------------------	
	elseif sKeyName == "INFO_DELETE" then
 --		Form.SetDelayEvent(1, 0.5)
		AutoRule_SelectByAccount() 
		
	 ------------------------------------
	 -- 조건 삭제 -> 전체 재조회
	 ------------------------------------	
	elseif sKeyName == "DELETE_ITEM" then
 --		Form.SetDelayEvent(2, 0.5)
		AutoRule_Delete(g_nClickIdx)
		
	 ------------------------------------
	 -- 조건 수정 -> 조건설정 화면으로 이동
	 ------------------------------------
	elseif sKeyName == "INFO_MODIFY" then
		g_isModify = true
		g_sModifyInfo = sRet
		
		Form.TriggerEvent("#", "CHECK_ACCT_PWD", "")
		
	 ------------------------------------
	 -- 조건 변경 -> 전체 재조회
	 ------------------------------------
	elseif sKeyName == "INFO_CHANGE" then
 --		Form.SetDelayEvent(1, 0.5)
		AutoRule_SelectByAccount() 
		
	elseif sKeyName == "CHECK_AGREE" then
		if sRet == "ok" then
		
			 --Form.TriggerEvent("#", "CHECK_ACCT_PWD", "")
			DATAMANAGER.RequestTranData("obtro_oder_135a")
		end
	end
end



 --============================================================================
 -- Form_OnMsgBoxClose
 --============================================================================
function Form_OnMsgBoxClose(sKeyName, sRet)
	 ------------------------------------
	 -- 전체실행
	 ------------------------------------
	if sKeyName == "ALL_RUN" then
		if sRet == "ok" then
			AutoRule_AllUpdateStatus() 
		end
		
	elseif sKeyName == "ALL_STOP" then
		if sRet == "ok" then
			AutoRule_AllUpdateStatus_Stop() 
		end
		
	 ------------------------------------
	 -- 전체삭제
	 ------------------------------------
	elseif sKeyName == "ALL_DELETE" then
		if sRet == "ok" then
			AutoRule_AllDelete() 
		end
	
	 ------------------------------------
	 -- 단건삭제
	 ------------------------------------
	elseif sKeyName == "DELETE" then
		if sRet == "ok" then
			AutoRule_Delete(g_nClickIdx) 
		end
		
	elseif sKeyName == "REG" then
		if sRet == "ok" then
			sAcnt 	= g_sAcno..g_sAsno  --Form.GetTopCtlProp("act0","caption")
			Form.OpenScreen("87051" , sAcnt)
		end
	end
end


 --============================================================================
function DATAMANAGER_OnSendTranBefore(szTranID)
	if szTranID == "obpds_srvc_323r" then
		sAcno 	= g_sAcno  --Form.GetTopCtlProp("act0","total")
		sAsno 	= g_sAsno  --Form.GetTopCtlProp("act0","sequence")
	
		DATAMANAGER.SetDataValue(0, "obpds_srvc_323r", "InBlock1", "ACNO" 				, 0 	, sAcno )
		DATAMANAGER.SetDataValue(0, "obpds_srvc_323r", "InBlock1", "ASNO"				, 0 	, sAsno )
		DATAMANAGER.SetDataValue(0, "obpds_srvc_323r", "InBlock1", "SVCD"				, 0 	, "082" )
		DATAMANAGER.SetDataValue(0, "obpds_srvc_323r", "InBlock1", "CSNO"				, 0 	, "" )
	elseif szTranID == "obtro_oder_135a" then
		sCsno = Form.GetSharedData("..CUST_NUM", false)
		sDate = Form.GetSharedData("..HOST_DATE", false)
		sMediaCode = Form.GetSharedData("..MEDIA_CODE", false)
		
		sAcno 	= g_sAcno  --Form.GetTopCtlProp("act0","total")
		sAsno 	= g_sAsno  --Form.GetTopCtlProp("act0","sequence")
		
		DATAMANAGER.SetDataValue(0, "obtro_oder_135a", "InBlock1", "BSWR_CLCD" , 0 , "U1")
		DATAMANAGER.SetDataValue(0, "obtro_oder_135a", "InBlock1", "CSNO" , 0 , sCsno)
		DATAMANAGER.SetDataValue(0, "obtro_oder_135a", "InBlock1", "PROS_CLS_CODE" , 0 ,"1")
		DATAMANAGER.SetDataValue(0, "obtro_oder_135a", "InBlock1", "ACNO" , 0 , sAcno)
		DATAMANAGER.SetDataValue(0, "obtro_oder_135a", "InBlock1", "ASNO" , 0 , sAsno)
		DATAMANAGER.SetDataValue(0, "obtro_oder_135a", "InBlock1", "AGRM_YN" , 0 , "Y")
		DATAMANAGER.SetDataValue(0, "obtro_oder_135a", "InBlock1", "AGRM_DATE" , 0 , sDate)
		DATAMANAGER.SetDataValue(0, "obtro_oder_135a", "InBlock1", "CHAN_TYPE_CLS_CODE" , 0 , sMediaCode)
		
	elseif szTranID == "obtro_oder_133r" then
		
		sCsno		= Form.GetSharedData("..CUST_NUM", false)
		
		DATAMANAGER.SetDataValue(0, "obtro_oder_133r", "InBlock1", "BSWR_CLCD" , 0 , 		"U1")
		DATAMANAGER.SetDataValue(0, "obtro_oder_133r", "InBlock1", "CSNO" , 0 , 		sCsno)
	
	end
end

 --============================================================================
function DATAMANAGER_OnReceiveTranComplete(szTranID)
	if szTranID == "obpds_srvc_323r" then
		szYakCd = DATAMANAGER.GetDataMsgCode(szTranID)
		
		if szYakCd ~= "5766" then
			Form.MsgBox("안내", "해외주식 거래신청 미등록 계좌는 약정 신청 후 거래가 가능합니다. 해당 화면으로 이동하시겠습니까?" , "REG", 7, "거래신청하기" , "취소")
			
		else
			DATAMANAGER.RequestTranData("obtro_oder_133r")
 --			Form.OpenPopup("nrshtro17100_p11" , "" , "")
			 --Form.TriggerEvent("#", "CHECK_ACCT_PWD", "")
		end
	elseif szTranID == "obtro_oder_135a" then
		Form.TriggerEvent("#", "CHECK_ACCT_PWD", "")
		
	elseif szTranID == "obtro_oder_133r" then
		sYN = DATAMANAGER.GetDataValue(0, "obtro_oder_133r", "OutBlock1", "AGRM_YN" , 0)
		
		if sYN == "Y" then
			Form.TriggerEvent("#", "CHECK_ACCT_PWD", "")
		else
			Form.OpenPopup("nrshtro17100_p11" , "" , "")
		end
	end
end

 --============================================================================
function DATAMANAGER_OnReceiveTranError(szTranID , szErrCode , szErrMsg)
	if szTranID == "obpds_srvc_323r" then
		szYakCd = DATAMANAGER.GetDataMsgCode(szTranID)
		
		if szYakCd ~= "5766" then
			Form.MsgBox("안내", "해외주식 거래신청 미등록 계좌는 약정 신청 후 거래가 가능합니다. 해당 화면으로 이동하시겠습니까?" , "REG", 7 , "거래신청하기", "취소")

		else
			Form.OpenPopup("nrshtro17100_p11" , "" , "")
			 --Form.TriggerEvent("#", "CHECK_ACCT_PWD", "")
		end
		return
	end
	
	szSubMsg = DATAMANAGER.GetDataMsgSubText(szTranID)
	
	if string.string.string.len(gf_Trim(szSubMsg))	>	0 then
		Form.ShowAlert("알림", szErrMsg .. "(" .. szSubMsg .. ")")
	else
		Form.ShowAlert("알림", szErrMsg )
	end
end


 --============================================================================
function cont0_pnl0_OnScrollEnd()
	if isEmpty(g_sNextKey) == false then
		AutoRule_SelectByAccount_Next()
	end
end


	
