 --============================================================================
 -- btnReg_OnClick : 매도 조건 추가하기
 --============================================================================
function cont0_pnl0_OnClick(nIndex, sCellID)
	g_nClickIdx = gf_Tonumber(nIndex)
	
	 ------------------------------------
	 -- 삭제버튼 클릭
	 ------------------------------------
	if sCellID == "Image5" or sCellID == "btnDelete" then
		Form.MsgBox("안내", "감시 조건을\n삭제 하시겠습니까?", "DELETE", 7, "확인", "취소")
	
	 ------------------------------------
	 -- 감시여부 버튼 클릭
	 ------------------------------------
	elseif sCellID == "lblData1" or  sCellID == "Image3" then
		if g_isClickable == true then
			g_isClickable = false
			AutoRule_UpdateStatus(nIndex) 
		end
	
	 ------------------------------------
	 -- 이외 영역 -> 조건 상세 팝업
	 ------------------------------------
	else
		Open_Info()
	end
end

