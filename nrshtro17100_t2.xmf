	end
	
	cont0_Image2_OnClick()
end

 --============================================================================
 -- cont0_Image0_OnClick : 감시조건 전체실행
 --============================================================================
function cont0_Image0_OnClick()
	nCnt = 0
	for i = 0, gf_Tonumber(cont0.pnl0.rowcount) - 1 do
		sStatus = cont0.pnl0.GetPropCardCell("caption"		,"conditionStatusCode"	,i)

		if sStatus == "01" or sStatus == "02" then
			nCnt = nCnt + 1
		end
	end
	
	nRowCnt = gf_Tonumber(cont0.pnl0.rowcount)
	Form.MsgBox("안내", "전체 감시 조건 [총 "..nRowCnt.."/" .. gf_CommaValue(nCnt,0) .. "건] 에 대해\n자동 감시를 실행 하시겠습니까?", "ALL_RUN", 7, "확인", "취소")
end

