local g_arrContent2_Check
g_arrContent2_Check = Array("0", "0", "0", "0")

local g_szLinkGbn, g_szDupSel

local g_nPannel0_Height
g_nPannel0_Height = 0

local g_nPannel1_Height
g_nPannel1_Height = 0

local g_szSelData
g_szSelData = "거래량 많은순"
