function DisplaySetting_PannelList(nRowIdx, szCtlName)
	nCnt = nRowIdx * 2
	if szCtlName == "lbl0" then
		nCnt = gf_Tonumber(nCnt) + 0
	elseif szCtlName == "lbl1" then
		nCnt = gf_Tonumber(nCnt) + 1
	end
	
	if #g_arrContent2_Check < nCnt+1 then
		return
	end
	
	Clear_Content("1")
	
	g_arrContent2_Check[nCnt+1] = "1"
	contBg.Pannel1.SetPropCardCell("imagefilepth", szCtlName, nRowIdx, g_szBtnImg_Select)
	
	g_szSelData = g_arrContent2(nCnt)
	
	if g_szSelData == "거래량 많은순" or g_szSelData == "거래량 낮은순" then
		Clear_Content("0")
	
		g_arrContent_Check[0+1] = "1"
		contBg.Pannel0.SetPropCardCell("imagefilepth", "lbl0", 0, g_szBtnImg_Select)
		
		contBg.Pannel0.SetPropCardCell("imagefilepth", "lbl1", 0, g_szBtnImg_Disable)
		contBg.Pannel0.SetPropCardCell("imagefilepth", "lbl2", 0, g_szBtnImg_Disable)
		
		contBg.Pannel0.SetPropCardCell("imagefilepth", "lbl0", 1, g_szBtnImg_Disable)
		contBg.Pannel0.SetPropCardCell("imagefilepth", "lbl1", 1, g_szBtnImg_Disable)
		contBg.Pannel0.SetPropCardCell("imagefilepth", "lbl2", 1, g_szBtnImg_Disable)
		
		contBg.Pannel0.SetPropCardCell("fgcolor", "lbl1", 0, g_szTxtColor_Grey)
		contBg.Pannel0.SetPropCardCell("fgcolor", "lbl2", 0, g_szTxtColor_Grey)
		
		contBg.Pannel0.SetPropCardCell("fgcolor", "lbl0", 1, g_szTxtColor_Grey)
		contBg.Pannel0.SetPropCardCell("fgcolor", "lbl1", 1, g_szTxtColor_Grey)
		contBg.Pannel0.SetPropCardCell("fgcolor", "lbl2", 1, g_szTxtColor_Grey)
	else
		Init_Content()
		
	end
end

 --===============================================
 -- 배열 -> 문자열 변환
 --===============================================
function Convert_ArrToString(arrData, szSeperator)
	szResult = ""
	
	if arrData == nil then
		return szResult
	end
	
	if szSeperator == nil or szSeperator == "" then
		return szResult
	end
	szArrCnt = #arrData
	
	for i = 0, szArrCnt - 1 do
		if i ~= 0 then
			szResult = szResult .. szSeperator 
		end
		
		szResult = szResult .. arrData[i+1] 
	end
	
	return szResult
end

 --===============================================
 -- 배열 -> 문자열 변환(체크항목)
 --===============================================
function Convert_ChkArrToString(arrData, arrChkData, szSeperator)
	szResult = ""
	
	if arrData == nil then
		return szResult
	end
	
	if arrChkData == nil then
		return szResult
	end
	
	if szSeperator == nil or szSeperator == "" then
		return szResult
	end
	
	szArrCnt = #arrData
	
	for i = 0, szArrCnt - 1 do
		if arrChkData[i+1] == "1" then
			if szResult ~= "" then
				szResult = szResult .. szSeperator 
			end
			szResult = szResult .. arrData[i+1] 
		end
	end
	
	return szResult
end

