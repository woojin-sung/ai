 --===============================================
 -- 문자열 -> 배열 변환
 --===============================================
function Convert_StringToArr(szData, szSeperator)
	szArrData = ""
	
	if szData ~= nil and szData ~= "" then
		szArrData = gf_Split(szData, szSeperator)
	end
	
	return szArrData
end

 --===============================================
 -- 배열 데이터 확인
 --===============================================
function Contains_Array(arrData, szData)

	if arrData == nil or arrData == "" then
		return false
	end
	
	if szData == nil or szData == "" then
		return false
	end
	
	nArrCnt = #arrData
	
	for i = 0, nArrCnt-1 do
		szArrData = arrData[i+1]
		
		if szArrData == szData then
			return true
		end
	end
	
	return false
end

 --===============================================
 -- 체크배열 초기화
 --===============================================
function Clear_ChkArray(arrData)

	if arrData == nil or arrData == "" then
		return false
	end
	
	if szData == nil or szData == "" then
		return false
	end
	
	nArrCnt = #arrData
	
	for i = 0, nArrCnt-1 do
		arrData[i+1] = "0"	
	end
end

 --===============================================
 -- 체크배열 전체선택
 --===============================================
function All_ChkArray(arrData)

	if arrData == nil or arrData == "" then
		return false
	end
	
	if szData == nil or szData == "" then
		return false
	end
	
	nArrCnt = #arrData
	
	for i = 0, nArrCnt-1 do
		arrData[i+1] = "1"	
	end
end

 --===============================================
 -- 배열 인덱스 추출
 --===============================================
function Return_ArrayIndex(arrData, szData)
	nReturn = -1
	if arrData == nil or arrData == "" then
		return nReturn
	end
	
	if szData == nil or szData == "" then
		return nReturn
	end
	
	nArrCnt = #arrData
	for i = 0, nArrCnt-1 do
		if arrData[i+1] == szData then
			nReturn = i
			break
		end
	end
	
	return nReturn
end

function Return_AllChkYN(arrData)
	if arrData == nil or arrData == "" then
		return "N"
	end
	
	nArrCnt = #arrData
	for i = 1, nArrCnt-1 do
		if arrData[i+1] == "0" then
			return "N"
		end
	end
	
	return "Y"
end

function Return_ClearChkYN(arrData)
	if arrData == nil or arrData == "" then
		return "N"
	end
	
	nArrCnt = #arrData
	for i = 1, nArrCnt-1 do
		if arrData[i+1] == "1" then
			return "N"
		end
	end
	
	return "Y"
end



 --****************************************************************************
 --               C  O  M  M  O  N       F  U  N  C  T  I  O  N               
 --****************************************************************************
 --===============================================
 -- Form_OnFormInitBefore
 --===============================================
function Form_OnFormInitBefore()
end

 --===============================================
 -- Form_OnFormInit
 --===============================================
function Form_OnFormInit()
	
	szData = Form.GetOpenLinkData()
	
	if szData == nil or gf_Trim(szData) == "" then
		return
	end
	
	szArrData = gf_Split(szData, "★")
	
	nArrCnt = #szArrData
	
	if nArrCnt > 3 then
		g_szLinkGbn = szArrData[0+1]

		g_szDupSel = szArrData[1+1]
		
		szContData = szArrData[2+1]
		szContData2 = szArrData[3+1]
		
		
		szSavaData1 = ""
		szSavaData2 = ""
		if #szArrData > 4 then
			szSavaData1 = szArrData[4+1]
		end
		
		if #szArrData > 5 then
			szSavaData2 = szArrData[5+1]
		end
		
		g_szSelData = szSavaData2
		
		if g_szDupSel == "1" then
			szContData = "전체`" .. szContData
		end
		
		if szContData ~= "" then
			g_arrContent = Convert_StringToArr(szContData, "`")
		end
		
		nArrCnt = #g_arrContent
		
		g_arrContent_Check = {}
		for i = 0, nArrCnt-1 do
			if string.find(szSavaData1, g_arrContent(i)) > 0 then
				g_arrContent_Check[i+1] = "1"
			else
				g_arrContent_Check[i+1] = "0"
			end
		end
		
		if szContData2 ~= "" then
			g_arrContent2 = Convert_StringToArr(szContData2, "`")
		end
		nArrCnt = #g_arrContent2
		
		g_arrContent2_Check = {}
		
		for i = 0, nArrCnt-1 do
			if string.find(szSavaData2, g_arrContent2(i)) > 0 then
				g_arrContent2_Check[i+1] = "1"
			else
				g_arrContent2_Check[i+1] = "0"
			end
		end
	end
	
	Init_Control()
	Init_Content()
end

 --===============================================
 -- imgBack_OnClick
 --===============================================
function imgBack_OnClick()
end

 --============================================================================
function contBg_Pannel0_OnClick(nIndex, sCellID)
	if sCellID == "" then
		return
	end
	DisplaySetting_PannelBtn(nIndex, sCellID)
end

 --============================================================================
function contBg_Pannel1_OnClick(nIndex, sCellID)
	if sCellID == "" then
		return
	end
	DisplaySetting_PannelList(nIndex, sCellID)
end

 --============================================================================
function contBg_btnOk_OnClick()
	szContent0 = Convert_ChkArrToString(g_arrContent, g_arrContent_Check, "`")
	szContent1 = Convert_ChkArrToString(g_arrContent2, g_arrContent2_Check, "`")
	
	szReturnData = szContent0 .. "★" .. szContent1
	Form.SendReturnToParent("RETURN_DATA_"..g_szLinkGbn, szReturnData)
	Form.CloseForm()
end

 --============================================================================
function contBg_btnCancel_OnClick()
	Clear_Content("0")
	Clear_Content("1")
	
	DisplaySetting_PannelList(1, "lbl0")
end

 --============================================================================
function imgBg_OnClick()
	Form.CloseForm()
end

	
