-- =============================================================================
function Form_OnFormInit()
	Load_Config()
	SetOrderTypeList()
	cont0.lblItemName.maxlinecnt = "2^-6"
	g_szOdrPop     = Form.LoadConfigData("SET_ORDER", "OPEN_CONFIRM")
	if gf_Trim(g_szOdrPop) == "" then
		g_szOdrPop = "1"
	end
	sLinkData = Form.GetOpenLinkData()
	arrLinkData = Convert_StrToArr(sLinkData, "`")
	nArrCnt = #arrLinkData
	if nArrCnt >= 28 then
		g_sGbn = arrLinkData[1]
		g_sAcno = arrLinkData[2]
		g_sAsno = arrLinkData[3]
		g_sPwd = arrLinkData[4]
		g_sAcntNm = arrLinkData[5]
		orderConditionId	= arrLinkData[6]
		registrationDate	= arrLinkData[7]
		accountNumber		= arrLinkData[8]
		accountSeqNumber	= arrLinkData[9]	
		stockExchangeCode	= arrLinkData[10]
		stockCode			= arrLinkData[11]
		stockKoreaName		= arrLinkData[12]
		tradeType			= arrLinkData[13]
		watchConditionType 	= arrLinkData[14]
		watchConditionTypeNm	= arrLinkData[15]
		watchType			= arrLinkData[16]
		watchTypeNm		= arrLinkData[17]
		price			= arrLinkData[18]
		orderPaymentType	= arrLinkData[19]
		orderClsType		= arrLinkData[20]
		orderClsTypeNm		= arrLinkData[21]
		orderPriceType		= arrLinkData[22]
		tickValue			= arrLinkData[23]
		orderPrice			= arrLinkData[24]
		orderQty			= arrLinkData[25]
		expirationDate		= arrLinkData[26]	
		conditionStatusCode	= arrLinkData[27]
		conditionStatusName	= arrLinkData[28]
		sItemCode = Transform_Exid2(stockExchangeCode) .. "@" .. stockCode
		Check_ItemCode(sItemCode)
		if isEmpty(expirationDate) == false then 
			cont1.Calendar0.caption = string.gsub(expirationDate, "-", "")
		end
		g_isModify = true
		--		g_isModify_OneTime = true
	elseif nArrCnt >= 5 then
		sItemCode = Form.GetSharedData("&ITEM_OVERSTOCK", 0)
		Check_ItemCode(sItemCode)
		g_sGbn = arrLinkData[1]
		g_sAcno = arrLinkData[2]
		g_sAsno = arrLinkData[3]
		g_sPwd = arrLinkData[4]
		g_sAcntNm = arrLinkData[5]
		cont1_cmb4_OnEditComplete(0)
	end
end
