function cont1_cmb4_OnEditComplete(iIndex)
	sKey = cont1.cmb4.cbkeydata
	Form.SetSharedData("17100_BUY_ORDER_COND_TYPE" , sKey)
	sKey2 = cont1.cmb4.cbkeydata
	if sKey2 == "05" or sKey2 == "34" then 
		bPopYN = Form.GetEnvData("OrdNotice_17100_p13")
		if (bPopYN == "" or bPopYN == "0") and g_isFst == false  then
			-- sText = "상/하한가가 없는 미국 시장의 특성 상\n해당종목의 가격이 급등락할 수 있으며 "..
			--	   "시장가 주문 시 현재가 또는 원하는 가격보다 낮거나 불리한 가격에 체결될 수 있음을 유의하시기 바랍니다."
			--
			-- Form.MsgBox("시장가 주문 유의사항 안내",sText, "MARKET_ORDER_NOTICE" ,7, "확인","다시보지않기")
			Form.OpenPopup("nrshtro17100_p13" , "" , "") 
		end
		cont1.cmb5.enable = false
		cont1.cmb5.caption = ""
	else
		cont1.cmb5.enable = true
		cont1.cmb5.cbkeydata = cont1.cmb5.cbkeydata
	end
	Change_OrderType()
end
-- =============================================================================
function cont1_cmb1_OnEditComplete(iIndex)
	sKey = cont1.cmb1.cbkeydata
	Form.SetEnvData(1, "17100_BUY_MONITOR_COND_BOUND", sKey)
	sKey2 = cont1.cmb6.cbkeydata
	if sKey2 == "06" or sKey2 == "05" then
		sPrc = Replace_Prc(cont1.Label6.caption)
		if gf_Tonumber(sPrc) == 0 then
			sPrc = ""
		end
		sPrc = string.gsub(sPrc, "-", "")
		if isEmpty(sPrc) == false then
			if sKey2 == "06" then
				sPrc = SetPrice("AUTO", sPrc, "2", "%")
			elseif sKey2 == "05" then	
				sPrc = SetPrice("AUTO", sTmpPrc, contHidden.Label8.caption, contHidden.Label7.caption)
			end
			if sKey == "2" then
				sPrc = "-"..sPrc
			end
			cont1.Label6.caption = sPrc
		end
	end
end
