function cont1_btnPPlus0_OnClick()
	Calc_Price2(gf_Tonumber(cont1.cmb5.currentindex), 0)
	sPrevPrc = Replace_Prc(cont1.edtPrc0.caption)
	sKey = cont1.cmb5.cbkeydata
	if sKey == "01" then
		sPrc = Calc_Price2(0, 0, sPrevPrc)
		cont1.Combo0.cbkeydata = sPrc
		sPrc = SetPrice("AUTO", sPrc, "0", "틱")
	elseif sKey == "09" then
		if gf_Tonumber(sPrevPrc) == 0 then
			sPrc = Replace_Prc(contHidden.Label0.caption)
			sPrc  = ReSet_Prc(sPrc, 1)
		else
			sPrc = Calc_Price2(1, 0, sPrevPrc)
		end
		sPrc = SetPrice("AUTO", sPrc, contHidden.Label8.caption, contHidden.Label7.caption)
	end
	cont1.edtPrc0.caption = sPrc
end
