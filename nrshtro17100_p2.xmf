function AutoRule_Create() 
	g_sStep = "CREATE"
	Form.releaseRequestData()
	sUserID = Form.GetSharedData("&USER_ID", false )
	Form.MakeRequestData("userId", sUserID)
	Form.MakeRequestData("accountNumber", 	g_sAcno)
	Form.MakeRequestData("accountSeqNumber", g_sAsno)
	Form.MakeRequestData("accountPassword", g_sPwd)
	Form.MakeRequestData("stockExchangeCode", g_sMarket)
	Form.MakeRequestData("stockCode", g_sCode)
	Form.MakeRequestData("tradeType", "2")
	Form.MakeRequestData("conditionName", "매수자동조건")
	Form.startBuildJson()
	Form.putJsonData("watchConditionType", cont1.cmb6.cbkeydata)
	Form.putJsonData("watchType", cont1.cmb1.cbkeydata)
	Form.putJsonData("price", Replace_Prc(cont1.Label6.caption))
	sData = Form.endBuildJson()
	Form.MakeRequestData("buyCondition", sData)
	Form.MakeRequestData("orderPaymentType", "1")
	Form.MakeRequestData("orderClsType", cont1.cmb4.cbkeydata)
	if cont1.cmb4.cbkeydata ~= "05" and cont1.cmb4.cbkeydata ~= "34" then
		Form.MakeRequestData("orderPriceType", cont1.cmb5.cbkeydata)
		if cont1.cmb5.cbkeydata == "01" then
			Form.MakeRequestData("tickValue", cont1.Combo0.cbkeydata)
			Form.MakeRequestData("orderPrice", "0")
			--		sPrc = contHidden.lblHyun.caption
			--		nUnit = Cdbl(GetHogaUnit(g_sExid3, sPrc, 0))
			--		
			--		nResultPrc = Cdbl(sPrc) + (nUnit * Cint(cont1.Combo0.cbkeydata))
			--		Form.MakeRequestData("orderPrice", nResultPrc)
		elseif cont1.cmb5.cbkeydata == "09" then
			Form.MakeRequestData("tickValue","0")
			Form.MakeRequestData("orderPrice", Replace_Prc(cont1.edtPrc0.caption))
		else
			Form.MakeRequestData("tickValue","0")
			Form.MakeRequestData("orderPrice", "0")
		end
	end
	Form.MakeRequestData("orderQty", cont1.edtQty.caption)
	sMonth = cont1.Calendar0.calmonth
	if gf_Tonumber(cont1.Calendar0.calmonth) < 10 then
		sMonth = "0"..sMonth
	end
	sDate = cont1.Calendar0.caption
	Form.MakeRequestData("expirationDate", Left(sDate,4) .. "-" ..  Mid(sDate,5,2)  .. "-" .. Right(sDate,2))
	Form.MakeRequestData("conditionStatusCode", g_sAutoRule)
	sDev = Form.GetSharedData("&SERVER_MODE", false)
	sUrl = ""
	if sDev == "1" then	-- 개발기
		sUrl = "https://dev-api-gateway.imeritz.com:8443/"
	else
		sUrl = "https://api-gateway.imeritz.com:8443/"
	end
	Form.requestRestAPI(sUrl.."api/v1/rule/create", "")
	g_sAutoRule = "01"
end
function AutoRule_Update() 
	g_sStep = "UPDATE"
	Form.releaseRequestData()
	Form.MakeRequestData("orderConditionId", orderConditionId)
	Form.MakeRequestData("accountPassword", g_sPwd)
	Form.MakeRequestData("stockExchangeCode", g_sMarket)
	Form.MakeRequestData("stockCode", g_sCode)
	Form.MakeRequestData("tradeType", "2")
	Form.startBuildJson()
	Form.putJsonData("watchConditionType", cont1.cmb6.cbkeydata)
	Form.putJsonData("watchType", cont1.cmb1.cbkeydata)
	Form.putJsonData("price", Replace_Prc(cont1.Label6.caption))
	sData = Form.endBuildJson()
	Form.MakeRequestData("buyCondition", sData)
	Form.MakeRequestData("orderPaymentType", "1")
	Form.MakeRequestData("orderClsType", cont1.cmb4.cbkeydata)
	if cont1.cmb4.cbkeydata ~= "05" and cont1.cmb4.cbkeydata ~= "34" then
		Form.MakeRequestData("orderPriceType", cont1.cmb5.cbkeydata)
		if cont1.cmb5.cbkeydata == "01" then
			Form.MakeRequestData("tickValue", cont1.Combo0.cbkeydata)
			Form.MakeRequestData("orderPrice", "0")
			--		sPrc = contHidden.lblHyun.caption
			--		nUnit = Cdbl(GetHogaUnit(g_sExid3, sPrc, 0))
			--		
			--		nResultPrc = Cdbl(sPrc) + (nUnit * Cint(cont1.Combo0.cbkeydata))
			--		Form.MakeRequestData("orderPrice", nResultPrc)
		elseif cont1.cmb5.cbkeydata == "09" then
			Form.MakeRequestData("tickValue","0")
			Form.MakeRequestData("orderPrice", Replace_Prc(cont1.edtPrc0.caption))
		else
			Form.MakeRequestData("tickValue","0")
			Form.MakeRequestData("orderPrice", "0")
		end
	end
	Form.MakeRequestData("orderQty", cont1.edtQty.caption)
	sMonth = cont1.Calendar0.calmonth
	if gf_Tonumber(cont1.Calendar0.calmonth) < 10 then
		sMonth = "0"..sMonth
	end
	Form.MakeRequestData("conditionStatusCode", g_sAutoRule)
	sDate = cont1.Calendar0.caption
	Form.MakeRequestData("expirationDate", Left(sDate,4) .. "-" ..  Mid(sDate,5,2)  .. "-" .. Right(sDate,2))
	sDev = Form.GetSharedData("&SERVER_MODE", false)
	sUrl = ""
	if sDev == "1" then	-- 개발기
		sUrl = "https://dev-api-gateway.imeritz.com:8443/"
	else
		sUrl = "https://api-gateway.imeritz.com:8443/"
	end
	Form.requestRestAPI(sUrl.."api/v1/rule/update", "")
	g_sAutoRule = "01"
end
-- =============================================================================
function Form_OnTriggerEvent(sEventName, sParam)
	if sEventName ==  "RESTAPI_RETURN" then
		sStep = g_sStep
		g_sStep = ""
		-- ----------------------------------
		-- 조건 등록
		-- ----------------------------------
		if sStep == "CREATE" then
			-- ----------------------------------------
			-- 성공
			-- ----------------------------------------
			if sParam == "SUCCESS" then
				status = Form.responseRestAPI("DATA", 0, "status", "")
				if status == "00" then
					Form.CloseForm()
					Form.SendReturnToParent("COMPLETE_ORDER" , "")
				end
			-- ----------------------------------------
			-- 실패(ERROR or EXCEPTION)
			-- ----------------------------------------
			else
				oError = Form.responseRestAPI("JSONOBJ", 0, "error", "")
				if isEmpty(oError) == false then
					errorCode = Form.responseRestAPI("DATA", 0, "errorCode", oError)
					errorMessage = Form.responseRestAPI("DATA", 0, "errorMessage", oError)
					if errorCode == "LIMIT_REACHED" then
						Form.ShowAlert("알림", "자동 감시 주문은\n50개 까지만 등록 가능해요.")
						return 
					end
				end
				Form.ShowAlert("알림", g_sCommonErrorMsg)
				return 
			end
		-- ----------------------------------
		-- 조건 수정
		-- ----------------------------------
		elseif sStep == "UPDATE" then
			-- ----------------------------------------
			-- 성공
			-- ----------------------------------------
			if sParam == "SUCCESS" then
				status = Form.responseRestAPI("DATA", 0, "status", "")
				if status == "00" then
					Form.CloseForm()
					Form.SendReturnToParent("COMPLETE_MODIFY" , "")
				end
			-- ----------------------------------------
			-- 실패(ERROR or EXCEPTION)
			-- ----------------------------------------
			else
				oError = Form.responseRestAPI("JSONOBJ", 0, "error", "")
				if isEmpty(oError) == false then
					errorCode = Form.responseRestAPI("DATA", 0, "errorCode", oError)
					errorMessage = Form.responseRestAPI("DATA", 0, "errorMessage", oError)
					if errorCode == "UNMODIFIABLE_STATUS" then
						Form.MsgBox("알림", "감시가 실행되어 수정이 불가해요.\n내역조회에서 확인해 주세요.", "DISABLE_ORDER", 6)
						return 
					elseif errorCode == "FORCED_STOP_STATUS" then
						Form.ShowAlert("알림", errorMessage)
						return 
					end
				end
				Form.ShowAlert("알림", g_sCommonErrorMsg)
				return 
			end
		end
	end
end
-- =============================================================================
function Form_OnFormInitBefore()
	imgBack.maintainratio = "2"
	imgInfo.maintainratio = "1"
	cont0.imgSearch.maintainratio = "1"
	--	cont0.lblItemName.maxlinecnt = "2^-4"
end
-- =============================================================================
function Form_OnLinkData(sKey, sValue)
	-- 20250804_01 YSH START
	-- 해외주식 장운영 정보 조회방식 변경
	if sKey == "OVRS_MARKET_OPERATION_TRAN" then
		-- Form.ShowAlert("자동감시주문_매수_nrshtro17100_p2", "조회 성공 여부 : " & sValue)
		if sValue == "SUCCESS" then
			if g_sExid ~= "" then
				sKey = "&OVRS_MARKET_OPERATION_" .. Transform_Exid4(g_sExid)
				g_szMktOpClsCd = Form.GetSharedData(sKey, false)
				Check_ItemCode(g_sItemCode)
			end
		end
	elseif sKey == "OVRS_MARKET_OPERATION_REAL" then
		-- Form.ShowAlert("자동감시주문_매수_nrshtro17100_p2", "실시간 조회 성공 여부 : " & sValue & " / g_sExid : " & Transform_Exid4(g_sExid))
		arrMktData = gf_Split(sValue, "@")
		if arrMktData[1] == Transform_Exid4(g_sExid) and g_szMktOpClsCd ~= arrMktData[2] then
			g_szMktOpClsCd = arrMktData[2]
			Convert_MktOpInfo(g_szMktOpClsCd)
			DisplaySetting_MktOperation(g_szMktOp, g_isMktClosed, g_szSubMktOp, g_szBaseDate, g_isHoliday)
			Cancel_Real_Total()
			-- 해외주식 종목 기본정보 및 주간시세 보정용
			DATAMANAGER.RequestTranData("ohhts_6000_001r_1")
		end
	end
	-- 20250804_01 YSH END
end
