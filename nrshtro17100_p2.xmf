function cont0_imgSearch_OnClick()
	if g_isModify == false then
		Form.OpenPopup("msearchdialog", "종목검색★56:52★INTG_DIVIDE_HISTORY★EMPTY★EMPTY", "")
	end
end
function DisplaySet_OrderPrc(sValue, isChk)
	if isEmpty(sValue) == true or gf_Tonumber(sValue) == 0 then
		cont1.edtPrc0.caption = ""
		sKey = cont1.cmb5.cbkeydata
		if sKey == "01" then
			cont1.edtPrc0.caption = "0 틱"
		end
		return
	end
	sKey = cont1.cmb5.cbkeydata
	if sKey == "01" then
		sPrc = SetPrice("AUTO", sValue, "0", "틱")
	elseif sKey == "09" then
		if gf_Tonumber(sValue) == 0 then
			return
		end
		if Check_HogaUnit(sValue, isChk) == false then
			return
		end
		sTmpPrc = ReSet_Prc(sValue, 0)
		sPrc = SetPrice("AUTO", sTmpPrc, contHidden.Label8.caption, contHidden.Label7.caption)
	end
	cont1.edtPrc0.caption = sPrc
end
function DisplaySet_CondPrc(sValue, isChk)
	if isEmpty(sValue) == true or gf_Tonumber(sValue) == 0 then
		return
	end
	sKey = cont1.cmb6.cbkeydata
	if sKey == "06" then
		sPrc = SetPrice("AUTO", sValue, "2", "%")
		sSubKey = cont1.cmb1.cbkeydata
		if sSubKey == "2" then
			sPrc = "-"..string.gsub(sPrc, "-", "")
		end
	else
		if Check_HogaUnit(sValue, isChk) == false then
			return
		end
		sTmpPrc = ReSet_Prc(sValue, 0)
		sPrc = SetPrice("AUTO", sTmpPrc, contHidden.Label8.caption, contHidden.Label7.caption)
		sSubKey = cont1.cmb1.cbkeydata
		if sSubKey == "2" and  sKey == "05" then
			sPrc = "-"..string.gsub(sPrc, "-", "")
		end
	end
	cont1.Label6.fgcolor = 334
	cont1.Label6.caption = sPrc
end
function DisplaySet_OrderQty(sValue)
	if isEmpty(sValue) == true or gf_Tonumber(sValue) == 0 then
		cont1.edtQty.caption = ""
		return
	end
	cont1.edtQty.caption = sValue
end
-- =============================================================================
function Form_OnPopupReturn(sKeyName, sRet)
	if sKeyName == "DLG_SELECT" then
		Check_ItemCode(sRet)
	elseif sKeyName == "AUTO_RULE_KEYPAD_END" then
		arrRet = Convert_StrToArr(sRet, "`")
		nArrCnt = #arrRet
		if nArrCnt > 1 then
			sKey = arrRet[1]
			sValue = arrRet[2]
			if sKey == "매수_주문수량" then
				DisplaySet_OrderQty(sValue)
			elseif sKey == "매수_감시가격" then
				DisplaySet_CondPrc(sValue, true)
			elseif sKey == "매수_주문가격" then
				DisplaySet_OrderPrc(sValue, true)
			end
		end
	elseif sKeyName == "ORDER_CONFIRM_CHECK" then
		if sRet == "ok" then
			if g_isPTP == "Y" then
				szData = "90" .. "|" .. ""	-- 매매구분|메시지
				-- Form.OpenPopup("mhtro16060_p15", szData , "")	-- OnPopupReturn -> "PTP주문경고"
				Form.OpenPopupAnimation("mhtro16100_p15", szData, "", "2")
			else
				--				g_sAutoRule = "01"
				--				if g_isModify == true then
				--					AutoRule_Update() 
				--				else
				--					AutoRule_Create()
				--				end if
				-- v20250729_01 >>
				Form.MsgBox("안내", "등록하신 감시 조건을\n바로 실행하시겠습니까?\n(감시는 정규장에서만 실행돼요.)", "MONITORING_EXECUTE", 7, "실행하기", "취소")
				-- v20250729_01 <<
			end
		end
	elseif sKeyName == "PTP주문경고" then
		--		g_sAutoRule = "01"
		--		if g_isModify == true then
		--			AutoRule_Update() 
		--		else
		--			AutoRule_Create()
		--		end if
		-- v20250729_01 >>
		Form.MsgBox("안내", "등록하신 감시 조건을\n바로 실행하시겠습니까?\n(감시는 정규장에서만 실행돼요.)", "MONITORING_EXECUTE", 7, "실행하기", "취소")
		-- v20250729_01 <<
	elseif sKeyName == "MYCOND_RETURN" then
		arrLinkData = Convert_StrToArr(sRet, "`")
		nArrCnt = #arrLinkData
		if nArrCnt > 0 then
			g_isModify = false
			--			g_isModify_OneTime = false
			orderConditionId	= ""
			registrationDate	= ""
			accountNumber		= arrLinkData[1]
			accountSeqNumber	= arrLinkData[2]	
			stockExchangeCode	= arrLinkData[3]
			stockCode			= arrLinkData[4]
			stockKoreaName		= arrLinkData[5]
			tradeType			= arrLinkData[6]
			watchConditionType 	= arrLinkData[7]
			watchConditionTypeNm	= arrLinkData[8]
			watchType			= arrLinkData[9]
			watchTypeNm		= arrLinkData[10]
			price			= arrLinkData[11]
			orderPaymentType	= arrLinkData[12]
			orderClsType		= arrLinkData[13]
			orderClsTypeNm		= arrLinkData[14]
			orderPriceType		= arrLinkData[15]
			tickValue			= arrLinkData[16]
			orderPrice			= arrLinkData[17]
			orderQty			= arrLinkData[18]
			expirationDate		= arrLinkData[19]	
			conditionStatusCode	= ""
			conditionStatusName	= ""
			sItemCode = Transform_Exid2(stockExchangeCode) .. "@" .. stockCode
			Check_ItemCode(sItemCode)
			if isEmpty(expirationDate) == false then 
				cont1.Calendar0.caption = string.gsub(expirationDate, "-")
			end
		end
		-- --------------------------------
		-- 비밀번호 입력 (직접 / 주문자동)
		-- --------------------------------
	elseif sKeyName == "CORRECT_PWD" then
		-- --------------------------------
		-- 비밀번호 입력 완료
		-- --------------------------------
		if sRet ~= "" then
			local szAcnt
			tData = gf_Split(sRet, "★")
			if UBOUND(tData) > 0 then
				g_sPwd = tData[1]
				Form.PostLinkData("17100_PWD_CHANGE", sRet)
			end
			DATAMANAGER.RequestTranData("obtro_oder_132r")
		end 
	end
end
-- =============================================================================
function Form_OnMsgBoxClose(sKeyName, sRet)
	if sKeyName == "MONITORING_EXECUTE" then
		if sRet == "ok" then
			g_sAutoRule = "02"
		else
			g_sAutoRule = "01"
		end
		if g_isModify == true then
			AutoRule_Update() 
		else
			AutoRule_Create()
		end
	elseif sKeyName == "REG" then
		if sRet == "ok" then
			Form.OpenScreen("87051" , g_sAcno..g_sAsno)
		elseif sRet == "no" then
			--			Button0.left = 0
			--			Form.closeForm()
		end
	elseif sKeyName == "CLEAR_DATA" then 
		if sRet == "ok" then
			Clear_Data()
		end
	elseif sKeyName == "DISABLE_PTP" then 
		if sRet == "no" then
			Form.SendReturnToParent("DELETE_ITEM" , "")
		end
		Form.CloseForm()
	elseif sKeyName == "DISABLE_ORDER" then 	
		Form.CloseForm()
	end
end
