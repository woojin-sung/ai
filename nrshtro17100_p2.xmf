				elseif szOrdPrc <= 500000 then
					szUnit = "500"
				elseif szOrdPrc <= 1000000 then
					szUnit = "1000"
				elseif szOrdPrc <= 3000000 then
					szUnit = "1000"
				elseif szOrdPrc <= 5000000 then
					szUnit = "5000"
				elseif szOrdPrc <= 10000000 then
					szUnit = "10000"
				elseif szOrdPrc <= 30000000 then
					szUnit = "10000"
				else 
					szUnit = "50000"
				end
			end
		end
	end
	return szUnit
end
-- ==============================================
-- 거래소코드 -> 거래소명 변환 
-- ==============================================
function Transform_Exid(sValue)
	if sValue == "HKS" then	-- 104
		return "홍콩"
	elseif sValue == "HSI" then -- 529
		return "항셍 지수"
	elseif sValue == "SHS" then -- 215
		return "중국 상해"
	elseif sValue == "SZS" then -- 214
		return "중국 심천"
	elseif sValue == "NYS" then -- 321
		return "미국 뉴욕"
	elseif sValue == "AMX" then -- 66
		return "미국 아멕스"
	elseif sValue == "NAS" then -- 537
		return "미국 나스닥"
	elseif sValue == "NAO" then -- 130
		return "미국"
	elseif sValue == "SPI" then -- 625
		return "미국 S&P"
	elseif sValue == "DJI" then -- 310
		return "미국 다우존스"
	elseif sValue == "TSE" then -- 106
		return "일본 도쿄"
	elseif sValue == "OSE" then -- 107
		return "일본 오사카"
	elseif sValue == "JSD" then -- 112
		return "일본 자스닥"
	elseif sValue == "NII" then -- 889
		return "일본 니케이"
	elseif sValue == "NAI" then -- 538
		return "미국 나스닥"
	elseif sValue == "HSX" then -- 770
		return "베트남 호치민"
	elseif sValue == "HNX" then -- 771
		return "베트남 하노이"
	else
		return ""
	end
end
-- ==============================================
-- 거래소 구분코드 변경(3자리 -> 2자리)
-- 원장조회 종목연동 시, 과거 거래소 코드로 연동되는 경우 예외처리를 위해 필요
-- ==============================================
function Transform_Exid2(sValue)
    local Transform_Exid2 = ""
	if sValue == "HKS" then
		Transform_Exid2 = "HK"
	elseif sValue == "SHS" then
		Transform_Exid2 = "SH"
	elseif sValue == "SZS" then
		Transform_Exid2 = "SZ"
	elseif sValue == "NYS" then
		Transform_Exid2 = "NY"
	elseif sValue == "AMX" then
		Transform_Exid2 = "AX"
	elseif sValue == "NAS" then
		Transform_Exid2 = "OQ"
	elseif sValue == "TSE" then
		Transform_Exid2 = "JP"
	else
		Transform_Exid2 = sValue
	end
	
	return Transform_Exid2
end
function Transform_Exid3(sValue)
     local Transform_Exid3 = ""
	if sValue == "HK" then
		Transform_Exid3 = "HKS"
	elseif sValue == "SH" then
		Transform_Exid3 = "SHS"
	elseif sValue == "SZ" then
		Transform_Exid3 = "SZS"
	elseif sValue == "NY" then
		Transform_Exid3 = "NYS"
	elseif sValue == "AX" then
		Transform_Exid3 = "AMX"
	elseif sValue == "OQ" then
		Transform_Exid3 = "NAS"
	elseif sValue == "JP" then
		Transform_Exid3 = "TSE"
	else
		Transform_Exid3 = sValue
	end
	
	return Transform_Exid3
end
-- ==============================================
-- 장 운영 정보 조회 전용 - 거래소 구분 코드
-- ==============================================
function Transform_Exid4(sValue)
     local Transform_Exid4 = ""
	-- 20250804_01 YSH START
	if sValue == "HK" or sValue == "HKS" then
		Transform_Exid4 = "HK"
	elseif sValue == "SH" or sValue == "SHS" then
		Transform_Exid4 = "SH"
	elseif sValue == "SZ" or sValue == "SZS" then
		Transform_Exid4 = "SZ"
	elseif sValue == "JP" or sValue == "TSE" then
		Transform_Exid4 = "JP"
	elseif sValue == "NY" or sValue == "NYS" then
		Transform_Exid4 = "US"
	elseif sValue == "AX" or sValue == "AMX" then
		Transform_Exid4 = "US"
	elseif sValue == "OQ" or sValue == "NAS" then
		Transform_Exid4 = "US"
	else
		Transform_Exid4 = "US"
	end
	-- 20250804_01 YSH END
	
	return Transform_Exid4
end
-- ==============================================
-- 종목코드 변경 
-- ==============================================
function Check_ItemCode(szCode)
	arrLinkCode = gf_Split(szCode,"★")
	if #arrLinkCode < 1 then
		tempCode = "OQ@AAPL"
		tempName = Form.GetItemCodeInfo(tempCode, "name")
		-- 최근조회 종목 설정
		Form.SetSharedData( "&ITEM_CODE" , tempCode )
		Form.SetSharedData( "&ITEM_KORNAME" , tempName  )
		Form.SetSharedData( "&ITEM_OVERSTOCK", tempCode.."★"..tempName.."★".."", "" )
		Form.SendMessageToMain( "CHANGE_ITEMCODE_OVERSTOCK", tempCode.."★"..tempName.."★".."", "" )
		-- 종목세팅 재시작
		Check_ItemCode(tempCode)
		return
	end
	-- ------------------------------------------------------
	-- 종목정보 확인
	-- ------------------------------------------------------
	if CheckMasterFile(arrLinkCode[1]) == false then
		tempCode = "OQ@AAPL"
		tempName = Form.GetItemCodeInfo(tempCode, "name")
		-- 최근조회 종목 설정
		Form.SetSharedData( "&ITEM_CODE" , tempCode )
		Form.SetSharedData( "&ITEM_KORNAME" , tempName  )
		Form.SetSharedData( "&ITEM_OVERSTOCK", tempCode.."★"..tempName.."★".."", "" )
		Form.SendMessageToMain( "CHANGE_ITEMCODE_OVERSTOCK", tempCode.."★"..tempName.."★".."", "" )
		-- 종목세팅 재시작
		Check_ItemCode(tempCode)
		return
	end
	-- ------------------------------------------------------
	-- 종목코드 분리 (거래소코드@종목코드)
	-- ------------------------------------------------------
	arrCode = gf_Split(arrLinkCode[1], "@")
	if #arrCode > 1 then 
		Button0.left = 1000
		g_sCode 		= arrCode[2]							-- 종목코드		
		g_sExid 		= Transform_Exid2(arrCode[1])				-- 거래소 구분(영문 2자리)
		g_sItemCode 	= g_sExid .. "@" .. g_sCode					-- 거래소@종목코드
		g_sItemName 	= Form.GetItemCodeInfo(g_sItemCode, "name")	-- 종목명
		-- 20250804_01 YSH START
		sKey = "&OVRS_MARKET_OPERATION_" .. Transform_Exid4(g_sExid)
		g_szMktOpClsCd = Form.GetSharedData(sKey, false)
		-- 20250804_01 YSH END
		-- -----------------------------------------------------
		-- 미국종목 아닌 경우 기본종목 재설정
		-- -----------------------------------------------------
		if g_sExid ~= "OQ" and g_sExid ~= "NY" and g_sExid ~= "AX" then
			tempCode = "OQ@AAPL"
			tempName = Form.GetItemCodeInfo(tempCode, "name")
			-- 최근조회 종목 설정
			Form.SetSharedData( "&ITEM_CODE" , tempCode )
			Form.SetSharedData( "&ITEM_KORNAME" , tempName  )
			Form.SetSharedData( "&ITEM_OVERSTOCK", tempCode.."★"..tempName.."★".."", "" )
			Form.SendMessageToMain( "CHANGE_ITEMCODE_OVERSTOCK", tempCode.."★"..tempName.."★".."", "" )
			-- 종목세팅 재시작
			Check_ItemCode(tempCode)
			return
		end
		-- -----------------------------------------------------
		-- 종목정보 저장
		-- -----------------------------------------------------
		g_rtChk 		= Form.GetSharedData( "REALTIME_"..g_sExid, false )	-- 실시간 여부(서비스호출)
		g_sExid2 		= Form.GetItemCodeInfo(g_sItemCode, "exchcode3") 	-- 거래소 구분값(영문 3자리)
		g_sExid3		= Form.GetItemCodeInfo(g_sItemCode, "exchid")		-- 거래소 구분값(숫자 4자리)
		g_sMarket 		= Transform_Exid3(arrCode[1]) 					-- 거래소 구분값(영문 3자리, 국내와 혼용)
		-- -----------------------------------------------------
		-- 종목명 세팅
		-- -----------------------------------------------------
		cont0.lblItemName.caption = g_sItemName
		lblMktInfo0.visible = true
		DATAMANAGER.RequestTranData("obtro_comn_006r")
		Cancel_Real_Total()
		-- -----------------------------------------------------
		-- 종목정보 조회
		-- -----------------------------------------------------
		DATAMANAGER.RequestTranData("obsim_oscm_331r")
	end
end
-- ==============================================
-- 장운영 정보 기반 시세서비스 호출
-- ==============================================
function Request_MktOp(szMkOpClsCd)
	Cancel_Real_Total()
	if szMkOpClsCd == "001" then	-- 주간장 개시
		DATAMANAGER.RequestTranData("ohhts_6000_017r")
	elseif szMkOpClsCd == "002" then	-- 주간장 종료
		DATAMANAGER.RequestTranData("ohhts_6000_001r")
	elseif szMkOpClsCd == "003" then	-- 프리장 개시
		DATAMANAGER.RequestTranData("ohhts_6000_001r")
	elseif szMkOpClsCd == "004" then	-- 정규장 개시
		DATAMANAGER.RequestTranData("ohhts_6000_001r")
	elseif szMkOpClsCd == "005" then	-- 애프터장 개시
		DATAMANAGER.RequestTranData("ohhts_6000_023r")
	elseif szMkOpClsCd == "006" then	-- 애프터장 종료
		DATAMANAGER.RequestTranData("ohhts_6000_001r")
	elseif szMkOpClsCd == "011" or szMkOpClsCd == "012" then -- 미국 외 장개시/종료
		DATAMANAGER.RequestTranData("ohhts_6000_001r")
	elseif szMkOpClsCd == "013" then -- 장종료
		DATAMANAGER.RequestTranData("ohhts_6000_001r")
	else	-- 예외케이스
		DATAMANAGER.RequestTranData("ohhts_6000_001r")
	end
end
-- ==============================================
-- 실시간 서비스 등록 해제 
-- ==============================================
function Cancel_Real_Total()
	-- 해외주식 체결(프리/정규) 실시간 해제
	DATAMANAGER.CancelRealData("ohhts_exst_cntg")
	-- 해외주식 체결(주간) 실시간 해제
	DATAMANAGER.CancelRealData("ohhts_exst_cntd")
	-- 해외주식 체결(애프터) 실시간 해제
	DATAMANAGER.CancelRealData("ohhts_exst_cnta")
end
-- ==============================================
-- 장운영 정보 코드 변환
-- ==============================================
function Convert_MktOpInfo(szMkOpClsCd)
	if szMkOpClsCd == "001" then
		-- 주간 시작
		g_szMktOp = "주간"
		g_isMktClosed = "N"
		g_szSubMktOp = "전일종가"
	elseif szMkOpClsCd == "002" then
		-- 주간 종료
		g_szMktOp = "주간"
		g_isMktClosed = "Y"
		g_szSubMktOp = "주간종가"
	elseif szMkOpClsCd == "003" then
		-- Pre 시작
		g_szMktOp = "Pre"
		g_isMktClosed = "N"
		g_szSubMktOp = "주간종가"
	elseif szMkOpClsCd == "004" then
		-- 정규장 시작
		g_szMktOp = "정규장"
		g_isMktClosed = "N"
		g_szSubMktOp = "주간종가"
	elseif szMkOpClsCd == "005" then
		-- After 시작
		g_szMktOp = "After"
		g_isMktClosed = "N"
		g_szSubMktOp = "After"
	elseif szMkOpClsCd == "006" then
		-- After 종료
		g_szMktOp = "After"
		g_isMktClosed = "Y"
		g_szSubMktOp = "After"
	elseif szMkOpClsCd == "011" then 
		-- 미국 외 장시작
		g_szMktOp = "정규장"
		g_isMktClosed = "N"
		g_szSubMktOp = ""
	elseif szMkOpClsCd == "012" then 
		-- 미국 외 장종료
		g_szMktOp = "정규장"
		g_isMktClosed = "Y"
		g_szSubMktOp = ""
	elseif szMkOpClsCd == "013" then 
		-- 휴일
		g_szMktOp = "정규장"
		g_isMktClosed = "Y"
		g_szSubMktOp = "After"
	else
		g_szMktOp = "정규장"
		g_isMktClosed = "Y"
		g_szSubMktOp = "After"
	end
end
-- ==============================================
-- 장운영 정보 (주간/휴장 포함) 체크
-- ==============================================
function DisplaySetting_MktOperation(szMktOp, isClosed, szSubMktOp, szBaseDate, isHoliday)
	if g_szMktOpClsCd == "000" then
		lblMktInfo0.caption = "휴장"
		lblMktInfo0.imagefilepth = g_szBadgeBg_Line
	elseif g_szMktOpClsCd == "013" then
		lblMktInfo0.caption = "장종료"
		lblMktInfo0.imagefilepth = g_szBadgeBg_Grey
	else
		lblMktInfo0.caption = szMktOp
		lblMktInfo0.imagefilepth = g_szBadgeBg_Red
		if isClosed == "Y" then
			lblMktInfo0.caption = "장종료"
			lblMktInfo0.imagefilepth = g_szBadgeBg_Grey
		end
	end
end
function Replace_Prc(sPrc)
	if isEmpty(sPrc) == true then
		return ""
	end
	sPrc = string.gsub(sPrc, ",", "")
	sPrc = string.gsub(sPrc, contHidden.Label7.caption, "")
	sPrc = string.gsub(sPrc, "%", "")
	sPrc = string.gsub(sPrc, "틱", "")
	sPrc = string.gsub(sPrc, "$", "")
	return gf_Trim(sPrc)
end
-- =============================================================================
-- (공통) 가격입력창 가격SET
-- =============================================================================
function SetPrice(sType, nPrc, nDecimalLen, sPostFix)
	sPreFix = ""
	if sPostFix == "USD" then
		sPostFix = ""
		sPreFix = "$"
	end
	if isEmpty(nDecimalLen) == true or isEmpty(nPrc) == true then
		return ""
	end
	sChk = Instr(gf_Tostring(nPrc), ".")
	-- =================================================================
	-- 소수점(dot)이 있는 경우
	-- =================================================================
	if sChk > 0 then
		-- ------------------------------
		-- 소수점영역 길이
		-- ------------------------------
		sCha = gf_Tonumber(string.len(nPrc) - sChk)
		-- -------------------------------------------------------
		-- 소수점영역의 길이가 국가별 소수점 자리수를 다 채운 경우
		-- -------------------------------------------------------
		if sCha >= gf_Tonumber(nDecimalLen) then
			if sCha >= gf_Tonumber(nDecimalLen) then
				sResult = sPreFix.." "..gf_CommaValue(nPrc, nDecimalLen).." " .. sPostFix
				return sResult
			else
				return ""
			end
		-- -------------------------------------------------------	 
		-- 소수점영역의 길이를 아직 다 안채운 경우
		-- -------------------------------------------------------
		else
			-- -------------------------------------------------------------------
			-- 자동으로 호가가격이 입력되는 경우(초기값 세팅/ 호가 +,- 버튼 클릭)
			-- 국가별 소수점 자리수로 가격을 다시 맞춰준다.
			-- -------------------------------------------------------------------
			if sType == "AUTO" then
				sResult = sPreFix.." "..gf_CommaValue(nPrc,nDecimalLen).." " .. sPostFix
				return sResult
			-- -------------------------------------------------------------------
			-- 가격이 수동으로 입력되는 경우(키패드 입력)에는 입력받은대로 표시
			-- -------------------------------------------------------------------
			else
				sResult =  nPrc.." " .. sPostFix
				return sResult
			end
		end
	-- =================================================================
	-- 소수점(dot)이 없는 경우
	-- =================================================================
	else
		if sType == "AUTO" then
			sResult = sPreFix.." "..gf_CommaValue(nPrc,nDecimalLen) .." " .. sPostFix
			return sResult
		else
			sResult = sPreFix.." "..gf_CommaValue(nPrc,0) .." " .. sPostFix
			return sResult
		end
	end
end
-- =============================================================================
-- 가격 호가단위 맞추기 
-- =============================================================================
function ReSet_Prc(szData, nGbn)
	if isEmpty(szData) == true then
		return 0
	end
	nDecimal = gf_Tonumber(contHidden.Label8.caption)
	szUnit = GetHogaUnit(g_sExid3, szData, nGbn)
	if nGbn == 0 then
		nResult = Round(gf_Tonumber(szData) % gf_Tonumber(szUnit), gf_Tonumber(nDecimal))
		if nResult ~= 0 and nResult ~= gf_Tonumber(szUnit) then
			return gf_Tonumber(szData) - nResult
		else
			return szData
		end
	else
		nResult = Round(gf_Tonumber(szData) % gf_Tonumber(szUnit), gf_Tonumber(nDecimal))
		if nResult ~= 0 then
			return gf_Tonumber(szData) + (gf_Tonumber(szUnit) - nResult)
		else
			return szData
		end
	end
end
-- =============================================================================
-- Calc_Price : +, - 버튼클릭시 호가단위로 가격계산
-- =============================================================================
function Calc_Price2(nType, nGbn, sValue)
	if nType == 0 then
		if isEmpty(sValue) == true then
			return "0"
		end
		nValue  = gf_Tonumber(sValue)
		-- ------------------------------------------------
		-- + 버튼 클릭
		-- ------------------------------------------------
		if nGbn == 0 then							
			nValue = nValue + 1
		-- ------------------------------------------------
		-- - 버튼 클릭 
		-- ------------------------------------------------
		elseif nGbn == 1 then						
			nValue = nValue - 1
		end
		if nValue > 10 then
			nValue = 10
		end
		if nValue < -10 then
			nValue = -10
		end
		return nValue
	else
		-- ---------------------------------------------
		-- 호가단위 맞춘 가격데이터 계산
		-- ---------------------------------------------
		sPrc  = ReSet_Prc(sValue, nGbn)
		szUnit = GetHogaUnit(g_sExid3, sPrc, nGbn)
		--		-- ---------------------------------------------
		--		-- 가격데이터가 없는 경우
		--		-- ---------------------------------------------
		--		if isEmpty(sPrc) == true or CDbl(sPrc) == 0 then
		--			if isEmpty(Form.getTopCtlProp("contHidden.lblItemSellHoga","caption")) == true or CDbl(Form.getTopCtlProp("contHidden.lblItemSellHoga","caption")) == 0 then
		--				sPrc = 0
		--			else
		--				sPrc = Form.getTopCtlProp("contHidden.lblItemSellHoga","caption")
		--			end
		--			
		--		-- ---------------------------------------------
		--		-- 가격데이터가 있는 경우
		--		-- ---------------------------------------------
		--		else
		-- ------------------------------------------------
		-- + 버튼 클릭
		-- ------------------------------------------------
		if nGbn == 0 then							
			sPrc = gf_Tonumber(sPrc) + gf_Tonumber(szUnit)
		-- ------------------------------------------------
		-- - 버튼 클릭 
		-- ------------------------------------------------
		elseif nGbn == 1 then						
			sPrc = gf_Tonumber(sPrc) - gf_Tonumber(szUnit)
		end
		--		end if
		if isEmpty(sPrc) == true or gf_Tonumber(sPrc) < 0 then
			sPrc = ""
		end
		return sPrc
	end
end
-- =============================================================================
-- Calc_Qty : +, - 버튼클릭시 수량 length로 수량단위 계산
-- =============================================================================
function Calc_Qty2(nGbn)
	sQty = cont1.edtQty.caption
	g_sQtyUnit = contHidden.Label10.caption
	if isEmpty(g_sQtyUnit) == true then
		g_sQtyUnit = "1"
	end
	-- ---------------------------------------------------------
	-- 수량이 빈값인 경우 매매단위로 초기화
	-- ---------------------------------------------------------
	if isEmpty(sQty) == true then
		if nGbn == 0 then
			sQty = g_sQtyUnit
		else
			return
		end
	-- ---------------------------------------------------------
	-- 수량이 빈값이 아닌 경우
	-- ---------------------------------------------------------
	else
		-- ---------------------------------------------------------
		-- [+]버튼 클릭
		-- ---------------------------------------------------------
		if nGbn == 0 then
			sQty = gf_Tonumber(sQty) + gf_Tonumber(g_sQtyUnit)
			nResult = gf_Tonumber(sQty) % gf_Tonumber(g_sQtyUnit)
			if nResult ~= 0 then
				sQty = gf_Tonumber(sQty) - nResult
			end
		--			if CDbl(sQty) < CDbl(g_sDefQty) then
		--				sQty = contHidden.Label10.caption
		--			end if
		-- ---------------------------------------------------------
		-- [-]버튼 클릭
		-- ---------------------------------------------------------
		elseif nGbn == 1 then
			if gf_Tonumber(sQty) == 0 then
				return
			else		
				sQty = sQty - gf_Tonumber(g_sQtyUnit)
				nResult = gf_Tonumber(sQty) % gf_Tonumber(g_sQtyUnit)
				--				if Cdbl(sQty) < Cdbl(g_sDefQty) then
				--					sQty = 0
				--				end if
			end
		end
	end
	-- ---------------------------------------------------------
	-- 입력값 자리수 체크
	-- ---------------------------------------------------------
	--	if Len(szQty) <= gMaxLen then		
	if isEmpty(sQty) == true or gf_Tonumber(sQty) == 0 then
		cont1.edtQty.caption = ""
	else
		cont1.edtQty.caption = sQty
	end
	--	end if
end
-- =============================================================================
-- From일로부터 + @일/개월 가져오기
-- =============================================================================
function CalcDate(sType,nDiff)
	--	sDate = Form.GetSharedData("&BIZ_DT", false )
	--	
	--	sToday = Form.GetSharedData("&HOST_DATE", false )
	--	if cint(sToday) >  Cint(Form.GetSharedData("&BIZ_DT", false )) then
	--		sDate = Form.GetSharedData("&BIZ_NXT_DT", false )
	--	else	
	--		sDate = Form.GetSharedData("&BIZ_DT", false )
	--	end if
	sDate = g_sBizDate
	sYear = Left(sDate, 4)
	sMonth = Mid(sDate, 5, 2)
	sDay = Right(sDate, 2)
	sRsltDate = string.gsub(DateAdd (sType, nDiff,  sYear.."-".. sMonth .."-".. sDay), "-", "")
	return sRsltDate
end
