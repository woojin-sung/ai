				elseif szOrdPrc <= 2000.00 then
					szUnit = "0.500"
				else
					szUnit = "1.000"
				end
			end
		else
			if nGbn == 0 then
				if szOrdPrc < 0.25 then
					szUnit = "0.001"
				elseif szOrdPrc < 0.50 then
					szUnit = "0.005"
				elseif szOrdPrc < 10.00 then
					szUnit = "0.010"
				elseif szOrdPrc < 20.00 then	
					szUnit = "0.020"
				elseif szOrdPrc < 100.00 then
					szUnit = "0.050"
				elseif szOrdPrc < 200.00 then
					szUnit = "0.100"
				elseif szOrdPrc < 500.00 then
					szUnit = "0.200"
				elseif szOrdPrc < 1000.00 then
					szUnit = "0.500"
				elseif szOrdPrc < 2000.00 then
					szUnit = "1.000"
				elseif szOrdPrc < 5000.00 then
					szUnit = "2.000"
				else 
					szUnit = "5.000"
				end
			else
				if szOrdPrc <= 0.25 then
					szUnit = "0.001"
				elseif szOrdPrc <= 0.50 then
					szUnit = "0.005"
				elseif szOrdPrc <= 10.00 then
					szUnit = "0.010"
				elseif szOrdPrc <= 20.00 then	
					szUnit = "0.020"
				elseif szOrdPrc <= 100.00 then
					szUnit = "0.050"
				elseif szOrdPrc <= 200.00 then
					szUnit = "0.100"
				elseif szOrdPrc <= 500.00 then
					szUnit = "0.200"
				elseif szOrdPrc <= 1000.00 then
					szUnit = "0.500"
				elseif szOrdPrc <= 2000.00 then
					szUnit = "1.000"
				elseif szOrdPrc <= 5000.00 then
					szUnit = "2.000"
				else
					szUnit = "5.000"
				end
			end
		end
	-- -----------------------------------------------------------------------
	-- 해외주식 일본시장(도쿄거래소) 추가
	-- -----------------------------------------------------------------------
	elseif szMk == "0106" then -- 도쿄
		if szTtype == 3 then
			if nGbn == 0 then
				if szOrdPrc < 1000 then
					szUnit = "0.1"
				elseif szOrdPrc < 3000 then
					szUnit = "0.5"
				elseif szOrdPrc < 5000 then
					szUnit = "1"
				elseif szOrdPrc < 10000 then	
