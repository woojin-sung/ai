-- ****************************************************************************
--             P  E  R  S  O  N  A  L       F  U  N  C  T  I  O  N              
-- ****************************************************************************
-- ===============================================
-- NULL 체크 
-- ===============================================
function isEmpty(sData)
	if gf_Trim(sData) == "" or sData == nil or gf_Trim(sData) == "null" then
		return true
	else
		return false
	end
end
-- ===============================================
-- 숫자 소수점 절사 함수
-- ===============================================
function truncateToDecimalPlaces(nVal, nDeimalPlaces)
	nVal = gf_Tonumber(nVal)
	nFactor = 10 ^ nDeimalPlaces
	szNumStr = gf_CommaValue(nVal*nFactor,12,0,0,0,1)
	nDecimalIdx = Instr(szNumStr, ".")
	nTotalData = 0
	if gf_Tonumber(nDecimalIdx) > 0 then
		nTotalData = gf_Tonumber(Left(szNumStr, gf_Tonumber(nDecimalIdx)-1))
	else
		nTotalData = gf_Tonumber(szNumStr)
	end
	return nTotalData / nFactor
end
-- ===============================================
-- (NonNull) 문자열 -> 배열 변환함수
-- ===============================================
function Convert_StrToArr(szData, szSeperator)
	local arrData
	-- --------------------------------------------
	-- 링크데이터 값 체크
	-- --------------------------------------------
	if isEmpty(szData) then
		arrData = {}
		return arrData
	end
	-- --------------------------------------------
	-- 구분자 값 체크
	-- --------------------------------------------
	if isEmpty(szSeperator) then
		-- 단일변수
		arrData = {}
		table.insert(arrData, szData)
	else
		-- 다중변수
		arrData = gf_Split(szData, szSeperator)
	end
	return arrData
end
-- =============================================================================
-- 마스터파일에 있는 종목인지 체크
-- =============================================================================
function CheckMasterFile(szCode)
	if isEmpty(szCode) == true then
		return false
	end
	arrCode = gf_Split(szCode,"@")
	if #arrCode < 2 then
		return false
	end
	szTransExidCode = Transform_Exid2(arrCode[1])
	szTransItemCode = szTransExidCode .. "@" .. arrCode[2]
	szCheckData = Form.GetItemCodeInfo(szTransItemCode, "exchid")
	if isEmpty(szCheckData) == true then
		return false
	end
	return true
end
-- =============================================================================
-- 거래소 호가단위 설정
-- =============================================================================
function GetHogaUnit(szMk, szPrc, nGbn) 
	-- -----------------------------------------------------------------------
	-- 호가단위 초기화
	-- -----------------------------------------------------------------------
	szOrdPrc = gf_Tonumber(szPrc)
	szUnit = "1.000"
	-- -----------------------------------------------------------------------
	-- 틱타입 확인
	-- -----------------------------------------------------------------------
	szTtype = gf_Tonumber(contHidden.Label9.caption)
	if szTtype == 0 or szTtype == "" then
		szTtype = "0"
	end
	-- -----------------------------------------------------------------------
	-- 중국(상해/심천) 호가단위 설정
	-- -----------------------------------------------------------------------
	if szMk == "0215" then -- 상해
		-- 20240613 LES START 틱단위 수정
		if szTtype == 2 then -- ETF
			szUnit = "0.001"
		else
			szUnit = "0.010"
		end
		-- 20240613 LES END
	elseif szMk == "0214" then -- 심천
		-- 20240613 LES START 틱단위 수정
		if szTtype == 2 then -- ETF
			szUnit = "0.001"
		else
			szUnit = "0.010"
		end
		-- 20240613 LES END
	-- -----------------------------------------------------------------------
	-- 미국(뉴욕/나스닥/아멕스) 호가단위 설정
	-- -----------------------------------------------------------------------
	elseif szMk == "0321" or szMk == "0537" or szMk == "0066" then -- 뉴욕, 나스닥, 아멕스
		-- 20240702 LES START - 1달러미만 종목 0.0001단위
		if szOrdPrc < 1.00 then
			szUnit = "0.0001" 
		else
			if szTtype == 1 then
				szUnit = "0.010"
			elseif szTtype == 2 then
				szUnit = "0.050"
			elseif szTtype == 3 then
				szUnit = "0.050"
