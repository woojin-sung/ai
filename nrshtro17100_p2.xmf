function Check_HogaUnit(sValue, isChk)
	-- ------------------------------------
	-- 체크여부
	-- ------------------------------------
	if isChk == false then
		return true
	end
	szUnit = GetHogaUnit(g_sExid3, sValue, 0)
	--	nMod = CDbl(sValue) % CDbl(szUnit)
	nDiv = gf_Tonumber(sValue) / gf_Tonumber(szUnit)
	sDiv = gf_CommaValue(nDiv,4,1,0,0,1)
	nDecimalIdx = Instr(sDiv, ".")
	nTotalLen = Form.GetLen(sDiv)
	nMod = gf_Tonumber(right(sDiv, gf_Tonumber(nTotalLen) - gf_Tonumber(nDecimalIdx)))
	--	msgbox CDBL(sValue) .. "|" .. cDBL(szUnit) .. "|" .. Cdbl(nMod)
	if gf_Tonumber(sValue) >= 1 and nMod > 0 then
		Form.ShowAlert("알림", "호가 단위를 확인해주세요.\n(호가 단위 : " .. gf_Tonumber(szUnit) .. " " .. contHidden.Label7.caption..")")
		return false
	else
		return true
	end
end
function Load_Config()
	-- -------------
	-- 감시조건 
	-- -------------
	g_mCondType = Form.GetEnvData("17100_BUY_MONITOR_COND_TYPE")
	if isEmpty(g_mCondType) == true then
		g_mCondType = "01"
		Form.SetEnvData(1, "17100_BUY_MONITOR_COND_TYPE", g_mCondType)
	end
	g_mCondBound = Form.GetEnvData("17100_BUY_MONITOR_COND_BOUND")
	if isEmpty(g_mCondBound) == true then
		g_mCondBound = "2"
		Form.SetEnvData(1, "17100_BUY_MONITOR_COND_BOUND", g_mCondBound)
	end
	-- -------------
	-- 주문조건 
	-- -------------
	g_oCondType = Form.GetSharedData("17100_BUY_ORDER_COND_TYPE", false)
	if isEmpty(g_oCondType) == true then
		g_oCondType = "01"
		Form.SetSharedData("17100_BUY_ORDER_COND_TYPE" , g_oCondType)
	end
	g_oCondPrc = Form.GetSharedData("17100_BUY_ORDER_COND_PRC", false)
	if isEmpty(g_oCondPrc) == true then
		g_oCondPrc = "01"
		Form.SetSharedData("17100_BUY_ORDER_COND_PRC" , g_oCondPrc)
	end
end
function SetOrderTypeList()
	sList = "01`현재가`설정 가격에 도달 시 감시가 실행돼요.\r\n" ..
		"02`시가(당일 정규장 기준)`설정 가격이 시가에 도달 시 감시가 실행돼요.\r\n" ..
		"03`고가(당일 정규장 기준)`설정 가격이 고가에 도달 시 감시가 실행돼요.\r\n" ..
		"04`저가(당일 정규장 기준)`설정 가격이 저가에 도달 시 감시가 실행돼요.\r\n" ..
		"05`전일종가대비`전일 종가 대비 설정 가격 만큼 상승하거나 하락 시 감시가 실행돼요.     \r\n" ..
		"06`등락률(전일종가대비)`설정한 등락률 만큼 상승하거나 하락 시 감시가 실행돼요.     \r\n"
	sOsType = Form.GetSharedData("&OS_TYPE", false)
	if sOsType == "2" then
		cont1.cmb6.SetPopupHeight(470)
	else
		cont1.cmb6.SetPopupHeight(380)
	end
	cont1.cmb6.clear = true
	cont1.cmb6.cbinputdatatext = sList
end
