-- =============================================================================
-- 접두사 / 접미사 변환 함수 (조건추가해서 사용하기 바람)
-- =============================================================================
function Replace_Affix(nIdx, sAffix, sText)
	sTempAffix = ""
	if sAffix == "$" then
		sTempAffix = "USD"
	elseif sAffix == "USD" then
		sTempAffix = "$"
	else
		sTempAffix = sAffix
	end
	sResult = sText
	if Instr(sResult, sAffix) > 0 then
		-- --------------
		-- Prefix
		-- --------------
		if nIdx == 0 then
			sResult = sTempAffix .. " " .. gf_Trim(string.gsub(sResult, sAffix, ""))
		-- --------------
		-- Suffix
		-- --------------
		elseif nIdx == 1 then
			sResult = gf_Trim(string.gsub(sResult, sAffix, "")) .. " " .. sTempAffix
		end
	end
	return sResult
end
-- ======================================================================================
-- REST API 통신처리
-- ======================================================================================
function Open_Confirm()
	sLinkData = Left(g_sAcno,4) .. "-" .. Right(g_sAcno,4)  .. "-" .. g_sAsno .. " " .. g_sAcntNm
	sLinkData = sLinkData .. "`" .. g_sCode
	sLinkData = sLinkData .. "`" .. g_sItemName
	sLinkData = sLinkData .. "`" .. cont1.cmb6.caption
	sLinkData = sLinkData .. "`" .. Replace_Affix(1, "$", cont1.Label6.caption)  .. " " .. cont1.cmb1.caption
	sLinkData = sLinkData .. "`" .. cont1.cmb4.caption 
	if cont1.cmb4.cbkeydata ~= "05" and cont1.cmb4.cbkeydata ~= "34" then
		if cont1.cmb5.cbkeydata == "01" then
			sLinkData = sLinkData .. "`" .. cont1.Combo0.caption 
		elseif cont1.cmb5.cbkeydata == "09" then
			sLinkData = sLinkData .. "`" .. Replace_Affix(1, "$", cont1.edtPrc0.caption)  
		else
			sLinkData = sLinkData .. "`" .. cont1.cmb5.caption 
		end
	else
		sLinkData = sLinkData .. "`" .. "-"
	end
	if isEmpty(cont1.edtQty.caption) == true then
		sLinkData = sLinkData .. "`" .. "-"
	else
		sLinkData = sLinkData .. "`" .. gf_CommaValue(cont1.edtQty.caption , 0) .. " 주"
	end
	sDate = cont1.Calendar0.caption
	sConvDate = Mid(sDate,3,2) .. "." .. Mid(sDate,5,2) .. "." .. Right(sDate,2) .. " 까지"
	sLinkData = sLinkData .. "`" .. sConvDate
	Form.OpenPopup("nrshtro17100_pa" , sLinkData , "")
end
