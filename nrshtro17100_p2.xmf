function cont1_Label6_OnClick()
	sLinkData = "1"									-- 매도/매수 구분 (매도:0, 매수:1)
	sPrc = Replace_Prc(cont1.Label6.caption)
	if gf_Tonumber(sPrc) == 0 then
		sPrc = ""
	end
	if cont1.cmb6.cbkeydata == "06" then
		sLinkData = "0"	
		sLinkData = sLinkData .. "`" .. "2"					-- 가격/수량 구분 (가격:0, 수량:1, 등락률:2)
		sLinkData = sLinkData .. "`" .. string.gsub(sPrc, "-", "")	-- 가격/수량 값   
		sLinkData = sLinkData .. "`" .. "6"	-- 소숫점 자리
		sLinkData = sLinkData .. "`" .. "2"	-- 소숫점 자리
		sLinkData = sLinkData .. "`" .. "%"	-- 뒷첨자 
	else
		sLinkData = sLinkData .. "`" .. "0"					-- 가격/수량 구분 (가격:0, 수량:1, 등락률:2)
		sLinkData = sLinkData .. "`" .. string.gsub(sPrc, "-", "")		-- 가격/수량 값   
		sLinkData = sLinkData .. "`" .. "12"	-- 소숫점 자리
		sLinkData = sLinkData .. "`" .. contHidden.Label8.caption	-- 소숫점 자리
		sLinkData = sLinkData .. "`" .. contHidden.Label7.caption	-- 뒷첨자 
	end
	if cont1.cmb6.cbkeydata == "06" then
		sPrc = SetPrice("AUTO", 0, "2", "%")
	else
		sPrc = SetPrice("AUTO", 0, contHidden.Label8.caption, contHidden.Label7.caption)
	end
	cont1.Label6.fgcolor = 333
	cont1.Label6.caption = sPrc
	sLinkData = sLinkData .. "`" .. "매수_감시가격"			-- 리턴받을 키값
	Form.OpenPopup("nrshtro17100_p0" , sLinkData, "")
end
