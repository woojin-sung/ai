	<SCRIPT_INFO _len="5479" _ulen="5120" >
dofile("scr/script.lua")
dofile("scr/json.lua")
-- ============================================================================
-- ============================================================================
local g_sTheme
g_sTheme = Form.GetEnvData("common.theme")
local g_sOsType
g_sOsType = Form.GetSharedData("&OS_TYPE", false )
local nextTop
nextTop = 0
-- =============================================================================
function Form_OnFormInitBefore()
	img0.maintainratio = "1"
	img1.maintainratio = "1"
	imgicon0.maintainratio = "1"
end
-- =============================================================================
function Form_OnFormInit()
	if g_sTheme == "white" then
		img0.imgpath = "guide_tab1_img1_l"
		img1.imgpath = "guide_tab1_img2_l"
	else
		img0.imgpath = "guide_tab1_img1_d"
		img1.imgpath = "guide_tab1_img2_d"
	end
	sText = "주가가 목표로 정한 이익실현 가격에 도달 시 감시가 실행되어, 설정한 주문 방법으로 매도 주문이 실행돼요."
	--	nLen = Cint(Form.getLen("상승하여 목표로 정한 이익실현 가격에 도달 시"))
	lblInfo0.sizeAutoFit()
	lblInfo0.caption = sText
	--	lblInfo0.changeTextAttr(11, nLen, 290, -2, true)
end
-- =============================================================================
function lblInfo0_OnSizeAutoFit()
	--	nH = cint(lblInfo0.height2)
	nH = 0
	if g_sOsType == "2" then
		nH = gf_Tonumber(lblInfo0.height)
	else
		nH = gf_Tonumber(lblInfo0.height2)
	end
	nextTop = 40 + nH + 10
	img0.top = nextTop
	nextTop = nextTop + 150 + 20
	lblSubInfo0.top = nextTop
	sText = "예) 주가가 $550(이익실현가격) 도달 시 설정한 주문 조건으로 주문이 실행돼요."
	lblSubInfo0.sizeAutoFit()
	lblSubInfo0.caption = sText
end
-- =============================================================================
function lblSubInfo0_OnSizeAutoFit()
	--	nH = cint(lblSubInfo0.height2)
	nH = 0
	if g_sOsType == "2" then
		nH = gf_Tonumber(lblSubInfo0.height)
	else
		nH = gf_Tonumber(lblSubInfo0.height2)
	end
	nextTop = nextTop + nH + 30
	lblDiv0.top = nextTop
	nextTop = nextTop + 30
	imgicon0.top = nextTop
	lbl1.top = nextTop
	nextTop = nextTop + 50
	img1.top = nextTop
	nextTop = nextTop + 120 + 20
	lblSubInfo1.top = nextTop
	sText = "① 기준가를 선택해요."
	lblSubInfo1.sizeAutoFit()
	lblSubInfo1.caption = sText
end
-- =============================================================================
function lblSubInfo1_OnSizeAutoFit()
	--	nH = cint(lblSubInfo1.height2)
	nH = 0
	if g_sOsType == "2" then
		nH = gf_Tonumber(lblSubInfo1.height)
	else
		nH = gf_Tonumber(lblSubInfo1.height2)
	end
	nextTop = nextTop + nH + 8
	lblSubInfo2.top = nextTop
	sText = "② 이익 실현 조건(가격)을 입력해요."
	lblSubInfo2.sizeAutoFit()
	lblSubInfo2.caption = sText
end
-- =============================================================================
function lblSubInfo2_OnSizeAutoFit()
	--	nH = cint(lblSubInfo2.height2)
	nH = 0
	if g_sOsType == "2" then
		nH = gf_Tonumber(lblSubInfo2.height)
	else
		nH = gf_Tonumber(lblSubInfo2.height2)
	end
	nextTop = nextTop + nH + 3
	if g_sOsType == "2" then
		lblGuide0.top = nextTop
	else
		lblGuide0.top = nextTop + 2
	end
	lblSubInfo3.top = nextTop
	sText = "단위 ($, %, 틱) 선택 후 조건을 입력해요."
	lblSubInfo3.sizeAutoFit()
	lblSubInfo3.caption = sText
end
-- =============================================================================
function lblSubInfo3_OnSizeAutoFit()
	--	nH = cint(lblSubInfo3.height2)
	nH = 0
	if g_sOsType == "2" then
		nH = gf_Tonumber(lblSubInfo3.height)
	else
		nH = gf_Tonumber(lblSubInfo3.height2)
	end
	nextTop = nextTop + nH + 3
	if g_sOsType == "2" then
		lblGuide1.top = nextTop
	else
		lblGuide1.top = nextTop + 2
	end
	lblSubInfo4.top = nextTop
	sText = "기준가 보다 높은 가격으로 입력해요."
	lblSubInfo4.sizeAutoFit()
	lblSubInfo4.caption = sText
end
-- =============================================================================
function lblSubInfo4_OnSizeAutoFit()
	--	nH = cint(lblSubInfo4.height2)
	nH = 0
	if g_sOsType == "2" then
		nH = gf_Tonumber(lblSubInfo4.height)
	else
		nH = gf_Tonumber(lblSubInfo4.height2)
	end
	nextTop = nextTop + nH + 3
	if g_sOsType == "2" then
		lblGuide2.top = nextTop
	else
		lblGuide2.top = nextTop + 2
	end
	lblSubInfo5.top = nextTop
	sText = "'%, 틱' 선택 후 조건 입력 시 감시가격이 자동 조회돼요."
	lblSubInfo5.sizeAutoFit()
	lblSubInfo5.caption = sText
end
-- =============================================================================
function lblSubInfo5_OnSizeAutoFit()
	--	nH = cint(lblSubInfo5.height2)
	nH = 0
	if g_sOsType == "2" then
		nH = gf_Tonumber(lblSubInfo5.height)
	else
		nH = gf_Tonumber(lblSubInfo5.height2)
	end
	nextTop = nextTop + nH + 3
	lblSubInfo6.top = nextTop
	sText = "% 선택 시 감시가격 = 기준가 + (기준가×감시조건%)"
	lblSubInfo6.sizeAutoFit()
	lblSubInfo6.caption = sText
end
-- =============================================================================
function lblSubInfo6_OnSizeAutoFit()
	--	nH = cint(lblSubInfo6.height2)
	nH = 0
	if g_sOsType == "2" then
		nH = gf_Tonumber(lblSubInfo6.height)
	else
		nH = gf_Tonumber(lblSubInfo6.height2)
	end
	nextTop = nextTop + nH + 20
	Form.triggerEvent("#", "MID_1_SIZE", nextTop)
end
	</SCRIPT_INFO>
</ROOT>