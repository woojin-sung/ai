 --============================================================================
 --해외주식 세미스크린 세미메뉴
 --============================================================================
function Form_OnFormInit()
	szLinkData = Form.GetOpenLinkData()

	if szLinkData == "JP" then
		TblQuick.visible = false
		TblQuickCHHK.visible = false
		TblQuickJP.visible = true
		
		imgQuick.height = 240
	elseif szLinkData == "SH" or szLinkData == "SZ" or szLinkData == "HK" then
		TblQuick.visible = false
		TblQuickCHHK.visible = true
		TblQuickJP.visible = false
		
		imgQuick.height = 280
	else
		TblQuick.visible = true
		TblQuickCHHK.visible = false
		TblQuickJP.visible = false
		
		imgQuick.height = 320
	end
	
end
 --============================================================================
function TblQuick_OnClick(lRow , lColumn)
	-- SELECT CASE 변환 (수동 보정 필요)
	if gf_Tonumber(lRow) == 0 then
 --		Form.OpenPopup("mhetc91001" , "1", "")
		Form.OpenScreen("91001" , "1")
		
	elseif gf_Tonumber(lRow) == 1 then
		Form.OpenScreen("11010" , "")
		
	elseif gf_Tonumber(lRow) == 2 then
		Form.SendReturnToParent("SCREEN_MENU" , "REG_MEMO")

	elseif gf_Tonumber(lRow) == 3 then
		Form.SendReturnToParent("SCREEN_MENU" , "DISCLAIMER")
	
	elseif gf_Tonumber(lRow) == 4 then
		Form.OpenScreen("16020" , "")

	elseif gf_Tonumber(lRow) == 5 then
		Form.OpenScreen("87051" , "")
		
	elseif gf_Tonumber(lRow) == 6 then
		Form.OpenScreen("16090" , "")
		
	elseif gf_Tonumber(lRow) == 7 then
		Form.SendReturnToParent("SCREEN_MENU" , "SET_SCREEN")
		
	end
	
	Form.CloseForm()
end

