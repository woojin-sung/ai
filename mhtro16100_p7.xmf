 --****************************************************************************
 --               G  L  O  B  A  L       V  A  R  I  A  B  L  E
 --****************************************************************************

local g_nCount
g_nCount = 0

local g_nIndex -- 매도수구분 (0:매수, 1:매도, 2:정정, 3:취소)
local g_szOrder_Acc -- 계좌번호
local g_szOrder_AccName -- 고객명
local g_szOder_Cnt -- 주문건수
local g_szAllCheck -- 전체선택 여부


 --Dim g_szOrd_ItmCode		 -- 종목코드
 --Dim g_szOrd_ItmName		 -- 종목명
 --Dim g_szOrd_OrdType		 -- 주문구분
 --Dim g_szOrd_Security		 -- 현금/대출
 --Dim g_nOrd_Qty			 -- 주문수량
 --Dim g_nOrd_Price			 -- 주문가격
 --Dim g_nOrd_OrdNo			 -- 원주문번호
 --Dim g_nOrd_ChkAll			 -- 잔량전부	
 --Dim g_nOrd_Decimal		 -- 가격자릿수
 --Dim g_nOrd_Currency		 -- 통화기호
 --Dim g_szOrd_PrcName		 -- 시장가/지정가
 --
 --Dim g_nOrd_LoanType		 -- 대출구분
 --Dim g_szOrd_LoanDate		 -- 대출일자
 --Dim g_szOrd_LoanSrno		 -- 대출일련번호
 --
 --============================================================================
function Form_OnFormInitBefore()

	local szData, arrData, szItemName

	szData = Form.GetOpenLinkData()
	
	arrData = gf_Split(szData,"|")
	
	if #arrData < 1 then
	    return
	end
	
	 -------------------------------------------------------------
	 -- 일반주문
	 -------------------------------------------------------------
	g_nIndex				= arrData[0+1]  -- 매도수구분 (0:매수, 1:매도, 2:정정, 3:취소, 10:예약매수, 11:예약매도, 12:예약취소)
	g_szOrder_Acc			= arrData[1+1]	 -- 계좌번호
	g_szOrder_AccName		= arrData[2+1]	 -- 고객명
	g_szOder_Cnt			= arrData[3+1]  -- 주문건수
	g_szAllCheck			= arrData[4+1]  -- 전체선택여부
	
 --	g_szOrd_ItmCode 		= arrData[3+1]	 -- 종목코드
 --	g_szOrd_ItmName 		= arrData[4+1]	 -- 종목명
 --	g_szOrd_OrdType  		= arrData[5+1]	 -- 주문구분
 --	g_szOrd_Security 		= arrData[6+1]	 -- 현금/대출구분 (0:현금/1:대출)
 --	g_nOrd_Qty   			= arrData[7+1]	 -- 주문수량
 --	g_nOrd_Price 			= arrData[8+1]	 -- 주문가격
 --	g_nOrd_OrdNo 			= arrData[9+1]	 -- 원주문번호
 --	g_nOrd_ChkAll 		= arrData[10+1]	 -- 잔량전부
 --	g_nOrd_Decimal		= arrData[11+1]	 -- 가격자릿수
 --	g_nOrd_Currency		= arrData[12+1]	 -- 통화
 --	g_szOrd_PrcName		= arrData[13+1]	 -- 시장가or지정가
 --	
 --	 --대출일경우
 --	if g_szOrd_Security == "1" then
 --		g_nOrd_LoanType		= arrData[14+1]	 -- 대출구분
 --		g_szOrd_LoanDate		= arrData[15+1]	 -- 대출일자
 --		g_szOrd_LoanSrno		= arrData[16+1]	 -- 대출일련번호
 --	end if
	
end

 --============================================================================
function Form_OnFormInit()

    Set_Data(g_nIndex)
    
end

 --============================================================================
 --주문화면 데이터
 --============================================================================
function Set_Data(nIndex)

    	 -------------------------------------------------------------
	 -- 계좌번호/고객명
	 -------------------------------------------------------------
	szStr1 = string.sub(g_szOrder_Acc, 1, 4)
	szStr2 = string.sub(g_szOrder_Acc, 5, 5 + 4 - 1)
	szStr3 = string.sub(g_szOrder_Acc, -2)
	tblMaedo1.SetCellString( 0, 1, szStr1.."-".. szStr2 .."-".. szStr3.." "..g_szOrder_AccName)
	
	 -------------------------------------------------------------
	 -- 주문건수
	 -------------------------------------------------------------
	tblMaedo1.SetCellString( 1, 1, g_szOder_Cnt.."건")
	
	 -------------------------------------------------------------
	 -- 종목
	 -------------------------------------------------------------
	if g_szAllCheck == "Y" then
		tblMaedo1.SetCellString( 2, 1, "전종목")
	else
		tblMaedo1.SetCellString( 2, 1, "선택종목")
	end
	
	 -------------------------------------------------------------
	 -- 수량
	 -------------------------------------------------------------
	tblMaedo1.SetCellString( 3, 1, "전량")
	
	
end

 --============================================================================
function SendOrder()
    
    if g_nCount == 0 then
	    Form.SendReturnToParent( "전체취소주문전송" , "1")
	    
	    g_nCount = 1
	    Form.CloseForm( )
	    
    end
    
end
 --============================================================================
function btnMaesu1Close_OnClick()
	Form.CloseForm()	
end
 --============================================================================
function btnMaesu1_OnClick()
	SendOrder()
end
 --============================================================================
function imgBg_OnClick()
	Form.CloseForm()	
end

